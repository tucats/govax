	.TITLE	LIBCRD	Phase 34 LIB$CREATE_DIR probe
	.IDENT	/V1.0/

; Written by testdata/credir/gen.go. Calls LIB$CREATE_DIR once per case
; and writes "STAT", the case number, and R0 to LIBCRD.DMP.

	.PSECT	DATA,NOEXE,WRT,LONG
OFAB:	$FAB	FNM=<LIBCRD.DMP>,FAC=PUT,RFM=VAR,MRS=64
ORAB:	$RAB	FAB=OFAB,RBF=REC,RSZ=12
REC:	.ASCII	/STAT/
STEP:	.LONG	0
STAT:	.LONG	0
	.ALIGN	LONG
; 1: defaults
A1:	.LONG	1
	.ADDRESS A1_1
A1_1:	.ASCID	|[P1]|
; 2: again: it exists
A2:	.LONG	1
	.ADDRESS A2_1
A2_1:	.ASCID	|[P1]|
; 3: several levels
A3:	.LONG	1
	.ADDRESS A3_1
A3_1:	.ASCID	|[P2.A.B]|
; 4: a new leaf under existing levels
A4:	.LONG	1
	.ADDRESS A4_1
A4_1:	.ASCID	|[P2.A.C]|
; 5: owner-UIC
A5:	.LONG	2
	.ADDRESS A5_1
	.ADDRESS A5_2
A5_1:	.ASCID	|[P3]|
A5_2:	.LONG	^X800081
; 6: owner-UIC 0: the parent's
A6:	.LONG	2
	.ADDRESS A6_1
	.ADDRESS A6_2
A6_1:	.ASCID	|[P3.CHILD]|
A6_2:	.LONG	^X0
; 7: owner-UIC omitted: the parent's
A7:	.LONG	1
	.ADDRESS A7_1
A7_1:	.ASCID	|[P3.OMIT]|
; 8: enable world, value W:R
A8:	.LONG	4
	.ADDRESS A8_1
	.LONG	0
	.ADDRESS A8_3
	.ADDRESS A8_4
A8_1:	.ASCID	|[P4]|
A8_3:	.WORD	^XF000
	.ALIGN	LONG
A8_4:	.WORD	^XE000
	.ALIGN	LONG
; 9: enable 0: value ignored
A9:	.LONG	4
	.ADDRESS A9_1
	.LONG	0
	.ADDRESS A9_3
	.ADDRESS A9_4
A9_1:	.ASCID	|[P4E]|
A9_3:	.WORD	^X0
	.ALIGN	LONG
A9_4:	.WORD	^XFFFF
	.ALIGN	LONG
; 10: value omitted with enable
A10:	.LONG	3
	.ADDRESS A10_1
	.LONG	0
	.ADDRESS A10_3
A10_1:	.ASCID	|[P4V]|
A10_3:	.WORD	^XF000
	.ALIGN	LONG
; 11: the manual's parent, %X13FF
A11:	.LONG	4
	.ADDRESS A11_1
	.LONG	0
	.ADDRESS A11_3
	.ADDRESS A11_4
A11_1:	.ASCID	|[P5]|
A11_3:	.WORD	^XFFFF
	.ALIGN	LONG
A11_4:	.WORD	^X13FF
	.ALIGN	LONG
; 12: the manual's example, %XDBFF/%X37FF
A12:	.LONG	4
	.ADDRESS A12_1
	.LONG	0
	.ADDRESS A12_3
	.ADDRESS A12_4
A12_1:	.ASCID	|[P5.EX]|
A12_3:	.WORD	^XDBFF
	.ALIGN	LONG
A12_4:	.WORD	^X37FF
	.ALIGN	LONG
; 13: maximum-versions 3
A13:	.LONG	5
	.ADDRESS A13_1
	.LONG	0
	.LONG	0
	.LONG	0
	.ADDRESS A13_5
A13_1:	.ASCID	|[P6]|
A13_5:	.WORD	^X3
	.ALIGN	LONG
; 14: maximum-versions omitted: the parent's
A14:	.LONG	1
	.ADDRESS A14_1
A14_1:	.ASCID	|[P6.INH]|
; 15: maximum-versions 0: no limit
A15:	.LONG	5
	.ADDRESS A15_1
	.LONG	0
	.LONG	0
	.LONG	0
	.ADDRESS A15_5
A15_1:	.ASCID	|[P6.ZERO]|
A15_5:	.WORD	^X0
	.ALIGN	LONG
; 16: all six arguments, volume 1
A16:	.LONG	6
	.ADDRESS A16_1
	.ADDRESS A16_2
	.ADDRESS A16_3
	.ADDRESS A16_4
	.ADDRESS A16_5
	.ADDRESS A16_6
A16_1:	.ASCID	|[P7]|
A16_2:	.LONG	^XC000C1
A16_3:	.WORD	^XF
	.ALIGN	LONG
A16_4:	.WORD	^X0
	.ALIGN	LONG
A16_5:	.WORD	^X2
	.ALIGN	LONG
A16_6:	.WORD	^X1
	.ALIGN	LONG
; 17: a seventh argument (initial allocation?)
A17:	.LONG	7
	.ADDRESS A17_1
	.LONG	0
	.LONG	0
	.LONG	0
	.LONG	0
	.LONG	0
	.ADDRESS A17_7
A17_1:	.ASCID	|[P8]|
A17_7:	.LONG	^X4
; 18: a device by logical name
A18:	.LONG	1
	.ADDRESS A18_1
A18_1:	.ASCID	|CRDDEV:[P10]|
; 19: UIC format
A19:	.LONG	1
	.ADDRESS A19_1
A19_1:	.ASCID	|[123,321]|
; 20: UIC format with owner-UIC
A20:	.LONG	2
	.ADDRESS A20_1
	.ADDRESS A20_2
A20_1:	.ASCID	|[1,4]|
A20_2:	.LONG	^X800081
; 21: relative to the default
A21:	.LONG	1
	.ADDRESS A21_1
A21_1:	.ASCID	|[.SUBREL]|
; 22: relative, above the MFD
A22:	.LONG	1
	.ADDRESS A22_1
A22_1:	.ASCID	|[-.UP]|
; 23: no directory
A23:	.LONG	1
	.ADDRESS A23_1
A23_1:	.ASCID	|CRDDEV:|
; 24: a directory from a logical name only
A24:	.LONG	1
	.ADDRESS A24_1
A24_1:	.ASCID	|CRDLOG:|
; 25: a file name
A25:	.LONG	1
	.ADDRESS A25_1
A25_1:	.ASCID	|[P1]X.DAT|
; 26: a version
A26:	.LONG	1
	.ADDRESS A26_1
A26_1:	.ASCID	|[P1];1|
; 27: a wildcard
A27:	.LONG	1
	.ADDRESS A27_1
A27_1:	.ASCID	|[P*]|
; 28: a node
A28:	.LONG	1
	.ADDRESS A28_1
A28_1:	.ASCID	|NODE::[P9]|
; 29: no such device
A29:	.LONG	1
	.ADDRESS A29_1
A29_1:	.ASCID	|NOSUCH:[X]|
; 30: nine levels
A30:	.LONG	1
	.ADDRESS A30_1
A30_1:	.ASCID	|[L1.L2.L3.L4.L5.L6.L7.L8.L9]|
; 31: a 40-character name
A31:	.LONG	1
	.ADDRESS A31_1
A31_1:	.ASCID	|[ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789ABCD]|
; 32: a 256-character spec
A32:	.LONG	1
	.ADDRESS A32_1
A32_1:	.WORD	256
	.BYTE	14,1
	.ADDRESS A32_1_S
A32_1_S:	.ASCII	|[|
	.ASCII	|ABCDEFGHIJABCDEFGHIJABCDEFGHIJABCDEFGHIJABCDEFGHIJ|
	.ASCII	|ABCDEFGHIJABCDEFGHIJABCDEFGHIJABCDEFGHIJABCDEFGHIJ|
	.ASCII	|ABCDEFGHIJABCDEFGHIJABCDEFGHIJABCDEFGHIJABCDEFGHIJ|
	.ASCII	|ABCDEFGHIJABCDEFGHIJABCDEFGHIJABCDEFGHIJABCDEFGHIJ|
	.ASCII	|ABCDEFGHIJABCDEFGHIJABCDEFGHIJABCDEFGHIJABCDEFGHIJ|
	.ASCII	|DIRS]|
; 33: no arguments
A33:	.LONG	0
; 34: a 0 descriptor address, under LIB$SIG_TO_RET
A34:	.LONG	1
	.LONG	0

	.PSECT	CODE,EXE,NOWRT,LONG
	.ENTRY	LIBCRD,^M<R2,R3,R4,R5,R6>
	$CREATE	FAB=OFAB
	BLBS	R0,1$
	RET
1$:	$CONNECT RAB=ORAB
	BLBS	R0,2$
	RET
2$:
	MOVL	#1,STEP
	CALLG	A1,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#2,STEP
	CALLG	A2,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#3,STEP
	CALLG	A3,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#4,STEP
	CALLG	A4,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#5,STEP
	CALLG	A5,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#6,STEP
	CALLG	A6,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#7,STEP
	CALLG	A7,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#8,STEP
	CALLG	A8,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#9,STEP
	CALLG	A9,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#10,STEP
	CALLG	A10,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#11,STEP
	CALLG	A11,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#12,STEP
	CALLG	A12,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#13,STEP
	CALLG	A13,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#14,STEP
	CALLG	A14,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#15,STEP
	CALLG	A15,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#16,STEP
	CALLG	A16,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#17,STEP
	CALLG	A17,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#18,STEP
	CALLG	A18,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#19,STEP
	CALLG	A19,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#20,STEP
	CALLG	A20,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#21,STEP
	CALLG	A21,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#22,STEP
	CALLG	A22,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#23,STEP
	CALLG	A23,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#24,STEP
	CALLG	A24,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#25,STEP
	CALLG	A25,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#26,STEP
	CALLG	A26,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#27,STEP
	CALLG	A27,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#28,STEP
	CALLG	A28,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#29,STEP
	CALLG	A29,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#30,STEP
	CALLG	A30,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#31,STEP
	CALLG	A31,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#32,STEP
	CALLG	A32,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#33,STEP
	CALLG	A33,G^LIB$CREATE_DIR
	JSB	SAVE
	MOVL	#34,STEP
	CALLS	#0,C34
	JSB	SAVE
	$CLOSE	FAB=OFAB
	MOVL	#1,R0
	RET

; SAVE writes the case number and R0.
SAVE:	MOVL	R0,STAT
	$PUT	RAB=ORAB
	RSB

; 34, with LIB$SIG_TO_RET as its handler.
	.ENTRY	C34,^M<>
	PUSHAB	G^LIB$SIG_TO_RET
	CALLS	#1,G^LIB$ESTABLISH
	CALLG	A34,G^LIB$CREATE_DIR
	RET

	.END	LIBCRD
