$ ! CREDIR.COM - the Phase 34 oracle: CREATE/DIRECTORY's qualifiers and
$ ! defaults, as VMS 7.3 does them. Run it once, with the exchange
$ ! volume's [000000] as the default directory:
$ !
$ !     @CREDIR/OUTPUT=CREDIR.LOG
$ !
$ ! Some commands fail on purpose; SET NOON keeps going past them.
$ !
$ SET NOON
$ SET VERIFY
$ DEV = F$PARSE("[000000]",,,"DEVICE")
$ SET DEFAULT 'DEV'[000000]
$ WRITE SYS$OUTPUT "UIC ", F$GETJPI("","UIC")
$ !
$ ! Defaults, and a directory that already exists.
$ CREATE/DIRECTORY/LOG [PLAIN]
$ CREATE/DIRECTORY/LOG [PLAIN]
$ CREATE/DIRECTORY [PLAIN]
$ CREATE/DIRECTORY/LOG/VERSION_LIMIT=5/OWNER_UIC=[7,7] [PLAIN]
$ !
$ ! /OWNER_UIC.
$ CREATE/DIRECTORY/LOG/OWNER_UIC=[200,201] [OWNED]
$ CREATE/DIRECTORY/LOG [OWNED.CHILD]
$ CREATE/DIRECTORY/LOG/OWNER_UIC=PARENT [OWNED.PCHILD]
$ CREATE/DIRECTORY/LOG/OWNER_UIC=[1,4] [OWNED.SELF]
$ CREATE/DIRECTORY/LOG/OWNER_UIC=PARENT [PARENTTOP]
$ !
$ ! /VERSION_LIMIT.
$ CREATE/DIRECTORY/LOG/VERSION_LIMIT=3 [LIMITED]
$ CREATE/DIRECTORY/LOG [LIMITED.INHERIT]
$ CREATE/DIRECTORY/LOG/VERSION_LIMIT=0 [LIMITED.NONE]
$ CREATE/DIRECTORY/LOG/VERSION_LIMIT=7 [LIMITED.SEVEN]
$ !
$ ! /PROTECTION.
$ CREATE/DIRECTORY/LOG/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) [PROT]
$ CREATE/DIRECTORY/LOG [PROT.INHERIT]
$ CREATE/DIRECTORY/LOG/PROTECTION=(S:RWE,O:RW,G,W) [PROT.EXPLICIT]
$ CREATE/DIRECTORY/LOG/PROTECTION=(G:R) [PROT.PARTIAL]
$ CREATE/DIRECTORY/LOG/PROTECTION=(SYSTEM:RWED,OWNER:RWED,GROUP:RE,WORLD) [PROT.LONG]
$ !
$ ! /ALLOCATION.
$ CREATE/DIRECTORY/LOG/ALLOCATION=4 [ALLOC]
$ !
$ ! Several levels at once, with and without qualifiers.
$ CREATE/DIRECTORY/LOG [DEEP.A.B]
$ CREATE/DIRECTORY/LOG/OWNER_UIC=[300,301]/VERSION_LIMIT=2 [DEEPER.X.Y]
$ CREATE/DIRECTORY/LOG/PROTECTION=(W:RE) [DEEPEST.P.Q]
$ !
$ ! A list.
$ CREATE/DIRECTORY/LOG [LIST1],[LIST2]
$ !
$ ! Relative directories, and a logical name for the device.
$ SET DEFAULT [PLAIN]
$ CREATE/DIRECTORY/LOG [.SUB]
$ CREATE/DIRECTORY/LOG [-.SIBLING]
$ SET DEFAULT [000000]
$ DEFINE CREDEV 'DEV'
$ CREATE/DIRECTORY/LOG CREDEV:[LOGICAL]
$ DEASSIGN CREDEV
$ !
$ ! Names at and past the limits.
$ CREATE/DIRECTORY/LOG [ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789ABC]
$ CREATE/DIRECTORY/LOG [ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789ABCD]
$ CREATE/DIRECTORY/LOG [L1.L2.L3.L4.L5.L6.L7.L8]
$ CREATE/DIRECTORY/LOG [L1.L2.L3.L4.L5.L6.L7.L8.L9]
$ !
$ ! Errors.
$ CREATE/DIRECTORY/LOG [PLAIN]FILE.DAT
$ CREATE/DIRECTORY/LOG [WILD*]
$ CREATE/DIRECTORY/LOG [PLAIN...]
$ CREATE/DIRECTORY/LOG/OWNER_UIC=[400000,1] [BADUIC]
$ CREATE/DIRECTORY/LOG/VERSION_LIMIT=40000 [BADLIMIT]
$ CREATE/DIRECTORY/LOG NOSUCH:[X]
$ !
$ ! A file in a new directory, so the directory's first entry is seen.
$ CREATE [ALLOC]FIRST.DAT
FIRST.DAT
$ !
$ DIRECTORY/FULL [000000...]*.DIR
$ DIRECTORY/OWNER/PROTECTION/FILE_ID/SIZE=ALL [000000...]*.DIR
$ DIRECTORY/OWNER/PROTECTION [ALLOC]
