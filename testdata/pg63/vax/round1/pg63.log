%LIB-F-INSVIRMEM, insufficient virtual memory
$ WSV:
$ WRITE SYS$OUTPUT "ws dfwscnt=", F$GETJPI("","DFWSCNT"), " wssize=", F$GETJPI("","WSSIZE"), -
	" quota=", F$GETJPI("","WSQUOTA"), " extent=", F$GETJPI("","WSEXTENT"), -
	" auth=", F$GETJPI("","WSAUTH"), " authext=", F$GETJPI("","WSAUTHEXT")
ws dfwscnt=94 wssize=94 quota=94 extent=16400 auth=1024 authext=16400
$ WRITE SYS$OUTPUT "ws ppg=", F$GETJPI("","PPGCNT"), " gpg=", F$GETJPI("","GPGCNT"), -
	" peak=", F$GETJPI("","WSPEAK"), " flts=", F$GETJPI("","PAGEFLTS")
ws ppg=70 gpg=22 peak=2162 flts=58941
$ RETURN
$ !
$ ! The program, assembled and linked, then run twice: part A and part B
$ ! (README.md), with automatic adjustment off.
$ !
$ DEFINE/USER_MODE SYS$OUTPUT PG63_BUILD.LOG
$ DEFINE/USER_MODE SYS$ERROR PG63_BUILD.LOG
$ MACRO/NOLIST PG63
%DCL-W-ACTIMAGE, error activating image LIBRTL
-CLI-E-IMGNAME, image file SIMVAX$DUA0:[SYS0.SYSCOMMON.][SYSLIB]LIBRTL.EXE
-SYSTEM-F-INSFWSL, insufficient working set limit
$ LINK/NOMAP PG63
%DCL-W-ACTIMAGE, error activating image LIBRTL
-CLI-E-IMGNAME, image file SIMVAX$DUA0:[SYS0.SYSCOMMON.][SYSLIB]LIBRTL.EXE
-SYSTEM-F-INSFWSL, insufficient working set limit
$ SET WORKING_SET/NOADJUST
%LIB-F-INSVIRMEM, insufficient virtual memory
$ GOSUB WSV
$ WSV:
$ WRITE SYS$OUTPUT "ws dfwscnt=", F$GETJPI("","DFWSCNT"), " wssize=", F$GETJPI("","WSSIZE"), -
	" quota=", F$GETJPI("","WSQUOTA"), " extent=", F$GETJPI("","WSEXTENT"), -
	" auth=", F$GETJPI("","WSAUTH"), " authext=", F$GETJPI("","WSAUTHEXT")
ws dfwscnt=94 wssize=94 quota=94 extent=16400 auth=1024 authext=16400
$ WRITE SYS$OUTPUT "ws ppg=", F$GETJPI("","PPGCNT"), " gpg=", F$GETJPI("","GPGCNT"), -
	" peak=", F$GETJPI("","WSPEAK"), " flts=", F$GETJPI("","PAGEFLTS")
ws ppg=68 gpg=22 peak=2162 flts=60936
$ RETURN
$ DEFINE/USER_MODE SYS$OUTPUT PG63A.OUT
$ RUN PG63
%DCL-W-ACTIMAGE, error activating image PG63
-CLI-E-IMAGEFNF, image file not found DUA1:[000000]PG63.EXE;
$ SHOW SYMBOL $STATUS
  $STATUS == "%X100388B2"
$ GOSUB WSV
$ WSV:
$ WRITE SYS$OUTPUT "ws dfwscnt=", F$GETJPI("","DFWSCNT"), " wssize=", F$GETJPI("","WSSIZE"), -
	" quota=", F$GETJPI("","WSQUOTA"), " extent=", F$GETJPI("","WSEXTENT"), -
	" auth=", F$GETJPI("","WSAUTH"), " authext=", F$GETJPI("","WSAUTHEXT")
ws dfwscnt=94 wssize=94 quota=94 extent=16400 auth=1024 authext=16400
$ WRITE SYS$OUTPUT "ws ppg=", F$GETJPI("","PPGCNT"), " gpg=", F$GETJPI("","GPGCNT"), -
	" peak=", F$GETJPI("","WSPEAK"), " flts=", F$GETJPI("","PAGEFLTS")
ws ppg=68 gpg=24 peak=2162 flts=62032
$ RETURN
$ DEFINE PG63_PART B
$ DEFINE/USER_MODE SYS$OUTPUT PG63B.OUT
$ RUN PG63
%DCL-W-ACTIMAGE, error activating image PG63
-CLI-E-IMAGEFNF, image file not found DUA1:[000000]PG63.EXE;
$ SHOW SYMBOL $STATUS
  $STATUS == "%X100388B2"
$ GOSUB WSV
$ WSV:
$ WRITE SYS$OUTPUT "ws dfwscnt=", F$GETJPI("","DFWSCNT"), " wssize=", F$GETJPI("","WSSIZE"), -
	" quota=", F$GETJPI("","WSQUOTA"), " extent=", F$GETJPI("","WSEXTENT"), -
	" auth=", F$GETJPI("","WSAUTH"), " authext=", F$GETJPI("","WSAUTHEXT")
ws dfwscnt=94 wssize=94 quota=94 extent=16400 auth=1024 authext=16400
$ WRITE SYS$OUTPUT "ws ppg=", F$GETJPI("","PPGCNT"), " gpg=", F$GETJPI("","GPGCNT"), -
	" peak=", F$GETJPI("","WSPEAK"), " flts=", F$GETJPI("","PAGEFLTS")
ws ppg=104 gpg=48 peak=2162 flts=63199
$ RETURN
$ DEASSIGN PG63_PART
$ SET WORKING_SET/ADJUST
%LIB-F-INSVIRMEM, insufficient virtual memory
$ TYPE PG63A.OUT
%STR-F-INSVIRMEM, insufficient virtual memory
$ TYPE PG63B.OUT
%STR-F-INSVIRMEM, insufficient virtual memory
$ !
$ ! The $PURGWS macro round (testdata/mp/macros, round 8).
$ !
$ @MACROS8/OUTPUT=MACROS8.LOG
