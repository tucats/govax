$ ! PG63.COM - Phase 63's probe of the working set (testdata/pg63/README.md).
$ ! Run it, from SYSTEM, with the exchange volume's [000000] as the default
$ ! directory:
$ !
$ !     @PG63/OUTPUT=PG63.LOG
$ !
$ ! PG63.LOG gets this procedure's log; PG63A.OUT and PG63B.OUT the
$ ! program's two runs; PG63S.LOG the subprocess's log; PG63_BUILD.LOG
$ ! MACRO's and LINK's messages; MACROS8.LOG the $PURGWS macro round's.
$ SET NOON
$ SET VERIFY
$ WRITE SYS$OUTPUT F$GETSYI("VERSION"), " ", F$GETSYI("HW_NAME")
$ GOSUB WSS
$ SHOW MEMORY/PHYSICAL_PAGES
$ RUN SYS$SYSTEM:SYSGEN
USE ACTIVE
SHOW MINWSCNT
SHOW WSMAX
SHOW GROWLIM
SHOW BORROWLIM
SHOW FREELIM
SHOW FREEGOAL
SHOW TBSKIPWSL
SHOW MPW_HILIMIT
SHOW MPW_LOLIMIT
SHOW MPW_WRTCLUSTER
SHOW PFCDEFAULT
SHOW PFRATL
SHOW PFRATH
SHOW WSINC
SHOW WSDEC
SHOW AWSTIME
SHOW AWSMIN
SHOW SWPOUTPGCNT
SHOW PQL_DWSDEFAULT
SHOW PQL_MWSDEFAULT
SHOW PQL_DWSQUOTA
SHOW PQL_MWSQUOTA
SHOW PQL_DWSEXTENT
SHOW PQL_MWSEXTENT
EXIT
$ !
$ ! SET WORKING_SET: each qualifier within and beyond its bounds, with
$ ! /LOG and without; then the values as they were. Round 1 found that
$ ! a quota near the floor leaves the process unable to run images, so
$ ! only values that keep the quota and extent at Q0 - 100 or more are
$ ! tried here; the rest are tried in subprocesses (PG63X.COM, below,
$ ! whose logs are typed here).
$ !
$ L0 = F$GETJPI("","DFWSCNT")
$ Q0 = F$GETJPI("","WSQUOTA")
$ E0 = F$GETJPI("","WSEXTENT")
$ AQ = F$GETJPI("","WSAUTH")
$ AE = F$GETJPI("","WSAUTHEXT")
$ M = F$GETSYI("MINWSCNT")
$ SET WORKING_SET
$ GOSUB WSS
$ X = Q0 - 100
$ SET WORKING_SET/QUOTA='X'/LOG
$ GOSUB WSS
$ X = Q0 - 90
$ SET WORKING_SET/QUOTA='X'
$ GOSUB WSS
$ X = Q0 - 50
$ SET WORKING_SET/LIMIT='X'/LOG
$ GOSUB WSS
$ X = AQ + 100
$ SET WORKING_SET/LIMIT='X'/LOG
$ GOSUB WSS
$ X = AE + 100
$ SET WORKING_SET/LIMIT='X'/LOG
$ GOSUB WSS
$ SET WORKING_SET/LIMIT='L0'/QUOTA='Q0'/LOG
$ GOSUB WSS
$ X = AQ + 100
$ SET WORKING_SET/QUOTA='X'
$ GOSUB WSS
$ X = E0 - 1000
$ SET WORKING_SET/EXTENT='X'/LOG
$ GOSUB WSS
$ X = AE + 100
$ SET WORKING_SET/EXTENT='X'
$ GOSUB WSS
$ X = L0 - 100
$ SET WORKING_SET/LIMIT='X'/LOG
$ GOSUB WSS
$ SET WORKING_SET/EXTENT='E0'/QUOTA='Q0'/LIMIT='L0'/LOG
$ GOSUB WSS
$ SET WORKING_SET/NOADJUST
$ GOSUB WSS
$ SET WORKING_SET/ADJUST
$ GOSUB WSS
$ !
$ ! The values near and below the floor, each in a subprocess of its own,
$ ! which may be left unable to run images: PG63X.COM shows its values,
$ ! sets them, and shows them again with lexical functions, which need no
$ ! image.
$ !
$ SPAWN/OUTPUT=PG63X.LOG @PG63X "/LIMIT=50/LOG"
$ TYPE PG63X.LOG
$ SPAWN/OUTPUT=PG63X.LOG @PG63X "/LIMIT=5/LOG"
$ TYPE PG63X.LOG
$ SPAWN/OUTPUT=PG63X.LOG @PG63X "/LIMIT=0/LOG"
$ TYPE PG63X.LOG
$ SPAWN/OUTPUT=PG63X.LOG @PG63X "/QUOTA=300/LOG"
$ TYPE PG63X.LOG
$ SPAWN/OUTPUT=PG63X.LOG @PG63X "/QUOTA=200/LOG"
$ TYPE PG63X.LOG
$ SPAWN/OUTPUT=PG63X.LOG @PG63X "/QUOTA=5/LOG"
$ TYPE PG63X.LOG
$ SPAWN/OUTPUT=PG63X.LOG @PG63X "/QUOTA=5"
$ TYPE PG63X.LOG
$ SPAWN/OUTPUT=PG63X.LOG @PG63X "/QUOTA=0/LOG"
$ TYPE PG63X.LOG
$ SPAWN/OUTPUT=PG63X.LOG @PG63X "/EXTENT=300/LOG"
$ TYPE PG63X.LOG
$ SPAWN/OUTPUT=PG63X.LOG @PG63X "/EXTENT=21/LOG"
$ TYPE PG63X.LOG
$ SPAWN/OUTPUT=PG63X.LOG @PG63X "/EXTENT=20/LOG"
$ TYPE PG63X.LOG
$ SPAWN/OUTPUT=PG63X.LOG @PG63X "/EXTENT=19/LOG"
$ TYPE PG63X.LOG
$ SPAWN/OUTPUT=PG63X.LOG @PG63X "/EXTENT=0/LOG"
$ TYPE PG63X.LOG
$ GOSUB WSS
$ !
$ ! A subprocess's own values.
$ !
$ SPAWN/OUTPUT=PG63S.LOG @PG63S
$ TYPE PG63S.LOG
$ GOSUB WSS
$ !
$ ! The program, assembled and linked, then run twice: part A and part B
$ ! (README.md), with automatic adjustment off.
$ !
$ DEFINE/USER_MODE SYS$OUTPUT PG63_BUILD.LOG
$ DEFINE/USER_MODE SYS$ERROR PG63_BUILD.LOG
$ MACRO/NOLIST PG63
$ LINK/NOMAP PG63
$ SET WORKING_SET/NOADJUST
$ GOSUB WSV
$ DEFINE/USER_MODE SYS$OUTPUT PG63A.OUT
$ RUN PG63
$ SHOW SYMBOL $STATUS
$ GOSUB WSV
$ DEFINE PG63_PART B
$ DEFINE/USER_MODE SYS$OUTPUT PG63B.OUT
$ RUN PG63
$ SHOW SYMBOL $STATUS
$ GOSUB WSV
$ DEASSIGN PG63_PART
$ SET WORKING_SET/ADJUST
$ TYPE PG63A.OUT
$ TYPE PG63B.OUT
$ !
$ ! The $PURGWS macro round (testdata/mp/macros, round 8).
$ !
$ @MACROS8/OUTPUT=MACROS8.LOG
$ SET NOVERIFY
$ EXIT
$ !
$ ! WSS: SHOW WORKING_SET, then WSV. WSV: the working set's values.
$ !
$ WSS:
$ SHOW WORKING_SET
$ WSV:
$ WRITE SYS$OUTPUT "ws dfwscnt=", F$GETJPI("","DFWSCNT"), " wssize=", F$GETJPI("","WSSIZE"), -
	" quota=", F$GETJPI("","WSQUOTA"), " extent=", F$GETJPI("","WSEXTENT"), -
	" auth=", F$GETJPI("","WSAUTH"), " authext=", F$GETJPI("","WSAUTHEXT")
$ WRITE SYS$OUTPUT "ws ppg=", F$GETJPI("","PPGCNT"), " gpg=", F$GETJPI("","GPGCNT"), -
	" peak=", F$GETJPI("","WSPEAK"), " flts=", F$GETJPI("","PAGEFLTS")
$ RETURN
