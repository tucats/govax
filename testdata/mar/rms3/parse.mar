	.TITLE	PARSE	Phase 33 runtime oracle
	.IDENT	/V1.0/

; $PARSE: each case's result, without a search. Cases 13 and 14 give a
; related file (NAM$L_RLF) whose resultant string is [TEST]B.TXT;1, without
; and with FAB$V_OFP.

	$FABDEF
	$NAMDEF
	$RABDEF

; DUMP writes one record: TAG, the step, the op, and LEN bytes at ADDR.
	.MACRO	DUMP	TAG,ADDR,LEN
	MOVL	#^A/TAG/,REC
	MOVL	STEP,REC+4
	MOVL	OP,REC+8
	MOVC3	#LEN,ADDR,REC+12
	MOVZWL	#LEN+12,R6
	JSB	PUTREC
	.ENDM	DUMP

	.PSECT	DATA,NOEXE,WRT,LONG
OFAB:	$FAB	FNM=<[OUT]PARSE.DMP>,FAC=PUT,RFM=VAR,MRS=1024
ORAB:	$RAB	FAB=OFAB,RBF=REC
FABT:	$FAB	NAM=NAM1
RNAM:	$NAM	RSA=RSTR,RSS=64
RSTR:	.ASCII	/[TEST]B.TXT;1/
RSTRL = .-RSTR
	.BLKB	64
	.ALIGN	LONG
FAB1:	.BLKB	FAB$C_BLN
NAMT:	$NAM	ESA=ESA,ESS=255,RSA=RSA,RSS=255
NAM1:	.BLKB	NAM$C_BLN
STEP:	.LONG	0
OP:	.LONG	0
STAT:	.LONG	0
ESA:	.BLKB	256
RSA:	.BLKB	256
REC:	.BLKB	1024
S1:	.ASCII	|[TEST]A.DAT|
S1_L = .-S1
S2:	.ASCII	||
S2_L = .-S2
S3:	.ASCII	|A|
S3_L = .-S3
S4:	.ASCII	|[TEST].DAT|
S4_L = .-S4
