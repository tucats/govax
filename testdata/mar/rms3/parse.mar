	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S53,FAB1+FAB$L_FNA
	MOVB	#S53_L,FAB1+FAB$B_FNS
	MOVAB	S54,FAB1+FAB$L_DNA
	MOVB	#S54_L,FAB1+FAB$B_DNS
	CLRB	NAM1+NAM$B_ESS
	$PARSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#1,OP
	JSB	DUMPALL
	MOVL	#28,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S55,FAB1+FAB$L_FNA
	MOVB	#S55_L,FAB1+FAB$B_FNS
	MOVAB	S56,FAB1+FAB$L_DNA
	MOVB	#S56_L,FAB1+FAB$B_DNS
	MOVB	#NAM$M_SYNCHK,NAM1+NAM$B_NOP
	MOVB	#2,NAM1+NAM$B_ESS
	$PARSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#1,OP
	JSB	DUMPALL
	MOVL	#29,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S57,FAB1+FAB$L_FNA
	MOVB	#S57_L,FAB1+FAB$B_FNS
	MOVAB	S58,FAB1+FAB$L_DNA
	MOVB	#S58_L,FAB1+FAB$B_DNS
	MOVW	#1,FAB1+FAB$W_IFI
	$PARSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#1,OP
	JSB	DUMPALL
	MOVL	#30,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S59,FAB1+FAB$L_FNA
	MOVB	#S59_L,FAB1+FAB$B_FNS
	MOVAB	S60,FAB1+FAB$L_DNA
	MOVB	#S60_L,FAB1+FAB$B_DNS
	MOVB	#NAM$C_BID+1,NAM1+NAM$B_BID
	$PARSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#1,OP
	JSB	DUMPALL
	$CLOSE	FAB=OFAB
	RET

; PUTREC writes REC's first R6 bytes to the output file.
PUTREC:	MOVW	R6,ORAB+RAB$W_RSZ
	$PUT	RAB=ORAB
	RSB

; DUMPALL writes STAT, FAB1, NAM1, and the two string buffers.
DUMPALL:
	DUMP	STAT,STAT,4
	DUMP	FAB_,FAB1,FAB$C_BLN
	DUMP	NAM_,NAM1,NAM$C_BLN
	DUMP	ESA_,ESA,256
	DUMP	RSA_,RSA,256
	RSB

	.END	PARSE
