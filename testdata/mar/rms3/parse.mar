	.PSECT	CODE,EXE,NOWRT,LONG
	.ENTRY	PARSE,^M<R2,R3,R4,R5,R6,R7>
	$CREATE	FAB=OFAB
	BLBS	R0,1$
	RET
1$:	$CONNECT RAB=ORAB
	BLBS	R0,2$
	RET
