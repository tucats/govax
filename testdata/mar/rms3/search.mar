	$PARSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#1,OP
	JSB	DUMPALL
	BLBS	STAT,L21
	BRW	L20
L21:
	CLRL	R7
L19:	INCL	R7
	ADDL3	#700,R7,STEP
	$SEARCH	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#2,OP
	JSB	DUMPALL
	BLBC	STAT,L20
	CMPL	R7,#30
	BLSS	L19
L20:
	MOVL	#8,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S15,FAB1+FAB$L_FNA
	MOVB	#S15_L,FAB1+FAB$B_FNS
	MOVAB	S16,FAB1+FAB$L_DNA
	MOVB	#S16_L,FAB1+FAB$B_DNS
	$PARSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#1,OP
	JSB	DUMPALL
	BLBS	STAT,L24
	BRW	L23
L24:
	CLRL	R7
L22:	INCL	R7
	ADDL3	#800,R7,STEP
	$SEARCH	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#2,OP
	JSB	DUMPALL
	BLBC	STAT,L23
	CMPL	R7,#30
	BLSS	L22
L23:
	MOVL	#9,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S17,FAB1+FAB$L_FNA
	MOVB	#S17_L,FAB1+FAB$B_FNS
	MOVAB	S18,FAB1+FAB$L_DNA
	MOVB	#S18_L,FAB1+FAB$B_DNS
	$PARSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#1,OP
	JSB	DUMPALL
	BLBS	STAT,L27
	BRW	L26
L27:
	CLRL	R7
L25:	INCL	R7
	ADDL3	#900,R7,STEP
	$SEARCH	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#2,OP
	JSB	DUMPALL
	BLBC	STAT,L26
	CMPL	R7,#30
	BLSS	L25
L26:
	MOVL	#10,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S19,FAB1+FAB$L_FNA
	MOVB	#S19_L,FAB1+FAB$B_FNS
	MOVAB	S20,FAB1+FAB$L_DNA
	MOVB	#S20_L,FAB1+FAB$B_DNS
	$PARSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#1,OP
	JSB	DUMPALL
	BLBS	STAT,L30
	BRW	L29
L30:
	CLRL	R7
L28:	INCL	R7
	ADDL3	#1000,R7,STEP
	$SEARCH	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#2,OP
	JSB	DUMPALL
	BLBC	STAT,L29
	CMPL	R7,#30
	BLSS	L28
L29:
	MOVL	#11,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S21,FAB1+FAB$L_FNA
	MOVB	#S21_L,FAB1+FAB$B_FNS
	MOVAB	S22,FAB1+FAB$L_DNA
	MOVB	#S22_L,FAB1+FAB$B_DNS
	$PARSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#1,OP
	JSB	DUMPALL
	BLBS	STAT,L33
	BRW	L32
L33:
	CLRL	R7
L31:	INCL	R7
	ADDL3	#1100,R7,STEP
	$SEARCH	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#2,OP
	JSB	DUMPALL
	BLBC	STAT,L32
	CMPL	R7,#30
	BLSS	L31
L32:
	MOVL	#12,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S23,FAB1+FAB$L_FNA
	MOVB	#S23_L,FAB1+FAB$B_FNS
	MOVAB	S24,FAB1+FAB$L_DNA
	MOVB	#S24_L,FAB1+FAB$B_DNS
	$PARSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#1,OP
	JSB	DUMPALL
	BLBS	STAT,L36
	BRW	L35
L36:
	CLRL	R7
L34:	INCL	R7
	ADDL3	#1200,R7,STEP
	$SEARCH	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#2,OP
	JSB	DUMPALL
	BLBC	STAT,L35
	CMPL	R7,#30
	BLSS	L34
L35:
	MOVL	#13,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S25,FAB1+FAB$L_FNA
	MOVB	#S25_L,FAB1+FAB$B_FNS
	MOVAB	S26,FAB1+FAB$L_DNA
	MOVB	#S26_L,FAB1+FAB$B_DNS
	$PARSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#1,OP
	JSB	DUMPALL
	BLBS	STAT,L39
	BRW	L38
L39:
	CLRL	R7
L37:	INCL	R7
	ADDL3	#1300,R7,STEP
	$SEARCH	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#2,OP
	JSB	DUMPALL
	BLBC	STAT,L38
	CMPL	R7,#30
	BLSS	L37
L38:
	MOVL	#14,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S27,FAB1+FAB$L_FNA
	MOVB	#S27_L,FAB1+FAB$B_FNS
	MOVAB	S28,FAB1+FAB$L_DNA
	MOVB	#S28_L,FAB1+FAB$B_DNS
	$PARSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#1,OP
	JSB	DUMPALL
	BLBS	STAT,L42
	BRW	L41
L42:
	CLRL	R7
L40:	INCL	R7
	ADDL3	#1400,R7,STEP
	$SEARCH	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#2,OP
	JSB	DUMPALL
	BLBC	STAT,L41
	CMPL	R7,#30
	BLSS	L40
L41:
	MOVL	#15,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S29,FAB1+FAB$L_FNA
	MOVB	#S29_L,FAB1+FAB$B_FNS
	MOVAB	S30,FAB1+FAB$L_DNA
	MOVB	#S30_L,FAB1+FAB$B_DNS
	$PARSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#1,OP
	JSB	DUMPALL
	BLBS	STAT,L45
	BRW	L44
L45:
	CLRL	R7
L43:	INCL	R7
	ADDL3	#1500,R7,STEP
	$SEARCH	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#2,OP
	JSB	DUMPALL
	BLBC	STAT,L44
	CMPL	R7,#30
	BLSS	L43
L44:
	MOVL	#16,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S31,FAB1+FAB$L_FNA
	MOVB	#S31_L,FAB1+FAB$B_FNS
	MOVAB	S32,FAB1+FAB$L_DNA
	MOVB	#S32_L,FAB1+FAB$B_DNS
	$SEARCH	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#2,OP
	JSB	DUMPALL
	$CLOSE	FAB=OFAB
	RET

; PUTREC writes REC's first R6 bytes to the output file.
PUTREC:	MOVW	R6,ORAB+RAB$W_RSZ
	$PUT	RAB=ORAB
	RSB

; DUMPALL writes STAT, FAB1, NAM1, and the two string buffers.
DUMPALL:
	DUMP	STAT,STAT,4
	DUMP	FAB_,FAB1,FAB$C_BLN
	DUMP	NAM_,NAM1,NAM$C_BLN
	DUMP	ESA_,ESA,256
	DUMP	RSA_,RSA,256
	RSB

	.END	SEARCH
