	.TITLE	SEARCH	Phase 33 runtime oracle
	.IDENT	/V1.0/

; $SEARCH: each case is a $PARSE, then $SEARCH until it fails (at most
; 30 times). The last case calls $SEARCH with no $PARSE first.

	$FABDEF
	$NAMDEF
	$RABDEF

; DUMP writes one record: TAG, the step, the op, and LEN bytes at ADDR.
	.MACRO	DUMP	TAG,ADDR,LEN
	MOVL	#^A/TAG/,REC
	MOVL	STEP,REC+4
	MOVL	OP,REC+8
	MOVC3	#LEN,ADDR,REC+12
	MOVZWL	#LEN+12,R6
	JSB	PUTREC
	.ENDM	DUMP

	.PSECT	DATA,NOEXE,WRT,LONG
OFAB:	$FAB	FNM=<[OUT]SEARCH.DMP>,FAC=PUT,RFM=VAR,MRS=1024
ORAB:	$RAB	FAB=OFAB,RBF=REC
FABT:	$FAB	NAM=NAM1
	.ALIGN	LONG
FAB1:	.BLKB	FAB$C_BLN
NAMT:	$NAM	ESA=ESA,ESS=255,RSA=RSA,RSS=255
NAM1:	.BLKB	NAM$C_BLN
STEP:	.LONG	0
OP:	.LONG	0
STAT:	.LONG	0
ESA:	.BLKB	256
RSA:	.BLKB	256
REC:	.BLKB	1024
S1:	.ASCII	|[TEST]*.DAT;*|
S1_L = .-S1
S2:	.ASCII	||
S2_L = .-S2
S3:	.ASCII	|[TEST]A.DAT|
S3_L = .-S3
S4:	.ASCII	||
S4_L = .-S4
S5:	.ASCII	|[TEST...]*.*;*|
S5_L = .-S5
S6:	.ASCII	||
S6_L = .-S6
S7:	.ASCII	|[TEST]*.NONE|
S7_L = .-S7
S8:	.ASCII	||
S8_L = .-S8
S9:	.ASCII	|[TEST.EMPTY]*.*;*|
S9_L = .-S9
S10:	.ASCII	||
S10_L = .-S10
S11:	.ASCII	|TSL:*.DAT|
S11_L = .-S11
S12:	.ASCII	||
S12_L = .-S12
S13:	.ASCII	|[TEST]A.DAT;*|
S13_L = .-S13
S14:	.ASCII	||
S14_L = .-S14
S15:	.ASCII	|[TEST]%.DAT|
S15_L = .-S15
S16:	.ASCII	||
S16_L = .-S16
S17:	.ASCII	|[*]*.DAT|
S17_L = .-S17
S18:	.ASCII	||
S18_L = .-S18
S19:	.ASCII	|[TEST]A.DAT;-1|
S19_L = .-S19
S20:	.ASCII	||
S20_L = .-S20
S21:	.ASCII	|[TEST]A.DAT;0|
S21_L = .-S21
S22:	.ASCII	||
S22_L = .-S22
S23:	.ASCII	|[TEST]*.*|
S23_L = .-S23
S24:	.ASCII	||
S24_L = .-S24
S25:	.ASCII	|[TEST]NONE.DAT|
S25_L = .-S25
S26:	.ASCII	||
S26_L = .-S26
S27:	.ASCII	|[NOSUCH]*.*|
S27_L = .-S27
S28:	.ASCII	||
S28_L = .-S28
S29:	.ASCII	|[TEST]*.DAT;2|
S29_L = .-S29
S30:	.ASCII	||
S30_L = .-S30
S31:	.ASCII	|[TEST]A.DAT|
S31_L = .-S31
S32:	.ASCII	||
S32_L = .-S32

	.PSECT	CODE,EXE,NOWRT,LONG
	.ENTRY	SEARCH,^M<R2,R3,R4,R5,R6,R7>
	$CREATE	FAB=OFAB
	BLBS	R0,1$
	RET
1$:	$CONNECT RAB=ORAB
	BLBS	R0,2$
	RET
2$:
	MOVL	#1,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S1,FAB1+FAB$L_FNA
	MOVB	#S1_L,FAB1+FAB$B_FNS
	MOVAB	S2,FAB1+FAB$L_DNA
	MOVB	#S2_L,FAB1+FAB$B_DNS
	$PARSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#1,OP
	JSB	DUMPALL
	BLBS	STAT,L3
	BRW	L2
L3:
	CLRL	R7
L1:	INCL	R7
	ADDL3	#100,R7,STEP
	$SEARCH	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#2,OP
	JSB	DUMPALL
	BLBC	STAT,L2
	CMPL	R7,#30
	BLSS	L1
L2:
	MOVL	#2,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S3,FAB1+FAB$L_FNA
	MOVB	#S3_L,FAB1+FAB$B_FNS
	MOVAB	S4,FAB1+FAB$L_DNA
	MOVB	#S4_L,FAB1+FAB$B_DNS
	$PARSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#1,OP
	JSB	DUMPALL
	BLBS	STAT,L6
	BRW	L5
L6:
	CLRL	R7
L4:	INCL	R7
	ADDL3	#200,R7,STEP
	$SEARCH	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#2,OP
	JSB	DUMPALL
	BLBC	STAT,L5
	CMPL	R7,#30
	BLSS	L4
L5:
	MOVL	#3,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S5,FAB1+FAB$L_FNA
	MOVB	#S5_L,FAB1+FAB$B_FNS
	MOVAB	S6,FAB1+FAB$L_DNA
	MOVB	#S6_L,FAB1+FAB$B_DNS
	$PARSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#1,OP
	JSB	DUMPALL
	BLBS	STAT,L9
	BRW	L8
L9:
	CLRL	R7
L7:	INCL	R7
	ADDL3	#300,R7,STEP
	$SEARCH	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#2,OP
	JSB	DUMPALL
	BLBC	STAT,L8
	CMPL	R7,#30
	BLSS	L7
L8:
	MOVL	#4,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S7,FAB1+FAB$L_FNA
	MOVB	#S7_L,FAB1+FAB$B_FNS
	MOVAB	S8,FAB1+FAB$L_DNA
	MOVB	#S8_L,FAB1+FAB$B_DNS
	$PARSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#1,OP
	JSB	DUMPALL
	BLBS	STAT,L12
	BRW	L11
L12:
	CLRL	R7
L10:	INCL	R7
	ADDL3	#400,R7,STEP
	$SEARCH	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#2,OP
	JSB	DUMPALL
	BLBC	STAT,L11
	CMPL	R7,#30
	BLSS	L10
L11:
	MOVL	#5,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S9,FAB1+FAB$L_FNA
	MOVB	#S9_L,FAB1+FAB$B_FNS
	MOVAB	S10,FAB1+FAB$L_DNA
	MOVB	#S10_L,FAB1+FAB$B_DNS
	$PARSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#1,OP
	JSB	DUMPALL
	BLBS	STAT,L15
	BRW	L14
L15:
	CLRL	R7
L13:	INCL	R7
	ADDL3	#500,R7,STEP
	$SEARCH	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#2,OP
	JSB	DUMPALL
	BLBC	STAT,L14
	CMPL	R7,#30
	BLSS	L13
L14:
	MOVL	#6,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S11,FAB1+FAB$L_FNA
	MOVB	#S11_L,FAB1+FAB$B_FNS
	MOVAB	S12,FAB1+FAB$L_DNA
	MOVB	#S12_L,FAB1+FAB$B_DNS
	$PARSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#1,OP
	JSB	DUMPALL
	BLBS	STAT,L18
	BRW	L17
L18:
	CLRL	R7
L16:	INCL	R7
	ADDL3	#600,R7,STEP
	$SEARCH	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#2,OP
	JSB	DUMPALL
	BLBC	STAT,L17
	CMPL	R7,#30
	BLSS	L16
L17:
	MOVL	#7,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S13,FAB1+FAB$L_FNA
	MOVB	#S13_L,FAB1+FAB$B_FNS
	MOVAB	S14,FAB1+FAB$L_DNA
