	.TITLE	NAMFID	Phase 33 runtime oracle
	.IDENT	/V1.0/

; $OPEN by name block (FAB$V_NAM). Case 1 finds [TEST]B.TXT with $PARSE
; and $SEARCH and saves the NAM; the rest open from its FID, DID, and DVI.

	$FABDEF
	$NAMDEF
	$RABDEF

; DUMP writes one record: TAG, the step, the op, and LEN bytes at ADDR.
	.MACRO	DUMP	TAG,ADDR,LEN
	MOVL	#^A/TAG/,REC
	MOVL	STEP,REC+4
	MOVL	OP,REC+8
	MOVC3	#LEN,ADDR,REC+12
	MOVZWL	#LEN+12,R6
	JSB	PUTREC
	.ENDM	DUMP

	.PSECT	DATA,NOEXE,WRT,LONG
OFAB:	$FAB	FNM=<[OUT]NAMFID.DMP>,FAC=PUT,RFM=VAR,MRS=1024
ORAB:	$RAB	FAB=OFAB,RBF=REC
FABT:	$FAB	FAC=GET,NAM=NAM1
NSAV:	.BLKB	NAM$C_BLN
	.ALIGN	LONG
FAB1:	.BLKB	FAB$C_BLN
NAMT:	$NAM	ESA=ESA,ESS=255,RSA=RSA,RSS=255
NAM1:	.BLKB	NAM$C_BLN
STEP:	.LONG	0
OP:	.LONG	0
STAT:	.LONG	0
ESA:	.BLKB	256
RSA:	.BLKB	256
REC:	.BLKB	1024
S1:	.ASCII	|[TEST]B.TXT|
S1_L = .-S1
S2:	.ASCII	||
S2_L = .-S2
S3:	.ASCII	||
S3_L = .-S3
S4:	.ASCII	||
S4_L = .-S4
S5:	.ASCII	|B.TXT|
S5_L = .-S5
S6:	.ASCII	||
S6_L = .-S6
S7:	.ASCII	||
S7_L = .-S7
S8:	.ASCII	||
S8_L = .-S8
S9:	.ASCII	||
S9_L = .-S9
S10:	.ASCII	||
S10_L = .-S10
S11:	.ASCII	|[TEST.SUB]C.DAT|
S11_L = .-S11
S12:	.ASCII	||
S12_L = .-S12
S13:	.ASCII	|[TEST]A.DAT|
S13_L = .-S13
S14:	.ASCII	||
S14_L = .-S14
S15:	.ASCII	|[TEST]A.DAT|
S15_L = .-S15
S16:	.ASCII	||
S16_L = .-S16
S17:	.ASCII	|NONE.DAT|
S17_L = .-S17
S18:	.ASCII	||
S18_L = .-S18
S19:	.ASCII	|*.TXT|
S19_L = .-S19
S20:	.ASCII	||
S20_L = .-S20

	.PSECT	CODE,EXE,NOWRT,LONG
	.ENTRY	NAMFID,^M<R2,R3,R4,R5,R6,R7>
	$CREATE	FAB=OFAB
	BLBS	R0,1$
	RET
1$:	$CONNECT RAB=ORAB
	BLBS	R0,2$
	RET
2$:
	MOVL	#1,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S1,FAB1+FAB$L_FNA
	MOVB	#S1_L,FAB1+FAB$B_FNS
	MOVAB	S2,FAB1+FAB$L_DNA
	MOVB	#S2_L,FAB1+FAB$B_DNS
	$PARSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#1,OP
	JSB	DUMPALL
	$SEARCH	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#2,OP
	JSB	DUMPALL
	MOVC3	#NAM$C_BLN,NAM1,NSAV
	MOVL	#2,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S3,FAB1+FAB$L_FNA
	MOVB	#S3_L,FAB1+FAB$B_FNS
	MOVAB	S4,FAB1+FAB$L_DNA
	MOVB	#S4_L,FAB1+FAB$B_DNS
	BISL2	#FAB$M_NAM,FAB1+FAB$L_FOP
	MOVC3	#6,NSAV+NAM$W_FID,NAM1+NAM$W_FID
	MOVC3	#16,NSAV+NAM$T_DVI,NAM1+NAM$T_DVI
	$OPEN	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#3,OP
	JSB	DUMPALL
	BLBS	STAT,L2
	BRW	L1
L2:
	CLRL	FAB1+FAB$L_XAB
	$CLOSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#6,OP
	DUMP	STAT,STAT,4
L1:
	MOVL	#3,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S5,FAB1+FAB$L_FNA
	MOVB	#S5_L,FAB1+FAB$B_FNS
	MOVAB	S6,FAB1+FAB$L_DNA
	MOVB	#S6_L,FAB1+FAB$B_DNS
	BISL2	#FAB$M_NAM,FAB1+FAB$L_FOP
	MOVC3	#6,NSAV+NAM$W_DID,NAM1+NAM$W_DID
	MOVC3	#16,NSAV+NAM$T_DVI,NAM1+NAM$T_DVI
	$OPEN	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#3,OP
	JSB	DUMPALL
	BLBS	STAT,L4
	BRW	L3
L4:
	CLRL	FAB1+FAB$L_XAB
	$CLOSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#6,OP
	DUMP	STAT,STAT,4
L3:
	MOVL	#4,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S7,FAB1+FAB$L_FNA
	MOVB	#S7_L,FAB1+FAB$B_FNS
	MOVAB	S8,FAB1+FAB$L_DNA
	MOVB	#S8_L,FAB1+FAB$B_DNS
	BISL2	#FAB$M_NAM,FAB1+FAB$L_FOP
	MOVC3	#16,NSAV+NAM$T_DVI,NAM1+NAM$T_DVI
	MOVW	#999,NAM1+NAM$W_FID
	MOVW	#7,NAM1+NAM$W_FID_SEQ
	$OPEN	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#3,OP
	JSB	DUMPALL
	BLBS	STAT,L6
	BRW	L5
L6:
	CLRL	FAB1+FAB$L_XAB
	$CLOSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#6,OP
	DUMP	STAT,STAT,4
L5:
	MOVL	#5,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S9,FAB1+FAB$L_FNA
	MOVB	#S9_L,FAB1+FAB$B_FNS
	MOVAB	S10,FAB1+FAB$L_DNA
	MOVB	#S10_L,FAB1+FAB$B_DNS
	BISL2	#FAB$M_NAM,FAB1+FAB$L_FOP
	MOVC3	#6,NSAV+NAM$W_FID,NAM1+NAM$W_FID
	$OPEN	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#3,OP
	JSB	DUMPALL
	BLBS	STAT,L8
	BRW	L7
L8:
	CLRL	FAB1+FAB$L_XAB
	$CLOSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#6,OP
	DUMP	STAT,STAT,4
L7:
	MOVL	#6,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S11,FAB1+FAB$L_FNA
	MOVB	#S11_L,FAB1+FAB$B_FNS
	MOVAB	S12,FAB1+FAB$L_DNA
	MOVB	#S12_L,FAB1+FAB$B_DNS
	BISL2	#FAB$M_NAM,FAB1+FAB$L_FOP
	MOVC3	#6,NSAV+NAM$W_DID,NAM1+NAM$W_DID
	MOVC3	#16,NSAV+NAM$T_DVI,NAM1+NAM$T_DVI
	$OPEN	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#3,OP
	JSB	DUMPALL
	BLBS	STAT,L10
	BRW	L9
L10:
	CLRL	FAB1+FAB$L_XAB
	$CLOSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#6,OP
	DUMP	STAT,STAT,4
L9:
	MOVL	#7,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S13,FAB1+FAB$L_FNA
	MOVB	#S13_L,FAB1+FAB$B_FNS
	MOVAB	S14,FAB1+FAB$L_DNA
	MOVB	#S14_L,FAB1+FAB$B_DNS
	BISL2	#FAB$M_NAM,FAB1+FAB$L_FOP
	MOVC3	#6,NSAV+NAM$W_FID,NAM1+NAM$W_FID
	MOVC3	#16,NSAV+NAM$T_DVI,NAM1+NAM$T_DVI
	$OPEN	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#3,OP
	JSB	DUMPALL
	BLBS	STAT,L12
	BRW	L11
L12:
	CLRL	FAB1+FAB$L_XAB
	$CLOSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#6,OP
	DUMP	STAT,STAT,4
L11:
	MOVL	#8,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S15,FAB1+FAB$L_FNA
	MOVB	#S15_L,FAB1+FAB$B_FNS
	MOVAB	S16,FAB1+FAB$L_DNA
	MOVB	#S16_L,FAB1+FAB$B_DNS
	MOVC3	#6,NSAV+NAM$W_FID,NAM1+NAM$W_FID
	MOVC3	#16,NSAV+NAM$T_DVI,NAM1+NAM$T_DVI
	$OPEN	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#3,OP
	JSB	DUMPALL
	BLBS	STAT,L14
	BRW	L13
L14:
	CLRL	FAB1+FAB$L_XAB
	$CLOSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#6,OP
	DUMP	STAT,STAT,4
L13:
	MOVL	#9,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S17,FAB1+FAB$L_FNA
	MOVB	#S17_L,FAB1+FAB$B_FNS
	MOVAB	S18,FAB1+FAB$L_DNA
	MOVB	#S18_L,FAB1+FAB$B_DNS
	BISL2	#FAB$M_NAM,FAB1+FAB$L_FOP
	MOVC3	#6,NSAV+NAM$W_DID,NAM1+NAM$W_DID
	MOVC3	#16,NSAV+NAM$T_DVI,NAM1+NAM$T_DVI
	$OPEN	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#3,OP
	JSB	DUMPALL
	BLBS	STAT,L16
	BRW	L15
L16:
	CLRL	FAB1+FAB$L_XAB
	$CLOSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#6,OP
	DUMP	STAT,STAT,4
L15:
	MOVL	#10,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S19,FAB1+FAB$L_FNA
	MOVB	#S19_L,FAB1+FAB$B_FNS
	MOVAB	S20,FAB1+FAB$L_DNA
	MOVB	#S20_L,FAB1+FAB$B_DNS
	BISL2	#FAB$M_NAM,FAB1+FAB$L_FOP
	MOVC3	#6,NSAV+NAM$W_DID,NAM1+NAM$W_DID
	MOVC3	#16,NSAV+NAM$T_DVI,NAM1+NAM$T_DVI
	$OPEN	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#3,OP
	JSB	DUMPALL
	BLBS	STAT,L18
	BRW	L17
L18:
	CLRL	FAB1+FAB$L_XAB
	$CLOSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#6,OP
	DUMP	STAT,STAT,4
L17:
	$CLOSE	FAB=OFAB
	RET

; PUTREC writes REC's first R6 bytes to the output file.
PUTREC:	MOVW	R6,ORAB+RAB$W_RSZ
	$PUT	RAB=ORAB
	RSB

; DUMPALL writes STAT, FAB1, NAM1, and the two string buffers.
DUMPALL:
	DUMP	STAT,STAT,4
	DUMP	FAB_,FAB1,FAB$C_BLN
	DUMP	NAM_,NAM1,NAM$C_BLN
	DUMP	ESA_,ESA,256
	DUMP	RSA_,RSA,256
	RSB

	.END	NAMFID
