	.TITLE	CREATE	Phase 33 runtime oracle
	.IDENT	/V1.0/

; $CREATE with a NAM and XABs, and $CLOSE's XABRDT and XABPRO. Files go
; in [CRE], which RUN.COM empties first. Case 1's chain gives a
; protection, an allocation, and an expiration date (1-JAN-2030); case 7
; closes with a revision date (2-FEB-2031 12:00), a revision count, and a
; new protection, then reopens the file to read them back.

	$FABDEF
	$NAMDEF
	$RABDEF
	$XABDEF
	$XABDATDEF
	$XABRDTDEF
	$XABFHCDEF
	$XABPRODEF
	$XABALLDEF
	$XABSUMDEF
	$XABKEYDEF

; DUMP writes one record: TAG, the step, the op, and LEN bytes at ADDR.
	.MACRO	DUMP	TAG,ADDR,LEN
	MOVL	#^A/TAG/,REC
	MOVL	STEP,REC+4
	MOVL	OP,REC+8
	MOVC3	#LEN,ADDR,REC+12
	MOVZWL	#LEN+12,R6
	JSB	PUTREC
	.ENDM	DUMP

	.PSECT	DATA,NOEXE,WRT,LONG
OFAB:	$FAB	FNM=<[OUT]CREATE.DMP>,FAC=PUT,RFM=VAR,MRS=1024
ORAB:	$RAB	FAB=OFAB,RBF=REC
FABT:	$FAB	FAC=PUT,NAM=NAM1,RFM=VAR
CPRO:	$XABPRO	PRO=<RWED,RWED,RE,>,NXT=CALL
CALL:	$XABALL	ALQ=7,DEQ=3,NXT=CDAT
CDAT:	$XABDAT
KRDT:	$XABRDT	NXT=KPRO
KPRO:	$XABPRO	PRO=<RWED,RWED,,>
RRDT:	$XABRDT	NXT=RPRO
RPRO:	$XABPRO	NXT=RDAT
RDAT:	$XABDAT	NXT=RALL
RALL:	$XABALL	NXT=RFHC
RFHC:	$XABFHC
	.ALIGN	LONG
FAB1:	.BLKB	FAB$C_BLN
NAMT:	$NAM	ESA=ESA,ESS=255,RSA=RSA,RSS=255
NAM1:	.BLKB	NAM$C_BLN
STEP:	.LONG	0
OP:	.LONG	0
STAT:	.LONG	0
ESA:	.BLKB	256
RSA:	.BLKB	256
REC:	.BLKB	1024
S1:	.ASCII	|[CRE]N1.DAT|
S1_L = .-S1
S2:	.ASCII	||
S2_L = .-S2
S3:	.ASCII	|[CRE]N1.DAT|
S3_L = .-S3
S4:	.ASCII	||
S4_L = .-S4
S5:	.ASCII	|[CRE]N1.DAT;1|
S5_L = .-S5
S6:	.ASCII	||
S6_L = .-S6
S7:	.ASCII	|N1|
S7_L = .-S7
S8:	.ASCII	|[CRE].DAT|
S8_L = .-S8
S9:	.ASCII	|[CRE]N2.DAT;5|
S9_L = .-S9
S10:	.ASCII	||
S10_L = .-S10
S11:	.ASCII	|[CRE]N2.DAT;3|
S11_L = .-S11
S12:	.ASCII	||
S12_L = .-S12
S13:	.ASCII	|[CRE]N3.DAT|
S13_L = .-S13
S14:	.ASCII	||
S14_L = .-S14
S15:	.ASCII	|[CRE]N3.DAT|
S15_L = .-S15
S16:	.ASCII	||
S16_L = .-S16
S17:	.ASCII	|[NOSUCH]N.DAT|
S17_L = .-S17
S18:	.ASCII	||
S18_L = .-S18
S19:	.ASCII	|[CRE]*.DAT|
S19_L = .-S19
S20:	.ASCII	||
S20_L = .-S20
S21:	.ASCII	|[CRE]N4|
S21_L = .-S21
S22:	.ASCII	|.LIS|
S22_L = .-S22
S23:	.ASCII	|[CRE]N1.DAT;1|
S23_L = .-S23
S24:	.ASCII	||
S24_L = .-S24

	.PSECT	CODE,EXE,NOWRT,LONG
	.ENTRY	CREATE,^M<R2,R3,R4,R5,R6,R7>
	$CREATE	FAB=OFAB
	BLBS	R0,1$
	RET
1$:	$CONNECT RAB=ORAB
	BLBS	R0,2$
	RET
2$:
	MOVL	#1,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S1,FAB1+FAB$L_FNA
	MOVB	#S1_L,FAB1+FAB$B_FNS
	MOVAB	S2,FAB1+FAB$L_DNA
	MOVB	#S2_L,FAB1+FAB$B_DNS
	MOVAB	CPRO,FAB1+FAB$L_XAB
	MOVL	#^X16B28000,CDAT+XAB$Q_EDT
	MOVL	#^X00BFDA49,CDAT+XAB$Q_EDT+4
	$CREATE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#4,OP
	JSB	DUMPALL
	DUMP	CPRO,CPRO,XAB$C_PROLEN
	DUMP	CALL,CALL,XAB$C_ALLLEN
	DUMP	CDAT,CDAT,XAB$C_DATLEN
	BLBS	STAT,L2
	BRW	L1
L2:
	CLRL	FAB1+FAB$L_XAB
	$CLOSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#6,OP
	DUMP	STAT,STAT,4
L1:
	MOVL	#2,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S3,FAB1+FAB$L_FNA
	MOVB	#S3_L,FAB1+FAB$B_FNS
	MOVAB	S4,FAB1+FAB$L_DNA
	MOVB	#S4_L,FAB1+FAB$B_DNS
	$CREATE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#4,OP
	JSB	DUMPALL
	BLBS	STAT,L4
	BRW	L3
L4:
	CLRL	FAB1+FAB$L_XAB
	$CLOSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#6,OP
	DUMP	STAT,STAT,4
L3:
	MOVL	#3,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S5,FAB1+FAB$L_FNA
	MOVB	#S5_L,FAB1+FAB$B_FNS
	MOVAB	S6,FAB1+FAB$L_DNA
	MOVB	#S6_L,FAB1+FAB$B_DNS
	$CREATE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#4,OP
	JSB	DUMPALL
	BLBS	STAT,L6
	BRW	L5
L6:
	CLRL	FAB1+FAB$L_XAB
	$CLOSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#6,OP
	DUMP	STAT,STAT,4
L5:
	MOVL	#4,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S7,FAB1+FAB$L_FNA
	MOVB	#S7_L,FAB1+FAB$B_FNS
	MOVAB	S8,FAB1+FAB$L_DNA
	MOVB	#S8_L,FAB1+FAB$B_DNS
	BISL2	#FAB$M_CIF,FAB1+FAB$L_FOP
	$CREATE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#4,OP
	JSB	DUMPALL
	BLBS	STAT,L8
	BRW	L7
L8:
	CLRL	FAB1+FAB$L_XAB
	$CLOSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#6,OP
	DUMP	STAT,STAT,4
L7:
	MOVL	#5,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S9,FAB1+FAB$L_FNA
	MOVB	#S9_L,FAB1+FAB$B_FNS
	MOVAB	S10,FAB1+FAB$L_DNA
	MOVB	#S10_L,FAB1+FAB$B_DNS
	$CREATE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#4,OP
	JSB	DUMPALL
	BLBS	STAT,L10
	BRW	L9
L10:
	CLRL	FAB1+FAB$L_XAB
	$CLOSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#6,OP
	DUMP	STAT,STAT,4
L9:
	MOVL	#6,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S11,FAB1+FAB$L_FNA
	MOVB	#S11_L,FAB1+FAB$B_FNS
	MOVAB	S12,FAB1+FAB$L_DNA
	MOVB	#S12_L,FAB1+FAB$B_DNS
	$CREATE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#4,OP
	JSB	DUMPALL
	BLBS	STAT,L12
	BRW	L11
L12:
	CLRL	FAB1+FAB$L_XAB
	$CLOSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#6,OP
	DUMP	STAT,STAT,4
L11:
	MOVL	#7,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S13,FAB1+FAB$L_FNA
	MOVB	#S13_L,FAB1+FAB$B_FNS
	MOVAB	S14,FAB1+FAB$L_DNA
	MOVB	#S14_L,FAB1+FAB$B_DNS
	$CREATE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#4,OP
	JSB	DUMPALL
	BLBS	STAT,L14
	BRW	L13
L14:
	MOVL	#^X71E62000,KRDT+XAB$Q_RDT
	MOVL	#^X00C112A4,KRDT+XAB$Q_RDT+4
	MOVW	#9,KRDT+XAB$W_RVN
	MOVAB	KRDT,FAB1+FAB$L_XAB
	$CLOSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#6,OP
	DUMP	STAT,STAT,4
	DUMP	KRDT,KRDT,XAB$C_RDTLEN
	DUMP	KPRO,KPRO,XAB$C_PROLEN
L13:
	MOVL	#107,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S15,FAB1+FAB$L_FNA
	MOVB	#S15_L,FAB1+FAB$B_FNS
	MOVAB	S16,FAB1+FAB$L_DNA
	MOVB	#S16_L,FAB1+FAB$B_DNS
	MOVB	#FAB$M_GET,FAB1+FAB$B_FAC
	MOVAB	RRDT,FAB1+FAB$L_XAB
	$OPEN	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#3,OP
	JSB	DUMPALL
	DUMP	RRDT,RRDT,XAB$C_RDTLEN
	DUMP	RPRO,RPRO,XAB$C_PROLEN
	DUMP	RDAT,RDAT,XAB$C_DATLEN
	DUMP	RALL,RALL,XAB$C_ALLLEN
	DUMP	RFHC,RFHC,XAB$C_FHCLEN
	BLBS	STAT,L16
	BRW	L15
L16:
	CLRL	FAB1+FAB$L_XAB
	$CLOSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#6,OP
	DUMP	STAT,STAT,4
L15:
	MOVL	#8,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S17,FAB1+FAB$L_FNA
	MOVB	#S17_L,FAB1+FAB$B_FNS
	MOVAB	S18,FAB1+FAB$L_DNA
	MOVB	#S18_L,FAB1+FAB$B_DNS
	$CREATE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#4,OP
	JSB	DUMPALL
	BLBS	STAT,L18
	BRW	L17
L18:
	CLRL	FAB1+FAB$L_XAB
	$CLOSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#6,OP
	DUMP	STAT,STAT,4
L17:
	MOVL	#9,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S19,FAB1+FAB$L_FNA
	MOVB	#S19_L,FAB1+FAB$B_FNS
	MOVAB	S20,FAB1+FAB$L_DNA
	MOVB	#S20_L,FAB1+FAB$B_DNS
	$CREATE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#4,OP
	JSB	DUMPALL
	BLBS	STAT,L20
	BRW	L19
L20:
	CLRL	FAB1+FAB$L_XAB
	$CLOSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#6,OP
	DUMP	STAT,STAT,4
L19:
	MOVL	#10,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S21,FAB1+FAB$L_FNA
	MOVB	#S21_L,FAB1+FAB$B_FNS
	MOVAB	S22,FAB1+FAB$L_DNA
	MOVB	#S22_L,FAB1+FAB$B_DNS
	$CREATE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#4,OP
	JSB	DUMPALL
	BLBS	STAT,L22
	BRW	L21
L22:
	CLRL	FAB1+FAB$L_XAB
	$CLOSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#6,OP
	DUMP	STAT,STAT,4
L21:
	MOVL	#11,STEP
	MOVC3	#FAB$C_BLN,FABT,FAB1
	MOVC3	#NAM$C_BLN,NAMT,NAM1
	MOVC5	#0,(SP),#^XEE,#256,ESA
	MOVC5	#0,(SP),#^XEE,#256,RSA
	MOVAB	S23,FAB1+FAB$L_FNA
	MOVB	#S23_L,FAB1+FAB$B_FNS
	MOVAB	S24,FAB1+FAB$L_DNA
	MOVB	#S24_L,FAB1+FAB$B_DNS
	MOVB	#FAB$M_GET,FAB1+FAB$B_FAC
	MOVAB	RRDT,FAB1+FAB$L_XAB
	$OPEN	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#3,OP
	JSB	DUMPALL
	DUMP	RRDT,RRDT,XAB$C_RDTLEN
	DUMP	RPRO,RPRO,XAB$C_PROLEN
	DUMP	RDAT,RDAT,XAB$C_DATLEN
	DUMP	RALL,RALL,XAB$C_ALLLEN
	DUMP	RFHC,RFHC,XAB$C_FHCLEN
	BLBS	STAT,L24
	BRW	L23
L24:
	CLRL	FAB1+FAB$L_XAB
	$CLOSE	FAB=FAB1
	MOVL	R0,STAT
	MOVL	#6,OP
	DUMP	STAT,STAT,4
L23:
	$CLOSE	FAB=OFAB
	RET

; PUTREC writes REC's first R6 bytes to the output file.
PUTREC:	MOVW	R6,ORAB+RAB$W_RSZ
	$PUT	RAB=ORAB
	RSB

; DUMPALL writes STAT, FAB1, NAM1, and the two string buffers.
DUMPALL:
	DUMP	STAT,STAT,4
	DUMP	FAB_,FAB1,FAB$C_BLN
	DUMP	NAM_,NAM1,NAM$C_BLN
	DUMP	ESA_,ESA,256
	DUMP	RSA_,RSA,256
	RSB

	.END	CREATE
