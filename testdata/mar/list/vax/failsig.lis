                                     0000     1 	.TITLE	FAILSIG	Phase 29 probe: signaled conditions, for traceback
                                     0000     2 	.IDENT	/V1.0/
                                     0000     3 
                                     0000     4 ; Signals an error-severity condition (RMS$_EOF, which traceback reports
                                     0000     5 ; and then lets the program go on from), then stops with a fatal one
                                     0000     6 ; (SS$_ABORT), each from a nested routine. The values are written out so
                                     0000     7 ; the source needs no system macros.
                                     0000     8 
                           0001827A  0000     9 RMS$_EOF = ^X0001827A
                           0000002C  0000    10 SS$_ABORT = ^X0000002C
                                     0000    11 
                                 00000000    12 	.PSECT	CODE, NOWRT, EXE, LONG
                               0000  0000    13 	.ENTRY	FAILSIG, ^M<>
              00000011'EF   00   FB  0002    14 	CALLS	#0, WARNIT
              00000021'EF   00   FB  0009    15 	CALLS	#0, STOPIT
                                 04  0010    16 	RET
                                     0011    17 
                               0000  0011    18 	.ENTRY	WARNIT, ^M<>
                   0001827A 8F   DD  0013    19 	PUSHL	#RMS$_EOF
              00000000'GF   01   FB  0019    20 	CALLS	#1, G^LIB$SIGNAL
                                 04  0020    21 	RET
                                     0021    22 
                               0000  0021    23 	.ENTRY	STOPIT, ^M<>
                            2C   DD  0023    24 	PUSHL	#SS$_ABORT
              00000000'GF   01   FB  0025    25 	CALLS	#1, G^LIB$STOP
                                 04  002C    26 	RET
                                     002D    27 
                                     002D    28 	.END	FAILSIG
