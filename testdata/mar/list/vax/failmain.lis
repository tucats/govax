                                     0000     1 	.TITLE	FAILMAIN Phase 29 probe: a program that fails, for traceback
                                     0000     2 	.IDENT	/V1.0/
                                     0000     3 
                                     0000     4 ; With FAILSUB, a program whose third routine, two calls and one module
                                     0000     5 ; away, reads address 0 (the no-access page): an access violation that
                                     0000     6 ; nothing handles, so VMS's traceback prints the call chain. LIST.COM
                                     0000     7 ; links it with and without traceback and runs both, keeping what they
                                     0000     8 ; print for a future govax traceback to be checked against.
                                     0000     9 
                                     0000    10 	.EXTERNAL SUB1
                                     0000    11 
                                 00000000    12 	.PSECT	CODE, NOWRT, EXE, LONG
                               0000  0000    13 	.ENTRY	FAILMAIN, ^M<>
              00000000'GF   00   FB  0002    14 	CALLS	#0, G^SUB1
                                 04  0009    15 	RET
                                     000A    16 
                                     000A    17 	.END	FAILMAIN
