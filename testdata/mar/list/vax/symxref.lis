                                     0000     1 	.TITLE	SYMTAB	Phase 29 probe: the symbol table and psect synopsis
                                     0000     2 	.IDENT	/V1.0/
                                     0000     3 
                                     0000     4 ; Every kind of symbol the symbol table distinguishes, and symbols a macro
                                     0000     5 ; defines that the program does and doesn't use, to find which ones the
                                     0000     6 ; table leaves out (RMSCOPY.LIS lists about 55 of its 625 symbols), with
                                     0000     7 ; .ENABLE and .DISABLE SUPPRESSION. Long psect names and every psect
                                     0000     8 ; attribute fill the psect synopsis.
                                     0000     9 
                                     0000    10 	.EXTERNAL EXTREF
                                     0000    11 	.WEAK	WEAKREF, WEAKDEF
                                     0000    12 
                                     0000    13 ; Assigned symbols: local, global, an expression, and a relocatable one.
                           0000002A  0000    14 ABSVAL = 42
                           0000002B  0000    15 GLOBVAL == 43
                           0000007F  0000    16 EXPRVAL = ABSVAL * 2 + GLOBVAL
                           0000002C  0000    17 UNUSED = 44				; never used
                                     0000    18 
                                     0000    19 ; A macro defining many symbols, as the $xxxDEF macros do; only some are
                                     0000    20 ; used below.
                                     0000    21 	.MACRO	DEFS	PREFIX
                                     0000    22 PREFIX'_A = 1
                                     0000    23 PREFIX'_B = 2
                                     0000    24 PREFIX'_C = 3
                                     0000    25 PREFIX'_D == 4
                                     0000    26 	.ENDM	DEFS
                                     0000    27 
                                     0000    28 	DEFS	DFLT			; suppression as the default leaves it
                                     0000    29 	.ENABLE	SUPPRESSION
                                     0000    30 	DEFS	SUPP			; with suppression enabled
                                     0000    31 	.DISABLE SUPPRESSION
                                     0000    32 	DEFS	NOSUP			; and disabled again
                                     0000    33 
                                     0000    34 	.ENABLE	SUPPRESSION
                           00000005  0000    35 SUPPLAIN = 5				; outside a macro, with suppression
                                     0000    36 	.DISABLE SUPPRESSION
                                     0000    37 
                                 00000000    38 	.PSECT	DATA, WRT, NOEXE, LONG
00000005 00000001 00000001 00000001  0000    39 LABEL:	.LONG	DFLT_A, SUPP_A, NOSUP_A, SUPPLAIN
                           00000004  0010    40 RELVAL = LABEL + 4
00000000'0000007F 0000002A 00000004' 0010    41 	.LONG	RELVAL, ABSVAL, EXPRVAL, EXTREF, WEAKREF
                           00000000' 0020       
                           00000000' 0024    42 GLOB::	.LONG	UNDEF			; undefined: external, by .ENABLE GLOBAL (the default)
                           00000000  0028    43 WEAKDEF: .LONG	0
                           0000002C' 002C    44 10$:	.LONG	10$			; a local label
                                     0030    45 
                                 00000000    46 	.PSECT	A_PSECT_NAME_THAT_IS_31_CHARS_X, RD, WRT, NOEXE, GBL, SHR, PIC, OVR, QUAD
