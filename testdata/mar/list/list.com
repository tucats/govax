$ ! LIST.COM - the govax Phase 29 probe (docs/PHASE-29.md, subtask 1).
$ !
$ ! 1. Listings: each source with MACRO/LIST, and LCTL, BINARY, SYMTAB,
$ !    and XREF again with /SHOW=, /NOSHOW=, /NOOBJECT, and
$ !    /CROSS_REFERENCE. The error sources' objects (if MACRO writes any)
$ !    and $STATUS show what an assembly with errors leaves behind.
$ ! 2. Traceback and debugger records: TRACE assembled with each /DEBUG,
$ !    /ENABLE, and /DISABLE choice, and DBGSRC with its own .ENABLE and
$ !    .DISABLE; ANALYZE/OBJECT of every object.
$ ! 3. Images: TRACE linked with and without traceback and with /DEBUG
$ !    (not run: it would start the debugger), with maps and
$ !    ANALYZE/IMAGE; and the failing programs, linked with and without
$ !    traceback and run, so the log keeps what VMS's traceback printed.
$ !
$ ! Run it with the volume holding the sources as the default directory,
$ ! keeping a log of everything it prints:
$ !
$ !     @LIST/OUTPUT=LIST.LOG
$ !
$ SET NOON
$ SET VERIFY
$ !
$ ! 1. Listings.
$ !
$ MACRO/LIST LCTL
$ MACRO/LIST=LCTLSHOW/OBJECT=LCTLSHOW/SHOW=(EXPANSIONS,BINARY) LCTL
$ MACRO/LIST=LCTLNOSH/OBJECT=LCTLNOSH/NOSHOW=(CONDITIONALS,CALLS,DEFINITIONS) LCTL
$ MACRO/LIST BINARY
$ MACRO/LIST=BINNOOBJ/NOOBJECT BINARY
$ MACRO/LIST SYMTAB
$ MACRO/LIST NOTITLE
$ MACRO/LIST ERRORS
$ SHOW SYMBOL $STATUS
$ MACRO/LIST ERREND
$ SHOW SYMBOL $STATUS
$ DIRECTORY/SIZE=ALL ERRORS.*,ERREND.*
$ MACRO/LIST/CROSS_REFERENCE XREF
$ MACRO/LIST=XREFALL/OBJECT=XREFALL/CROSS_REFERENCE=ALL XREF
$ MACRO/LIST=SYMXREF/NOOBJECT/CROSS_REFERENCE SYMTAB
$ !
$ ! 2. Traceback and debugger records.
$ !
$ MACRO/LIST TRACE
$ MACRO/LIST=TRDEBUG/OBJECT=TRDEBUG/DEBUG TRACE
$ MACRO/OBJECT=TRDBGALL/DEBUG=ALL TRACE
$ MACRO/OBJECT=TRDBGTB/DEBUG=TRACEBACK TRACE
$ MACRO/OBJECT=TRDBGSYM/DEBUG=SYMBOLS TRACE
$ MACRO/OBJECT=TRDBGNON/DEBUG=NONE TRACE
$ MACRO/OBJECT=TRNODBG/NODEBUG TRACE
$ MACRO/OBJECT=TRENADBG/ENABLE=DEBUG TRACE
$ MACRO/OBJECT=TRDISTBK/DISABLE=TRACEBACK TRACE
$ MACRO/LIST DBGSRC
$ MACRO/LIST FAILMAIN
$ MACRO/LIST FAILSUB
$ MACRO/LIST FAILSIG
$ MACRO/OBJECT=FAILMAID/DEBUG FAILMAIN
$ MACRO/OBJECT=FAILSUBD/DEBUG FAILSUB
$ LIST = "LCTL,LCTLSHOW,LCTLNOSH,BINARY,SYMTAB,NOTITLE,XREF,XREFALL," + -
    "TRACE,TRDEBUG,TRDBGALL,TRDBGTB,TRDBGSYM,TRDBGNON,TRNODBG,TRENADBG," + -
    "TRDISTBK,DBGSRC,FAILMAIN,FAILSUB,FAILSIG,FAILMAID,FAILSUBD"
$ I = 0
$ NEXT:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO IMAGES
$   ANALYZE/OBJECT/OUTPUT='F'.ANL 'F'.OBJ
$   I = I + 1
$   GOTO NEXT
$ !
$ ! 3. Images.
$ !
$ IMAGES:
$ LINK/MAP TRACE
$ RUN TRACE
$ LINK/MAP=TRNOTB/EXECUTABLE=TRNOTB/NOTRACEBACK TRACE
$ RUN TRNOTB
$ LINK/MAP=TRDBGTRC/EXECUTABLE=TRDBGTRC TRDEBUG
$ RUN TRDBGTRC
$ LINK/MAP=TRDBGLNK/EXECUTABLE=TRDBGLNK/DEBUG TRDEBUG
$ LINK/MAP=TRLNKDBG/EXECUTABLE=TRLNKDBG/DEBUG TRACE
$ LINK/MAP FAILMAIN,FAILSUB
$ RUN FAILMAIN
$ SHOW SYMBOL $STATUS
$ LINK/MAP=FAILNOTB/EXECUTABLE=FAILNOTB/NOTRACEBACK FAILMAIN,FAILSUB
$ RUN FAILNOTB
$ SHOW SYMBOL $STATUS
$ LINK/MAP=FAILDBG/EXECUTABLE=FAILDBG FAILMAID,FAILSUBD
$ RUN FAILDBG
$ SHOW SYMBOL $STATUS
$ LINK/MAP FAILSIG
$ RUN FAILSIG
$ SHOW SYMBOL $STATUS
$ LINK/MAP=FSIGNOTB/EXECUTABLE=FSIGNOTB/NOTRACEBACK FAILSIG
$ RUN FSIGNOTB
$ SHOW SYMBOL $STATUS
$ LIST = "TRACE,TRNOTB,TRDBGTRC,TRDBGLNK,TRLNKDBG,FAILMAIN,FAILNOTB," + -
    "FAILDBG,FAILSIG,FSIGNOTB"
$ I = 0
$ INEXT:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO DONE
$   ANALYZE/IMAGE/OUTPUT='F'.ANI 'F'.EXE
$   I = I + 1
$   GOTO INEXT
$ DONE:
$ DIRECTORY/SIZE=ALL/DATE
$ SET NOVERIFY
$ EXIT
