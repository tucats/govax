V1.0                                                                     30-SEP-2026 04:11:39  DUA1:[000000]PSECTS.MAR;1         (1)

                                     0000     1 	.TITLE	PSECTS	Fixture 11: psect bookkeeping
                                     0000     2 	.IDENT	/V1.0/
                                     0000     3 
                                     0000     4 ; Checks what MACRO writes for data that comes before any .PSECT, for an
                                     0000     5 ; absolute psect of offsets and the global symbols defined in it (one of
                                     0000     6 ; them used nowhere), for going back to a psect after another, for
                                     0000     7 ; setting the location counter with ". =", and for .SAVE_PSECT and
                                     0000     8 ; .RESTORE_PSECT. START returns 1, so the image can be linked and run.
                                     0000     9 
                           00000000  0000    10 FIRST::	.LONG	0
                                     0004    11 
                                     0004    12 	.PSECT	OFFSETS, ABS
                           00000004  0000    13 OFF_A::	.BLKL	1
                           00000006  0004    14 OFF_B::	.BLKW	1
                           00000007  0006    15 OFF_C:	.BLKB	1
                           00000008  0007    16 OFF_D::	.BLKB	1
                                     0008    17 
                                 00000000    18 	.PSECT	DATA, WRT, NOEXE, LONG
                           00000001  0000    19 ONE:	.LONG	1
                                     0004    20 
                                 00000000    21 	.PSECT	CODE, NOWRT, EXE, LONG
                               0000  0000    22 	.ENTRY	START, ^M<>
              50   00000000'EF   D0  0002    23 	MOVL	ONE, R0
                                 04  0009    24 	RET
                                     000A    25 
                                 00000004    26 	.PSECT	DATA
                           00000002  0004    27 TWO:	.LONG	2
                           00000010  0008    28 	. = . + 8
                           00000003  0010    29 THREE:	.LONG	3
                           00000040  0014    30 	. = ONE + 64
                           00000004  0040    31 FOUR:	.LONG	4
                                     0044    32 	.SAVE_PSECT
                                 0000000A    33 	.PSECT	CODE
                       51   04   D0  000A    34 	MOVL	#OFF_B, R1
                                 05  000D    35 	RSB
                                 00000044    36 	.RESTORE_PSECT
                  00000006 00000000  0044    37 	.LONG	OFF_A, OFF_C
                                     004C    38 
                                     004C    39 	.END	START
