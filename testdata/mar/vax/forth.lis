                       8A   8B   D0  0381   824 	MOVL	(R11)+,(R10)+
                                 05  0384   825 	RSB
              50   00000237'EF   9E  0385   826 10$:	MOVAB	AGAIN_MSG,R0		; Complain
                          0499   30  038C   827 	BSBW	PRSTR
                          FD1E   31  038F   828 	BRW	ABORT
                                     0392   829 
                                     0392   830 ;
                                     0392   831 ; until--loop until condition becomes true
                                     0392   832 ;
                                     0392   833 	DEFWORD	<until>,F_UNTIL,PRIORITY
                       8B   04   D1  0392   834 	CMPL	#MRKBEGIN,(R11)+	; Verify match
                            10   12  0395   835 	BNEQ	10$
              8A   06128BD5 8F   D0  0397   836 	MOVL	#SKIPT,(R10)+		; Branch over backbranch if true
                  8A   9F17 8F   B0  039E   837 	MOVW	#AGAIN_HEADER,(R10)+	; compile in backbranch
                       8A   8B   D0  03A3   838 	MOVL	(R11)+,(R10)+
                                 05  03A6   839 	RSB
              50   0000025A'EF   9E  03A7   840 10$:	MOVAB	UNTIL_MSG,R0		; Complain
                          0477   30  03AE   841 	BSBW	PRSTR
                          FCFC   31  03B1   842 	BRW	ABORT
                                     03B4   843 
                                     03B4   844 ;
                                     03B4   845 ; leave--setup innermost loop so it will exit at next iteration
                                     03B4   846 ;
                                     03B4   847 	DEFPRIM	<leave>,F_LEAVE
                    04 AE   6E   D0  03B4   848 	MOVL	(SP),4(SP)
                                     03B8   849 	ENDPRIM	F_LEAVE
                                     03B9   850 
                                     03B9   851 ;
                                     03B9   852 ; "k"--return index of third loop
                                     03B9   853 ;
                                     03B9   854 	DEFPRIM	<k>,F_K
                    7B   14 AE   D0  03B9   855 	MOVL	20(SP),-(R11)
                                     03BD   856 	ENDPRIM	F_K
                                     03BE   857 
                                     03BE   858 ;
                                     03BE   859 ; "j"--return index of second loop
                                     03BE   860 ;
