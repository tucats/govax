                                     0461   952 
                                     0461   953 ;
                                     0461   954 ; "variable"--build a variable. Its code pushes the address of the
                                     0461   955 ;   longword that follows it.
                                     0461   956 ;
                           00008FD0  0461   957 XVAR1	= ^X8FD0			; MOVL #<addr>,-(R11)
                           0000007B  0461   958 XVAR2	= ^X7B
                                     0461   959 
                                     0461   960 	DEFWORD	<variable>,F_VARIABLE
                       54   07   3C  0461   961 	MOVZWL	#7,R4			; SFP = 7
                       55   08   3C  0464   962 	MOVZWL	#PRIMITIVE,R5		; SFA = PRIMITIVE
                          0576   30  0467   963 	BSBW	MKHEAD			; Build the header
                  8A   8FD0 8F   B0  046A   964 	MOVW	#XVAR1,(R10)+		; Our in-line code
                  8A   5A   06   C1  046F   965 	ADDL3	#6,R10,(R10)+
                    8A   7B 8F   90  0473   966 	MOVB	#XVAR2,(R10)+
                       8A   05   90  0477   967 	MOVB	#RSB_HEADER,(R10)+
                            8A   D4  047A   968 	CLRL	(R10)+			; The first word of space (= 0)
