                                 05  0495   982 	RSB
                                     0496   983 
                                     0496   984 ;
                                     0496   985 ; ":"--start a colon definition
                                     0496   986 ;
                                     0496   987 	DEFWORD	<:>,F_COLON
              00000520'EF   01   D0  0496   988 	MOVL	#1,STATE		; Set our state to "compile"
                            54   D4  049D   989 	CLRL	R4			; SFP = 0
                       55   02   3C  049F   990 	MOVZWL	#XSMUDGED,R5		; SFA = SMUDGED
                          053B   30  04A2   991 	BSBW	MKHEAD			; Build the header
                       7B   01   D0  04A5   992 	MOVL	#MRKCOLON,-(R11)	; and leave our mark on the stack
                                 05  04A8   993 	RSB
                                     04A9   994 
                                     04A9   995 ;
                                     04A9   996 ; ";"--end compile mode
                                     04A9   997 ;
                                     04A9   998 	DEFWORD	<;>,F_SEMI,PRIORITY
                   00000520'EF   D4  04A9   999 	CLRL	STATE			; Reset compile state
                       8B   01   D1  04AF  1000 	CMPL	#MRKCOLON,(R11)+	; Check the mark
                            0D   13  04B2  1001 	BEQL	10$
              50   000002BC'EF   9E  04B4  1002 	MOVAB	SEMI_MSG,R0		; Uh-oh, bad match. Complain
                          036A   30  04BB  1003 	BSBW	PRSTR
                          FBEF   31  04BE  1004 	BRW	ABORT
                         0A A8   B4  04C1  1005 10$:	CLRW	10(R8)			; All OK, so clear the smudge
                       8A   05   90  04C4  1006 	MOVB	#RSB_HEADER,(R10)+	; Add the closing RSB
                                 05  04C7  1007 	RSB
                                     04C8  1008 
                                     04C8  1009 ;
                                     04C8  1010 ; "mod"--get remainder of division
                                     04C8  1011 ;
                                     04C8  1012 	DEFWORD	<mod>,F_MOD
                       50   8B   D0  04C8  1013 	MOVL	(R11)+,R0		; The divisor
             52   00   6B   01   7A  04CB  1014 	EMUL	#1,(R11),#0,R2		; The dividend, as a quadword
             6B   51   52   50   7B  04D0  1015 	EDIV	R0,R2,R1,(R11)		; Keep the remainder
                                 05  04D5  1016 	RSB
                                     04D6  1017 
                                     04D6  1018 ;
                                     04D6  1019 ; "/"--divide second by top
                                     04D6  1020 ;
                                     04D6  1021 	DEFPRIM	</>,F_DIVIDE
                       6B   8B   C6  04D6  1022 	DIVL2	(R11)+,(R11)
                                     04D9  1023 	ENDPRIM	F_DIVIDE
                                     04DA  1024 
                                     04DA  1025 ;
                                     04DA  1026 ; "*"--multiply top two items on stack
                                     04DA  1027 ;
                                     04DA  1028 	DEFPRIM	<*>,F_TIMES
                       6B   8B   C4  04DA  1029 	MULL2	(R11)+,(R11)
