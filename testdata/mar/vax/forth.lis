                       8B   05   D1  0356   806 	CMPL	#MRKWHILE,(R11)+	; Check match
                            0F   12  0359   807 	BNEQ	10$
                       50   8B   D0  035B   808 	MOVL	(R11)+,R0		; Save where to patch
                  8A   9F17 8F   B0  035E   809 	MOVW	#AGAIN_HEADER,(R10)+	; JMP @#<back>
                       8A   8B   D0  0363   810 	MOVL	(R11)+,(R10)+
