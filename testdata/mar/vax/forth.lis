                                     0406   901 ; loop--branch back to the opening "DO"
                                     0406   902 ;
                           1704AED6  0406   903 XLOOP1	= ^X1704AED6		; INCL 4(SP) / JMP @#<back>
                           0000009F  0406   904 XLOOP2	= ^X9F
                                     0406   905 
                                     0406   906 	DEFWORD	<loop>,F_LOOP,PRIORITY
                       8B   03   D1  0406   907 	CMPL	#MRKDO,(R11)+		; Check for match of control structures
                            15   12  0409   908 	BNEQ	10$
                       50   8B   D0  040B   909 	MOVL	(R11)+,R0		; Keep where to fill in forward branch addr.
              8A   1704AED6 8F   D0  040E   910 	MOVL	#XLOOP1,(R10)+		; Build code to increment loop
                    8A   9F 8F   90  0415   911 	MOVB	#XLOOP2,(R10)+
                       8A   8B   D0  0419   912 	MOVL	(R11)+,(R10)+
                       60   5A   D0  041C   913 	MOVL	R10,(R0)		; Fill in this location as loop exit addr.
                                 05  041F   914 	RSB
