                            EA   12  08A8  1490 	BNEQ	20$			; No, keep going
                    50   04 A1   D0  08AA  1491 	MOVL	4(R1),R0		; We have a match. R0 -> entry
                       52   51   D0  08AE  1492 	MOVL	R1,R2			; R2 -> top of entry
                    51   0A A1   32  08B1  1493 	CVTWL	10(R1),R1		; R1 = (SFA)
                            53   D4  08B5  1494 	CLRL	R3			; Return Z
                                 05  08B7  1495 	RSB
                       51   61   D0  08B8  1496 30$:	MOVL	(R1),R1			; Move to next entry
                            CA   12  08BB  1497 	BNEQ	10$
                       53   01   D0  08BD  1498 	MOVL	#1,R3			; No match, return NZ
                                 05  08C0  1499 	RSB
                                     08C1  1500 
                                     08C1  1501 ;
                                     08C1  1502 ; lower--make the character in R4 lowercase, if it's a letter
                                     08C1  1503 ;
                    41 8F   54   91  08C1  1504 LOWER:	CMPB	R4,#^A/A/
                            09   1F  08C5  1505 	BLSSU	10$
                    5A 8F   54   91  08C7  1506 	CMPB	R4,#^A/Z/
                            03   1A  08CB  1507 	BGTRU	10$
                       54   20   88  08CD  1508 	BISB2	#^X20,R4
                                 05  08D0  1509 10$:	RSB
                                     08D1  1510 
                                     08D1  1511 ;
                                     08D1  1512 ; iswhite--return Z if the character pointed to by R9 is a white
                                     08D1  1513 ;   space character or the NUL ending the line. Uses R3.
                                     08D1  1514 ;
                                     08D1  1515 ISWHITE:
                       53   69   90  08D1  1516 	MOVB	(R9),R3			; Keep this char in register
                       53   09   91  08D4  1517 	CMPB	#TAB,R3			; Tab
                            0C   13  08D7  1518 	BEQL	10$
                       53   20   91  08D9  1519 	CMPB	#SPC,R3			; Space
                            07   13  08DC  1520 	BEQL	10$
                       53   0A   91  08DE  1521 	CMPB	#NL,R3			; Newline
                            02   13  08E1  1522 	BEQL	10$
                            53   95  08E3  1523 	TSTB	R3			; NULL
                                 05  08E5  1524 10$:	RSB
                                     08E6  1525 
                                     08E6  1526 ;
                                     08E6  1527 ; getlin--read another line of input from the current input unit into
                                     08E6  1528 ;   INLINE, ending it with a newline and a NUL, and point R9 at it. The
                                     08E6  1529 ;   terminal prompts with the output line so far and "> ". At the end of
                                     08E6  1530 ;   a file, the file is closed and the input it interrupted resumes; at
                                     08E6  1531 ;   the end of the terminal's input, forth exits. Uses R0.
                                     08E6  1532 ;
                            3E   BB  08E6  1533 GETLIN:	PUSHR	#^M<R1,R2,R3,R4,R5>
              52   0000095C'EF   D0  08E8  1534 	MOVL	IUNIT,R2		; Get the input unit
              50   000025B8'EF   DE  08EF  1535 	MOVAL	TTIN,R0			; Prompt if it's the terminal
                       50   52   D1  08F6  1536 	CMPL	R2,R0
                            29   12  08F9  1537 	BNEQ	10$
              51   000026D8'EF   DE  08FB  1538 	MOVAL	TTOUT,R1		; Add "> " to what's been printed
                  50   0094 C1   D0  0902  1539 	MOVL	UB_LEN(R1),R0
                53   0098 C140   9E  0907  1540 	MOVAB	UB_BUF(R1)[R0],R3
                       83   3E   90  090D  1541 	MOVB	#^A/>/,(R3)+
                       63   20   90  0910  1542 	MOVB	#SPC,(R3)
             0080 C2   0098 C1   9E  0913  1543 	MOVAB	UB_BUF(R1),UB_RAB+RAB$L_PBF(R2)
             0084 C2   50   02   81  091A  1544 	ADDB3	#2,R0,UB_RAB+RAB$B_PSZ(R2)
                       0094 C1   D4  0920  1545 	CLRL	UB_LEN(R1)		;  and make that the prompt
                                     0924  1546 10$:	$GET	RAB=UB_RAB(R2)		; Read a record
