                                     0000     1 	.TITLE	FORTH	Vforth, a subroutine-threaded FORTH
                                     0000     2 	.IDENT	/V2.0/
                                     0000     3 
                                     0000     4 ;
                                     0000     5 ; Vforth--a 32 bit forth system using subroutine threading for
                                     0000     6 ;   increased speed.
                                     0000     7 ;
                                     0000     8 ;   By Andy Valencia, 1984
                                     0000     9 ;
                                     0000    10 ; Modifications:
                                     0000    11 ;
                                     0000    12 ;   05/15/99  Tom Cole
                                     0000    13 ;   Port to run under eVAX. This involves changing a few
                                     0000    14 ;   pseudo-instructions to the assembler, and storing the
                                     0000    15 ;   code resident in the microkernel space.
                                     0000    16 ;
                                     0000    17 ;   09/26/28  Tom Cole
                                     0000    18 ;   This was written to run within the microkernel, but
                                     0000    19 ;   that was never practical. Modified to run in P0
                                     0000    20 ;   space as a regular program, not a resident feature of
                                     0000    21 ;   the microkernel.
                                     0000    22 ;
                                     0000    23 ;   10/04/26  MACRO-32 port (testdata/asm/forth.asm is the eVAX original)
                                     0000    24 ;   Rewritten for VAX MACRO: assembled with MACRO, linked with LINK,
                                     0000    25 ;   and run with RUN. The changes:
                                     0000    26 ;
                                     0000    27 ;   - Program sections: code (FORTH_CODE), constant text and tables
                                     0000    28 ;     (FORTH_TEXT), variables and buffers (FORTH_DATA), the built-in
                                     0000    29 ;     dictionary's headers (FORTH_WORDS), and the dictionary new words
                                     0000    30 ;     are compiled into (FORTH_DICT, writable and executable).
                                     0000    31 ;   - I/O is RMS: the terminal is SYS$INPUT and SYS$OUTPUT, and "input"
                                     0000    32 ;     and "output" open files (default types .FTH and .LIS). The original
                                     0000    33 ;     used Unix-style CHMK system calls and DEC C's string routines.
                                     0000    34 ;     Output is gathered a line at a time and written as one record; a
                                     0000    35 ;     line still unfinished when the terminal is read becomes part of
                                     0000    36 ;     the prompt.
                                     0000    37 ;   - A command's text (LIB$GET_FOREIGN), when it's run as a foreign
                                     0000    38 ;     command ("FORTH :== $FORTH" then "FORTH 2 3 + ."), is interpreted
                                     0000    39 ;     and then forth halts, as the original's string-argument entry did;
                                     0000    40 ;     without it, forth is interactive. Words are found whatever their
                                     0000    41 ;     case, since DCL uppercases a command's unquoted text.
                                     0000    42 ;   - The DEFWORD and DEFPRIM macros build the dictionary headers, and
                                     0000    43 ;     DEFPRIM computes a primitive's length instead of hand-counting it.
                                     0000    44 ;   - BSD-style jbr/jeql/jnequ pseudo-branches are BRB/BRW/BSBW and
                                     0000    45 ;     branches around BRW; addresses are taken with MOVAB/MOVAL.
                                     0000    46 ;   - The operand stack is an area of its own, not 80 bytes below the
                                     0000    47 ;     return stack (where nested calls and RMS calls overwrote it).
                                     0000    48 ;   - Bugs fixed: "(" compared R0 with the byte at address 0 instead of
                                     0000    49 ;     testing for a NUL; "and" was a logical, not bitwise, and; "c@"
                                     0000    50 ;     sign-extended; "mod" ignored a negative dividend's sign; "fill"
                                     0000    51 ;     wrote one byte for a count of 0; "." needed more room for base 2
                                     0000    52 ;     and printed no trailing blank; numbers like "12x" were accepted
                                     0000    53 ;     as 12, and digits above F were misread in bases over 16; a ";"
                                     0000    54 ;     with an unmatched control structure didn't abort; "(.")" across
                                     0000    55 ;     input lines lost its string pointer; words longer than 80
                                     0000    56 ;     characters, ." strings over 132, and more than 7 nested input or
                                     0000    57 ;     output files overran their buffers.
FORTH                           Vforth, a subroutine-threaded FORTH       4-OCT-2026 19:44:35  VAX MACRO V5.4-3            Page   2
V2.0                                                                      4-OCT-2026 19:56:48  DUA1:[000000]FORTH.MAR;2          (1)

                                     0000    58 ;
                                     0000    59 ; Registers with fixed uses:
                                     0000    60 ;   PC  - Since we're using subroutine threading, this operates as the
                                     0000    61 ;         actual execution vector for each instruction.
                                     0000    62 ;   SP  - Maintains the return stack (the VMS user stack)
                                     0000    63 ;   R11 - The operand stack
                                     0000    64 ;   R10 - Next open byte in the dictionary--"HERE"
                                     0000    65 ;   R9  - Index into current input line
                                     0000    66 ;   R8  - Points to last entry in the dictionary chain
                                     0000    67 ;
                                     0000    68 ; A dictionary entry is laid out as:
                                     0000    69 ;    0  link to the previous entry (0 ends the chain)
                                     0000    70 ;    4  PFA: address of the word's code
                                     0000    71 ;    8  SFP: for a primitive, the length of its code, without the RSB
                                     0000    72 ;   10  SFA: flag bits (XRECURSIVE, XSMUDGED, PRIORITY, PRIMITIVE)
                                     0000    73 ;   12  the word's name, as an ASCIZ string
                                     0000    74 ;
                                     0000    75 
                                     0000    76 	$FABDEF				; FAB field offsets
                                     0000    77 	$RABDEF				; RAB field offsets
                                     0000    78 	$SSDEF				; system status codes
                                     0000    79 
                                     0000    80 ;
                                     0000    81 ; These are the instruction fragments compiled into the executable code
                                     0000    82 ;
                           00009F16  0000    83 JSB_HEADER	= ^X9F16		; JSB @#...
                           00008FD0  0000    84 LIT_HEADER	= ^X8FD0		; MOVL #...,-(R11)
                           0000007B  0000    85 LIT_TAILER	= ^X7B
                           00000005  0000    86 RSB_HEADER	= ^X05			; RSB
                           00009F17  0000    87 AGAIN_HEADER	= ^X9F17		; JMP @#...
                           06128BD5  0000    88 SKIPT		= ^X06128BD5		; TSTL (R11)+ / BNEQ .+8
                                     0000    89 
                                     0000    90 ;
                                     0000    91 ; These are the other constants
                                     0000    92 ;
                           00000001  0000    93 XRECURSIVE	= 1			; SFA bits: recursive function
                           00000002  0000    94 XSMUDGED	= 2			;   SMUDGE bit
                           00000004  0000    95 PRIORITY	= 4			;   IMMEDIATE
                           00000008  0000    96 PRIMITIVE	= 8			;   PRIMITIVE--is a code macro
                                     0000    97 
                           0000000E  0000    98 DSC_T		= 14			; DSC$K_DTYPE_T, text
                           00000001  0000    99 DSC_S		= 1			; DSC$K_CLASS_S, a fixed-length string
                                     0000   100 
                           0000000A  0000   101 NL		= 10			; Newline
                           00000020  0000   102 SPC		= 32			; Space
                           00000009  0000   103 TAB		= 9			; Tab
                                     0000   104 
                           00000001  0000   105 MRKCOLON	= 1			; For control structure matching
                           00000002  0000   106 MRKIF		= 2
                           00000003  0000   107 MRKDO		= 3
                           00000004  0000   108 MRKBEGIN	= 4
                           00000005  0000   109 MRKWHILE	= 5
                                     0000   110 
                                     0000   111 ;
                                     0000   112 ; Sizes
                                     0000   113 ;
                           00000084  0000   114 LINSIZ		= 132			; Longest output line
FORTH                           Vforth, a subroutine-threaded FORTH       4-OCT-2026 19:44:35  VAX MACRO V5.4-3            Page   3
V2.0                                                                      4-OCT-2026 19:56:48  DUA1:[000000]FORTH.MAR;2          (1)

                           00000400  0000   115 INLMAX		= 1024			; Longest input record
                           00000402  0000   116 INLSIZ		= INLMAX+2		;  plus the newline and NUL we add
                           00000050  0000   117 WRDMAX		= 80			; Longest word
                           00000084  0000   118 DOTQMAX		= 132			; Longest ." string
                           00000008  0000   119 MAXDEP		= 8			; Input and output stack depths
                           00000100  0000   120 OPSDEP		= 256			; Operand stack size, in longwords
                           00007530  0000   121 DICTSIZ		= 30000			; Room for new words
                                     0000   122 
                                     0000   123 ;
                                     0000   124 ; A unit block is one open file: its FAB, its RAB, and (for output) the
                                     0000   125 ; line being built. A unit, as the input and output stacks hold it, is
                                     0000   126 ; the address of its unit block.
                                     0000   127 ;
                           00000000  0000   128 UB_FAB		= 0			; The FAB
                           00000050  0000   129 UB_RAB		= FAB$C_BLN		; The RAB
                           00000094  0000   130 UB_LEN		= UB_RAB+RAB$C_BLN	; Bytes in the output line
                           00000098  0000   131 UB_BUF		= UB_LEN+4		; The output line
                           0000011E  0000   132 UB_BLN		= UB_BUF+LINSIZ+2	;  (room for a "> " prompt after it)
                                     0000   133 
                                     0000   134 ;
                                     0000   135 ; DEFWORD builds a dictionary header for the word NAME in FORTH_WORDS,
                                     0000   136 ; chained to the one before it, then defines LABEL, the word's code,
                                     0000   137 ; where the assembly was. FLAGS are the SFA bits.
                                     0000   138 ;
                                     0000   139 ; DEFPRIM is DEFWORD for a primitive: one whose code is copied in line
                                     0000   140 ; when a definition is compiled. Its code ends with ENDPRIM LABEL, which
                                     0000   141 ; marks the end of the bytes to copy and adds the RSB.
                                     0000   142 ;
                                     0000   143 	.MACRO	DEFWORD	NAME,LABEL,FLAGS=0
                                     0000   144 	.SAVE_PSECT
                                     0000   145 	.PSECT	FORTH_WORDS,NOWRT,NOEXE,LONG
                                     0000   146 LABEL'_H:
                                     0000   147 	.ADDRESS LASTWORD
                                     0000   148 	.ADDRESS LABEL
                                     0000   149 	.WORD	0,FLAGS
                                     0000   150 	.ASCIZ	\NAME\
                                     0000   151 LASTWORD = LABEL'_H
                                     0000   152 	.RESTORE_PSECT
                                     0000   153 LABEL:
                                     0000   154 	.ENDM	DEFWORD
                                     0000   155 
                                     0000   156 	.MACRO	DEFPRIM	NAME,LABEL
                                     0000   157 	.SAVE_PSECT
                                     0000   158 	.PSECT	FORTH_WORDS,NOWRT,NOEXE,LONG
                                     0000   159 LABEL'_H:
                                     0000   160 	.ADDRESS LASTWORD
                                     0000   161 	.ADDRESS LABEL
                                     0000   162 	.WORD	LABEL'_E-LABEL,PRIMITIVE
                                     0000   163 	.ASCIZ	\NAME\
                                     0000   164 LASTWORD = LABEL'_H
                                     0000   165 	.RESTORE_PSECT
                                     0000   166 LABEL:
                                     0000   167 	.ENDM	DEFPRIM
                                     0000   168 
                                     0000   169 	.MACRO	ENDPRIM	LABEL
                                     0000   170 LABEL'_E:
                                     0000   171 	RSB
FORTH                           Vforth, a subroutine-threaded FORTH       4-OCT-2026 19:44:35  VAX MACRO V5.4-3            Page   4
V2.0                                                                      4-OCT-2026 19:56:48  DUA1:[000000]FORTH.MAR;2          (1)

                                     0000   172 	.ENDM	ENDPRIM
                                     0000   173 
                           00000000  0000   174 LASTWORD = 0				; The chain starts empty
                                     0000   175 
                                     0000   176 ;
                                     0000   177 ; ----Data
                                     0000   178 ;
                                 00000000   179 	.PSECT	FORTH_DATA,WRT,NOEXE,LONG
                                     0000   180 
                                     0000   181 SP_HOLD:				; Holds return stack base
                           00000004  0000   182 	.BLKL	1
                                     0004   183 INLINE:					; Room for a record of input
                           00000406  0004   184 	.BLKB	INLSIZ
                                     0406   185 WRD:					;  and up to an 80-char word
                           00000457  0406   186 	.BLKB	WRDMAX+1
                                     0457   187 DOTQBUF:				; A ." string
                           000004DC  0457   188 	.BLKB	DOTQMAX+1
                                     04DC   189 FPRBUF:					; "f." fraction digits
                           000004E6  04DC   190 	.BLKB	10
                           00000508  04E6   191 	.BLKB	34			; "." digits, built backward
                                 00  0508   192 PRNBUF:	.BYTE	0			;  from here
                           0000050A  0509   193 SIGN:	.BLKB	1			; Flags a number's sign
                           0000050C  050A   194 CMDLEN:	.BLKW	1			; The command text's length
                                     050C   195 ONESHOT:				; Nonzero when running a command's text
                           0000050D  050C   196 	.BLKB	1
                                     050D   197 	.ALIGN	LONG
                                     0510   198 EXITSTS:				; The status forth exits with
                           00000001  0510   199 	.LONG	SS$_NORMAL
                                     0514   200 	.ALIGN	LONG
                               03F9' 0514   201 CMDDSC:	.WORD	INLMAX-HALT_LEN		; Descriptor: the command's text
                              01 0E  0516   202 	.BYTE	DSC_T,DSC_S		;  goes into INLINE, leaving room
                           00000004' 0518   203 	.ADDRESS INLINE			;  to add " halt" 
                           0000000A  051C   204 BASE:	.LONG	10			; BASE variable--the current base
                           00000000  0520   205 STATE:	.LONG	0			; STATE variable--0=interp, 1=compiling
                                     0524   206 
                                     0524   207 ;
                                     0524   208 ; The operand stack, which grows down from OPSTK_END. The guard after
                                     0524   209 ; it keeps a word run on an empty stack from storing into anything else.
                                     0524   210 ;
                                     0524   211 	.ALIGN	LONG
                           00000924  0524   212 OPSTK:	.BLKL	OPSDEP
                                     0924   213 OPSTK_END:
                           00000934  0924   214 	.BLKL	4
                                     0934   215 
                                     0934   216 ;
                                     0934   217 ; Pushdown lists of input & output units. The terminal is at the
                                     0934   218 ; bottom of each.
                                     0934   219 ;
                           000025B8' 0934   220 ISTK:	.ADDRESS TTIN
                           00000954  0938   221 	.BLKL	MAXDEP-1
                           00000934' 0954   222 ISP:	.ADDRESS ISTK
                           00000000  0958   223 IDEEP:	.LONG	0
                           000025B8' 095C   224 IUNIT:	.ADDRESS TTIN
                           000026D8' 0960   225 OSTK:	.ADDRESS TTOUT
                           00000980  0964   226 	.BLKL	MAXDEP-1
                           00000960' 0980   227 OSP:	.ADDRESS OSTK
                           00000000  0984   228 ODEEP:	.LONG	0
FORTH                           Vforth, a subroutine-threaded FORTH       4-OCT-2026 19:44:35  VAX MACRO V5.4-3            Page   5
V2.0                                                                      4-OCT-2026 19:56:48  DUA1:[000000]FORTH.MAR;2          (1)

                           000026D8' 0988   229 OUNIT:	.ADDRESS TTOUT
                                     098C   230 
                                     098C   231 ;
                                     098C   232 ; KLUDGE city! When we push down an input file, we have to save the buffer,
                                     098C   233 ;   otherwise the new input file will abuse it in various undesireable
                                     098C   234 ;   ways. So we make room for a save image of each input unit.
                                     098C   235 ;
                           0000259A  098C   236 IBUFS:	.BLKB	INLSIZ*<MAXDEP-1>	; The input buffers
                           000025B6  259A   237 IBUFX:	.BLKL	MAXDEP-1		;  and the current position within them
                                     25B6   238 
                                     25B6   239 ;
                                     25B6   240 ; The terminal's unit blocks. Each $GET from the terminal prompts with
                                     25B6   241 ; whatever's in RAB$L_PBF, which GETLIN sets.
                                     25B6   242 ;
                                     25B6   243 	.ALIGN	LONG
                                     25B8   244 TTIN:	$FAB	FNM=<SYS$INPUT>,FAC=GET
                                     2608   245 	$RAB	FAB=TTIN,UBF=INLINE,USZ=INLMAX,ROP=PMT
                           00000000  264C   246 	.LONG	0
                           000026D6  2650   247 	.BLKB	LINSIZ+2
                                     26D6   248 
                                     26D6   249 	.ALIGN	LONG
                                     26D8   250 TTOUT:	$FAB	FNM=<SYS$OUTPUT>,FAC=PUT,RAT=CR
                                     2728   251 	$RAB	FAB=TTOUT
                           00000000  276C   252 	.LONG	0
                           000027F6  2770   253 	.BLKB	LINSIZ+2
                                     27F6   254 
                                     27F6   255 ;
                                     27F6   256 ; The unit blocks of the files "input" and "output" open, one for each
                                     27F6   257 ; level of nesting.
                                     27F6   258 ;
                                     27F6   259 	.ALIGN	LONG
                           00002FCA  27F8   260 IUNITS:	.BLKB	UB_BLN*<MAXDEP-1>
                           0000379C  2FCA   261 OUNITS:	.BLKB	UB_BLN*<MAXDEP-1>
                                     379C   262 
                                     379C   263 ;
                                     379C   264 ; ----Constant text and tables
                                     379C   265 ;
                                 00000000   266 	.PSECT	FORTH_TEXT,NOWRT,NOEXE,LONG
                                     0000   267 
                                     0000   268 ;
                                     0000   269 ; The FAB and RAB an input or output file's unit block starts as.
                                     0000   270 ;
                                     0000   271 IFABT:	$FAB	FAC=GET,DNM=<.FTH>
                                     0050   272 IRABT:	$RAB	UBF=INLINE,USZ=INLMAX
                                     0094   273 OFABT:	$FAB	FAC=PUT,RAT=CR,DNM=<.LIS>
                                     00E4   274 ORABT:	$RAB
                                     0128   275 
                                     0128   276 HALT_TEXT:				; What follows the command's text
               00 0A 74 6C 61 68 20  0128   277 	.ASCII	/ halt/<NL><0>
                           00000007  012F   278 HALT_LEN = .-HALT_TEXT
20 30 2E 32 56 20 68 74 72 6F 66 56  012F   279 BANNER:	.ASCIZ	|Vforth V2.0 -- "halt" or Ctrl/Z to exit|<NL>
72 6F 20 22 74 6C 61 68 22 20 2D 2D  013B       
65 20 6F 74 20 5A 2F 6C 72 74 43 20  0147       
