                       7B   02   D0  02E6   749 	MOVL	#MRKIF,-(R11)		; Mark the control structure
                                 05  02E9   750 	RSB
                                     02EA   751 
                                     02EA   752 ;
                                     02EA   753 ; "else"
                                     02EA   754 ;
                                     02EA   755 	DEFWORD	<else>,F_ELSE,PRIORITY
                       8B   02   D1  02EA   756 	CMPL	#MRKIF,(R11)+		; Check for matching IF
                            15   12  02ED   757 	BNEQ	10$
                  8A   9F17 8F   B0  02EF   758 	MOVW	#AGAIN_HEADER,(R10)+	; JMP @#...
                       50   5A   D0  02F4   759 	MOVL	R10,R0
                       5A   04   C0  02F7   760 	ADDL2	#4,R10			; Leave room for the jump address
                       9B   5A   D0  02FA   761 	MOVL	R10,@(R11)+		; Have FALSE branch here
                       7B   50   D0  02FD   762 	MOVL	R0,-(R11)		; Put our fill-in addr.
                       7B   02   D0  0300   763 	MOVL	#MRKIF,-(R11)		;  and put back the marker
                                 05  0303   764 	RSB
              50   000001AB'EF   9E  0304   765 10$:	MOVAB	ELSE_MSG,R0		; Complain
                          051A   30  030B   766 	BSBW	PRSTR
                          FD9F   31  030E   767 	BRW	ABORT
                                     0311   768 
                                     0311   769 ;
                                     0311   770 ; endif--finish off the conditional
                                     0311   771 ;
                                     0311   772 	DEFWORD	<endif>,F_ENDIF,PRIORITY
                       02   8B   D1  0311   773 	CMPL	(R11)+,#MRKIF		; Check match
                            04   12  0314   774 	BNEQ	10$
                       9B   5A   D0  0316   775 	MOVL	R10,@(R11)+
                                 05  0319   776 	RSB
              50   000001CB'EF   9E  031A   777 10$:	MOVAB	ENDIF_MSG,R0		; Complain on no match
                          0504   30  0321   778 	BSBW	PRSTR
                          FD89   31  0324   779 	BRW	ABORT
                                     0327   780 
                                     0327   781 ;
                                     0327   782 ; begin--start of all looping conditionals
                                     0327   783 ;
                                     0327   784 	DEFWORD	<begin>,F_BEGIN,PRIORITY
                       7B   5A   D0  0327   785 	MOVL	R10,-(R11)		; Save current address
                       7B   04   D0  032A   786 	MOVL	#MRKBEGIN,-(R11)	;  and control structure marker
                                 05  032D   787 	RSB
                                     032E   788 
                                     032E   789 ;
                                     032E   790 ; "while".."repeat" looping construct
                                     032E   791 ;
                                     032E   792 	DEFWORD	<while>,F_WHILE,PRIORITY
                       8B   04   D1  032E   793 	CMPL	#MRKBEGIN,(R11)+	; Check match
                            16   12  0331   794 	BNEQ	10$
              8A   06128BD5 8F   D0  0333   795 	MOVL	#SKIPT,(R10)+		; TSTL (R11)+ / BNEQ .+8
                  8A   9F17 8F   B0  033A   796 	MOVW	#AGAIN_HEADER,(R10)+	; JMP @#<forward>
                       7B   5A   D0  033F   797 	MOVL	R10,-(R11)		; Mark where to plug in
                       5A   04   C0  0342   798 	ADDL2	#4,R10			; Leave room for the patch
                       7B   05   D0  0345   799 	MOVL	#MRKWHILE,-(R11)
                                 05  0348   800 	RSB
              50   000001F0'EF   9E  0349   801 10$:	MOVAB	WHILE_MSG,R0		; Bad match, complain
                          04D5   30  0350   802 	BSBW	PRSTR
                          FD5A   31  0353   803 	BRW	ABORT
                                     0356   804 
                                     0356   805 	DEFWORD	<repeat>,F_REPEAT,PRIORITY
