              5B   00000924'EF   9E  008D   355 	MOVAB	OPSTK_END,R11		; Empty the operand stack
                   00000520'EF   D4  0094   356 	CLRL	STATE			; Not compiling
              59   00000004'EF   9E  009A   357 	MOVAB	INLINE,R9		; Interpret the command's text
                          05D2   31  00A1   358 	BRW	INTERP
