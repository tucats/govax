                                     00B0   363 
                                     00B0   364 ;
                                     00B0   365 ; abort--reset the stacks and the input, and restart the interpreter.
                                     00B0   366 ;   When running a command's text, there's no restarting: forth exits
                                     00B0   367 ;   with SS$_ABORT instead.
                                     00B0   368 ;
              5E   00000000'EF   D0  00B0   369 ABORT:	MOVL	SP_HOLD,SP		; Start SP from its initial value
                   0000050C'EF   95  00B7   370 	TSTB	ONESHOT			; Running a command's text?
                            0A   13  00BD   371 	BEQL	10$
              00000510'EF   2C   D0  00BF   372 	MOVL	#SS$_ABORT,EXITSTS	; Yes, give up
                          0111   31  00C6   373 	BRW	F_HALT
                          0AAF   30  00C9   374 10$:	BSBW	CLOSEALL		; Back to the terminal
              5B   00000924'EF   9E  00CC   375 	MOVAB	OPSTK_END,R11		; Empty the operand stack
                   00000520'EF   D4  00D3   376 	CLRL	STATE			; Turn off compile mode
              59   00000004'EF   9E  00D9   377 	MOVAB	INLINE,R9		; Set up input line as empty
                            69   94  00E0   378 	CLRB	(R9)
                          0591   31  00E2   379 	BRW	INTERP			; Start up the interpretive loop
