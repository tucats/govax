                                     03C8   872 ;
                                     03C8   873 ; "do"--start a loop ( limit index -- ). At run time the return stack
                                     03C8   874 ;   holds the limit at (SP) and the index at 4(SP).
                                     03C8   875 ;
                           D07E8BD0  03C8   876 XDO1	= ^XD07E8BD0		; MOVL (R11)+,-(SP) / MOVL (R11)+,-(SP)
                           00007E8B  03C8   877 XDO2	= ^X7E8B
                           D0508ED0  03C8   878 XDO3	= ^XD0508ED0		; MOVL (SP)+,R0 / MOVL (SP)+,R1
                           51D1518E  03C8   879 XDO4	= ^X51D1518E		;   CMPL R1,R0 / BLSS .+8
                           17061950  03C8   880 XDO5	= ^X17061950		;   JMP @#<forward>
                           0000009F  03C8   881 XDO6	= ^X9F
                           D07E51D0  03C8   882 XDO7	= ^XD07E51D0		; MOVL R1,-(SP) / MOVL R0,-(SP)
                           00007E50  03C8   883 XDO8	= ^X7E50
                                     03C8   884 
                                     03C8   885 	DEFWORD	<do>,F_DO,PRIORITY
              8A   D07E8BD0 8F   D0  03C8   886 	MOVL	#XDO1,(R10)+
                  8A   7E8B 8F   B0  03CF   887 	MOVW	#XDO2,(R10)+
                       7B   5A   D0  03D4   888 	MOVL	R10,-(R11)		; Save current pos. for back branch
              8A   D0508ED0 8F   D0  03D7   889 	MOVL	#XDO3,(R10)+
              8A   51D1518E 8F   D0  03DE   890 	MOVL	#XDO4,(R10)+
              8A   17061950 8F   D0  03E5   891 	MOVL	#XDO5,(R10)+
                    8A   9F 8F   90  03EC   892 	MOVB	#XDO6,(R10)+
                       7B   5A   D0  03F0   893 	MOVL	R10,-(R11)		; Save this loc for fill-in as forward branch
                       5A   04   C0  03F3   894 	ADDL2	#4,R10
              8A   D07E51D0 8F   D0  03F6   895 	MOVL	#XDO7,(R10)+
                  8A   7E50 8F   B0  03FD   896 	MOVW	#XDO8,(R10)+
                       7B   03   D0  0402   897 	MOVL	#MRKDO,-(R11)		; Flag our control structure
                                 05  0405   898 	RSB
