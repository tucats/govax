                         16 50   E9  092E  1547 	BLBC	R0,20$			; Test for EOF
                    50   72 A2   3C  0931  1548 	MOVZWL	UB_RAB+RAB$W_RSZ(R2),R0
              59   00000004'EF   9E  0935  1549 	MOVAB	INLINE,R9		; Set the input line pointer
                     6940   0A   90  093C  1550 	MOVB	#NL,(R9)[R0]		; Terminate the line
                       01 A940   94  0940  1551 	CLRB	1(R9)[R0]
                            3E   BA  0944  1552 	POPR	#^M<R1,R2,R3,R4,R5>
                                 05  0946  1553 	RSB
                                     0947  1554 
              50   000025B8'EF   DE  0947  1555 20$:	MOVAL	TTIN,R0			; If at top, forth exits
                       50   52   D1  094E  1556 	CMPL	R2,R0
                            03   12  0951  1557 	BNEQ	30$
                          F884   31  0953  1558 	BRW	F_HALT
                                     0956  1559 30$:	$CLOSE	FAB=(R2)		; EOF--Close the unit
                   00000958'EF   D7  095F  1560 	DECL	IDEEP			; Decrement nesting depth count
              00000954'EF   04   C2  0965  1561 	SUBL2	#4,ISP			; Pop back to the input before it
     0000095C'EF   00000954'FF   D0  096C  1562 	MOVL	@ISP,IUNIT
50   00000958'EF   00000402 8F   C5  0977  1563 	MULL3	#INLSIZ,IDEEP,R0	; Restore its buffer
       0000098C'EF40   0402 8F   28  0983  1564 	MOVC3	#INLSIZ,IBUFS[R0],INLINE
                   00000004'EF       098D       
              50   00000958'EF   D0  0992  1565 	MOVL	IDEEP,R0		; and its input index
            59   0000259A'EF40   D0  0999  1566 	MOVL	IBUFX[R0],R9
                            3E   BA  09A1  1567 	POPR	#^M<R1,R2,R3,R4,R5>
                                 05  09A3  1568 	RSB				; Return with the restored input buffer
                                     09A4  1569 
                                     09A4  1570 ;
                                     09A4  1571 ; getw--get the next word in the current input line. If there are no
                                     09A4  1572 ;   more words in this line, get another from the input. Uses R0, R1,
                                     09A4  1573 ;   and R3.
                                     09A4  1574 ;
                          FF2A   30  09A4  1575 GETW:	BSBW	ISWHITE			; Skip initial white space
                            09   12  09A7  1576 	BNEQ	10$
                            89   95  09A9  1577 	TSTB	(R9)+			; Is white. If NULL, need new line
                            F7   12  09AB  1578 	BNEQ	GETW
                          FF36   30  09AD  1579 	BSBW	GETLIN
                            F2   11  09B0  1580 	BRB	GETW
              50   00000406'EF   9E  09B2  1581 10$:	MOVAB	WRD,R0			; Found word. Copy into "wrd"
              51   00000456'EF   9E  09B9  1582 	MOVAB	WRD+WRDMAX,R1		;  up to this far
                       51   50   D1  09C0  1583 20$:	CMPL	R0,R1
                            03   1E  09C3  1584 	BGEQU	30$
                       80   69   90  09C5  1585 	MOVB	(R9),(R0)+
                            59   D6  09C8  1586 30$:	INCL	R9
                          FF04   30  09CA  1587 40$:	BSBW	ISWHITE
                            F1   12  09CD  1588 	BNEQ	20$
                            69   95  09CF  1589 	TSTB	(R9)			; Read new buffer if at end
                            0A   12  09D1  1590 	BNEQ	50$
                            50   DD  09D3  1591 	PUSHL	R0			; Save R0, then call "getlin"
                          FF0E   30  09D5  1592 	BSBW	GETLIN
                       50   8E   D0  09D8  1593 	MOVL	(SP)+,R0
                            ED   11  09DB  1594 	BRB	40$
                            60   94  09DD  1595 50$:	CLRB	(R0)			; add NULL at end of word
                                 05  09DF  1596 	RSB
