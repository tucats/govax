                                     05C9  1188 ;
                                     05C9  1189 ; sin & cos (and the corresponding fsin & fcos)
                                     05C9  1190 ;
                                     05C9  1191 	DEFWORD	<sin>,F_SIN
                       50   8B   D0  05C9  1192 	MOVL	(R11)+,R0		; Get angle
                            51   D4  05CC  1193 	CLRL	R1			; Negative quadrant flag
                            50   D5  05CE  1194 10$:	TSTL	R0			; Fold negative angles
                            09   18  05D0  1195 	BGEQ	20$
              50   00000168 8F   C0  05D2  1196 	ADDL2	#360,R0
                            F3   11  05D9  1197 	BRB	10$
              00000168 8F   50   D1  05DB  1198 20$:	CMPL	R0,#360			; Fold angles > 360
                            09   19  05E2  1199 	BLSS	30$
              50   00000168 8F   C2  05E4  1200 	SUBL2	#360,R0
                            EE   11  05EB  1201 	BRB	20$
              000000B5 8F   50   D1  05ED  1202 30$:	CMPL	R0,#181			; Flag & fold negative quadrant vals
                            0C   19  05F4  1203 	BLSS	40$
                    51   FF 8F   90  05F6  1204 	MOVB	#-1,R1
