                          FC5B   31  0452   936 	BRW	ABORT
                                     0455   937 
                                     0455   938 ;
                                     0455   939 ; "@"--fetch the contents of the addressed word
                                     0455   940 ;
                                     0455   941 	DEFPRIM	<@>,F_FETCH
                    6B   00 BB   D0  0455   942 	MOVL	@(R11),(R11)
