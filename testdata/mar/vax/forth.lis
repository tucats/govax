                            38   13  0211   607 	BEQL	20$
              51   00000988'EF   D0  0213   608 	MOVL	OUNIT,R1		; Write the unit's last line
                       0094 C1   D5  021A   609 	TSTL	UB_LEN(R1)
                            03   13  021E   610 	BEQL	10$
                          063F   30  0220   611 	BSBW	FLUSHU
              51   00000988'EF   D0  0223   612 10$:	MOVL	OUNIT,R1		; Close the current unit
                                     022A   613 	$CLOSE	FAB=(R1)
              00000980'EF   04   C2  0233   614 	SUBL2	#4,OSP			; Move back a position
     00000988'EF   00000980'FF   D0  023A   615 	MOVL	@OSP,OUNIT		;  and set output to that unit
                   00000984'EF   D7  0245   616 	DECL	ODEEP			; Decrement nesting count
                                 05  024B   617 20$:	RSB
