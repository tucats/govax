                                     0798  1372 ; badwrd--print the offending word, then call abort to restart the
                                     0798  1373 ;   interpreter.
                                     0798  1374 ;
              50   00000406'EF   9E  0798  1375 BADWRD:	MOVAB	WRD,R0			; First print the offending word
