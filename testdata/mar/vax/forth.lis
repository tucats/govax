                                     05B7  1169 
                                     05B7  1170 ;
                                     05B7  1171 ; (.")--run-time code to print a string: the string follows the JSB
                                     05B7  1172 ;   that called us, and we return past it
                                     05B7  1173 ;
                                     05B7  1174 	DEFWORD	^%(.")%,F_PDOTQ
                       50   8E   D0  05B7  1175 	MOVL	(SP)+,R0		; Get the address of our return loc.
                          026B   30  05BA  1176 	BSBW	PRSTR			; Print the string
                            62   17  05BD  1177 	JMP	(R2)			; Return to addr following string
                                     05BF  1178 
                                     05BF  1179 ;
                                     05BF  1180 ; "."--pop and print the top number on the stack, then a blank
                                     05BF  1181 ;
                                     05BF  1182 	DEFWORD	<.>,F_DOT
                          021E   30  05BF  1183 	BSBW	PRINT_INT
                       50   20   9A  05C2  1184 	MOVZBL	#SPC,R0
                          026E   30  05C5  1185 	BSBW	PUTCH
                                 05  05C8  1186 	RSB
