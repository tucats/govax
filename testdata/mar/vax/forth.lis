                                     01D7   579 ;
                                     01D7   580 ; "abort"--calls the forth abort code
                                     01D7   581 ;
                                     01D7   582 	DEFWORD	<abort>,F_ABORT
                          FED6   31  01D7   583 	BRW	ABORT
                                     01DA   584 
                                     01DA   585 ;
                                     01DA   586 ; "halt"--cause forth to exit, closing any files. The dictionary's end
                                     01DA   587 ;   is saved, as the original's resident version needed.
                                     01DA   588 ;
                                     01DA   589 	DEFWORD	<halt>,F_HALT
                          099E   30  01DA   590 	BSBW	CLOSEALL		; Close the files
              51   000026D8'EF   DE  01DD   591 	MOVAL	TTOUT,R1		; Finish the terminal's last line
                       0094 C1   D5  01E4   592 	TSTL	UB_LEN(R1)
                            03   13  01E8   593 	BEQL	10$
                          0675   30  01EA   594 	BSBW	FLUSHU
              000037A0'EF   5A   D0  01ED   595 10$:	MOVL	R10,DICTEND		; save end of dictionary storage area
              0000379C'EF   58   D0  01F4   596 	MOVL	R8,LATEST		; end of dictionary linked list
              50   00000510'EF   D0  01FB   597 	MOVL	EXITSTS,R0		; SS$_NORMAL, unless abort says otherwise
                                 04  0202   598 	RET
                                     0203   599 
                                     0203   600 ;
                                     0203   601 ; "outpop"--do for the output list what EOF does for the input list;
                                     0203   602 ;   close the current output file & pop back a level
