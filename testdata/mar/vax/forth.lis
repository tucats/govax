                          FFC1   30  09E0  1603 MKHEAD:	BSBW	GETW			; Get the name of the new word
                       52   58   D0  09E3  1604 	MOVL	R8,R2			; Add this word to the chain
                       58   5A   D0  09E6  1605 	MOVL	R10,R8
                       8A   52   D0  09E9  1606 	MOVL	R2,(R10)+
                       50   5A   D0  09EC  1607 	MOVL	R10,R0			; Save this position (PFA)
                            8A   D4  09EF  1608 	CLRL	(R10)+
                       8A   54   B0  09F1  1609 	MOVW	R4,(R10)+		; SFP
                       8A   55   B0  09F4  1610 	MOVW	R5,(R10)+		; SFA
              51   00000406'EF   9E  09F7  1611 	MOVAB	WRD,R1			; Now copy the name in
                       8A   81   90  09FE  1612 10$:	MOVB	(R1)+,(R10)+
                            FB   12  0A01  1613 	BNEQ	10$
                       60   5A   D0  0A03  1614 	MOVL	R10,(R0)		; Finally, update the PFA
                                 05  0A06  1615 	RSB
                                     0A07  1616 
                                     0A07  1617 ;
                                     0A07  1618 ; setname--point the FAB of the unit at R6 at the name in "wrd", and
                                     0A07  1619 ;   its RAB at its FAB.
                                     0A07  1620 ;
                                     0A07  1621 SETNAME:
              52   00000406'EF   9E  0A07  1622 	MOVAB	WRD,R2
             62   0051 8F   00   3A  0A0E  1623 	LOCC	#0,#WRDMAX+1,(R2)	; Find the name's end
                  50   51   52   C3  0A14  1624 	SUBL3	R2,R1,R0
                    2C A6   52   D0  0A18  1625 	MOVL	R2,FAB$L_FNA(R6)
                    34 A6   50   90  0A1C  1626 	MOVB	R0,FAB$B_FNS(R6)
                  008C C6   56   D0  0A20  1627 	MOVL	R6,UB_RAB+RAB$L_FAB(R6)
                                 05  0A25  1628 	RSB
                                     0A26  1629 
                                     0A26  1630 ;
                                     0A26  1631 ; inopen--open the file named in "wrd" for input; add it to the pushdown
                                     0A26  1632 ;   stack. Error if it can't be opened.
                                     0A26  1633 ;
              07   00000958'EF   D1  0A26  1634 INOPEN:	CMPL	IDEEP,#MAXDEP-1		; Room for another?
                            0D   19  0A2D  1635 	BLSS	10$
              50   00000191'EF   9E  0A2F  1636 	MOVAB	DEEP_MSG,R0
                          FDEF   30  0A36  1637 	BSBW	PRSTR
                          F674   31  0A39  1638 	BRW	ABORT
56   00000958'EF   0000011E 8F   C5  0A3C  1639 10$:	MULL3	#UB_BLN,IDEEP,R6	; R6 -> the unit block for it
            56   000027F8'EF46   9E  0A48  1640 	MOVAB	IUNITS[R6],R6
    66   00000000'EF   0050 8F   28  0A50  1641 	MOVC3	#FAB$C_BLN,IFABT,(R6)
 50 A6   00000050'EF   0044 8F   28  0A5A  1642 	MOVC3	#RAB$C_BLN,IRABT,UB_RAB(R6)
                          FF9F   30  0A65  1643 	BSBW	SETNAME
                       0094 C6   D4  0A68  1644 	CLRL	UB_LEN(R6)
                                     0A6C  1645 	$OPEN	FAB=(R6)
                         65 50   E9  0A75  1646 	BLBC	R0,90$
                                     0A78  1647 	$CONNECT RAB=UB_RAB(R6)
                         4F 50   E9  0A82  1648 	BLBC	R0,80$
                                     0A85  1649 
50   00000958'EF   00000402 8F   C5  0A85  1650 	MULL3	#INLSIZ,IDEEP,R0	; Open successful, save previous buffer
         00000004'EF   0402 8F   28  0A91  1651 	MOVC3	#INLSIZ,INLINE,IBUFS[R0]
