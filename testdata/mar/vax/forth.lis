                                     02A1   697 	DEFWORD	^%>%,F_GT		; Greater than
                       6B   8B   D1  02A1   698 	CMPL	(R11)+,(R11)
                            03   19  02A4   699 	BLSS	10$
                            6B   D4  02A6   700 	CLRL	(R11)
                                 05  02A8   701 	RSB
                    6B   FF 8F   98  02A9   702 10$:	CVTBL	#-1,(R11)
                                 05  02AD   703 	RSB
                                     02AE   704 
                                     02AE   705 	DEFWORD	^%<%,F_LT		; Less than
                       6B   8B   D1  02AE   706 	CMPL	(R11)+,(R11)
                            03   14  02B1   707 	BGTR	10$
                            6B   D4  02B3   708 	CLRL	(R11)
                                 05  02B5   709 	RSB
                    6B   FF 8F   98  02B6   710 10$:	CVTBL	#-1,(R11)
                                 05  02BA   711 	RSB
                                     02BB   712 
                                     02BB   713 ;
                                     02BB   714 ; drop,2drop--get rid of top item(s)
                                     02BB   715 ;
                                     02BB   716 	DEFPRIM	<2drop>,F_TWODROP
                       5B   08   C0  02BB   717 	ADDL2	#8,R11
                                     02BE   718 	ENDPRIM	F_TWODROP
                                     02BF   719 
                                     02BF   720 	DEFPRIM	<drop>,F_DROP
                       50   8B   D0  02BF   721 	MOVL	(R11)+,R0
                                     02C2   722 	ENDPRIM	F_DROP
                                     02C3   723 
                                     02C3   724 ;
                                     02C3   725 ; swap--exchange top & second
                                     02C3   726 ;
                                     02C3   727 	DEFPRIM	<swap>,F_SWAP
                       50   8B   D0  02C3   728 	MOVL	(R11)+,R0
                       51   6B   D0  02C6   729 	MOVL	(R11),R1
                       6B   50   D0  02C9   730 	MOVL	R0,(R11)
                       7B   51   D0  02CC   731 	MOVL	R1,-(R11)
                                     02CF   732 	ENDPRIM	F_SWAP
                                     02D0   733 
                                     02D0   734 ;
                                     02D0   735 ; dup--duplicate top
                                     02D0   736 ;
                                     02D0   737 	DEFPRIM	<dup>,F_DUP
                       7B   6B   D0  02D0   738 	MOVL	(R11),-(R11)
                                     02D3   739 	ENDPRIM	F_DUP
                                     02D4   740 
                                     02D4   741 ;
                                     02D4   742 ; "if"--conditional control structure
                                     02D4   743 ;
                                     02D4   744 	DEFWORD	<if>,F_IF,PRIORITY
              8A   06128BD5 8F   D0  02D4   745 	MOVL	#SKIPT,(R10)+		; TSTL (R11)+ / BNEQ .+8
                  8A   9F17 8F   B0  02DB   746 	MOVW	#AGAIN_HEADER,(R10)+	; JMP @#...
                       7B   5A   D0  02E0   747 	MOVL	R10,-(R11)
                       5A   04   C0  02E3   748 	ADDL2	#4,R10
FORTH                           Vforth, a subroutine-threaded FORTH       4-OCT-2026 19:44:35  VAX MACRO V5.4-3            Page  15
