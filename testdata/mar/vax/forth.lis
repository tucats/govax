                                     07AF  1381 ;
                                     07AF  1382 ; isdig--return Z if the character at R7 is a digit in base R6 (watch
                                     07AF  1383 ;   out for HEX!). Uses R3 and R4.
                                     07AF  1384 ;
                       53   67   90  07AF  1385 ISDIG:	MOVB	(R7),R3			; Put the char in question into R3
                       30   53   91  07B2  1386 	CMPB	R3,#^A/0/		; Check for 0..9
                            25   1F  07B5  1387 	BLSSU	90$
                       39   53   91  07B7  1388 	CMPB	R3,#^A/9/
                            1D   1B  07BA  1389 	BLEQU	80$
                       0B   56   D1  07BC  1390 	CMPL	R6,#11			; For higher bases, check A..?
                            1B   19  07BF  1391 	BLSS	90$
                  54   56   36   C1  07C1  1392 	ADDL3	#^A/A/-11,R6,R4		; Change the base into the highest char
                    61 8F   53   91  07C5  1393 	CMPB	R3,#^A/a/		; Map a..? to A..?
                            03   1F  07C9  1394 	BLSSU	10$
                       53   20   82  07CB  1395 	SUBB2	#^A/a/-^A/A/,R3
                    41 8F   53   91  07CE  1396 10$:	CMPB	R3,#^A/A/		; Check against 'A'
                            08   1F  07D2  1397 	BLSSU	90$
                       54   53   91  07D4  1398 	CMPB	R3,R4			; Check against highest char
                            03   1A  07D7  1399 	BGTRU	90$
                            53   D4  07D9  1400 80$:	CLRL	R3			; A digit: Z
                                 05  07DB  1401 	RSB
                       53   01   D0  07DC  1402 90$:	MOVL	#1,R3			; Not a digit: NZ
                                 05  07DF  1403 	RSB
                                     07E0  1404 
                                     07E0  1405 ;
                                     07E0  1406 ; print_int--pop the top number and print it in BASE
                                     07E0  1407 ;
                                     07E0  1408 PRINT_INT:
              55   0000051C'EF   D0  07E0  1409 	MOVL	BASE,R5			; Get the base
              51   00000508'EF   9E  07E7  1410 	MOVAB	PRNBUF,R1		; R1 points to the char positions
                       50   8B   D0  07EE  1411 	MOVL	(R11)+,R0		; R0 holds the number
                       52   50   D0  07F1  1412 	MOVL	R0,R2			; Keep a copy to do the sign
                            03   18  07F4  1413 	BGEQ	10$			; Negate if negative
                       50   50   CE  07F6  1414 	MNEGL	R0,R0
                  53   50   55   C7  07F9  1415 10$:	DIVL3	R5,R0,R3		; R3 holds new number
                  54   53   55   C5  07FD  1416 	MULL3	R5,R3,R4		; Calculate remainder the hard way
                  54   50   54   C3  0801  1417 	SUBL3	R4,R0,R4
                       09   54   D1  0805  1418 	CMPL	R4,#9			; See if it's a HEX digit
                            07   15  0808  1419 	BLEQ	20$
               71   54   57 8F   81  080A  1420 	ADDB3	#^A/a/-10,R4,-(R1)
                            04   11  080F  1421 	BRB	30$
                  71   54   30   81  0811  1422 20$:	ADDB3	#^A/0/,R4,-(R1)		; Put it in as the next digit
                       50   53   D0  0815  1423 30$:	MOVL	R3,R0			; Update number
                            DF   12  0818  1424 	BNEQ	10$
                            52   D5  081A  1425 	TSTL	R2			; Now check sign
                            03   18  081C  1426 	BGEQ	40$
                       71   2D   90  081E  1427 	MOVB	#^A/-/,-(R1)
                       50   51   D0  0821  1428 40$:	MOVL	R1,R0			; print the number
                          0001   30  0824  1429 	BSBW	PRSTR
                                 05  0827  1430 	RSB
