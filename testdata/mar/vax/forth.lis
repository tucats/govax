                                     050C  1104 ;
                                     050C  1105 ; "f."--print a floating point number, then a blank
                                     050C  1106 ;
                                     050C  1107 	DEFWORD	<f.>,F_FDOT
                            6B   53  050C  1108 	TSTF	(R11)			; If it's negative...
                            09   18  050E  1109 	BGEQ	10$
                       50   2D   9A  0510  1110 	MOVZBL	#^A/-/,R0		;  Print a '-'
                          0320   30  0513  1111 	BSBW	PUTCH
                       6B   6B   52  0516  1112 	MNEGF	(R11),(R11)		;  And negate it
                       7B   6B   4A  0519  1113 10$:	CVTFL	(R11),-(R11)		; Print the integer part
                          02C1   30  051C  1114 	BSBW	PRINT_INT
              53   000004DC'EF   9E  051F  1115 	MOVAB	FPRBUF,R3		; R3 points to buffer position
                       50   8B   50  0526  1116 	MOVF	(R11)+,R0		; Get the number
                       51   50   4A  0529  1117 	CVTFL	R0,R1			; Get the integer part
                       51   51   4E  052C  1118 	CVTLF	R1,R1
                       50   51   42  052F  1119 	SUBF2	R1,R0			; And take it off the number
                       83   2E   90  0532  1120 	MOVB	#^A/./,(R3)+		; The decimal point
                       54   06   D0  0535  1121 	MOVL	#6,R4			; We always print 6 places
                       50   22   44  0538  1122 20$:	MULF2	#10.0,R0		; Get the next digit
                       51   50   4A  053B  1123 	CVTFL	R0,R1			; R1 is the next digit
                       55   51   4E  053E  1124 	CVTLF	R1,R5			; Take this digit off the number
                       50   55   42  0541  1125 	SUBF2	R5,R0
                  83   51   30   81  0544  1126 	ADDB3	#^A/0/,R1,(R3)+		; Turn it into the ASCII byte
                         ED 54   F5  0548  1127 	SOBGTR	R4,20$			; Loop 6 times
                       83   20   90  054B  1128 	MOVB	#SPC,(R3)+
                            63   94  054E  1129 	CLRB	(R3)
              50   000004DC'EF   9E  0550  1130 	MOVAB	FPRBUF,R0		; Now print it
                          02CE   30  0557  1131 	BSBW	PRSTR
                                 05  055A  1132 	RSB
                                     055B  1133 
                                     055B  1134 ;
                                     055B  1135 ; ." --if compiling, generate code to print a string, otherwise just
                                     055B  1136 ;   print the string
                                     055B  1137 ;
                                     055B  1138 	DEFWORD	^%."%,F_DOTQ,PRIORITY
              51   00000457'EF   9E  055B  1139 	MOVAB	DOTQBUF,R1
              52   000004DB'EF   9E  0562  1140 	MOVAB	DOTQBUF+DOTQMAX,R2	; Where the string has to stop
                       20   69   91  0569  1141 	CMPB	(R9),#SPC		; Skip char if it's the separating blank
                            02   12  056C  1142 	BNEQ	10$
                            59   D6  056E  1143 	INCL	R9
                       50   89   90  0570  1144 10$:	MOVB	(R9)+,R0		; get the next char of the string
                       22   50   91  0573  1145 	CMPB	R0,#^A/"/		; End string on newline or close quote
                            18   13  0576  1146 	BEQL	30$
                       0A   50   91  0578  1147 	CMPB	R0,#NL
