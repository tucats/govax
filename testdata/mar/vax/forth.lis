                                     0828  1433 ; prstr--print the null-terminated string pointed to by R0 on the
                                     0828  1434 ;   output unit. Returns R2 pointing past the NUL. Uses R0 and R1.
                                     0828  1435 ;
                       52   50   D0  0828  1436 PRSTR:	MOVL	R0,R2
                       50   82   9A  082B  1437 10$:	MOVZBL	(R2)+,R0
                            05   13  082E  1438 	BEQL	20$
                          0003   30  0830  1439 	BSBW	PUTCH
                            F6   11  0833  1440 	BRB	10$
                                 05  0835  1441 20$:	RSB
                                     0836  1442 
                                     0836  1443 ;
                                     0836  1444 ; putch--write the character in R0 to the output unit: a newline ends
                                     0836  1445 ;   the line, writing it as a record, as does a full line. Uses R0 and R1.
                                     0836  1446 ;
              51   00000988'EF   D0  0836  1447 PUTCH:	MOVL	OUNIT,R1
                       0A   50   91  083D  1448 	CMPB	R0,#NL
                            20   13  0840  1449 	BEQL	FLUSHU
                            52   DD  0842  1450 	PUSHL	R2
                  52   0094 C1   D0  0844  1451 	MOVL	UB_LEN(R1),R2
                0098 C142   50   90  0849  1452 	MOVB	R0,UB_BUF(R1)[R2]
                       0094 C1   D6  084F  1453 	INCL	UB_LEN(R1)
                       52   8E   D0  0853  1454 	MOVL	(SP)+,R2
         00000084 8F   0094 C1   D1  0856  1455 	CMPL	UB_LEN(R1),#LINSIZ
                            01   18  085F  1456 	BGEQ	FLUSHU
                                 05  0861  1457 	RSB
                                     0862  1458 
                                     0862  1459 ;
                                     0862  1460 ; flushu--write the line of the unit at R1 as a record, and empty it.
                                     0862  1461 ;   Uses R0 and R1.
                                     0862  1462 ;
               78 A1   0098 C1   9E  0862  1463 FLUSHU:	MOVAB	UB_BUF(R1),UB_RAB+RAB$L_RBF(R1)
               72 A1   0094 C1   B0  0868  1464 	MOVW	UB_LEN(R1),UB_RAB+RAB$W_RSZ(R1)
                       0094 C1   D4  086E  1465 	CLRL	UB_LEN(R1)
                                     0872  1466 	$PUT	RAB=UB_RAB(R1)
                                 05  087C  1467 	RSB
                                     087D  1468 
                                     087D  1469 ;
                                     087D  1470 ; lookup--take the current word in "wrd" and see if it's in the dictionary
                                     087D  1471 ;   chain. If it is, return with address in R0 and Z; otherwise
                                     087D  1472 ;   return with NZ. If it is found, R1 will contain the SFA and R2 the
                                     087D  1473 ;   entry. Case doesn't matter, as DCL uppercases a command's text.
                                     087D  1474 ;   Uses R3, R4, and R5.
                                     087D  1475 ;
              50   00000406'EF   9E  087D  1476 LOOKUP:	MOVAB	WRD,R0			; R0 -> word
                       51   58   D0  0884  1477 	MOVL	R8,R1			; R1 -> next entry to check against
                  52   51   0C   C1  0887  1478 10$:	ADDL3	#12,R1,R2		; R2 -> cur entry's name
                       53   50   D0  088B  1479 	MOVL	R0,R3			; R3 -> our word
                    0A A1   02   B3  088E  1480 	BITW	#XSMUDGED,10(R1)	; Smudged?
                            24   12  0892  1481 	BNEQ	30$
                       54   83   90  0894  1482 20$:	MOVB	(R3)+,R4		; Compare the names, ignoring case
                            28   10  0897  1483 	BSBB	LOWER
                       55   54   90  0899  1484 	MOVB	R4,R5
                       54   62   90  089C  1485 	MOVB	(R2),R4
                            20   10  089F  1486 	BSBB	LOWER
                       55   54   91  08A1  1487 	CMPB	R4,R5
                            12   12  08A4  1488 	BNEQ	30$			;  they didn't match
                            82   95  08A6  1489 	TSTB	(R2)+			; They did; at end of names?
