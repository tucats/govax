                          055A   30  0483   977 	BSBW	MKHEAD			; Build the header
                  8A   8FD0 8F   B0  0486   978 	MOVW	#XVAR1,(R10)+		; Our in-line code
                       8A   8B   D0  048B   979 	MOVL	(R11)+,(R10)+		; the value to push
