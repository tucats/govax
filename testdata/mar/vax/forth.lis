                       7B   51   D0  0783  1364 	MOVL	R1,-(R11)
                          FEED   31  0786  1365 	BRW	INTERP
                  8A   8FD0 8F   B0  0789  1366 90$:	MOVW	#LIT_HEADER,(R10)+	; MOVL #...,-(R11)
                       8A   51   D0  078E  1367 	MOVL	R1,(R10)+
                    8A   7B 8F   90  0791  1368 	MOVB	#LIT_TAILER,(R10)+
                          FEDE   31  0795  1369 	BRW	INTERP
