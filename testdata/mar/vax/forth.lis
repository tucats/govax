                                     0676  1262 
                                     0676  1263 ;
                                     0676  1264 ; interp--the interpreter's loop: read a word, then execute it, compile
                                     0676  1265 ;   it, or push it as a number
                                     0676  1266 ;
                                     0676  1267 	DEFWORD	<interp>,INTERP
              50   00000924'EF   9E  0676  1268 	MOVAB	OPSTK_END,R0		; Check for underflow
                       50   5B   D1  067D  1269 	CMPL	R11,R0
                            09   1B  0680  1270 	BLEQU	10$
              50   000002D5'EF   9E  0682  1271 	MOVAB	EMPTY_MSG,R0		; Underflowed. Complain & abort
                            13   11  0689  1272 	BRB	15$
              50   00000524'EF   9E  068B  1273 10$:	MOVAB	OPSTK,R0		; Check for overflow
                       50   5B   D1  0692  1274 	CMPL	R11,R0
                            0D   1E  0695  1275 	BGEQU	20$
              50   000002E4'EF   9E  0697  1276 	MOVAB	FULL_MSG,R0		; Overflowed. Complain & abort
                          0187   30  069E  1277 15$:	BSBW	PRSTR
                          FA0C   31  06A1  1278 	BRW	ABORT
                                     06A4  1279 
                          02FD   30  06A4  1280 20$:	BSBW	GETW			; Get next word
                          01D3   30  06A7  1281 	BSBW	LOOKUP			; In the dictionary?
                            03   13  06AA  1282 	BEQL	30$
                          002C   31  06AC  1283 	BRW	CKNUM			;  No, see if it's a number
                   00000520'EF   95  06AF  1284 30$:	TSTB	STATE			; Yes, either compile or execute
                            04   12  06B5  1285 	BNEQ	50$
                            60   16  06B7  1286 40$:	JSB	(R0)			; execute via its address
                            BB   11  06B9  1287 	BRB	INTERP
                       51   04   D3  06BB  1288 50$:	BITL	#PRIORITY,R1		; See if it's immediate
                            F7   12  06BE  1289 	BNEQ	40$
                       51   08   D3  06C0  1290 	BITL	#PRIMITIVE,R1		; See if it generates in-line code
                            0A   12  06C3  1291 	BNEQ	60$
                  8A   9F16 8F   B0  06C5  1292 	MOVW	#JSB_HEADER,(R10)+	; compile it with a JSB header
                       8A   50   D0  06CA  1293 	MOVL	R0,(R10)+
                            A7   11  06CD  1294 	BRB	INTERP
                    51   08 A2   32  06CF  1295 60$:	CVTWL	8(R2),R1		; Get number of bytes in def.
                       8A   80   90  06D3  1296 70$:	MOVB	(R0)+,(R10)+		; Copy bytes of instructions
                         FA 51   F5  06D6  1297 	SOBGTR	R1,70$			; See if done
                            9B   11  06D9  1298 	BRB	INTERP
                                     06DB  1299 
                                     06DB  1300 ;
                                     06DB  1301 ; ----Internal routines
                                     06DB  1302 ;
                                     06DB  1303 
                                     06DB  1304 ;
                                     06DB  1305 ; cknum--the word isn't in the dictionary: push or compile it as a number
                                     06DB  1306 ;   if it is one, in BASE (or as a float, decimal, with a point)
                                     06DB  1307 ;
              57   00000406'EF   9E  06DB  1308 CKNUM:	MOVAB	WRD,R7			; R7 is our index to the line
                   00000509'EF   94  06E2  1309 	CLRB	SIGN			; Take care of negative numbers here
                       2D   67   91  06E8  1310 	CMPB	(R7),#^A/-/
                            0A   12  06EB  1311 	BNEQ	10$
           00000509'EF   FF 8F   90  06ED  1312 	MOVB	#-1,SIGN
                            57   D6  06F5  1313 	INCL	R7
              56   0000051C'EF   D0  06F7  1314 10$:	MOVL	BASE,R6			; Keep base in R6
                          00AE   30  06FE  1315 	BSBW	ISDIG			; Is this a number?
                            03   13  0701  1316 	BEQL	15$
                          0092   31  0703  1317 	BRW	BADWRD			;  No, complain
                                     0706  1318 
