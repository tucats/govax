                                     010B   181 	.SBTTL	ALLOCATE - allocate a number
                                     010B   182 ;
                                     010B   183 ; ALLOCATE(address) gets BYTES bytes from LIB$GET_VM, zeroes them, and
                                     010B   184 ; stores their address in the longword at address. It returns
                                     010B   185 ; LIB$GET_VM's status.
                                     010B   186 ;
                               007C  010B   187 	.ENTRY	ALLOCATE, ^M<R2,R3,R4,R5,R6>
                    56   04 AC   D0  010D   188 	MOVL	4(AP), R6
                            56   DD  0111   189 	PUSHL	R6			; base-address
                   00000008'EF   DF  0113   190 	PUSHAL	BYTES			; number-bytes
              00000000'GF   02   FB  0119   191 	CALLS	#2, G^LIB$GET_VM
                         0E 50   E9  0120   192 	BLBC	R0, 10$
    00000008'EF   00   66   00   2C  0123   193 	MOVC5	#0, (R6), #0, BYTES, @(R6)	; Zero it (BYTES < 64K)
                         00 B6       012C       
                       50   01   D0  012E   194 	MOVL	#SS$_NORMAL, R0
                                 04  0131   195 10$:	RET
                                     0132   196 
                                     0132   197 	.SBTTL	COMPUTE_PI - Machin's formula
                                     0132   198 ;
                                     0132   199 ; COMPUTE_PI sets SUM to pi: 16 * arctan(1/5) - 4 * arctan(1/239). SUM
                                     0132   200 ; starts at zero, and ARCTAN adds each series into it.
                                     0132   201 ;
                               0000  0132   202 	.ENTRY	COMPUTE_PI, ^M<>
                            01   DD  0134   203 	PUSHL	#1			; Subtract 4 * arctan(1/239)
                   000000EF 8F   DD  0136   204 	PUSHL	#239
                            04   DD  013C   205 	PUSHL	#4
                            00   DD  013E   206 	PUSHL	#0			; ... after adding 16 * arctan(1/5)
                            05   DD  0140   207 	PUSHL	#5
                            10   DD  0142   208 	PUSHL	#16
              00000153'EF   03   FB  0144   209 	CALLS	#3, ARCTAN
              00000153'EF   03   FB  014B   210 	CALLS	#3, ARCTAN
                                 04  0152   211 	RET
                                     0153   212 
                                     0153   213 	.SBTTL	ARCTAN - add a multiple of an arctangent to SUM
                                     0153   214 ;
                                     0153   215 ; ARCTAN(k, x, negative) adds k * arctan(1/x) to SUM, or subtracts it if
                                     0153   216 ; negative is 1. TERM holds k / x^n for n = 1, 3, 5, ..., and QUOT each
                                     0153   217 ; term, TERM / n, which is added to SUM or subtracted from it in turn.
                                     0153   218 ; The series ends when TERM becomes zero. START, the index of TERM's
                                     0153   219 ; first nonzero longword, only grows, so each step skips TERM's leading
                                     0153   220 ; zeros.
                                     0153   221 ;
PI                              Compute pi to any number of decimal plac  6-OCT-2026 13:39:16  VAX MACRO V5.4-3            Page   5
V1.0                            ARCTAN - add a multiple of an arctangent  6-OCT-2026 13:38:05  DUA1:[000000]PI.MAR;1             (1)

                                     0153   222 ; Registers:	R2 = n		R3 = x^2	R4 = START
                                     0153   223 ;		R5 = 1 to subtract the next term, 0 to add it
                                     0153   224 ;
                               003C  0153   225 	.ENTRY	ARCTAN, ^M<R2,R3,R4,R5>
    00000008'EF   00   6E   00   2C  0155   226 	MOVC5	#0, (SP), #0, BYTES, @TERM	; TERM = k
                   00000010'FF       015E       
           00000010'FF   04 AC   D0  0163   227 	MOVL	4(AP), @TERM
                            54   D4  016B   228 	CLRL	R4
                    55   0C AC   D0  016D   229 	MOVL	12(AP), R5
                                     0171   230 
                            54   DD  0171   231 	PUSHL	R4			; TERM = TERM / x
                         08 AC   DD  0173   232 	PUSHL	8(AP)
                   00000010'EF   DD  0176   233 	PUSHL	TERM
                   00000010'EF   DD  017C   234 	PUSHL	TERM
              000001FE'EF   04   FB  0182   235 	CALLS	#4, DIVIDE
            53   08 AC   08 AC   C5  0189   236 	MULL3	8(AP), 8(AP), R3
                       52   01   D0  018F   237 	MOVL	#1, R2
                                     0192   238 
                            54   DD  0192   239 10$:	PUSHL	R4			; QUOT = TERM / n
                            52   DD  0194   240 	PUSHL	R2
                   00000014'EF   DD  0196   241 	PUSHL	QUOT
                   00000010'EF   DD  019C   242 	PUSHL	TERM
              000001FE'EF   04   FB  01A2   243 	CALLS	#4, DIVIDE
                                     01A9   244 
                            54   DD  01A9   245 	PUSHL	R4			; SUM = SUM +/- QUOT
                   00000014'EF   DD  01AB   246 	PUSHL	QUOT
                   0000000C'EF   DD  01B1   247 	PUSHL	SUM
                         09 55   E8  01B7   248 	BLBS	R5, 20$
              0000022D'EF   03   FB  01BA   249 	CALLS	#3, ADD
                            07   11  01C1   250 	BRB	30$
              0000029A'EF   03   FB  01C3   251 20$:	CALLS	#3, SUBTRACT
                       55   01   CC  01CA   252 30$:	XORL2	#1, R5			; The signs alternate
                                     01CD   253 
                            54   DD  01CD   254 	PUSHL	R4			; TERM = TERM / x^2
                            53   DD  01CF   255 	PUSHL	R3
                   00000010'EF   DD  01D1   256 	PUSHL	TERM
                   00000010'EF   DD  01D7   257 	PUSHL	TERM
              000001FE'EF   04   FB  01DD   258 	CALLS	#4, DIVIDE
                                     01E4   259 
              50   00000010'EF   D0  01E4   260 	MOVL	TERM, R0		; Skip TERM's new leading zeros
                          6044   D5  01EB   261 40$:	TSTL	(R0)[R4]
                            09   12  01EE   262 	BNEQ	50$
           F3 54   00000004'EF   F2  01F0   263 	AOBLSS	WORDS, R4, 40$
                                 04  01F8   264 	RET				; TERM is zero: the series is done
                                     01F9   265 
                       52   02   C0  01F9   266 50$:	ADDL2	#2, R2			; n = n + 2
                            94   11  01FC   267 	BRB	10$
