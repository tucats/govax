                                     02FD   378 	.SBTTL	PRINT_PI - print the number
                                     02FD   379 ;
                                     02FD   380 ; PRINT_PI(number, places) prints number's integer part, a point, and
                                     02FD   381 ; places digits of its fraction, LINE_DIGITS to a line in groups of
                                     02FD   382 ; GROUP_DIGITS. Each fraction longword becomes nine digits by way of
                                     02FD   383 ; packed decimal: CVTLP, then CVTPS, which keeps the leading zeros.
                                     02FD   384 ; (Both change R0 to R3, so this routine keeps its state in R4 to R8.)
                                     02FD   385 ;
                                     02FD   386 ; Registers:	R7 = places left	R8 = number's address
                                     02FD   387 ;		R4 = longword index	R5 = digits left in the longword
                                     02FD   388 ;		R6 = the next digit's address
                                     02FD   389 ;
                               01F0  02FD   390 	.ENTRY	PRINT_PI, ^M<R4,R5,R6,R7,R8>
                    57   08 AC   D0  02FF   391 	MOVL	8(AP), R7
