                                     0079   121 	.SBTTL	GET_PLACES - read the count of places
                                     0079   122 ;
                                     0079   123 ; GET_PLACES(places) reads the command line with LIB$GET_FOREIGN. If it
                                     0079   124 ; has a number, that number, from 1 to MAX_PLACES, goes into the longword
                                     0079   125 ; at places; if it's empty, places is left alone. Anything else is
                                     0079   126 ; reported, and GET_PLACES returns SS$_BADPARAM, with STS$M_INHIB_MSG set
                                     0079   127 ; so that it isn't reported again.
                                     0079   128 ;
                               001C  0079   129 	.ENTRY	GET_PLACES, ^M<R2,R3,R4>
                   00000018'EF   3F  007B   130 	PUSHAW	CMD_LEN			; resultant-length
                            7E   D4  0081   131 	CLRL	-(SP)			; no prompt-string
                   0000006A'EF   7F  0083   132 	PUSHAQ	CMD_DESC		; resultant-string
              00000000'GF   03   FB  0089   133 	CALLS	#3, G^LIB$GET_FOREIGN
                         06 50   E8  0090   134 	BLBS	R0, 10$
                   00000018'EF   B4  0093   135 	CLRW	CMD_LEN			; Unreadable: take the default
                                     0099   136 
              52   00000018'EF   3C  0099   137 10$:	MOVZWL	CMD_LEN, R2		; R2 = characters left
              53   0000001A'EF   9E  00A0   138 	MOVAB	CMD_BUF, R3		; R3 = the next one
                            54   D4  00A7   139 	CLRL	R4			; R4 = the number so far
                                     00A9   140 
                            52   D5  00A9   141 20$:	TSTL	R2			; Skip leading blanks
                            45   13  00AB   142 	BEQL	80$			; All blank: keep the default
                       20   63   91  00AD   143 	CMPB	(R3), #^A/ /
                            06   12  00B0   144 	BNEQ	30$
                            53   D6  00B2   145 	INCL	R3
                            52   D7  00B4   146 	DECL	R2
                            F1   11  00B6   147 	BRB	20$
                                     00B8   148 
                            52   D5  00B8   149 30$:	TSTL	R2			; Read digits
                            2E   13  00BA   150 	BEQL	50$
                  50   63   30   83  00BC   151 	SUBB3	#^A/0/, (R3), R0	; R0 = the digit's value, or more
                       09   50   91  00C0   152 	CMPB	R0, #9			; than 9 (unsigned) if it isn't one
                            18   1A  00C3   153 	BGTRU	40$
                       50   50   9A  00C5   154 	MOVZBL	R0, R0
                       54   0A   C4  00C8   155 	MULL2	#10, R4			; Number = number * 10 + digit
                       54   50   C0  00CB   156 	ADDL2	R0, R4
              000186A0 8F   54   D1  00CE   157 	CMPL	R4, #MAX_PLACES
                            1F   14  00D5   158 	BGTR	90$
                            53   D6  00D7   159 	INCL	R3
                            52   D7  00D9   160 	DECL	R2
                            DB   11  00DB   161 	BRB	30$
                                     00DD   162 
                       20   63   91  00DD   163 40$:	CMPB	(R3), #^A/ /		; Only blanks may follow
                            14   12  00E0   164 	BNEQ	90$
                            53   D6  00E2   165 	INCL	R3
