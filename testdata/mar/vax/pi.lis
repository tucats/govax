                                     0000    88 	.SBTTL	PI - main routine
                                     0000    89 ;
                                     0000    90 ; PI reads the count of places, sizes and allocates the three numbers,
                                     0000    91 ; computes pi, and prints it.
                                     0000    92 ;
                               0004  0000    93 	.ENTRY	PI, ^M<R2>
                   00000000'EF   DF  0002    94 	PUSHAL	PLACES			; Get the count of places
              00000079'EF   01   FB  0008    95 	CALLS	#1, GET_PLACES
                         66 50   E9  000F    96 	BLBC	R0, 90$			; Bad count: already reported
                                     0012    97 
         50   00000000'EF   09   C7  0012    98 	DIVL3	#9, PLACES, R0		; Longwords for the fraction,
         00000004'EF   50   04   C1  001A    99 	ADDL3	#<1+1+GUARD>, R0, WORDS	; plus the rest, the integer
00000008'EF   00000004'EF   04   C5  0022   100 	MULL3	#4, WORDS, BYTES	; part, and the guard
                                     002E   101 
              52   0000000C'EF   DE  002E   102 	MOVAL	SUM, R2			; Allocate SUM, TERM, and QUOT,
                            52   DD  0035   103 	PUSHL	R2			; consecutive longwords
              0000010B'EF   01   FB  0037   104 	CALLS	#1, ALLOCATE
                         37 50   E9  003E   105 	BLBC	R0, 90$
                         04 A2   DF  0041   106 	PUSHAL	4(R2)
              0000010B'EF   01   FB  0044   107 	CALLS	#1, ALLOCATE
                         2A 50   E9  004B   108 	BLBC	R0, 90$
