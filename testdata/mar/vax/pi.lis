PI                              Compute pi to any number of decimal plac  6-OCT-2026 13:39:16  VAX MACRO V5.4-3            Page   1
V1.0                                                                      6-OCT-2026 13:38:05  DUA1:[000000]PI.MAR;1             (1)

                                     0000     1 	.TITLE	PI	Compute pi to any number of decimal places
                                     0000     2 	.IDENT	/V1.0/
                                     0000     3 
                                     0000     4 ;
                                     0000     5 ; PI prints pi to a number of decimal places on SYS$OUTPUT: 100 by
                                     0000     6 ; default, or the count given on the command line when it's run as a
                                     0000     7 ; foreign command (PI :== $PI, then PI 500), read with LIB$GET_FOREIGN.
                                     0000     8 ;
                                     0000     9 ; It uses Machin's formula,
                                     0000    10 ;
                                     0000    11 ;	pi = 16 * arctan(1/5) - 4 * arctan(1/239)
                                     0000    12 ;
                                     0000    13 ; summing each arctangent's Taylor series,
                                     0000    14 ;
                                     0000    15 ;	arctan(1/x) = 1/x - 1/(3*x^3) + 1/(5*x^5) - ...
                                     0000    16 ;
                                     0000    17 ; in multiple-precision fixed point. A number is an array of longwords,
                                     0000    18 ; most significant first: the first holds the integer part, and each of
                                     0000    19 ; the rest nine more decimal digits of the fraction (each is a "digit" in
                                     0000    20 ; base 1,000,000,000). Dividing one by a longword is a run of EMUL and
                                     0000    21 ; EDIV instructions, carrying each remainder into the next longword;
                                     0000    22 ; adding and subtracting carry from the least significant longword up.
                                     0000    23 ; Two extra longwords of fraction absorb the error of truncating every
                                     0000    24 ; division, and the digits printed are truncated, not rounded.
                                     0000    25 ;
                                     0000    26 ; Every routine is called with CALLS, so the program also exercises call
                                     0000    27 ; frames: tracebacks, SHOW CALLS, and breakpoints in nested routines
                                     0000    28 ; (PI -> COMPUTE_PI -> ARCTAN -> DIVIDE, and PI -> PRINT_PI -> PUT_DIGIT
                                     0000    29 ; -> FLUSH_LINE). Arrays are passed by reference and counts by value.
                                     0000    30 ;
                                     0000    31 
                                     0000    32 	$SSDEF				; SS$_NORMAL, SS$_BADPARAM
                                     0000    33 
                           3B9ACA00  0000    34 BASE = 1000000000		; Each longword holds 9 decimal digits
                           00000064  0000    35 DEFAULT_PLACES = 100		; Places when none is given
                           000186A0  0000    36 MAX_PLACES = 100000		; Most places allowed (keeps the arrays
                                     0000    37 				; under 64K bytes, a MOVC5 length)
                           00000002  0000    38 GUARD = 2			; Extra longwords against truncation error
                           00000032  0000    39 LINE_DIGITS = 50		; Digits printed on each line
                           0000000A  0000    40 GROUP_DIGITS = 10		; Digits between spaces on a line
                           10000000  0000    41 STS$M_INHIB_MSG = ^X10000000	; Status already reported
                                     0000    42 
                                     0000    43 ;
                                     0000    44 ; Descriptors are written out in full: DSC$K_DTYPE_T (14) is text, and
                                     0000    45 ; DSC$K_CLASS_S (1) a fixed-length string.
                                     0000    46 ;
                                     0000    47 	.MACRO	STRING_DESC	LEN,ADDR
                                     0000    48 	.WORD	LEN
                                     0000    49 	.BYTE	14,1
                                     0000    50 	.ADDRESS ADDR
                                     0000    51 	.ENDM	STRING_DESC
                                     0000    52 
                                 00000000    53 	.PSECT	PI_DATA, WRT, NOEXE, LONG
                                     0000    54 
                           00000064  0000    55 PLACES:	.LONG	DEFAULT_PLACES	; Decimal places to print
                           00000000  0004    56 WORDS:	.LONG	0		; Longwords in each number
                           00000000  0008    57 BYTES:	.LONG	0		; Bytes in each number
