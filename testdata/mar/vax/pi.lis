                                     022D   292 	.SBTTL	ADD - add two numbers
                                     022D   293 ;
                                     022D   294 ; ADD(sum, addend, start) adds addend to sum; addend's longwords before
                                     022D   295 ; start are taken to be zero. Each longword's carry goes into the next
                                     022D   296 ; more significant one.
                                     022D   297 ;
                                     022D   298 ; Registers:	R2 = sum	R3 = addend	R4 = carry
                                     022D   299 ;		R5 = index	R6 = start
                                     022D   300 ;
                               007C  022D   301 	.ENTRY	ADD, ^M<R2,R3,R4,R5,R6>
                    52   04 AC   7D  022F   302 	MOVQ	4(AP), R2
                    56   0C AC   D0  0233   303 	MOVL	12(AP), R6
                            54   D4  0237   304 	CLRL	R4
         55   00000004'EF   01   C3  0239   305 	SUBL3	#1, WORDS, R5
                       56   55   D1  0241   306 	CMPL	R5, R6
                            29   19  0244   307 	BLSS	30$
              50   6345   6245   C1  0246   308 10$:	ADDL3	(R2)[R5], (R3)[R5], R0	; Add the longwords and the carry
                       50   54   C0  024C   309 	ADDL2	R4, R0
                            54   D4  024F   310 	CLRL	R4
              3B9ACA00 8F   50   D1  0251   311 	CMPL	R0, #BASE
                            0A   19  0258   312 	BLSS	20$
              50   3B9ACA00 8F   C2  025A   313 	SUBL2	#BASE, R0		; Carry one
                       54   01   D0  0261   314 	MOVL	#1, R4
                     6245   50   D0  0264   315 20$:	MOVL	R0, (R2)[R5]
                            55   D7  0268   316 	DECL	R5
                       56   55   D1  026A   317 	CMPL	R5, R6
                            D7   18  026D   318 	BGEQ	10$
                                     026F   319 
                            54   D5  026F   320 30$:	TSTL	R4			; Carry on up from start
                            26   13  0271   321 	BEQL	50$
