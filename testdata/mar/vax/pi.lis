                                     01FE   269 	.SBTTL	DIVIDE - divide a number by a longword
                                     01FE   270 ;
                                     01FE   271 ; DIVIDE(source, destination, divisor, start) sets destination to source
                                     01FE   272 ; / divisor, longword by longword from start to the end; source's
                                     01FE   273 ; longwords before start must be zero, and destination's are left alone.
                                     01FE   274 ; Each step's dividend is the last remainder times BASE plus the next
                                     01FE   275 ; longword. Since the remainder is less than the divisor, the quotient
                                     01FE   276 ; is less than BASE: it fits a longword.
                                     01FE   277 ;
PI                              Compute pi to any number of decimal plac  6-OCT-2026 13:39:16  VAX MACRO V5.4-3            Page   6
V1.0                            DIVIDE - divide a number by a longword    6-OCT-2026 13:38:05  DUA1:[000000]PI.MAR;1             (1)

                                     01FE   278 ; Registers:	R2 = source	R3 = destination	R4 = remainder
                                     01FE   279 ;		R5 = index	R6/R7 = the quadword dividend
                                     01FE   280 ;
                               00FC  01FE   281 	.ENTRY	DIVIDE, ^M<R2,R3,R4,R5,R6,R7>
                    52   04 AC   7D  0200   282 	MOVQ	4(AP), R2
                            54   D4  0204   283 	CLRL	R4
                    55   10 AC   D0  0206   284 	MOVL	16(AP), R5
              00000004'EF   55   D1  020A   285 	CMPL	R5, WORDS
                            19   18  0211   286 	BGEQ	20$
  56   6245   3B9ACA00 8F   54   7A  0213   287 10$:	EMUL	R4, #BASE, (R2)[R5], R6
        54   6345   56   0C AC   7B  021D   288 	EDIV	12(AP), R6, (R3)[R5], R4
           E7 55   00000004'EF   F2  0224   289 	AOBLSS	WORDS, R5, 10$
                                 04  022C   290 20$:	RET
