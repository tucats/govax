              51   0000001F'EF   9E  0018    18 	MOVAB	HERE, R1
                    51   FD AF   9E  001F    19 HERE:	MOVAB	HERE, R1
                                     0023    20 	.DEFAULT DISPLACEMENT, WORD
                  51   0028'CF   9E  0023    21 	MOVAB	THERE, R1
                       50   01   D0  0028    22 THERE:	MOVL	#1, R0
