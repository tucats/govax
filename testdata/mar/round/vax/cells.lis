CELLS                           Phase 29 round: fixup cell order          4-OCT-2026 16:00:53  VAX MACRO V5.4-3            Page   1
V1.0                                                                      4-OCT-2026 15:58:52  DUA1:[000000]CELLS.MAR;1          (1)

                                     0000     1 	.TITLE	CELLS	Phase 29 round: fixup cell order
                                     0000     2 	.IDENT	/V1.0/
                                     0000     3 
                                     0000     4 ; In what order does LINK lay out the fixup section's cells, one for
                                     0000     5 ; each LIBRTL routine a general mode (G^) operand calls? FAILSIG gives
                                     0000     6 ; LIB$STOP (offset 4F8) a cell before LIB$SIGNAL (4F0), the reverse of
                                     0000     7 ; their first calls. This calls four routines in an order where each
                                     0000     8 ; possible rule gives a different order:
                                     0000     9 ;
                                     0000    10 ;	reverse of first calls:		LIB$GET_INPUT, LIB$ADDX, LIB$WAIT
                                     0000    11 ;	reverse of last calls:		LIB$ADDX, LIB$GET_INPUT, LIB$WAIT
                                     0000    12 ;	highest offset first:		LIB$ADDX (7D0), LIB$WAIT (558),
                                     0000    13 ;					LIB$GET_INPUT (410)
                                     0000    14 ;	name order, last first:		LIB$WAIT, LIB$GET_INPUT, LIB$ADDX
                                     0000    15 ;
                                     0000    16 ; It's only linked, never run: the calls have no arguments to speak of.
                                     0000    17 
                                 00000000    18 	.PSECT	CODE, NOWRT, EXE, LONG
                               0000  0000    19 	.ENTRY	CELLS, ^M<>
              00000000'GF   00   FB  0002    20 	CALLS	#0, G^LIB$WAIT
              00000000'GF   00   FB  0009    21 	CALLS	#0, G^LIB$ADDX
              00000000'GF   00   FB  0010    22 	CALLS	#0, G^LIB$GET_INPUT
              00000000'GF   00   FB  0017    23 	CALLS	#0, G^LIB$ADDX
                                 04  001E    24 	RET
                                     001F    25 
                                     001F    26 	.END	CELLS
