$ ! RMSERR.COM - the Phase 32 oracle's error probes. Their messages go to
$ ! ERRORS.LOG, which the author audits for macro text before Claude reads it.
$ ! Written by testdata/mar/rms/gen.go. Run it with the exchange volume as
$ ! the default directory:
$ !
$ !     @RMSERR/OUTPUT=ERRORS.LOG
$ !
$ ! Each program is assembled with /NOLIST, so no listing of a macro
$ ! expansion is made, and its object is analyzed.
$ !
$ SET NOON
$ SET VERIFY
$ MACRO/NOLIST ERR_DEF_GLOBAL
$ ANALYZE/OBJECT/OUTPUT=ERR_DEF_GLOBAL.ANL ERR_DEF_GLOBAL.OBJ
$ MACRO/NOLIST ERR_FAC
$ ANALYZE/OBJECT/OUTPUT=ERR_FAC.ANL ERR_FAC.OBJ
$ MACRO/NOLIST ERR_KEYWORD
$ ANALYZE/OBJECT/OUTPUT=ERR_KEYWORD.ANL ERR_KEYWORD.OBJ
$ MACRO/NOLIST ERR_NOP
$ ANALYZE/OBJECT/OUTPUT=ERR_NOP.ANL ERR_NOP.OBJ
$ MACRO/NOLIST ERR_ORG
$ ANALYZE/OBJECT/OUTPUT=ERR_ORG.ANL ERR_ORG.OBJ
$ MACRO/NOLIST ERR_ROP2
$ ANALYZE/OBJECT/OUTPUT=ERR_ROP2.ANL ERR_ROP2.OBJ
$ MACRO/NOLIST ERR_SHR_NQL
$ ANALYZE/OBJECT/OUTPUT=ERR_SHR_NQL.ANL ERR_SHR_NQL.OBJ
$ MACRO/NOLIST ERR_SS_GLOBAL
$ ANALYZE/OBJECT/OUTPUT=ERR_SS_GLOBAL.ANL ERR_SS_GLOBAL.OBJ
$ MACRO/NOLIST ERR_STORE_REG
$ ANALYZE/OBJECT/OUTPUT=ERR_STORE_REG.ANL ERR_STORE_REG.OBJ
$ MACRO/NOLIST ERR_XABDAT_EDT
$ ANALYZE/OBJECT/OUTPUT=ERR_XABDAT_EDT.ANL ERR_XABDAT_EDT.OBJ
$ DIRECTORY/SIZE=ALL *.OBJ
