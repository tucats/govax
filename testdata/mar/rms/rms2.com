$ ! RMS2.COM - the Phase 32 oracle's the second round's probes.
$ ! Written by testdata/mar/rms/gen.go. Run it with the exchange volume as
$ ! the default directory:
$ !
$ !     @RMS2/OUTPUT=RMS2.LOG
$ !
$ ! Each program is assembled with /NOLIST, so no listing of a macro
$ ! expansion is made, and its object is analyzed.
$ !
$ SET NOON
$ SET VERIFY
$ MACRO/NOLIST R2_ORDER_FAB
$ ANALYZE/OBJECT/OUTPUT=R2_ORDER_FAB.ANL R2_ORDER_FAB.OBJ
$ MACRO/NOLIST R2_ORDER_NAM
$ ANALYZE/OBJECT/OUTPUT=R2_ORDER_NAM.ANL R2_ORDER_NAM.OBJ
$ MACRO/NOLIST R2_ORDER_RAB
$ ANALYZE/OBJECT/OUTPUT=R2_ORDER_RAB.ANL R2_ORDER_RAB.OBJ
$ MACRO/NOLIST R2_ORDER_XABALL
$ ANALYZE/OBJECT/OUTPUT=R2_ORDER_XABALL.ANL R2_ORDER_XABALL.OBJ
$ MACRO/NOLIST R2_ORDER_XABDAT
$ ANALYZE/OBJECT/OUTPUT=R2_ORDER_XABDAT.ANL R2_ORDER_XABDAT.OBJ
$ MACRO/NOLIST R2_ORDER_XABKEY
$ ANALYZE/OBJECT/OUTPUT=R2_ORDER_XABKEY.ANL R2_ORDER_XABKEY.OBJ
$ MACRO/NOLIST R2_ORDER_XABPRO
$ ANALYZE/OBJECT/OUTPUT=R2_ORDER_XABPRO.ANL R2_ORDER_XABPRO.OBJ
$ MACRO/NOLIST R2_ORDER_XABRDT
$ ANALYZE/OBJECT/OUTPUT=R2_ORDER_XABRDT.ANL R2_ORDER_XABRDT.OBJ
$ MACRO/NOLIST R2_ORDER_XABTRM
$ ANALYZE/OBJECT/OUTPUT=R2_ORDER_XABTRM.ANL R2_ORDER_XABTRM.OBJ
$ DIRECTORY/SIZE=ALL *.OBJ
