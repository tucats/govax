		UBF=UBUF, -
		USZ=#200, -
		XAB=XAB1
	$RAB_STORE	RAB=RBUF, -
		XAB=XAB1, -
		USZ=#200, -
		UBF=UBUF, -
		TMO=#10, -
		RSZ=#80, -
