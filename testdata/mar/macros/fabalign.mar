	.TITLE	FABALIGN	Phase 28 fixture: a misaligned $FAB
	.IDENT	/V1.0/

; $FAB checks that its block is longword aligned, a test of a
; relocatable location. Real MACRO assembles this and prints its
; informational message only for the second block, which the .BYTE
; before it misaligns.

	.PSECT	DATA, WRT, NOEXE, LONG
GOOD:	$FAB	FNM=<A.DAT>
	.BYTE	1
BAD:	$FAB	FNM=<B.DAT>

	.END
