$ ! MACROS.COM - the govax Phase 28 fixtures (docs/PHASE-28.md, subtask 10).
$ !
$ ! 1. Programs using macros: MACRO/LIST and ANALYZE/OBJECT each. QIOW,
$ !    RMSCOPY, and USELIB are complete programs, so they are also linked
$ !    (with maps) and run. RMSCOPY copies RMSCOPY.MAR to RMSCOPY.OUT.
$ ! 2. Libraries made by LIBRARIAN: LIBMAC.MLB from LIBMAC.MAR, and
$ !    LIBOBJ.OLB from LIBSUB1 and LIBSUB2, each listed in full. USELIB is
$ !    assembled with LIBMAC.MLB, and LIBMAIN linked with LIBOBJ.OLB.
$ ! 3. govax's, when present:
$ !    - GV_NAME.OBJ, govax's object for NAME.MAR: ANALYZE/OBJECT, and the
$ !      programs linked and run;
$ !    - GV_LIBMAC.MLB and GV_LIBOBJ.OLB, govax's libraries: listed in full,
$ !      used by MACRO and LINK, extracted from, and (a copy of each)
$ !      changed by LIBRARIAN.
$ !
$ ! Run it with the volume holding the fixtures as the default directory,
$ ! keeping a log of everything it prints:
$ !
$ !     @MACROS/OUTPUT=MACROS.LOG
$ !
$ SET NOON
$ SET VERIFY
$ !
$ ! 1. Programs using macros.
$ !
$ LIST = "USERMAC,QIOW,RMSCOPY,FABALIGN"
$ I = 0
$ NEXT:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO PROGRAMS
$   MACRO/LIST 'F'
$   ANALYZE/OBJECT/OUTPUT='F'.ANL 'F'.OBJ
$   I = I + 1
$   GOTO NEXT
$ PROGRAMS:
$ LINK/MAP QIOW
$ RUN QIOW
$ SHOW SYMBOL $STATUS
$ LINK/MAP RMSCOPY
$ RUN RMSCOPY
$ SHOW SYMBOL $STATUS
$ DIFFERENCES RMSCOPY.MAR RMSCOPY.OUT
$ !
$ ! 2. Libraries made by LIBRARIAN.
$ !
$ LIBRARY/CREATE/MACRO LIBMAC LIBMAC.MAR
$ LIBRARY/LIST=LIBMAC.LLS/FULL LIBMAC.MLB
$ LIBRARY/EXTRACT=*/OUTPUT=LIBMAC.EXT LIBMAC.MLB
$ MACRO/LIST USELIB+LIBMAC/LIBRARY
$ ANALYZE/OBJECT/OUTPUT=USELIB.ANL USELIB.OBJ
$ LINK/MAP USELIB
$ RUN USELIB
$ SHOW SYMBOL $STATUS
$ MACRO/LIST LIBSUB1
$ MACRO/LIST LIBSUB2
$ MACRO/LIST LIBMAIN
$ ANALYZE/OBJECT/OUTPUT=LIBSUB1.ANL LIBSUB1.OBJ
$ ANALYZE/OBJECT/OUTPUT=LIBSUB2.ANL LIBSUB2.OBJ
$ ANALYZE/OBJECT/OUTPUT=LIBMAIN.ANL LIBMAIN.OBJ
$ LIBRARY/CREATE LIBOBJ LIBSUB1,LIBSUB2
$ LIBRARY/LIST=LIBOBJ.LLS/FULL/NAMES LIBOBJ.OLB
$ LINK/MAP LIBMAIN,LIBOBJ/LIBRARY
$ RUN LIBMAIN
$ SHOW SYMBOL $STATUS
$ !
$ ! 3. govax's objects and libraries.
$ !
$ LIST = "USERMAC,QIOW,RMSCOPY,FABALIGN,USELIB,LIBSUB1,LIBSUB2,LIBMAIN"
$ I = 0
$ GVNEXT:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO GVPROGRAMS
$   IF F$SEARCH("GV_''F'.OBJ") .NES. "" THEN -
        ANALYZE/OBJECT/OUTPUT=GV_'F'.ANL GV_'F'.OBJ
$   I = I + 1
$   GOTO GVNEXT
$ GVPROGRAMS:
$ IF F$SEARCH("GV_QIOW.OBJ") .EQS. "" THEN GOTO GVRMSCOPY
$ LINK/MAP GV_QIOW
$ RUN GV_QIOW
$ SHOW SYMBOL $STATUS
$ GVRMSCOPY:
$ IF F$SEARCH("GV_RMSCOPY.OBJ") .EQS. "" THEN GOTO GVUSELIB
$ LINK/MAP GV_RMSCOPY
$ RUN GV_RMSCOPY
$ SHOW SYMBOL $STATUS
$ DIFFERENCES RMSCOPY.MAR RMSCOPY.OUT
$ GVUSELIB:
$ IF F$SEARCH("GV_USELIB.OBJ") .EQS. "" THEN GOTO GVLIBMAC
$ LINK/MAP GV_USELIB
$ RUN GV_USELIB
$ SHOW SYMBOL $STATUS
$ GVLIBMAC:
$ IF F$SEARCH("GV_LIBMAC.MLB") .EQS. "" THEN GOTO GVLIBOBJ
$ LIBRARY/LIST=GV_LIBMAC.LLS/FULL GV_LIBMAC.MLB
$ LIBRARY/EXTRACT=*/OUTPUT=GV_LIBMAC.EXT GV_LIBMAC.MLB
$ MACRO/LIST=GV_USELIBM.LIS/OBJECT=GV_USELIBM.OBJ USELIB+GV_LIBMAC/LIBRARY
$ ANALYZE/OBJECT/OUTPUT=GV_USELIBM.ANL GV_USELIBM.OBJ
$ LINK/MAP GV_USELIBM
$ RUN GV_USELIBM
$ SHOW SYMBOL $STATUS
$ COPY GV_LIBMAC.MLB GV_LIBMAC2.MLB
$ LIBRARY/REPLACE/MACRO/LOG GV_LIBMAC2 EXTRA.MAR
$ LIBRARY/DELETE=CHECK/LOG GV_LIBMAC2.MLB
$ LIBRARY/LIST=GV_LIBMAC2.LLS/FULL GV_LIBMAC2.MLB
$ LIBRARY/EXTRACT=*/OUTPUT=GV_LIBMAC2.EXT GV_LIBMAC2.MLB
$ GVLIBOBJ:
$ IF F$SEARCH("GV_LIBOBJ.OLB") .EQS. "" THEN GOTO DONE
$ LIBRARY/LIST=GV_LIBOBJ.LLS/FULL/NAMES GV_LIBOBJ.OLB
$ LINK/MAP=GV_LIBMAINL.MAP/EXECUTABLE=GV_LIBMAINL.EXE LIBMAIN,GV_LIBOBJ/LIBRARY
$ RUN GV_LIBMAINL
$ SHOW SYMBOL $STATUS
$ IF F$SEARCH("GV_LIBMAIN.OBJ") .EQS. "" THEN GOTO GVOLB2
$ LINK/MAP GV_LIBMAIN,GV_LIBOBJ/LIBRARY
$ RUN GV_LIBMAIN
$ SHOW SYMBOL $STATUS
$ GVOLB2:
$ COPY GV_LIBOBJ.OLB GV_LIBOBJ2.OLB
$ LIBRARY/REPLACE/LOG GV_LIBOBJ2 LIBSUB2
$ LIBRARY/DELETE=LIBSUB1/LOG GV_LIBOBJ2.OLB
$ LIBRARY/LIST=GV_LIBOBJ2.LLS/FULL/NAMES GV_LIBOBJ2.OLB
$ DONE:
$ DIRECTORY/FULL/OUTPUT=FILES.LST *.OBJ,*.MLB,*.OLB
$ SET NOVERIFY
$ EXIT
