                                     0031    58 	.MACRO	WHICH
                                     0031    59 	.BYTE	1
                                     0031    60 	.ENDM	WHICH
                                     0031    61 	.MACRO	WHICH
                                     0031    62 	.BYTE	2
                                     0031    63 	.ENDM	WHICH
                                     0031    64 REDEF:	WHICH				; the second definition
                           00000001  0032    65 	.MDELETE WHICH
                                     0032    66 
                                     0032    67 ; \symbol passes a symbol's value.
                                     0032    68 
                           0000002A  0032    69 VALUE = 42
                                     0032    70 	.MACRO	ASCVAL	N
                                     0032    71 	.ASCII	/N/
                                     0032    72 	.ENDM	ASCVAL
                                     0032    73 
                                     0032    74 VALS:	ASCVAL	\VALUE			; "42"
                                     0034    75 	ASCVAL	VALUE			; "VALUE"
                                     0039    76 
                                     0039    77 ; .NARG and .NCHR, and a macro that stops early with .MEXIT.
                                     0039    78 
                                     0039    79 	.MACRO	COUNT	P1, P2, P3, P4
                                     0039    80 	.NARG	...N
                                     0039    81 	.NCHR	...C, <P1>
                                     0039    82 	.BYTE	...N, ...C
                                     0039    83 	.IIF	BLANK <P4>, .MEXIT
                                     0039    84 	.BYTE	^XFF
                                     0039    85 	.ENDM	COUNT
                                     0039    86 
                                     0039    87 COUNTS:	COUNT
                                     003B    88 	COUNT	X
                                     003D    89 	COUNT	ABCDE, 2, 3
                                     003F    90 	COUNT	, , , LAST
                                     0042    91 
                                     0042    92 ; Conditionals on arguments.
                                     0042    93 
                                     0042    94 	.MACRO	TEST	A, B
                                     0042    95 	.IF	BLANK <A>
                                     0042    96 	.BYTE	0
                                     0042    97 	.IFF
                                     0042    98 	.IF	IDENTICAL <A>, <B>
                                     0042    99 	.BYTE	1
                                     0042   100 	.IFF
                                     0042   101 	.BYTE	2
                                     0042   102 	.ENDC
                                     0042   103 	.ENDC
                                     0042   104 	.ENDM	TEST
                                     0042   105 
                                     0042   106 CONDS:	TEST
                                     0043   107 	TEST	FOO, FOO
                                     0044   108 	TEST	FOO, BAR
                                     0045   109 
                                     0045   110 ; The string operators.
                                     0045   111 
                                     0045   112 	.MACRO	STRINGS	S
                                     0045   113 	.BYTE	%LENGTH(S)
                                     0045   114 	.BYTE	%LOCATE(<C>, S)
