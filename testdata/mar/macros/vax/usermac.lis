                                     0000     1 	.TITLE	USERMAC	Phase 28 fixture: user-defined macros
                                     0000     2 	.IDENT	/V1.0/
                                     0000     3 
                                     0000     4 ; Every feature of MACRO's macro facility that a program can use without
                                     0000     5 ; a library: arguments of each form, created local labels, repeat blocks,
                                     0000     6 ; string operators, .NARG, .NCHR, and .NTYPE. Each result lands in the
                                     0000     7 ; object as data or code, so comparing objects compares expansions.
                                     0000     8 
                                 00000000     9 	.PSECT	DATA, WRT, NOEXE, LONG
                                     0000    10 
                                     0000    11 ; Positional and keyword arguments, and defaults.
                                     0000    12 
                                     0000    13 	.MACRO	TRIPLE	A, B=2, C=3
                                     0000    14 	.BYTE	A, B, C
                                     0000    15 	.ENDM	TRIPLE
                                     0000    16 
                                     0000    17 POSN:	TRIPLE	1			; 1, 2, 3
                                     0003    18 	TRIPLE	4, 5, 6			; 4, 5, 6
                                     0006    19 	TRIPLE	7, , 9			; a null argument takes its default
                                     0009    20 	TRIPLE	C=12, A=10		; keywords, in any order
                                     000C    21 	TRIPLE	13, C=15		; mixed
                                     000F    22 
                                     000F    23 ; Delimited arguments: <...> (nesting), and ^x...x.
                                     000F    24 
                                     000F    25 	.MACRO	BYTES	LIST
                                     000F    26 	.BYTE	LIST
                                     000F    27 	.ENDM	BYTES
                                     000F    28 
                                     000F    29 DELIM:	BYTES	<1, 2, 3>
                                     0012    30 	BYTES	<<4>+1>			; the outer brackets only
                                     0013    31 	BYTES	^%6, 7%
                                     0015    32 
                                     0015    33 ; Concatenation with the apostrophe.
                                     0015    34 
                                     0015    35 	.MACRO	LABELS	PREFIX, N
                                     0015    36 PREFIX'_'N:	.LONG	N
                                     0015    37 	.ENDM	LABELS
                                     0015    38 
                                     0015    39 	LABELS	TBL, 1
                                     0019    40 	LABELS	TBL, 2
                  00000019'00000015' 001D    41 	.LONG	TBL_1, TBL_2
                                     0025    42 
                                     0025    43 ; A macro that defines a macro, with the apostrophe the inner one keeps.
                                     0025    44 
                                     0025    45 	.MACRO	MAKER	NAME, PREFIX
                                     0025    46 	.MACRO	NAME	SYM
                                     0025    47 PREFIX''SYM:	.WORD	^XAA
                                     0025    48 	.ENDM	NAME
                                     0025    49 	.ENDM	MAKER
                                     0025    50 
                                     0025    51 	MAKER	MADE, MK_
                                     0025    52 	MADE	ONE
                                     0027    53 	MADE	TWO
                  00000027'00000025' 0029    54 	.LONG	MK_ONE, MK_TWO
                                     0031    55 
                                     0031    56 ; Redefinition and .MDELETE.
                                     0031    57 
