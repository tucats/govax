                                     0082   174 ; Code: created local labels, so each expansion has its own.
                                     0082   175 
                                     0082   176 	.MACRO	MAX	A, B, DEST, ?SKIP
                                     0082   177 	MOVL	A, DEST
                                     0082   178 	CMPL	B, DEST
                                     0082   179 	BLEQ	SKIP
                                     0082   180 	MOVL	B, DEST
                                     0082   181 SKIP:
                                     0082   182 	.ENDM	MAX
                                     0082   183 
                                 00000004   184 	.PSECT	CODE
                               0004  0004   185 	.ENTRY	USERMAC, ^M<R2>
                                     0006   186 	MAX	#1, #2, R0
                                     0011   187 	MAX	R0, #5, R2
                                     001C   188 	MAX	#9, R2, R0, SKIP=10$	; a created label given explicitly
                                 04  0027   189 	RET
                           0000002C  0028   190 FWD:	.BLKB	4
                                     002C   191 
                                     002C   192 	.PRINT	; USERMAC: informational message from .PRINT

                                     002C   193 
                                     002C   194 	.END	USERMAC
