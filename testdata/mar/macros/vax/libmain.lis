                                     0000     1 	.TITLE	LIBMAIN	Phase 28 fixture: a program linked with an object library
                                     0000     2 	.IDENT	/V1.0/
                                     0000     3 
                                     0000     4 ; Calls TWICE and SQUARE, which LINK finds in the object library:
                                     0000     5 ;	LINK LIBMAIN,LIBOBJ/LIBRARY
                                     0000     6 ; It exits with success when TWICE(21) is 42 and SQUARE(7) is 49, and
                                     0000     7 ; SQUARE counted one call; with 0 otherwise.
                                     0000     8 
                                 00000000     9 	.PSECT	CODE, NOWRT, EXE, LONG
                               0000  0000    10 	.ENTRY	LIBMAIN, ^M<>
                            7E   D4  0002    11 	CLRL	-(SP)
                            15   DD  0004    12 	PUSHL	#21
              00000000'GF   01   FB  0006    13 	CALLS	#1, G^TWICE
                       2A   50   D1  000D    14 	CMPL	R0, #42
                            1A   12  0010    15 	BNEQ	10$
                            07   DD  0012    16 	PUSHL	#7
              00000000'GF   01   FB  0014    17 	CALLS	#1, G^SQUARE
                       31   50   D1  001B    18 	CMPL	R0, #49
                            0C   12  001E    19 	BNEQ	10$
              01   00000000'GF   D1  0020    20 	CMPL	G^SQUARE_COUNT, #1
                            03   12  0027    21 	BNEQ	10$
                       6E   01   D0  0029    22 	MOVL	#1, (SP)
                       50   8E   D0  002C    23 10$:	MOVL	(SP)+, R0
                                 04  002F    24 	RET
                                     0030    25 
                                     0030    26 	.END	LIBMAIN
