	.MACRO	ADDUP	A, B, -
		C=#0, DEST=R0
	ADDL3	A, B, DEST
	ADDL2	C, DEST		;
	.ENDM	ADDUP
	.MACRO	BITS	PREFIX, NAMES
	.IIF	BLANK <NAMES>, .WARN ; BITS: no names for PREFIX;
...BIT = 1
	.IRP	NAME, <NAMES>
PREFIX'_'NAME = ...BIT
...BIT = ...BIT * 2
	.ENDR
	.ENDM	BITS
	.MACRO	CHECK	?OK
	BLBS	R0, OK
	RET
OK:
	.ENDM	CHECK
	.MACRO	DEFINER	NAME
	.MACRO	NAME	VALUE
	.WORD	VALUE
	.ENDM	NAME
	.ENDM	DEFINER
	.MACRO	PUTMSG	TEXT, ?STR, ?SKIP	; the .MACRO line keeps its comment
	BRB	SKIP
STR:	.ASCID	/TEXT/
SKIP:	PUSHAQ	STR
	CALLS	#1, G^LIB$PUT_OUTPUT
	.ENDM	PUTMSG
