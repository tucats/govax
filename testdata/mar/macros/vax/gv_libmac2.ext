	.MACRO	ADDUP	A, B, DEST=R0
	ADDL3	A, B, DEST
	.ENDM	ADDUP
	.MACRO	BITS	PREFIX, NAMES
	.IIF	BLANK <NAMES>, .WARN ; BITS: no names for PREFIX;
...BIT = 1
	.IRP	NAME, <NAMES>
PREFIX'_'NAME = ...BIT
...BIT = ...BIT * 2
	.ENDR
	.ENDM	BITS
	.MACRO	DEFINER	NAME
	.MACRO	NAME	VALUE
	.WORD	VALUE
	.ENDM	NAME
	.ENDM	DEFINER
	.MACRO	NEGATE	SRC, DEST=R0
	MNEGL	SRC, DEST
	.ENDM	NEGATE
	.MACRO	PUTMSG	TEXT, ?STR, ?SKIP	; the .MACRO line keeps its comment
	BRB	SKIP
STR:	.ASCID	/TEXT/
SKIP:	PUSHAQ	STR
	CALLS	#1, G^LIB$PUT_OUTPUT
	.ENDM	PUTMSG
