
$ !
$ ! 1. Programs using macros.
$ !
$ LIST = "USERMAC,QIOW,RMSCOPY,FABALIGN"
$ I = 0
$ NEXT:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO PROGRAMS
$   MACRO/LIST USERMAC
 USERMAC: informational message from .PRINT
$   ANALYZE/OBJECT/OUTPUT=USERMAC.ANL USERMAC.OBJ
%ANALYZE-I-ERRORS, DUA1:[000000]USERMAC.OBJ;1                              0 errors
$   I = I + 1
$   GOTO NEXT
$ NEXT:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO PROGRAMS
$   MACRO/LIST QIOW
$   ANALYZE/OBJECT/OUTPUT=QIOW.ANL QIOW.OBJ
%ANALYZE-I-ERRORS, DUA1:[000000]QIOW.OBJ;1                                 0 errors
$   I = I + 1
$   GOTO NEXT
$ NEXT:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO PROGRAMS
$   MACRO/LIST RMSCOPY
$   ANALYZE/OBJECT/OUTPUT=RMSCOPY.ANL RMSCOPY.OBJ
%ANALYZE-I-ERRORS, DUA1:[000000]RMSCOPY.OBJ;1                              0 errors
$   I = I + 1
$   GOTO NEXT
$ NEXT:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO PROGRAMS
$   MACRO/LIST FABALIGN
%MACRO-I-GENINFO, Generated INFO: RMS BLOCK NOT LONGWORD ALIGNED;
$   ANALYZE/OBJECT/OUTPUT=FABALIGN.ANL FABALIGN.OBJ
%ANALYZE-I-ERRORS, DUA1:[000000]FABALIGN.OBJ;1                             0 errors
$   I = I + 1
$   GOTO NEXT
$ NEXT:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO PROGRAMS
$ PROGRAMS:
$ LINK/MAP QIOW
$ RUN QIOW
%SYSTEM-F-FILNOTACC, file not accessed on channel
$ SHOW SYMBOL $STATUS
  $STATUS == "%X000000AC"
$ LINK/MAP RMSCOPY
$ RUN RMSCOPY
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00010001"
$ DIFFERENCES RMSCOPY.MAR RMSCOPY.OUT
Number of difference sections found: 0
Number of difference records found: 0

DIFFERENCES /IGNORE=()/MERGED=1-
    DUA1:[000000]RMSCOPY.MAR;1-
    DUA1:[000000]RMSCOPY.OUT;1
$ !
$ ! 2. Libraries made by LIBRARIAN.
$ !
$ LIBRARY/CREATE/MACRO LIBMAC LIBMAC.MAR
$ LIBRARY/LIST=LIBMAC.LLS/FULL LIBMAC.MLB
$ LIBRARY/EXTRACT=*/OUTPUT=LIBMAC.EXT LIBMAC.MLB
$ MACRO/LIST USELIB+LIBMAC/LIBRARY
$ ANALYZE/OBJECT/OUTPUT=USELIB.ANL USELIB.OBJ
%ANALYZE-I-ERRORS, DUA1:[000000]USELIB.OBJ;1                               0 errors
$ LINK/MAP USELIB
$ RUN USELIB
Hello from a macro library
ADDUP gave 9
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00000001"
$ MACRO/LIST LIBSUB1
$ MACRO/LIST LIBSUB2
$ MACRO/LIST LIBMAIN
$ ANALYZE/OBJECT/OUTPUT=LIBSUB1.ANL LIBSUB1.OBJ
%ANALYZE-I-ERRORS, DUA1:[000000]LIBSUB1.OBJ;1                              0 errors
$ ANALYZE/OBJECT/OUTPUT=LIBSUB2.ANL LIBSUB2.OBJ
%ANALYZE-I-ERRORS, DUA1:[000000]LIBSUB2.OBJ;1                              0 errors
$ ANALYZE/OBJECT/OUTPUT=LIBMAIN.ANL LIBMAIN.OBJ
%ANALYZE-I-ERRORS, DUA1:[000000]LIBMAIN.OBJ;1                              0 errors
$ LIBRARY/CREATE LIBOBJ LIBSUB1,LIBSUB2
$ LIBRARY/LIST=LIBOBJ.LLS/FULL/NAMES LIBOBJ.OLB
$ LINK/MAP LIBMAIN,LIBOBJ/LIBRARY
$ RUN LIBMAIN
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00000001"
