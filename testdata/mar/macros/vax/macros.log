  $STATUS == "%X00000001"
$ COPY GV_LIBMAC.MLB GV_LIBMAC2.MLB
$ LIBRARY/REPLACE/MACRO/LOG GV_LIBMAC2 EXTRA.MAR
%LIBRAR-S-REPLACED, module ADDUP replaced in DUA1:[000000]GV_LIBMAC2.MLB;1
%LIBRAR-S-INSERTED, module NEGATE inserted in DUA1:[000000]GV_LIBMAC2.MLB;1
$ LIBRARY/DELETE=CHECK/LOG GV_LIBMAC2.MLB
%LIBRAR-S-DELETED, module CHECK deleted from DUA1:[000000]GV_LIBMAC2.MLB;1
$ LIBRARY/LIST=GV_LIBMAC2.LLS/FULL GV_LIBMAC2.MLB
$ LIBRARY/EXTRACT=*/OUTPUT=GV_LIBMAC2.EXT GV_LIBMAC2.MLB
$ GVLIBOBJ:
$ IF F$SEARCH("GV_LIBOBJ.OLB") .EQS. "" THEN GOTO DONE
$ LIBRARY/LIST=GV_LIBOBJ.LLS/FULL/NAMES GV_LIBOBJ.OLB
$ LINK/MAP=GV_LIBMAINL.MAP/EXECUTABLE=GV_LIBMAINL.EXE LIBMAIN,GV_LIBOBJ/LIBRARY
$ RUN GV_LIBMAINL
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00000001"
$ IF F$SEARCH("GV_LIBMAIN.OBJ") .EQS. "" THEN GOTO GVOLB2
$ LINK/MAP GV_LIBMAIN,GV_LIBOBJ/LIBRARY
$ RUN GV_LIBMAIN
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00000001"
