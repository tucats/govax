                                     0000     1 	.TITLE	USELIB	Phase 28 fixture: a program using a macro library
                                     0000     2 	.IDENT	/V1.0/
                                     0000     3 
                                     0000     4 ; Calls LIBMAC's macros, found in the library given on the command line:
                                     0000     5 ;	MACRO USELIB+LIBMAC/LIBRARY		(VMS)
                                     0000     6 ;	MACRO USELIB/LIBRARY=LIBMAC		(govax)
                                     0000     7 ; It prints two lines and exits with success.
                                     0000     8 
                                     0000     9 	BITS	OPT, <READ, WRITE, EXEC>
                                     0000    10 
                                 00000000    11 	.PSECT	DATA, WRT, NOEXE, LONG
                           00000005  0000    12 FLAGS:	.LONG	OPT_READ ! OPT_EXEC
                                     0004    13 	DEFINER	WORDS
                                     0004    14 	WORDS	1
                                     0006    15 	WORDS	OPT_WRITE
                                     0008    16 
                                 00000000    17 	.PSECT	CODE, NOWRT, EXE, LONG
                               0004  0000    18 	.ENTRY	USELIB, ^M<R2>
                                     0002    19 	PUTMSG	<Hello from a macro library>
                                     0030    20 	ADDUP	#2, #3, C=#4, DEST=R2	; R2 = 9
                       09   52   D1  0037    21 	CMPL	R2, #9
                            28   12  003A    22 	BNEQ	10$
                                     003C    23 	PUTMSG	<ADDUP gave 9>
                       50   01   D0  005C    24 	MOVL	#1, R0
                                     005F    25 	CHECK
                                 04  0063    26 	RET
                            50   D4  0064    27 10$:	CLRL	R0
                                 04  0066    28 	RET
                                     0067    29 
                                     0067    30 	.END	USELIB
