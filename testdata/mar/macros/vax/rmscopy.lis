RMSCOPY                         Phase 28 fixture: copy a file with RMS   30-SEP-2026 16:09:09  VAX MACRO V5.4-3            Page   1
V1.0                                                                     30-SEP-2026 16:08:00  DUA1:[000000]RMSCOPY.MAR;1        (1)

                                     0000     1 	.TITLE	RMSCOPY	Phase 28 fixture: copy a file with RMS
                                     0000     2 	.IDENT	/V1.0/
                                     0000     3 
                                     0000     4 ; A complete program built on the RMS control block macros: $FAB and $RAB
                                     0000     5 ; initialize the blocks at assembly time, and $OPEN, $CREATE, $CONNECT,
                                     0000     6 ; $GET, $PUT, and $CLOSE call RMS. It copies RMSCOPY.MAR, its own source,
                                     0000     7 ; to RMSCOPY.OUT, a record at a time, and exits with the status of the
                                     0000     8 ; first failure, or success at end of file.
                                     0000     9 
                                     0000    10 	$RMSDEF				; RMS$_EOF
                                     0000    11 
                                 00000000    12 	.PSECT	DATA, WRT, NOEXE, LONG
                                     0000    13 INFAB:	$FAB	FNM=<RMSCOPY.MAR>, FAC=GET
                                     0050    14 INRAB:	$RAB	FAB=INFAB, UBF=BUFFER, USZ=BUFSIZ
                                     0094    15 OUTFAB:	$FAB	FNM=<RMSCOPY.OUT>, FAC=PUT, -
                                     0094    16 		RAT=CR, RFM=VAR, ORG=SEQ
                                     00E4    17 OUTRAB:	$RAB	FAB=OUTFAB, RBF=BUFFER
                           00000328  0128    18 BUFFER:	.BLKB	512
                           00000200  0328    19 BUFSIZ = .-BUFFER
                                     0328    20 
                                 00000000    21 	.PSECT	CODE, NOWRT, EXE, LONG
                               0000  0000    22 	.ENTRY	RMSCOPY, ^M<>
                                     0002    23 	$OPEN	FAB=INFAB
                         30 50   E9  000F    24 	BLBC	R0, 90$
                                     0012    25 	$CONNECT RAB=INRAB
                         20 50   E9  001F    26 	BLBC	R0, 90$
                                     0022    27 	$CREATE	FAB=OUTFAB
                         10 50   E9  002F    28 	BLBC	R0, 90$
                                     0032    29 	$CONNECT RAB=OUTRAB
                         01 50   E8  003F    30 	BLBS	R0, 10$
                                 04  0042    31 90$:	RET
                                     0043    32 
                                     0043    33 10$:	$GET	RAB=INRAB
                         1C 50   E9  0050    34 	BLBC	R0, 20$
     00000106'EF   00000072'EF   B0  0053    35 	MOVW	INRAB+RAB$W_RSZ, OUTRAB+RAB$W_RSZ
                                     005E    36 	$PUT	RAB=OUTRAB
                         D5 50   E8  006B    37 	BLBS	R0, 10$
                                 04  006E    38 	RET
                                     006F    39 
              0001827A 8F   50   D1  006F    40 20$:	CMPL	R0, #RMS$_EOF		; the end of the input is success
                            1D   12  0076    41 	BNEQ	99$
                                     0078    42 	$CLOSE	FAB=OUTFAB
                         0D 50   E9  0085    43 	BLBC	R0, 99$
                                     0088    44 	$CLOSE	FAB=INFAB
                                 04  0095    45 99$:	RET
                                     0096    46 
                                     0096    47 	.END	RMSCOPY
