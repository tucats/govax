                                     0000     4 ; Code in two executable psects, switching between them, code before
                                     0000     5 ; any .ENTRY, code in a NOEXE psect, and a routine that doesn't end in
                                     0000     6 ; RET. DST.COM assembles it /DEBUG/LIST.
                                     0000     7 
                                 00000000     8 	.PSECT	FIRST, NOWRT, EXE, LONG
                            50   D6  0000     9 SUBA:	INCL	R0		; code before any .ENTRY
                                 05  0002    10 	RSB
                                     0003    11 
                                 00000000    12 	.PSECT	SECOND, NOWRT, EXE, LONG
                               0000  0000    13 	.ENTRY	DSTLN2, ^M<>
                   00000000'EF   16  0002    14 	JSB	SUBA
                   00000003'EF   16  0008    15 	JSB	SUBB
                            00   11  000E    16 	BRB	NEXT
                                     0010    17 
                                 00000003    18 	.PSECT	FIRST
                            50   D7  0003    19 SUBB:	DECL	R0		; back in the first psect
                                 05  0005    20 	RSB
                                     0006    21 
                                 00000010    22 	.PSECT	SECOND
                   00000000'EF   16  0010    23 NEXT:	JSB	SUBC
                                 04  0016    24 	RET
                                     0017    25 
                                 00000000    26 	.PSECT	DATA, WRT, NOEXE, LONG
                            51   D4  0000    27 SUBC:	CLRL	R1		; code in a NOEXE psect
                                 05  0002    28 	RSB
                                     0003    29 
                                 00000017    30 	.PSECT	SECOND
                               0000  0017    31 	.ENTRY	LOOPS, ^M<>	; a routine that doesn't end in RET
                            50   D6  0019    32 20$:	INCL	R0
                            FC   11  001B    33 	BRB	20$
                                     001D    34 
                                     001D    35 	.END	DSTLN2
