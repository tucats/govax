	.TITLE	DSTDBG	Phase 29 probe 2: .ENABLE DEBUG partway
	.IDENT	/V1.0/

; Assembled without /DEBUG, so debugger records start off: which
; symbols and lines does .ENABLE DEBUG partway bring in? DST.COM
; assembles it /LIST.

BEFORE = 1
	.PSECT	DATA, WRT, NOEXE, LONG
DBEFORE: .LONG	1

	.PSECT	CODE, NOWRT, EXE, LONG
	.ENTRY	DSTDBG, ^M<>
	CLRL	R0
	INCL	R0

	.ENABLE	DEBUG

AFTER = 2
	.PSECT	DATA
DAFTER:	.LONG	2

	.PSECT	CODE
	INCL	R0
	RET

	.END	DSTDBG
