;    1        PROGRAM MATMUL
	.ENTRY	MATMUL,^M<R2>
;    2  C     Matrix multiplication, the classic triple loop.
;    3        INTEGER N
;    4        PARAMETER (N = 60)
;    5        REAL A(N,N), B(N,N), C(N,N), S
;    6        INTEGER I, J, K
;    7        DO 20 J = 1, N
	MOVL	#60,MATMUL.$C1		; DO 20's count
	MOVL	#1,MATMUL.J
MATMUL.$1:				; DO 20's body
;    8           DO 10 I = 1, N
	MOVL	#60,MATMUL.$C2		; DO 10's count
	MOVL	#1,MATMUL.I
MATMUL.$2:				; DO 10's body
;    9              A(I,J) = I + J
	ADDL3	MATMUL.I,MATMUL.J,R0
	MULL3	MATMUL.J,#60,R1
	ADDL2	MATMUL.I,R1
	CVTLF	R0,MATMUL.A-244[R1]
;   10              B(I,J) = 2*I - J
	MULL3	#2,MATMUL.I,R0
	SUBL2	MATMUL.J,R0
	MULL3	MATMUL.J,#60,R1
	ADDL2	MATMUL.I,R1
	CVTLF	R0,MATMUL.B-244[R1]
;   11              C(I,J) = 0.0
	MULL3	MATMUL.J,#60,R0
	ADDL2	MATMUL.I,R0
	CLRF	MATMUL.C-244[R0]
;   12     10    CONTINUE
MATMUL.L10:
