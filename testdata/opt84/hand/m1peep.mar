	DECL	MATMUL.$C2		; one pass fewer
	BLEQ	MATMUL.$3
	BRW	MATMUL.$2
MATMUL.$3:
;   13     20 CONTINUE
MATMUL.L20:
	INCL	MATMUL.J
	DECL	MATMUL.$C1		; one pass fewer
	BLEQ	MATMUL.$4
	BRW	MATMUL.$1
MATMUL.$4:
;   14        DO 50 J = 1, N
	MOVL	#60,MATMUL.$C3		; DO 50's count
	MOVL	#1,MATMUL.J
MATMUL.$5:				; DO 50's body
;   15           DO 40 K = 1, N
	MOVL	#60,MATMUL.$C4		; DO 40's count
	MOVL	#1,MATMUL.K
MATMUL.$6:				; DO 40's body
;   16              DO 30 I = 1, N
	MOVL	#60,MATMUL.$C5		; DO 30's count
	MOVL	#1,MATMUL.I
MATMUL.$7:				; DO 30's body
;   17                 C(I,J) = C(I,J) + A(I,K)*B(K,J)
	MULL3	MATMUL.K,#60,R0
	ADDL2	MATMUL.I,R0
	MULL3	MATMUL.J,#60,R1
	ADDL2	MATMUL.K,R1
	MULF3	MATMUL.A-244[R0],MATMUL.B-244[R1],R0
	MULL3	MATMUL.J,#60,R1
	ADDL2	MATMUL.I,R1
	MULL3	MATMUL.J,#60,R2
	ADDL2	MATMUL.I,R2
	ADDF3	MATMUL.C-244[R1],R0,MATMUL.C-244[R2]
;   18     30       CONTINUE
MATMUL.L30:
	INCL	MATMUL.I
	SOBGTR	MATMUL.$C5,MATMUL.$7
MATMUL.L40:
	INCL	MATMUL.K
	DECL	MATMUL.$C4
	BLEQ	MATMUL.$9
	BRW	MATMUL.$6
MATMUL.$9:
MATMUL.L50:
	INCL	MATMUL.J
	DECL	MATMUL.$C3
	BLEQ	MATMUL.$AA
	BRW	MATMUL.$5
MATMUL.$AA:
MATMUL.$10:
;   21        S = 0.0
	CLRF	MATMUL.S
;   22        DO 60 I = 1, N
	MOVL	#60,MATMUL.$C6		; DO 60's count
	MOVL	#1,MATMUL.I
MATMUL.$11:				; DO 60's body
;   23           S = S + C(I,I)
	MULL3	MATMUL.I,#60,R0
	ADDL2	MATMUL.I,R0
	ADDF2	MATMUL.C-244[R0],MATMUL.S
;   24     60 CONTINUE
MATMUL.L60:
	INCL	MATMUL.I
	DECL	MATMUL.$C6		; one pass fewer
	BLEQ	MATMUL.$12
