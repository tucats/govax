	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;   18        REAL FUNCTION FLT(I)
	.ENTRY	FLT,^M<>
;   19        INTEGER I
;   20        FLT = I*0.5 + 1.0
