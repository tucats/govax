	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;   22        SUBROUTINE BUBBLE(A, N)
	.ENTRY	BUBBLE,^M<R6,R7,R8>
	MOVAL	@BUBBLE.A(AP),BUBBLE.$B1+4
	MOVL	@BUBBLE.N(AP),BUBBLE.$B1+28
