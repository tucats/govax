	MOVAL	@BUBBLE.A(AP)[R0],BUBBLE.$B1+16
	MULL3	#4,BUBBLE.$B1+20,BUBBLE.$B1+12
;   23        INTEGER N, I, J
;   24        REAL A(N), T
;   25        DO 20 I = 1, N-1
	SUBL3	#1,@BUBBLE.N(AP),BUBBLE.$C1 ; DO 20's count
	MOVL	#1,BUBBLE.I
	TSTL	BUBBLE.$C1
	BGTR	BUBBLE.$2
	BRW	BUBBLE.$1
BUBBLE.$2:
