	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;   35        REAL FUNCTION DOT(A, B, N)
	.ENTRY	DOT,^M<R6,R7,R8,R9,R10>
