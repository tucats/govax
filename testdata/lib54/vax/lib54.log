%SHOW-S-NOTRAN, no translation for logical name SYS$LP_LINES
$ DEFINE/USER_MODE SYS$OUTPUT LIB54.MLG
$ MACRO/NOLIST LIB54
$ LINK/NOMAP LIB54
$ DEFINE/USER_MODE SYS$OUTPUT LIB54.OUT
$ RUN LIB54
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00000001"
$ DIRECTORY/SIZE/DATE

