COUNT2:	.LONG	2
COUNT0:	.LONG	0
TABLE:	.BLKB	256		; a copy of a translation table, to show
KEYTAB:	$LIB_KEY_TABLE	<<ADD,1>,<DELETE,2>,<EXIT,3>,<DEL,4>,<EXTRA,5>>
KEYTAB2:	$LIB_KEY_TABLE	<<AB,1>,<C,2>>
ODDTAB:	.LONG	3,0,0,0

