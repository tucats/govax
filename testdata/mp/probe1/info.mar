	.title	info
;
; Phase 45 probe 1's second child (README.md): it reports what a
; subprocess created with no input, output, or error finds, by writing
; the translations of SYS$INPUT, SYS$OUTPUT, SYS$ERROR, and SYS$COMMAND
; to the mailbox PROBE_MBX, one message each, then returns.
;
	$IODEF
	$LNMDEF

	.macro	check	?ok
	blbs	r0,ok
	brw	done
ok:
	.endm

	.psect	data,noexe,wrt
mbx_name:	.ascid	/PROBE_MBX/
table:		.ascid	/LNM$FILE_DEV/
ctl:		.ascid	/!AS = "!AD"/

names:		.address	n_input,n_output,n_error,n_command
n_input:	.ascid	/SYS$INPUT/
n_output:	.ascid	/SYS$OUTPUT/
n_error:	.ascid	/SYS$ERROR/
n_command:	.ascid	/SYS$COMMAND/

chan:		.word	0,0
equiv:		.blkb	255
equiv_len:	.long	0
items:		.word	255,LNM$_STRING
		.long	equiv,equiv_len
		.long	0

out_buf:	.blkb	300
out_len:	.word	0,0
out_desc:	.word	300
		.byte	14,1
		.long	out_buf
iosb:		.quad	0

write_now = <IO$_WRITEVBLK!IO$M_NOW>	; write a mailbox without waiting

	.psect	code,exe,nowrt
	.entry	start,^m<r6,r7>

	$assign_s	devnam=mbx_name, chan=chan
	check

	movab	names,r6
	movl	#4,r7
loop:	clrl	equiv_len
	$trnlnm_s	tabnam=table, lognam=@0(r6), itmlst=items
	blbs	r0,found
	clrl	equiv_len		; none: report an empty translation
found:	$fao_s	ctrstr=ctl, outlen=out_len, outbuf=out_desc, -
		p1=(r6), p2=equiv_len, p3=#equiv	; !AS, !AD
	check
	movw	out_len,out_desc
	$qiow_s	chan=chan, func=#write_now, iosb=iosb, -
		p1=out_buf, p2=out_len
	movw	#300,out_desc
	addl2	#4,r6
	sobgtr	r7,again
	brb	finish
again:	brw	loop
finish:
	movl	#1,r0
done:	ret

	.end	start
