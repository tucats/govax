$ ! MACROS6.COM - round 6 of the system service macro probes
$ ! (testdata/mp/macros/README.md). Written by gen.go. MACROS.COM runs it.
$ !
$ ! Each program is assembled with /NOLIST, so no listing of a macro
$ ! expansion is made, and its object is analyzed.
$ !
$ SET NOON
$ SET VERIFY
$ MACRO/NOLIST R6_CRMPSC
$ ANALYZE/OBJECT/OUTPUT=R6_CRMPSC.ANL R6_CRMPSC.OBJ
$ MACRO/NOLIST R6_MGBLSC
$ ANALYZE/OBJECT/OUTPUT=R6_MGBLSC.ANL R6_MGBLSC.OBJ
$ MACRO/NOLIST R6_DGBLSC
$ ANALYZE/OBJECT/OUTPUT=R6_DGBLSC.ANL R6_DGBLSC.OBJ
$ MACRO/NOLIST R6_ENQ
$ ANALYZE/OBJECT/OUTPUT=R6_ENQ.ANL R6_ENQ.OBJ
$ MACRO/NOLIST R6_ENQW
$ ANALYZE/OBJECT/OUTPUT=R6_ENQW.ANL R6_ENQW.OBJ
$ MACRO/NOLIST R6_DEQ
$ ANALYZE/OBJECT/OUTPUT=R6_DEQ.ANL R6_DEQ.OBJ
$ MACRO/NOLIST R6_GETLKI
$ ANALYZE/OBJECT/OUTPUT=R6_GETLKI.ANL R6_GETLKI.OBJ
$ MACRO/NOLIST R6_GETLKIW
$ ANALYZE/OBJECT/OUTPUT=R6_GETLKIW.ANL R6_GETLKIW.OBJ
$ SET NOVERIFY
$ EXIT
