$ ! MACROS.COM - Phase 45's system service macro probes
$ ! (testdata/mp/macros/README.md). Written by gen.go. Run it with the
$ ! exchange volume as the default directory:
$ !
$ !     @MACROS/OUTPUT=MACROS.LOG
$ !
$ ! Each program is assembled with /NOLIST, so no listing of a macro
$ ! expansion is made, and its object is analyzed.
$ !
$ SET NOON
$ SET VERIFY
$ MACRO/NOLIST SVC_CREPRC
$ ANALYZE/OBJECT/OUTPUT=SVC_CREPRC.ANL SVC_CREPRC.OBJ
$ MACRO/NOLIST SVC_DELPRC
$ ANALYZE/OBJECT/OUTPUT=SVC_DELPRC.ANL SVC_DELPRC.OBJ
$ MACRO/NOLIST SVC_WAKE
$ ANALYZE/OBJECT/OUTPUT=SVC_WAKE.ANL SVC_WAKE.OBJ
$ MACRO/NOLIST SVC_HIBER
$ ANALYZE/OBJECT/OUTPUT=SVC_HIBER.ANL SVC_HIBER.OBJ
$ MACRO/NOLIST SVC_SCHDWK
$ ANALYZE/OBJECT/OUTPUT=SVC_SCHDWK.ANL SVC_SCHDWK.OBJ
$ MACRO/NOLIST SVC_CANWAK
$ ANALYZE/OBJECT/OUTPUT=SVC_CANWAK.ANL SVC_CANWAK.OBJ
$ MACRO/NOLIST SVC_FORCEX
$ ANALYZE/OBJECT/OUTPUT=SVC_FORCEX.ANL SVC_FORCEX.OBJ
$ MACRO/NOLIST SVC_SUSPND
$ ANALYZE/OBJECT/OUTPUT=SVC_SUSPND.ANL SVC_SUSPND.OBJ
$ MACRO/NOLIST SVC_RESUME
$ ANALYZE/OBJECT/OUTPUT=SVC_RESUME.ANL SVC_RESUME.OBJ
$ MACRO/NOLIST SVC_SETPRI
$ ANALYZE/OBJECT/OUTPUT=SVC_SETPRI.ANL SVC_SETPRI.OBJ
$ MACRO/NOLIST SVC_SETPRN
$ ANALYZE/OBJECT/OUTPUT=SVC_SETPRN.ANL SVC_SETPRN.OBJ
$ MACRO/NOLIST SVC_GETJPI
$ ANALYZE/OBJECT/OUTPUT=SVC_GETJPI.ANL SVC_GETJPI.OBJ
$ MACRO/NOLIST SVC_GETJPIW
$ ANALYZE/OBJECT/OUTPUT=SVC_GETJPIW.ANL SVC_GETJPIW.OBJ
$ MACRO/NOLIST SVC_GETDVI
$ ANALYZE/OBJECT/OUTPUT=SVC_GETDVI.ANL SVC_GETDVI.OBJ
$ MACRO/NOLIST SVC_GETDVIW
$ ANALYZE/OBJECT/OUTPUT=SVC_GETDVIW.ANL SVC_GETDVIW.OBJ
$ MACRO/NOLIST SVC_CREMBX
$ ANALYZE/OBJECT/OUTPUT=SVC_CREMBX.ANL SVC_CREMBX.OBJ
$ MACRO/NOLIST SVC_DELMBX
$ ANALYZE/OBJECT/OUTPUT=SVC_DELMBX.ANL SVC_DELMBX.OBJ
$ MACRO/NOLIST SVC_SETIMR
$ ANALYZE/OBJECT/OUTPUT=SVC_SETIMR.ANL SVC_SETIMR.OBJ
$ MACRO/NOLIST SVC_CANTIM
$ ANALYZE/OBJECT/OUTPUT=SVC_CANTIM.ANL SVC_CANTIM.OBJ
$ MACRO/NOLIST SVC_WAITFR
$ ANALYZE/OBJECT/OUTPUT=SVC_WAITFR.ANL SVC_WAITFR.OBJ
$ MACRO/NOLIST SVC_SETEF
$ ANALYZE/OBJECT/OUTPUT=SVC_SETEF.ANL SVC_SETEF.OBJ
$ MACRO/NOLIST SVC_CLREF
$ ANALYZE/OBJECT/OUTPUT=SVC_CLREF.ANL SVC_CLREF.OBJ
$ MACRO/NOLIST SVC_READEF
$ ANALYZE/OBJECT/OUTPUT=SVC_READEF.ANL SVC_READEF.OBJ
$ SET NOVERIFY
$ EXIT
