$ ! MACROS9.COM - round 9 of the system service macro probes
$ ! (testdata/mp/macros/README.md). Written by gen.go. MACROS.COM runs it.
$ !
$ ! Each program is assembled with /NOLIST, so no listing of a macro
$ ! expansion is made, and its object is analyzed.
$ !
$ SET NOON
$ SET VERIFY
$ MACRO/NOLIST R9_CHANGE_ACL
$ ANALYZE/OBJECT/OUTPUT=R9_CHANGE_ACL.ANL R9_CHANGE_ACL.OBJ
$ MACRO/NOLIST R9_PARSE_ACL
$ ANALYZE/OBJECT/OUTPUT=R9_PARSE_ACL.ANL R9_PARSE_ACL.OBJ
$ MACRO/NOLIST R9_FORMAT_ACL
$ ANALYZE/OBJECT/OUTPUT=R9_FORMAT_ACL.ANL R9_FORMAT_ACL.OBJ
$ MACRO/NOLIST R9_CHKPRO
$ ANALYZE/OBJECT/OUTPUT=R9_CHKPRO.ANL R9_CHKPRO.OBJ
$ MACRO/NOLIST R9_CHECK_ACCESS
$ ANALYZE/OBJECT/OUTPUT=R9_CHECK_ACCESS.ANL R9_CHECK_ACCESS.OBJ
$ MACRO/NOLIST R9_GET_SECURITY
$ ANALYZE/OBJECT/OUTPUT=R9_GET_SECURITY.ANL R9_GET_SECURITY.OBJ
$ MACRO/NOLIST R9_SET_SECURITY
$ ANALYZE/OBJECT/OUTPUT=R9_SET_SECURITY.ANL R9_SET_SECURITY.OBJ
$ MACRO/NOLIST R9_SETDFPROT
$ ANALYZE/OBJECT/OUTPUT=R9_SETDFPROT.ANL R9_SETDFPROT.OBJ
$ SET NOVERIFY
$ EXIT
