	.title	mschild
;
; The multiprocessing milestone's child (MSPARENT.MAR has the whole
; story; docs/PHASE-48 - LIB_SPAWN.md, subtask 5). It assigns channels to
; its parent's two mailboxes by their logical names, opens SHARED.DAT for
; shared writing, and makes CHILD.DAT. Then, for each "MSG n" it reads,
; it appends "CHILD n" to both files and answers "ACK n", until "DONE",
; when it closes the files and ends with the status 3.
;
	$IODEF
	$RABDEF

; CHECK: end the program with the service's failure status in R0.
	.macro	check	?ok
	blbs	r0,ok
	brw	fail
ok:
	.endm

; IOCHECK: the same, for the status in the I/O status block.
	.macro	iocheck	?ok
	movzwl	iosb,r0
	blbs	r0,ok
	brw	fail
ok:
	.endm

	.psect	data,noexe,wrt,long
to_child_name:	.ascid	/MS_TO_CHILD/
to_parent_name:	.ascid	/MS_TO_PARENT/

run_msg:	.ascid	/Child: running/
done_msg:	.ascid	/Child: done/
child_text:	.ascii	/CHILD /

msg_buf:	.blkb	64
msg_len:	.long	0
rec_buf:	.blkb	80

in_chan:	.word	0,0
out_chan:	.word	0,0
iosb:		.quad	0

; SHARED.DAT, which the parent made, opened to append to while the parent
; does; and CHILD.DAT, the child's own.
	.align	long
shared_fab:	$FAB	FNM=<SHARED.DAT>, FAC=<PUT>, SHR=<GET,PUT>
shared_rab:	$RAB	FAB=shared_fab, ROP=EOF, RBF=rec_buf
own_fab:	$FAB	FNM=<CHILD.DAT>, FAC=<PUT>, ORG=SEQ, RFM=VAR, RAT=CR
own_rab:	$RAB	FAB=own_fab, RBF=rec_buf

	.psect	code,exe,nowrt
	.entry	start,^m<r2,r3,r4,r5,r6,r7>
	pushaq	run_msg
	calls	#1,g^lib$put_output

	$assign_s	devnam=to_child_name, chan=in_chan
	check
	$assign_s	devnam=to_parent_name, chan=out_chan
	check
	$open	fab=shared_fab
	check
	$connect	rab=shared_rab
	check
	$create	fab=own_fab
	check
	$connect	rab=own_rab
	check

; Read a message: DONE ends the loop.
read:	$qiow_s	chan=in_chan, func=#IO$_READVBLK, iosb=iosb, -
		p1=msg_buf, p2=#64
	check
	iocheck
	movzwl	iosb+2,msg_len
	cmpb	msg_buf,#^A/D/
	bneq	10$
	brw	done

; "MSG n" becomes the record "CHILD n", in both files.
10$:	movc3	#6,child_text,rec_buf
	subl3	#4,msg_len,r6
	movc3	r6,msg_buf+4,rec_buf+6
	addl3	#6,r6,r7
	movw	r7,shared_rab+RAB$W_RSZ
	movw	r7,own_rab+RAB$W_RSZ
	$put	rab=shared_rab
	check
	$put	rab=own_rab
	check

; ... and the reply "ACK n".
	movb	#^A/A/,msg_buf
	movb	#^A/C/,msg_buf+1
	movb	#^A/K/,msg_buf+2
	$qiow_s	chan=out_chan, func=#IO$_WRITEVBLK, iosb=iosb, -
		p1=msg_buf, p2=msg_len
	check
	iocheck
	brw	read

done:	$close	fab=shared_fab
	check
	$close	fab=own_fab
	check
	pushaq	done_msg
	calls	#1,g^lib$put_output
	movl	#3,r0
fail:	ret

	.end	start
