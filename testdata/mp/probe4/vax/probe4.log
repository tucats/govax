
1 RUN P4CHILD: spawn 00000001, completion 00000003
2 EXIT 7: spawn 00000001, completion 00000007
3 FROBNICATE: spawn 00000001, completion 00038090
4 RUN NOSUCH: spawn 00000001, completion 100388B2
5 SHOW LOGICAL/PROCESS P4_*: spawn 00000001, completion 10000001
6 SHOW SYMBOL P4SYM: spawn 00000001, completion 00000001
7 SHOW SYMBOL P4SYM, CLI$M_NOCLISYM: spawn 00000001, completion 00038140
8 flags ^X200: spawn 00158234
9 NOWAIT: spawn 00000001, the event flag just after: 00000001
9 NOWAIT: default name "SYSTEM_1"
9 NOWAIT: completion 00000003, the event flag at the end: 00000009
10 $CREPRC of LOGINOUT: create 00000001, final status 00038090
11 LIB$SPAWN with no CLI: create 00000001, final status 0015837C
end
 
DUA1:[000000]P4_1.LOG;1
 
 
