	.TITLE	LIB53	Phase 53 LIBRTL instruction routines probe
	.IDENT	/V1.0/

; Written by testdata/lib53/gen.go: do not edit. Calls each of Phase
; 53's LIBRTL routines, case by case, each in a routine of its own under
; HANDLER, and prints with LIB$PUT_OUTPUT what it returned in R0, any
; condition it signaled, and what it stored. See gen.go.

	$SSDEF

	.PSECT	DATA,NOEXE,WRT,QUAD
SIGCOND:	.LONG	0		; the condition HANDLER was given
SIGARG1:	.LONG	0		; an access violation's reason mask
SIGARG2:	.LONG	0		; and virtual address
LINLEN:	.WORD	0
	.ALIGN	LONG
LINDSC:	.WORD	132
	.BYTE	14,1
	.ADDRESS	LINE
PARTDSC:	.WORD	9
	.BYTE	14,1
	.LONG	0
OUTDSC:	.WORD	0
	.BYTE	14,1
	.ADDRESS	LINE
LINE:	.BLKB	132
R0CTL:	.ASCID	"!AC R0=!XL"
SIGCTL:	.ASCID	"!AC R0=!XL signal !XL !XL !XL"
MEMCTL:	.ASCID	"  !AC:"
LWCTL:	.ASCID	" !XL"
TXTCTL:	.ASCID	/  !AC: !UL "!AF"/

; Shared data.
	.ALIGN	QUAD
QHDR:	.QUAD	0
QE1:	.QUAD	0
QE2:	.QUAD	0
QE3:	.QUAD	0
QBUSY:	.LONG	1,0		; a header with its secondary interlock set
QREM:	.LONG	0
QRETRY1:	.LONG	1
QRETRY3:	.LONG	3
BITS:	.LONG	0,0,0,0
POS42:	.LONG	42
POS104:	.LONG	104
POSM1:	.LONG	-1
UPCASE:
	.REPT	97
	.BYTE	.-UPCASE
	.ENDR
	.REPT	26
	.BYTE	.-UPCASE-32
	.ENDR
	.REPT	133
	.BYTE	.-UPCASE
	.ENDR
UPDESC:	.WORD	256
	.BYTE	14,1
	.ADDRESS	UPCASE
CLASSTAB:	.BYTE	0[48]
	.BYTE	1[10]
	.BYTE	0[7]
	.BYTE	2[26]
	.BYTE	0[165]
MASK1:	.BYTE	1
MASK2:	.BYTE	2
MASK3:	.BYTE	3
	.ALIGN	LONG
CRCPOLY:	.LONG	^O120001	; CRC-16 (the manual's example)
CRCTAB:	.BLKL	16
CRC0:	.LONG	0
CRC1234:	.LONG	^X1234
STAR:	.ASCID	"*"
DOT:	.ASCID	"."
ARGS:	.LONG	2,3,4		; LIB$CALLG's argument list

