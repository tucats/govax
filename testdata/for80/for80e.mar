	.TITLE	FOR80E - FOR's conditions with no handler
; Written by testdata/for80/gen.go. The part is the foreign command's text.
	.PSECT	D,NOEXE,WRT,LONG
PART:	.BLKB	8
PD:	.WORD	8
	.BYTE	14,1
	.ADDRESS PART
FI2:	.ASCIZ	~(1X,I2)~
FI3:	.ASCIZ	~(I3)~
FI5:	.ASCIZ	~(1X,I5)~
FBAD:	.ASCIZ	~(1X,J3)~
FLOOP:	.ASCIZ	~(1X,'A')~
V1:	.F_FLOATING 3.25
V2:	.LONG	0
TABC:	.ASCID	~ABC~
TB:	.BLKB	2
T2:	.WORD	2
	.BYTE	14,1
	.ADDRESS TB
AFTER:	.ASCID	~FOR80E: the statement returned~
	.PSECT	C,EXE,NOWRT
; OUTCONERR, then the statement goes on
	.ENTRY	PART_A,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	PUSHAB	FI2
	PUSHL	#6
	CALLS	#2,G^FOR$WRITE_SO
	PUSHL	#3244
	CALLS	#1,G^FOR$IO_L_V
	CALLS	#0,G^FOR$IO_END
	RET
; FORVARMIS
	.ENTRY	PART_B,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	PUSHAB	FI5
	PUSHL	#6
	CALLS	#2,G^FOR$WRITE_SO
	PUSHAL	V1
	CALLS	#1,G^FOR$IO_F_R
	CALLS	#0,G^FOR$IO_END
	RET
; SYNERRFOR
	.ENTRY	PART_C,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	PUSHAB	FBAD
	PUSHL	#6
	CALLS	#2,G^FOR$WRITE_SO
	PUSHL	#1
	CALLS	#1,G^FOR$IO_L_V
	CALLS	#0,G^FOR$IO_END
	RET
; INFFORLOO
	.ENTRY	PART_D,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	PUSHAB	FLOOP
	PUSHL	#6
	CALLS	#2,G^FOR$WRITE_SO
	PUSHL	#1
	CALLS	#1,G^FOR$IO_L_V
	CALLS	#0,G^FOR$IO_END
	RET
; INPCONERR, from an internal record
	.ENTRY	PART_E,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	PUSHAB	FI3
	PUSHAB	TABC
	CALLS	#2,G^FOR$READ_IO
	PUSHAL	V2
	CALLS	#1,G^FOR$IO_L_R
	CALLS	#0,G^FOR$IO_END
	RET
; INPCONERR, from SYS$INPUT
	.ENTRY	PART_F,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	PUSHAB	FI3
	PUSHL	#5
	CALLS	#2,G^FOR$READ_SO
	PUSHAL	V2
	CALLS	#1,G^FOR$IO_L_R
	CALLS	#0,G^FOR$IO_END
	RET
; ENDDURREA, at SYS$INPUT's end
	.ENTRY	PART_G,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	PUSHAB	FI3
	PUSHL	#5
	CALLS	#2,G^FOR$READ_SO
	PUSHAL	V2
	CALLS	#1,G^FOR$IO_L_R
	CALLS	#0,G^FOR$IO_END
	RET
; OUTSTAOVE, an internal record
	.ENTRY	PART_H,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	PUSHAB	FI5
	PUSHAB	T2
	CALLS	#2,G^FOR$WRITE_IO
	PUSHL	#1
	CALLS	#1,G^FOR$IO_L_V
	CALLS	#0,G^FOR$IO_END
	RET
; INVLOGUNI
	.ENTRY	PART_I,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	PUSHAB	FI5
	PUSHL	#1000
	CALLS	#2,G^FOR$WRITE_SO
	PUSHL	#1
	CALLS	#1,G^FOR$IO_L_V
	CALLS	#0,G^FOR$IO_END
	RET
; RECIO_OPE
	.ENTRY	PART_J,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	PUSHAB	FI5
	PUSHL	#6
	CALLS	#2,G^FOR$WRITE_SO
	PUSHAB	FI5
	PUSHL	#6
	CALLS	#2,G^FOR$WRITE_SO
	CALLS	#0,G^FOR$IO_END
	RET

	.ENTRY	FOR80E,^M<>
	PUSHAB	PD
	CALLS	#1,G^LIB$GET_FOREIGN
	CMPB	PART,#^A/A/
	BNEQ	10$
	CALLS	#0,PART_A
10$:
	CMPB	PART,#^A/B/
	BNEQ	11$
	CALLS	#0,PART_B
11$:
	CMPB	PART,#^A/C/
	BNEQ	12$
	CALLS	#0,PART_C
12$:
	CMPB	PART,#^A/D/
	BNEQ	13$
	CALLS	#0,PART_D
13$:
	CMPB	PART,#^A/E/
	BNEQ	14$
	CALLS	#0,PART_E
14$:
	CMPB	PART,#^A/F/
	BNEQ	15$
	CALLS	#0,PART_F
15$:
	CMPB	PART,#^A/G/
	BNEQ	16$
	CALLS	#0,PART_G
16$:
	CMPB	PART,#^A/H/
	BNEQ	17$
	CALLS	#0,PART_H
17$:
	CMPB	PART,#^A/I/
	BNEQ	18$
	CALLS	#0,PART_I
18$:
	CMPB	PART,#^A/J/
	BNEQ	19$
	CALLS	#0,PART_J
19$:
	PUSHAB	AFTER
	CALLS	#1,G^LIB$PUT_OUTPUT
	MOVL	#1,R0
	RET
	.END	FOR80E
