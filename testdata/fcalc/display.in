sin(30)
set angle grads
show angle
set angle radians
! Seeds: the same seed, the same numbers; only that is shown.
show seed
set seed 42
a = rand();
b = rand();
a == b
set seed 42
rand() == a
show seed
set seed 43
rand() == a
! Errors.
