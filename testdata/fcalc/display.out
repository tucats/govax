fcalc> set echo
fcalc> ! The settings as they start.
fcalc> show settings
set digits 12
set format auto
set angle radians
set base decimal
set echo
fcalc> ! AUTO, the default: 12 significant digits, trailing zeros dropped.
fcalc> pi
3.14159265359
fcalc> 1/3
0.333333333333
fcalc> 2^60
1.15292150461e+18
fcalc> 1.5e-7
1.5e-7
fcalc> 0.00012
0.00012
fcalc> set digits 4
fcalc> pi
3.142
fcalc> 123456
1.235e+5
fcalc> 1/3
0.3333
fcalc> 2/3 + i/3
0.6667 + 0.3333i
fcalc> show digits
set digits 4
fcalc> ! SCIENTIFIC: every digit shown, one before the point.
fcalc> set format scientific
fcalc> pi
3.142e+0
fcalc> 0
0.000e+0
fcalc> -2
-2.000e+0
fcalc> 1e-7
1.000e-7
fcalc> 6.02214076e23
6.022e+23
fcalc> 3 + 4i
3.000e+0 + 4.000e+0i
fcalc> [1, 20; 300, 4000]
  1.000e+0  2.000e+1
  3.000e+2  4.000e+3
fcalc> set digits 1
fcalc> pi
3e+0
fcalc> -0.96
-1e+0
fcalc> ! ENGINEERING: the exponent a multiple of 3.
fcalc> set format engineering
fcalc> 12345
10e+3
fcalc> set digits 4
fcalc> 12346
12.35e+3
fcalc> 0.00015
150.0e-6
fcalc> 1.5e-7
150.0e-9
fcalc> -0.001
-1.000e-3
fcalc> 1e5
100.0e+3
fcalc> 999.96
1.000e+3
fcalc> set digits 2
fcalc> 1.5e5
150e+3
fcalc> 1234
1.2e+3
fcalc> ! FIXED: DIGITS places after the point.
fcalc> set format fixed
fcalc> set digits 4
fcalc> pi
3.1416
fcalc> 2
2.0000
fcalc> -1/3
-0.3333
fcalc> 123.456
123.4560
fcalc> 2.5 + 1.25i
2.5000 + 1.2500i
fcalc> 0.00001
0.0000
fcalc> -0.00001
0.0000
fcalc> 1e-9 + 1e-6i
0.0000
fcalc> 1 + 1e-6i
1.0000
fcalc> 0.00006
0.0001
fcalc> 99999999999
99999999999.0000
fcalc> 1e11
1.0000e+11
fcalc> 1e12
1.0000e+12
fcalc> [1, 0.5; 0.25, 0.125]
  1.0000  0.5000
  0.2500  0.1250
fcalc> set digits 1
fcalc> pi
3.1
fcalc> show format
set format fixed
fcalc> set format auto
fcalc> set digits 12
fcalc> ! Bases: a whole number is shown with its prefix, which may be typed.
fcalc> set base hex
fcalc> 255
0xFF
fcalc> -255
-0xFF
fcalc> 0xff + 1
0x100
fcalc> 0x1fi
0x1Fi
fcalc> 3 + 4i
0x3 + 0x4i
fcalc> 2.5
2.5
fcalc> 0
0
fcalc> 0b1010
0xA
fcalc> 0o17
0xF
fcalc> 2^51
0x8000000000000
fcalc> 4e15
4e+15
fcalc> [10, 11; 12, 255]
  0xA   0xB
  0xC  0xFF
fcalc> n = 4096
n = 0x1000
fcalc> list variables
ans = [0xA, 0xB; 0xC, 0xFF]
n = 0x1000
fcalc> show base
set base hex
fcalc> set base binary
fcalc> 10
0b1010
fcalc> -5
-0b101
fcalc> 0.5
0.5
fcalc> 0x7FFFFFFF
0b1111111111111111111111111111111
fcalc> set base octal
fcalc> 64
0o100
fcalc> 0xFF
0o377
fcalc> set base decimal
fcalc> 0xff
255
fcalc> 0XFF + 0B11 + 0O7
265
fcalc> 0b11i
3i
fcalc> 0x
        ^
%FCALC-E-EXTRA, unexpected text
fcalc> 0b102
       ^
%FCALC-E-BADNUMBER, invalid number
fcalc> 0xfffffffffffff
       ^
%FCALC-E-OVERFLOW, result is too large
fcalc> 0xFFFFFFFFFFFFFF
       ^
%FCALC-E-OVERFLOW, result is too large
fcalc> clear n
fcalc> ! Angles.
fcalc> set angle degrees
fcalc> show angle
set angle degrees
fcalc> sin(30)
0.5
fcalc> set angle grads
fcalc> show angle
set angle grads
fcalc> set angle radians
fcalc> ! Seeds: the same seed, the same numbers; only that is shown.
fcalc> show seed
! no seed has been set
fcalc> set seed 42
fcalc> a = rand();
fcalc> b = rand();
fcalc> a == b
0
fcalc> set seed 42
fcalc> rand() == a
1
fcalc> show seed
set seed 42
fcalc> set seed 43
fcalc> rand() == a
0
fcalc> ! Errors.
fcalc> set format bogus
                  ^
%FCALC-E-BADSET, unknown setting
fcalc> set format
                 ^
%FCALC-E-BADSET, unknown setting
fcalc> set format auto extra
                       ^
%FCALC-E-EXTRA, unexpected text
fcalc> set base 16
                ^
%FCALC-E-BADSET, unknown setting
fcalc> set digits 0
                  ^
%FCALC-E-DOMAIN, argument is out of range
fcalc> set digits 16
                  ^
%FCALC-E-DOMAIN, argument is out of range
fcalc> set digits 2.5
                  ^
%FCALC-E-DOMAIN, argument is out of range
fcalc> set seed -1
                ^
%FCALC-E-DOMAIN, argument is out of range
fcalc> set seed 1e10
                ^
%FCALC-E-DOMAIN, argument is out of range
fcalc> set seed x
                ^
%FCALC-E-BADSET, unknown setting
fcalc> show bogus
            ^
%FCALC-E-BADSET, unknown setting
fcalc> show settings now
                     ^
%FCALC-E-EXTRA, unexpected text
fcalc> show
           ^
%FCALC-E-BADSET, unknown setting
fcalc> set
          ^
%FCALC-E-BADSET, unknown setting
fcalc> ! Every setting changed, then shown.
fcalc> set digits 8
fcalc> set format engineering
fcalc> set angle degrees
fcalc> set base hex
fcalc> show settings
set digits 8
set format engineering
set angle degrees
set base hex
set seed 43
set echo
fcalc> set noecho
fcalc> set noecho
fcalc> set echo
fcalc> clear all
fcalc> show memory
arrays in use: 0
tree nodes in use: 0
fcalc> quit
