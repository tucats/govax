! Choosing: only the arm chosen is evaluated.
if(1 < 2, 10, 20)
if(0, 1/0, 5)
if(1, 5, 1/0)
if(1, 2)
! Random numbers: only their properties can be shown.
floor(rand())
floor(rand(10, 20) / 10)
ceil(rand(6) / 6)
frac(rand(6))
rand(0)
! Arguments and their errors.
sqrt()
sqrt(1, 2)
foo(1)
sin(cos(0.5) + ln(2))
sqrt(1/0)
quit
