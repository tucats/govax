fcalc> ! The labels by the display's settings.
fcalc> plot 1000 * x for x from 0 to 1 size 11, 3
1000 |        ***
     |   *****
   0 |***--------
     +-----------
      0         1
      * 1000 * x
fcalc> set base hex
fcalc> plot x^2 for x from 0 to 16 size 17, 5
0x100 |               **
      |             **
      |          ***
      |      ****
    0 |******-----------
      +-----------------
       0            0x10
       * x^2
fcalc> set base decimal
fcalc> ! PLOT's errors.
fcalc> plot x for x from 1 to 0
                              ^
%FCALC-E-BADLIMITS, lower limit must be below upper limit
fcalc> plot x for x from 0 to 1 y 1, 1
                                     ^
%FCALC-E-BADLIMITS, lower limit must be below upper limit
fcalc> plot x for x from 0 to 1 size 5, 5
                                     ^
%FCALC-E-DOMAIN, argument is out of range
fcalc> plot x for x from 0 to 1 size 20.5, 5
                                     ^
%FCALC-E-NOTWHOLE, operand must be a whole number
fcalc> plot x for x from 0 to 1 size 20, 61
                                         ^
%FCALC-E-DOMAIN, argument is out of range
fcalc> plot x for x from 0 to 1 size 20 5
                                        ^
%FCALC-E-KEYWORD, ',' expected
fcalc> plot x for x from 0 to 1 y 0
                                   ^
%FCALC-E-KEYWORD, ',' expected
fcalc> plot sqrt(x - 5) for x from 0 to 1
            ^
%FCALC-E-NOPOINTS, no point can be plotted
fcalc> plot [1i, 2i]
            ^
%FCALC-E-NOPOINTS, no point can be plotted
fcalc> plot [1, 2; 3, 4]
            ^
%FCALC-E-NOTVECTOR, operand must be a vector
fcalc> plot 3
            ^
%FCALC-E-NOTVECTOR, operand must be a vector
fcalc> plot [1, 2] versus [1, 2, 3]
            ^
%FCALC-E-NOTCONFORM, shapes of the operands do not agree
fcalc> plot [1, 2] versus [1, 2i]
                          ^
%FCALC-E-NOTREAL, operand must be real
fcalc> plot [1, 2] versus 3
                          ^
%FCALC-E-NOTVECTOR, operand must be a vector
fcalc> plot y for x from 0 to 1
            ^
%FCALC-E-UNDEFINED, y is not defined
fcalc> plot [x, x] for x from 0 to 1
            ^
%FCALC-E-NOTSCALAR, operand must be a scalar
fcalc> plot x for x from 0 to 1 color 3
                                ^
%FCALC-E-EXTRA, unexpected text
fcalc> plot = 3
       ^
%FCALC-E-RESERVED, plot is a reserved word
fcalc> clear all
fcalc> show memory
arrays in use: 0
tree nodes in use: 0
