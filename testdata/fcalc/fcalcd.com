$! fcalcd.com: fcalc under the debugger (Phase 111, subtask 9). fcalc is built
$! /DEBUG with nothing optimized, MACRO/DEBUG, and LINK/DEBUG, and run with
$! DBG$INPUT naming FCALCD.DBG, a session that logs itself to FCALCD.DLG;
$! fcalc reads its lines from the data lines below.
$ FORTRAN/G_FLOATING/NOOPTIMIZE/DEBUG=ALL FCPLATFORM
$ FORTRAN/G_FLOATING/NOOPTIMIZE/DEBUG=ALL FCKINDS
$ FORTRAN/G_FLOATING/NOOPTIMIZE/DEBUG=ALL FCMESSAGES
$ FORTRAN/G_FLOATING/NOOPTIMIZE/DEBUG=ALL FCVALUES
$ FORTRAN/G_FLOATING/NOOPTIMIZE/DEBUG=ALL FCARRAYS
$ FORTRAN/G_FLOATING/NOOPTIMIZE/DEBUG=ALL FCLEXER
$ FORTRAN/G_FLOATING/NOOPTIMIZE/DEBUG=ALL FCTREE
$ FORTRAN/G_FLOATING/NOOPTIMIZE/DEBUG=ALL FCSYMBOLS
$ FORTRAN/G_FLOATING/NOOPTIMIZE/DEBUG=ALL FCFUNCS
$ FORTRAN/G_FLOATING/NOOPTIMIZE/DEBUG=ALL FCPOLY
$ FORTRAN/G_FLOATING/NOOPTIMIZE/DEBUG=ALL FCMATRIX
$ FORTRAN/G_FLOATING/NOOPTIMIZE/DEBUG=ALL FCEVAL
$ FORTRAN/G_FLOATING/NOOPTIMIZE/DEBUG=ALL FCNUMERIC
$ FORTRAN/G_FLOATING/NOOPTIMIZE/DEBUG=ALL FCPLOT
$ FORTRAN/G_FLOATING/NOOPTIMIZE/DEBUG=ALL FCSTATE
$ FORTRAN/G_FLOATING/NOOPTIMIZE/DEBUG=ALL FCALC
$ MACRO/DEBUG FCPLATFORM
$ MACRO/DEBUG FCKINDS
$ MACRO/DEBUG FCMESSAGES
$ MACRO/DEBUG FCVALUES
$ MACRO/DEBUG FCARRAYS
$ MACRO/DEBUG FCLEXER
$ MACRO/DEBUG FCTREE
$ MACRO/DEBUG FCSYMBOLS
$ MACRO/DEBUG FCFUNCS
$ MACRO/DEBUG FCPOLY
$ MACRO/DEBUG FCMATRIX
$ MACRO/DEBUG FCEVAL
$ MACRO/DEBUG FCNUMERIC
$ MACRO/DEBUG FCPLOT
$ MACRO/DEBUG FCSTATE
$ MACRO/DEBUG FCALC
$ LINK/DEBUG FCALC,FCPLATFORM,FCKINDS,FCMESSAGES,FCVALUES,FCARRAYS,FCLEXER,-
       FCTREE,FCSYMBOLS,FCFUNCS,FCPOLY,FCMATRIX,FCEVAL,FCNUMERIC,FCPLOT,FCSTATE
$ DEFINE/USER_MODE DBG$INPUT FCALCD.DBG
$ RUN FCALC
set echo
fact(n) = if(n < 2, 1, n * fact(n - 1))
fact(3)
$ EXIT
