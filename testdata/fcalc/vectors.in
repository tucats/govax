set echo
! Vectors: rows and columns of values, made, indexed, and computed with.
! A row's elements are parted by commas, a column's by semicolons.
v = [1, 2, 3]
w = [4; 5; 6]
[2]
[1 + 2i, -3, 0.5]
[sqrt(4), 2^3, -(1)]
! A vector's elements may be vectors: they are joined.
[v, 4, 5]
[w; 7]
! The functions that make vectors.
linspace(0, 1, 5)
linspace(1, 2, 1)
range(1, 5)
range(10, 1, -3)
range(0, 1, 0.25)
range(0, 1, 0.1)
zeros(1, 3)
ones(3, 1)
! Indexing: a number, a range lo:hi:stride (as a Fortran section, any part
! left out), or a vector of numbers.
v(2)
w(3)
v(2:3)
v(:2)
v(2:)
v(:)
v(3:1:-1)
v(::2)
w(2:3)
v([3, 1, 1])
r = range(1, 12)
r(2:11:3)
! Assigning elements.
v(2) = 20
v(1:2) = 0
v([1, 3]) = [7, 9]
v
! Element by element: + and - and the dotted operators, a scalar with
! every element.
v = [1, 2, 3]
v + w'
v - 1
10 - v
2 * v
v / 2
v .* v
v ./ [2, 4, 8]
v .^ 2
2 .^ v
-v
[1, 2, 3, 4] mod 3
v == [1, 0, 3]
v > 1
v <> 2
not (v > 1)
v > 1 and v < 3
v < 2 or v > 2
[4, 5]!
! A row times a column is a number; a column times a row a matrix.
v * w
w * v
! The functions of FCFUNCS apply to each element.
sqrt([4, 9, -16])
abs([3 + 4i, -5])
exp([0, 1])
floor([1.5, -1.5])
atan2([1, -1], [1, 1])
atan2([1, -1], 1)
round(linspace(0, 1, 3) * 10)
! The list functions take every element.
sum(v)
prod(v)
mean([1, 2, 3, 4])
median([5, 1, 3])
max(v, 10)
min([4, 2], [8, 1])
gcd([12, 18, 30])
stdev([2, 4, 4, 4, 5, 5, 7, 9])
var([1, 2, 3, 4])
var([1, 2], 3, [4])
! Sizes.
size(v)
size(w)
size(5)
size(w, 1)
rows(v)
cols(v)
numel(w)
! Reshaping, running sums, sorting.
reshape(range(1, 6), 2, 3)
cumsum([1, 2, 3, 4])
cumsum([1; 1; 1])
sort([3, -1, 2, 0])
sort([2i, -1, 1 - i, 1 + i])
! Products and norms.
dot([1, 2, 3], [4, 5, 6])
dot([1; 2; 3], [4, 5, 6])
dot([i, 1], [i, 1])
cross([1, 0, 0], [0, 1, 0])
cross([1, 2, 3], [4, 5, 6])
norm([3, 4])
norm([3, -4], 1)
norm([1, 2, 2], 3)
norm([-7, 2], huge)
norm([1e200, 1e200])
! A vector's transposes: ' conjugates, .' doesn't.
[1, 2]'
[1 + i, 2]'
[1 + i, 2].'
! Users' functions of vectors.
sumsq(x) = sum(x .^ 2)
sumsq([1, 2, 3])
second(x) = x(2)
second([5, 6, 7])
unit(x) = x / norm(x)
unit([3, 4])
! NAME(...) = assigns elements if NAME is a variable holding an array, and
! defines a function if not; NAME(...) calls a function if there is one,
! and indexes a variable if not.
v = [10, 20, 30]
v(k) = 0
k = 2
v(k) = 0
clear v k
v(x) = 2 * x
v = [10, 20, 30]
v(3)
clear v
v(3)
! A long vector is shown in groups of columns that fit a line, and LIST
! shows each array as the literal that makes it.
long = range(1, 45)
list variables
clear all
! The errors.
[1, 2] + [1, 2, 3]
[1, 2; 3]
[1, 2
v = [1, 2, 3]
v(4)
v(0)
v(1.5)
v(i)
v(3:1)
v(1:3:0)
v(2) = [1, 2]
v(1, 2, 3)
sin(1:2)
1:2
2 ^ v
v ^ 2
linspace(0, 1, 0)
linspace(v, 1, 2)
range(5, 1)
range(1, 2, 0)
range(1, 1e9)
zeros(2.5)
ones(10001)
cross([1, 2], [3, 4])
dot([1, 2], [1, 2, 3])
size(v, 3)
reshape(v, 2, 2)
norm(v, 0.5)
[1e200, 2] .* 1e200
v / [1, 2]
clear all
show memory
quit
