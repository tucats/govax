$ ! FTN86D.COM - DUNGEON on VMS, built by VMS's MACRO and LINK from the .MAR files govax's
$ ! compiler made, against the FTNRTL FTN86.COM built. Written by testdata/ftn86/gen.go.
$ ! [DUNGEON] is compiled the usual way, [DUNGEONR] /RECURSIVE, its sections' names
$ ! ending in R.
$ !
$ ! Run it after FTN86.COM, with the exchange volume's [000000] the default directory:
$ !
$ !     @FTN86D/OUTPUT=FTN86D.LOG
$ !
$ SET NOON
$ ROOT = F$PARSE(F$ENVIRONMENT("DEFAULT"),,,"DEVICE")
$ DEFINE FTNRTL 'ROOT'[FTN86]FTNRTL.EXE
$ SET DEFAULT 'ROOT'[DUNGEON]
$ WRITE SYS$OUTPUT "==== BUILD"
$ MACRO/NOLIST DUNGEON,GAME,GDT,PARSER,SUBR,ROOMS,VERBS,OBJECTS,TIMEFNC
$ LINK/NOMAP/EXECUTABLE=DUNGEON DUNGEON,GAME,GDT,PARSER,SUBR,ROOMS,VERBS,OBJECTS,TIMEFNC,'ROOT'[FTN86]FTN86/OPTIONS
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== GAME"
$ DEFINE/USER_MODE SYS$INPUT GAME.IN
$ RUN DUNGEON
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== SAVE"
$ DEFINE/USER_MODE SYS$INPUT SAVE.IN
$ RUN DUNGEON
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== RESTORE"
$ DEFINE/USER_MODE SYS$INPUT RESTORE.IN
$ RUN DUNGEON
$ SHOW SYMBOL $STATUS
$ SET DEFAULT 'ROOT'[DUNGEONR]
$ WRITE SYS$OUTPUT "==== BUILDR"
$ MACRO/NOLIST DUNGEON,GAME,GDT,PARSER,SUBR,ROOMS,VERBS,OBJECTS,TIMEFNC
$ LINK/NOMAP/EXECUTABLE=DUNGEON DUNGEON,GAME,GDT,PARSER,SUBR,ROOMS,VERBS,OBJECTS,TIMEFNC,'ROOT'[FTN86]FTN86/OPTIONS
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== GAMER"
$ DEFINE/USER_MODE SYS$INPUT GAME.IN
$ RUN DUNGEON
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== SAVER"
$ DEFINE/USER_MODE SYS$INPUT SAVE.IN
$ RUN DUNGEON
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== RESTORER"
$ DEFINE/USER_MODE SYS$INPUT RESTORE.IN
$ RUN DUNGEON
$ SHOW SYMBOL $STATUS
$ SET DEFAULT 'ROOT'[000000]
$ WRITE SYS$OUTPUT "==== END"
