$ ! FTN86.COM - does a program govax's FORTRAN compiler made run on VMS, with FTNRTL
$ ! built here from its sources? (docs/PHASE-86 - FORTRAN milestone.md, subtask 4). Written
$ ! by testdata/ftn86/gen.go. There's no VAX FORTRAN here, and none is needed: each
$ ! program's .MAR file came from govax's compiler, and VMS's MACRO and LINK do the rest.
$ !
$ ! Run it with the exchange volume mounted as DUA1, its [000000] the default directory:
$ !
$ !     @FTN86/OUTPUT=FTN86.LOG
$ !
$ SET NOON
$ ROOT = F$PARSE(F$ENVIRONMENT("DEFAULT"),,,"DEVICE")
$ !
$ ! FTNRTL, from its sources.
$ !
$ SET DEFAULT DUA1:[FTN86]
$ WRITE SYS$OUTPUT "==== FTNRTL"
==== FTNRTL
$ MACRO/NOLIST FTN_VECTOR
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_CONTROL
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_UNITS
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_STATEMENT
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_FORMAT
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_EDIT
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_FLOAT
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_LISTOUT
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_LISTIN
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_NAMELIST
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_INTERNAL
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_OPEN
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_INQUIRE
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_POSITION
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_UNFORMATTED
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_DIRECT
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_RECORD
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_INTRINSICS
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_SYSTEM
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ LINK/SHAREABLE=FTNRTL/MAP=FTNRTL/FULL FTNRTL/OPTIONS
! FTNRTL.OPT - the options that link FTNRTL.EXE, govax's FORTRAN run-time
! library (docs/PHASE-74 - FORTRAN plan.md, Decision 13). go generate
! ./internal/ftnrtl builds the image from these, as
!
!	$ MACRO FTN_VECTOR
!	$ MACRO FTN_CONTROL
!	$ MACRO FTN_UNITS
!	$ MACRO FTN_STATEMENT
!	$ MACRO FTN_FORMAT
!	$ MACRO FTN_EDIT
!	$ MACRO FTN_FLOAT
!	$ MACRO FTN_LISTOUT
!	$ MACRO FTN_LISTIN
!	$ MACRO FTN_NAMELIST
!	$ MACRO FTN_INTERNAL
!	$ MACRO FTN_OPEN
!	$ MACRO FTN_INQUIRE
!	$ MACRO FTN_POSITION
!	$ MACRO FTN_UNFORMATTED
!	$ MACRO FTN_DIRECT
!	$ MACRO FTN_RECORD
!	$ MACRO FTN_INTRINSICS
!	$ MACRO FTN_SYSTEM
!	$ LINK/SHAREABLE=FTNRTL/NOSYSLIB FTNRTL/OPTIONS
!
! would, with internal/asm and internal/link, which take LIBRTL's and MTHRTL's
! symbols from govax's own tables. VMS's LINK finds them in IMAGELIB, so on VMS
! it is the same LINK without /NOSYSLIB (testdata/ftn86). The transfer vector is a
! cluster of its own, first, so that it starts the image; the modules
! follow. GSMATCH=LEQUAL lets a program linked against this FTNRTL run on
! any later one: add 1 to the minor number whenever the vector gains an
! entry, and change the major number only if an entry's meaning changes.
CLUSTER=FTNRTL_VECTOR,,,FTN_VECTOR.OBJ
FTN_CONTROL.OBJ
FTN_UNITS.OBJ
FTN_STATEMENT.OBJ
FTN_FORMAT.OBJ
FTN_EDIT.OBJ
FTN_FLOAT.OBJ
FTN_LISTOUT.OBJ
FTN_LISTIN.OBJ
FTN_NAMELIST.OBJ
FTN_INTERNAL.OBJ
FTN_OPEN.OBJ
FTN_INQUIRE.OBJ
FTN_POSITION.OBJ
FTN_UNFORMATTED.OBJ
FTN_DIRECT.OBJ
FTN_RECORD.OBJ
FTN_INTRINSICS.OBJ
FTN_SYSTEM.OBJ
GSMATCH=LEQUAL,1,17
IDENTIFICATION="V1.0"
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ DEFINE FTNRTL DUA1:[FTN86]FTNRTL.EXE
$ !
$ ! Each program, compiled by govax both ways, each in a directory of its own, since
$ ! a program may leave files behind it.
