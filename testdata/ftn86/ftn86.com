$ ! FTN86.COM - does a program govax's FORTRAN compiler made run on VMS, with FTNRTL
$ ! built here from its sources? (docs/PHASE-86 - FORTRAN milestone.md, subtask 4). Written
$ ! by testdata/ftn86/gen.go. There's no VAX FORTRAN here, and none is needed: each
$ ! program's .MAR file came from govax's compiler, and VMS's MACRO and LINK do the rest.
$ !
$ ! Run it with the exchange volume mounted as DUA1, its [000000] the default directory:
$ !
$ !     @FTN86/OUTPUT=FTN86.LOG
$ !
$ SET NOON
$ ROOT = F$PARSE(F$ENVIRONMENT("DEFAULT"),,,"DEVICE")
$ !
$ ! FTNRTL, from its sources.
$ !
$ SET DEFAULT 'ROOT'[FTN86]
$ WRITE SYS$OUTPUT "==== FTNRTL"
$ MACRO/NOLIST FTN_VECTOR
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_CONTROL
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_UNITS
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_STATEMENT
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_FORMAT
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_EDIT
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_FLOAT
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_LISTOUT
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_LISTIN
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_NAMELIST
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_INTERNAL
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_OPEN
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_INQUIRE
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_POSITION
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_UNFORMATTED
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_DIRECT
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_RECORD
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_KEYED
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_INTRINSICS
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_SYSTEM
$ SHOW SYMBOL $STATUS
$ IF F$TRNLNM("FTNRTL") .NES. "" THEN DEASSIGN FTNRTL
$ LINK/SHAREABLE=FTNRTL/MAP=FTNRTL/FULL FTNRTL/OPTIONS
$ SHOW SYMBOL $STATUS
$ DEFINE FTNRTL 'ROOT'[FTN86]FTNRTL.EXE
$ !
$ ! Each program, compiled by govax three ways, each in a directory of its own, since
$ ! a program may leave files behind it.
$ !
