	.TITLE	LIB55	Phase 55 LIBRTL jackets and resources probe
	.IDENT	/V1.0/

; Written by testdata/lib55/gen.go: do not edit. Calls each of Phase
; 55's LIBRTL routines, case by case, each in a routine of its own under
; HANDLER, and prints with LIB$PUT_OUTPUT what it returned in R0, any
; condition it signaled, and what it stored. See gen.go.

	$SSDEF
	$JPIDEF
	$DVIDEF
	$SYIDEF
	$LNMDEF

	.PSECT	DATA,NOEXE,WRT,QUAD
SIGCOND:	.LONG	0		; the condition HANDLER was given
SIGARG1:	.LONG	0		; an access violation's reason mask
SIGARG2:	.LONG	0		; and virtual address
LINLEN:	.WORD	0
	.ALIGN	LONG
LINDSC:	.WORD	132
	.BYTE	14,1
	.ADDRESS	LINE
PARTDSC:	.WORD	9
	.BYTE	14,1
	.LONG	0
OUTDSC:	.WORD	0
	.BYTE	14,1
	.ADDRESS	LINE
LINE:	.BLKB	132
MASKBUF:	.BLKB	200
R0CTL:	.ASCID	"!AC R0=!XL"
SIGCTL:	.ASCID	"!AC R0=!XL signal !XL !XL !XL"
MEMCTL:	.ASCID	"  !AC:"
VMEMCTL:	.ASCID	"  ~!AC:"
LWCTL:	.ASCID	" !XL"
TXTCTL:	.ASCID	/  !AC: !UL "!AF"/
VTXTCTL:	.ASCID	/  ~!AC: !UL "!AF"/
MASKCTL:	.ASCID	/  !AC masked: !UL "!AF"/

; Shared data.
	.ALIGN	QUAD
ABSTIM:	.LONG	^XB7E49CC0,^X00BC3E97
DELTIM:	.LONG	^XA459A2E0,^XFFFFFF25
BADTIM:	.LONG	^X12BA4000,^XFFE14D2E
ONE:	.LONG	1
ZERO:	.LONG	0
FIFTEEN:	.LONG	15
ACCNAM:	.LONG	0		; LIB$GET_ACCNAM's FILE table, if VMS has it
HANDLE:	.LONG	0		; a heap timer block
ASTVAL:	.LONG	^X55555555	; LIB$AST_IN_PROG's value in an AST
TIMSTAT:	.LONG	1		; what TIMACT returns
TIMARG:	.LONG	^X55555555	; TIMACT's second argument
TIMCNT:	.LONG	0		; TIMACT's argument count
TIMDSC:	.WORD	0		; TIMACT's copy of the line
	.BYTE	14,1
	.ADDRESS	TIMBUF
TIMBUF:	.BLKB	200
DISKNAM:	.ASCID	"LIB55_DISK"
PROCTAB:	.ASCID	"LNM$PROCESS_TABLE"
LANGNAM:	.ASCID	"SYS$LANGUAGE"
TRNNAM:	.ASCID	"LIB55_NAME"
FRENCH:	.ASCII	"FRENCH"
HELLO:	.ASCII	"Hello World"
LANGITM:	.WORD	6,LNM$_STRING
	.ADDRESS	FRENCH
	.LONG	0,0
TRNITM:	.WORD	11,LNM$_STRING
	.ADDRESS	HELLO
	.LONG	0,0
OWNNAMS:	.WORD	1
	.BYTE	14,1
	.ADDRESS	OWNNAMS_0
	.WORD	1
	.BYTE	14,1
	.ADDRESS	OWNNAMS_1
	.WORD	1
	.BYTE	14,1
	.ADDRESS	OWNNAMS_2
	.WORD	1
	.BYTE	14,1
	.ADDRESS	OWNNAMS_3
OWNNAMS_0:	.ASCII	"S"
OWNNAMS_1:	.ASCII	"O"
OWNNAMS_2:	.ASCII	"G"
OWNNAMS_3:	.ASCII	"W"
EQUALS:	.ASCID	"="
COMMA:	.ASCID	","
MYTABLE:	.WORD	5
	.BYTE	14,1
	.ADDRESS	MYTABLE_0
	.WORD	4
	.BYTE	14,1
	.ADDRESS	MYTABLE_1
	.WORD	0
	.BYTE	14,1
	.ADDRESS	MYTABLE_2
	.WORD	5
	.BYTE	14,1
	.ADDRESS	MYTABLE_3
