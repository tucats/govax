; 50: GETJPI pid 0 written
	.ENTRY	C50,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	PUSHAB	C50_P
	PUSHAB	C50_I
	CALLS	#2,G^LIB$GETJPI
	PUSHL	R0
	CLRL	C50_Z
	TSTL	C50_P
	BEQL	C50_NZ
	MOVL	#1,C50_Z
	C50_NZ:
	$GETJPIW_S	ITMLST=C50_IL
	CMPL	C50_P,C50_MY
	BNEQ	C50_NE
	MOVL	#1,C50_E
	C50_NE:
	MOVL	(SP)+,R0
	RET

