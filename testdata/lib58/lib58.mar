; 272: make LOST directories
	.ENTRY	C272,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	PUSHAW	PROTVAL
	PUSHAW	PROTEN
	PUSHL	#0
	PUSHAB	C272_F0
	CALLS	#4,G^LIB$CREATE_DIR
	BLBS	R0,C272_K0
	BRW	C272_X
C272_K0:
	INCL	C272_N
	PUSHAW	PROTVAL
	PUSHAW	PROTEN
	PUSHL	#0
	PUSHAB	C272_F1
	CALLS	#4,G^LIB$CREATE_DIR
	BLBS	R0,C272_K1
	BRW	C272_X
C272_K1:
	INCL	C272_N
C272_X:
	PUSHL	R0
	MOVL	(SP)+,R0
	RET

; 273: make ORPHAN.TXT
	.ENTRY	C273,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	PUSHAB	C273_S
	CALLS	#1,MKFILE
	PUSHL	R0
	MOVL	MKNAM+NAM$W_FID,LOSTFID
	MOVW	MKNAM+NAM$W_FID+4,LOSTFID+4
	MOVL	MKNAM+NAM$W_DID,LOSTDID
	MOVW	MKNAM+NAM$W_DID+4,LOSTDID+4
	MOVL	(SP)+,R0
	PUSHL	R0
	MOVL	(SP)+,R0
	RET

