	.PSECT	CODE,NOWRT,EXE

; HANDLER records the condition (and an access violation's reason mask
; and address), then unwinds to the case routine's caller, which gets
; the condition in R0. It ignores SS$_UNWIND, the call an unwind makes.
	.ENTRY	HANDLER,^M<>
	MOVL	4(AP),R0		; the signal array
	CMPL	4(R0),#SS$_UNWIND
	BEQL	9$
	MOVL	4(R0),SIGCOND
	CLRQ	SIGARG1
	CMPL	SIGCOND,#SS$_ACCVIO
	BNEQ	1$
	MOVQ	8(R0),SIGARG1
1$:	MOVL	8(AP),R1		; the mechanism array
	MOVL	SIGCOND,12(R1)		; CHF$L_MCH_SAVR0
	$UNWIND_S
9$:	RET

; EMIT writes the line in LINE (LINLEN long): to the log while a case
; runs (INCALL), else to SYS$OUTPUT.
	.ENTRY	EMIT,^M<R2,R3,R4,R5>
	MOVZWL	LINLEN,R2
	TSTL	INCALL
	BEQL	2$
	ADDL3	LOGEND,R2,R3
	ADDL2	#2,R3
	CMPL	R3,#LOGSIZE
	BGTRU	1$
	MOVAB	LOGBUF,R4
	ADDL2	LOGEND,R4
	MOVW	R2,(R4)+
	MOVL	R3,LOGEND
	MOVC3	R2,LINE,(R4)
	RET
1$:	INCL	LOGLOST
	RET
2$:	MOVW	R2,OUTDSC
	PUSHAQ	OUTDSC
	CALLS	#1,G^LIB$PUT_OUTPUT
	RET

; FLUSH writes the log's lines to SYS$OUTPUT and empties it.
	.ENTRY	FLUSH,^M<R2,R3>
	MOVAB	LOGBUF,R2
	ADDL3	R2,LOGEND,R3
1$:	CMPL	R2,R3
	BGEQU	2$
	MOVZWL	(R2)+,R0
	MOVW	R0,LOGDSC
	MOVL	R2,LOGDSC+4
	ADDL2	R0,R2
	PUSHAQ	LOGDSC
	CALLS	#1,G^LIB$PUT_OUTPUT
	BRB	1$
2$:	CLRL	LOGEND
	TSTL	LOGLOST
	BEQL	3$
	$FAO_S	CTRSTR=LOSTCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=LOGLOST
	CLRL	LOGLOST
	CALLS	#0,EMIT
3$:	RET

; RESETCB puts the routines' answers and actions back as they start:
; success, and nothing more.
	.ENTRY	RESETCB,^M<>
	MNEGL	#1,CONFBITS
	MNEGL	#1,ERRBITS
	MNEGL	#1,SUCCBITS
	CLRL	CONFACT
	CLRL	SUCCACT
	RET

; CBSTAT cell: the status a routine returns, from the cell's low bit (1
; is success, 0 FAILST), and the cell rotated a bit to the right.
	.ENTRY	CBSTAT,^M<>
	MOVL	4(AP),R1
	MOVL	#1,R0
	BLBS	(R1),1$
	MOVL	#FAILST,R0
1$:	ROTL	#-1,(R1),(R1)
	RET

; CBPRINT name, shape, ap: a routine's line ("  > name argc"), then a
; line for each argument, as shape says to show it.
	.ENTRY	CBPRINT,^M<R2,R3,R4,R5,R6,R7>
	MOVL	12(AP),R6		; the routine's argument list
	MOVZBL	(R6),R5
	$FAO_S	CTRSTR=CBHCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP),P2=R5
	CALLS	#0,EMIT
	MOVL	8(AP),R4		; the shape
	CLRL	R3
1$:	CMPL	R3,R5
	BLSS	2$
	RET
2$:	MOVL	4(R6)[R3],R2		; the argument
	ADDL3	#1,R3,R7		; its number
	MOVB	#^A"V",R0
	MOVZBL	(R4),R1
	CMPL	R3,R1
	BGEQ	3$
	MOVB	1(R4)[R3],R0
3$:	CMPB	R0,#^A"V"
	BNEQ	4$
	BRW	20$
4$:	TSTL	R2
	BNEQ	5$
	$FAO_S	CTRSTR=CB0CTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=R7
	BRW	90$
5$:	CMPB	R0,#^A"D"
	BNEQ	6$
	BRW	10$
6$:	CMPB	R0,#^A"R"
	BNEQ	7$
	BRW	30$
7$:	$FAO_S	CTRSTR=CBFCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=R7
	CALLS	#0,EMIT
	PUSHL	R2
	PUSHAB	CBPFX
	CALLS	#2,FMTFAB
	BRW	91$
10$:	MOVZBL	2(R2),T1		; a descriptor: type, class, length, text
	MOVZBL	3(R2),T2
	MOVZWL	(R2),T3
	MOVL	4(R2),R1
	BNEQ	11$
	CLRL	T3
11$:	$FAO_S	CTRSTR=CBDCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=R7,P2=T1,P3=T2,P4=T3,P5=T3,P6=R1
	BRW	90$
20$:	$FAO_S	CTRSTR=CBVCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=R7,P2=R2
	BRW	90$
30$:	$FAO_S	CTRSTR=CBRCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=R7,P2=(R2)
90$:	CALLS	#0,EMIT
91$:	INCL	R3
	BRW	1$

; FMTFAB prefix, fab: a FAB's lines, each after the prefix (an ASCIC
; string): its block ID, status, status value, context, and whether it's
; open; its file and default names; then its NAM's.
	.ENTRY	FMTFAB,^M<R2,R3,R4>
	MOVL	8(AP),R2
	MOVZBL	FAB$B_BID(R2),R3
	CLRL	R4
	TSTW	FAB$W_IFI(R2)
	BEQL	1$
	MOVL	#1,R4
1$:	$FAO_S	CTRSTR=FAB1CTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP),P2=R3,-
		P3=FAB$L_STS(R2),P4=FAB$L_STV(R2),P5=FAB$L_CTX(R2),P6=R4
	CALLS	#0,EMIT
	CMPB	R3,#FAB$C_BID
	BNEQ	9$
	MOVZBL	FAB$B_FNS(R2),R3
	MOVL	FAB$L_FNA(R2),R4
	BNEQ	2$
	CLRL	R3
2$:	$FAO_S	CTRSTR=FNACTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP),P2=R3,P3=R3,P4=R4
	CALLS	#0,EMIT
	MOVZBL	FAB$B_DNS(R2),R3
	MOVL	FAB$L_DNA(R2),R4
	BNEQ	3$
	CLRL	R3
3$:	$FAO_S	CTRSTR=DNACTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP),P2=R3,P3=R3,P4=R4
	CALLS	#0,EMIT
	MOVL	FAB$L_NAM(R2),R4
	BEQL	9$
	PUSHL	R4
	PUSHL	4(AP)
	CALLS	#2,FMTNAM
9$:	RET

; FMTNAM prefix, nam: a NAM's lines: its resultant string and whether it
; holds a wildcard context, its expanded string, and its related NAM's
; resultant string.
	.ENTRY	FMTNAM,^M<R2,R3,R4,R5>
	MOVL	8(AP),R2
	MOVZBL	NAM$B_BID(R2),R3
	CMPB	R3,#NAM$C_BID
	BEQL	1$
	$FAO_S	CTRSTR=NAMXCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP),P2=R3
	CALLS	#0,EMIT
	RET
1$:	CLRL	R5
	TSTL	NAM$L_WCC(R2)
	BEQL	2$
	MOVL	#1,R5
2$:	MOVZBL	NAM$B_RSL(R2),R3
	MOVL	NAM$L_RSA(R2),R4
	BNEQ	3$
	CLRL	R3
3$:	$FAO_S	CTRSTR=NAMRCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP),P2=R3,P3=R3,P4=R4,P5=R5
	CALLS	#0,EMIT
	MOVZBL	NAM$B_ESL(R2),R3
	MOVL	NAM$L_ESA(R2),R4
	BNEQ	4$
	CLRL	R3
4$:	$FAO_S	CTRSTR=NAMECTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP),P2=R3,P3=R3,P4=R4
	CALLS	#0,EMIT
	MOVL	NAM$L_RLF(R2),R2
	BEQL	9$
	MOVZBL	NAM$B_RSL(R2),R3
	MOVL	NAM$L_RSA(R2),R4
	BNEQ	5$
	CLRL	R3
5$:	$FAO_S	CTRSTR=RLFCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP),P2=R3,P3=R3,P4=R4
	CALLS	#0,EMIT
9$:	RET

; CONFDO and SUCCDO do what CONFACT or SUCCACT asks, once, R2 the FAB
; (CONFDO only): 1 $OPEN and $CLOSE it, 2 signal SIGVAL, 3 delete
; NESTSPEC with LIB$DELETE_FILE, 4 $OPEN it and leave it open.
CONFDO:	MOVL	CONFACT,R0
	CLRL	CONFACT
	BRB	DOACT
SUCCDO:	MOVL	SUCCACT,R0
	CLRL	SUCCACT
DOACT:	CASEL	R0,#1,#3
1$:	.WORD	10$-1$,20$-1$,30$-1$,40$-1$
	RSB
10$:	PUSHL	#0
	PUSHL	#0
	PUSHL	R2
	CALLS	#3,G^SYS$OPEN
	MOVL	R0,T1
	PUSHL	#0
	PUSHL	#0
	PUSHL	R2
	CALLS	#3,G^SYS$CLOSE
	$FAO_S	CTRSTR=OPENCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=T1,P2=R0
	CALLS	#0,EMIT
	RSB
20$:	PUSHL	SIGVAL
	CALLS	#1,G^LIB$SIGNAL
	RSB
30$:	PUSHAB	DFOK
	PUSHL	#0
	PUSHL	#0
	PUSHAB	NESTSPEC
	CALLS	#4,G^LIB$DELETE_FILE
	$FAO_S	CTRSTR=NESTCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=R0
	CALLS	#0,EMIT
	RSB
40$:	PUSHL	#0
	PUSHL	#0
	PUSHL	R2
	CALLS	#3,G^SYS$OPEN
	$FAO_S	CTRSTR=OPEN1CTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=R0
	CALLS	#0,EMIT
	RSB

; The routines the probe gives LIBRTL: each logs its call and arguments,
; may do CONFACT's or SUCCACT's action, and returns its cell's next bit.
	.ENTRY	FSOK,^M<R2>
	PUSHL	AP
	PUSHAB	SH_F
	PUSHAB	NM_FSOK
	CALLS	#3,CBPRINT
	MOVL	4(AP),R2
	BSBW	SUCCDO
	PUSHAB	SUCCBITS
	CALLS	#1,CBSTAT
	RET

	.ENTRY	FSERR,^M<R2>
	PUSHL	AP
	PUSHAB	SH_F
	PUSHAB	NM_FSERR
	CALLS	#3,CBPRINT
	PUSHAB	ERRBITS
	CALLS	#1,CBSTAT
	RET

	.ENTRY	DFOK,^M<R2>
	PUSHL	AP
	PUSHAB	SH_DV
	PUSHAB	NM_DFOK
	CALLS	#3,CBPRINT
	CLRL	R2
	BSBW	SUCCDO
	PUSHAB	SUCCBITS
	CALLS	#1,CBSTAT
	RET

	.ENTRY	DFERR,^M<R2>
	PUSHL	AP
	PUSHAB	SH_DRRRV
	PUSHAB	NM_DFERR
	CALLS	#3,CBPRINT
	PUSHAB	ERRBITS
	CALLS	#1,CBSTAT
	RET

	.ENTRY	DFCONF,^M<R2>
	PUSHL	AP
	PUSHAB	SH_DFV
	PUSHAB	NM_DFCONF
	CALLS	#3,CBPRINT
	MOVL	8(AP),R2
	BSBW	CONFDO
	PUSHAB	CONFBITS
	CALLS	#1,CBSTAT
	RET

	.ENTRY	RFOK,^M<R2>
	PUSHL	AP
	PUSHAB	SH_DDV
	PUSHAB	NM_RFOK
	CALLS	#3,CBPRINT
	CLRL	R2
	BSBW	SUCCDO
	PUSHAB	SUCCBITS
	CALLS	#1,CBSTAT
	RET

	.ENTRY	RFERR,^M<R2>
	PUSHL	AP
	PUSHAB	SH_DDRRRV
	PUSHAB	NM_RFERR
	CALLS	#3,CBPRINT
	PUSHAB	ERRBITS
	CALLS	#1,CBSTAT
	RET

	.ENTRY	RFCONF,^M<R2>
	PUSHL	AP
	PUSHAB	SH_DDFV
	PUSHAB	NM_RFCONF
	CALLS	#3,CBPRINT
	MOVL	12(AP),R2
	BSBW	CONFDO
	PUSHAB	CONFBITS
	CALLS	#1,CBSTAT
	RET

; LISTF spec: a line ("  = name") for each file LIB$FIND_FILE finds for
; spec, at most 50, then its status ("  = end"), which it returns.
	.ENTRY	LISTF,^M<R2,R3>
	CLRL	LISTCTX
	MOVL	#50,R3
1$:	PUSHAL	LISTCTX
	PUSHAQ	LISTD
	PUSHL	4(AP)
	CALLS	#3,G^LIB$FIND_FILE
	BLBC	R0,2$
	$FAO_S	CTRSTR=LISTCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=#LISTD
	CALLS	#0,EMIT
	SOBGTR	R3,1$
2$:	MOVL	R0,R2
	$FAO_S	CTRSTR=LISTECTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=R2
	CALLS	#0,EMIT
	PUSHAL	LISTCTX
	CALLS	#1,G^LIB$FIND_FILE_END
	MOVL	R2,R0
	RET

; MKFILE spec: makes the file (one record), its NAM MKNAM.
	.ENTRY	MKFILE,^M<R2>
	MOVL	4(AP),R2
	MOVB	(R2),MKFAB+FAB$B_FNS
	MOVL	4(R2),MKFAB+FAB$L_FNA
	PUSHL	#0
	PUSHL	#0
	PUSHAB	MKFAB
	CALLS	#3,G^SYS$CREATE
	BLBC	R0,9$
	PUSHL	#0
	PUSHL	#0
	PUSHAB	MKRAB
	CALLS	#3,G^SYS$CONNECT
	BLBC	R0,8$
	PUSHL	#0
	PUSHL	#0
	PUSHAB	MKRAB
	CALLS	#3,G^SYS$PUT
	BLBC	R0,8$
	PUSHL	#0
	PUSHL	#0
	PUSHAB	MKFAB
	CALLS	#3,G^SYS$CLOSE
	RET
8$:	MOVL	R0,R2
	PUSHL	#0
	PUSHL	#0
	PUSHAB	MKFAB
	CALLS	#3,G^SYS$CLOSE
	MOVL	R2,R0
9$:	RET

; GETFID spec, fid, did: opens the file, keeps its file ID (and, unless
; did is 0, its directory ID), three words each, and its NAM's device
; name in DVIDSC and DVI2DSC.
	.ENTRY	GETFID,^M<R2,R3,R4,R5>
	MOVL	4(AP),R2
	MOVB	(R2),FIDFAB+FAB$B_FNS
	MOVL	4(R2),FIDFAB+FAB$L_FNA
	PUSHL	#0
	PUSHL	#0
	PUSHAB	FIDFAB
	CALLS	#3,G^SYS$OPEN
	BLBC	R0,9$
	PUSHL	#0
	PUSHL	#0
	PUSHAB	FIDFAB
	CALLS	#3,G^SYS$CLOSE
	MOVL	8(AP),R1
	MOVL	FIDNAM+NAM$W_FID,(R1)
	MOVW	FIDNAM+NAM$W_FID+4,4(R1)
	MOVL	12(AP),R1
	BEQL	1$
	MOVL	FIDNAM+NAM$W_DID,(R1)
	MOVW	FIDNAM+NAM$W_DID+4,4(R1)
1$:	MOVZBW	FIDNAM+NAM$T_DVI,DVIDSC
	SUBW3	#1,DVIDSC,DVI2DSC
	MOVC3	#15,FIDNAM+NAM$T_DVI+1,DVIBUF
	MOVL	#1,R0
9$:	RET

; SHOWR0 name, r0: the case's line.
	.ENTRY	SHOWR0,^M<>
	TSTL	SIGCOND
	BNEQ	1$
	$FAO_S	CTRSTR=R0CTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP),P2=8(AP)
	BRB	2$
1$:	$FAO_S	CTRSTR=SIGCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP),P2=8(AP),-
		P3=SIGCOND,P4=SIGARG1,P5=SIGARG2
2$:	CALLS	#0,EMIT
	RET

; SHOWMEM name, address, count, control: count longwords in hex, after
; the name as control (MEMCTL or VMEMCTL) shows it.
	.ENTRY	SHOWMEM,^M<R2,R3,R4>
	MOVL	8(AP),R2
	MOVL	12(AP),R3
	$FAO_S	CTRSTR=@16(AP),OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP)
	MOVZWL	LINLEN,R4
1$:	TSTL	R3
	BEQL	2$
	MOVAB	LINE[R4],PARTDSC+4
	$FAO_S	CTRSTR=LWCTL,OUTBUF=PARTDSC,P1=(R2)+
	ADDL2	#9,R4
	DECL	R3
	BRB	1$
2$:	MOVW	R4,LINLEN
	CALLS	#0,EMIT
	RET

; SHOWTXT name, descriptor: a class S or D string's length and text.
	.ENTRY	SHOWTXT,^M<R2,R3>
	MOVL	8(AP),R2
	MOVZWL	(R2),R0
	MOVL	4(R2),R3
	BNEQ	1$
	CLRL	R0
1$:	$FAO_S	CTRSTR=TXTCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP),P2=R0,P3=R0,P4=R3
	CALLS	#0,EMIT
	RET

; SHOWVS name, descriptor: a varying string's CURLEN and text.
	.ENTRY	SHOWVS,^M<R2>
	MOVL	8(AP),R2
	MOVL	4(R2),R2		; CURLEN, then the text
	MOVZWL	(R2)+,R0
	$FAO_S	CTRSTR=TXTCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP),P2=R0,P3=R0,P4=R2
	CALLS	#0,EMIT
	RET

; SHOWFAB name, fab: the name's line, then the FAB's.
	.ENTRY	SHOWFAB,^M<>
	$FAO_S	CTRSTR=FABHCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP)
	CALLS	#0,EMIT
	PUSHL	8(AP)
	PUSHAB	SHPFX
	CALLS	#2,FMTFAB
	RET

; 1: make directories
	.ENTRY	C1,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	PUSHAW	PROTVAL
	PUSHAW	PROTEN
	PUSHL	#0
	PUSHAB	C1_F0
	CALLS	#4,G^LIB$CREATE_DIR
	BLBS	R0,C1_K0
	BRW	C1_X
C1_K0:
	INCL	C1_N
	PUSHAW	PROTVAL
	PUSHAW	PROTEN
	PUSHL	#0
	PUSHAB	C1_F1
	CALLS	#4,G^LIB$CREATE_DIR
	BLBS	R0,C1_K1
	BRW	C1_X
C1_K1:
	INCL	C1_N
	PUSHAW	PROTVAL
	PUSHAW	PROTEN
	PUSHL	#0
	PUSHAB	C1_F2
	CALLS	#4,G^LIB$CREATE_DIR
	BLBS	R0,C1_K2
	BRW	C1_X
C1_K2:
	INCL	C1_N
	PUSHAW	PROTVAL
	PUSHAW	PROTEN
	PUSHL	#0
	PUSHAB	C1_F3
	CALLS	#4,G^LIB$CREATE_DIR
	BLBS	R0,C1_K3
	BRW	C1_X
C1_K3:
	INCL	C1_N
C1_X:
	PUSHL	R0
	MOVL	(SP)+,R0
	RET

; 2: make A and B files
	.ENTRY	C2,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	PUSHAB	C2_F0
	CALLS	#1,MKFILE
	BLBS	R0,C2_K0
	BRW	C2_X
C2_K0:
	INCL	C2_N
	PUSHAB	C2_F1
	CALLS	#1,MKFILE
	BLBS	R0,C2_K1
	BRW	C2_X
C2_K1:
	INCL	C2_N
	PUSHAB	C2_F2
	CALLS	#1,MKFILE
	BLBS	R0,C2_K2
	BRW	C2_X
C2_K2:
	INCL	C2_N
	PUSHAB	C2_F3
	CALLS	#1,MKFILE
	BLBS	R0,C2_K3
	BRW	C2_X
C2_K3:
	INCL	C2_N
	PUSHAB	C2_F4
	CALLS	#1,MKFILE
	BLBS	R0,C2_K4
	BRW	C2_X
C2_K4:
	INCL	C2_N
	PUSHAB	C2_F5
	CALLS	#1,MKFILE
	BLBS	R0,C2_K5
	BRW	C2_X
C2_K5:
	INCL	C2_N
	PUSHAB	C2_F6
	CALLS	#1,MKFILE
	BLBS	R0,C2_K6
	BRW	C2_X
C2_K6:
	INCL	C2_N
C2_X:
	PUSHL	R0
	MOVL	(SP)+,R0
	RET

; 3: define LIB58_LIST
	.ENTRY	C3,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	$CRELNM_S	TABNAM=PROCTAB,LOGNAM=LISTLOG,ITMLST=LISTITM
	MOVL	R0,C3_S
	PUSHL	R0
	MOVL	(SP)+,R0
	RET

; 4: FF A*.TXT 1
	.ENTRY	C4,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	MOVL	#^X55555555,STV
	PUSHAB	STV
	PUSHL	#0
	PUSHL	#0
	PUSHAB	CTXA
	PUSHAB	C4_D
	PUSHAB	C4_S
	CALLS	#6,G^LIB$FIND_FILE
	PUSHL	R0
	CLRL	C4_Z
	TSTL	CTXA
	BEQL	C4_NZ
	MOVL	#1,C4_Z
C4_NZ:
	MOVL	(SP)+,R0
	RET

; 5: FF A*.TXT 2
	.ENTRY	C5,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	MOVL	#^X55555555,STV
	PUSHAB	STV
	PUSHL	#0
	PUSHL	#0
	PUSHAB	CTXA
	PUSHAB	C5_D
	PUSHAB	C5_S
	CALLS	#6,G^LIB$FIND_FILE
	PUSHL	R0
	CLRL	C5_Z
	TSTL	CTXA
	BEQL	C5_NZ
	MOVL	#1,C5_Z
C5_NZ:
	MOVL	(SP)+,R0
	RET

; 6: FF A*.TXT 3
	.ENTRY	C6,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	MOVL	#^X55555555,STV
	PUSHAB	STV
	PUSHL	#0
	PUSHL	#0
	PUSHAB	CTXA
	PUSHAB	C6_D
	PUSHAB	C6_S
	CALLS	#6,G^LIB$FIND_FILE
	PUSHL	R0
	CLRL	C6_Z
	TSTL	CTXA
	BEQL	C6_NZ
	MOVL	#1,C6_Z
C6_NZ:
	MOVL	(SP)+,R0
	RET

; 7: FF A*.TXT 4
	.ENTRY	C7,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	MOVL	#^X55555555,STV
	PUSHAB	STV
	PUSHL	#0
	PUSHL	#0
	PUSHAB	CTXA
	PUSHAB	C7_D
	PUSHAB	C7_S
	CALLS	#6,G^LIB$FIND_FILE
	PUSHL	R0
	CLRL	C7_Z
	TSTL	CTXA
	BEQL	C7_NZ
	MOVL	#1,C7_Z
C7_NZ:
	MOVL	(SP)+,R0
	RET

; 8: FF A*.TXT 5
	.ENTRY	C8,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	MOVL	#^X55555555,STV
	PUSHAB	STV
	PUSHL	#0
	PUSHL	#0
	PUSHAB	CTXA
	PUSHAB	C8_D
	PUSHAB	C8_S
	CALLS	#6,G^LIB$FIND_FILE
	PUSHL	R0
	CLRL	C8_Z
	TSTL	CTXA
	BEQL	C8_NZ
	MOVL	#1,C8_Z
