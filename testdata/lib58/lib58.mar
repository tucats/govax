; 275: remove ORPHAN.TXT's entry
	.ENTRY	C275,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	$ASSIGN_S	DEVNAM=DVIDSC,CHAN=ACPCHAN
	MOVL	R0,C275_A
	MOVC5	#0,(SP),#0,#64,ACPFIB
	MOVL	LOSTDID,ACPFIB+FIB$W_DID
	MOVW	LOSTDID+4,ACPFIB+FIB$W_DID+4
	$QIOW_S	CHAN=ACPCHAN,FUNC=#IO$_DELETE,IOSB=ACPIOSB,P1=ACPFIBD,P2=#ORPHNAM
	MOVL	R0,C275_Q
	MOVZWL	ACPIOSB,C275_I
	$DASSGN_S	CHAN=ACPCHAN
	MOVL	C275_Q,R0
	PUSHL	R0
	MOVL	(SP)+,R0
	RET

