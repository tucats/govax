LGET:	.ASCID	~$GET~
LFND:	.ASCID	~$FIND~
LUPD:	.ASCID	~$UPDATE~
LDEL:	.ASCID	~$DELETE~
LREW:	.ASCID	~$REWIND~
LFRE:	.ASCID	~$FREE~
LRLS:	.ASCID	~$RELEASE~
LTRU:	.ASCID	~$TRUNCATE~
LDO:	.ASCID	~dump $OPEN~
LDE:	.ASCID	~dump $READ~
