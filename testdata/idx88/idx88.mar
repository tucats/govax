	.PSECT	C,EXE,NOWRT,LONG
; OUT(control string, values...): one line, by $FAOL.
	.ENTRY	OUT,^M<R2>
	MOVW	#256,BD
	MOVL	4(AP),R2
	MOVAB	8(AP),R0
	$FAOL_S	CTRSTR=(R2),OUTLEN=LD,OUTBUF=BD,PRMLST=(R0)
	PUSHAB	LD
	CALLS	#1,G^LIB$PUT_OUTPUT
	RET
; HND prints a condition and unwinds to the driver: a fault costs one case.
	.ENTRY	HND,^M<R2>
	MOVL	4(AP),R2
	CMPL	4(R2),#SS$_UNWIND
	BEQL	9$
	PUSHL	12(R2)
	PUSHL	8(R2)
	PUSHL	4(R2)
	PUSHAB	MCOND
	CALLS	#4,OUT
	$UNWIND_S
9$:	MOVL	#SS$_RESIGNAL,R0
	RET
	.ENTRY	MARK,^M<>
	PUSHL	4(AP)
	PUSHAB	MMK
	CALLS	#2,OUT
	RET
; SHOW(label, status): the status stays in R0.
	.ENTRY	SHOW,^M<>
	PUSHL	8(AP)
	PUSHL	4(AP)
	PUSHAB	MSHOW
	CALLS	#3,OUT
	MOVL	8(AP),R0
	RET
	.ENTRY	SHOWF,^M<R2>
	MOVAB	FB,R2
	PUSHL	FAB$L_STV(R2)
	PUSHL	FAB$L_STS(R2)
	PUSHL	FAB$L_FOP(R2)
	MOVZWL	FAB$W_DEQ(R2),-(SP)
	PUSHL	FAB$L_ALQ(R2)
	MOVZBL	FAB$B_BKS(R2),-(SP)
	MOVZWL	FAB$W_MRS(R2),-(SP)
	MOVZBL	FAB$B_RAT(R2),-(SP)
	MOVZBL	FAB$B_RFM(R2),-(SP)
	MOVZBL	FAB$B_ORG(R2),-(SP)
	PUSHAB	MFAB
	CALLS	#11,OUT
	RET
	.ENTRY	SHOWR,^M<R2>
	MOVL	CURR,R2
	MOVZBL	RAB$B_KRF(R2),-(SP)
	PUSHL	RAB$L_STV(R2)
	PUSHL	RAB$L_STS(R2)
	MOVZWL	RAB$W_RSZ(R2),-(SP)
	MOVZWL	RAB$W_RFA+4(R2),-(SP)
	PUSHL	RAB$W_RFA(R2)
	PUSHAB	MRAB
	CALLS	#7,OUT
	RET
; SHOWG: a record read.
	.ENTRY	SHOWG,^M<R2,R3>
	MOVL	CURR,R2
	MOVZWL	RAB$W_RSZ(R2),R3
	CMPL	R3,#60
	BLEQ	10$
	MOVL	#60,R3
10$:	PUSHAB	RDB
	PUSHL	R3
	PUSHL	RAB$L_STS(R2)
	MOVZWL	RAB$W_RFA+4(R2),-(SP)
	PUSHL	RAB$W_RFA(R2)
	MOVZWL	RAB$W_RSZ(R2),-(SP)
	PUSHAB	MGOT
	CALLS	#7,OUT
	RET
; SHOWK: the key XAB OKEY, after $DISPLAY.
	.ENTRY	SHOWK,^M<R2>
	MOVAB	OKEY,R2
	MOVZBL	XAB$B_PROLOG(R2),-(SP)
	PUSHL	XAB$L_DVB(R2)
	PUSHL	XAB$L_RVB(R2)
	MOVZWL	XAB$W_MRL(R2),-(SP)
	MOVZWL	XAB$W_IFL(R2),-(SP)
	MOVZWL	XAB$W_DFL(R2),-(SP)
	MOVZBL	XAB$B_DBS(R2),-(SP)
	MOVZBL	XAB$B_IBS(R2),-(SP)
	MOVZBL	XAB$B_DAN(R2),-(SP)
	MOVZBL	XAB$B_LAN(R2),-(SP)
	MOVZBL	XAB$B_IAN(R2),-(SP)
	MOVZBL	XAB$B_LVL(R2),-(SP)
	MOVZBL	XAB$B_TKS(R2),-(SP)
	MOVZBL	XAB$B_NUL(R2),-(SP)
	MOVZBL	XAB$B_NSG(R2),-(SP)
	MOVZBL	XAB$B_FLG(R2),-(SP)
	MOVZBL	XAB$B_DTP(R2),-(SP)
	MOVZBL	XAB$B_REF(R2),-(SP)
	PUSHAB	MKEY1
	CALLS	#19,OUT
	PUSHAB	KNMB
	PUSHL	#32
	MOVZBL	XAB$B_SIZ0+7(R2),-(SP)
	MOVZBL	XAB$B_SIZ0+6(R2),-(SP)
	MOVZBL	XAB$B_SIZ0+5(R2),-(SP)
	MOVZBL	XAB$B_SIZ0+4(R2),-(SP)
	MOVZBL	XAB$B_SIZ0+3(R2),-(SP)
	MOVZBL	XAB$B_SIZ0+2(R2),-(SP)
	MOVZBL	XAB$B_SIZ0+1(R2),-(SP)
	MOVZBL	XAB$B_SIZ0(R2),-(SP)
	MOVZWL	XAB$W_POS0+14(R2),-(SP)
	MOVZWL	XAB$W_POS0+12(R2),-(SP)
	MOVZWL	XAB$W_POS0+10(R2),-(SP)
	MOVZWL	XAB$W_POS0+8(R2),-(SP)
	MOVZWL	XAB$W_POS0+6(R2),-(SP)
	MOVZWL	XAB$W_POS0+4(R2),-(SP)
	MOVZWL	XAB$W_POS0+2(R2),-(SP)
	MOVZWL	XAB$W_POS0(R2),-(SP)
	PUSHAB	MKEY2
	CALLS	#19,OUT
	RET
	.ENTRY	SHOWA,^M<R2>
	MOVAB	OALL,R2
	PUSHL	XAB$L_LOC(R2)
	MOVZWL	XAB$W_VOL(R2),-(SP)
	MOVZWL	XAB$W_DEQ(R2),-(SP)
	PUSHL	XAB$L_ALQ(R2)
	MOVZBL	XAB$B_BKZ(R2),-(SP)
	MOVZBL	XAB$B_AOP(R2),-(SP)
	MOVZBL	XAB$B_ALN(R2),-(SP)
	MOVZBL	XAB$B_AID(R2),-(SP)
	PUSHAB	MALL
	CALLS	#9,OUT
	RET
; RST: the FAB and RAB as new, with what the case asked to share. RAB fields left
; by a failure can't carry over.
	.ENTRY	RST,^M<R2,R3,R4,R5>
	MOVC3	#FAB$C_BLN,FBT,FB
	MOVC3	#RAB$C_BLN,RBT,RB
	MOVB	SHRV,FB+FAB$B_SHR
	MOVAB	RB,CURR
	RET
	.ENTRY	NAMEF,^M<>
	MOVL	4(AP),R0
	MOVB	(R0),FB+FAB$B_FNS
	MOVL	4(R0),FB+FAB$L_FNA
	RET
; CRE(name): $CREATE by the values the case set, then $CONNECT.
	.ENTRY	CRE,^M<R2>
	CALLS	#0,RST
	PUSHL	4(AP)
	CALLS	#1,NAMEF
	MOVB	ORGV,FB+FAB$B_ORG
	MOVB	RFMV,FB+FAB$B_RFM
	MOVB	RATV,FB+FAB$B_RAT
	MOVW	MRSV,R0
	BGEQ	5$
	CLRL	R0
5$:	MOVW	R0,FB+FAB$W_MRS
	MOVB	BKSV,FB+FAB$B_BKS
	MOVL	ALQV,FB+FAB$L_ALQ
	MOVW	DEQV,FB+FAB$W_DEQ
	MOVL	FOPV,FB+FAB$L_FOP
	MOVL	XABV,FB+FAB$L_XAB
	PUSHAB	FB
	CALLS	#1,G^SYS$CREATE
	PUSHL	R0
	PUSHAB	LCRE
	CALLS	#2,SHOW
	MOVL	R0,R2
	CALLS	#0,SHOWF
	CLRL	FB+FAB$L_XAB
	BLBC	R2,9$
	PUSHAB	RB
	CALLS	#1,G^SYS$CONNECT
	PUSHL	R0
	PUSHAB	LCON
	CALLS	#2,SHOW
9$:	RET
; OPN(name, quiet): $OPEN, what $DISPLAY says of each key and area, and $CONNECT.
	.ENTRY	OPN,^M<R2,R3>
	CALLS	#0,RST
	PUSHL	4(AP)
	CALLS	#1,NAMEF
	MOVAB	OSUM,FB+FAB$L_XAB
	PUSHAB	FB
	CALLS	#1,G^SYS$OPEN
	PUSHL	R0
	PUSHAB	LOPN
	CALLS	#2,SHOW
	BLBS	R0,5$
	CALLS	#0,SHOWF
	RET
5$:	TSTL	8(AP)
	BEQL	6$
	BRW	50$
6$:	CALLS	#0,SHOWF
	MOVZWL	OSUM+XAB$W_PVN,-(SP)
	MOVZBL	OSUM+XAB$B_NOK,-(SP)
	MOVZBL	OSUM+XAB$B_NOA,-(SP)
	PUSHAB	MSUM
	CALLS	#4,OUT
	CLRL	R2
10$:	CMPB	R2,OSUM+XAB$B_NOK
	BGEQU	20$
	MOVB	R2,OKEY+XAB$B_REF
	MOVAB	OKEY,FB+FAB$L_XAB
	PUSHAB	FB
	CALLS	#1,G^SYS$DISPLAY
	BLBS	R0,15$
	PUSHL	R0
	PUSHAB	LDSP
	CALLS	#2,SHOW
15$:	CALLS	#0,SHOWK
	INCL	R2
	BRB	10$
20$:	CLRL	R2
30$:	CMPB	R2,OSUM+XAB$B_NOA
	BGEQU	50$
	MOVB	R2,OALL+XAB$B_AID
	MOVAB	OALL,FB+FAB$L_XAB
	PUSHAB	FB
	CALLS	#1,G^SYS$DISPLAY
	BLBS	R0,35$
	PUSHL	R0
	PUSHAB	LDSP
	CALLS	#2,SHOW
35$:	CALLS	#0,SHOWA
	INCL	R2
	BRB	30$
50$:	CLRL	FB+FAB$L_XAB
	PUSHAB	RB
	CALLS	#1,G^SYS$CONNECT
	PUSHL	R0
	PUSHAB	LCON
	CALLS	#2,SHOW
	RET
; OPN2(name): the second stream, on a FAB of its own.
	.ENTRY	OPN2,^M<>
	MOVL	4(AP),R0
	MOVB	(R0),FB2+FAB$B_FNS
	MOVL	4(R0),FB2+FAB$L_FNA
	PUSHAB	FB2
	CALLS	#1,G^SYS$OPEN
	PUSHL	R0
	PUSHAB	LOPN
	CALLS	#2,SHOW
	PUSHAB	RB2
	CALLS	#1,G^SYS$CONNECT
	PUSHL	R0
	PUSHAB	LCON
	CALLS	#2,SHOW
	RET
	.ENTRY	CUR1,^M<>
	MOVAB	RB,CURR
	RET
	.ENTRY	CUR2,^M<>
	MOVAB	RB2,CURR
	RET
	.ENTRY	CLO,^M<>
	CLRL	FB+FAB$L_XAB
	PUSHAB	FB
	CALLS	#1,G^SYS$CLOSE
	PUSHL	R0
	PUSHAB	LCLO
	CALLS	#2,SHOW
	RET
; CLEAN closes whatever a case left open, and puts the shared values back.
	.ENTRY	CLEAN,^M<>
	CLRL	FB+FAB$L_XAB
	TSTW	FB+FAB$W_IFI
	BEQL	10$
	PUSHAB	FB
	CALLS	#1,G^SYS$CLOSE
10$:	TSTW	FB2+FAB$W_IFI
	BEQL	20$
	PUSHAB	FB2
	CALLS	#1,G^SYS$CLOSE
20$:	TSTW	FB3+FAB$W_IFI
	BEQL	30$
	PUSHAB	FB3
	CALLS	#1,G^SYS$CLOSE
30$:	CLRB	SHRV
	CLRL	FOPV
	CLRL	ROPV
	CLRB	TMOV
	MOVW	#32000,USZV
	MOVAB	RB,CURR
	RET
; HEXL(offset): one line of BLK in hex, unless it's all zeros.
	.ENTRY	HEXL,^M<R2,R3,R4,R5>
	MOVL	4(AP),R2
	MOVAB	BLK[R2],R3
	SKPC	#0,#32,(R3)
	BEQL	90$
	MOVAB	HL,R4
	MOVB	#32,(R4)+
	MOVB	#32,(R4)+
	MOVB	#32,(R4)+
	EXTZV	#8,#4,R2,R0
	MOVB	HX[R0],(R4)+
	EXTZV	#4,#4,R2,R0
	MOVB	HX[R0],(R4)+
	EXTZV	#0,#4,R2,R0
	MOVB	HX[R0],(R4)+
	MOVB	#32,(R4)+
	MOVL	#32,R5
10$:	MOVZBL	(R3)+,R0
	EXTZV	#4,#4,R0,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#0,#4,R0,R1
	MOVB	HX[R1],(R4)+
	SOBGTR	R5,10$
	MOVAB	HL,R1
	SUBL3	R1,R4,R0
	MOVW	R0,HLD
	PUSHAB	HLD
	CALLS	#1,G^LIB$PUT_OUTPUT
90$:	RET
; DUMPF(name): every block of a closed file.
	.ENTRY	DUMPF,^M<R2,R3,R4>
	MOVL	4(AP),R0
	MOVB	(R0),FB3+FAB$B_FNS
	MOVL	4(R0),FB3+FAB$L_FNA
	PUSHAB	FB3
	CALLS	#1,G^SYS$OPEN
	BLBS	R0,10$
	PUSHL	R0
	PUSHAB	LDO
	CALLS	#2,SHOW
	RET
10$:	PUSHAB	RB3
	CALLS	#1,G^SYS$CONNECT
	MOVL	#1,R3
20$:	MOVL	R3,RB3+RAB$L_BKT
	PUSHAB	RB3
	CALLS	#1,G^SYS$READ
	BLBC	R0,40$
	PUSHL	R3
	PUSHAB	MVB
	CALLS	#2,OUT
	CLRL	R4
30$:	PUSHL	R4
	CALLS	#1,HEXL
	ACBL	#511,#32,R4,30$
	INCL	R3
	BRB	20$
40$:	PUSHL	R0
	PUSHAB	LDE
	CALLS	#2,SHOW
	PUSHAB	FB3
	CALLS	#1,G^SYS$CLOSE
	RET
; MKREC(n): the common record in BIGB, whose tail main's set.
	.ENTRY	MKREC,^M<R2,R3,R4,R5,R6>
	MOVL	4(AP),R2
	$FAO_S	CTRSTR=MP,OUTBUF=D8A,P1=R2
	MOVL	R2,BIGB+8
	MNEGL	R2,BIGB+12
	DIVL3	#3,R2,R3
	$FAO_S	CTRSTR=MA,OUTBUF=D8B,P1=R3
	SUBL3	R2,#9999999,R3
	$FAO_S	CTRSTR=MB,OUTBUF=D8C,P1=R3
	CVTLP	R2,#7,BIGB+32
	MOVL	4(AP),R2		; CVTLP used R0 to R3
	MOVL	R2,BIGB+36
	CLRL	BIGB+40
	MNEGL	R2,BIGB+44
	MOVL	#-1,BIGB+48
	TSTL	R2
	BNEQ	9$
	CLRL	BIGB+48
9$:	RET
; MKKEY(n): the same record's fields in KEYB, for a key.
	.ENTRY	MKKEY,^M<R2,R3,R4,R5>
	MOVC3	#52,BIGB,RDB
	PUSHL	4(AP)
	CALLS	#1,MKREC
	MOVC3	#52,BIGB,KEYB
	MOVC3	#52,RDB,BIGB
	RET
; PUTB(size, rop, rac): the record in BIGB.
	.ENTRY	PUTB,^M<R2>
	MOVL	CURR,R2
	MOVW	4(AP),RAB$W_RSZ(R2)
	MOVAB	BIGB,RAB$L_RBF(R2)
	MOVL	8(AP),RAB$L_ROP(R2)
	MOVB	12(AP),RAB$B_RAC(R2)
	PUSHL	R2
	CALLS	#1,G^SYS$PUT
	PUSHL	R0
	PUSHAB	LPUT
	CALLS	#2,SHOW
	CALLS	#0,SHOWR
	RET
; PUTN(n, size, rop, rac).
	.ENTRY	PUTN,^M<R2>
	PUSHL	4(AP)
	CALLS	#1,MKREC
	MOVL	CURR,R2
	MOVW	8(AP),RAB$W_RSZ(R2)
	MOVAB	BIGB,RAB$L_RBF(R2)
	MOVL	12(AP),RAB$L_ROP(R2)
	MOVB	16(AP),RAB$B_RAC(R2)
	PUSHL	R2
	CALLS	#1,G^SYS$PUT
	PUSHL	R0
	MOVZWL	8(AP),-(SP)
	PUSHL	4(AP)
	PUSHAB	MPUTN
	CALLS	#4,OUT
	CALLS	#0,SHOWR
	RET
; PUTS(first, count, step, mod, size, rac): many records; only a failure shows.
	.ENTRY	PUTS,^M<R2,R3,R4,R5,R6,R7,R8>
	MOVL	CURR,R2
	CLRL	R3
	CLRL	R5
	CLRL	R6
	MOVL	#1,R7
10$:	CMPL	R3,8(AP)
	BGEQ	50$
	MULL3	R3,12(AP),R4
	ADDL2	4(AP),R4
	TSTL	16(AP)
	BEQL	20$
	EMUL	#0,#0,R4,R0
	EDIV	16(AP),R0,R0,R4
	INCL	R4
20$:	PUSHL	R4
	CALLS	#1,MKREC
	MOVW	20(AP),RAB$W_RSZ(R2)
	MOVAB	BIGB,RAB$L_RBF(R2)
	MOVL	ROPV,RAB$L_ROP(R2)
	MOVB	24(AP),RAB$B_RAC(R2)
	PUSHL	R2
	CALLS	#1,G^SYS$PUT
	MOVL	R0,R7
	BLBS	R0,30$
	INCL	R6
	PUSHL	R0
	MOVZWL	20(AP),-(SP)
	PUSHL	R4
	PUSHAB	MPUTN
	CALLS	#4,OUT
	BRB	40$
30$:	INCL	R5
40$:	INCL	R3
	BRB	10$
50$:	MOVZWL	RAB$W_RFA+4(R2),-(SP)
	PUSHL	RAB$W_RFA(R2)
	PUSHL	R7
	PUSHL	R6
	PUSHL	R5
	PUSHAB	MPUTS
	CALLS	#6,OUT
	RET
; UPDB(size, rop): the record in BIGB over the current one.
	.ENTRY	UPDB,^M<R2>
	MOVL	CURR,R2
	MOVW	4(AP),RAB$W_RSZ(R2)
	MOVAB	BIGB,RAB$L_RBF(R2)
	MOVL	8(AP),RAB$L_ROP(R2)
	PUSHL	R2
	CALLS	#1,G^SYS$UPDATE
	PUSHL	R0
	PUSHAB	LUPD
	CALLS	#2,SHOW
	CALLS	#0,SHOWR
	RET
	.ENTRY	DEL,^M<R2>
	MOVL	CURR,R2
	MOVL	4(AP),RAB$L_ROP(R2)
	PUSHL	R2
	CALLS	#1,G^SYS$DELETE
	PUSHL	R0
	PUSHAB	LDEL
	CALLS	#2,SHOW
	CALLS	#0,SHOWR
	RET
; GETK(svc, krf, key address, ksz, rop, rac): 0 $GET, 1 $FIND; RAC 0 SEQ, 1 KEY, 2 RFA.
	.ENTRY	GETK,^M<R2>
	MOVL	CURR,R2
	MOVB	8(AP),RAB$B_KRF(R2)
	MOVL	12(AP),RAB$L_KBF(R2)
	MOVB	16(AP),RAB$B_KSZ(R2)
	MOVL	20(AP),RAB$L_ROP(R2)
	MOVB	24(AP),RAB$B_RAC(R2)
	MOVB	TMOV,RAB$B_TMO(R2)
	TSTL	4(AP)
	BNEQ	20$
	MOVW	USZV,RAB$W_USZ(R2)
	MOVAB	RDB,RAB$L_UBF(R2)
	PUSHL	R2
	CALLS	#1,G^SYS$GET
	PUSHL	R0
	PUSHAB	LGET
	CALLS	#2,SHOW
	BLBC	R0,10$
	CALLS	#0,SHOWG
	RET
10$:	CALLS	#0,SHOWR
	RET
20$:	PUSHL	R2
	CALLS	#1,G^SYS$FIND
	PUSHL	R0
	PUSHAB	LFND
	CALLS	#2,SHOW
	CALLS	#0,SHOWR
	RET
; WALK(krf, most): every record, in the stream's order, with its RFA.
	.ENTRY	WALK,^M<R2,R3,R4>
	MOVL	CURR,R2
	MOVB	4(AP),RAB$B_KRF(R2)
	PUSHL	R2
	CALLS	#1,G^SYS$REWIND
	CLRL	R3
	MOVL	#1,R4
10$:	CMPL	R3,8(AP)
	BGEQ	50$
	CLRL	RAB$L_ROP(R2)
	MOVB	#RAB$C_SEQ,RAB$B_RAC(R2)
	MOVW	USZV,RAB$W_USZ(R2)
	MOVAB	RDB,RAB$L_UBF(R2)
	PUSHL	R2
	CALLS	#1,G^SYS$GET
	MOVL	R0,R4
	BLBC	R0,50$
	INCL	R3
	MOVZWL	RAB$W_RSZ(R2),-(SP)
	MOVZWL	RAB$W_RFA+4(R2),-(SP)
	PUSHL	RAB$W_RFA(R2)
	PUSHAB	RDB
	PUSHL	#8
	PUSHAB	MWREC
	CALLS	#6,OUT
	BRB	10$
50$:	PUSHL	R4
	PUSHL	R3
	MOVZBL	4(AP),-(SP)
	PUSHAB	MWALK
	CALLS	#4,OUT
	RET
; SAVER(slot) keeps the stream's RFA, SETR(slot) puts it back for an RFA access.
	.ENTRY	SAVER,^M<R2>
	MOVL	CURR,R2
	MULL3	#6,4(AP),R0
	MOVAB	RFAT,R1
	ADDL2	R0,R1
	MOVL	RAB$W_RFA(R2),(R1)
	MOVW	RAB$W_RFA+4(R2),4(R1)
	RET
	.ENTRY	SETR,^M<R2>
	MOVL	CURR,R2
	MULL3	#6,4(AP),R0
	MOVAB	RFAT,R1
	ADDL2	R0,R1
	MOVL	(R1),RAB$W_RFA(R2)
	MOVW	4(R1),RAB$W_RFA+4(R2)
	RET
	.ENTRY	REW,^M<R2>
	MOVL	CURR,R2
	MOVB	4(AP),RAB$B_KRF(R2)
	PUSHL	R2
	CALLS	#1,G^SYS$REWIND
	PUSHL	R0
	PUSHAB	LREW
	CALLS	#2,SHOW
	CALLS	#0,SHOWR
	RET
; CON(krf, rop): the stream disconnected and connected again.
	.ENTRY	CON,^M<R2>
	MOVL	CURR,R2
	PUSHL	R2
	CALLS	#1,G^SYS$DISCONNECT
	PUSHL	R0
	PUSHAB	LDIS
	CALLS	#2,SHOW
	MOVB	4(AP),RAB$B_KRF(R2)
	MOVL	8(AP),RAB$L_ROP(R2)
	PUSHL	R2
	CALLS	#1,G^SYS$CONNECT
	PUSHL	R0
	PUSHAB	LCON
	CALLS	#2,SHOW
	RET
	.ENTRY	FRE,^M<R2>
	MOVL	CURR,R2
	PUSHL	R2
	CALLS	#1,G^SYS$FREE
	PUSHL	R0
	PUSHAB	LFRE
	CALLS	#2,SHOW
	RET
	.ENTRY	RLS,^M<R2>
	MOVL	CURR,R2
	PUSHL	R2
	CALLS	#1,G^SYS$RELEASE
	PUSHL	R0
	PUSHAB	LRLS
	CALLS	#2,SHOW
	RET
	.ENTRY	TRU,^M<R2>
	MOVL	CURR,R2
	PUSHL	R2
	CALLS	#1,G^SYS$TRUNCATE
	PUSHL	R0
	PUSHAB	LTRU
	CALLS	#2,SHOW
	RET
; SEQW(n, size): a $PUT in sequence at the stream's place.
	.ENTRY	SEQW,^M<>
	CLRL	-(SP)
	CLRL	-(SP)
	PUSHL	8(AP)
	PUSHL	4(AP)
	CALLS	#4,PUTN
	RET
	.ENTRY	C0,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
	MOVB	#FAB$C_SEQ,ORGV
	MOVB	#FAB$C_VAR,RFMV
	MOVB	#FAB$M_CR,RATV
	MOVW	#120,MRSV
	MOVB	#0,BKSV
	MOVL	#0,ALQV
	MOVW	#0,DEQV
	CLRL	XABV
	PUSHAB	T2
	CALLS	#1,L^CRE
	PUSHL	#0
	PUSHL	#0
	PUSHL	#80
	PUSHL	#1
	CALLS	#4,L^PUTN
	PUSHL	#0
	PUSHL	#100
	PUSHL	#0
	PUSHL	#1
	PUSHL	#5
	PUSHL	#2
	CALLS	#6,L^PUTS
	CALLS	#0,L^CLO
	PUSHL	#0
	PUSHAB	T2
	CALLS	#2,L^OPN
	PUSHL	#0
	PUSHL	#0
	PUSHL	#0
	PUSHL	#0
	PUSHL	#0
	PUSHL	#0
	CALLS	#6,L^GETK
	PUSHL	#0
	CALLS	#1,L^SAVER
	PUSHL	#0
	PUSHL	#0
	PUSHL	#0
	PUSHL	#0
	PUSHL	#0
	PUSHL	#0
	CALLS	#6,L^GETK
	PUSHL	#0
	CALLS	#1,L^SETR
	PUSHL	#2
	PUSHL	#0
	PUSHL	#0
	PUSHL	#0
	PUSHL	#0
	PUSHL	#0
	CALLS	#6,L^GETK
	CALLS	#0,L^CLO
	PUSHAB	T2
	CALLS	#1,L^DUMPF
	RET
	.ENTRY	C1,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
	MOVB	#FAB$C_IDX,ORGV
	MOVB	#FAB$C_VAR,RFMV
	MOVB	#FAB$M_CR,RATV
	MOVW	#120,MRSV
	MOVB	#0,BKSV
	MOVL	#0,ALQV
	MOVW	#0,DEQV
	MOVAB	X1,XABV
	PUSHAB	T5
	CALLS	#1,L^CRE
	PUSHL	#0
	PUSHL	#0
	PUSHL	#100
	PUSHL	#5
	CALLS	#4,L^PUTN
	PUSHL	#0
	PUSHL	#0
	PUSHL	#100
	PUSHL	#1
	CALLS	#4,L^PUTN
	PUSHL	#0
	PUSHL	#0
	PUSHL	#100
	PUSHL	#3
	CALLS	#4,L^PUTN
	PUSHL	#0
	PUSHL	#0
	PUSHL	#100
	PUSHL	#2
	CALLS	#4,L^PUTN
	PUSHL	#0
	PUSHL	#0
	PUSHL	#100
	PUSHL	#4
	CALLS	#4,L^PUTN
	CALLS	#0,L^CLO
	PUSHL	#0
	PUSHAB	T5
	CALLS	#2,L^OPN
	PUSHL	#0
	PUSHL	#0
	PUSHL	#0
	PUSHL	#0
	PUSHL	#0
	PUSHL	#0
	CALLS	#6,L^GETK
	CALLS	#0,L^CLO
	PUSHAB	T5
	CALLS	#1,L^DUMPF
	RET
	.ENTRY	C2,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
	MOVB	#FAB$C_IDX,ORGV
	MOVB	#FAB$C_VAR,RFMV
	MOVB	#FAB$M_CR,RATV
	MOVW	#120,MRSV
	MOVB	#0,BKSV
	MOVL	#0,ALQV
	MOVW	#0,DEQV
	MOVAB	X2,XABV
	PUSHAB	T7
	CALLS	#1,L^CRE
	CALLS	#0,L^CLO
	PUSHL	#0
	PUSHAB	T7
	CALLS	#2,L^OPN
	PUSHL	#0
	PUSHL	#0
	PUSHL	#0
	PUSHL	#0
	PUSHL	#0
	PUSHL	#0
	CALLS	#6,L^GETK
	CALLS	#0,L^CLO
	PUSHAB	T7
	CALLS	#1,L^DUMPF
	RET
	.ENTRY	C3,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
	MOVB	#FAB$C_IDX,ORGV
	MOVB	#FAB$C_VAR,RFMV
	MOVB	#FAB$M_CR,RATV
	MOVW	#120,MRSV
	MOVB	#0,BKSV
	MOVL	#0,ALQV
	MOVW	#0,DEQV
	MOVAB	X3,XABV
	PUSHAB	T9
	CALLS	#1,L^CRE
	PUSHL	#0
	PUSHL	#0
	PUSHL	#100
	PUSHL	#5
	CALLS	#4,L^PUTN
	PUSHL	#0
	PUSHL	#0
	PUSHL	#100
	PUSHL	#1
	CALLS	#4,L^PUTN
	PUSHL	#0
	PUSHL	#0
	PUSHL	#100
	PUSHL	#3
	CALLS	#4,L^PUTN
	PUSHL	#0
	PUSHL	#0
	PUSHL	#100
	PUSHL	#2
	CALLS	#4,L^PUTN
	PUSHL	#0
	PUSHL	#0
	PUSHL	#100
	PUSHL	#4
	CALLS	#4,L^PUTN
	CALLS	#0,L^CLO
	PUSHL	#0
	PUSHAB	T9
	CALLS	#2,L^OPN
	PUSHL	#0
	PUSHL	#0
	PUSHL	#0
	PUSHL	#0
	PUSHL	#0
	PUSHL	#0
	CALLS	#6,L^GETK
	CALLS	#0,L^CLO
	PUSHAB	T9
	CALLS	#1,L^DUMPF
	RET
	.ENTRY	C4,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
	MOVB	#FAB$C_IDX,ORGV
	MOVB	#FAB$C_VAR,RFMV
	MOVB	#FAB$M_CR,RATV
	MOVW	#120,MRSV
	MOVB	#0,BKSV
	MOVL	#0,ALQV
	MOVW	#0,DEQV
	MOVAB	X4,XABV
	PUSHAB	T11
	CALLS	#1,L^CRE
