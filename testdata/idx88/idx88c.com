$ ! IDX88C.COM - Phase 88's round 3: the utilities (subtask 10;
$ ! docs/PHASE-88 - keyed index files.md). Run it with the exchange volume's
$ ! [000000] as the default directory:
$ !
$ !     @IDX88C/OUTPUT=IDX88C.LOG
$ !
$ ! The Record Management Utilities manual describes CREATE/FDL, CONVERT,
$ ! ANALYZE/RMS_FILE, and FDL. This round is what it leaves to their
$ ! behavior: their messages and statuses, the files they make, CONVERT's
$ ! exceptions and statistics, and ANALYZE's reports on files of every
$ ! organization and on damaged ones. Its inputs are round 1's files, restored
$ ! from IDX88.BCK into [IN] by EXCHANGEC.CMD; everything it makes is in [R3], saved at the end
$ ! as IDX88C.BCK. Sections C0 to C13; each command's $STATUS is shown.
$ ! Nothing reads the terminal.
$ SET NOON
$ SET VERIFY
$ !
$ ! C0: the inputs (restored into [IN] when the volume was made), the work
$ ! directory, and IDX88P (which adds a number to a byte of a file, for C12).
$ M = "C0"
$ SHOW SYMBOL M
$ WRITE SYS$OUTPUT F$GETSYI("VERSION"), " ", F$GETSYI("HW_NAME")
$ CREATE/DIRECTORY [R3]
$ DIRECTORY/SIZE/TOTAL [IN]
$ ! MACRO's own output goes to a log of its own, which stays on the volume
$ ! until the author has read it, as round 1's did.
$ DEFINE/USER_MODE SYS$OUTPUT IDX88CM.LOG
$ DEFINE/USER_MODE SYS$ERROR NL:
$ MACRO/NOLIST IDX88P
$ LINK/NOMAP IDX88P
$ SHOW SYMBOL $STATUS
$ PATCH := $'F$PARSE("IDX88P.EXE")'
$ !
$ ! C1: the facilities' messages, from HELP/MESSAGE, each to a file of its own
$ ! (DIGITAL's text: these stay local, never in the repository). A facility
$ ! name HELP/MESSAGE doesn't know only costs its file.
$ M = "C1"
$ SHOW SYMBOL M
$ HELP/MESSAGE/FACILITY=CONVERT/OUTPUT=MSGCONV.TXT
$ SHOW SYMBOL $STATUS
$ HELP/MESSAGE/FACILITY=CONV/OUTPUT=MSGCONV2.TXT
$ SHOW SYMBOL $STATUS
$ HELP/MESSAGE/FACILITY=FDL/OUTPUT=MSGFDL.TXT
$ SHOW SYMBOL $STATUS
$ HELP/MESSAGE/FACILITY=CREATEFDL/OUTPUT=MSGCRFDL.TXT
$ SHOW SYMBOL $STATUS
$ HELP/MESSAGE/FACILITY=ANLRMS/OUTPUT=MSGANL.TXT
$ SHOW SYMBOL $STATUS
$ HELP/MESSAGE/FACILITY=ANALYZE/OUTPUT=MSGANL2.TXT
$ SHOW SYMBOL $STATUS
$ DIRECTORY/SIZE MSG*.TXT
$ SET DEFAULT [R3]
$ !
$ ! C2: CREATE/FDL, sequential and relative files. Each FDL file is written
$ ! here; each file made is shown by DIRECTORY/FULL and ANALYZE/RMS_FILE/FDL
$ ! (the subroutine SHOW, at the end).
$ M = "C2"
$ SHOW SYMBOL M
$ ! C2.1: the least there is.
$ CREATE C21.FDL
FILE
    ORGANIZATION sequential
$ CREATE/FDL=C21 C21.DAT
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C21.DAT
$ ! C2.2: an empty FDL file.
$ CREATE C22.FDL
$ CREATE/FDL=C22 C22.DAT
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C22.DAT
$ ! C2.3: fixed records, FORTRAN carriage control, /LOG.
$ CREATE C23.FDL
FILE
    ORGANIZATION sequential
RECORD
    CARRIAGE_CONTROL fortran
    FORMAT fixed
    SIZE 80
$ CREATE/FDL=C23/LOG C23.DAT
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C23.DAT
$ ! C2.4: VFC records.
$ CREATE C24.FDL
FILE
    ORGANIZATION sequential
RECORD
    CARRIAGE_CONTROL print
    CONTROL_FIELD_SIZE 2
    FORMAT vfc
    SIZE 100
$ CREATE/FDL=C24 C24.DAT
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C24.DAT
$ ! C2.5 to C2.8: the stream formats and undefined.
$ CREATE C25.FDL
FILE; ORGANIZATION sequential
RECORD; FORMAT stream
$ CREATE/FDL=C25 C25.DAT
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C25.DAT
$ CREATE C26.FDL
FILE; ORGANIZATION sequential
RECORD; FORMAT stream_lf; CARRIAGE_CONTROL carriage_return
$ CREATE/FDL=C26 C26.DAT
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C26.DAT
$ CREATE C27.FDL
FILE; ORGANIZATION sequential
RECORD; FORMAT stream_cr
$ CREATE/FDL=C27 C27.DAT
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C27.DAT
$ CREATE C28.FDL
FILE; ORGANIZATION sequential
RECORD; FORMAT undefined; CARRIAGE_CONTROL none
$ CREATE/FDL=C28 C28.DAT
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C28.DAT
$ ! C2.9: allocation, extension, contiguity, no block spanning.
$ CREATE C29.FDL
FILE
    ALLOCATION 100
    CONTIGUOUS yes
    EXTENSION 10
    ORGANIZATION sequential
RECORD
    BLOCK_SPAN no
    FORMAT variable
    SIZE 500
$ CREATE/FDL=C29 C29.DAT
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C29.DAT
$ CREATE C2A.FDL
FILE
    ALLOCATION 20
    BEST_TRY_CONTIGUOUS yes
    ORGANIZATION sequential
$ CREATE/FDL=C2A C2A.DAT
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C2A.DAT
$ ! C2.B: FILE NAME and DEFAULT_NAME: no file named, a name without a type,
$ ! and a whole name, which wins.
$ CREATE C2B.FDL
FILE
    DEFAULT_NAME ".XYZ"
    NAME "C2BNAME.DAT"
    ORGANIZATION sequential
$ CREATE/FDL=C2B/LOG
$ SHOW SYMBOL $STATUS
$ CREATE/FDL=C2B/LOG C2BOTHER
$ SHOW SYMBOL $STATUS
$ CREATE/FDL=C2B/LOG C2BWHOLE.ABC
$ SHOW SYMBOL $STATUS
$ DIRECTORY C2B*.*
$ ! C2.C: no FILE NAME and no file named.
$ CREATE/FDL=C21/LOG
$ SHOW SYMBOL $STATUS
$ ! C2.D: an existing file: a new version.
$ CREATE/FDL=C21/LOG C21.DAT
$ SHOW SYMBOL $STATUS
$ DIRECTORY C21.DAT;*
$ ! C2.E: protection, owner, the dates, TITLE, IDENT, SYSTEM.
$ CREATE C2E.FDL
TITLE "Round 3's dates and protection"
IDENT "an identification of our own"
SYSTEM
    SOURCE VAX/VMS
FILE
    ORGANIZATION sequential
    OWNER [200,201]
    PROTECTION (system:RWED, owner:RWE, group:R, world:)
DATE
    EXPIRATION "1-JAN-2030 00:00:00.00"
    CREATION "2-FEB-2020 12:34:56.78"
$ CREATE/FDL=C2E C2E.DAT
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C2E.DAT
$ ! C2.F: case, abbreviations, comments, blank lines, tabs, and switches as
$ ! T, F, true, 1.
$ CREATE C2F.FDL
! a comment line
fi
	org	SEQ	! a comment after a value

  alloc 6 ; exte 3 ! two attributes and a comment
	contig F
rec;form FIX;si 12
  bl T
$ CREATE/FDL=C2F C2F.DAT
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C2F.DAT
$ CREATE C2G.FDL
FILE; ORGANIZATION sequential; CONTIGUOUS true
RECORD; BLOCK_SPAN 1
$ CREATE/FDL=C2G C2G.DAT
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C2G.DAT
$ ! C2.H: relative files.
$ CREATE C2H.FDL
FILE
    BUCKET_SIZE 3
    MAX_RECORD_NUMBER 500
    ORGANIZATION relative
RECORD
    FORMAT fixed
    SIZE 50
$ CREATE/FDL=C2H C2H.DAT
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C2H.DAT
$ CREATE C2I.FDL
FILE; ORGANIZATION relative
RECORD; FORMAT variable; SIZE 200
$ CREATE/FDL=C2I C2I.DAT
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C2I.DAT
$ ! C2.J: run-time sections, which CREATE/FDL is to pass over.
$ CREATE C2J.FDL
FILE; ORGANIZATION sequential
RECORD; FORMAT variable; SIZE 80
ACCESS; GET yes; PUT yes; UPDATE yes
SHARING; GET yes; PUT yes
CONNECT; MULTIBUFFER_COUNT 4; WRITE_BEHIND yes
$ CREATE/FDL=C2J C2J.DAT
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C2J.DAT
$ !
$ ! C3: CREATE/FDL, indexed files.
$ M = "C3"
$ SHOW SYMBOL M
$ ! C3.1: one key, the attributes given.
$ CREATE C31.FDL
FILE
    ORGANIZATION indexed
RECORD
    FORMAT variable
    SIZE 100
KEY 0
    SEG0_LENGTH 8
    SEG0_POSITION 0
    TYPE string
$ CREATE/FDL=C31 C31.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C31.IDX
$ ! C3.2: one key, its length alone.
$ CREATE C32.FDL
FILE; ORGANIZATION indexed
KEY 0; SEG0_LENGTH 6
$ CREATE/FDL=C32 C32.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C32.IDX
$ ! C3.3: LENGTH and POSITION, the manual's names for an unsegmented key.
$ CREATE C33.FDL
FILE; ORGANIZATION indexed
RECORD; SIZE 60
KEY 0; LENGTH 10; POSITION 4; TYPE string; NAME "BY_NAME"
$ CREATE/FDL=C33 C33.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C33.IDX
$ ! C3.4: indexed with no KEY section.
$ CREATE C34.FDL
FILE; ORGANIZATION indexed
RECORD; SIZE 60
$ CREATE/FDL=C34 C34.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C34.IDX
$ ! C3.5: every type but collated, a key each.
$ CREATE C35.FDL
FILE; ORGANIZATION indexed
RECORD; FORMAT fixed; SIZE 200
KEY 0; SEG0_LENGTH 8; SEG0_POSITION 0; TYPE string
KEY 1; SEG0_LENGTH 2; SEG0_POSITION 10; TYPE bin2; DUPLICATES yes
KEY 2; SEG0_LENGTH 4; SEG0_POSITION 12; TYPE bin4; DUPLICATES yes
KEY 3; SEG0_LENGTH 8; SEG0_POSITION 16; TYPE bin8; DUPLICATES yes
KEY 4; SEG0_LENGTH 2; SEG0_POSITION 24; TYPE int2; DUPLICATES yes
KEY 5; SEG0_LENGTH 4; SEG0_POSITION 26; TYPE int4; DUPLICATES yes
KEY 6; SEG0_LENGTH 8; SEG0_POSITION 30; TYPE int8; DUPLICATES yes
KEY 7; SEG0_LENGTH 5; SEG0_POSITION 38; TYPE decimal; DUPLICATES yes
KEY 8; SEG0_LENGTH 8; SEG0_POSITION 44; TYPE dstring; DUPLICATES yes
KEY 9; SEG0_LENGTH 2; SEG0_POSITION 52; TYPE dbin2; DUPLICATES yes
KEY 10; SEG0_LENGTH 4; SEG0_POSITION 54; TYPE dbin4; DUPLICATES yes
KEY 11; SEG0_LENGTH 8; SEG0_POSITION 58; TYPE dbin8; DUPLICATES yes
KEY 12; SEG0_LENGTH 2; SEG0_POSITION 66; TYPE dint2; DUPLICATES yes
KEY 13; SEG0_LENGTH 4; SEG0_POSITION 68; TYPE dint4; DUPLICATES yes
KEY 14; SEG0_LENGTH 8; SEG0_POSITION 72; TYPE dint8; DUPLICATES yes
KEY 15; SEG0_LENGTH 5; SEG0_POSITION 80; TYPE ddecimal; DUPLICATES yes
$ CREATE/FDL=C35 C35.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C35.IDX
$ ! C3.6: segments, flags, null values, names.
$ CREATE C36.FDL
FILE; ORGANIZATION indexed
RECORD; FORMAT variable; SIZE 120
KEY 0
    NAME "PART"
    SEG0_LENGTH 4
    SEG0_POSITION 10
    SEG1_LENGTH 3
    SEG1_POSITION 0
    SEG2_LENGTH 2
    SEG2_POSITION 20
    TYPE string
KEY 1
    CHANGES yes
    DUPLICATES yes
    NAME "OWNER"
    NULL_KEY yes
    NULL_VALUE " "
    SEG0_LENGTH 8
    SEG0_POSITION 30
KEY 2
    CHANGES no
    DUPLICATES no
    NULL_KEY yes
    NULL_VALUE 0
    SEG0_LENGTH 4
    SEG0_POSITION 40
    TYPE bin4
$ CREATE/FDL=C36 C36.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C36.IDX
$ ! C3.7: compression off, fills, and a file bucket size.
$ CREATE C37.FDL
FILE; ORGANIZATION indexed; BUCKET_SIZE 4
RECORD; SIZE 300
KEY 0
    DATA_FILL 50
    DATA_KEY_COMPRESSION no
    DATA_RECORD_COMPRESSION no
    INDEX_COMPRESSION no
    INDEX_FILL 75
    SEG0_LENGTH 12
KEY 1
    DATA_FILL 80
    DATA_KEY_COMPRESSION no
    DUPLICATES yes
    SEG0_LENGTH 6
    SEG0_POSITION 20
$ CREATE/FDL=C37 C37.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C37.IDX
$ ! C3.8: three areas, each key's levels placed in them.
$ CREATE C38.FDL
FILE; ORGANIZATION indexed
RECORD; SIZE 120
AREA 0
    ALLOCATION 30
    BUCKET_SIZE 3
    EXTENSION 6
AREA 1
    ALLOCATION 9
    BUCKET_SIZE 1
    EXTENSION 3
AREA 2
    ALLOCATION 12
    BEST_TRY_CONTIGUOUS yes
    BUCKET_SIZE 2
    EXTENSION 4
KEY 0
    DATA_AREA 0
    INDEX_AREA 1
    LEVEL1_INDEX_AREA 1
    SEG0_LENGTH 8
KEY 1
    DATA_AREA 2
    DUPLICATES yes
    INDEX_AREA 2
    LEVEL1_INDEX_AREA 2
    SEG0_LENGTH 8
    SEG0_POSITION 16
$ CREATE/FDL=C38 C38.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C38.IDX
$ ! C3.9: prolog levels: 3, 2, and 1 asked for.
$ CREATE C39.FDL
FILE; ORGANIZATION indexed
RECORD; SIZE 80
KEY 0; PROLOG 3; SEG0_LENGTH 8
$ CREATE/FDL=C39 C39.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C39.IDX
$ CREATE C3A.FDL
FILE; ORGANIZATION indexed
RECORD; SIZE 80
KEY 0; PROLOG 2; SEG0_LENGTH 8
$ CREATE/FDL=C3A C3A.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C3A.IDX
$ CREATE C3B.FDL
FILE; ORGANIZATION indexed
RECORD; SIZE 80
KEY 0; PROLOG 1; SEG0_LENGTH 8
$ CREATE/FDL=C3B C3B.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C3B.IDX
$ ! C3.C: an overlapping primary key, with no PROLOG.
$ CREATE C3C.FDL
FILE; ORGANIZATION indexed
RECORD; SIZE 80
KEY 0; SEG0_LENGTH 6; SEG0_POSITION 0; SEG1_LENGTH 6; SEG1_POSITION 3
$ CREATE/FDL=C3C C3C.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C3C.IDX
$ ! C3.D: KEY 1 written before KEY 0, and keys 0 and 2 alone.
$ CREATE C3D.FDL
FILE; ORGANIZATION indexed
RECORD; SIZE 80
KEY 1; SEG0_LENGTH 4; SEG0_POSITION 10; DUPLICATES yes
KEY 0; SEG0_LENGTH 8
$ CREATE/FDL=C3D C3D.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C3D.IDX
$ CREATE C3E.FDL
FILE; ORGANIZATION indexed
RECORD; SIZE 80
KEY 0; SEG0_LENGTH 8
KEY 2; SEG0_LENGTH 4; SEG0_POSITION 10; DUPLICATES yes
$ CREATE/FDL=C3E C3E.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C3E.IDX
$ ! C3.F: refusals RMS makes: CHANGES on a primary key, a key past the
$ ! record's size, an area no AREA section defines, a fill past the bucket.
$ CREATE C3F.FDL
FILE; ORGANIZATION indexed
KEY 0; CHANGES yes; DUPLICATES yes; SEG0_LENGTH 8
$ CREATE/FDL=C3F C3F.IDX
$ SHOW SYMBOL $STATUS
$ DIRECTORY C3F.IDX
$ CREATE C3G.FDL
FILE; ORGANIZATION indexed
RECORD; FORMAT fixed; SIZE 20
KEY 0; SEG0_LENGTH 8; SEG0_POSITION 16
$ CREATE/FDL=C3G C3G.IDX
$ SHOW SYMBOL $STATUS
$ DIRECTORY C3G.IDX
$ CREATE C3H.FDL
FILE; ORGANIZATION indexed
AREA 0; ALLOCATION 9; BUCKET_SIZE 2
KEY 0; SEG0_LENGTH 8; DATA_AREA 0; INDEX_AREA 3
$ CREATE/FDL=C3H C3H.IDX
$ SHOW SYMBOL $STATUS
$ DIRECTORY C3H.IDX
$ CREATE C3I.FDL
FILE; ORGANIZATION indexed; BUCKET_SIZE 1
KEY 0; SEG0_LENGTH 8; DATA_FILL 600
$ CREATE/FDL=C3I C3I.IDX
$ SHOW SYMBOL $STATUS
$ DIRECTORY C3I.IDX
$ !
$ ! C4: FDL's own refusals, one fault a file. Each CREATE/FDL's message,
$ ! status, and whether it left a file.
$ M = "C4"
$ SHOW SYMBOL M
$ ! C4.1: an unknown primary.
$ CREATE C41.FDL
FIEL
    ORGANIZATION sequential
$ CREATE/FDL=C41 C41.DAT
$ SHOW SYMBOL $STATUS
$ DIRECTORY C41.DAT
$ ! C4.2: an unknown secondary.
$ CREATE C42.FDL
FILE
    ORGANISATION sequential
$ CREATE/FDL=C42 C42.DAT
$ SHOW SYMBOL $STATUS
$ DIRECTORY C42.DAT
$ ! C4.3: an unknown keyword value.
$ CREATE C43.FDL
FILE
    ORGANIZATION squential
$ CREATE/FDL=C43 C43.DAT
$ SHOW SYMBOL $STATUS
$ DIRECTORY C43.DAT
$ ! C4.4: a number out of range.
$ CREATE C44.FDL
FILE
    BUCKET_SIZE 64
    ORGANIZATION relative
$ CREATE/FDL=C44 C44.DAT
$ SHOW SYMBOL $STATUS
$ DIRECTORY C44.DAT
$ ! C4.5: a secondary before any primary.
$ CREATE C45.FDL
    ORGANIZATION sequential
FILE
$ CREATE/FDL=C45 C45.DAT
$ SHOW SYMBOL $STATUS
$ DIRECTORY C45.DAT
$ ! C4.6: a secondary twice.
$ CREATE C46.FDL
FILE
    ORGANIZATION sequential
    ALLOCATION 5
    ALLOCATION 7
$ CREATE/FDL=C46 C46.DAT
$ SHOW SYMBOL $STATUS
$ DIRECTORY C46.DAT
$ ! C4.7: a primary twice.
$ CREATE C47.FDL
FILE
    ORGANIZATION sequential
FILE
    ALLOCATION 5
$ CREATE/FDL=C47 C47.DAT
$ SHOW SYMBOL $STATUS
$ DIRECTORY C47.DAT
$ ! C4.8: primaries out of order (RECORD before FILE).
$ CREATE C48.FDL
RECORD
    SIZE 80
FILE
    ORGANIZATION sequential
$ CREATE/FDL=C48 C48.DAT
$ SHOW SYMBOL $STATUS
$ DIRECTORY C48.DAT
$ ! C4.9: a value missing.
$ CREATE C49.FDL
FILE
    ORGANIZATION sequential
    ALLOCATION
$ CREATE/FDL=C49 C49.DAT
$ SHOW SYMBOL $STATUS
$ DIRECTORY C49.DAT
$ ! C4.A: an ambiguous abbreviation (CONTIGUOUS, CONTEXT).
$ CREATE C4A.FDL
FILE
    ORGANIZATION sequential
    CONT yes
$ CREATE/FDL=C4A C4A.DAT
$ SHOW SYMBOL $STATUS
$ DIRECTORY C4A.DAT
$ ! C4.B: a string with no closing quotation mark.
$ CREATE C4B.FDL
FILE
    NAME "C4BNAME.DAT
    ORGANIZATION sequential
$ CREATE/FDL=C4B C4B.DAT
$ SHOW SYMBOL $STATUS
$ DIRECTORY C4B*.DAT
$ ! C4.C: a switch that isn't one.
$ CREATE C4C.FDL
FILE
    CONTIGUOUS maybe
    ORGANIZATION sequential
$ CREATE/FDL=C4C C4C.DAT
$ SHOW SYMBOL $STATUS
$ DIRECTORY C4C.DAT
$ ! C4.D: KEY with no number, and with 300.
$ CREATE C4D.FDL
FILE; ORGANIZATION indexed
KEY; SEG0_LENGTH 8
$ CREATE/FDL=C4D C4D.IDX
$ SHOW SYMBOL $STATUS
$ DIRECTORY C4D.IDX
$ CREATE C4E.FDL
FILE; ORGANIZATION indexed
KEY 300; SEG0_LENGTH 8
$ CREATE/FDL=C4E C4E.IDX
$ SHOW SYMBOL $STATUS
$ DIRECTORY C4E.IDX
$ ! C4.F: SEG1 with no SEG0.
$ CREATE C4F.FDL
FILE; ORGANIZATION indexed
KEY 0; SEG1_LENGTH 8; SEG1_POSITION 0
$ CREATE/FDL=C4F C4F.IDX
$ SHOW SYMBOL $STATUS
$ DIRECTORY C4F.IDX
$ ! C4.G: a bad protection, and a bad date.
$ CREATE C4G.FDL
FILE
    ORGANIZATION sequential
    PROTECTION (system:RWQ)
$ CREATE/FDL=C4G C4G.DAT
$ SHOW SYMBOL $STATUS
$ DIRECTORY C4G.DAT
$ CREATE C4H.FDL
FILE
    ORGANIZATION sequential
DATE
    EXPIRATION "31-FEB-2030"
$ CREATE/FDL=C4H C4H.DAT
$ SHOW SYMBOL $STATUS
$ DIRECTORY C4H.DAT
$ ! C4.I: an FDL file that doesn't exist, and /FDL with no value.
$ CREATE/FDL=NOSUCH C4I.DAT
$ SHOW SYMBOL $STATUS
$ CREATE/FDL C4I.DAT
$ SHOW SYMBOL $STATUS
$ ! C4.J: a fault on line 6, after good lines, so the message's line is seen.
$ CREATE C4J.FDL
TITLE "line 1"
FILE
    ALLOCATION 3
    ORGANIZATION sequential
RECORD
    FORMAT variabel
    SIZE 80
$ CREATE/FDL=C4J C4J.DAT
$ SHOW SYMBOL $STATUS
$ DIRECTORY C4J.DAT
$ !
$ ! C5: CREATE/FDL from ANALYZE/RMS_FILE/FDL's files of round 1's files, with
$ ! their ANALYSIS sections: is the file made the same as the one analyzed?
$ M = "C5"
$ SHOW SYMBOL M
$ ANALYZE/RMS_FILE/FDL/OUTPUT=A35.FDL [IN]S35.IDX
$ CREATE/FDL=A35 C51.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C51.IDX
$ ANALYZE/RMS_FILE/FDL/OUTPUT=A62.FDL [IN]S62.IDX
$ CREATE/FDL=A62 C52.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C52.IDX
$ ANALYZE/RMS_FILE/FDL/OUTPUT=A122.FDL [IN]F122.IDX
$ CREATE/FDL=A122 C53.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C53.IDX
$ !
$ ! C6: CONVERT between organizations. F122.IDX is 300 records of every key
$ ! type (round 1's case 122); a file's first records are shown by HEAD.
$ M = "C6"
$ SHOW SYMBOL M
$ CREATE SEQV.FDL
FILE; ORGANIZATION sequential
RECORD; FORMAT variable; SIZE 200; CARRIAGE_CONTROL carriage_return
$ CREATE REL.FDL
FILE; ORGANIZATION relative; MAX_RECORD_NUMBER 400; BUCKET_SIZE 2
RECORD; FORMAT variable; SIZE 200
$ ! C6.1: indexed to sequential, by FDL.
$ CONVERT/FDL=SEQV [IN]F122.IDX C61.SEQ
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C61.SEQ
$ CALL HEAD C61.SEQ
$ ! C6.2: indexed to indexed with no FDL: the input's attributes.
$ CONVERT [IN]F122.IDX C62.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C62.IDX
$ ! C6.3: sequential back to indexed, by the analysis's FDL.
$ CONVERT/FDL=A122 C61.SEQ C63.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C63.IDX
$ ! C6.4: sequential to sequential with no FDL, and no output type.
$ CONVERT C61.SEQ C64
$ SHOW SYMBOL $STATUS
$ DIRECTORY C64.*
$ ! C6.5: to and from a relative file.
$ CONVERT/FDL=REL C61.SEQ C65.REL
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C65.REL
$ CONVERT/FDL=SEQV C65.REL C65.SEQ
$ SHOW SYMBOL $STATUS
$ CALL HEAD C65.SEQ
$ ! C6.6: by an alternate key (/KEY): key 1 is n, the primary's order; key 2
$ ! is -n, the other way.
$ CONVERT/FDL=SEQV/KEY=1 [IN]F122.IDX C66A.SEQ
$ SHOW SYMBOL $STATUS
$ CALL HEAD C66A.SEQ
$ CONVERT/FDL=SEQV/KEY=2 [IN]F122.IDX C66B.SEQ
$ SHOW SYMBOL $STATUS
$ CALL HEAD C66B.SEQ
$ ! C6.7: round 1's biggest file and its three areas' file, reorganized.
$ CONVERT [IN]G116.IDX C67A.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C67A.IDX
$ CONVERT [IN]S62.IDX C67B.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C67B.IDX
$ ! C6.8: a new primary key: the records sorted by it (key 2's -n).
$ CREATE K2.FDL
FILE; ORGANIZATION indexed
RECORD; FORMAT variable; SIZE 200
KEY 0; SEG0_LENGTH 4; SEG0_POSITION 12; TYPE int4
KEY 1; SEG0_LENGTH 8; SEG0_POSITION 0; TYPE string
$ CONVERT/FDL=K2 [IN]F122.IDX C68.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C68.IDX
$ CONVERT/FDL=SEQV C68.IDX C68.SEQ
$ CALL HEAD C68.SEQ
$ !
$ ! C7: loading an indexed file: fast or not, fills, sorting, exceptions,
$ ! statistics. C66B.SEQ is in reverse primary order; KT.TXT is text.
$ M = "C7"
$ SHOW SYMBOL M
$ CREATE K50.FDL
FILE; ORGANIZATION indexed
RECORD; FORMAT variable; SIZE 200
KEY 0; DATA_FILL 50; INDEX_FILL 50; SEG0_LENGTH 8
KEY 1; DATA_FILL 50; INDEX_FILL 50; SEG0_LENGTH 4; SEG0_POSITION 8; TYPE bin4; DUPLICATES yes
$ ! C7.1 to C7.6: the same records, each way.
$ CONVERT/FDL=A122 C61.SEQ C71.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C71.IDX
$ CONVERT/FDL=A122/NOFAST_LOAD C61.SEQ C72.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C72.IDX
$ CONVERT/FDL=K50 C61.SEQ C73.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C73.IDX
$ CONVERT/FDL=K50/NOFAST_LOAD C61.SEQ C74.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C74.IDX
$ CONVERT/FDL=K50/NOFAST_LOAD/FILL_BUCKETS C61.SEQ C75.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C75.IDX
$ CONVERT/FDL=K50/FILL_BUCKETS C61.SEQ C76.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C76.IDX
$ ! C7.7: input out of order: sorted, and /NOSORT.
$ CONVERT/FDL=A122/STATISTICS C66B.SEQ C77A.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C77A.IDX
$ CONVERT/FDL=K50/NOSORT/STATISTICS/EXCEPTIONS_FILE=C77B C66B.SEQ C77B.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C77B.IDX
$ DIRECTORY/FULL C77B.EXC
$ CALL HEAD C77B.EXC
$ ! C7.8: text records into an indexed file: a duplicate key, a record
$ ! shorter than the key, one longer than the file's records, out of order.
$ CREATE KT.TXT
BBB one
AAA two
AAA a duplicate
CC
DDD a record longer than the file's twenty bytes
ZZZ last
CCC three
$ CREATE KT.FDL
FILE; ORGANIZATION indexed
RECORD; FORMAT variable; SIZE 20
KEY 0; SEG0_LENGTH 3
$ CONVERT/FDL=KT KT.TXT C78A.IDX
$ SHOW SYMBOL $STATUS
$ TYPE C78A.IDX
$ CONVERT/FDL=KT/EXCEPTIONS_FILE=C78B/STATISTICS KT.TXT C78B.IDX
$ SHOW SYMBOL $STATUS
$ TYPE C78B.IDX
$ TYPE C78B.EXC
$ CONVERT/FDL=KT/NOSORT/EXCEPTIONS_FILE KT.TXT C78C.IDX
$ SHOW SYMBOL $STATUS
$ TYPE C78C.IDX
$ DIRECTORY KT.EXC,C78C.EXC
$ TYPE KT.EXC
$ CONVERT/FDL=KT/EXIT KT.TXT C78D.IDX
$ SHOW SYMBOL $STATUS
$ DIRECTORY C78D.IDX
$ TYPE C78D.IDX
$ CONVERT/FDL=KT/NOSORT/EXIT KT.TXT C78E.IDX
$ SHOW SYMBOL $STATUS
$ TYPE C78E.IDX
$ ! C7.9: two inputs, concatenated: every key twice.
$ CONVERT/FDL=KT/EXCEPTIONS_FILE=C79 KT.TXT,KT.TXT C79.IDX
$ SHOW SYMBOL $STATUS
$ TYPE C79.IDX
$ TYPE C79.EXC
$ !
$ ! C8: record formats: /PAD, /TRUNCATE, /FIXED_CONTROL, stream files.
$ M = "C8"
$ SHOW SYMBOL M
$ CREATE T.TXT
abc
abcdefghij
abcdefghijklmnopq

last line
$ CREATE FIX10.FDL
FILE; ORGANIZATION sequential
RECORD; FORMAT fixed; SIZE 10; CARRIAGE_CONTROL carriage_return
$ CONVERT/FDL=FIX10 T.TXT C81A.FIX
$ SHOW SYMBOL $STATUS
$ TYPE C81A.FIX
$ CONVERT/FDL=FIX10/PAD T.TXT C81B.FIX
$ SHOW SYMBOL $STATUS
$ DUMP/RECORD C81B.FIX
$ CONVERT/FDL=FIX10/PAD=%X2E T.TXT C81C.FIX
$ SHOW SYMBOL $STATUS
$ TYPE C81C.FIX
$ CONVERT/FDL=FIX10/PAD=X T.TXT C81D.FIX
$ SHOW SYMBOL $STATUS
$ TYPE C81D.FIX
$ CONVERT/FDL=FIX10/TRUNCATE T.TXT C81E.FIX
$ SHOW SYMBOL $STATUS
$ TYPE C81E.FIX
$ CONVERT/FDL=FIX10/TRUNCATE/PAD=%D45/EXCEPTIONS_FILE=C81F T.TXT C81F.FIX
$ SHOW SYMBOL $STATUS
$ TYPE C81F.FIX
$ DIRECTORY C81F.EXC
$ ! C8.2: fixed into variable with no FDL (the input's attributes), and
$ ! fixed into a longer fixed with /PAD.
$ CONVERT C81E.FIX C82A.FIX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C82A.FIX
$ CREATE FIX12.FDL
FILE; ORGANIZATION sequential
RECORD; FORMAT fixed; SIZE 12; CARRIAGE_CONTROL carriage_return
$ CONVERT/FDL=FIX12/PAD=%X21 C81E.FIX C82B.FIX
$ SHOW SYMBOL $STATUS
$ TYPE C82B.FIX
$ ! C8.3: VFC: DCL's OPEN/WRITE makes one.
$ OPEN/WRITE F C83.VFC
$ WRITE F "first"
$ WRITE F "second"
$ CLOSE F
$ DUMP/RECORD C83.VFC
$ CONVERT/FDL=SEQV C83.VFC C83A.TXT
$ SHOW SYMBOL $STATUS
$ DUMP/RECORD C83A.TXT
$ CONVERT/FDL=SEQV/FIXED_CONTROL C83.VFC C83B.TXT
$ SHOW SYMBOL $STATUS
$ DUMP/RECORD C83B.TXT
$ CONVERT/FDL=C24/FIXED_CONTROL T.TXT C83C.VFC
$ SHOW SYMBOL $STATUS
$ DUMP/RECORD C83C.VFC
$ CONVERT/FDL=C24 T.TXT C83D.VFC
$ SHOW SYMBOL $STATUS
$ DUMP/RECORD C83D.VFC
$ ! C8.4: stream formats and back.
$ CONVERT/FDL=C26 T.TXT C84A.SLF
$ SHOW SYMBOL $STATUS
$ DUMP/BLOCKS=(START:1,COUNT:1) C84A.SLF
$ CONVERT/FDL=C27 T.TXT C84B.SCR
$ SHOW SYMBOL $STATUS
$ DUMP/BLOCKS=(START:1,COUNT:1) C84B.SCR
$ CONVERT/FDL=C25 T.TXT C84C.STM
$ SHOW SYMBOL $STATUS
$ DUMP/BLOCKS=(START:1,COUNT:1) C84C.STM
$ CONVERT/FDL=SEQV C84A.SLF C84D.TXT
$ SHOW SYMBOL $STATUS
$ DUMP/RECORD C84D.TXT
$ CONVERT/FDL=C28 T.TXT C84E.UDF
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C84E.UDF
$ DUMP/BLOCKS=(START:1,COUNT:1) C84E.UDF
$ !
$ ! C9: CONVERT into files that exist: /NOCREATE, /APPEND, /MERGE; /PROLOG;
$ ! the qualifiers that change nothing a file holds.
$ M = "C9"
$ SHOW SYMBOL M
$ CREATE/FDL=KT C91.IDX
$ CONVERT/NOCREATE KT.TXT C91.IDX
$ SHOW SYMBOL $STATUS
$ TYPE C91.IDX
$ CALL SHOWF C91.IDX
$ CREATE KU.TXT
EEE added
AAA again
MMM middle
$ CONVERT/MERGE KU.TXT C91.IDX
$ SHOW SYMBOL $STATUS
$ TYPE C91.IDX
$ CONVERT/MERGE/EXCEPTIONS_FILE=C91 KU.TXT C91.IDX
$ SHOW SYMBOL $STATUS
$ TYPE C91.EXC
$ DIRECTORY C91.IDX;*
$ COPY T.TXT C92.TXT
$ CONVERT/APPEND KU.TXT C92.TXT
$ SHOW SYMBOL $STATUS
$ TYPE C92.TXT
$ DIRECTORY C92.TXT;*
$ CONVERT/NOCREATE KU.TXT C92.TXT
$ SHOW SYMBOL $STATUS
$ TYPE C92.TXT
$ DIRECTORY C92.TXT;*
$ CONVERT/PROLOG=2 [IN]S35.IDX C93A.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C93A.IDX
$ CONVERT/PROLOG=1 [IN]S35.IDX C93B.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C93B.IDX
$ CONVERT/PROLOG=3 C93A.IDX C93C.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C93C.IDX
$ CONVERT/READ_CHECK/WRITE_CHECK/SHARE/WORK_FILES=3/STATISTICS [IN]S35.IDX C94.IDX
$ SHOW SYMBOL $STATUS
$ CALL SHOWF C94.IDX
$ CONVERT/WORK_FILES=0 [IN]S35.IDX C95.IDX
$ SHOW SYMBOL $STATUS
$ !
$ ! C10: CONVERT's refusals.
$ M = "C10"
$ SHOW SYMBOL M
$ CONVERT NOSUCH.DAT C101.DAT
$ SHOW SYMBOL $STATUS
$ CONVERT/FDL=NOSUCH T.TXT C102.DAT
$ SHOW SYMBOL $STATUS
$ CONVERT/FDL=C4J T.TXT C103.DAT
$ SHOW SYMBOL $STATUS
$ DIRECTORY C103.DAT
$ CONVERT [IN]S3*.IDX C104.IDX
$ SHOW SYMBOL $STATUS
$ CONVERT T.TXT C10*.DAT
$ SHOW SYMBOL $STATUS
$ CONVERT T.TXT,T.TXT,T.TXT,T.TXT,T.TXT,T.TXT,T.TXT,T.TXT,T.TXT,T.TXT,T.TXT C105.TXT
$ SHOW SYMBOL $STATUS
$ CONVERT/KEY=9 [IN]S35.IDX C106.IDX
$ SHOW SYMBOL $STATUS
$ CONVERT/KEY=1 T.TXT C107.TXT
$ SHOW SYMBOL $STATUS
$ CONVERT/MERGE KU.TXT C92.TXT
$ SHOW SYMBOL $STATUS
$ CONVERT/APPEND/MERGE KU.TXT C91.IDX
$ SHOW SYMBOL $STATUS
$ CONVERT/APPEND KU.TXT C91.IDX
$ SHOW SYMBOL $STATUS
$ CONVERT/NOCREATE T.TXT C108.TXT
$ SHOW SYMBOL $STATUS
$ CONVERT/PROLOG=4 [IN]S35.IDX C109.IDX
$ SHOW SYMBOL $STATUS
$ CONVERT/FDL=FIX10/PAD=%X300 T.TXT C10A.FIX
$ SHOW SYMBOL $STATUS
$ CONVERT/WORK_FILES=11 [IN]S35.IDX C10B.IDX
$ SHOW SYMBOL $STATUS
$ CONVERT/STATISTICS=FULL T.TXT C10C.TXT
$ SHOW SYMBOL $STATUS
$ CONVERT/IDENTICAL T.TXT C10D.TXT
$ SHOW SYMBOL $STATUS
$ CONVERT/FDL=KT/PAD KT.TXT C10E.IDX
$ SHOW SYMBOL $STATUS
$ CONVERT/FDL=C2H T.TXT C10F.REL
$ SHOW SYMBOL $STATUS
$ CONVERT/FDL=C2H/PAD T.TXT C10G.REL
$ SHOW SYMBOL $STATUS
$ DIRECTORY C10*.*
$ !
$ ! C11: ANALYZE/RMS_FILE on each organization and format, and its
$ ! qualifiers.
$ M = "C11"
$ SHOW SYMBOL M
$ ANALYZE/RMS_FILE/OUTPUT=SYS$OUTPUT T.TXT
$ SHOW SYMBOL $STATUS
$ ANALYZE/RMS_FILE/OUTPUT=SYS$OUTPUT C81E.FIX
$ ANALYZE/RMS_FILE/OUTPUT=SYS$OUTPUT C83.VFC
$ ANALYZE/RMS_FILE/OUTPUT=SYS$OUTPUT C84A.SLF
$ ANALYZE/RMS_FILE/OUTPUT=SYS$OUTPUT C84E.UDF
$ ANALYZE/RMS_FILE/OUTPUT=SYS$OUTPUT C21.DAT
$ ANALYZE/RMS_FILE/OUTPUT=SYS$OUTPUT C65.REL
$ ANALYZE/RMS_FILE/OUTPUT=SYS$OUTPUT C2H.DAT
$ ANALYZE/RMS_FILE/OUTPUT=SYS$OUTPUT C31.IDX
$ ANALYZE/RMS_FILE/OUTPUT=SYS$OUTPUT C38.IDX
$ ANALYZE/RMS_FILE/OUTPUT=SYS$OUTPUT C78B.IDX
$ ANALYZE/RMS_FILE/FDL/OUTPUT=SYS$OUTPUT T.TXT
$ ANALYZE/RMS_FILE/FDL/OUTPUT=SYS$OUTPUT C65.REL
$ ANALYZE/RMS_FILE/STATISTICS/OUTPUT=SYS$OUTPUT [IN]S35.IDX
$ SHOW SYMBOL $STATUS
$ ANALYZE/RMS_FILE/STATISTICS/OUTPUT=SYS$OUTPUT [IN]G116.IDX
$ ANALYZE/RMS_FILE/STATISTICS/OUTPUT=SYS$OUTPUT C78B.IDX
$ ANALYZE/RMS_FILE/STATISTICS/OUTPUT=SYS$OUTPUT T.TXT
$ SHOW SYMBOL $STATUS
$ ANALYZE/RMS_FILE/SUMMARY/OUTPUT=SYS$OUTPUT [IN]F122.IDX
$ SHOW SYMBOL $STATUS
$ ANALYZE/RMS_FILE/SUMMARY/OUTPUT=SYS$OUTPUT [IN]S62.IDX
$ ANALYZE/RMS_FILE/SUMMARY/OUTPUT=SYS$OUTPUT C65.REL
$ ANALYZE/RMS_FILE/SUMMARY/OUTPUT=SYS$OUTPUT T.TXT
$ ANALYZE/RMS_FILE/CHECK/OUTPUT=SYS$OUTPUT [IN]G116.IDX
$ ! The output's default name, /NOOUTPUT, a list, a wildcard.
$ ANALYZE/RMS_FILE T.TXT
$ SHOW SYMBOL $STATUS
$ ANALYZE/RMS_FILE/FDL T.TXT
$ SHOW SYMBOL $STATUS
$ ANALYZE/RMS_FILE/STATISTICS C31.IDX
$ SHOW SYMBOL $STATUS
$ DIRECTORY T.*,C31.*
$ ANALYZE/RMS_FILE/NOOUTPUT C31.IDX
$ SHOW SYMBOL $STATUS
$ ANALYZE/RMS_FILE/OUTPUT=SYS$OUTPUT C31.IDX,C32.IDX
$ SHOW SYMBOL $STATUS
$ ANALYZE/RMS_FILE/FDL/OUTPUT=C11L.FDL C31.IDX,C32.IDX
$ SHOW SYMBOL $STATUS
$ TYPE C11L.FDL
$ ANALYZE/RMS_FILE/OUTPUT=SYS$OUTPUT C81*.FIX
$ SHOW SYMBOL $STATUS
$ ! Refusals: a missing file, a directory file, qualifiers together.
$ ANALYZE/RMS_FILE/OUTPUT=SYS$OUTPUT NOSUCH.DAT
$ SHOW SYMBOL $STATUS
$ ANALYZE/RMS_FILE/OUTPUT=SYS$OUTPUT [000000]R3.DIR
$ SHOW SYMBOL $STATUS
$ ANALYZE/RMS_FILE/CHECK/FDL/OUTPUT=SYS$OUTPUT C31.IDX
$ SHOW SYMBOL $STATUS
$ ANALYZE/RMS_FILE/STATISTICS/SUMMARY/OUTPUT=SYS$OUTPUT C31.IDX
$ SHOW SYMBOL $STATUS
$ ANALYZE/RMS_FILE/CHECK/STATISTICS/OUTPUT=SYS$OUTPUT C31.IDX
$ SHOW SYMBOL $STATUS
$ !
$ ! C12: ANALYZE/RMS_FILE/CHECK on damaged copies of round 1's S35.IDX (two
$ ! keys, buckets of 2 blocks: key descriptors in VBNs 1 and 2, the area's in
$ ! 3, key 0's data bucket at 4 and root at 7, key 1's SIDRs at 10 and root
$ ! at 13). Each copy has one byte changed by IDX88P.
$ M = "C12"
$ SHOW SYMBOL M
$ ! A copy made, one byte changed, and /CHECK: P1 the copy's name, P2 the
$ ! VBN, P3 the offset, P4 what is added.
$ CALL DAMAGE X01.IDX 4 0 1
$ CALL DAMAGE X02.IDX 5 511 1
$ CALL DAMAGE X03.IDX 1 510 1
$ CALL DAMAGE X04.IDX 1 12 3
$ CALL DAMAGE X05.IDX 4 4 2
$ CALL DAMAGE X06.IDX 4 6 255
$ CALL DAMAGE X07.IDX 4 8 100
$ CALL DAMAGE X08.IDX 3 24 50
$ CALL DAMAGE X09.IDX 10 20 1
$ CALL DAMAGE X10.IDX 7 14 1
$ CALL DAMAGE X11.IDX 4 13 1
$ CALL DAMAGE X12.IDX 4 12 1
$ CALL DAMAGE X13.IDX 1 17 1
$ CALL DAMAGE X14.IDX 2 84 1
$ ! The other reports on a damaged file.
$ ANALYZE/RMS_FILE/FDL/OUTPUT=SYS$OUTPUT X05.IDX
$ SHOW SYMBOL $STATUS
$ ANALYZE/RMS_FILE/STATISTICS/OUTPUT=SYS$OUTPUT X05.IDX
$ SHOW SYMBOL $STATUS
$ ANALYZE/RMS_FILE/SUMMARY/OUTPUT=SYS$OUTPUT X07.IDX
$ SHOW SYMBOL $STATUS
$ ! CONVERT of a damaged file.
$ CONVERT/FDL=SEQV X05.IDX C12A.SEQ
$ SHOW SYMBOL $STATUS
$ CONVERT/FDL=SEQV X07.IDX C12B.SEQ
$ SHOW SYMBOL $STATUS
$ !
$ ! C13: A35.FDL names [IN]S35.IDX: with no file given, which name is made?
$ ! (Last, so that C12's copies were of round 1's file.) Then everything
$ ! made, in a save set.
$ M = "C13"
$ SHOW SYMBOL M
$ CREATE/FDL=A35/LOG
$ SHOW SYMBOL $STATUS
$ DIRECTORY [IN]S35.IDX;*
$ SET DEFAULT [-]
$ DIRECTORY/SIZE/TOTAL [R3]
$ BACKUP [R3]*.*;* IDX88C.BCK/SAVE_SET
$ SHOW SYMBOL $STATUS
$ BACKUP/LIST=IDX88CBCK.TXT IDX88C.BCK/SAVE_SET
$ !
$ ! The end.
$ M = "END"
$ SHOW SYMBOL M
$ SET NOVERIFY
$ EXIT
$ !
$ ! Each subroutine is a command level of its own, which starts with DCL's
$ ! ON ERROR THEN EXIT, so each says SET NOON again.
$ !
$ ! SHOWF: a file made, by DIRECTORY/FULL and ANALYZE/RMS_FILE/FDL.
$ SHOWF: SUBROUTINE
$ SET NOON
$ DIRECTORY/FULL 'P1'
$ ANALYZE/RMS_FILE/FDL/OUTPUT=SYS$OUTPUT 'P1'
$ ENDSUBROUTINE
$ !
$ ! HEAD: the first five records of a file, their first 8 bytes (round 1's
$ ! records' primary key, or a text record's start), their sizes, and how
$ ! many there are.
$ HEAD: SUBROUTINE
$ SET NOON
$ N = 0
$ OPEN/READ H 'P1'
$ HEADLOOP:
$ READ/END_OF_FILE=HEADEND/ERROR=HEADEND H R
$ N = N + 1
$ IF N .LE. 5 THEN WRITE SYS$OUTPUT N, " |", F$EXTRACT(0, 8, R), "| ", F$LENGTH(R)
$ GOTO HEADLOOP
$ HEADEND:
$ CLOSE H
$ WRITE SYS$OUTPUT "records: ", N
$ ENDSUBROUTINE
$ !
$ ! DAMAGE: a copy of S35.IDX, one byte changed, and /CHECK's report.
$ DAMAGE: SUBROUTINE
$ SET NOON
$ COPY [IN]S35.IDX 'P1'
$ PFILE == "''P1'"
$ PVBN == "''P2'"
$ POFF == "''P3'"
$ PADD == "''P4'"
$ PATCH
$ SHOW SYMBOL $STATUS
$ ANALYZE/RMS_FILE/CHECK/OUTPUT=SYS$OUTPUT 'P1'
$ SHOW SYMBOL $STATUS
$ ENDSUBROUTINE
