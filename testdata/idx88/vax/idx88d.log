AAAA the only AAAA..
BBBB first of BBBB..
BBBB second of BBBB.
$ !
$ ! D10: OPEN/APPEND of an indexed file, and WRITE of a lower key after a
$ ! higher one (does /APPEND mean RMS's EOF, and so a $PUT in sequence?).
$ M = "D10"
$ SHOW SYMBOL M
  M = "D10"
$ OPEN/APPEND F D3.IDX
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00000001"
$ WRITE F "M001 first"
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00010001"
$ WRITE F "A001 lower"
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00010001"
$ WRITE F "Z001 higher"
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00010001"
$ CLOSE F
$ OPEN/APPEND F D3.IDX
$ WRITE F "B001 lower again"
%RMS-F-SEQ, primary key out of sequence (SEQ access)
$ SHOW SYMBOL $STATUS
  $STATUS == "%X000186AC"
$ R = "-"
$ READ F R
%RMS-E-EOF, end of file detected
$ SHOW SYMBOL $STATUS
  $STATUS == "%X0001827A"
$ SHOW SYMBOL R
  R = "-"
$ CLOSE F
$ TYPE D3.IDX
A001 lower
M001 first
Z001 higher
