	.TITLE	PHUTIL	What the telephone book's programs print with (Phase 88)
;
; PH_PRINT(control, args...) is $FAOL and LIB$PUT_OUTPUT. PH_SHOW(label, status)
; prints a label and a status by its name, and returns the status. PH_GOT(status,
; rab) prints a status that isn't plain success, and the record if one came.
;
	$RABDEF
	$RMSDEF

	.PSECT	PH_DATA,WRT,NOEXE,LONG
	.MACRO	NAME,STATUS
	.LONG	RMS$_'STATUS
	.ADDRESS D_'STATUS
	.SAVE_PSECT
	.PSECT	PH_NAMES,NOWRT,NOEXE,LONG
D_'STATUS:	.ASCID	/'STATUS'/
	.RESTORE_PSECT
	.ENDM	NAME
NAMES:	NAME	NORMAL
	NAME	OK_DUP
	NAME	OK_LIM
	NAME	OK_RRL
	NAME	OK_ALK
	NAME	EOF
	NAME	RNF
	NAME	RLK
	NAME	DUP
	NAME	CHG
	NAME	KSZ
	NAME	KRF
	NAME	ROP
	NAME	CUR
	NAME	SEQ
	NAME	IOP
	NAME	FAC
	NAME	SHR
	NAME	FLK
	NAME	DEL
	NAME	RNL
	.LONG	0
FNAME:	.ASCID	/!AS !AS/
FBAD:	.ASCID	/!AS %X!XL/
FREC:	.ASCID	/  !AF/
LSTS:	.ASCID	/status/
OUT:	.BLKB	132
OUTD:	.LONG	132
	.ADDRESS OUT
TEXT:	.LONG	0
	.ADDRESS OUT

	.PSECT	PH_CODE,NOWRT,EXE
	.ENTRY	PH_PRINT,^M<>
	PUSHAB	8(AP)
	PUSHAQ	OUTD
	PUSHAW	TEXT
	PUSHL	4(AP)
	CALLS	#4,G^SYS$FAOL
	PUSHAQ	TEXT
	CALLS	#1,G^LIB$PUT_OUTPUT
	RET

	.ENTRY	PH_SHOW,^M<R2>
	MOVAB	NAMES,R2
10$:	TSTL	(R2)
	BEQL	20$
	CMPL	(R2),8(AP)
	BEQL	30$
	ADDL2	#8,R2
	BRB	10$
20$:	PUSHL	8(AP)
	PUSHL	4(AP)
	PUSHAQ	FBAD
	CALLS	#3,PH_PRINT
	BRB	40$
30$:	PUSHL	4(R2)
	PUSHL	4(AP)
	PUSHAQ	FNAME
	CALLS	#3,PH_PRINT
40$:	MOVL	8(AP),R0
	RET

	.ENTRY	PH_GOT,^M<R2>
	MOVL	8(AP),R2		; the RAB
	CMPL	4(AP),#RMS$_NORMAL
	BEQL	20$
	PUSHL	4(AP)
	PUSHAQ	LSTS
	CALLS	#2,PH_SHOW
	BLBC	4(AP),30$
20$:	PUSHL	RAB$L_RBF(R2)
	MOVZWL	RAB$W_RSZ(R2),-(SP)
	PUSHAQ	FREC
	CALLS	#3,PH_PRINT
30$:	MOVL	4(AP),R0
	RET
	.END
