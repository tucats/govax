$! PHONES.COM - DCL on the file PHONES.MAR made and PHONESF.FOR left: TYPE in the
$! primary key's order; READ by each key; a file made from the description ANALYZE
$! writes of it, and loaded from it by CONVERT, which has the same records, though
$! those of one alternate key now in the primary key's order, the order it loads.
$ WRITE SYS$OUTPUT "-- TYPE"
$ TYPE PHONES.IDX
$ WRITE SYS$OUTPUT "-- READ"
$ OPEN/READ F PHONES.IDX
$ READ/INDEX=1/KEY="415-4004" F LINE
$ WRITE SYS$OUTPUT LINE
$ READ F LINE
$ WRITE SYS$OUTPUT LINE
$ READ/INDEX=2/KEY="212"/MATCH=EQ F LINE
$ WRITE SYS$OUTPUT LINE
$ READ/INDEX=0/KEY="NOBODY"/ERROR=MISSING F LINE
$ WRITE SYS$OUTPUT "NOT MISSING"
$MISSING:
$ WRITE SYS$OUTPUT "NO NOBODY"
$ CLOSE F
$ WRITE SYS$OUTPUT "-- CONVERT"
$ ANALYZE/RMS_FILE/FDL/OUTPUT=PHONES.FDL PHONES.IDX
$ CONVERT/FDL=PHONES.FDL PHONES.IDX PHONES2.IDX
$ TYPE PHONES2.IDX
$ OPEN/READ F PHONES2.IDX
$ READ/INDEX=3/KEY="TENNIS" F LINE
$ WRITE SYS$OUTPUT LINE
$ READ F LINE
$ WRITE SYS$OUTPUT LINE
$ CLOSE F
