	.TITLE	PHONESL	A record locked against another process (Phase 88)
;
; Holds a record of PHONES.IDX, the file shared, while a subprocess runs
; PHONESC, which finds it locked; lets it go, and runs PHONESC again, which now
; reads it. A record PHONESC wrote is there at once for this process.
;
	$RABDEF

	.PSECT	DATA,WRT,NOEXE,LONG
FAB:	$FAB	FNM=<PHONES.IDX>,FAC=<GET,PUT,UPD,DEL>,SHR=<GET,PUT,UPD,DEL>
RAB:	$RAB	FAB=FAB,UBF=BUF,USZ=60,RAC=KEY,KBF=KEY1,KSZ=6
BUF:	.BLKB	60
KEY1:	.ASCII	/WALKER/
KEY2:	.ASCII	/OWENS/
CMD:	.ASCID	/RUN PHONESC/
LOPEN:	.ASCID	/parent OPEN/
LFREE:	.ASCID	/parent FREE/
LGET:	.ASCID	/parent GET/

	.PSECT	CODE,NOWRT,EXE
	.ENTRY	START,^M<>
	$OPEN	FAB=FAB
	PUSHL	R0
	PUSHAQ	LOPEN
	CALLS	#2,PH_SHOW
	$CONNECT RAB=RAB
	$GET	RAB=RAB
	PUSHAB	RAB
	PUSHL	R0
	CALLS	#2,PH_GOT
	PUSHAQ	CMD
	CALLS	#1,G^LIB$SPAWN
	$FREE	RAB=RAB
	PUSHL	R0
	PUSHAQ	LFREE
	CALLS	#2,PH_SHOW
	PUSHAQ	CMD
	CALLS	#1,G^LIB$SPAWN
	MOVAB	KEY2,RAB+RAB$L_KBF
	MOVB	#5,RAB+RAB$B_KSZ
	$GET	RAB=RAB
	PUSHAB	RAB
	PUSHL	R0
	CALLS	#2,PH_GOT
	$CLOSE	FAB=FAB
	MOVL	#1,R0
	RET
	.END	START
