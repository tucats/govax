$ DEFINE/USER_MODE SYS$OUTPUT OTS72T.MLG
$ MACRO/NOLIST OTS72T
$ LINK/NOMAP OTS72T,SYS$INPUT/OPTIONS
SYS$SHARE:FORRTL/SHAREABLE
$ DEFINE/USER_MODE SYS$OUTPUT OTS72T.OUT
$ RUN OTS72T
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00000001"
