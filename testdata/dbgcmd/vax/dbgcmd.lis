                                     0000     1 	.TITLE	DBGCMD	Phase 42 probe: breakpoints, stepping, watching
                                     0000     2 	.IDENT	/V1.0/
                                     0000     3 
                                     0000     4 ; A small program for the VMS debugger's run-control commands to work
                                     0000     5 ; on (docs/PHASE-42.md, subtask 1): a recursive routine (STEP/OVER and
                                     0000     6 ; STEP/RETURN across recursion, SET BREAK/AFTER), a loop of branches
                                     0000     7 ; (SET BREAK/BRANCH, /LINE), data written a longword, a byte, and 16
                                     0000     8 ; bytes at a time (SET WATCH), a JSB subroutine, a condition signalled
                                     0000     9 ; and handled, and one signalled with no handler (SET BREAK/EXCEPTION).
                                     0000    10 ; DBGCMD.COM assembles and links it /DEBUG and runs it under the
                                     0000    11 ; debugger with each .DBG file.
                                     0000    12 ;
                                     0000    13 ; It runs to the end: the unhandled signal is a warning, which VMS
                                     0000    14 ; reports and continues from.
                                     0000    15 
                                     0000    16 	.EXTERNAL LIB$PUT_OUTPUT, LIB$SIGNAL
                                     0000    17 
                           00000001  0000    18 SS$_CONTINUE = 1			; a handler's "continue"
                           00000870  0000    19 SS$_ENDOFFILE = ^X870			; a warning: %SYSTEM-W-ENDOFFILE
                                     0000    20 
                                 00000000    21 	.PSECT	DATA, WRT, NOEXE, LONG
                           00000000  0000    22 WATCHL:	.LONG	0			; a watched longword
                                 00  0004    23 WATCHB:	.BYTE	0			; a watched byte
                                     0005    24 	.ALIGN	LONG
                           00000018  0008    25 BUFFER:	.BLKB	16			; written 16 bytes at once (MOVC3)
42 41 39 38 37 36 35 34 33 32 31 30  0018    26 SOURCE:	.ASCII	/0123456789ABCDEF/
                        46 45 44 43  0024       
                           00000000  0028    27 RESULT:	.LONG	0			; FACT(5)
                           00000000  002C    28 COUNT:	.LONG	0			; the loop's counter
44 4D 43 47 42 44 00000038'010E0000' 0030    29 MSG:	.ASCID	/DBGCMD: done/
                  65 6E 6F 64 20 3A  003E       
                                     0044    30 
                                 00000000    31 	.PSECT	CODE, NOWRT, EXE, LONG
                               000C  0000    32 	.ENTRY	START, ^M<R2,R3>
                       52   05   D0  0002    33 	MOVL	#5, R2			; FACT's argument
                            52   DD  0005    34 	PUSHL	R2
              0000006E'EF   01   FB  0007    35 	CALLS	#1, FACT		; FACT(5), recursively
              00000028'EF   50   D0  000E    36 	MOVL	R0, RESULT
                       53   03   D0  0015    37 	MOVL	#3, R3			; a loop of branches
                   0000002C'EF   D6  0018    38 LOOP:	INCL	COUNT
                07 0000002C'EF   E8  001E    39 	BLBS	COUNT, ODD
              00000000'EF   02   C0  0025    40 	ADDL2	#2, WATCHL		; writes the watched longword
                         E9 53   F5  002C    41 ODD:	SOBGTR	R3, LOOP
           00000004'EF   41 8F   90  002F    42 	MOVB	#^X41, WATCHB		; writes the watched byte
00000008'EF   00000018'EF   10   28  0037    43 	MOVC3	#16, SOURCE, BUFFER	; writes 16 bytes at once
                   00000089'EF   16  0043    44 	JSB	BUMP			; a JSB subroutine
              00000090'EF   00   FB  0049    45 	CALLS	#0, CATCH		; signals, and handles it
                   00000870 8F   DD  0050    46 	PUSHL	#SS$_ENDOFFILE		; signals with no handler
              00000000'GF   01   FB  0056    47 	CALLS	#1, G^LIB$SIGNAL
                   00000030'EF   7F  005D    48 	PUSHAQ	MSG
              00000000'GF   01   FB  0063    49 	CALLS	#1, G^LIB$PUT_OUTPUT
                       50   01   D0  006A    50 	MOVL	#1, R0
                                 04  006D    51 LAST:	RET
                                     006E    52 
                               0004  006E    53 	.ENTRY	FACT, ^M<R2>		; FACT(n) = n!, by recursion
                    52   04 AC   D0  0070    54 	MOVL	4(AP), R2
                       01   52   D1  0074    55 	CMPL	R2, #1
