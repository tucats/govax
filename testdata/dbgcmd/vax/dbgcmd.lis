                            04   14  0077    56 	BGTR	RECUR
                       50   01   D0  0079    57 	MOVL	#1, R0
                                 04  007C    58 	RET
                  7E   52   01   C3  007D    59 RECUR:	SUBL3	#1, R2, -(SP)
                    E9 AF   01   FB  0081    60 	CALLS	#1, FACT
                       50   52   C4  0085    61 BACK:	MULL2	R2, R0			; each FACT call returns here
                                 04  0088    62 	RET
                                     0089    63 
                   00000000'EF   D6  0089    64 BUMP:	INCL	WATCHL			; a JSB subroutine
                                 05  008F    65 	RSB
                                     0090    66 
                               0000  0090    67 	.ENTRY	CATCH, ^M<>
              6D   000000A7'EF   9E  0092    68 	MOVAB	HANDLR, (FP)		; establishes HANDLR
                   00000870 8F   DD  0099    69 	PUSHL	#SS$_ENDOFFILE
              00000000'GF   01   FB  009F    70 	CALLS	#1, G^LIB$SIGNAL
                                 04  00A6    71 	RET
                                     00A7    72 
                               0000  00A7    73 	.ENTRY	HANDLR, ^M<>		; continues from any condition
                       50   01   D0  00A9    74 	MOVL	#SS$_CONTINUE, R0
                                 04  00AC    75 	RET
                                     00AD    76 
                                     00AD    77 	.END	START
