
$ ! DBGCMD.COM - Phase 42's probe (docs/PHASE-42.md, subtask 1): how the
$ ! VMS debugger's run-control commands behave and word their output
$ ! (breakpoints, tracepoints, watchpoints, STEP, EXAMINE and DEPOSIT,
$ ! CALL, exceptions, and its error messages), for govax's debugger to
$ ! be checked against.
$ !
$ ! 1. Builds DBGCMD with /DEBUG, linked /DEBUG, with its listing, map,
$ !    and ANALYZE/IMAGE.
$ ! 2. Runs it under the debugger once for each file of debugger commands
$ !    (*.DBG), logging each session to a file of the same name with
$ !    type DLG.
$ !
$ ! Run it with the exchange volume as the default directory, keeping a
$ ! log of everything it prints:
$ !
$ !     @DBGCMD/OUTPUT=DBGCMD.LOG
$ !
$ SET NOON
$ SET VERIFY
$ !
$ ! 1. The build.
$ !
$ MACRO/DEBUG/LIST DBGCMD
$ LINK/DEBUG/MAP DBGCMD
$ ANALYZE/IMAGE/OUTPUT=DBGCMD.ANI DBGCMD.EXE
%ANALYZE-I-ERRORS, DUA1:[000000]DBGCMD.EXE;1                               0 errors
$ !
$ ! 2. Debugger sessions. DEBUG writes a file of debugger commands that
$ !    opens P1.DLG as the log, runs the probe's commands (P1.DBG), and
$ !    exits, then runs DBGCMD under the debugger reading it.
$ !
$ CALL DEBUG BREAK
$ DEBUG: SUBROUTINE
$   OPEN/WRITE DBGF RUN.DBG
$   WRITE DBGF "SET LOG BREAK.DLG"
$   WRITE DBGF "SET OUTPUT LOG,VERIFY"
$   WRITE DBGF "@BREAK.DBG"
$   WRITE DBGF "EXIT"
$   CLOSE DBGF
$   DEFINE/USER_MODE DBG$INPUT RUN.DBG
$   DEFINE/USER_MODE DBG$DECW$DISPLAY " "
$   RUN/DEBUG DBGCMD

         OpenVMS VAX DEBUG Version V7.1-000

%DEBUG-I-INITIAL, Language: MACRO, Module: DBGCMD
%DEBUG-I-VERIFYICF, entering command procedure BREAK.DBG
 ! BREAK.DBG - breakpoints at addresses (docs/PHASE-42.md, subtask 1):
 ! how SET BREAK, SHOW BREAK, and CANCEL BREAK word things, /AFTER,
 ! /TEMPORARY, WHEN, DO, a list of addresses, and a break at an address
 ! with no label. DBGCMD.COM runs it with SET LOG and SET OUTPUT
 ! LOG,VERIFY.
 !
 ! None set yet.
 SHOW BREAK
%DEBUG-I-NOBREAKS, no breakpoints are set
 !
 ! A routine: the break is after its entry mask, at each recursion.
 SET BREAK FACT
 SHOW BREAK
breakpoint at routine DBGCMD\FACT
 GO
break at routine DBGCMD\FACT
    54:         MOVL    4(AP), R2
 SHOW CALLS
 module name     routine name      line                rel PC           abs PC
*DBGCMD          FACT                54               00000002         00000470
*DBGCMD          START               35               0000000E         0000040E
 GO
break at routine DBGCMD\FACT
    54:         MOVL    4(AP), R2
 SHOW CALLS
 module name     routine name      line                rel PC           abs PC
*DBGCMD          FACT                54               00000002         00000470
*DBGCMD          FACT                60               00000017         00000485
*DBGCMD          START               35               0000000E         0000040E
 CANCEL BREAK FACT
 SHOW BREAK
%DEBUG-I-NOBREAKS, no breakpoints are set
 !
 ! /AFTER:3 - the third time BACK is reached, and every time after.
 SET BREAK/AFTER:3 BACK
 SHOW BREAK
breakpoint at DBGCMD\FACT\BACK
   /after: 3
 GO
break at DBGCMD\FACT\BACK
    61: BACK:   MULL2   R2, R0                  ; each FACT call returns here
 SHOW CALLS
 module name     routine name      line                rel PC           abs PC
*DBGCMD          FACT                61               00000017         00000485
*DBGCMD          FACT                60               00000017         00000485
*DBGCMD          START               35               0000000E         0000040E
 EXAMINE R0
DBGCMD\FACT\%R0:        00000006
 GO
break at DBGCMD\FACT\BACK
    61: BACK:   MULL2   R2, R0                  ; each FACT call returns here
 EXAMINE R0
DBGCMD\FACT\%R0:        00000018
 CANCEL BREAK BACK
 !
 ! An address with no label of its own (the RET after BACK's MULL2).
 SET BREAK BACK+3
 SHOW BREAK
breakpoint at DBGCMD\FACT\%LINE 62
 GO
break at DBGCMD\FACT\%LINE 62
    62:         RET
 CANCEL BREAK BACK+3
 !
 ! A list, and a temporary break.
 SET BREAK LOOP, ODD
 SET BREAK/TEMPORARY LAST
 SHOW BREAK
breakpoint at DBGCMD\START\ODD
breakpoint at DBGCMD\START\LOOP
breakpoint at DBGCMD\START\LAST [temporary]
 GO
break at DBGCMD\START\LOOP
    38: LOOP:   INCL    COUNT
 GO
break at DBGCMD\START\ODD
    41: ODD:    SOBGTR  R3, LOOP
 GO
break at DBGCMD\START\LOOP
    38: LOOP:   INCL    COUNT
 CANCEL BREAK LOOP
 SHOW BREAK
breakpoint at DBGCMD\START\ODD
breakpoint at DBGCMD\START\LAST [temporary]
 GO
break at DBGCMD\START\ODD
    41: ODD:    SOBGTR  R3, LOOP
 GO
break at DBGCMD\START\ODD
    41: ODD:    SOBGTR  R3, LOOP
 CANCEL BREAK ODD
 !
 ! WHEN (true, then false) and DO. The GO after HANDLR's break goes on
 ! to LAST, unless the debugger stops first at the signal no handler
 ! handles.
 SET BREAK BUMP WHEN (.WATCHL EQL 2)
 SET BREAK CATCH WHEN (.WATCHL EQL 99)
 SET BREAK HANDLR DO (EXAMINE R0; SHOW CALLS)
 SHOW BREAK
breakpoint at DBGCMD\START\LAST [temporary]
breakpoint at DBGCMD\FACT\BUMP
   when (.WATCHL EQL 2)
breakpoint at routine DBGCMD\CATCH
   when (.WATCHL EQL 99)
breakpoint at routine DBGCMD\HANDLR
   do (EXAMINE R0; SHOW CALLS)
 GO
%DEBUG-E-NOACCESSR, no read access to address 00000002
break at DBGCMD\FACT\BUMP
    64: BUMP:   INCL    WATCHL                  ; a JSB subroutine
 EXAMINE WATCHL
DBGCMD\WATCHL:  00000002
 GO
%DEBUG-E-NOACCESSR, no read access to address 00000003
break at routine DBGCMD\CATCH
    68:         MOVAB   HANDLR, (FP)            ; establishes HANDLR
 GO
break at routine DBGCMD\HANDLR
    74:         MOVL    #SS$_CONTINUE, R0
 EXAMINE R0;
DBGCMD\HANDLR\%R0:      03C00000
  SHOW CALLS
 module name     routine name      line                rel PC           abs PC
*DBGCMD          HANDLR              74               00000002         000004A9
----- above condition handler called with exception 00000870:
%SYSTEM-W-ENDOFFILE, end of file
----- end of exception message
*DBGCMD          CATCH               70               00000016         000004A6
*DBGCMD          START               45               00000050         00000450
 SHOW BREAK
breakpoint at DBGCMD\START\LAST [temporary]
breakpoint at DBGCMD\FACT\BUMP
   when (.WATCHL EQL 2)
breakpoint at routine DBGCMD\CATCH
   when (.WATCHL EQL 99)
breakpoint at routine DBGCMD\HANDLR
   do (EXAMINE R0; SHOW CALLS)
 !
 ! LAST's temporary break is gone; the program ends.
 CANCEL BREAK/ALL
 SHOW BREAK
%DEBUG-I-NOBREAKS, no breakpoints are set
 GO
%SYSTEM-W-ENDOFFILE, end of file
break on unhandled exception preceding DBGCMD\START\%LINE 48
    48:         PUSHAQ  MSG
%DEBUG-I-VERIFYICF, exiting command procedure BREAK.DBG
$   SHOW SYMBOL $STATUS
  $STATUS == "%X10028009"
$ ENDSUBROUTINE
$ CALL DEBUG BRKCLS
$ DEBUG: SUBROUTINE
$   OPEN/WRITE DBGF RUN.DBG
$   WRITE DBGF "SET LOG BRKCLS.DLG"
$   WRITE DBGF "SET OUTPUT LOG,VERIFY"
$   WRITE DBGF "@BRKCLS.DBG"
$   WRITE DBGF "EXIT"
$   CLOSE DBGF
$   DEFINE/USER_MODE DBG$INPUT RUN.DBG
$   DEFINE/USER_MODE DBG$DECW$DISPLAY " "
$   RUN/DEBUG DBGCMD

         OpenVMS VAX DEBUG Version V7.1-000

%DEBUG-I-INITIAL, Language: MACRO, Module: DBGCMD
%DEBUG-I-VERIFYICF, entering command procedure BRKCLS.DBG
 ! BRKCLS.DBG - breakpoints on classes of instruction (docs/PHASE-42.md,
 ! subtask 1): /CALL, /RETURN, /BRANCH, /LINE, and /INSTRUCTION, with and
 ! without opcodes, and how SHOW BREAK and CANCEL BREAK show them.
 !
 ! Every call and return instruction.
 SET BREAK/CALL
 SHOW BREAK
breakpoint on calls:
 BSBB     BSBW     CALLG    CALLS    JSB      RET      RSB     
 GO
break on calls at DBGCMD\START\%LINE 35
    35:         CALLS   #1, FACT                ; FACT(5), recursively
 GO
break on calls at DBGCMD\FACT\%LINE 60
    60:         CALLS   #1, FACT
 SHOW CALLS
 module name     routine name      line                rel PC           abs PC
*DBGCMD          FACT                60               00000013         00000481
*DBGCMD          START               35               0000000E         0000040E
 GO
break on calls at DBGCMD\FACT\%LINE 60
    60:         CALLS   #1, FACT
 GO
break on calls at DBGCMD\FACT\%LINE 60
    60:         CALLS   #1, FACT
 CANCEL BREAK/CALL
 SHOW BREAK
%DEBUG-I-NOBREAKS, no breakpoints are set
 !
 ! Each return from FACT.
 SET BREAK/RETURN FACT
 SHOW BREAK
breakpoint on return from routine DBGCMD\FACT
 GO
break on return from routine DBGCMD\FACT at DBGCMD\FACT\%LINE 58
    58:         RET
 SHOW CALLS
 module name     routine name      line                rel PC           abs PC
*DBGCMD          FACT                58               0000000E         0000047C
*DBGCMD          FACT                60               00000017         00000485
*DBGCMD          FACT                60               00000017         00000485
*DBGCMD          FACT                60               00000017         00000485
*DBGCMD          FACT                60               00000017         00000485
*DBGCMD          START               35               0000000E         0000040E
 GO
break on return from routine DBGCMD\FACT at DBGCMD\FACT\%LINE 62
    62:         RET
 SHOW CALLS
 module name     routine name      line                rel PC           abs PC
*DBGCMD          FACT                62               0000001A         00000488
*DBGCMD          FACT                60               00000017         00000485
*DBGCMD          FACT                60               00000017         00000485
*DBGCMD          FACT                60               00000017         00000485
*DBGCMD          START               35               0000000E         0000040E
 CANCEL BREAK/ALL
 !
 ! Every branch.
 SET BREAK/BRANCH
 SHOW BREAK
breakpoint on branches:
 ACBB     ACBD     ACBF     ACBG     ACBH     ACBL     ACBW     AOBLEQ  
 AOBLSS   BBC      BBCC     BBCCI    BBCS     BBS      BBSC     BBSS    
 BBSSI    BCC      BCS      BEQL     BEQLU    BGEQ     BGEQU    BGTR    
 BGTRU    BLBC     BLBS     BLEQ     BLEQU    BLSS     BLSSU    BNEQ    
 BNEQU    BRB      BRW      BVC      BVS      CASEB    CASEL    CASEW   
 JMP      SOBGEQ   SOBGTR  
 GO
break on branches at DBGCMD\START\%LINE 39
    39:         BLBS    COUNT, ODD
 GO
break on branches at DBGCMD\START\ODD
    41: ODD:    SOBGTR  R3, LOOP
 GO
break on branches at DBGCMD\START\%LINE 39
    39:         BLBS    COUNT, ODD
 CANCEL BREAK/BRANCH
 !
 ! Every line.
 SET BREAK/LINE
 SHOW BREAK
breakpoint on lines
 GO
break on lines at DBGCMD\START\%LINE 40
    40:         ADDL2   #2, WATCHL              ; writes the watched longword
 GO
break on lines at DBGCMD\START\ODD
    41: ODD:    SOBGTR  R3, LOOP
 GO
break on lines at DBGCMD\START\LOOP
    38: LOOP:   INCL    COUNT
 CANCEL BREAK/LINE
 !
 ! Given opcodes, then every instruction.
 SET BREAK/INSTRUCTION=(MOVB,MOVC3)
 SHOW BREAK
breakpoint on instruction(s): 
 MOVB     MOVC3   
 GO
break on instruction(s) at DBGCMD\START\%LINE 42
    42:         MOVB    #^X41, WATCHB           ; writes the watched byte
 GO
break on instruction(s) at DBGCMD\START\%LINE 43
    43:         MOVC3   #16, SOURCE, BUFFER     ; writes 16 bytes at once
 CANCEL BREAK/INSTRUCTION
 SET BREAK/INSTRUCTION
 SHOW BREAK
breakpoint on instructions
 GO
break on instruction at DBGCMD\START\%LINE 44
    44:         JSB     BUMP                    ; a JSB subroutine
 GO
break on instruction at DBGCMD\FACT\BUMP
    64: BUMP:   INCL    WATCHL                  ; a JSB subroutine
 CANCEL BREAK/INSTRUCTION
 SHOW BREAK
%DEBUG-I-NOBREAKS, no breakpoints are set
 !
 ! To the end.
 SET BREAK LAST
 GO
%SYSTEM-W-ENDOFFILE, end of file
break on unhandled exception preceding DBGCMD\START\%LINE 48
    48:         PUSHAQ  MSG
 CANCEL BREAK/ALL
 GO
DBGCMD: done
%DEBUG-I-EXITSTATUS, is '%SYSTEM-S-NORMAL, normal successful completion'
%DEBUG-I-VERIFYICF, exiting command procedure BRKCLS.DBG
$   SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ ENDSUBROUTINE
$ CALL DEBUG STEP
$ DEBUG: SUBROUTINE
$   OPEN/WRITE DBGF RUN.DBG
$   WRITE DBGF "SET LOG STEP.DLG"
$   WRITE DBGF "SET OUTPUT LOG,VERIFY"
$   WRITE DBGF "@STEP.DBG"
$   WRITE DBGF "EXIT"
$   CLOSE DBGF
$   DEFINE/USER_MODE DBG$INPUT RUN.DBG
$   DEFINE/USER_MODE DBG$DECW$DISPLAY " "
$   RUN/DEBUG DBGCMD

         OpenVMS VAX DEBUG Version V7.1-000

%DEBUG-I-INITIAL, Language: MACRO, Module: DBGCMD
%DEBUG-I-VERIFYICF, entering command procedure STEP.DBG
 ! STEP.DBG - stepping (docs/PHASE-42.md, subtask 1): the default unit
 ! (a line), /INSTRUCTION, /INTO and /OVER, a count, STEP/OVER of a
 ! recursive call (which frame it stops in), /RETURN from a routine and
 ! from a JSB subroutine, /BRANCH, /CALL, /SILENT, /NOSOURCE, SET STEP's
 ! keywords, SHOW STEP after each, and stepping over a signal.
 !
 SHOW STEP
step type: source, nosilent, by line,
           over routine calls
 STEP
stepped to DBGCMD\START\%LINE 34
    34:         PUSHL   R2
 STEP/INSTRUCTION
stepped to DBGCMD\START\%LINE 35: CALLS    S^#01,L^DBGCMD\FACT
    35:         CALLS   #1, FACT                ; FACT(5), recursively
 !
 ! Into FACT, then through it an instruction at a time.
 STEP/INTO
stepped to routine DBGCMD\FACT
    54:         MOVL    4(AP), R2
 SHOW CALLS
 module name     routine name      line                rel PC           abs PC
*DBGCMD          FACT                54               00000002         00000470
*DBGCMD          START               35               0000000E         0000040E
 SET STEP INSTRUCTION
 SHOW STEP
step type: source, nosilent, by instruction,
           over routine calls
 STEP
stepped to DBGCMD\FACT\%LINE 55: CMPL     R2,S^#01
    55:         CMPL    R2, #1
 STEP
stepped to DBGCMD\FACT\%LINE 56: BGTR     DBGCMD\FACT\RECUR
    56:         BGTR    RECUR
 STEP 2
stepped to DBGCMD\FACT\%LINE 60: CALLS    S^#01,B^DBGCMD\FACT
    60:         CALLS   #1, FACT
 !
 ! At FACT's own CALLS: over the whole recursion, back in this frame.
 EXAMINE/INSTRUCTION .PC
DBGCMD\FACT\%LINE 60:   CALLS    S^#01,B^DBGCMD\FACT
 STEP/OVER
stepped to DBGCMD\FACT\BACK: MULL2    R2,R0
    61: BACK:   MULL2   R2, R0                  ; each FACT call returns here
 SHOW CALLS
 module name     routine name      line                rel PC           abs PC
*DBGCMD          FACT                61               00000017         00000485
*DBGCMD          FACT                60               00000017         00000485
*DBGCMD          FACT                60               00000017         00000485
*DBGCMD          FACT                60               00000017         00000485
*DBGCMD          START               35               0000000E         0000040E
 EXAMINE R0
DBGCMD\FACT\%R0:        00000001
 !
 ! Out of FACT, then on to the loop.
 STEP/RETURN
stepped on return from DBGCMD\FACT\BACK to DBGCMD\FACT\%LINE 62: RET     
    62:         RET
 SHOW CALLS
 module name     routine name      line                rel PC           abs PC
*DBGCMD          FACT                62               0000001A         00000488
*DBGCMD          FACT                60               00000017         00000485
*DBGCMD          FACT                60               00000017         00000485
*DBGCMD          FACT                60               00000017         00000485
*DBGCMD          START               35               0000000E         0000040E
 STEP
stepped to DBGCMD\FACT\BACK: MULL2    R2,R0
    61: BACK:   MULL2   R2, R0                  ; each FACT call returns here
 STEP/BRANCH
stepped to DBGCMD\START\%LINE 39: BLBS     L^DBGCMD\COUNT,DBGCMD\START\ODD
    39:         BLBS    COUNT, ODD
 STEP/BRANCH
stepped to DBGCMD\START\ODD: SOBGTR   R3,DBGCMD\START\LOOP
    41: ODD:    SOBGTR  R3, LOOP
 STEP/CALL
stepped to DBGCMD\START\%LINE 44: JSB      L^DBGCMD\FACT\BUMP
    44:         JSB     BUMP                    ; a JSB subroutine
 EXAMINE/INSTRUCTION .PC
DBGCMD\START\%LINE 44:  JSB      L^DBGCMD\FACT\BUMP
 !
 ! Into the JSB subroutine and out again.
 SET STEP INTO
 SHOW STEP
step type: source, nosilent, by instruction,
           into routine calls
 STEP
stepped to DBGCMD\FACT\BUMP: INCL     L^DBGCMD\WATCHL
    64: BUMP:   INCL    WATCHL                  ; a JSB subroutine
 SHOW CALLS
 module name     routine name      line                rel PC           abs PC
*DBGCMD          FACT                64               0000001B         00000489
 STEP/RETURN
%SYSTEM-W-ENDOFFILE, end of file
break on unhandled exception preceding DBGCMD\START\%LINE 48: PUSHAQ   L^00000230
    48:         PUSHAQ  MSG
 STEP
stepped to DBGCMD\START\%LINE 49: CALLS    S^#01,@L^HANDLR+1A1
    49:         CALLS   #1, G^LIB$PUT_OUTPUT
 SET STEP OVER
 !
 ! Quietly, and without source lines.
 STEP/SILENT
DBGCMD: done
 EXAMINE/INSTRUCTION .PC
DBGCMD\START\%LINE 50:  MOVL     S^#01,R0
 STEP/NOSOURCE
stepped to DBGCMD\START\LAST: RET     
 SET STEP NOSOURCE
 SHOW STEP
step type: nosource, nosilent, by instruction,
           over routine calls
 STEP
stepped on return from DBGCMD\FACT\BUMP to DBGCMD\START\LAST: RET     
 SET STEP SOURCE
 SET STEP LINE
 SHOW STEP
step type: source, nosilent, by line,
           over routine calls
 !
 ! Over the call that signals and handles a condition, then over the
 ! signal no one handles.
 STEP
%DEBUG-I-EXITSTATUS, is '%SYSTEM-S-NORMAL, normal successful completion'
 STEP
%DEBUG-E-BADSTARTPC, cannot start from PC 00000000
 STEP
%DEBUG-E-BADSTARTPC, cannot start from PC 00000000
 STEP
%DEBUG-E-BADSTARTPC, cannot start from PC 00000000
 STEP
%DEBUG-E-BADSTARTPC, cannot start from PC 00000000
 SHOW CALLS
%DEBUG-E-NOCALLS, no active call frames
 GO
%DEBUG-E-BADSTARTPC, cannot start from PC 00000000
