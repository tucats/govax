                                     0000     4 ; Checks the stack program and the mode byte MACRO writes for operand
                                     0000     5 ; modes other than relative when the linker must finish the value:
                                     0000     6 ; displacement (with no size, and L^), displacement deferred, immediate,
                                     0000     7 ; absolute, and relative indexed, with relocatable and external values.
                                     0000     8 ; The data checks negative constants in expressions left to the linker.
                                     0000     9 ; Assemble only: EXTOFF and EXTVAL are defined nowhere.
                                     0000    10 
                                 00000000    11 	.PSECT	DATA, WRT, NOEXE, LONG
00000004 00000003 00000002 00000001  0000    12 TABLE:	.LONG	1, 2, 3, 4
                           FFFFFFFC' 0010    13 	.LONG	EXTVAL+<-4>
                           00000000' 0014    14 	.LONG	EXTVAL*<-300>
                           FFFE7960' 0018    15 	.LONG	EXTVAL+<-100000>
                                     001C    16 
                                 00000000    17 	.PSECT	CODE, NOWRT, EXE, LONG
                               000C  0000    18 	.ENTRY	START, ^M<R2,R3>
                  50   0000'C2   D0  0002    19 	MOVL	TABLE(R2), R0
                  50   0000'C2   D0  0007    20 	MOVL	EXTOFF(R2), R0
              50   00000000'E2   D0  000C    21 	MOVL	L^TABLE(R2), R0
                  50   0000'D2   D0  0013    22 	MOVL	@TABLE(R2), R0
              50   00000000'8F   D0  0018    23 	MOVL	#TABLE, R0
              51   00000000'8F   D0  001F    24 	MOVL	#EXTVAL, R1
              52   00000000'9F   D0  0026    25 	MOVL	@#TABLE, R2
              53   00000000'9F   D0  002D    26 	MOVL	@#EXTVAL, R3
            50   00000000'EF42   D0  0034    27 	MOVL	TABLE[R2], R0
                                 04  003C    28 	RET
