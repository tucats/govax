
$ LIST = "DEFS,SHARE1,SHARE2,ADDR,EXTERN,EXPRS,MODES,GENERAL,GLOBALS"
$ I = 0
$ ASM:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO LINKS
$   MACRO/LIST DEFS
$   I = I + 1
$   GOTO ASM
$ ASM:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO LINKS
$   MACRO/LIST SHARE1
$   I = I + 1
$   GOTO ASM
$ ASM:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO LINKS
$   MACRO/LIST SHARE2
$   I = I + 1
$   GOTO ASM
$ ASM:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO LINKS
$   MACRO/LIST ADDR
$   I = I + 1
$   GOTO ASM
$ ASM:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO LINKS
$   MACRO/LIST EXTERN
$   I = I + 1
$   GOTO ASM
$ ASM:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO LINKS
$   MACRO/LIST EXPRS
$   I = I + 1
$   GOTO ASM
$ ASM:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO LINKS
$   MACRO/LIST MODES
$   I = I + 1
$   GOTO ASM
$ ASM:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO LINKS
$   MACRO/LIST GENERAL
$   I = I + 1
$   GOTO ASM
$ ASM:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO LINKS
$   MACRO/LIST GLOBALS
$   I = I + 1
$   GOTO ASM
$ ASM:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO LINKS
$ LINKS:
$ ! The Phase 27 fixtures with the module that defines their externals.
$ CALL LNK EXTERN  "EXTERN,DEFS"
$ LNK: SUBROUTINE
$   LINK/MAP=EXTERN.MAP/EXECUTABLE=EXTERN.EXE EXTERN,DEFS
$   SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$   IF F$SEARCH("EXTERN.EXE") .NES. "" THEN -
        ANALYZE/IMAGE/OUTPUT=EXTERN.ANI EXTERN.EXE
%ANALYZE-I-ERRORS, DUA1:[000000]EXTERN.EXE;1                               0 errors
$   EXIT
$ CALL LNK EXPRS   "EXPRS,DEFS"
$ LNK: SUBROUTINE
$   LINK/MAP=EXPRS.MAP/EXECUTABLE=EXPRS.EXE EXPRS,DEFS
%LINK-W-USRTFR, image DUA1:[000000]EXPRS.EXE;1 has no user transfer address
$   SHOW SYMBOL $STATUS
  $STATUS == "%X10648268"
$   IF F$SEARCH("EXPRS.EXE") .NES. "" THEN -
        ANALYZE/IMAGE/OUTPUT=EXPRS.ANI EXPRS.EXE
%ANALYZE-I-ERRORS, DUA1:[000000]EXPRS.EXE;1                                0 errors
$   EXIT
$ CALL LNK MODES   "MODES,DEFS"
$ LNK: SUBROUTINE
$   LINK/MAP=MODES.MAP/EXECUTABLE=MODES.EXE MODES,DEFS
$   SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$   IF F$SEARCH("MODES.EXE") .NES. "" THEN -
        ANALYZE/IMAGE/OUTPUT=MODES.ANI MODES.EXE
%ANALYZE-I-ERRORS, DUA1:[000000]MODES.EXE;1                                0 errors
$   EXIT
$ CALL LNK GENERAL "GENERAL,DEFS"
$ LNK: SUBROUTINE
$   LINK/MAP=GENERAL.MAP/EXECUTABLE=GENERAL.EXE GENERAL,DEFS
$   SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$   IF F$SEARCH("GENERAL.EXE") .NES. "" THEN -
        ANALYZE/IMAGE/OUTPUT=GENERAL.ANI GENERAL.EXE
%ANALYZE-I-ERRORS, DUA1:[000000]GENERAL.EXE;1                              0 errors
$   EXIT
$ CALL LNK GLOBALS "GLOBALS,DEFS"
$ LNK: SUBROUTINE
$   LINK/MAP=GLOBALS.MAP/EXECUTABLE=GLOBALS.EXE GLOBALS,DEFS
%LINK-W-USRTFR, image DUA1:[000000]GLOBALS.EXE;1 has no user transfer address
$   SHOW SYMBOL $STATUS
  $STATUS == "%X10648268"
$   IF F$SEARCH("GLOBALS.EXE") .NES. "" THEN -
        ANALYZE/IMAGE/OUTPUT=GLOBALS.ANI GLOBALS.EXE
%ANALYZE-I-ERRORS, DUA1:[000000]GLOBALS.EXE;1                              0 errors
$   EXIT
$ ! Undefined symbols: EXTERN alone.
$ CALL LNK EXTERNU "EXTERN"
$ LNK: SUBROUTINE
$   LINK/MAP=EXTERNU.MAP/EXECUTABLE=EXTERNU.EXE EXTERN
%LINK-W-NUDFSYMS, 2 undefined symbols:
%LINK-I-UDFSYM, 	EXTDATA 
%LINK-I-UDFSYM, 	SUB_ONE 
%LINK-W-USEUNDEF, undefined symbol SUB_ONE referenced
	in psect CODE offset %X00000004
	in module EXTERN file DUA1:[000000]EXTERN.OBJ;1
%LINK-W-USEUNDEF, undefined symbol SUB_ONE referenced
	in psect CODE offset %X0000000B
	in module EXTERN file DUA1:[000000]EXTERN.OBJ;1
%LINK-W-USEUNDEF, undefined symbol EXTDATA referenced
	in psect CODE offset %X00000011
	in module EXTERN file DUA1:[000000]EXTERN.OBJ;1
%LINK-W-USEUNDEF, undefined symbol EXTDATA referenced
	in psect CODE offset %X00000018
	in module EXTERN file DUA1:[000000]EXTERN.OBJ;1
%LINK-W-USEUNDEF, undefined symbol EXTDATA referenced
	in psect CODE offset %X0000001F
	in module EXTERN file DUA1:[000000]EXTERN.OBJ;1
$   SHOW SYMBOL $STATUS
  $STATUS == "%X10648268"
$   IF F$SEARCH("EXTERNU.EXE") .NES. "" THEN -
        ANALYZE/IMAGE/OUTPUT=EXTERNU.ANI EXTERNU.EXE
%ANALYZE-I-ERRORS, DUA1:[000000]EXTERNU.EXE;1                              0 errors
$   EXIT
$ ! A user object library, searched.
$ LIBRARY/CREATE/OBJECT MYLIB DEFS
$ CALL LNK EXTERNL "EXTERN,MYLIB/LIBRARY"
$ LNK: SUBROUTINE
$   LINK/MAP=EXTERNL.MAP/EXECUTABLE=EXTERNL.EXE EXTERN,MYLIB/LIBRARY
$   SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$   IF F$SEARCH("EXTERNL.EXE") .NES. "" THEN -
        ANALYZE/IMAGE/OUTPUT=EXTERNL.ANI EXTERNL.EXE
%ANALYZE-I-ERRORS, DUA1:[000000]EXTERNL.EXE;1                              0 errors
$   EXIT
$ ! Psects shared across modules, in both orders.
$ CALL LNK SHARE   "SHARE1,SHARE2"
$ LNK: SUBROUTINE
$   LINK/MAP=SHARE.MAP/EXECUTABLE=SHARE.EXE SHARE1,SHARE2
$   SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$   IF F$SEARCH("SHARE.EXE") .NES. "" THEN -
        ANALYZE/IMAGE/OUTPUT=SHARE.ANI SHARE.EXE
%ANALYZE-I-ERRORS, DUA1:[000000]SHARE.EXE;1                                0 errors
$   EXIT
$ CALL LNK SHARER  "SHARE2,SHARE1"
$ LNK: SUBROUTINE
$   LINK/MAP=SHARER.MAP/EXECUTABLE=SHARER.EXE SHARE2,SHARE1
$   SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$   IF F$SEARCH("SHARER.EXE") .NES. "" THEN -
        ANALYZE/IMAGE/OUTPUT=SHARER.ANI SHARER.EXE
%ANALYZE-I-ERRORS, DUA1:[000000]SHARER.EXE;1                               0 errors
$   EXIT
$ ! .ADDRESS of a shareable image routine.
$ CALL LNK ADDR    "ADDR"
$ LNK: SUBROUTINE
$   LINK/MAP=ADDR.MAP/EXECUTABLE=ADDR.EXE ADDR
$   SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$   IF F$SEARCH("ADDR.EXE") .NES. "" THEN -
        ANALYZE/IMAGE/OUTPUT=ADDR.ANI ADDR.EXE
%ANALYZE-I-ERRORS, DUA1:[000000]ADDR.EXE;1                                 0 errors
$   EXIT
$ ! An options file.
$ CALL LNK PROG    "PROG/OPTIONS"
$ LNK: SUBROUTINE
$   LINK/MAP=PROG.MAP/EXECUTABLE=PROG.EXE PROG/OPTIONS
! Link fixture: an options file
SHARE1, SHARE2		! the program
STACK=30
IDENTIFICATION="V9"
SYMBOL=LIMIT,41
$   SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$   IF F$SEARCH("PROG.EXE") .NES. "" THEN -
        ANALYZE/IMAGE/OUTPUT=PROG.ANI PROG.EXE
%ANALYZE-I-ERRORS, DUA1:[000000]PROG.EXE;1                                 0 errors
$   EXIT
$ ! The complete programs.
$ RUN SHARE
%SYSTEM-F-BADATTRIB, bad attribute control list
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00000034"
$ RUN SHARER
%SYSTEM-F-BADATTRIB, bad attribute control list
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00000034"
$ RUN ADDR
Called through .ADDRESS
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00000001"
$ RUN PROG
%SYSTEM-F-BADATTRIB, bad attribute control list
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00000034"
$ DIRECTORY/FULL/OUTPUT=FILES.LST *.OBJ,*.OLB,*.EXE,*.MAP
$ SET NOVERIFY