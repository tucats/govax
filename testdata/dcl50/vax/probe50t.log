$ ! one per P1, run by PROBE50T.COM. Each case ends with EXIT (or ends
$ ! the procedure some other way, which is what it asks about).
$ GOTO SUBEXIT
%DCL-E-INVIFNEST, invalid IF-THEN-ELSE nesting structure or data inconsistency
$ SUBEXIT:
$ WRITE SYS$OUTPUT "SUBEXIT: depth ", F$ENVIRONMENT("DEPTH")
SUBEXIT: depth 1
$ EXIT 3
%DCL-S-RETURNED, control returned to process SYSTEM
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00000003"
$ SPAWN FROBNICATE
%DCL-S-SPAWNED, process SYSTEM_1 spawned
%DCL-S-ATTACHED, terminal now attached to process SYSTEM_1
%DCL-W-IVVERB, unrecognized command verb - check validity and spelling
 \FROBNICATE\
%DCL-S-RETURNED, control returned to process SYSTEM
%DCL-W-IVVERB, unrecognized command verb - check validity and spelling
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00038090"
$ M = "END"
$ SHOW SYMBOL M
  M = "END"
$ EXIT
