$ !
$ ! T5: a subprocess's DCL (subtask 19): SPAWN of a command, STOP in a
$ ! subprocess's procedure, and EXIT n from one: what each prints, and
$ ! $STATUS after the SPAWN.
$ M = "T5"
$ SHOW SYMBOL M
  M = "T5"
$ SPAWN WRITE SYS$OUTPUT "T5 depth ", F$ENVIRONMENT("DEPTH")
%DCL-S-SPAWNED, process SYSTEM_1 spawned
%DCL-S-ATTACHED, terminal now attached to process SYSTEM_1
T5 depth 0
%DCL-S-RETURNED, control returned to process SYSTEM
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00010001"
$ SPAWN @PROBE50U SUBSTOP
%DCL-S-SPAWNED, process SYSTEM_1 spawned
%DCL-S-ATTACHED, terminal now attached to process SYSTEM_1
$ ! PROBE50U.COM - round 5's nested cases (testdata/dcl50/README.md),
$ ! one per P1, run by PROBE50T.COM. Each case ends with EXIT (or ends
$ ! the procedure some other way, which is what it asks about).
$ GOTO SUBSTOP
%DCL-E-INVIFNEST, invalid IF-THEN-ELSE nesting structure or data inconsistency
$ SUBSTOP:
$ WRITE SYS$OUTPUT "SUBSTOP: before"
SUBSTOP: before
$ STOP
%DCL-S-RETURNED, control returned to process SYSTEM
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00010001"
$ SPAWN @PROBE50U SUBEXIT
%DCL-S-SPAWNED, process SYSTEM_1 spawned
%DCL-S-ATTACHED, terminal now attached to process SYSTEM_1
