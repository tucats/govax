$ !
$ ! T1: statuses and ON (DEVIATIONS.md's "[Phase 50] Statuses and ON").
$ M = "T1"
$ SHOW SYMBOL M
  M = "T1"
$ @PROBE50U EXITOK
$ ! PROBE50U.COM - round 5's nested cases (testdata/dcl50/README.md),
$ ! one per P1, run by PROBE50T.COM. Each case ends with EXIT (or ends
$ ! the procedure some other way, which is what it asks about).
$ GOTO EXITOK
$ EXITOK:
$ X = 1
$ EXIT
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10030001"
$ @PROBE50U ONGOTO
$ ! PROBE50U.COM - round 5's nested cases (testdata/dcl50/README.md),
$ ! one per P1, run by PROBE50T.COM. Each case ends with EXIT (or ends
$ ! the procedure some other way, which is what it asks about).
$ GOTO ONGOTO
$ ONGOTO:
$ ON ERROR THEN GOTO ONGOTO_L
$ OPEN/READ F NOSUCH.DAT
%DCL-E-OPENIN, error opening DUA1:[000000]NOSUCH.DAT; as input
-RMS-E-FNF, file not found
$ ONGOTO_L:
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10018292"
$ EXIT
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10018292"
$ @PROBE50U ONSUBST
$ ! PROBE50U.COM - round 5's nested cases (testdata/dcl50/README.md),
$ ! one per P1, run by PROBE50T.COM. Each case ends with EXIT (or ends
$ ! the procedure some other way, which is what it asks about).
$ GOTO ONSUBST
$ ONSUBST:
$ V = "first"
$ ON WARNING THEN WRITE SYS$OUTPUT "ONSUBST: V is first"
$ V = "second"
$ FROBNICATE
%DCL-W-IVVERB, unrecognized command verb - check validity and spelling
 \FROBNICATE\
ONSUBST: V is first
$ EXIT
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10010001"
$ @PROBE50U ONSEV
$ ! PROBE50U.COM - round 5's nested cases (testdata/dcl50/README.md),
$ ! one per P1, run by PROBE50T.COM. Each case ends with EXIT (or ends
$ ! the procedure some other way, which is what it asks about).
$ GOTO ONSEV
$ ONSEV:
$ WRITE SYS$OUTPUT "ONSEV default: ", F$ENVIRONMENT("ON_SEVERITY")
ONSEV default: ERROR
$ ON WARNING THEN CONTINUE
$ WRITE SYS$OUTPUT "ONSEV warning: ", F$ENVIRONMENT("ON_SEVERITY")
ONSEV warning: WARNING
$ ON SEVERE_ERROR THEN CONTINUE
$ WRITE SYS$OUTPUT "ONSEV severe: ", F$ENVIRONMENT("ON_SEVERITY")
ONSEV severe: SEVERE
$ SET NOON
$ ON CONTROL_Y THEN EXIT
$ WRITE SYS$OUTPUT "ONSEV noon, control_y: ", F$ENVIRONMENT("ON_SEVERITY"), " ", F$ENVIRONMENT("ON_CONTROL_Y")
ONSEV noon, control_y: NONE TRUE
$ OPEN/READ F NOSUCH.DAT
%DCL-E-OPENIN, error opening DUA1:[000000]NOSUCH.DAT; as input
-RMS-E-FNF, file not found
$ WRITE SYS$OUTPUT "ONSEV: still here after an error"
ONSEV: still here after an error
$ ON ERROR THEN CONTINUE
$ WRITE SYS$OUTPUT "ONSEV after ON ERROR: ", F$ENVIRONMENT("ON_SEVERITY")
ONSEV after ON ERROR: ERROR
$ EXIT
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10010001"
$ @PROBE50U SKPDAT
$ ! PROBE50U.COM - round 5's nested cases (testdata/dcl50/README.md),
$ ! one per P1, run by PROBE50T.COM. Each case ends with EXIT (or ends
$ ! the procedure some other way, which is what it asks about).
$ GOTO SKPDAT
$ SKPDAT:
$ ON WARNING THEN GOTO SKPDAT_L
$ DIRECTORY PROBE50U.COM

Directory DUA1:[000000]

PROBE50U.COM;1      

Total of 1 file.
%DCL-W-SKPDAT, image data (records not beginning with "$") ignored
$ SKPDAT_L:
$ WRITE SYS$OUTPUT "SKPDAT: action taken"
SKPDAT: action taken
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00010001"
$ EXIT
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10010001"
$ ON FOO THEN WRITE SYS$OUTPUT "foo"
%DCL-W-ONERR, invalid ON condition - use WARNING, SEVERE, ERROR, or CONTROL_Y
 \ FOO\
$ SHOW SYMBOL $STATUS
  $STATUS == "%X000380F8"
$ @PROBE50U EXIT34
$ ! PROBE50U.COM - round 5's nested cases (testdata/dcl50/README.md),
$ ! one per P1, run by PROBE50T.COM. Each case ends with EXIT (or ends
$ ! the procedure some other way, which is what it asks about).
$ GOTO EXIT34
$ EXIT34:
$ EXIT 3 4
%DCL-W-EXPSYN, invalid expression syntax - check operators and operands
$ WRITE SYS$OUTPUT "EXIT34: still here"
EXIT34: still here
$ EXIT
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10010001"
$ @PROBE50U/OUTPUT=PROBE50N.LOG EXITMSG
%SYSTEM-F-ABORT, abort
$ SHOW SYMBOL $STATUS
  $STATUS == "%X0000002C"
$ TYPE PROBE50N.LOG
$ ! PROBE50U.COM - round 5's nested cases (testdata/dcl50/README.md),
$ ! one per P1, run by PROBE50T.COM. Each case ends with EXIT (or ends
$ ! the procedure some other way, which is what it asks about).
$ GOTO EXITMSG
$ EXITMSG:
$ WRITE SYS$OUTPUT "EXITMSG: in the log"
EXITMSG: in the log
$ EXIT 44
$ DIRECTORY PROBE50T.COM

Directory DUA1:[000000]

PROBE50T.COM;1      

Total of 1 file.
