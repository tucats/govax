                                     0000     1 	.TITLE	MAIN2 - a program that uses SHR2, which uses SHR1 (Phase 68 probe)
                                     0000     2 	.IDENT	/V2.0/
                                     0000     3 ;
                                     0000     4 ; SAY ctl[,a,b,c] formats a line with $FAO (CTL is a .ASCID control
                                     0000     5 ; string, A to C its arguments, pushed as longwords) and writes it with
                                     0000     6 ; LIB$PUT_OUTPUT. It uses only the system service and LIBRTL entry
                                     0000     7 ; points, through G^, and changes R0 and R1.
                                     0000     8 ;
                                     0000     9 	.MACRO	SAY	CTL,A=#0,B=#0,C=#0
                                     0000    10 	PUSHL	C
                                     0000    11 	PUSHL	B
                                     0000    12 	PUSHL	A
                                     0000    13 	PUSHAQ	BUFD
                                     0000    14 	PUSHAW	OUTD
                                     0000    15 	PUSHAQ	CTL
                                     0000    16 	CALLS	#6,G^SYS$FAO
                                     0000    17 	PUSHAQ	OUTD
                                     0000    18 	CALLS	#1,G^LIB$PUT_OUTPUT
                                     0000    19 	.ENDM	SAY
                                     0000    20 
