                                     0000     1 	.TITLE	MAIN6 - a program that uses SHR6 (Phase 68 probe)
                                     0000     2 	.IDENT	/V6.0/
                                     0000     3 ;
                                     0000     4 ; SAY ctl[,a,b,c] formats a line with $FAO (CTL is a .ASCID control
                                     0000     5 ; string, A to C its arguments, pushed as longwords) and writes it with
                                     0000     6 ; LIB$PUT_OUTPUT. It uses only the system service and LIBRTL entry
                                     0000     7 ; points, through G^, and changes R0 and R1.
                                     0000     8 ;
                                     0000     9 	.MACRO	SAY	CTL,A=#0,B=#0,C=#0
                                     0000    10 	PUSHL	C
                                     0000    11 	PUSHL	B
                                     0000    12 	PUSHL	A
                                     0000    13 	PUSHAQ	BUFD
                                     0000    14 	PUSHAW	OUTD
                                     0000    15 	PUSHAQ	CTL
                                     0000    16 	CALLS	#6,G^SYS$FAO
                                     0000    17 	PUSHAQ	OUTD
                                     0000    18 	CALLS	#1,G^LIB$PUT_OUTPUT
                                     0000    19 	.ENDM	SAY
                                     0000    20 
                                 00000000    21 	.PSECT	SAY_DATA,WRT,NOEXE,LONG
                           00000084  0000    22 BUF:	.BLKB	132
                               0084  0084    23 BUFD:	.WORD	132
                              01 0E  0086    24 	.BYTE	14,1
                           00000000' 0088    25 	.ADDRESS BUF
                               0000  008C    26 OUTD:	.WORD	0
                              01 0E  008E    27 	.BYTE	14,1
                           00000000' 0090    28 	.ADDRESS BUF
                                     0094    29 
                                 00000000    30 	.PSECT	MAIN_DATA,WRT,NOEXE,LONG
3A 36 4E 49 41 4D 00000008'010E0000' 0000    31 F_GET:	.ASCID	/MAIN6: SHR6_GET() !SL/
20 29 28 54 45 47 5F 36 52 48 53 20  000E       
                           4C 53 21  001A       
                                     001D    32 
                                 00000000    33 	.PSECT	MAIN_CODE,NOWRT,EXE,LONG
                               0004  0000    34 	.ENTRY	MAIN6,^M<R2>
              00000000'GF   00   FB  0002    35 	CALLS	#0,G^SHR6_GET
                       52   50   D0  0009    36 	MOVL	R0,R2
                                     000C    37 	SAY	F_GET,R2
                       50   01   D0  0038    38 	MOVL	#1,R0
                                 04  003B    39 	RET
                                     003C    40 
                                     003C    41 	.END	MAIN6
