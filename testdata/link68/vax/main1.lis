                               0084  0084    29 BUFD:	.WORD	132
                              01 0E  0086    30 	.BYTE	14,1
                           00000000' 0088    31 	.ADDRESS BUF
                               0000  008C    32 OUTD:	.WORD	0
                              01 0E  008E    33 	.BYTE	14,1
                           00000000' 0090    34 	.ADDRESS BUF
                                     0094    35 
                                 00000000    36 	.PSECT	MAIN_DATA,WRT,NOEXE,LONG
                           00000000  0000    37 ORIGIN:	.LONG	0
