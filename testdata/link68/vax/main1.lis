                                     0000     1 	.TITLE	MAIN1 - a program that uses SHR1 (Phase 68 probe)
                                     0000     2 	.IDENT	/V1.0/
                                     0000     3 ;
                                     0000     4 ; Calls SHR1's routines and reads its data, through G^ and .ADDRESS.
                                     0000     5 ; SHR1's addresses show as offsets from SHR1_ORIGIN (SHR1_BASE's
                                     0000     6 ; answer), which shows once, absolute, as does MAIN1's own entry.
                                     0000     7 ; Linked against SHR1 (MAIN1, MAIN1N, MAIN1L, MAIN1U), SHR1A (MAIN1A),
                                     0000     8 ; and SHR4 (MAIN4).
                                     0000     9 ;
                                     0000    10 ; SAY ctl[,a,b,c] formats a line with $FAO (CTL is a .ASCID control
                                     0000    11 ; string, A to C its arguments, pushed as longwords) and writes it with
                                     0000    12 ; LIB$PUT_OUTPUT. It uses only the system service and LIBRTL entry
                                     0000    13 ; points, through G^, and changes R0 and R1.
                                     0000    14 ;
                                     0000    15 	.MACRO	SAY	CTL,A=#0,B=#0,C=#0
                                     0000    16 	PUSHL	C
                                     0000    17 	PUSHL	B
                                     0000    18 	PUSHL	A
                                     0000    19 	PUSHAQ	BUFD
                                     0000    20 	PUSHAW	OUTD
                                     0000    21 	PUSHAQ	CTL
                                     0000    22 	CALLS	#6,G^SYS$FAO
                                     0000    23 	PUSHAQ	OUTD
                                     0000    24 	CALLS	#1,G^LIB$PUT_OUTPUT
                                     0000    25 	.ENDM	SAY
                                     0000    26 
                                 00000000    27 	.PSECT	SAY_DATA,WRT,NOEXE,LONG
