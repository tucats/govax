                           00000000' 0004    39 	.ADDRESS SHR1_ADD		; a .ADDRESS of a routine in SHR1
                                     0008    40 ADDR_TAB:
                           00000000' 0008    41 	.ADDRESS SHR1_TABLE		; and of its data
