                                     0000     1 	.TITLE	XFR1 - SHR1's transfer vector (Phase 68 probe)
                                     0000     2 	.IDENT	/V1.0/
                                     0000     3 ;
                                     0000     4 ; The transfer vector for SHR1, which LINK68.COM links first in a
                                     0000     5 ; cluster of its own (SHR1.OPT's CLUSTER=). Each entry is 8 bytes:
                                     0000     6 ; .TRANSFER (no bytes; an instruction to the linker), then a CALL
                                     0000     7 ; entry's register save mask and a jump past the routine's own mask,
                                     0000     8 ; or a JSB entry's jump and 2 bytes of padding (the Linker manual,
                                     0000     9 ; Examples 4-1 and 4-2).
                                     0000    10 ;
                                 00000000    11 	.PSECT	$$XFR1,EXE,NOWRT,PIC,SHR,GBL,PAGE
                                     0000    12 
                                     0000    13 	.TRANSFER SHR1_BASE		; a CALL entry in SHR1.MAR
                               0000' 0000    14 	.MASK	SHR1_BASE
                   00000002'EF   17  0002    15 	JMP	L^SHR1_BASE+2
                                     0008    16 
                                     0008    17 	.TRANSFER SHR1_ADD		; a mask ORed with more registers
                               0030' 0008    18 	.MASK	SHR1_ADD,^M<R4,R5>
                   00000002'EF   17  000A    19 	JMP	L^SHR1_ADD+2
                                     0010    20 
                                     0010    21 	.TRANSFER SHR1_JSB		; a JSB entry
                   00000000'EF   17  0010    22 	JMP	L^SHR1_JSB
                           00000018  0016    23 	.BLKB	2
                                     0018    24 
                                     0018    25 	.TRANSFER SHR1_SHOW
                               0000' 0018    26 	.MASK	SHR1_SHOW
                   00000002'EF   17  001A    27 	JMP	L^SHR1_SHOW+2
                                     0020    28 
                                     0020    29 	.TRANSFER SHR1_LOCAL		; defined later in this module
                               0000' 0020    30 	.MASK	SHR1_LOCAL
                          FFDD'  31  0022    31 	BRW	SHR1_LOCAL+2		; the MACRO manual's branch
                           00000028  0025    32 	.BLKB	3
                                     0028    33 
                           00000048  0028    34 	.BLKB	32			; room for later vectors
                                     0048    35 
                                 00000000    36 	.PSECT	XFR1_CODE,NOWRT,EXE,PIC,SHR,LONG
                                     0000    37 
                               0000  0000    38 	.ENTRY	SHR1_LOCAL,^M<>
                       50   11   D0  0002    39 	MOVL	#17,R0
                                 04  0005    40 	RET
                                     0006    41 
                                     0006    42 	.END
