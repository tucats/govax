                                     0000     2 	.IDENT	/V1.0/
                                     0000     3 ;
                                     0000     4 ; The routines XFR1's transfer vector leads to, and their data:
                                     0000     5 ;
                                     0000     6 ;   SHR1_BASE	returns SHR1_ORIGIN's address (the first byte of
                                     0000     7 ;		SHR1_CODE), from which MAIN1 measures SHR1's addresses
                                     0000     8 ;   SHR1_ADD	returns its two arguments' sum
                                     0000     9 ;   SHR1_JSB	R0 = R0*2+1 (a JSB entry)
                                     0000    10 ;   SHR1_SHOW	writes its argument with LIB$PUT_OUTPUT, then whether
                                     0000    11 ;		the .ADDRESS of its own table (a self-relative fixup)
                                     0000    12 ;		holds the table's address
                                     0000    13 ;
                                     0000    14 ; Each counts its calls in SHR1_COUNT, universal data. SHR1_TABLE is
                                     0000    15 ; read-only, shared, universal data. SHR1_ZERO is never stored in.
                                     0000    16 ;
