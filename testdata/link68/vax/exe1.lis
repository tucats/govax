                                     0000     1 	.TITLE	EXE1 - an executable laid out by options (Phase 68 probe)
                                     0000     2 	.IDENT	/V1.0/
                                     0000     3 ;
                                     0000     4 ; Linked with BASE=, CLUSTER= (EXE1B in a cluster of its own),
                                     0000     5 ; COLLECT=, PSECT_ATTR=, IOSEGMENT=, DZRO_MIN=, and ISD_MAX=, from
                                     0000     6 ; SYS$INPUT. Shows where each psect landed, absolute.
                                     0000     7 ;
                                     0000     8 ; SAY ctl[,a,b,c] formats a line with $FAO (CTL is a .ASCID control
                                     0000     9 ; string, A to C its arguments, pushed as longwords) and writes it with
                                     0000    10 ; LIB$PUT_OUTPUT. It uses only the system service and LIBRTL entry
                                     0000    11 ; points, through G^, and changes R0 and R1.
                                     0000    12 ;
                                     0000    13 	.MACRO	SAY	CTL,A=#0,B=#0,C=#0
                                     0000    14 	PUSHL	C
                                     0000    15 	PUSHL	B
                                     0000    16 	PUSHL	A
                                     0000    17 	PUSHAQ	BUFD
                                     0000    18 	PUSHAW	OUTD
                                     0000    19 	PUSHAQ	CTL
                                     0000    20 	CALLS	#6,G^SYS$FAO
                                     0000    21 	PUSHAQ	OUTD
                                     0000    22 	CALLS	#1,G^LIB$PUT_OUTPUT
                                     0000    23 	.ENDM	SAY
                                     0000    24 
