$ WRITE SYS$OUTPUT F$GETSYI("VERSION"), " ", F$GETSYI("HW_NAME")
V7.1     VAX 8600
$ HERE = F$ENVIRONMENT("DEFAULT")
$ RELINKS == 0
$ SHOW LOGICAL SYS$SHARE
   "SYS$SHARE" = "SYS$SYSROOT:[SYSLIB]" (LNM$SYSTEM_TABLE)
$ !
$ ! The sources.
$ !
$ LIST = "XFR1,SHR1,SHR2,SHR3,SHR6,MAIN1,MAIN2,MAIN3,MAIN6,EXE1,EXE1B"
$ I = 0
$ ASM:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO LINKS
$   MACRO/LIST XFR1.MAR
$   SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$   I = I + 1
$   GOTO ASM
$ ASM:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO LINKS
$   MACRO/LIST SHR1.MAR
$   SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$   I = I + 1
$   GOTO ASM
$ ASM:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO LINKS
$   MACRO/LIST SHR2.MAR
$   SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$   I = I + 1
$   GOTO ASM
$ ASM:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO LINKS
$   MACRO/LIST SHR3.MAR
$   SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$   I = I + 1
$   GOTO ASM
$ ASM:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO LINKS
$   MACRO/LIST SHR6.MAR
$   SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$   I = I + 1
$   GOTO ASM
$ ASM:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO LINKS
$   MACRO/LIST MAIN1.MAR
$   SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$   I = I + 1
$   GOTO ASM
$ ASM:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO LINKS
$   MACRO/LIST MAIN2.MAR
$   SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$   I = I + 1
$   GOTO ASM
$ ASM:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO LINKS
$   MACRO/LIST MAIN3.MAR
$   SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$   I = I + 1
$   GOTO ASM
$ ASM:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO LINKS
$   MACRO/LIST MAIN6.MAR
$   SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$   I = I + 1
$   GOTO ASM
$ ASM:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO LINKS
$   MACRO/LIST EXE1.MAR
$   SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$   I = I + 1
$   GOTO ASM
$ ASM:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO LINKS
$   MACRO/LIST EXE1B.MAR
$   SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$   I = I + 1
$   GOTO ASM
$ ASM:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO LINKS
$ LINKS:
$ ANALYZE/OBJECT/OUTPUT=XFR1.ANL XFR1.OBJ
%ANALYZE-I-ERRORS, DUA1:[000000]XFR1.OBJ;1                                 0 errors
$ !
$ ! SHR1: a transfer vector cluster first, from an options file, with
$ ! GSMATCH= from a second options file; its symbol table as SHR1.STB.
$ !
$ OPEN/WRITE OPT GSM.OPT
$ WRITE OPT "GSMATCH=LEQUAL,1,1000"
$ CLOSE OPT
$ LINK/SHAREABLE=SHR1/MAP=SHR1/FULL/SYMBOL_TABLE=SHR1 SHR1.OPT/OPTIONS,GSM.OPT/OPTIONS
! SHR1.OPT - SHR1's options (testdata/link68/README.md): the transfer
! vector in a cluster of its own, first; the library; the universal
! data. GSMATCH= comes from a second options file.
CLUSTER=SHR1_VECTORS,,,XFR1.OBJ
SHR1.OBJ
UNIVERSAL=SHR1_COUNT,SHR1_TABLE,SHR1_ORIGIN
GSMATCH=LEQUAL,1,1000
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ CALL ANI SHR1
$ ANI: SUBROUTINE
$   IF F$SEARCH("SHR1.EXE") .NES. "" THEN -
        ANALYZE/IMAGE/OUTPUT=SHR1.ANI SHR1.EXE
%ANALYZE-I-ERRORS, DUA1:[000000]SHR1.EXE;1                                 0 errors
$   EXIT
$ !
$ ! MAIN1 against SHR1.
$ !
$ LINK/MAP=MAIN1/FULL MAIN1.OBJ,SYS$INPUT/OPTIONS
SHR1/SHAREABLE
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ CALL ANI MAIN1
$ ANI: SUBROUTINE
$   IF F$SEARCH("MAIN1.EXE") .NES. "" THEN -
        ANALYZE/IMAGE/OUTPUT=MAIN1.ANI MAIN1.EXE
%ANALYZE-I-ERRORS, DUA1:[000000]MAIN1.EXE;1                                0 errors
$   EXIT
$ !
$ ! R1: SHR1 found through a logical name.
$ !
$ DEFINE SHR1 DUA1:[000000]SHR1.EXE
$ RUN MAIN1
MAIN1: SHR1_ORIGIN 00023A00, MAIN1 00000400
MAIN1: SHR1_ADD(3,4) 7, SHR1_COUNT 1
MAIN1: SHR1_JSB(5) 11
MAIN1: G^SHR1_ADD origin+FFFFFC08, .ADDRESS origin+FFFFFC08
MAIN1: G^SHR1_TABLE origin+FFFFFE00 holds 11111111, .ADDRESS origin+FFFFFE00
MAIN1: hello, through SHR1_SHOW
SHR1: the .ADDRESS of its own table is right
MAIN1: G^SHR1_COUNT origin+00000200 holds 3
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00000001"
$ !
$ ! R2: the logical name has no device and no type.
$ !
$ DEFINE SHR1 [000000]SHR1
%DCL-I-SUPERSEDE, previous value of SHR1 has been superseded
$ RUN MAIN1
%DCL-W-ACTIMAGE, error activating image SHR1
-CLI-E-IMAGEFNF, image file not found SIMVAX$DUA0:[SYS0.SYSCOMMON.][000000]SHR1.EXE;
$ SHOW SYMBOL $STATUS
  $STATUS == "%X100388B2"
$ !
$ ! R3: no logical name, and no SYS$SHARE:SHR1.EXE.
$ !
$ DEASSIGN SHR1
$ RUN MAIN1
%DCL-W-ACTIMAGE, error activating image SHR1
-CLI-E-IMAGEFNF, image file not found SIMVAX$DUA0:[SYS0.SYSCOMMON.][SYSLIB]SHR1.EXE;
$ SHOW SYMBOL $STATUS
  $STATUS == "%X100388B2"
$ !
$ ! R4: SYS$SHARE a process search list, SHR1.EXE in its first place.
$ !
$ CREATE/DIRECTORY [.SHRDIR]
$ COPY SHR1.EXE [.SHRDIR]
$ SHRDIR = F$PARSE("[.SHRDIR]",,,"DEVICE") + F$PARSE("[.SHRDIR]",,,"DIRECTORY")
$ OLD = F$TRNLNM("SYS$SHARE")
$ IF OLD .EQS. "" THEN OLD = "SYS$SYSROOT:[SYSLIB]"
$ DEFINE SYS$SHARE DUA1:[000000.SHRDIR],SYS$SYSROOT:[SYSLIB]
$ SHOW LOGICAL SYS$SHARE
   "SYS$SHARE" = "DUA1:[000000.SHRDIR]" (LNM$PROCESS_TABLE)
	= "SYS$SYSROOT:[SYSLIB]"
   "SYS$SHARE" = "SYS$SYSROOT:[SYSLIB]" (LNM$SYSTEM_TABLE)
$ RUN MAIN1
MAIN1: SHR1_ORIGIN 00023A00, MAIN1 00000400
MAIN1: SHR1_ADD(3,4) 7, SHR1_COUNT 1
MAIN1: SHR1_JSB(5) 11
MAIN1: G^SHR1_ADD origin+FFFFFC08, .ADDRESS origin+FFFFFC08
MAIN1: G^SHR1_TABLE origin+FFFFFE00 holds 11111111, .ADDRESS origin+FFFFFE00
MAIN1: hello, through SHR1_SHOW
SHR1: the .ADDRESS of its own table is right
MAIN1: G^SHR1_COUNT origin+00000200 holds 3
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00000001"
$ DEASSIGN SYS$SHARE
$ !
