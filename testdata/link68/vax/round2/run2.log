$ RUNS:
$ !
$ ! The runs: each of govax's programs against govax's shareable
$ ! images, found through logical names, as in LINK68.COM. SHR1 is the
$ ! last relink (LEQUAL,1,1000), SHR4 the ALWAYS,7,7 relink, and SHR1A
$ ! the relink MAIN1A doesn't match.
$ !
$ DEFINE SHR1 DUA1:[000000]SHR1.EXE
$ DEFINE SHR1A DUA1:[000000]SHR1A.EXE
$ DEFINE SHR2 DUA1:[000000]SHR2.EXE
$ DEFINE SHR3 DUA1:[000000]SHR3.EXE
$ DEFINE SHR3P DUA1:[000000]SHR3P.EXE
$ DEFINE SHR4 DUA1:[000000]SHR4.EXE
$ DEFINE SHR6 DUA1:[000000]SHR6.EXE
$ LIST = "MAIN1,MAIN1N,MAIN1L,MAIN1U,MAIN1A,MAIN2,MAIN3,MAIN3P,MAIN4,MAIN6,EXE1"
$ I = 0
$ RUN:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO LINKS
$   RUN MAIN1
MAIN1: SHR1_ORIGIN 00023A00, MAIN1 00000400
MAIN1: SHR1_ADD(3,4) 7, SHR1_COUNT 1
MAIN1: SHR1_JSB(5) 11
MAIN1: G^SHR1_ADD origin+FFFFFC08, .ADDRESS origin+FFFFFC08
MAIN1: G^SHR1_TABLE origin+FFFFFE00 holds 11111111, .ADDRESS origin+FFFFFE00
MAIN1: hello, through SHR1_SHOW
SHR1: the .ADDRESS of its own table is right
MAIN1: G^SHR1_COUNT origin+00000200 holds 3
$   SHOW SYMBOL $STATUS
  $STATUS == "%X00000001"
$   I = I + 1
$   GOTO RUN
$ RUN:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO LINKS
$   RUN MAIN1N
%DCL-W-ACTIMAGE, error activating image SHR1
