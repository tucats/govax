%DCL-E-NOTFR, no transfer address
$ SHOW SYMBOL $STATUS
  $STATUS == "%X0003889A"
$ !
$ ! VMS's LINK against govax's shareable images: does it read their
$ ! global symbol tables? MAIN1V uses SHR1, MAIN2V uses SHR2 (which uses
$ ! SHR1), each from VMS's MACRO's object, as LINK68.COM made them.
$ !
$ MACRO/NOLIST/OBJECT=MAIN1V.OBJ MAIN1.MAR
$ MACRO/NOLIST/OBJECT=MAIN2V.OBJ MAIN2.MAR
$ LINK/MAP=MAIN1V/FULL MAIN1V.OBJ,SYS$INPUT/OPTIONS
SHR1/SHAREABLE
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ RUN MAIN1V
MAIN1: SHR1_ORIGIN 00023A00, MAIN1 00000400
MAIN1: SHR1_ADD(3,4) 7, SHR1_COUNT 1
MAIN1: SHR1_JSB(5) 11
MAIN1: G^SHR1_ADD origin+FFFFFC08, .ADDRESS origin+FFFFFC08
MAIN1: G^SHR1_TABLE origin+FFFFFE00 holds 11111111, .ADDRESS origin+FFFFFE00
MAIN1: hello, through SHR1_SHOW
SHR1: the .ADDRESS of its own table is right
MAIN1: G^SHR1_COUNT origin+00000200 holds 3
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00000001"
$ LINK/MAP=MAIN2V/FULL MAIN2V.OBJ,SYS$INPUT/OPTIONS
SHR2/SHAREABLE
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ RUN MAIN2V
MAIN2: SHR2_TWICE(21) 42
MAIN2: SHR2_COUNT() 1
MAIN2: SHR2_ADDR() 0
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00000001"
$ !
$ ! VMS's librarian on govax's images, and VMS's LINK through the
$ ! library govax made.
$ !
$ LIBRARY/CREATE/SHARE MYSHRV SHR1.EXE,SHR2.EXE
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ LIBRARY/LIST=MYSHRV.LIS/FULL/NAMES/SHARE MYSHRV
$ LIBRARY/LIST=MYSHRG.LIS/FULL/NAMES/SHARE MYSHR
$ LINK/MAP=MAIN1W/FULL MAIN1V.OBJ,MYSHR/LIBRARY
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ RUN MAIN1W
%DCL-W-ACTIMAGE, error activating image MAIN1W
-CLI-E-IMAGEFNF, image file not found DUA1:[000000]MAIN1W.EXE;
$ SHOW SYMBOL $STATUS
  $STATUS == "%X100388B2"
$ !
$ DEASSIGN SHR1
$ DEASSIGN SHR1A
$ DEASSIGN SHR2
$ DEASSIGN SHR3
$ DEASSIGN SHR3P
$ DEASSIGN SHR4
$ DEASSIGN SHR6
$ DIRECTORY/SIZE=ALL/DATE *.EXE,*.AN2,*.OLB

