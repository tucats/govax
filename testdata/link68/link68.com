$ ! LINK68.COM - Phase 68's probe of shareable images
$ ! (testdata/link68/README.md). Run it with the exchange volume's
$ ! [000000] as the default directory:
$ !
$ !     @LINK68/OUTPUT=LINK68.LOG
$ !
$ ! It assembles the sources (NAME.LIS), links the images with maps
$ ! (NAME.MAP), analyzes each image as it's made (NAME.ANI), and runs
$ ! the programs. Object files are always named with their type, so a
$ ! logical name defined for a shareable image (SHR1, ...) doesn't
$ ! capture its object.
$ !
$ SET NOON
$ SET VERIFY
$ WRITE SYS$OUTPUT F$GETSYI("VERSION"), " ", F$GETSYI("HW_NAME")
$ HERE = F$ENVIRONMENT("DEFAULT")
$ RELINKS == 0
$ SHOW LOGICAL SYS$SHARE
$ !
$ ! The sources.
$ !
$ LIST = "XFR1,SHR1,SHR2,SHR3,SHR6,MAIN1,MAIN2,MAIN3,MAIN6,EXE1,EXE1B"
$ I = 0
$ ASM:
$   F = F$ELEMENT(I, ",", LIST)
$   IF F .EQS. "," THEN GOTO LINKS
$   MACRO/LIST 'F'.MAR
$   SHOW SYMBOL $STATUS
$   I = I + 1
$   GOTO ASM
$ LINKS:
$ ANALYZE/OBJECT/OUTPUT=XFR1.ANL XFR1.OBJ
$ !
$ ! SHR1: a transfer vector cluster first, from an options file, with
$ ! GSMATCH= from a second options file; its symbol table as SHR1.STB.
$ !
$ OPEN/WRITE OPT GSM.OPT
$ WRITE OPT "GSMATCH=LEQUAL,1,1000"
$ CLOSE OPT
$ LINK/SHAREABLE=SHR1/MAP=SHR1/FULL/SYMBOL_TABLE=SHR1 SHR1.OPT/OPTIONS,GSM.OPT/OPTIONS
$ SHOW SYMBOL $STATUS
$ CALL ANI SHR1
$ !
$ ! MAIN1 against SHR1.
$ !
$ LINK/MAP=MAIN1/FULL MAIN1.OBJ,SYS$INPUT/OPTIONS
SHR1/SHAREABLE
$ SHOW SYMBOL $STATUS
$ CALL ANI MAIN1
$ !
$ ! R1: SHR1 found through a logical name.
$ !
$ DEFINE SHR1 'HERE'SHR1.EXE
$ RUN MAIN1
$ SHOW SYMBOL $STATUS
$ !
$ ! R2: the logical name has no device and no type.
$ !
$ DEFINE SHR1 'F$PARSE("[]",,,"DIRECTORY")'SHR1
$ RUN MAIN1
$ SHOW SYMBOL $STATUS
$ !
$ ! R3: no logical name, and no SYS$SHARE:SHR1.EXE.
$ !
$ DEASSIGN SHR1
$ RUN MAIN1
$ SHOW SYMBOL $STATUS
$ !
$ ! R4: SYS$SHARE a process search list, SHR1.EXE in its first place.
$ !
$ CREATE/DIRECTORY [.SHRDIR]
$ COPY SHR1.EXE [.SHRDIR]
$ SHRDIR = F$PARSE("[.SHRDIR]",,,"DEVICE") + F$PARSE("[.SHRDIR]",,,"DIRECTORY")
$ OLD = F$TRNLNM("SYS$SHARE")
$ IF OLD .EQS. "" THEN OLD = "SYS$SYSROOT:[SYSLIB]"
$ DEFINE SYS$SHARE 'SHRDIR','OLD'
$ SHOW LOGICAL SYS$SHARE
$ RUN MAIN1
$ SHOW SYMBOL $STATUS
$ DEASSIGN SYS$SHARE
$ !
$ ! R5: SHR1 relinked with other idents and match controls; MAIN1 was
$ ! linked with LEQUAL,1,1000. MAIN1N is linked against NEVER.
$ !
$ DEFINE SHR1 'HERE'SHR1.EXE
$ CALL RELINK1 "LEQUAL,1,1001"
$ RUN MAIN1
$ SHOW SYMBOL $STATUS
$ CALL RELINK1 "LEQUAL,1,999"
$ RUN MAIN1
$ SHOW SYMBOL $STATUS
$ CALL RELINK1 "LEQUAL,2,1000"
$ RUN MAIN1
$ SHOW SYMBOL $STATUS
$ CALL RELINK1 "EQUAL,1,1000"
$ RUN MAIN1
$ SHOW SYMBOL $STATUS
$ CALL RELINK1 "EQUAL,1,1001"
$ RUN MAIN1
$ SHOW SYMBOL $STATUS
$ CALL RELINK1 "NEVER,1,1000"
$ RUN MAIN1
$ SHOW SYMBOL $STATUS
$ LINK/MAP=MAIN1N/FULL/EXECUTABLE=MAIN1N MAIN1.OBJ,SYS$INPUT/OPTIONS
SHR1/SHAREABLE
$ SHOW SYMBOL $STATUS
$ CALL ANI MAIN1N
$ RUN MAIN1N
$ SHOW SYMBOL $STATUS
$ CALL RELINK1 "ALWAYS,3,3"
$ RUN MAIN1
$ SHOW SYMBOL $STATUS
$ RUN MAIN1N
$ SHOW SYMBOL $STATUS
$ CALL RELINK1 "LEQUAL,1,1000"
$ RUN MAIN1
$ SHOW SYMBOL $STATUS
$ !
$ ! R6: SHR1A, without a transfer vector or GSMATCH=, and with no
$ ! traceback; MAIN1A against it. SHR1A relinked unchanged is a new
$ ! image, whose default ident (from the link time) is another.
$ !
$ LINK/SHAREABLE=SHR1A/MAP=SHR1A/FULL/NOTRACEBACK SHR1.OBJ,SYS$INPUT/OPTIONS
UNIVERSAL=SHR1_BASE,SHR1_ADD,SHR1_JSB,SHR1_SHOW
UNIVERSAL=SHR1_COUNT,SHR1_TABLE,SHR1_ORIGIN
$ SHOW SYMBOL $STATUS
$ CALL ANI SHR1A
$ LINK/MAP=MAIN1A/FULL/EXECUTABLE=MAIN1A MAIN1.OBJ,SYS$INPUT/OPTIONS
SHR1A/SHAREABLE
$ SHOW SYMBOL $STATUS
$ CALL ANI MAIN1A
$ DEFINE SHR1A 'HERE'SHR1A.EXE
$ RUN MAIN1A
$ SHOW SYMBOL $STATUS
$ WAIT 00:00:02
$ LINK/SHAREABLE=SHR1A/NOMAP/NOTRACEBACK SHR1.OBJ,SYS$INPUT/OPTIONS
UNIVERSAL=SHR1_BASE,SHR1_ADD,SHR1_JSB,SHR1_SHOW
UNIVERSAL=SHR1_COUNT,SHR1_TABLE,SHR1_ORIGIN
$ SHOW SYMBOL $STATUS
$ RUN MAIN1A
$ SHOW SYMBOL $STATUS
$ !
$ ! R7: SHR2 uses SHR1; MAIN2 uses SHR2.
$ !
$ LINK/SHAREABLE=SHR2/MAP=SHR2/FULL SHR2.OBJ,SYS$INPUT/OPTIONS
SHR1/SHAREABLE
UNIVERSAL=SHR2_TWICE,SHR2_COUNT,SHR2_ADDR
GSMATCH=EQUAL,2,5
$ SHOW SYMBOL $STATUS
$ CALL ANI SHR2
$ LINK/MAP=MAIN2/FULL MAIN2.OBJ,SYS$INPUT/OPTIONS
SHR2/SHAREABLE
$ SHOW SYMBOL $STATUS
$ CALL ANI MAIN2
$ DEFINE SHR2 'HERE'SHR2.EXE
$ RUN MAIN2
$ SHOW SYMBOL $STATUS
$ !
$ ! R8: position-dependent code, based (SHR3) and not (SHR3P).
$ !
$ LINK/SHAREABLE=SHR3/MAP=SHR3/FULL SHR3.OBJ,SYS$INPUT/OPTIONS
BASE=%X300000
UNIVERSAL=SHR3_GET,SHR3_DATA
$ SHOW SYMBOL $STATUS
$ CALL ANI SHR3
$ LINK/SHAREABLE=SHR3P/MAP=SHR3P/FULL SHR3.OBJ,SYS$INPUT/OPTIONS
UNIVERSAL=SHR3_GET,SHR3_DATA
$ SHOW SYMBOL $STATUS
$ CALL ANI SHR3P
$ LINK/MAP=MAIN3/FULL MAIN3.OBJ,SYS$INPUT/OPTIONS
SHR3/SHAREABLE
$ SHOW SYMBOL $STATUS
$ CALL ANI MAIN3
$ LINK/MAP=MAIN3P/FULL/EXECUTABLE=MAIN3P MAIN3.OBJ,SYS$INPUT/OPTIONS
SHR3P/SHAREABLE
$ SHOW SYMBOL $STATUS
$ CALL ANI MAIN3P
$ DEFINE SHR3 'HERE'SHR3.EXE
$ DEFINE SHR3P 'HERE'SHR3P.EXE
$ RUN MAIN3
$ SHOW SYMBOL $STATUS
$ RUN MAIN3P
$ SHOW SYMBOL $STATUS
$ !
$ ! R9: SHR4, SHR1's objects laid out by COLLECT=, PSECT_ATTR=,
$ ! DZRO_MIN=, and ISD_MAX=, with GSMATCH=ALWAYS; MAIN4 against it,
$ ! run before and after SHR4 is relinked with another ident.
$ !
$ LINK/SHAREABLE=SHR4/MAP=SHR4/FULL SYS$INPUT/OPTIONS
CLUSTER=FIRST,,,XFR1.OBJ
COLLECT=FIRST,SHR1_RO
SHR1.OBJ
PSECT_ATTR=SHR1_RO,NOSHR
DZRO_MIN=1
ISD_MAX=20
GSMATCH=ALWAYS,0,0
UNIVERSAL=SHR1_COUNT,SHR1_TABLE,SHR1_ORIGIN
$ SHOW SYMBOL $STATUS
$ CALL ANI SHR4
$ LINK/MAP=MAIN4/FULL/EXECUTABLE=MAIN4 MAIN1.OBJ,SYS$INPUT/OPTIONS
SHR4/SHAREABLE
$ SHOW SYMBOL $STATUS
$ CALL ANI MAIN4
$ DEFINE SHR4 'HERE'SHR4.EXE
$ RUN MAIN4
$ SHOW SYMBOL $STATUS
$ LINK/SHAREABLE=SHR4/NOMAP SYS$INPUT/OPTIONS
CLUSTER=FIRST,,,XFR1.OBJ
COLLECT=FIRST,SHR1_RO
SHR1.OBJ
PSECT_ATTR=SHR1_RO,NOSHR
DZRO_MIN=1
ISD_MAX=20
GSMATCH=ALWAYS,7,7
UNIVERSAL=SHR1_COUNT,SHR1_TABLE,SHR1_ORIGIN
$ SHOW SYMBOL $STATUS
$ RUN MAIN4
$ SHOW SYMBOL $STATUS
$ !
$ ! SHR5: PROTECT= around one cluster (not run: a protected image is
$ ! for installing).
$ !
$ LINK/SHAREABLE=SHR5/MAP=SHR5/FULL SYS$INPUT/OPTIONS
PROTECT=YES
CLUSTER=PROT,,,XFR1.OBJ
PROTECT=NO
SHR1.OBJ
UNIVERSAL=SHR1_COUNT
$ SHOW SYMBOL $STATUS
$ CALL ANI SHR5
$ !
$ ! R10: SHR6, a .ADDRESS in a shared, read-only psect; MAIN6.
$ !
$ LINK/SHAREABLE=SHR6/MAP=SHR6/FULL SHR6.OBJ,SYS$INPUT/OPTIONS
UNIVERSAL=SHR6_GET
$ SHOW SYMBOL $STATUS
$ CALL ANI SHR6
$ LINK/MAP=MAIN6/FULL MAIN6.OBJ,SYS$INPUT/OPTIONS
SHR6/SHAREABLE
$ SHOW SYMBOL $STATUS
$ CALL ANI MAIN6
$ DEFINE SHR6 'HERE'SHR6.EXE
$ RUN MAIN6
$ SHOW SYMBOL $STATUS
$ !
$ ! R11: EXE1, an executable laid out by options.
$ !
$ LINK/MAP=EXE1/FULL EXE1.OBJ,SYS$INPUT/OPTIONS
BASE=%X10000
CLUSTER=SECOND,%X40000,,EXE1B.OBJ
COLLECT=SECOND,EXE1_RO
PSECT_ATTR=EXE1_DATA,NOWRT
IOSEGMENT=40
DZRO_MIN=2
ISD_MAX=40
$ SHOW SYMBOL $STATUS
$ CALL ANI EXE1
$ RUN EXE1
$ SHOW SYMBOL $STATUS
$ !
$ ! R12: a shareable image library, searched by name (MAIN1L) and as
$ ! a default user library (LNK$LIBRARY, MAIN1U); then without it.
$ !
$ LIBRARY/CREATE/SHARE MYSHR SHR1.EXE,SHR2.EXE
$ SHOW SYMBOL $STATUS
$ LIBRARY/LIST=MYSHR.LIS/FULL/NAMES/SHARE MYSHR
$ LINK/MAP=MAIN1L/FULL/EXECUTABLE=MAIN1L MAIN1.OBJ,MYSHR/LIBRARY
$ SHOW SYMBOL $STATUS
$ CALL ANI MAIN1L
$ RUN MAIN1L
$ SHOW SYMBOL $STATUS
$ DEFINE LNK$LIBRARY 'HERE'MYSHR.OLB
$ LINK/MAP=MAIN1U/FULL/EXECUTABLE=MAIN1U MAIN1.OBJ
$ SHOW SYMBOL $STATUS
$ CALL ANI MAIN1U
$ RUN MAIN1U
$ SHOW SYMBOL $STATUS
$ LINK/NOUSERLIBRARY/NOMAP/EXECUTABLE=E9 MAIN1.OBJ
$ SHOW SYMBOL $STATUS
$ DEASSIGN LNK$LIBRARY
$ !
$ ! Errors. Each link's messages and $STATUS, and whether it made an
$ ! image (the DIRECTORY at the end).
$ !
$ ! E1: UNIVERSAL= of a symbol nothing defines.
$ LINK/SHAREABLE=E1/NOMAP SHR1.OBJ,SYS$INPUT/OPTIONS
UNIVERSAL=NOSUCH
$ SHOW SYMBOL $STATUS
$ ! E2: a transfer vector in an executable.
$ LINK/NOMAP/EXECUTABLE=E2 XFR1.OBJ,SHR1.OBJ
$ SHOW SYMBOL $STATUS
$ ! E3: a shareable image named on the command line.
$ LINK/NOMAP/EXECUTABLE=E3 MAIN2.OBJ,SHR2.EXE
$ SHOW SYMBOL $STATUS
$ ! E4: GSMATCH= with a bad keyword, then a major ident past a byte.
$ LINK/SHAREABLE=E4/NOMAP SHR1.OBJ,SYS$INPUT/OPTIONS
GSMATCH=SOMETIMES,1,2
$ SHOW SYMBOL $STATUS
$ LINK/SHAREABLE=E4/NOMAP SHR1.OBJ,SYS$INPUT/OPTIONS
GSMATCH=LEQUAL,300,1
$ SHOW SYMBOL $STATUS
$ ! E5: an executable based where the based SHR3 is.
$ LINK/NOMAP/EXECUTABLE=E5 MAIN3.OBJ,SYS$INPUT/OPTIONS
BASE=%X300000
SHR3/SHAREABLE
$ SHOW SYMBOL $STATUS
$ ! E6: GSMATCH= twice, then a misspelled option.
$ LINK/SHAREABLE=E6/NOMAP SHR1.OBJ,SYS$INPUT/OPTIONS
GSMATCH=LEQUAL,1,1
GSMATCH=LEQUAL,1,2
$ SHOW SYMBOL $STATUS
$ LINK/SHAREABLE=E6/NOMAP SHR1.OBJ,SYS$INPUT/OPTIONS
UNIVERSALS=SHR1_COUNT
$ SHOW SYMBOL $STATUS
$ ! E7: RUN of a shareable image.
$ RUN SHR1.EXE
$ SHOW SYMBOL $STATUS
$ ! E8: UNIVERSAL= in an executable.
$ LINK/NOMAP/EXECUTABLE=E8 MAIN1.OBJ,SYS$INPUT/OPTIONS
SHR1/SHAREABLE
UNIVERSAL=MAIN1
$ SHOW SYMBOL $STATUS
$ !
$ DEASSIGN SHR1
$ DEASSIGN SHR1A
$ DEASSIGN SHR2
$ DEASSIGN SHR3
$ DEASSIGN SHR3P
$ DEASSIGN SHR4
$ DEASSIGN SHR6
$ DIRECTORY/FULL/OUTPUT=FILES.LST *.*;*
$ DIRECTORY/SIZE=ALL/DATE *.EXE;*
$ SET NOVERIFY
$ EXIT
$ !
$ ! ANI name: ANALYZE/IMAGE NAME.EXE into NAME.ANI, if LINK made it.
$ ANI: SUBROUTINE
$   IF F$SEARCH("''P1'.EXE") .NES. "" THEN -
        ANALYZE/IMAGE/OUTPUT='P1'.ANI 'P1'.EXE
$   EXIT
$ ENDSUBROUTINE
$ !
$ ! RELINK1 gsmatch: SHR1 again, with GSMATCH=gsmatch; its analysis
$ ! is SHR1_n.ANI, n the GSMATCH's place in the series.
$ RELINK1: SUBROUTINE
$   OPEN/WRITE OPT GSM.OPT
$   WRITE OPT "GSMATCH=''P1'"
$   CLOSE OPT
$   LINK/SHAREABLE=SHR1.EXE/NOMAP SHR1.OPT/OPTIONS,GSM.OPT/OPTIONS
$   SHOW SYMBOL $STATUS
$   RELINKS == RELINKS + 1
$   ANALYZE/IMAGE/OUTPUT=SHR1_'RELINKS'.ANI SHR1.EXE
$   EXIT
$ ENDSUBROUTINE
