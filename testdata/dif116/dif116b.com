$ ! DIF116B.COM - Phase 116's probe of DIFFERENCES, round 2: the cases
$ ! from N60 on, which round 1 didn't reach. Written by
$ ! testdata/dif116/gen.go. Run it as SYSTEM, with the exchange volume
$ ! mounted, from its [DIF116] directory:
$ !
$ !     $ SET DEFAULT DUA1:[DIF116]
$ !     $ @DIF116B/OUTPUT=DIF116B.LOG
$ !
$ SET NOON
$ SET VERIFY
$ WRITE SYS$OUTPUT "######## ENVIRONMENT"
$ WRITE SYS$OUTPUT F$GETSYI("VERSION"), " ", F$GETSYI("HW_NAME"), " ", F$GETSYI("NODENAME")
$ WRITE SYS$OUTPUT F$TIME()
$ TOP = F$PARSE("[000000]",,,"DEVICE")
$ DEFINE DIF$TOP 'TOP'
$ DEFINE DIF$OUT DIF$TOP:[DIF116.OUT]
$ SHOW LOGICAL DIF$TOP
$ SET DEFAULT DIF$TOP:[DIF116.IN]
$ SHOW DEFAULT
$ !
$ WRITE SYS$OUTPUT "######## NAMES"
$ WRITE SYS$OUTPUT "#### CASE N60: long names"
$ DIFFERENCES/OUTPUT=DIF$OUT:N60.DIF [DIF116.IN.A_LONG_DIRECTORY_NAME_OF_THIRTY_NINE_CH]A_FILE_NAME_OF_THIRTY_NINE_CHARACTERS_X.A_TYPE_OF_THIRTY_NINE_CHARACTERS_XXXXXX -
[DIF116.IN.A_LONG_DIRECTORY_NAME_OF_THIRTY_NINE_CH]A_FILE_NAME_OF_THIRTY_NINE_CHARACTERS_X.B_TYPE_OF_THIRTY_NINE_CHARACTERS_XXXXXX
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE N61: long names at /WIDTH=80"
$ DIFFERENCES/WIDTH=80/OUTPUT=DIF$OUT:N61.DIF [DIF116.IN.A_LONG_DIRECTORY_NAME_OF_THIRTY_NINE_CH]A_FILE_NAME_OF_THIRTY_NINE_CHARACTERS_X.A_TYPE_OF_THIRTY_NINE_CHARACTERS_XXXXXX -
[DIF116.IN.A_LONG_DIRECTORY_NAME_OF_THIRTY_NINE_CH]A_FILE_NAME_OF_THIRTY_NINE_CHARACTERS_X.B_TYPE_OF_THIRTY_NINE_CHARACTERS_XXXXXX
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE N62: long names in parallel"
$ DIFFERENCES/PARALLEL/OUTPUT=DIF$OUT:N62.DIF [DIF116.IN.A_LONG_DIRECTORY_NAME_OF_THIRTY_NINE_CH]A_FILE_NAME_OF_THIRTY_NINE_CHARACTERS_X.A_TYPE_OF_THIRTY_NINE_CHARACTERS_XXXXXX -
[DIF116.IN.A_LONG_DIRECTORY_NAME_OF_THIRTY_NINE_CH]A_FILE_NAME_OF_THIRTY_NINE_CHARACTERS_X.B_TYPE_OF_THIRTY_NINE_CHARACTERS_XXXXXX
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE N63: every qualifier in the echo"
$ DIFFERENCES/IGNORE=(BLANK_LINES,CASE,COMMENTS,FORM_FEEDS,HEADER=2,SPACING,TRAILING_SPACES,EXACT)/COMMENT_DELIMITER=("!",";",COLON,TAB)/MATCH=4/MERGED=2/PARALLEL=1/SEPARATED=MASTER/WINDOW=10-
/MAXIMUM_DIFFERENCES=50/MODE=(ASCII,HEX)/NONUMBER/WIDTH=100/CHANGE_BAR=("$",NUMBER)/OUTPUT=DIF$OUT:N63.DIF F01.A F01.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE N64: every qualifier at /WIDTH=80"
$ DIFFERENCES/IGNORE=(BLANK_LINES,CASE,COMMENTS,FORM_FEEDS,HEADER=2,SPACING,TRAILING_SPACES,EXACT)/COMMENT_DELIMITER=("!",";",COLON,TAB)/MATCH=4/MERGED=2/PARALLEL=1/SEPARATED=MASTER/WINDOW=10-
/MAXIMUM_DIFFERENCES=50/MODE=(ASCII,HEX)/NONUMBER/WIDTH=80/OUTPUT=DIF$OUT:N64.DIF F01.A/CHANGE_BAR=% F01.B/CHANGE_BAR=#
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE N65: the defaults written out"
$ DIFFERENCES/MATCH=3/MERGED=1/NUMBER/WIDTH=132/MODE=ASCII/IGNORE=EDITED/OUTPUT=DIF$OUT:N65.DIF F01.A F01.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ !
$ WRITE SYS$OUTPUT "######## OUTPUT"
$ WRITE SYS$OUTPUT "#### CASE O01: /OUTPUT with no file"
$ SET DEFAULT DIF$TOP:[DIF116.SCR]
$ DIFFERENCES/OUTPUT [-.IN]A02.A [-.IN]A02.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ DIRECTORY DIF$TOP:[DIF116.SCR],DIF$TOP:[DIF116.IN]*.DIF
$ DELETE DIF$TOP:[DIF116.SCR]*.*;*/NOLOG
$ DELETE DIF$TOP:[DIF116.IN]*.DIF;*/NOLOG
$ SET DEFAULT DIF$TOP:[DIF116.IN]
$ WRITE SYS$OUTPUT "#### CASE O02: /OUTPUT=name, no type"
$ SET DEFAULT DIF$TOP:[DIF116.SCR]
$ DIFFERENCES/OUTPUT=LISTING [-.IN]A02.A [-.IN]A02.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ DIRECTORY DIF$TOP:[DIF116.SCR],DIF$TOP:[DIF116.IN]*.DIF
$ DELETE DIF$TOP:[DIF116.SCR]*.*;*/NOLOG
$ DELETE DIF$TOP:[DIF116.IN]*.DIF;*/NOLOG
$ SET DEFAULT DIF$TOP:[DIF116.IN]
$ WRITE SYS$OUTPUT "#### CASE O03: /OUTPUT=a directory"
$ SET DEFAULT DIF$TOP:[DIF116.SCR]
$ DIFFERENCES/OUTPUT=[-.SCR] [-.IN]A02.A [-.IN]A02.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ DIRECTORY DIF$TOP:[DIF116.SCR],DIF$TOP:[DIF116.IN]*.DIF
$ DELETE DIF$TOP:[DIF116.SCR]*.*;*/NOLOG
$ DELETE DIF$TOP:[DIF116.IN]*.DIF;*/NOLOG
$ SET DEFAULT DIF$TOP:[DIF116.IN]
$ WRITE SYS$OUTPUT "#### CASE O04: /SLP with no /OUTPUT"
$ SET DEFAULT DIF$TOP:[DIF116.SCR]
$ DIFFERENCES/SLP [-.IN]A02.A [-.IN]A02.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ DIRECTORY DIF$TOP:[DIF116.SCR],DIF$TOP:[DIF116.IN]*.DIF
$ DELETE DIF$TOP:[DIF116.SCR]*.*;*/NOLOG
$ DELETE DIF$TOP:[DIF116.IN]*.DIF;*/NOLOG
$ SET DEFAULT DIF$TOP:[DIF116.IN]
$ WRITE SYS$OUTPUT "#### CASE O05: /SLP/OUTPUT with no file"
$ SET DEFAULT DIF$TOP:[DIF116.SCR]
$ DIFFERENCES/SLP/OUTPUT [-.IN]A02.A [-.IN]A02.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ DIRECTORY DIF$TOP:[DIF116.SCR],DIF$TOP:[DIF116.IN]*.DIF
$ DELETE DIF$TOP:[DIF116.SCR]*.*;*/NOLOG
$ DELETE DIF$TOP:[DIF116.IN]*.DIF;*/NOLOG
$ SET DEFAULT DIF$TOP:[DIF116.IN]
$ WRITE SYS$OUTPUT "#### CASE O06: /OUTPUT with no file, identical files"
$ SET DEFAULT DIF$TOP:[DIF116.SCR]
$ DIFFERENCES/OUTPUT [-.IN]A13.A [-.IN]A13.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ DIRECTORY DIF$TOP:[DIF116.SCR],DIF$TOP:[DIF116.IN]*.DIF
$ DELETE DIF$TOP:[DIF116.SCR]*.*;*/NOLOG
$ DELETE DIF$TOP:[DIF116.IN]*.DIF;*/NOLOG
$ SET DEFAULT DIF$TOP:[DIF116.IN]
$ WRITE SYS$OUTPUT "#### CASE O07: /OUTPUT with no file, the first missing"
$ SET DEFAULT DIF$TOP:[DIF116.SCR]
$ DIFFERENCES/OUTPUT [-.IN]NOSUCH.A [-.IN]A13.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ DIRECTORY DIF$TOP:[DIF116.SCR],DIF$TOP:[DIF116.IN]*.DIF
$ DELETE DIF$TOP:[DIF116.SCR]*.*;*/NOLOG
$ DELETE DIF$TOP:[DIF116.IN]*.DIF;*/NOLOG
$ SET DEFAULT DIF$TOP:[DIF116.IN]
$ WRITE SYS$OUTPUT "#### CASE O08: /OUTPUT, the qualifier after the files"
$ SET DEFAULT DIF$TOP:[DIF116.SCR]
$ DIFFERENCES [-.IN]A02.A [-.IN]A02.B/OUTPUT
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ DIRECTORY DIF$TOP:[DIF116.SCR],DIF$TOP:[DIF116.IN]*.DIF
$ DELETE DIF$TOP:[DIF116.SCR]*.*;*/NOLOG
$ DELETE DIF$TOP:[DIF116.IN]*.DIF;*/NOLOG
$ SET DEFAULT DIF$TOP:[DIF116.IN]
$ WRITE SYS$OUTPUT "#### CASE O09: no /OUTPUT, SYS$OUTPUT defined to a file"
$ SET DEFAULT DIF$TOP:[DIF116.SCR]
$ DEFINE/USER_MODE SYS$OUTPUT DIF$TOP:[DIF116.SCR]REDIRECT.LIS
$ DIFFERENCES [-.IN]A02.A [-.IN]A02.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ DIRECTORY DIF$TOP:[DIF116.SCR],DIF$TOP:[DIF116.IN]*.DIF
$ DELETE DIF$TOP:[DIF116.SCR]*.*;*/NOLOG
$ DELETE DIF$TOP:[DIF116.IN]*.DIF;*/NOLOG
$ SET DEFAULT DIF$TOP:[DIF116.IN]
$ WRITE SYS$OUTPUT "#### CASE O20: a listing's attributes and records"
$ DIFFERENCES/OUTPUT=DIF$OUT:O20.DIF A02.A A02.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ DIRECTORY/FULL DIF$OUT:O20.DIF
$ DUMP/RECORD DIF$OUT:O20.DIF
$ DUMP/RECORD DIF$OUT:F10.DIF
$ DUMP/RECORD DIF$OUT:F19.DIF
$ DUMP/RECORD DIF$OUT:F35.DIF
$ DUMP/RECORD DIF$OUT:A20.DIF
$ DUMP/RECORD DIF$OUT:I30.DIF
$ DUMP/RECORD DIF$OUT:I32.DIF
$ !
$ WRITE SYS$OUTPUT "######## FORMATS"
$ WRITE SYS$OUTPUT "#### CASE R01: VFC files"
$ DIFFERENCES/OUTPUT=DIF$OUT:R01.DIF R01.VFC R02.VFC
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE R02: STREAM_LF files"
$ DIFFERENCES/OUTPUT=DIF$OUT:R02.DIF R01.STM R02.STM
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE R03: a STREAM_LF file and a variable one"
$ DIFFERENCES/OUTPUT=DIF$OUT:R03.DIF R01.STM A02.A
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE R04: VFC against STREAM_LF, the same records"
$ DIFFERENCES/OUTPUT=DIF$OUT:R04.DIF R01.VFC R01.STM
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE R05: fixed files"
$ DIFFERENCES/OUTPUT=DIF$OUT:R05.DIF R01.FIX R02.FIX
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE R06: fixed against variable, the same text"
$ DIFFERENCES/OUTPUT=DIF$OUT:R06.DIF R01.FIX R01.VFC
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE R07: fixed files, /IGNORE=TRAILING_SPACES"
$ DIFFERENCES/IGNORE=TRAILING_SPACES/OUTPUT=DIF$OUT:R07.DIF R01.FIX R01.VFC
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE R10: every byte, merged"
$ DIFFERENCES/OUTPUT=DIF$OUT:R10.DIF R10.FIX R11.FIX
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE R11: every byte, /IGNORE=PRETTY"
$ DIFFERENCES/IGNORE=PRETTY/OUTPUT=DIF$OUT:R11.DIF R10.FIX R11.FIX
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE R12: every byte, /PARALLEL"
$ DIFFERENCES/PARALLEL/OUTPUT=DIF$OUT:R12.DIF R10.FIX R11.FIX
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE R13: every byte, /MODE=(HEX,OCTAL)"
$ DIFFERENCES/MODE=(HEX,OCTAL)/OUTPUT=DIF$OUT:R13.DIF R10.FIX R11.FIX
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE R14: every byte, /SLP"
$ DIFFERENCES/SLP/OUTPUT=DIF$OUT:R14.DIF R10.FIX R11.FIX
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE R15: every byte, /IGNORE=(SPACING,TRAILING_SPACES,CASE)"
$ DIFFERENCES/IGNORE=(SPACING,TRAILING_SPACES,CASE)/OUTPUT=DIF$OUT:R15.DIF R10.FIX R11.FIX
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ !
$ WRITE SYS$OUTPUT "######## GENERATED"
$ WRITE SYS$OUTPUT "#### CASE G001: generated"
$ DIFFERENCES/OUTPUT=DIF$OUT:G001.DIF G001.A G001.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
