$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE F18: /WIDTH=200"
$ DIFFERENCES/WIDTH=200/OUTPUT=DIF$OUT:F18.DIF F01.A F01.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE F19: /MODE=HEXADECIMAL"
$ DIFFERENCES/MODE=HEXADECIMAL/OUTPUT=DIF$OUT:F19.DIF F01.A F01.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
