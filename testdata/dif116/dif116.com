$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE F13: /PARALLEL/WIDTH=80"
$ DIFFERENCES/PARALLEL/WIDTH=80/OUTPUT=DIF$OUT:F13.DIF F01.A F01.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE F14: /PARALLEL/WIDTH=40"
