$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE F27: /CHANGE_BAR=(""!"",NUMBER)/NONUMBER"
$ DIFFERENCES/CHANGE_BAR=("!",NUMBER)/NONUMBER/OUTPUT=DIF$OUT:F27.DIF F01.A F01.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
