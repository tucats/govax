$ ! DIF116.COM - Phase 116's probe of the DIFFERENCES command.
$ ! Written by testdata/dif116/gen.go. Run it as any user, with the
$ ! exchange volume mounted, from its [DIF116] directory:
$ !
$ !     $ SET DEFAULT DUA1:[DIF116]
$ !     $ @DIF116/OUTPUT=DIF116.LOG
$ !
$ ! It makes the listings in [DIF116.OUT], one per case, and writes each
$ ! case's status to the log. It changes nothing outside [DIF116...].
$ !
$ SET NOON
$ SET VERIFY
$ WRITE SYS$OUTPUT "######## ENVIRONMENT"
$ WRITE SYS$OUTPUT F$GETSYI("VERSION"), " ", F$GETSYI("HW_NAME"), " ", F$GETSYI("NODENAME")
$ WRITE SYS$OUTPUT F$TIME()
$ TOP = F$PARSE("[000000]",,,"DEVICE")
$ DEFINE DIF$TOP 'TOP'
$ DEFINE DIF$OUT DIF$TOP:[DIF116.OUT]
$ SHOW LOGICAL DIF$TOP
$ IF F$SEARCH("DIF$TOP:[DIF116]OUT.DIR") .EQS. "" THEN CREATE/DIRECTORY DIF$TOP:[DIF116.OUT]
$ IF F$SEARCH("DIF$TOP:[DIF116]SCR.DIR") .EQS. "" THEN CREATE/DIRECTORY DIF$TOP:[DIF116.SCR]
$ DELETE DIF$TOP:[DIF116.OUT]*.*;*/NOLOG
$ DELETE DIF$TOP:[DIF116.SCR]*.*;*/NOLOG
$ SET DEFAULT DIF$TOP:[DIF116.IN]
$ SHOW DEFAULT
$ DIRECTORY/SIZE V0*.TXT
$ !
$ WRITE SYS$OUTPUT "######## LAYOUT"
$ WRITE SYS$OUTPUT "#### CASE A01: two records inserted (the author's example)"
$ DIFFERENCES/OUTPUT=DIF$OUT:A01.DIF A01.TXT A01.TST
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE A01L: the same, to the log"
$ DIFFERENCES A01.TXT A01.TST
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE A02: one record changed in the middle"
$ DIFFERENCES/OUTPUT=DIF$OUT:A02.DIF A02.A A02.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE A03: two records deleted in the middle"
$ DIFFERENCES/OUTPUT=DIF$OUT:A03.DIF A03.A A03.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE A04: the first record changed"
$ DIFFERENCES/OUTPUT=DIF$OUT:A04.DIF A04.A A04.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE A05: the last record changed"
$ DIFFERENCES/OUTPUT=DIF$OUT:A05.DIF A05.A A05.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE A06: records inserted at the start"
$ DIFFERENCES/OUTPUT=DIF$OUT:A06.DIF A06.A A06.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE A07: records appended"
$ DIFFERENCES/OUTPUT=DIF$OUT:A07.DIF A07.A A07.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE A08: the last records deleted"
$ DIFFERENCES/OUTPUT=DIF$OUT:A08.DIF A08.A A08.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE A09: the first records deleted"
$ DIFFERENCES/OUTPUT=DIF$OUT:A09.DIF A09.A A09.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE A10: the master empty"
$ DIFFERENCES/OUTPUT=DIF$OUT:A10.DIF A10.A A10.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE A11: the revision empty"
$ DIFFERENCES/OUTPUT=DIF$OUT:A11.DIF A11.A A11.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE A12: both empty"
$ DIFFERENCES/OUTPUT=DIF$OUT:A12.DIF A12.A A12.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE A12L: both empty, to the log"
$ DIFFERENCES A12.A A12.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE A13: identical files"
$ DIFFERENCES/OUTPUT=DIF$OUT:A13.DIF A13.A A13.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE A13L: identical files, to the log"
$ DIFFERENCES A13.A A13.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE A14: nothing in common"
$ DIFFERENCES/OUTPUT=DIF$OUT:A14.DIF A14.A A14.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE A15: two sections"
$ DIFFERENCES/OUTPUT=DIF$OUT:A15.DIF A15.A A15.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE A16: changes one record apart"
$ DIFFERENCES/OUTPUT=DIF$OUT:A16.DIF A16.A A16.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE A17: changes two records apart"
$ DIFFERENCES/OUTPUT=DIF$OUT:A17.DIF A17.A A17.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE A18: changes three records apart"
$ DIFFERENCES/OUTPUT=DIF$OUT:A18.DIF A18.A A18.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE A19: a 200-byte record changed"
$ DIFFERENCES/OUTPUT=DIF$OUT:A19.DIF A19.A A19.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE A19W80: the same at /WIDTH=80"
$ DIFFERENCES/WIDTH=80/OUTPUT=DIF$OUT:A19W80.DIF A19.A A19.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE A20: tabs, trailing blanks, blank records"
$ DIFFERENCES/OUTPUT=DIF$OUT:A20.DIF A20.A A20.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE A21: line numbers of five and six digits"
$ DIFFERENCES/OUTPUT=DIF$OUT:A21.DIF A21.A A21.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE A22: a block moved up"
$ DIFFERENCES/OUTPUT=DIF$OUT:A22.DIF A22.A A22.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE A23: repeated records"
$ DIFFERENCES/OUTPUT=DIF$OUT:A23.DIF A23.A A23.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE A24: a change with an insertion after it"
$ DIFFERENCES/OUTPUT=DIF$OUT:A24.DIF A24.A A24.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ !
$ WRITE SYS$OUTPUT "######## MATCHING"
$ WRITE SYS$OUTPUT "#### CASE M16_1: changes one record apart, /MATCH=1"
$ DIFFERENCES/MATCH=1/OUTPUT=DIF$OUT:M16_1.DIF A16.A A16.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M18_1: changes three records apart, /MATCH=1"
$ DIFFERENCES/MATCH=1/OUTPUT=DIF$OUT:M18_1.DIF A18.A A18.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M23_1: repeated records, /MATCH=1"
$ DIFFERENCES/MATCH=1/OUTPUT=DIF$OUT:M23_1.DIF A23.A A23.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M16_2: changes one record apart, /MATCH=2"
$ DIFFERENCES/MATCH=2/OUTPUT=DIF$OUT:M16_2.DIF A16.A A16.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M18_2: changes three records apart, /MATCH=2"
$ DIFFERENCES/MATCH=2/OUTPUT=DIF$OUT:M18_2.DIF A18.A A18.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M23_2: repeated records, /MATCH=2"
$ DIFFERENCES/MATCH=2/OUTPUT=DIF$OUT:M23_2.DIF A23.A A23.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M16_3: changes one record apart, /MATCH=3"
$ DIFFERENCES/MATCH=3/OUTPUT=DIF$OUT:M16_3.DIF A16.A A16.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M18_3: changes three records apart, /MATCH=3"
$ DIFFERENCES/MATCH=3/OUTPUT=DIF$OUT:M18_3.DIF A18.A A18.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M23_3: repeated records, /MATCH=3"
$ DIFFERENCES/MATCH=3/OUTPUT=DIF$OUT:M23_3.DIF A23.A A23.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M16_5: changes one record apart, /MATCH=5"
$ DIFFERENCES/MATCH=5/OUTPUT=DIF$OUT:M16_5.DIF A16.A A16.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M18_5: changes three records apart, /MATCH=5"
$ DIFFERENCES/MATCH=5/OUTPUT=DIF$OUT:M18_5.DIF A18.A A18.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M23_5: repeated records, /MATCH=5"
$ DIFFERENCES/MATCH=5/OUTPUT=DIF$OUT:M23_5.DIF A23.A A23.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M01: /MATCH larger than either file"
$ DIFFERENCES/MATCH=50/OUTPUT=DIF$OUT:M01.DIF A02.A A02.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M02_W1: eight records inserted, /WINDOW=1"
$ DIFFERENCES/WINDOW=1/OUTPUT=DIF$OUT:M02_W1.DIF M02.A M02.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M02_W2: eight records inserted, /WINDOW=2"
$ DIFFERENCES/WINDOW=2/OUTPUT=DIF$OUT:M02_W2.DIF M02.A M02.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M02_W3: eight records inserted, /WINDOW=3"
$ DIFFERENCES/WINDOW=3/OUTPUT=DIF$OUT:M02_W3.DIF M02.A M02.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M02_W5: eight records inserted, /WINDOW=5"
$ DIFFERENCES/WINDOW=5/OUTPUT=DIF$OUT:M02_W5.DIF M02.A M02.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M02_W8: eight records inserted, /WINDOW=8"
$ DIFFERENCES/WINDOW=8/OUTPUT=DIF$OUT:M02_W8.DIF M02.A M02.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M02_W9: eight records inserted, /WINDOW=9"
$ DIFFERENCES/WINDOW=9/OUTPUT=DIF$OUT:M02_W9.DIF M02.A M02.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M02_W20: eight records inserted, /WINDOW=20"
$ DIFFERENCES/WINDOW=20/OUTPUT=DIF$OUT:M02_W20.DIF M02.A M02.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M03_W1: eight records changed, /WINDOW=1"
$ DIFFERENCES/WINDOW=1/OUTPUT=DIF$OUT:M03_W1.DIF M03.A M03.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M03_W4: eight records changed, /WINDOW=4"
$ DIFFERENCES/WINDOW=4/OUTPUT=DIF$OUT:M03_W4.DIF M03.A M03.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M03_W8: eight records changed, /WINDOW=8"
$ DIFFERENCES/WINDOW=8/OUTPUT=DIF$OUT:M03_W8.DIF M03.A M03.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M03_W9: eight records changed, /WINDOW=9"
$ DIFFERENCES/WINDOW=9/OUTPUT=DIF$OUT:M03_W9.DIF M03.A M03.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M04: a block moved, /WINDOW=2"
$ DIFFERENCES/WINDOW=2/OUTPUT=DIF$OUT:M04.DIF A22.A A22.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M05: /MATCH=1/MERGED=1"
$ DIFFERENCES/MATCH=1/MERGED=1/OUTPUT=DIF$OUT:M05.DIF A15.A A15.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ !
$ WRITE SYS$OUTPUT "######## FORMS"
$ WRITE SYS$OUTPUT "#### CASE F01: the base pair, merged by default"
$ DIFFERENCES/OUTPUT=DIF$OUT:F01.DIF F01.A F01.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE F02: /MERGED=0"
$ DIFFERENCES/MERGED=0/OUTPUT=DIF$OUT:F02.DIF F01.A F01.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE F03: /MERGED=2"
$ DIFFERENCES/MERGED=2/OUTPUT=DIF$OUT:F03.DIF F01.A F01.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE F04: /MERGED=3"
$ DIFFERENCES/MERGED=3/OUTPUT=DIF$OUT:F04.DIF F01.A F01.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE F05: /MERGED=5/MATCH=5"
$ DIFFERENCES/MERGED=5/MATCH=5/OUTPUT=DIF$OUT:F05.DIF F01.A F01.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE F06: /SEPARATED"
$ DIFFERENCES/SEPARATED/OUTPUT=DIF$OUT:F06.DIF F01.A F01.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE F07: /SEPARATED=MASTER"
$ DIFFERENCES/SEPARATED=MASTER/OUTPUT=DIF$OUT:F07.DIF F01.A F01.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE F08: /SEPARATED=REVISION"
$ DIFFERENCES/SEPARATED=REVISION/OUTPUT=DIF$OUT:F08.DIF F01.A F01.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE F09: /SEPARATED=(MASTER,REVISION)"
$ DIFFERENCES/SEPARATED=(MASTER,REVISION)/OUTPUT=DIF$OUT:F09.DIF F01.A F01.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE F10: /PARALLEL"
