$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE F15: /NONUMBER"
$ DIFFERENCES/NONUMBER/OUTPUT=DIF$OUT:F15.DIF F01.A F01.B
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", F$FAO("%X!XL",S), " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE F16: /PARALLEL/NONUMBER"
