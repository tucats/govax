! DBG113A.DBG - a register's name in an address expression (README.md):
! testdata/dbg85's @(AP+N) read AP as FFFF0030. Stopped at DEEP, in REC(1),
! whose argument list is at AP.
SET BREAK DEEP
GO
EXAMINE AP
!> EVALUATE AP
EVALUATE AP
!> EVALUATE %AP
EVALUATE %AP
!> EVALUATE .AP
EVALUATE .AP
!> EVALUATE/ADDRESS AP
EVALUATE/ADDRESS AP
!> EVALUATE/ADDRESS %R0
EVALUATE/ADDRESS %R0
!> EVALUATE/ADDRESS R5
EVALUATE/ADDRESS R5
!> EVALUATE/ADDRESS PC
EVALUATE/ADDRESS PC
!> EVALUATE/ADDRESS PSL
EVALUATE/ADDRESS PSL
!> EVALUATE AP+4
EVALUATE AP+4
!> EVALUATE .AP+4
EVALUATE .AP+4
!> EXAMINE AP+4
EXAMINE AP+4
!> EXAMINE R0+4
EXAMINE R0+4
!> EXAMINE %R12+4
EXAMINE %R12+4
!> EXAMINE R2+1
EXAMINE R2+1
!> EXAMINE @AP
EXAMINE @AP
!> EXAMINE @(AP+4)
EXAMINE @(AP+4)
!> EXAMINE @(%AP+4)
EXAMINE @(%AP+4)
!> EXAMINE .(.AP+4)
EXAMINE .(.AP+4)
!> EXAMINE 0FFFF0030
EXAMINE 0FFFF0030
!> EXAMINE 0FFFF0008
EXAMINE 0FFFF0008
!> EXAMINE 0FFFF003C
EXAMINE 0FFFF003C
!> EXAMINE 0FFFF0040
EXAMINE 0FFFF0040
!> EXAMINE 0FFFF0044
EXAMINE 0FFFF0044
!> EXAMINE 0FFFF0030:0FFFF003C
EXAMINE 0FFFF0030:0FFFF003C
!> EXAMINE R2:R4
EXAMINE R2:R4
!> DEPOSIT 0FFFF0008 = %HEX 2828
DEPOSIT 0FFFF0008 = %HEX 2828
EXAMINE R2
!> SYMBOLIZE 0FFFF0030
SYMBOLIZE 0FFFF0030
