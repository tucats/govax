$ ! TB70B.COM - round 2 of Phase 70's probe of traceback
$ ! (testdata/tb70/README.md). Run it with the exchange volume's
$ ! [000000] as the default directory:
$ !
$ !     @TB70B/OUTPUT=TB70B.LOG
$ !
$ SET NOON
$ SET VERIFY
$ MACRO TB70B
$ LINK/MAP=TB70B/FULL TB70B
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ LINK/MAP=TB70BNT/FULL/NOTRACEBACK/EXECUTABLE=TB70BNT TB70B
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ !
$ ! Where a routine ends, with traceback and without.
$ !
$ DEFINE TB70B_PART R
$ RUN TB70B
R1 return PC at routine+3FF
%SYSTEM-W-ENDOFFILE, end of file
%TRACE-W-TRACEBACK, symbolic stack dump follows
module name     routine name                     line       rel PC    abs PC

TB70B           R3FF                                       000003FF  000009C0
TB70B           PART_R                                     00000039  00000586
TB70B           TB70B                                      00000036  00000436
R2 return PC at routine+400
%SYSTEM-W-ENDOFFILE, end of file
%TRACE-W-TRACEBACK, symbolic stack dump follows
module name     routine name                     line       rel PC    abs PC

TB70B           CODE                                       000009C1  00000DC1
TB70B           PART_R                                     00000070  000005BD
TB70B           TB70B                                      00000036  00000436
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00000001"
$ RUN TB70BNT
R1 return PC at routine+3FF
%SYSTEM-W-ENDOFFILE, end of file
R2 return PC at routine+400
%SYSTEM-W-ENDOFFILE, end of file
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00000001"
$ !
$ ! Which conditions get the "improperly handled" dump, and the stack
$ ! it shows: without traceback (and part S with it).
$ !
$ DEFINE TB70B_PART O
%DCL-I-SUPERSEDE, previous value of TB70B_PART has been superseded
$ RUN TB70BNT
