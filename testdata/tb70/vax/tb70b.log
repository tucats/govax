$ !
$ ! Success, informational, and warning messages with SYS$OUTPUT and
$ ! SYS$ERROR apart: the program writing nothing to SYS$OUTPUT (N), and
$ ! a line first (M).
$ !
$ DEFINE TB70B_PART N
%DCL-I-SUPERSEDE, previous value of TB70B_PART has been superseded
$ DEFINE/USER_MODE SYS$OUTPUT TB70BOUTN.LOG
$ DEFINE/USER_MODE SYS$ERROR TB70BERRN.LOG
$ RUN TB70B
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00000001"
$ TYPE TB70BOUTN.LOG
%SYSTEM-S-NORMAL, normal successful completion
%SYSTEM-I-EOTIN, EOT response to text
%SYSTEM-W-ENDOFFILE, end of file
%TRACE-W-TRACEBACK, symbolic stack dump follows
module name     routine name                     line       rel PC    abs PC

TB70B           CONDS                                      00000025  00000549
TB70B           TB70B                                      000000A6  000004A6
