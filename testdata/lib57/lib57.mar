	.ENTRY	START,^M<R2,R3,R4,R5>
	PUSHAW	SELLEN
	PUSHL	#0
	PUSHAQ	SELDSC
	CALLS	#3,G^LIB$GET_FOREIGN
	MOVL	R0,FORSTAT
	BLBC	R0,1$
	TSTW	SELLEN
	BNEQ	2$
1$:	MOVC3	#8,CHILDGRP,SELBUF	; no command text: NOCLI's child
	MOVW	#8,SELLEN
2$:	MOVW	SELLEN,SELOUT
	PUSHAQ	SELOUT
	PUSHAQ	SELOUT
	CALLS	#2,G^STR$UPCASE
	CMPC5	SELLEN,SELBUF,#^A/ /,#3,G1_NAME
	BEQL	2000$
	BRW	1000$
