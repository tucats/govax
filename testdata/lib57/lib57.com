$ ! LIB57.COM - the Phase 57 probe of LIBRTL's CLI routines.
$ ! Written by testdata/lib57/gen.go. Run it with the exchange volume's
$ ! [000000] as the default directory:
$ !
$ !     @LIB57/OUTPUT=LIB57.LOG
$ !
$ ! DEF_LIBCLI.ANL gets the $LIBCLIDEF probe's analysis, LIB57.LOG the
$ ! rest.
$ SET NOON
$ SET VERIFY
$ WRITE SYS$OUTPUT F$GETSYI("VERSION")
$ DEV = F$PARSE("[000000]",,,"DEVICE")
$ SET DEFAULT 'DEV'[000000]
$ LIB57_DIR == DEV + "[000000]"
$ LIB57 :== $'DEV'[000000]LIB57.EXE
$ MACRO/NOLIST LIB57
$ MACRO/NOLIST LIB57B
$ LINK/NOMAP LIB57
$ LINK/NOMAP LIB57B
$ MACRO/NOLIST DEF_LIBCLI
$ ANALYZE/OBJECT/OUTPUT=DEF_LIBCLI.ANL DEF_LIBCLI.OBJ
$ !
$ ! S1: symbols at command level 1
$ G1 == "global one"
$ L1 = "local one"
$ ABBR*EV = "abbreviated"
$ NUM = -42
$ BOTH == "global both"
$ BOTH = "local both"
$ AMB*IG = "ambiguous"
$ DEL_L = "delete me"
$ DEL_G == "delete me too"
$ DEL_W == "global, deleted from the local table"
$ DEL_AB*BR = "abbreviated, deleted"
$ LIB57 SYM
$ SHOW SYMBOL $STATUS
$ SHOW SYMBOL/LOCAL S_LOCAL
$ SHOW SYMBOL/GLOBAL S_GLOBAL
$ SHOW SYMBOL/LOCAL S_ONE
$ SHOW SYMBOL S_ZERO
$ SHOW SYMBOL S_THREE
$ SHOW SYMBOL S_LOWER
$ SHOW SYMBOL S_AB
$ SHOW SYMBOL S_ABBREV
$ SHOW SYMBOL _UNDER
$ SHOW SYMBOL $DOLLAR
$ SHOW SYMBOL S_DASH
$ SHOW SYMBOL S_V255
$ SHOW SYMBOL S_V256
$ WRITE SYS$OUTPUT F$LENGTH(S_V1024)
$ SHOW SYMBOL S_V4097
$ SHOW SYMBOL AMBIG
$ SHOW SYMBOL AM
$ SHOW SYMBOL AMBX
$ SHOW SYMBOL S_EMPTY
$ SHOW SYMBOL S_CASE
$ SHOW SYMBOL/LOCAL G1
$ SHOW SYMBOL/GLOBAL G1
$ SHOW SYMBOL S_ONEARG
$ SHOW SYMBOL DEL_L
$ SHOW SYMBOL DEL_G
$ SHOW SYMBOL DEL_W
$ SHOW SYMBOL DEL_ABBR
$ SHOW SYMBOL L1
$ SHOW SYMBOL NUM
$ !
$ ! S2: symbols at command level 2
$ LOCOUT = "outer local"
$ LOCDEL = "outer, to be deleted"
$ @LIB57S SYMOUT
$ SHOW SYMBOL $STATUS
$ SHOW SYMBOL S_INNER
$ SHOW SYMBOL S_INNERG
$ SHOW SYMBOL LOCOUT
$ SHOW SYMBOL LOCDEL
$ !
$ ! S3: logical names
$ DEFINE LIB57_D "to delete"
$ DEFINE/JOB LIB57_JD "job, to delete"
$ DEFINE/USER_MODE LIB57_U "user mode"
$ LIB57 LNM
$ SHOW SYMBOL $STATUS
$ SHOW LOGICAL/PROCESS/FULL LIB57*
$ SHOW LOGICAL/PROCESS "lib57_lower"
$ SHOW LOGICAL/PROCESS "LIB57_TRAIL "
$ SHOW LOGICAL/JOB/FULL LIB57*
$ SHOW LOGICAL/GROUP/FULL LIB57*
$ DEASSIGN/JOB LIB57_B
$ DEASSIGN/JOB LIB57_F
$ DEASSIGN/GROUP LIB57_C
$ !
$ ! S4: the common area
$ LIB57 COM1
$ SHOW SYMBOL $STATUS
$ LIB57 COM2
$ RUN LIB57B
$ SPAWN/OUTPUT=LIB57SP.LOG LIB57 COM2
$ SHOW SYMBOL $STATUS
$ TYPE LIB57SP.LOG
$ !
$ ! S5: LIB$DO_COMMAND
$ CHAINED = "the chained command ran"
$ LIB57 DOSHOW
$ SHOW SYMBOL $STATUS
$ LIB57 DOAT
$ SHOW SYMBOL $STATUS
$ LIB57 DOEMPTY
$ SHOW SYMBOL $STATUS
$ LIB57 DOBLANK
$ SHOW SYMBOL $STATUS
$ LIB57 DOFAIL
$ SHOW SYMBOL $STATUS
$ LIB57 DOWRITE
$ SHOW SYMBOL $STATUS
$ LIB57 DO255
$ SHOW SYMBOL $STATUS
$ LIB57 DO256
$ SHOW SYMBOL $STATUS
$ LIB57 DOEXH
$ SHOW SYMBOL $STATUS
$ LIB57 DOAGAIN
$ SHOW SYMBOL $STATUS
$ @LIB57S DOEXIT
$ SHOW SYMBOL $STATUS
$ LIB57 DOMSG
$ SHOW SYMBOL $STATUS
$ @LIB57S DOLOCAL
$ SHOW SYMBOL CHAINED_LOCAL
$ SET NOVERIFY
$ LIB57 DOSHOW
$ SET VERIFY
$ LIB57 NOGROUP
$ SHOW SYMBOL $STATUS
$ !
$ ! S6: LIB$RUN_PROGRAM
$ LIB57 RUNB
$ SHOW SYMBOL $STATUS
$ LIB57 RUNAGAIN
$ SHOW SYMBOL $STATUS
$ LIB57 RUNEXH
$ SHOW SYMBOL $STATUS
$ LIB57 RUNSPEC
$ SHOW SYMBOL $STATUS
$ LIB57 RUNNONE
$ SHOW SYMBOL $STATUS
$ LIB57 RUNEMPTY
$ SHOW SYMBOL $STATUS
$ LIB57 RUNARGS
$ SHOW SYMBOL $STATUS
$ LIB57 RUN256
$ SHOW SYMBOL $STATUS
$ !
$ ! S7: the control keys
$ SET CONTROL=(Y,T)
$ ON CONTROL_Y THEN GOTO NEVER
$ CTL = "WRITE SYS$OUTPUT F$ENVIRONMENT(""CONTROL""), "" / "", F$ENVIRONMENT(""NOCONTROL""), "" / "", F$ENVIRONMENT(""ON_CONTROL_Y"")"
$ CTL
$ LIB57 CTLQ
$ CTL
$ LIB57 CTLDT
$ CTL
$ LIB57 CTLET
$ CTL
$ LIB57 CTLDY
$ CTL
$ ON CONTROL_Y THEN GOTO NEVER
$ LIB57 CTLEY
$ CTL
$ LIB57 CTLBOTH
$ CTL
$ LIB57 CTLBAD
$ CTL
$ SET CONTROL=(Y,T)
$ SPAWN/OUTPUT=LIB57SC.LOG @LIB57P
$ CTL
$ TYPE LIB57SC.LOG
$ SET NOCONTROL=T
$ !
$ ! S8: LIB$ATTACH's refusals
$ LIB57 ATTSELF
$ SHOW SYMBOL $STATUS
$ LIB57 ATTNONE
$ SHOW SYMBOL $STATUS
$ LIB57 ATTZERO
$ SHOW SYMBOL $STATUS
$ !
$ ! S9: no CLI
$ OPEN/WRITE IN LIB57N.DAT
$ WRITE IN "the command line"
$ CLOSE IN
$ LIB57 NOCLI
$ SHOW SYMBOL $STATUS
$ TYPE LIB57N.OUT
$ IF F$SEARCH("LIB57N.ERR") .NES. "" THEN TYPE LIB57N.ERR
$ !
$ ! The end.
$ SET NOVERIFY
$ EXIT
$ NEVER:
$ WRITE SYS$OUTPUT "ON CONTROL_Y's GOTO: not expected"
$ EXIT
