DBG89                           Phase 89 probe: SET SCOPE on a recursion  4-NOV-2026 16:21:49  VAX MACRO V5.4-3            Page   1
01                                                                        5-NOV-2026 07:42:26  DUA1:[000000]DBG89.MAR;1          (1)

                                     0000     1 	.TITLE	DBG89	Phase 89 probe: SET SCOPE on a recursion
                                     0000     2 	.IDENT	/01/
                                     0000     3 ; DBG89.MAR - the program behind Phase 89's debugger probe (README.md). START
                                     0000     4 ; calls DBG89B (another module's routine, which returns at once), then REC(3),
                                     0000     5 ; which calls itself down to REC(1), which calls LEAF. Each register a routine
                                     0000     6 ; writes says who wrote it: REC(n) leaves n*^X100 + k in Rk (R1 to R5), START
                                     0000     7 ; ^X1000 + k, LEAF ^X6006 in R6 and ^X7007 in R7. REC saves R2 to R4 and not
                                     0000     8 ; R5; LEAF saves R6 and not R7; START saves R2 to R5. So in each scope the
                                     0000     9 ; register a frame above saved, and the one nothing saved, can be told apart.
                                     0000    10 ; Y is a datum in both modules; DEPTH counts REC's activations.
                                     0000    11 
                                 00000000    12 	.PSECT	DATA89, WRT, NOEXE, LONG
                           00001111  0000    13 Y:	.LONG	^X1111			; DBG89's Y; DBG89B has one too
                           00000000  0004    14 DEPTH:	.LONG	0			; REC's activations so far
                                     0008    15 
                                 00000000    16 	.PSECT	CODE89, NOWRT, EXE, LONG
                               003C  0000    17 	.ENTRY	START, ^M<R2,R3,R4,R5>
              52   00001002 8F   D0  0002    18 	MOVL	#^X1002, R2
              53   00001003 8F   D0  0009    19 	MOVL	#^X1003, R3
              54   00001004 8F   D0  0010    20 	MOVL	#^X1004, R4
              55   00001005 8F   D0  0017    21 	MOVL	#^X1005, R5
              00000000'GF   00   FB  001E    22 	CALLS	#0, G^DBG89B		; another module's routine
                            03   DD  0025    23 	PUSHL	#3
              00000032'EF   01   FB  0027    24 	CALLS	#1, REC			; REC(3), recursively
                       50   01   D0  002E    25 	MOVL	#1, R0
                                 04  0031    26 	RET
                                     0032    27 
                               001C  0032    28 	.ENTRY	REC, ^M<R2,R3,R4>	; R5 is written but not saved
      51   04 AC   00000100 8F   C5  0034    29 	MULL3	#^X100, 4(AP), R1	; n*^X100
                  52   51   02   C1  003D    30 	ADDL3	#2, R1, R2
                  53   51   03   C1  0041    31 	ADDL3	#3, R1, R3
                  54   51   04   C1  0045    32 	ADDL3	#4, R1, R4
                  55   51   05   C1  0049    33 	ADDL3	#5, R1, R5
                   00000004'EF   D6  004D    34 	INCL	DEPTH
                    01   04 AC   D1  0053    35 	CMPL	4(AP), #1
                            0B   14  0057    36 	BGTR	RECUR
              00000072'EF   00   FB  0059    37 	CALLS	#0, LEAF		; REC(1) calls LEAF
                       50   01   D0  0060    38 DEEP:	MOVL	#1, R0
                                 04  0063    39 	RET
               7E   04 AC   01   C3  0064    40 RECUR:	SUBL3	#1, 4(AP), -(SP)
                    C5 AF   01   FB  0069    41 	CALLS	#1, REC
                    50   04 AC   C4  006D    42 BACK:	MULL2	4(AP), R0		; each inner REC returns here
                                 04  0071    43 	RET
                                     0072    44 
                               0040  0072    45 	.ENTRY	LEAF, ^M<R6>		; R7 is written but not saved
              56   00006006 8F   D0  0074    46 	MOVL	#^X6006, R6
              57   00007007 8F   D0  007B    47 	MOVL	#^X7007, R7
              50   00000F00 8F   D0  0082    48 	MOVL	#^X0F00, R0
              51   00000F01 8F   D0  0089    49 	MOVL	#^X0F01, R1
                                 01  0090    50 INLEAF:	NOP
                                 04  0091    51 	RET
                                     0092    52 
                                     0092    53 	.END	START
