$ ! LNM91.COM - Phase 91's probe of concealed and rooted logical names.
$ ! Written by testdata/lnm91/gen.go. Run it on the exchange volume,
$ ! with that volume's [000000] as the default directory:
$ !
$ !     @LNM91/OUTPUT=LNM91.LOG
$ !
$ SET NOON
$ SET VERIFY
$ !
$ WRITE SYS$OUTPUT "######## ENVIRONMENT"
######## ENVIRONMENT
$ WRITE SYS$OUTPUT F$GETSYI("VERSION"), " ", F$GETSYI("HW_NAME"), " ", F$GETSYI("NODENAME")
V7.1     VAX 8600 SIMVAX
$ DEV = F$PARSE("[000000]",,,"DEVICE")
$ PDEV = F$GETDVI(DEV,"DEVNAM")
$ BARE = F$EXTRACT(1,99,PDEV)
$ SHOW SYMBOL DEV
  DEV = "DUA1:"
$ SHOW SYMBOL PDEV
  PDEV = "_DUA1:"
$ SHOW SYMBOL BARE
  BARE = "DUA1:"
$ SET DEFAULT DUA1:[000000]
$ SHOW DEFAULT
  DUA1:[000000]
$ SHOW LOGICAL/FULL SYS$SYSROOT
   "SYS$SYSROOT" [exec] = "SIMVAX$DUA0:[SYS0.]" [concealed,terminal] (LNM$SYSTEM_TABLE)
	= "SYS$COMMON:"
1  "SYS$COMMON" [exec] = "SIMVAX$DUA0:[SYS0.SYSCOMMON.]" [concealed,terminal] (LNM$SYSTEM_TABLE)
$ SHOW LOGICAL/FULL SYS$SYSDEVICE
   "SYS$SYSDEVICE" [exec] = "SIMVAX$DUA0:" [concealed,terminal] (LNM$SYSTEM_TABLE)
$ SHOW LOGICAL/FULL SYS$COMMON
   "SYS$COMMON" [exec] = "SIMVAX$DUA0:[SYS0.SYSCOMMON.]" [concealed,terminal] (LNM$SYSTEM_TABLE)
$ SHOW LOGICAL/FULL SYS$SPECIFIC
   "SYS$SPECIFIC" [exec] = "SIMVAX$DUA0:[SYS0.]" [concealed,terminal] (LNM$SYSTEM_TABLE)
$ SHOW LOGICAL/FULL SYS$SYSTEM
   "SYS$SYSTEM" [exec] = "SYS$SYSROOT:[SYSEXE]" (LNM$SYSTEM_TABLE)
$ SHOW LOGICAL/FULL SYS$MANAGER
   "SYS$MANAGER" [exec] = "SYS$SYSROOT:[SYSMGR]" (LNM$SYSTEM_TABLE)
$ SHOW LOGICAL/FULL SYS$HELP
   "SYS$HELP" [exec] = "SYS$SYSROOT:[SYSHLP]" (LNM$SYSTEM_TABLE)
$ SHOW LOGICAL/FULL SYS$LIBRARY
   "SYS$LIBRARY" [exec] = "SYS$SYSROOT:[SYSLIB]" (LNM$SYSTEM_TABLE)
$ SHOW LOGICAL/FULL SYS$SHARE
   "SYS$SHARE" [exec] = "SYS$SYSROOT:[SYSLIB]" (LNM$SYSTEM_TABLE)
$ SHOW LOGICAL/FULL SYS$DISK
   "SYS$DISK" [super,crelog] = "DUA1:" (LNM$PROCESS_TABLE)
   "SYS$DISK" [exec] = "SIMVAX$DUA0:" [concealed,terminal] (LNM$SYSTEM_TABLE)
$ SHOW LOGICAL/FULL DISK$*

(LNM$PROCESS_TABLE)	[kernel]
			[no protection information]

(LNM$JOB_81C7AA80)	[kernel]  [shareable]  [Quota=(3840,4096)]
			[Protection=(RWCD,RWCD,,)]  [Owner=[SYSTEM]]

  "DISK$LNM91" [super] = "SIMVAX$DUA1:" [concealed,terminal]

(LNM$GROUP_000001)	[kernel]  [shareable,group]
			[Protection=(RWCD,R,R,)]  [Owner=[1,*]]

(LNM$SYSTEM_TABLE)	[kernel]  [shareable,system]
			[Protection=(RWC,RWC,R,R)]  [Owner=[SYSTEM]]

  "DISK$OPENVMS071" [exec] = "SIMVAX$DUA0:" [concealed,terminal]
