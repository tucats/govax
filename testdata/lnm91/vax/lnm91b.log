$ !
$ WRITE SYS$OUTPUT "######## ENVIRONMENT"
######## ENVIRONMENT
$ WRITE SYS$OUTPUT F$GETSYI("VERSION"), " ", F$GETSYI("HW_NAME"), " ", F$GETSYI("NODENAME")
V7.1     VAX 8600 SIMVAX
$ DEV = F$PARSE("[000000]",,,"DEVICE")
$ PDEV = F$GETDVI(DEV,"DEVNAM")
$ SHOW SYMBOL DEV
  DEV = "DUA1:"
$ SHOW SYMBOL PDEV
  PDEV = "_DUA1:"
$ SET DEFAULT DUA1:[000000]
$ !
$ WRITE SYS$OUTPUT "######## TREE"
######## TREE
$ CREATE/DIRECTORY DUA1:[LNM91.SUB]
$ CREATE/DIRECTORY DUA1:[LNM91.ROOT1]
$ CREATE/DIRECTORY DUA1:[SUB]
$ CREATE/DIRECTORY DUA1:[JONES]
$ CREATE/DIRECTORY DUA1:[OTHER]
$ CREATE/DIRECTORY DUA1:[R1.R2.R3.R4.R5.R6.R7]
$ CREATE T.DAT
template record
$ !
$ COPY T.DAT DUA1:[LNM91]A.DAT
$ COPY T.DAT DUA1:[LNM91.SUB]A.DAT
$ COPY T.DAT DUA1:[LNM91.ROOT1]A.DAT
$ COPY T.DAT DUA1:[SUB]A.DAT
$ COPY T.DAT DUA1:[JONES]A.DAT
$ COPY T.DAT DUA1:[OTHER]A.DAT
$ DEFINE/USER_MODE SYS$OUTPUT LNM91.MLG
$ MACRO/NOLIST LNM91
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ DEFINE/USER_MODE SYS$OUTPUT LNM91.LLG
$ LINK/NOMAP LNM91
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ IF F$SEARCH("LNM91.EXE") .EQS. "" THEN EXIT
$ PROG = DEV + "[000000]LNM91"
$ !
$ WRITE SYS$OUTPUT "######## DEFINITIONS"
######## DEFINITIONS
$ DEFINE LDEV _DUA1:
$ SHOW LOGICAL/FULL LDEV
   "LDEV" [super] = "_DUA1:" (LNM$PROCESS_TABLE)
$ DEFINE P _DUA1:[LNM91]
$ SHOW LOGICAL/FULL P
   "P" [super] = "_DUA1:[LNM91]" (LNM$PROCESS_TABLE)
$ DEFINE P2 P:
$ SHOW LOGICAL/FULL P2
   "P2" [super] = "P:" (LNM$PROCESS_TABLE)
1  "P" [super] = "_DUA1:[LNM91]" (LNM$PROCESS_TABLE)
$ DEFINE P3 LDEV:[LNM91]
$ SHOW LOGICAL/FULL P3
   "P3" [super] = "LDEV:[LNM91]" (LNM$PROCESS_TABLE)
$ DEFINE N _DUA1:[LNM91]A.DAT
$ SHOW LOGICAL/FULL N
   "N" [super] = "_DUA1:[LNM91]A.DAT" (LNM$PROCESS_TABLE)
$ DEFINE L _DUA1:[LNM91],_DUA1:[LNM91.SUB]
$ SHOW LOGICAL/FULL L
   "L" [super] = "_DUA1:[LNM91]" (LNM$PROCESS_TABLE)
	= "_DUA1:[LNM91.SUB]"
$ DEFINE/TRANSLATION_ATTRIBUTES=CONCEALED C _DUA1:[LNM91]
$ SHOW LOGICAL/FULL C
   "C" [super] = "_DUA1:[LNM91]" [concealed] (LNM$PROCESS_TABLE)
$ DEFINE/TRANSLATION_ATTRIBUTES=(CONCEALED,TERMINAL) C2 _DUA1:[LNM91]
$ SHOW LOGICAL/FULL C2
   "C2" [super] = "_DUA1:[LNM91]" [concealed,terminal] (LNM$PROCESS_TABLE)
$ DEFINE/TRANSLATION_ATTRIBUTES=CONCEALED C3 LDEV:[LNM91]
$ SHOW LOGICAL/FULL C3
   "C3" [super] = "LDEV:[LNM91]" [concealed] (LNM$PROCESS_TABLE)
$ DEFINE/TRANSLATION_ATTRIBUTES=(CONCEALED,TERMINAL) D7 _DUA1:[R1.R2.R3.R4.R5.R6.R7.]
$ SHOW LOGICAL/FULL D7
   "D7" [super] = "_DUA1:[R1.R2.R3.R4.R5.R6.R7.]" [concealed,terminal] (LNM$PROCESS_TABLE)
$ !
