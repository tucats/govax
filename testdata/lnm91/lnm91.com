$ WRITE SYS$OUTPUT "######## DEVICES"
$ RUN 'PROG'
D- BASE:
D- CONC:
D- NOCON:
D- TERM:
D- PHYS:
D- CDISK:
D- LDEV:
D- A1:
D- A2:
D- A3:
D- A4:
D- LIST:
D- SYS$SYSROOT:
D- SYS$COMMON:
D- SYS$SYSDEVICE:
D- SYS$SYSTEM:
P- SYS$SYSROOT:[SYSEXE]LOGINOUT.EXE
PN SYS$SYSROOT:[SYSEXE]LOGINOUT.EXE
S- SYS$SYSROOT:[SYSEXE]LOGINOUT.EXE
SN SYS$SYSROOT:[SYSEXE]LOGINOUT.EXE
S- SYS$SYSTEM:LOGINOUT.EXE
SN SYS$SYSTEM:LOGINOUT.EXE
S- SYS$COMMON:[SYSEXE]LOGINOUT.EXE
SN SYS$COMMON:[SYSEXE]LOGINOUT.EXE
S- SYS$SPECIFIC:[SYSEXE]*.EXE
F- SYS$SYSTEM:LOGINOUT.EXE
$ SHOW SYMBOL $STATUS
$ !
$ WRITE SYS$OUTPUT "######## DCL: F$PARSE"
$ SET DEFAULT 'DEV'[JONES]
$ CALL FP "BASE:[SUB]A.DAT"
$ CALL FP "BASE:A.DAT"
$ CALL FP "BASE:"
$ CALL FP "BASE:[000000]A.DAT"
$ CALL FP "BASE:[-]A.DAT"
$ CALL FP "NOCON:[SUB]A.DAT"
$ CALL FP "CDISK:[LNM91]A.DAT"
$ CALL FP "A1:A.DAT"
$ CALL FP "A2:A.DAT"
$ CALL FP "LIST:[SUB]A.DAT"
$ CALL FP "LDEV:[LNM91.ROOT1.][SUB]A.DAT"
$ CALL FP "BASE:[NOSUCH]A.DAT"
$ CALL FP "BASE:[--]A.DAT"
$ CALL FP "SYS$SYSTEM:LOGINOUT.EXE"
$ CALL FP "SYS$SYSROOT:[SYSEXE]"
$ !
$ WRITE SYS$OUTPUT "######## DCL: F$SEARCH, F$TRNLNM, F$GETDVI, F$FILE_ATTRIBUTES"
$ WRITE SYS$OUTPUT F$SEARCH("BASE:[SUB]A.DAT")
$ WRITE SYS$OUTPUT F$SEARCH("X.NOSUCH")
$ WRITE SYS$OUTPUT F$SEARCH("BASE:[*...]A.DAT")
$ WRITE SYS$OUTPUT F$SEARCH("X.NOSUCH")
$ WRITE SYS$OUTPUT F$SEARCH("A1:A.DAT")
$ WRITE SYS$OUTPUT F$SEARCH("X.NOSUCH")
$ WRITE SYS$OUTPUT F$SEARCH("CDISK:[LNM91.ROOT1]A.DAT")
$ WRITE SYS$OUTPUT F$SEARCH("X.NOSUCH")
$ WRITE SYS$OUTPUT "BASE ", F$TRNLNM("BASE"), " ", F$TRNLNM("BASE",,,,,"CONCEALED"), " ", F$TRNLNM("BASE",,,,,"TERMINAL")
$ WRITE SYS$OUTPUT "CONC ", F$TRNLNM("CONC"), " ", F$TRNLNM("CONC",,,,,"CONCEALED"), " ", F$TRNLNM("CONC",,,,,"TERMINAL")
$ WRITE SYS$OUTPUT "NOCON ", F$TRNLNM("NOCON"), " ", F$TRNLNM("NOCON",,,,,"CONCEALED"), " ", F$TRNLNM("NOCON",,,,,"TERMINAL")
$ WRITE SYS$OUTPUT "A1 ", F$TRNLNM("A1"), " ", F$TRNLNM("A1",,,,,"CONCEALED"), " ", F$TRNLNM("A1",,,,,"TERMINAL")
$ WRITE SYS$OUTPUT "SYS$SYSROOT ", F$TRNLNM("SYS$SYSROOT"), " ", F$TRNLNM("SYS$SYSROOT",,,,,"CONCEALED"), " ", F$TRNLNM("SYS$SYSROOT",,,,,"TERMINAL")
$ WRITE SYS$OUTPUT "SYS$SYSDEVICE ", F$TRNLNM("SYS$SYSDEVICE"), " ", F$TRNLNM("SYS$SYSDEVICE",,,,,"CONCEALED"), " ", F$TRNLNM("SYS$SYSDEVICE",,,,,"TERMINAL")
$ WRITE SYS$OUTPUT "BASE: ", F$GETDVI("BASE:","DEVNAM"), " ", F$GETDVI("BASE:","FULLDEVNAM"), " ", F$GETDVI("BASE:","CONCEALED")
$ WRITE SYS$OUTPUT "CONC: ", F$GETDVI("CONC:","DEVNAM"), " ", F$GETDVI("CONC:","FULLDEVNAM"), " ", F$GETDVI("CONC:","CONCEALED")
$ WRITE SYS$OUTPUT "NOCON: ", F$GETDVI("NOCON:","DEVNAM"), " ", F$GETDVI("NOCON:","FULLDEVNAM"), " ", F$GETDVI("NOCON:","CONCEALED")
$ WRITE SYS$OUTPUT "CDISK: ", F$GETDVI("CDISK:","DEVNAM"), " ", F$GETDVI("CDISK:","FULLDEVNAM"), " ", F$GETDVI("CDISK:","CONCEALED")
$ WRITE SYS$OUTPUT "A1: ", F$GETDVI("A1:","DEVNAM"), " ", F$GETDVI("A1:","FULLDEVNAM"), " ", F$GETDVI("A1:","CONCEALED")
$ WRITE SYS$OUTPUT "SYS$SYSROOT: ", F$GETDVI("SYS$SYSROOT:","DEVNAM"), " ", F$GETDVI("SYS$SYSROOT:","FULLDEVNAM"), " ", F$GETDVI("SYS$SYSROOT:","CONCEALED")
$ WRITE SYS$OUTPUT "SYS$SYSTEM: ", F$GETDVI("SYS$SYSTEM:","DEVNAM"), " ", F$GETDVI("SYS$SYSTEM:","FULLDEVNAM"), " ", F$GETDVI("SYS$SYSTEM:","CONCEALED")
$ WRITE SYS$OUTPUT F$FILE_ATTRIBUTES("BASE:[SUB]A.DAT","FID")
$ WRITE SYS$OUTPUT F$FILE_ATTRIBUTES("BASE:[SUB]A.DAT","DVI")
$ !
$ WRITE SYS$OUTPUT "######## DCL: SET DEFAULT"
$ SET DEFAULT BASE:[SUB]
$ SHOW DEFAULT
$ SHOW LOGICAL SYS$DISK
$ SET DEFAULT [.DEEP]
$ SHOW DEFAULT
$ SHOW LOGICAL SYS$DISK
$ SET DEFAULT [-]
$ SHOW DEFAULT
$ SHOW LOGICAL SYS$DISK
$ SET DEFAULT [-]
$ SHOW DEFAULT
$ SHOW LOGICAL SYS$DISK
$ SET DEFAULT [-]
$ SHOW DEFAULT
$ SHOW LOGICAL SYS$DISK
$ SET DEFAULT BASE:
$ SHOW DEFAULT
$ SHOW LOGICAL SYS$DISK
$ SET DEFAULT BASE:[000000]
$ SHOW DEFAULT
$ SHOW LOGICAL SYS$DISK
$ SET DEFAULT [-]
$ SHOW DEFAULT
$ SHOW LOGICAL SYS$DISK
$ SET DEFAULT BASE:[NOSUCH]
$ SHOW DEFAULT
$ SHOW LOGICAL SYS$DISK
$ SET DEFAULT A1:
$ SHOW DEFAULT
$ SHOW LOGICAL SYS$DISK
$ SET DEFAULT A2:
$ SHOW DEFAULT
$ SHOW LOGICAL SYS$DISK
$ SET DEFAULT A3:
$ SHOW DEFAULT
$ SHOW LOGICAL SYS$DISK
$ SET DEFAULT A4:
$ SHOW DEFAULT
$ SHOW LOGICAL SYS$DISK
$ SET DEFAULT NOCON:[SUB]
$ SHOW DEFAULT
$ SHOW LOGICAL SYS$DISK
$ SET DEFAULT CONC:[SUB]
$ SHOW DEFAULT
$ SHOW LOGICAL SYS$DISK
$ SET DEFAULT TERM:[SUB]
$ SHOW DEFAULT
$ SHOW LOGICAL SYS$DISK
$ SET DEFAULT LDEV:[LNM91.ROOT1.][SUB]
$ SHOW DEFAULT
$ SHOW LOGICAL SYS$DISK
$ SET DEFAULT LIST:[SUB]
$ SHOW DEFAULT
$ SHOW LOGICAL SYS$DISK
$ SET DEFAULT SYS$SYSTEM:
$ SHOW DEFAULT
$ SHOW LOGICAL SYS$DISK
$ SET DEFAULT SYS$SYSROOT:[SYSEXE]
$ SHOW DEFAULT
$ SHOW LOGICAL SYS$DISK
$ SET DEFAULT SYS$COMMON:[SYSEXE]
$ SHOW DEFAULT
$ SHOW LOGICAL SYS$DISK
$ !
$ WRITE SYS$OUTPUT "######## DCL: DIRECTORY"
$ SET DEFAULT 'DEV'[JONES]
$ DIRECTORY BASE:[SUB]
$ DIRECTORY BASE:[000000]
$ DIRECTORY BASE:
$ DIRECTORY BASE:[*]
$ DIRECTORY BASE:[*...]*.DAT
$ DIRECTORY BASE:[...]
$ DIRECTORY BASE:[-]
$ DIRECTORY BASE:[--]
$ DIRECTORY NOCON:[SUB]
$ DIRECTORY CONC:[SUB]
$ DIRECTORY CDISK:[LNM91.ROOT1]
$ DIRECTORY A1:
$ DIRECTORY A2:
$ DIRECTORY LIST:[SUB]
$ DIRECTORY LDEV:[LNM91.ROOT1.][SUB]
$ DIRECTORY SYS$SYSTEM:LOGINOUT.EXE
$ DIRECTORY SYS$SYSROOT:[SYSEXE]LOGINOUT.EXE
$ DIRECTORY SYS$COMMON:[SYSEXE]LOGINOUT.EXE
$ DIRECTORY SYS$SPECIFIC:[SYSEXE]*.EXE
$ DIRECTORY/TOTAL BASE:[SUB]
$ DIRECTORY/SIZE BASE:[SUB]A.DAT
$ DIRECTORY/FULL BASE:[SUB]A.DAT
$ SET DEFAULT BASE:[SUB]
$ DIRECTORY *.DIR,[-]*.DIR
$ DIRECTORY
$ SET DEFAULT BASE:[000000]
$ DIRECTORY [-]*.DIR
$ SET DEFAULT CDISK:[LNM91.ROOT1]
$ DIRECTORY
$ !
$ WRITE SYS$OUTPUT "######## DCL: FILE COMMANDS"
$ SET DEFAULT 'DEV'[JONES]
$ CREATE/DIRECTORY/LOG BASE:[NEWD]
$ CREATE/DIRECTORY/LOG BASE:[NEWD.DEEPER]
$ DIRECTORY 'DEV'[000000]NEWD.DIR
$ DIRECTORY 'DEV'[LNM91.ROOT1]NEWD.DIR
$ CREATE BASE:[NEWD]C.DAT
created record
$ !
$ TYPE BASE:[NEWD]C.DAT
$ COPY/LOG BASE:[NEWD]C.DAT BASE:[NEWD]D.DAT
$ COPY/LOG BASE:[NEWD]C.DAT LDEV:[LNM91]E.DAT
$ COPY/LOG LDEV:[LNM91]E.DAT BASE2:[SUB]E.DAT
$ COPY/LOG BASE:[NEWD]C.DAT BASE:[NEWD]
$ RENAME/LOG BASE:[NEWD]D.DAT BASE:[NEWD]F.DAT
$ RENAME/LOG BASE:[NEWD]F.DAT BASE2:[SUB]G.DAT
$ RENAME/LOG BASE:[NEWD]C.DAT H.DAT
$ DIRECTORY BASE:[NEWD],BASE2:[SUB]
$ DUMP/RECORD BASE:[SUB]A.DAT
$ OPEN/WRITE LNM91_O BASE:[NEWD]W.DAT
$ WRITE LNM91_O "written"
$ SHOW LOGICAL/FULL LNM91_O
$ CLOSE LNM91_O
$ OPEN/READ LNM91_O BASE:[NEWD]W.DAT
$ READ LNM91_O R
$ SHOW SYMBOL R
$ CLOSE LNM91_O
$ ANALYZE/RMS_FILE/OUTPUT=LNM91.ANL BASE:[SUB]A.DAT
$ TYPE LNM91.ANL
$ CREATE BASE:[NEWD]P.DAT
one
$ !
$ CREATE BASE:[NEWD]P.DAT
two
$ !
$ PURGE/LOG BASE:[NEWD]P.DAT
$ DELETE/LOG BASE:[NEWD]*.*;*
$ SET PROTECTION=(O:RWED) BASE:[000000]NEWD.DIR
$ DELETE/LOG BASE:[000000]NEWD.DIR;
$ DELETE/LOG BASE2:[SUB]E.DAT;*,G.DAT;*
$ DELETE/LOG LDEV:[LNM91]E.DAT;*
$ !
$ WRITE SYS$OUTPUT "######## DCL: ERRORS AND IMAGES"
$ TYPE BASE:[NOSUCH]X.DAT
$ TYPE BASE:[SUB]NOSUCH.DAT
$ TYPE BASE:[--]X.DAT
$ DIRECTORY BASE:[NOSUCH]
$ RUN BASE:[SUB]NOSUCH
$ RUN SYS$SYSROOT:[SYSEXE]NOSUCH
$ RUN SYS$SYSTEM:NOSUCH
$ !
$ WRITE SYS$OUTPUT "######## DCL: BACKUP"
$ BACKUP/LOG BASE:[SUB...]*.*;* LNM91.BCK/SAVE_SET
$ BACKUP/LIST LNM91.BCK/SAVE_SET
$ BACKUP/LOG LNM91.BCK/SAVE_SET/SELECT=[LNM91.ROOT1.SUB]A.DAT BASE:[OTHER]RESTORED.DAT
$ DIRECTORY BASE:[OTHER]
$ DELETE/LOG BASE:[OTHER]RESTORED.DAT;*
$ !
$ GOTO DONE
$ FP: SUBROUTINE
$ V = F$VERIFY(0)
$ WRITE SYS$OUTPUT "== F$PARSE ", P1
$ WRITE SYS$OUTPUT "  full  <", F$PARSE(P1), ">"
$ WRITE SYS$OUTPUT "  nocon <", F$PARSE(P1,,,,"NO_CONCEAL"), ">"
$ WRITE SYS$OUTPUT "  synt  <", F$PARSE(P1,,,,"SYNTAX_ONLY"), ">"
$ WRITE SYS$OUTPUT "  dev   <", F$PARSE(P1,,,"DEVICE"), "> dir <", F$PARSE(P1,,,"DIRECTORY"), ">"
$ WRITE SYS$OUTPUT "  ndev  <", F$PARSE(P1,,,"DEVICE","NO_CONCEAL"), "> ndir <", F$PARSE(P1,,,"DIRECTORY","NO_CONCEAL"), ">"
$ WRITE SYS$OUTPUT "  name  <", F$PARSE(P1,,,"NAME"), "> type <", F$PARSE(P1,,,"TYPE"), "> ver <", F$PARSE(P1,,,"VERSION"), ">"
$ V = F$VERIFY(V)
$ ENDSUBROUTINE
$ DONE:
$ !
$ WRITE SYS$OUTPUT "######## CLEANUP"
$ SET DEFAULT 'DEV'[000000]
$ DEASSIGN LDEV
$ DEASSIGN CDISK
$ DEASSIGN BASE
$ DEASSIGN BASE2
$ DEASSIGN CONC
$ DEASSIGN CONC2
$ DEASSIGN NOCON
$ DEASSIGN TERM
$ DEASSIGN PHYS
$ DEASSIGN A1
$ DEASSIGN A2
$ DEASSIGN A3
$ DEASSIGN A4
$ DEASSIGN A5
$ DEASSIGN LIST
$ DEASSIGN LIST2
$ DEASSIGN LIST3
$ DEASSIGN DEEP7
$ DEASSIGN DEEP8
$ DEASSIGN DEEP9
$ DEASSIGN LNM91_F
$ SHOW DEFAULT
$ WRITE SYS$OUTPUT "LNM91 FINISHED"
$ SET NOVERIFY
$ EXIT
