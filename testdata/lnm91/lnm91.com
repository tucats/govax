$ ! LNM91.COM - Phase 91's probe of concealed and rooted logical names.
$ ! Written by testdata/lnm91/gen.go. Run it on the exchange volume,
$ ! with that volume's [000000] as the default directory:
$ !
$ !     @LNM91/OUTPUT=LNM91.LOG
$ !
$ SET NOON
$ SET VERIFY
$ !
$ WRITE SYS$OUTPUT "######## ENVIRONMENT"
$ WRITE SYS$OUTPUT F$GETSYI("VERSION"), " ", F$GETSYI("HW_NAME"), " ", F$GETSYI("NODENAME")
$ DEV = F$PARSE("[000000]",,,"DEVICE")
$ PDEV = F$GETDVI(DEV,"DEVNAM")
$ BARE = F$EXTRACT(1,99,PDEV)
$ SHOW SYMBOL DEV
$ SHOW SYMBOL PDEV
$ SHOW SYMBOL BARE
$ SET DEFAULT 'DEV'[000000]
$ SHOW DEFAULT
$ SHOW LOGICAL/FULL SYS$SYSROOT
$ SHOW LOGICAL/FULL SYS$SYSDEVICE
$ SHOW LOGICAL/FULL SYS$COMMON
$ SHOW LOGICAL/FULL SYS$SPECIFIC
$ SHOW LOGICAL/FULL SYS$SYSTEM
$ SHOW LOGICAL/FULL SYS$MANAGER
$ SHOW LOGICAL/FULL SYS$HELP
$ SHOW LOGICAL/FULL SYS$LIBRARY
$ SHOW LOGICAL/FULL SYS$SHARE
$ SHOW LOGICAL/FULL SYS$DISK
$ SHOW LOGICAL/FULL DISK$*
$ !
$ WRITE SYS$OUTPUT "######## TREE"
$ CREATE/DIRECTORY 'DEV'[LNM91.ROOT1.SUB.DEEP]
$ CREATE/DIRECTORY 'DEV'[LNM91.ROOT1.JONES.K]
$ CREATE/DIRECTORY 'DEV'[LNM91.ROOT1.OTHER]
$ CREATE/DIRECTORY 'DEV'[LNM91.ROOT1.TOP]
$ CREATE/DIRECTORY 'DEV'[LNM91.ROOT2.SUB]
$ CREATE/DIRECTORY 'DEV'[SUB]
$ CREATE/DIRECTORY 'DEV'[JONES]
$ CREATE/DIRECTORY 'DEV'[OTHER]
$ CREATE/DIRECTORY 'DEV'[D1.D2.D3.D4.D5.D6.D7.D8]
$ CREATE T.DAT
template record
$ !
$ COPY T.DAT 'DEV'[LNM91.ROOT1]A.DAT
$ COPY T.DAT 'DEV'[LNM91.ROOT1.SUB]A.DAT
$ COPY T.DAT 'DEV'[LNM91.ROOT1.SUB.DEEP]A.DAT
$ COPY T.DAT 'DEV'[LNM91.ROOT1.JONES]A.DAT
$ COPY T.DAT 'DEV'[LNM91.ROOT1.JONES.K]A.DAT
$ COPY T.DAT 'DEV'[LNM91.ROOT1.OTHER]A.DAT
$ COPY T.DAT 'DEV'[LNM91.ROOT2.SUB]A.DAT
$ COPY T.DAT 'DEV'[SUB]A.DAT
$ COPY T.DAT 'DEV'[JONES]A.DAT
$ COPY T.DAT 'DEV'[OTHER]A.DAT
$ COPY T.DAT 'DEV'[LNM91.ROOT2.SUB]B.DAT
$ DEFINE/USER_MODE SYS$OUTPUT LNM91.MLG
$ MACRO/NOLIST LNM91
$ SHOW SYMBOL $STATUS
$ DEFINE/USER_MODE SYS$OUTPUT LNM91.LLG
$ LINK/NOMAP LNM91
$ SHOW SYMBOL $STATUS
$ IF F$SEARCH("LNM91.EXE") .EQS. "" THEN EXIT
$ PROG = DEV + "[000000]LNM91"
$ COPY LNM91.EXE 'DEV'[LNM91.ROOT1.SUB]LNM91.EXE
$ !
$ WRITE SYS$OUTPUT "######## DEFINITIONS"
$ DEFINE LDEV 'PDEV'
$ SHOW LOGICAL/FULL LDEV
$ DEFINE/TRANSLATION_ATTRIBUTES=CONCEALED CDISK 'PDEV'
$ SHOW LOGICAL/FULL CDISK
$ DEFINE/TRANSLATION_ATTRIBUTES=(CONCEALED,TERMINAL) BASE 'PDEV'[LNM91.ROOT1.]
$ SHOW LOGICAL/FULL BASE
$ DEFINE/TRANSLATION_ATTRIBUTES=(CONCEALED,TERMINAL) BASE2 'PDEV'[LNM91.ROOT2.]
$ SHOW LOGICAL/FULL BASE2
$ DEFINE/TRANSLATION_ATTRIBUTES=CONCEALED CONC 'PDEV'[LNM91.ROOT1.]
$ SHOW LOGICAL/FULL CONC
$ DEFINE/TRANSLATION_ATTRIBUTES=CONCEALED CONC2 LDEV:[LNM91.ROOT1.]
$ SHOW LOGICAL/FULL CONC2
$ DEFINE NOCON 'PDEV'[LNM91.ROOT1.]
$ SHOW LOGICAL/FULL NOCON
$ DEFINE/TRANSLATION_ATTRIBUTES=TERMINAL TERM 'PDEV'[LNM91.ROOT1.]
$ SHOW LOGICAL/FULL TERM
$ DEFINE/TRANSLATION_ATTRIBUTES=(CONCEALED,TERMINAL) PHYS 'BARE'[LNM91.ROOT1.]
$ SHOW LOGICAL/FULL PHYS
$ DEFINE A1 BASE:[SUB]
$ SHOW LOGICAL/FULL A1
$ DEFINE A2 BASE:[SUB.]
$ SHOW LOGICAL/FULL A2
$ DEFINE/TRANSLATION_ATTRIBUTES=CONCEALED A3 BASE:
$ SHOW LOGICAL/FULL A3
$ DEFINE/TRANSLATION_ATTRIBUTES=CONCEALED A4 BASE:[SUB]
$ SHOW LOGICAL/FULL A4
$ DEFINE A5 A2:[DEEP]
$ SHOW LOGICAL/FULL A5
$ DEFINE LIST BASE:,BASE2:
$ SHOW LOGICAL/FULL LIST
$ DEFINE/TRANSLATION_ATTRIBUTES=(CONCEALED,TERMINAL) LIST2 'PDEV'[LNM91.ROOT1.],'PDEV'[LNM91.ROOT2.]
$ SHOW LOGICAL/FULL LIST2
$ DEFINE LIST3 NOCON:,CDISK:[LNM91]
$ SHOW LOGICAL/FULL LIST3
$ DEFINE/TRANSLATION_ATTRIBUTES=(CONCEALED,TERMINAL) DEEP7 'PDEV'[D1.D2.D3.D4.D5.D6.D7.]
$ SHOW LOGICAL/FULL DEEP7
$ DEFINE/TRANSLATION_ATTRIBUTES=(CONCEALED,TERMINAL) DEEP8 'PDEV'[D1.D2.D3.D4.D5.D6.D7.D8.]
$ SHOW LOGICAL/FULL DEEP8
$ DEFINE/TRANSLATION_ATTRIBUTES=(CONCEALED,TERMINAL) DEEP9 'PDEV'[D1.D2.D3.D4.D5.D6.D7.D8.D9.]
$ SHOW LOGICAL/FULL DEEP9
$ !
$ WRITE SYS$OUTPUT "######## GUIDE TABLE, DEFAULT [JONES] ON THE PLAIN DEVICE"
$ SET DEFAULT 'DEV'[JONES]
$ SHOW DEFAULT
$ RUN 'PROG'
