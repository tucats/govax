$ SHOW SYMBOL $STATUS
$ !
$ WRITE SYS$OUTPUT "######## SYS$DISK WITH A DIRECTORY"
$ SET DEFAULT 'DEV'[JONES]
$ DEFINE SYS$DISK 'PDEV'[LNM91]
$ SHOW DEFAULT
$ RUN 'PROG'
P- A.DAT
PN A.DAT
PS A.DAT
S- A.DAT
P- [SUB]A.DAT
PN [SUB]A.DAT
PS [SUB]A.DAT
S- [SUB]A.DAT
