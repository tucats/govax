PS []A.DAT
S- []A.DAT
P- [-]A.DAT
PN [-]A.DAT
PS [-]A.DAT
S- [-]A.DAT
$ SHOW SYMBOL $STATUS
$ DEFINE/TRANSLATION_ATTRIBUTES=CONCEALED SYS$DISK 'PDEV'[LNM91]
$ SHOW DEFAULT
$ RUN 'PROG'
P- A.DAT
PN A.DAT
PS A.DAT
S- A.DAT
P- [SUB]A.DAT
PN [SUB]A.DAT
PS [SUB]A.DAT
S- [SUB]A.DAT
$ SHOW SYMBOL $STATUS
$ SET DEFAULT 'DEV'[JONES]
$ !
$ WRITE SYS$OUTPUT "######## DCL ON THOSE NAMES"
$ DIRECTORY P:
$ WRITE SYS$OUTPUT "<", F$PARSE("P:"), "> <", F$PARSE("P:",,,,"NO_CONCEAL"), ">"
$ DIRECTORY P:A.DAT
$ WRITE SYS$OUTPUT "<", F$PARSE("P:A.DAT"), "> <", F$PARSE("P:A.DAT",,,,"NO_CONCEAL"), ">"
$ DIRECTORY P:[SUB]
$ WRITE SYS$OUTPUT "<", F$PARSE("P:[SUB]"), "> <", F$PARSE("P:[SUB]",,,,"NO_CONCEAL"), ">"
$ DIRECTORY C:
$ WRITE SYS$OUTPUT "<", F$PARSE("C:"), "> <", F$PARSE("C:",,,,"NO_CONCEAL"), ">"
$ DIRECTORY C:A.DAT
$ WRITE SYS$OUTPUT "<", F$PARSE("C:A.DAT"), "> <", F$PARSE("C:A.DAT",,,,"NO_CONCEAL"), ">"
$ DIRECTORY C:[SUB]
$ WRITE SYS$OUTPUT "<", F$PARSE("C:[SUB]"), "> <", F$PARSE("C:[SUB]",,,,"NO_CONCEAL"), ">"
$ DIRECTORY C2:
$ WRITE SYS$OUTPUT "<", F$PARSE("C2:"), "> <", F$PARSE("C2:",,,,"NO_CONCEAL"), ">"
$ DIRECTORY N:
$ WRITE SYS$OUTPUT "<", F$PARSE("N:"), "> <", F$PARSE("N:",,,,"NO_CONCEAL"), ">"
$ DIRECTORY L:
$ WRITE SYS$OUTPUT "<", F$PARSE("L:"), "> <", F$PARSE("L:",,,,"NO_CONCEAL"), ">"
$ SET DEFAULT P:
$ SHOW DEFAULT
$ SHOW LOGICAL SYS$DISK
$ SET DEFAULT 'DEV'[JONES]
$ SET DEFAULT P:[SUB]
$ SHOW DEFAULT
$ SHOW LOGICAL SYS$DISK
$ SET DEFAULT 'DEV'[JONES]
$ SET DEFAULT C:
$ SHOW DEFAULT
$ SHOW LOGICAL SYS$DISK
$ SET DEFAULT 'DEV'[JONES]
$ SET DEFAULT C:[SUB]
$ SHOW DEFAULT
