$ ! LNM91B.COM - Phase 91's probe, round 2. Written by testdata/lnm91/gen.go.
$ ! Run it on its exchange volume, with that volume's [000000] as the
$ ! default directory:
$ !
$ !     @LNM91B/OUTPUT=LNM91B.LOG
$ !
$ SET NOON
$ SET VERIFY
$ !
$ WRITE SYS$OUTPUT "######## ENVIRONMENT"
$ WRITE SYS$OUTPUT F$GETSYI("VERSION"), " ", F$GETSYI("HW_NAME"), " ", F$GETSYI("NODENAME")
$ DEV = F$PARSE("[000000]",,,"DEVICE")
$ PDEV = F$GETDVI(DEV,"DEVNAM")
$ SHOW SYMBOL DEV
$ SHOW SYMBOL PDEV
$ SET DEFAULT 'DEV'[000000]
$ !
$ WRITE SYS$OUTPUT "######## TREE"
$ CREATE/DIRECTORY 'DEV'[LNM91.SUB]
$ CREATE/DIRECTORY 'DEV'[LNM91.ROOT1]
$ CREATE/DIRECTORY 'DEV'[SUB]
$ CREATE/DIRECTORY 'DEV'[JONES]
$ CREATE/DIRECTORY 'DEV'[OTHER]
$ CREATE/DIRECTORY 'DEV'[R1.R2.R3.R4.R5.R6.R7]
$ CREATE T.DAT
template record
$ !
$ COPY T.DAT 'DEV'[LNM91]A.DAT
$ COPY T.DAT 'DEV'[LNM91.SUB]A.DAT
$ COPY T.DAT 'DEV'[LNM91.ROOT1]A.DAT
$ COPY T.DAT 'DEV'[SUB]A.DAT
$ COPY T.DAT 'DEV'[JONES]A.DAT
$ COPY T.DAT 'DEV'[OTHER]A.DAT
$ DEFINE/USER_MODE SYS$OUTPUT LNM91.MLG
$ MACRO/NOLIST LNM91
$ SHOW SYMBOL $STATUS
$ DEFINE/USER_MODE SYS$OUTPUT LNM91.LLG
$ LINK/NOMAP LNM91
$ SHOW SYMBOL $STATUS
$ IF F$SEARCH("LNM91.EXE") .EQS. "" THEN EXIT
$ PROG = DEV + "[000000]LNM91"
$ !
$ WRITE SYS$OUTPUT "######## DEFINITIONS"
$ DEFINE LDEV 'PDEV'
$ SHOW LOGICAL/FULL LDEV
$ DEFINE P 'PDEV'[LNM91]
$ SHOW LOGICAL/FULL P
$ DEFINE P2 P:
$ SHOW LOGICAL/FULL P2
$ DEFINE P3 LDEV:[LNM91]
$ SHOW LOGICAL/FULL P3
$ DEFINE N 'PDEV'[LNM91]A.DAT
$ SHOW LOGICAL/FULL N
$ DEFINE L 'PDEV'[LNM91],'PDEV'[LNM91.SUB]
$ SHOW LOGICAL/FULL L
$ DEFINE/TRANSLATION_ATTRIBUTES=CONCEALED C 'PDEV'[LNM91]
$ SHOW LOGICAL/FULL C
$ DEFINE/TRANSLATION_ATTRIBUTES=(CONCEALED,TERMINAL) C2 'PDEV'[LNM91]
$ SHOW LOGICAL/FULL C2
$ DEFINE/TRANSLATION_ATTRIBUTES=CONCEALED C3 LDEV:[LNM91]
$ SHOW LOGICAL/FULL C3
$ DEFINE/TRANSLATION_ATTRIBUTES=(CONCEALED,TERMINAL) D7 'PDEV'[R1.R2.R3.R4.R5.R6.R7.]
$ SHOW LOGICAL/FULL D7
$ !
$ WRITE SYS$OUTPUT "######## PLAIN NAMES WITH A DIRECTORY"
$ SET DEFAULT 'DEV'[JONES]
$ RUN 'PROG'
P- P:A.DAT
