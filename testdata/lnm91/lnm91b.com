PS A.DAT||P:X.DAT
S- A.DAT||P:X.DAT
$ SHOW SYMBOL $STATUS
$ !
$ WRITE SYS$OUTPUT "######## CONCEALED NAMES WITH A DIRECTORY"
$ SET DEFAULT 'DEV'[JONES]
$ RUN 'PROG'
P- C:A.DAT
