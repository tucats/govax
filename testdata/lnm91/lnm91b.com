$ SET DEFAULT 'DEV'[JONES]
$ TYPE P:A.DAT
$ TYPE C:A.DAT
$ TYPE N:
$ CREATE/DIRECTORY/LOG P:[NEW]
$ CREATE/DIRECTORY/LOG C:[NEW]
$ !
$ WRITE SYS$OUTPUT "######## FIFTEEN LEVELS"
$ SET DEFAULT 'DEV'[000000]
$ CREATE/DIRECTORY/LOG D7:[E1.E2.E3.E4.E5.E6.E7.E8]
$ COPY T.DAT D7:[E1.E2.E3.E4.E5.E6.E7.E8]Y.DAT
$ DIRECTORY D7:[E1.E2.E3.E4.E5.E6.E7.E8]
$ DIRECTORY LDEV:[R1.R2.R3.R4.R5.R6.R7.E1]
$ DIRECTORY LDEV:[R1.R2.R3.R4.R5.R6.R7.E1.E2]
$ TYPE D7:[E1.E2.E3.E4.E5.E6.E7.E8]Y.DAT
$ RUN 'PROG'
C- D7:[E1.E2.E3.E4.E5.E6.E7.E8]X.DAT
O- D7:[E1.E2.E3.E4.E5.E6.E7.E8]X.DAT
ON D7:[E1.E2.E3.E4.E5.E6.E7.E8]X.DAT
F- D7:[E1.E2.E3.E4.E5.E6.E7.E8]X.DAT
S- D7:[E1.E2.E3.E4.E5.E6.E7.E8]*.DAT
S- D7:[E1...]*.DAT
S- D7:[*...]*.DAT
SN D7:[E1...]*.DAT
S- LDEV:[R1...]*.DAT
S- LDEV:[R1.R2.R3.R4.R5.R6.R7...]*.DAT
P- LDEV:[R1.R2.R3.R4.R5.R6.R7.E1]X.DAT
P- LDEV:[R1.R2.R3.R4.R5.R6.R7.E1.E2]X.DAT
