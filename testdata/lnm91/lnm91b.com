$ SET DEFAULT 'DEV'[JONES]
$ SET DEFAULT C2:
$ SHOW DEFAULT
$ SHOW LOGICAL SYS$DISK
$ SET DEFAULT 'DEV'[JONES]
$ SET DEFAULT N:
$ SHOW DEFAULT
