	.TITLE	LNM91 - RMS name processing with concealed and rooted names
	.IDENT	/1/
;
; Phase 91's probe (docs/PHASE-91 - concealed logical names.md). This
; program does what the data lines after its RUN command ask, one line
; per case, and reports what RMS did. A line is
;
;	OF NAME|DEFAULT|RELATED
;
; where O is the operation, F a flag, and DEFAULT and RELATED may be left
; out. RELATED is a related file's resultant string. The operations:
;
;	P  $PARSE
;	S  $PARSE, then $SEARCH until it stops
;	O  $OPEN and $CLOSE
;	C  $CREATE and $CLOSE
;	E  $ERASE
;	R  $RENAME, NAME to DEFAULT (the second field)
;	D  $ASSIGN and $GETDVIW of NAME
;	F  $OPEN, then LIB$FID_TO_NAME of the file found
;	J  $GETJPIW's JPI$_IMAGNAME (this image's own name)
;
; and the flags: - none, N NAM$V_NOCONCEAL, S NAM$V_SYNCHK.
;
	$FABDEF
	$NAMDEF
	$RMSDEF
	$DVIDEF
	$JPIDEF
	$SSDEF

; SAY text, a1, ... a10: format text with $FAOL and the arguments (each
; a longword, pushed by value) and write the line. The text is in line,
; branched around.
	.MACRO	SAY	TEXT,A1,A2,A3,A4,A5,A6,A7,A8,A9,A10,?LBL,?OVER
	BRW	OVER
LBL:	.ASCID	TEXT
OVER:
	$$N = 1
	.IRP	ARG,<A10,A9,A8,A7,A6,A5,A4,A3,A2,A1>
	.IF	NOT_BLANK,<ARG>
	PUSHL	ARG
	$$N = $$N + 1
	.ENDC
	.ENDR
	PUSHAQ	LBL
	CALLS	#$$N,SAYR
	.ENDM	SAY

; RMS service, fab: call an RMS service with no completion routines.
	.MACRO	RMS	SERVICE,FAB
	CLRQ	-(SP)
	PUSHAB	FAB
	CALLS	#3,G^SYS$'SERVICE
	.ENDM	RMS

; DONE label: report the status of the operation just done on FAB1, and
; NAM1's strings and fields.
	.MACRO	DONE	LABEL
	PUSHAB	NAM1
	PUSHAB	FAB1
	PUSHAQ	LABEL
	CALLS	#3,REPORT
	.ENDM	DONE

	.PSECT	DATA,WRT,NOEXE,LONG

MAXLINE	= 512
SEARCHMAX = 60

LINE:	.BLKB	MAXLINE
LINED:	.WORD	MAXLINE
	.BYTE	14,1
	.ADDRESS LINE
LINLEN:	.WORD	0

; The line's three fields, as descriptors.
PRI:	.LONG	0,0
DEF:	.LONG	0,0
REL:	.LONG	0,0
OPC:	.BYTE	0
FLAG:	.BYTE	0

OUTD:	.LONG	600
	.ADDRESS OUTBUF
OUTBUF:	.BLKB	600
OUTLEN:	.WORD	0

	.ALIGN	LONG
FABT:	$FAB	RFM=VAR,RAT=CR
	.ALIGN	LONG
NAMT:	$NAM

	.ALIGN	LONG
FAB1:	.BLKB	FAB$C_BLN
FAB2:	.BLKB	FAB$C_BLN
NAM1:	.BLKB	NAM$C_BLN
NAM2:	.BLKB	NAM$C_BLN
NAMR:	.BLKB	NAM$C_BLN
ESA1:	.BLKB	256
RSA1:	.BLKB	256
ESA2:	.BLKB	256
RSA2:	.BLKB	256

CHAN:	.WORD	0
IOSB:	.QUAD	0

DEVNAM:	.BLKB	64
DEVLEN:	.LONG	0
FULLNAM: .BLKB	64
FULLLEN: .LONG	0
CONCEAL: .LONG	0
DVILST:	.WORD	64,DVI$_DEVNAM
	.ADDRESS DEVNAM,DEVLEN
	.WORD	64,DVI$_FULLDEVNAM
	.ADDRESS FULLNAM,FULLLEN
	.WORD	4,DVI$_CONCEALED
	.ADDRESS CONCEAL,0
	.LONG	0

IMAGE:	.BLKB	256
IMGLEN:	.LONG	0
JPILST:	.WORD	255,JPI$_IMAGNAME
	.ADDRESS IMAGE,IMGLEN
	.LONG	0

DVID:	.WORD	0
	.BYTE	14,1
	.LONG	0
FN:	.BLKB	256
FND:	.WORD	256
	.BYTE	14,1
	.ADDRESS FN
FNLEN:	.WORD	0

L_PARSE: .ASCID	/$PARSE/
L_SEARCH: .ASCID /$SEARCH/
L_OPEN:	.ASCID	/$OPEN/
L_CREATE: .ASCID /$CREATE/
L_ERASE: .ASCID	/$ERASE/
L_RENAME: .ASCID /$RENAME/

	.PSECT	CODE,NOWRT,EXE

	.ENTRY	START,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
LOOP:	PUSHAW	LINLEN
	CLRL	-(SP)
	PUSHAQ	LINED
	CALLS	#3,G^LIB$GET_INPUT
	BLBS	R0,10$
	CMPL	R0,#RMS$_EOF
	BEQL	5$
	MOVL	R0,R2
	SAY	</get input failed !XL/>,R2
5$:	MOVL	#SS$_NORMAL,R0
	RET

10$:	MOVZWL	LINLEN,R6
	SAY	</== !AD/>,R6,#LINE
	CMPL	R6,#2
	BGEQ	15$
	BRW	LOOP
15$:	MOVB	LINE,OPC
	MOVB	LINE+1,FLAG

; Split the rest of the line, from its fourth character, at "|".
	MOVAB	LINE+3,R10
	SUBL3	#3,R6,R11
	BGEQ	20$
	CLRL	R11
20$:	MOVAQ	PRI,R9
	JSB	SPLIT
	MOVAQ	DEF,R9
	JSB	SPLIT
	MOVAQ	REL,R9
	JSB	SPLIT

; Make the blocks new, and apply the flag and the related name.
	PUSHAQ	DEF
	PUSHAQ	PRI
	PUSHAB	RSA1
	PUSHAB	ESA1
	PUSHAB	NAM1
	PUSHAB	FAB1
	CALLS	#6,SETUP
	CMPB	FLAG,#^A/N/
	BNEQ	30$
	BISB2	#NAM$M_NOCONCEAL,NAM1+NAM$B_NOP
30$:	CMPB	FLAG,#^A/S/
	BNEQ	40$
	BISB2	#NAM$M_SYNCHK,NAM1+NAM$B_NOP
40$:	TSTL	REL
	BEQL	50$
	MOVC3	#NAM$C_BLN,NAMT,NAMR
	MOVB	REL,NAMR+NAM$B_RSL
	MOVL	REL+4,NAMR+NAM$L_RSA
	MOVAB	NAMR,NAM1+NAM$L_RLF

; Do the operation.
50$:	MOVZBL	OPC,R0
	CMPL	R0,#^A/P/
	BNEQ	51$
	CALLS	#0,OPP
	BRW	LOOP
51$:	CMPL	R0,#^A/S/
	BNEQ	52$
	CALLS	#0,OPS
	BRW	LOOP
52$:	CMPL	R0,#^A/O/
	BNEQ	53$
	CALLS	#0,OPO
	BRW	LOOP
53$:	CMPL	R0,#^A/C/
	BNEQ	54$
	CALLS	#0,OPC_C
	BRW	LOOP
54$:	CMPL	R0,#^A/E/
	BNEQ	55$
	CALLS	#0,OPE
	BRW	LOOP
55$:	CMPL	R0,#^A/R/
	BNEQ	56$
	CALLS	#0,OPR
	BRW	LOOP
56$:	CMPL	R0,#^A/D/
	BNEQ	57$
	CALLS	#0,OPD
	BRW	LOOP
57$:	CMPL	R0,#^A/F/
	BNEQ	58$
	CALLS	#0,OPF
	BRW	LOOP
58$:	CMPL	R0,#^A/J/
	BNEQ	59$
	CALLS	#0,OPJ
	BRW	LOOP
59$:	SAY	</unknown operation/>
	BRW	LOOP

; SPLIT: with R10 the text and R11 its length, make the descriptor at R9
; the text up to the next "|" and step past it. Changes R0 to R5, R10,
; and R11.
SPLIT:	CLRQ	(R9)
	TSTL	R11
	BLEQ	9$
	LOCC	#^A/|/,R11,(R10)
	SUBL3	R0,R11,R2
	MOVL	R2,(R9)
	MOVL	R10,4(R9)
	TSTL	R0
	BEQL	8$
	ADDL3	#1,R1,R10
	SUBL3	#1,R0,R11
	RSB
8$:	CLRL	R11
9$:	RSB

; SETUP fab, nam, esa, rsa, name, default: make a FAB and its NAM new.
	.ENTRY	SETUP,^M<R2,R3,R4,R5,R6,R7>
	MOVL	4(AP),R6
	MOVL	8(AP),R7
	MOVC3	#FAB$C_BLN,FABT,(R6)
	MOVC3	#NAM$C_BLN,NAMT,(R7)
	MOVL	20(AP),R0
	MOVB	(R0),FAB$B_FNS(R6)
	MOVL	4(R0),FAB$L_FNA(R6)
	MOVL	24(AP),R0
	MOVB	(R0),FAB$B_DNS(R6)
	MOVL	4(R0),FAB$L_DNA(R6)
	MOVL	R7,FAB$L_NAM(R6)
	MOVL	12(AP),NAM$L_ESA(R7)
	MOVB	#255,NAM$B_ESS(R7)
	MOVL	16(AP),NAM$L_RSA(R7)
	MOVB	#255,NAM$B_RSS(R7)
	RET

; REPORT label, fab, nam: the status of an operation, and the NAM.
	.ENTRY	REPORT,^M<R2,R3,R4,R5,R6,R7>
	MOVL	8(AP),R6
	MOVL	FAB$L_STS(R6),R2
	MOVL	FAB$L_STV(R6),R3
	SAY	</  !AS sts=!XL stv=!XL/>,4(AP),R2,R3
	MOVL	12(AP),R6
	MOVZBL	NAM$B_ESL(R6),R2
	SAY	</  esa=!UL "!AD"/>,R2,R2,NAM$L_ESA(R6)
	MOVZBL	NAM$B_RSL(R6),R2
	SAY	</  rsa=!UL "!AD"/>,R2,R2,NAM$L_RSA(R6)
	MOVL	NAM$L_FNB(R6),R2
	EXTZV	#NAM$V_CNCL_DEV,#1,R2,R3
	EXTZV	#NAM$V_ROOT_DIR,#1,R2,R4
	EXTZV	#NAM$V_DIR_LVLS,#3,R2,R5
	SAY	</  fnb=!XL cncl=!UL root=!UL lvls=!UL/>,R2,R3,R4,R5
	MOVZBL	NAM$B_NODE(R6),R2
	MOVZBL	NAM$B_DEV(R6),R3
	MOVZBL	NAM$B_DIR(R6),R4
	MOVZBL	NAM$B_NAME(R6),R5
	MOVZBL	NAM$B_TYPE(R6),R7
	MOVZBL	NAM$B_VER(R6),R0
	SAY	</  len node=!UL dev=!UL dir=!UL name=!UL type=!UL ver=!UL/>,R2,R3,R4,R5,R7,R0
	MOVAB	NAM$T_DVI(R6),R2
	MOVZWL	NAM$W_DID(R6),R3
	MOVZWL	NAM$W_DID+2(R6),R4
	MOVZWL	NAM$W_DID+4(R6),R5
	SAY	</  dvi="!AC" did=(!UL,!UL,!UL)/>,R2,R3,R4,R5
	MOVZWL	NAM$W_FID(R6),R3
	MOVZWL	NAM$W_FID+2(R6),R4
	MOVZWL	NAM$W_FID+4(R6),R5
	SAY	</  fid=(!UL,!UL,!UL)/>,R3,R4,R5
	RET

	.ENTRY	OPP,^M<R2>
	RMS	PARSE,FAB1
	DONE	L_PARSE
	RET

	.ENTRY	OPS,^M<R2,R3,R7>
	RMS	PARSE,FAB1
	DONE	L_PARSE
	BLBC	FAB1+FAB$L_STS,90$
	MOVL	#SEARCHMAX,R7
10$:	RMS	SEARCH,FAB1
	DONE	L_SEARCH
	BLBC	FAB1+FAB$L_STS,90$
	SOBGTR	R7,10$
	SAY	</  search limit reached/>
90$:	RET

	.ENTRY	OPO,^M<R2,R3>
	RMS	OPEN,FAB1
	DONE	L_OPEN
	BLBC	FAB1+FAB$L_STS,90$
	RMS	CLOSE,FAB1
90$:	RET

	.ENTRY	OPC_C,^M<R2,R3>
	MOVB	#FAB$M_PUT,FAB1+FAB$B_FAC
	RMS	CREATE,FAB1
	DONE	L_CREATE
	BLBC	FAB1+FAB$L_STS,90$
	RMS	CLOSE,FAB1
90$:	RET

	.ENTRY	OPE,^M<R2,R3>
	RMS	ERASE,FAB1
	DONE	L_ERASE
	RET

	.ENTRY	OPR,^M<R2,R3>
	PUSHAQ	REL
	PUSHAQ	DEF
	PUSHAB	RSA2
	PUSHAB	ESA2
	PUSHAB	NAM2
	PUSHAB	FAB2
	CALLS	#6,SETUP
	PUSHAB	FAB2
	CLRQ	-(SP)
	PUSHAB	FAB1
	CALLS	#4,G^SYS$RENAME
	DONE	L_RENAME
	SAY	</  new name:/>
	PUSHAB	NAM2
	PUSHAB	FAB2
	PUSHAQ	L_RENAME
	CALLS	#3,REPORT
	RET

	.ENTRY	OPD,^M<R2,R3,R4,R5,R6,R7>
	$ASSIGN_S DEVNAM=PRI,CHAN=CHAN
	MOVL	R0,R7
	SAY	</  $ASSIGN !XL/>,R7
	BLBC	R7,10$
	$DASSGN_S CHAN=CHAN
10$:	CLRL	DEVLEN
	CLRL	FULLLEN
	MNEGL	#1,CONCEAL
	$GETDVIW_S DEVNAM=PRI,ITMLST=DVILST,IOSB=IOSB
	MOVL	R0,R7
	MOVZWL	IOSB,R6
	MOVL	DEVLEN,R2
	MOVL	FULLLEN,R3
	MOVL	CONCEAL,R4
	SAY	</  $GETDVIW !XL iosb=!XW concealed=!XL/>,R7,R6,R4
	SAY	</  devnam="!AD" fulldevnam="!AD"/>,R2,#DEVNAM,R3,#FULLNAM
	RET

	.ENTRY	OPF,^M<R2,R3,R4,R5,R6,R7>
	RMS	OPEN,FAB1
	DONE	L_OPEN
	BLBS	FAB1+FAB$L_STS,10$
	RET
10$:	MOVZBW	NAM1+NAM$T_DVI,DVID
	MOVAB	NAM1+NAM$T_DVI+1,DVID+4
	CLRW	FNLEN
	PUSHAW	FNLEN
	PUSHAQ	FND
	PUSHAB	NAM1+NAM$W_FID
	PUSHAQ	DVID
	CALLS	#4,G^LIB$FID_TO_NAME
	MOVL	R0,R7
	MOVZWL	FNLEN,R2
	SAY	</  LIB$FID_TO_NAME !XL "!AD"/>,R7,R2,#FN
	RMS	CLOSE,FAB1
	RET

	.ENTRY	OPJ,^M<R2,R3,R4,R5,R6,R7>
	CLRL	IMGLEN
	$GETJPIW_S ITMLST=JPILST,IOSB=IOSB
	MOVL	R0,R7
	MOVZWL	IOSB,R6
	MOVL	IMGLEN,R2
	SAY	</  $GETJPIW !XL iosb=!XW "!AD"/>,R7,R6,R2,#IMAGE
	RET

; SAYR text, a1, ...: format and write one line.
	.ENTRY	SAYR,^M<R2,R3,R4,R5>
	MOVL	#600,OUTD
	$FAOL_S	CTRSTR=@4(AP),OUTLEN=OUTLEN,OUTBUF=OUTD,PRMLST=8(AP)
	MOVW	OUTLEN,OUTD
	PUSHAQ	OUTD
	CALLS	#1,G^LIB$PUT_OUTPUT
	MOVL	#600,OUTD
	RET

	.END	START
