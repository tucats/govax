                                     0000     4 ; The main module of a two-module program (DBGSUB is the other) whose
                                     0000     5 ; instructions refer, in every addressing mode, to the things a debug
                                     0000     6 ; symbol table names: labels of code and of data, routines (CALLS,
                                     0000     7 ; CALLG, JSB, BSBW), constants, a global constant, a psect base with no
                                     0000     8 ; label, addresses past a label, the other module's data and routines,
                                     0000     9 ; and a LIBRTL routine. DBG.COM assembles and links it /DEBUG, and the
                                     0000    10 ; debugger shows its instructions (EXAMINE/INSTRUCTION) for govax's
                                     0000    11 ; disassembler to be checked against (docs/PHASE-41.md, subtask 1).
                                     0000    12 ;
                                     0000    13 ; It runs to the end without faulting: DBGDIS.DBG steps through part of
                                     0000    14 ; it and then lets it finish.
                                     0000    15 
                                     0000    16 	.EXTERNAL LIB$PUT_OUTPUT, SUB1, SUBDATA
                                     0000    17 
