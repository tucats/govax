! DBGDIS.DBG - debugger commands for DBGDIS (docs/PHASE-41.md, subtask 1).
! DBG.COM runs them for VMS's DBGDIS.EXE and for govax's GVDBGDIS.EXE,
! after SET LOG and SET OUTPUT LOG,VERIFY. Line numbers are DBGDIS.MAR's
! and DBGSUB.MAR's: change them here if those sources change.
!
! What the debugger knows on start-up.
SHOW IMAGE
SHOW MODULE
SHOW LANGUAGE
SHOW RADIX
SHOW MODE
SHOW SCOPE
EXAMINE/INSTRUCTION .PC
!
! Every module's symbols, then their addresses.
SET MODULE/ALL
SHOW MODULE
SHOW SYMBOL/ADDRESS * IN DBGDIS
SHOW SYMBOL/ADDRESS * IN DBGSUB
SHOW SYMBOL/TYPE * IN DBGDIS
!
! Instructions, symbolic (the default): each routine whole, by name.
EXAMINE/INSTRUCTION START:LAST
EXAMINE/INSTRUCTION LOCALR:LOCEND
EXAMINE/INSTRUCTION JSBRTN:JSBEND
EXAMINE/INSTRUCTION SUB1:DBGSUB\SUBEND
!
! By line, and one at a time.
EXAMINE/INSTRUCTION %LINE 47:%LINE 56
EXAMINE/INSTRUCTION %LINE 85
EXAMINE/INSTRUCTION DBGSUB\%LINE 14
EXAMINE/INSTRUCTION START
EXAMINE/INSTRUCTION START+2
EXAMINE START
EXAMINE SUB2
EXAMINE/INSTRUCTION SUB2
!
! Data and constants by name.
EXAMINE COUNT
EXAMINE TABLE
EXAMINE TABLE+8
EXAMINE MSG
EXAMINE TEXT
EXAMINE NOLAB2-4
EXAMINE SUBDATA
EVALUATE LIMIT
EVALUATE BIG
EVALUATE GLIMIT
!
! Addresses to names, and names to addresses.
EVALUATE/ADDRESS START
EVALUATE/ADDRESS COUNT
EVALUATE/ADDRESS TABLE+8
EVALUATE/ADDRESS NOLAB2-4
EVALUATE/ADDRESS %LINE 47
EVALUATE/ADDRESS DBGSUB\%LINE 14
SYMBOLIZE START
SYMBOLIZE START+2
SYMBOLIZE TABLE+8
SYMBOLIZE TEXT+10
SYMBOLIZE NOLAB2-4
SYMBOLIZE SUBDATA
SYMBOLIZE JSBRTN+3
SYMBOLIZE %LINE 85
!
! Not symbolic.
SET MODE NOSYMBOLIC
EXAMINE/INSTRUCTION START:LAST
EXAMINE/INSTRUCTION SUB1:DBGSUB\SUBEND
EXAMINE COUNT
SET MODE SYMBOLIC
!
! Decimal, then the default radix again.
SET RADIX DECIMAL
EXAMINE/INSTRUCTION %LINE 47:%LINE 56
EVALUATE/ADDRESS TABLE+8
SYMBOLIZE TEXT+10
CANCEL RADIX
!
! Stepping by instruction, then by line.
SET STEP INSTRUCTION
STEP
STEP
STEP
STEP
STEP
EXAMINE/OPERANDS .PC
EXAMINE/OPERANDS=FULL .PC
SET STEP LINE
STEP
STEP
SHOW CALLS
!
! Breaks in a JSB subroutine (reached by JSB, then BSBW), then three
! and four calls deep (SUB2, and SUBJSB under it).
SET BREAK SUB2
SET BREAK DBGSUB\SUBJSB
SET BREAK JSBRTN
GO
SHOW CALLS
EXAMINE/INSTRUCTION .PC
GO
SHOW CALLS
GO
SHOW CALLS
EXAMINE/INSTRUCTION .PC
GO
SHOW CALLS
EXAMINE/INSTRUCTION .PC
STEP/INSTRUCTION
EXAMINE/INSTRUCTION .PC
CANCEL BREAK/ALL
!
! The end of START, then the end of the program.
SET BREAK LAST
GO
SHOW CALLS
EXAMINE/INSTRUCTION .PC
CANCEL BREAK/ALL
GO
