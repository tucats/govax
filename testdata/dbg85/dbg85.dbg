! DBG85.DBG - the debugger on the compiler's own MACRO (README.md). VMS's log
! leaves out a command that fails, so a comment names each case first.
SHOW LANGUAGE
SHOW RADIX
SHOW SCOPE
SHOW MODULE
!> SHOW MODULE DBG85
SHOW MODULE DBG85
SET MODULE/ALL
SHOW MODULE
!> SHOW SYMBOL *
SHOW SYMBOL *
!> SHOW SYMBOL/ADDRESS *
SHOW SYMBOL/ADDRESS *
!> SHOW SYMBOL/TYPE *
SHOW SYMBOL/TYPE *
!> SHOW SYMBOL $LOCAL
SHOW SYMBOL $LOCAL
!> EXAMINE $LOCAL
EXAMINE $LOCAL
!> EXAMINE DBG85\$LOCAL
EXAMINE DBG85\$LOCAL
!> SET BREAK SUB85
SET BREAK SUB85
!> SET BREAK SUB85.L10
SET BREAK SUB85.L10
!> SHOW BREAK
SHOW BREAK
!> GO to SUB85
GO
SHOW CALLS
SHOW SCOPE
!> EXAMINE .PC, D6
EXAMINE .PC
!> EXAMINE/INSTRUCTION .PC
EXAMINE/INSTRUCTION .PC
!> EXAMINE/SOURCE .PC
EXAMINE/SOURCE .PC
!> TYPE 1:5
TYPE 1:5
!> Each kind of variable as the compiler declares it
!> EXAMINE DBG85.X
EXAMINE DBG85.X
!> EXAMINE DBG85.V
EXAMINE DBG85.V
!> EXAMINE DBG85.V[1]
EXAMINE DBG85.V[1]
!> EXAMINE DBG85.V+4
EXAMINE DBG85.V+4
!> EXAMINE/FLOAT DBG85.V
EXAMINE/FLOAT DBG85.V
!> EXAMINE/FLOAT DBG85.V[1]
EXAMINE/FLOAT DBG85.V[1]
!> EXAMINE/FLOAT DBG85.V:DBG85.V+8
EXAMINE/FLOAT DBG85.V:DBG85.V+8
!> EXAMINE DBG85.DD
EXAMINE DBG85.DD
!> EXAMINE/D_FLOAT DBG85.DD
EXAMINE/D_FLOAT DBG85.DD
!> EXAMINE DBG85.H
EXAMINE DBG85.H
!> EXAMINE DBG85.I
EXAMINE DBG85.I
!> EXAMINE DBG85.L
EXAMINE DBG85.L
!> EXAMINE DBG85.NAME
EXAMINE DBG85.NAME
!> EXAMINE/ASCII:8 DBG85.NAME
EXAMINE/ASCII:8 DBG85.NAME
!> EXAMINE DBG85.M
EXAMINE DBG85.M
!> EXAMINE DBG85.M[1,2]
EXAMINE DBG85.M[1,2]
!> EXAMINE DBG85.IC, in a common block
EXAMINE DBG85.IC
!> EXAMINE DBG85.RC
EXAMINE DBG85.RC
!> EXAMINE/FLOAT DBG85.RC
EXAMINE/FLOAT DBG85.RC
!> EXAMINE BLK
EXAMINE BLK
!> EXAMINE BLK.$BASE
EXAMINE BLK.$BASE
!> EXAMINE DBG85.$K1
EXAMINE DBG85.$K1
!> EVALUATE/ADDRESS DBG85.X
EVALUATE/ADDRESS DBG85.X
!> Dummy arguments, D2: EXAMINE SUB85.A
EXAMINE SUB85.A
!> EVALUATE SUB85.N
EVALUATE SUB85.N
!> EVALUATE/ADDRESS SUB85.N
EVALUATE/ADDRESS SUB85.N
!> SHOW SYMBOL/TYPE SUB85.N
SHOW SYMBOL/TYPE SUB85.N
!> EXAMINE @(AP+SUB85.N)
EXAMINE @(AP+SUB85.N)
!> EXAMINE .(.AP+SUB85.N)
EXAMINE .(.AP+SUB85.N)
!> EXAMINE @SUB85.N(AP)
EXAMINE @SUB85.N(AP)
!> EXAMINE SUB85.I
EXAMINE SUB85.I
!> EXAMINE SUB85\SUB85.I
EXAMINE SUB85\SUB85.I
!> EXAMINE DBG85\SUB85\SUB85.I
EXAMINE DBG85\SUB85\SUB85.I
!> EXAMINE DBG85\SUB85.I
EXAMINE DBG85\SUB85.I
!> EXAMINE SUB85\SUB85.L10
EXAMINE SUB85\SUB85.L10
!> EXAMINE/INSTRUCTION DBG85\SUB85\SUB85.L10
EXAMINE/INSTRUCTION DBG85\SUB85\SUB85.L10
!> Bare FORTRAN names: EXAMINE I
EXAMINE I
!> EXAMINE V
EXAMINE V
!> Stepping
STEP
STEP
STEP/INSTRUCTION
!> GO to the label
GO
SHOW CALLS
EXAMINE/INSTRUCTION .PC
!> EXAMINE .PC
EXAMINE .PC
!> Language FORTRAN
SET LANGUAGE FORTRAN
SHOW LANGUAGE
SHOW RADIX
!> EXAMINE DBG85.X
EXAMINE DBG85.X
!> EXAMINE DBG85.V(1)
EXAMINE DBG85.V(1)
!> EXAMINE DBG85.M(1,2)
EXAMINE DBG85.M(1,2)
!> EXAMINE DBG85.NAME
EXAMINE DBG85.NAME
!> SET LANGUAGE MACRO
SET LANGUAGE MACRO
CANCEL BREAK/ALL
!> GO to TXT85
SET BREAK TXT85
GO
!> EXAMINE TXT85.S
EXAMINE TXT85.S
!> EXAMINE .PC
EXAMINE .PC
SHOW CALLS
!> GO to the end
GO
