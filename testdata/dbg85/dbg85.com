$ ! DBG85.COM - Phase 85's probe of the debugger on names with periods and on
$ ! the FORTRAN compiler's MACRO (docs/PHASE-85 - FORTRAN compiler usability.md,
$ ! subtask 2; README.md). EXCHANGE.CMD put govax's compiled DBG85.MAR, DBG85O.MAR,
$ ! and images GVDBG85.EXE and GVDBG85M.EXE on this volume.
$ !
$ ! Run it with the exchange volume as the default directory:
$ !
$ !     @DBG85/OUTPUT=DBG85.LOG
$ !
$ SET NOON
$ SET VERIFY
$ !
$ ! 1. Builds. DBG85N and DBG85O only assemble: does VMS's MACRO take a name
$ !    starting with a period, and the compiler's /OPTIMIZE output?
$ !
$ MACRO/DEBUG/LIST DBG85
$ LINK/DEBUG/MAP DBG85
$ MACRO/DEBUG/LIST DBG85M
$ LINK/DEBUG/MAP DBG85M
$ MACRO/DEBUG/LIST DBG85N
$ LINK/DEBUG/MAP DBG85N
$ MACRO/LIST DBG85O
$ MACRO/LIST DBG85S
$ LINK/SHAREABLE/MAP DBG85S,DBG85S.OPT/OPTIONS
$ DEFINE DBG85S 'F$ENVIRONMENT("DEFAULT")'DBG85S.EXE
$ MACRO/DEBUG/LIST DBG85C
$ LINK/DEBUG/MAP DBG85C,DBG85C.OPT/OPTIONS
$ !
$ ! 2. Debugger sessions.
$ !
$ CALL DEBUG DBG85M DBG85M
$ CALL DEBUG GVDBG85M DBG85M
$ CALL DEBUG DBG85 DBG85
$ CALL DEBUG GVDBG85 DBG85
$ CALL DEBUG DBG85C DBG85C
$ IF F$SEARCH("DBG85N.EXE") .NES. "" THEN CALL DEBUG DBG85N DBG85N
$ DEASSIGN DBG85S
$ DIRECTORY/SIZE=ALL/DATE *.*
$ EXIT
$ !
$ DEBUG: SUBROUTINE
$   OPEN/WRITE DBGF RUN.DBG
$   WRITE DBGF "SET LOG ''P1'.DLG"
$   WRITE DBGF "SET OUTPUT LOG,VERIFY"
$   WRITE DBGF "@''P2'.DBG"
$   WRITE DBGF "EXIT"
$   CLOSE DBGF
$   DEFINE/USER_MODE DBG$INPUT RUN.DBG
$   DEFINE/USER_MODE DBG$DECW$DISPLAY " "
$   RUN/DEBUG 'P1'
$   SHOW SYMBOL $STATUS
$ ENDSUBROUTINE
