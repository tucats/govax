! DBG85M.DBG - the debugger's rule for names with periods (README.md). VMS's log
! leaves out a command that fails, so a comment names each case first.
SHOW LANGUAGE
SHOW RADIX
SHOW MODULE
SET MODULE/ALL
!> SHOW SYMBOL *
SHOW SYMBOL *
!> SHOW SYMBOL/ADDRESS *
SHOW SYMBOL/ADDRESS *
!> SHOW SYMBOL/TYPE *
SHOW SYMBOL/TYPE *
!> SHOW SYMBOL A.B
SHOW SYMBOL A.B
!> SHOW SYMBOL A*
SHOW SYMBOL A*
!> EXAMINE A
EXAMINE A
!> EXAMINE A.B, which exists
EXAMINE A.B
!> EXAMINE a.b
EXAMINE a.b
!> EXAMINE C.D, whose parts exist and which doesn't
EXAMINE C.D
!> EXAMINE E.
EXAMINE E.
!> EXAMINE F..G
EXAMINE F..G
!> EXAMINE H.1
EXAMINE H.1
!> EXAMINE $.K
EXAMINE $.K
!> EXAMINE _.L
EXAMINE _.L
!> EXAMINE GLOB.AL
EXAMINE GLOB.AL
!> EXAMINE AB.CDEFGHIJKLMNOPQRSTUVWXYZ01234
EXAMINE AB.CDEFGHIJKLMNOPQRSTUVWXYZ01234
!> EXAMINE EQU.X, a constant
EXAMINE EQU.X
!> EVALUATE EQU.X
EVALUATE EQU.X
!> EXAMINE FLT.X
EXAMINE FLT.X
!> EXAMINE/FLOAT FLT.X
EXAMINE/FLOAT FLT.X
!> Expressions: EXAMINE A .B
EXAMINE A .B
!> EXAMINE A+.B
EXAMINE A+.B
!> EXAMINE .A
EXAMINE .A
!> EXAMINE ..A
EXAMINE ..A
!> EXAMINE .A.B
EXAMINE .A.B
!> EXAMINE A.B+4
EXAMINE A.B+4
!> EXAMINE A.B:C
EXAMINE A.B:C
!> EXAMINE A.B,C
EXAMINE A.B,C
!> EXAMINE TABLE.X[2]
EXAMINE TABLE.X[2]
!> EXAMINE TABLE.X:TABLE.X+12
EXAMINE TABLE.X:TABLE.X+12
!> EVALUATE A.B
EVALUATE A.B
!> EVALUATE/ADDRESS A.B
EVALUATE/ADDRESS A.B
!> EVALUATE .A.B
EVALUATE .A.B
!> EVALUATE A.B+1
EVALUATE A.B+1
!> EVALUATE C.D
EVALUATE C.D
!> Paths: EXAMINE DBG85M\A.B
EXAMINE DBG85M\A.B
!> EXAMINE DBG85M\A
EXAMINE DBG85M\A
!> EXAMINE DBG85M.A
EXAMINE DBG85M.A
!> EXAMINE DBG85M\R.TN\LOC.AL
EXAMINE DBG85M\R.TN\LOC.AL
!> EXAMINE R.TN\LOC.AL
EXAMINE R.TN\LOC.AL
!> EXAMINE/INSTRUCTION LOC.AL
EXAMINE/INSTRUCTION LOC.AL
!> DEPOSIT A.B=99
DEPOSIT A.B=99
!> EXAMINE A.B
EXAMINE A.B
!> DEPOSIT A.B=3
DEPOSIT A.B=3
!> SET BREAK R.TN
SET BREAK R.TN
!> SET BREAK LOC.AL
SET BREAK LOC.AL
!> SET WATCH A.B
SET WATCH A.B
!> SHOW BREAK
SHOW BREAK
!> SHOW WATCH
SHOW WATCH
!> GO to R.TN
GO
SHOW CALLS
EXAMINE/INSTRUCTION .PC
EXAMINE .PC
!> GO to LOC.AL
GO
EXAMINE/INSTRUCTION .PC
!> GO to the watch
GO
!> CANCEL WATCH A.B
CANCEL WATCH A.B
!> Language FORTRAN
SET LANGUAGE FORTRAN
SHOW LANGUAGE
!> EXAMINE A.B
EXAMINE A.B
!> EXAMINE C.D
EXAMINE C.D
!> EXAMINE .A
EXAMINE .A
!> EXAMINE GLOB.AL
EXAMINE GLOB.AL
!> EXAMINE TABLE.X(2)
EXAMINE TABLE.X(2)
!> EVALUATE A.B
EVALUATE A.B
!> Language MACRO again
SET LANGUAGE MACRO
!> GO to the end
GO
