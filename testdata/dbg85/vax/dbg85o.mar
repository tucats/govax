	PUSHAL	DBG85.$K2
	PUSHAL	DBG85.V
	CALLS	#3,G^SUB85
;   25        CALL TXT85(NAME)
	PUSHAQ	DBG85.$D1
	CALLS	#1,G^TXT85
;   26        END
	MOVL	#1,R0			; SS$_NORMAL
	RET

; Storage map for SUB85, a subroutine
;   A      REAL (?)  argument 1  @SUB85.A(AP)
;   N      INTEGER   argument 2  @SUB85.N(AP)
;   TOTAL  REAL      argument 3  @SUB85.TOTAL(AP)
;   I      INTEGER   $LOCAL+0    SUB85.I
;   R8 is $L1: DO 10's limit
;   R9 is $R1: an address in $B1
;   R6 is $R2: I, during a loop
;   R7 is $R3: TOTAL, during a loop
;
SUB85.A = 4				; A is argument 1
SUB85.N = 8				; N is argument 2
SUB85.TOTAL = 12			; TOTAL is argument 3

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
SUB85.I:
	.BLKL	1			; I
SUB85.$B1:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_F,DSC$K_CLASS_A
	.LONG	0			; A's bounds: set at each entry point
	.BYTE	0,0,^XE0,1		; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0			; multipliers
	.LONG	1,0			; bounds

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;   27        SUBROUTINE SUB85(A, N, TOTAL)
	.ENTRY	SUB85,^M<R6,R7,R8,R9>
	MOVAL	@SUB85.A(AP),SUB85.$B1+4
	MOVL	@SUB85.N(AP),SUB85.$B1+28
	MOVL	SUB85.$B1+28,SUB85.$B1+20
	MOVL	#-1,R0
	MOVAL	@SUB85.A(AP)[R0],SUB85.$B1+16
	MULL3	#4,SUB85.$B1+20,SUB85.$B1+12
;   28        REAL A(N), TOTAL
;   29        INTEGER I
;   30        TOTAL = 0.0
	CLRF	@SUB85.TOTAL(AP)
;   31        DO 10 I = 1, N
	MOVL	@SUB85.N(AP),R8		; DO 10's limit
	MOVL	#1,SUB85.I
	CMPL	#1,R8
	BGTR	SUB85.$1
	MOVL	SUB85.$B1+16,R9
	MOVL	SUB85.I,R6
	MOVL	@SUB85.TOTAL(AP),R7
SUB85.$3:				; DO 10's body
;   32           TOTAL = TOTAL + A(I)
	ADDF2	(R9)[R6],R7
;   33   10   CONTINUE
SUB85.L10:
	AOBLEQ	R8,R6,SUB85.$3
	MOVL	R6,SUB85.I
	MOVL	R7,@SUB85.TOTAL(AP)
SUB85.$1:
;   34        RETURN
	RET
;   35        END

