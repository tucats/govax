; OUT(control, values...) writes a line.
	.ENTRY	OUT,^M<R2,R3,R4,R5>
	$FAOL_S	CTRSTR=@4(AP),OUTLEN=LD,OUTBUF=BD,PRMLST=8(AP)
	PUSHAB	LD
	CALLS	#1,G^LIB$PUT_OUTPUT
	RET
; SHOW(what, r0)
	.ENTRY	SHOW,^M<>
	PUSHL	8(AP)
	PUSHL	4(AP)
	PUSHAB	MSHOW
	CALLS	#3,OUT
	RET
; HND prints a condition, continues below severe, and unwinds from a severe one.
HND:	.WORD	^M<R2>
	MOVL	4(AP),R2
	CMPL	4(R2),#SS$_UNWIND
	BEQL	50$
	PUSHL	12(R2)
	PUSHL	8(R2)
	PUSHL	(R2)
	PUSHL	4(R2)
	PUSHAB	MCOND
	CALLS	#5,OUT
	BICL3	#^XFFFFFFF8,4(R2),R0
	CMPL	R0,#4
	BEQL	40$
	MOVL	#SS$_CONTINUE,R0
	RET
40$:	PUSHAB	MUNW
	CALLS	#1,G^LIB$PUT_OUTPUT
	$UNWIND_S
50$:	MOVL	#SS$_CONTINUE,R0
	RET
; HEXS(address, count) writes bytes in hex, 32 to a line, with an offset.
	.ENTRY	HEXS,^M<R2,R3,R4,R5,R6,R7>
	MOVL	4(AP),R2
	MOVL	8(AP),R3
	CLRL	R7
10$:	TSTL	R3
	BGTR	11$
	BRW	90$
11$:	MOVAB	HL,R4
	MOVB	#^A/ /,(R4)+
	MOVB	#^A/ /,(R4)+
	ASHL	#-8,R7,R0
	EXTZV	#4,#4,R0,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#0,#4,R0,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#4,#4,R7,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#0,#4,R7,R1
	MOVB	HX[R1],(R4)+
	MOVB	#^A/:/,(R4)+
	MOVB	#^A/ /,(R4)+
	MOVL	#32,R5
20$:	TSTL	R3
	BLEQ	30$
	MOVZBL	(R2)+,R6
	EXTZV	#4,#4,R6,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#0,#4,R6,R1
	MOVB	HX[R1],(R4)+
	DECL	R3
	INCL	R7
	SOBGTR	R5,20$
30$:	MOVAB	HL,R0
	SUBL3	R0,R4,R0
	MOVW	R0,HLD
	PUSHAB	HLD
	CALLS	#1,G^LIB$PUT_OUTPUT
	BRW	10$
90$:	RET
; DUMPF(name, flags): a file's attributes by $OPEN and XABFHC; flag 1, its records
; in hex (the first 32 bytes of each, the first 40 records); flag 2, its blocks in
; hex, by block I/O (all-zero lines left out, the first 16 blocks).
	.ENTRY	DUMPF,^M<R2,R3,R4,R5,R6,R7>
	MOVL	4(AP),R2
	MOVB	(R2),FB2+FAB$B_FNS
	MOVL	4(R2),FB2+FAB$L_FNA
	$OPEN	FAB=FB2
	BLBS	R0,10$
	PUSHL	R0
	PUSHL	R2
	PUSHAB	MST
	CALLS	#3,OUT
	RET
10$:	MOVZWL	FH2+XAB$W_FFB,-(SP)
	PUSHL	FH2+XAB$L_EBK
	PUSHL	FH2+XAB$L_HBK
	MOVZWL	FH2+XAB$W_LRL,-(SP)
	PUSHL	FB2+FAB$L_FOP
	MOVZBL	FB2+FAB$B_BKS,-(SP)
	MOVZWL	FB2+FAB$W_DEQ,-(SP)
	PUSHL	FB2+FAB$L_ALQ
	PUSHL	FB2+FAB$L_MRN
	MOVZWL	FB2+FAB$W_MRS,-(SP)
	MOVZBL	FB2+FAB$B_RAT,-(SP)
	MOVZBL	FB2+FAB$B_RFM,-(SP)
	MOVZBL	FB2+FAB$B_ORG,-(SP)
	PUSHL	R2
	PUSHAB	MST2
	CALLS	#15,OUT
	BLBS	8(AP),20$
	BRW	50$
20$:	$CONNECT RAB=RB2
	MOVL	#1,R6
30$:	MOVL	#33000,R0
	MOVW	R0,RB2+RAB$W_USZ
	MOVAB	RDB,RB2+RAB$L_UBF
	$GET	RAB=RB2
	MOVL	R0,R7
	MOVZWL	RB2+RAB$W_RSZ,-(SP)
	PUSHL	R7
	PUSHL	R6
	PUSHAB	MRC
	CALLS	#4,OUT
	BLBC	R7,40$
	MOVZWL	RB2+RAB$W_RSZ,R3
	CMPL	R3,#32
	BLEQ	35$
	MOVL	#32,R3
35$:	PUSHL	R3
	PUSHAB	RDB
	CALLS	#2,HEXS
	AOBLEQ	#40,R6,30$
40$:
50$:	$CLOSE	FAB=FB2
	BBC	#1,8(AP),59$
	BRW	60$
59$:	RET
60$:	MOVB	(R2),FB3+FAB$B_FNS
	MOVL	4(R2),FB3+FAB$L_FNA
	$OPEN	FAB=FB3
	BLBS	R0,62$
	PUSHL	R0
	PUSHL	R2
	PUSHAB	MST
	CALLS	#3,OUT
	RET
62$:	$CONNECT RAB=RB3
	MOVL	#1,R6
70$:	MOVL	R6,RB3+RAB$L_BKT
	MOVW	#512,RB3+RAB$W_USZ
	MOVAB	BLK,RB3+RAB$L_UBF
	$READ	RAB=RB3
	BLBC	R0,80$
	PUSHL	R6
	PUSHAB	MVB
	CALLS	#2,OUT
	CLRL	R3
72$:	MOVAB	BLK[R3],R4
	MOVL	#8,R5
74$:	TSTL	(R4)+
	BNEQ	76$
	SOBGTR	R5,74$
	BRB	78$
76$:	PUSHL	#32
	PUSHAB	BLK[R3]
	PUSHL	R3
	CALLS	#3,HEXO
78$:	ACBL	#511,#32,R3,72$
	AOBLEQ	#16,R6,70$
80$:	$CLOSE	FAB=FB3
	RET
; HEXO(offset, address, count): one line of block dump, with the block's offset.
	.ENTRY	HEXO,^M<R2,R3,R4,R5,R6,R7>
	MOVL	8(AP),R2
	MOVL	12(AP),R3
	MOVL	4(AP),R7
	MOVAB	HL,R4
	MOVB	#^A/ /,(R4)+
	MOVB	#^A/ /,(R4)+
	EXTZV	#8,#4,R7,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#4,#4,R7,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#0,#4,R7,R1
	MOVB	HX[R1],(R4)+
	MOVB	#^A/:/,(R4)+
	MOVB	#^A/ /,(R4)+
20$:	MOVZBL	(R2)+,R6
	EXTZV	#4,#4,R6,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#0,#4,R6,R1
	MOVB	HX[R1],(R4)+
	SOBGTR	R3,20$
	MOVAB	HL,R0
	SUBL3	R0,R4,R0
	MOVW	R0,HLD
	PUSHAB	HLD
	CALLS	#1,G^LIB$PUT_OUTPUT
	RET
; RDFILL fills the read buffer with 55s.
	.ENTRY	RDFILL,^M<R2,R3,R4,R5>
	MOVC5	#0,RDB,#^X55,#64,RDB
	RET
; SHOWFR shows the FAB and RAB of UVAL's unit, through FOR$RAB.
	.ENTRY	SHOWFR,^M<R2,R3>
	PUSHAB	UVAL
	CALLS	#1,G^FOR$RAB
	MOVL	R0,R3
	BNEQ	10$
	PUSHL	R0
	PUSHAB	MNORAB
	CALLS	#2,OUT
	RET
10$:	MOVL	RAB$L_FAB(R3),R2
	MOVZBL	FAB$B_FSZ(R2),-(SP)
	MOVZWL	FAB$W_BLS(R2),-(SP)
	MOVZBL	FAB$B_BKS(R2),-(SP)
	PUSHL	FAB$L_FOP(R2)
	MOVZWL	FAB$W_DEQ(R2),-(SP)
	PUSHL	FAB$L_ALQ(R2)
	PUSHL	FAB$L_MRN(R2)
	MOVZWL	FAB$W_MRS(R2),-(SP)
	MOVZBL	FAB$B_RAT(R2),-(SP)
	MOVZBL	FAB$B_RFM(R2),-(SP)
	MOVZBL	FAB$B_ORG(R2),-(SP)
	MOVZBL	FAB$B_SHR(R2),-(SP)
	MOVZBL	FAB$B_FAC(R2),-(SP)
	PUSHAB	MFAB
	CALLS	#14,OUT
	CALLS	#0,SHOWR3
	RET
	.ENTRY	SHOWR3,^M<>
	MOVZBL	RAB$B_KRF(R3),-(SP)
	MOVZBL	RAB$B_KSZ(R3),-(SP)
	MOVZWL	RAB$W_USZ(R3),-(SP)
	MOVZWL	RAB$W_RSZ(R3),-(SP)
	CVTBL	RAB$B_MBF(R3),-(SP)
	MOVZBL	RAB$B_MBC(R3),-(SP)
	MOVZBL	RAB$B_RAC(R3),-(SP)
	PUSHL	RAB$L_ROP(R3)
	PUSHAB	MRAB
	CALLS	#9,OUT
	RET
	.ENTRY	SHOWASV,^M<>
	PUSHL	ASVL
	PUSHAB	MASV
	CALLS	#2,OUT
	MNEGL	#1,ASVL
	RET
; INQ1(code, unit keyword or 0, file descriptor or 0): one question. 29 to 33, 41,
; and 42 are numbers and logicals; the others text.
	.ENTRY	INQ1,^M<R2,R3,R4,R5,R6,R7>
	MOVL	4(AP),R7
	MOVL	#^X12345678,IQL
	MOVC5	#0,IQT,#^A/*/,#64,IQT
	CASEL	R7,#29,#19
1$:	.WORD	20$-1$,20$-1$,20$-1$,20$-1$,20$-1$
	.WORD	30$-1$,30$-1$,30$-1$,30$-1$,30$-1$,30$-1$,30$-1$
	.WORD	20$-1$,20$-1$
	.WORD	30$-1$,30$-1$,30$-1$,30$-1$,30$-1$,30$-1$
20$:	PUSHAB	IQL
	BISL3	#^X500,R7,-(SP)
	BRB	40$
30$:	PUSHAB	IQD
	BISL3	#^X400,R7,-(SP)
40$:	PUSHL	#^X00010203
	MOVL	#3,R6
	TSTL	12(AP)
	BEQL	50$
	PUSHL	12(AP)
	PUSHL	#^X070E
	ADDL2	#2,R6
50$:	TSTL	8(AP)
	BEQL	60$
	PUSHL	8(AP)
	INCL	R6
60$:	CALLS	R6,G^FOR$INQUIRE
	MOVL	R0,R6
	CMPB	IQT,#^A/*/
	BNEQ	70$
	PUSHL	IQL
	PUSHL	R6
	PUSHL	R7
	PUSHAB	MIQL
	CALLS	#4,OUT
	RET
70$:	PUSHAB	IQT
	PUSHL	#64
	PUSHL	R6
	PUSHL	R7
	PUSHAB	MIQT
	CALLS	#5,OUT
	RET
; INQA(unit keyword or 0, file descriptor or 0): every question.
	.ENTRY	INQA,^M<R2>
	MOVL	#29,R2
10$:	PUSHL	8(AP)
	PUSHL	4(AP)
	PUSHL	R2
	CALLS	#3,INQ1
	AOBLEQ	#48,R2,10$
	RET
; UOLOG is a USEROPEN routine: it shows what it's given, then by UOMODE opens the
; file. 0 $CREATE and $CONNECT, 1 $OPEN and $CONNECT, 2 fails with RMS$_FNF, 3
; $CREATE alone, 4 $CREATE with RFM changed.
	.ENTRY	UOLOG,^M<R2,R3,R4,R5,R6>
	MOVL	4(AP),R2
	MOVL	8(AP),R3
	MOVL	12(AP),R4
	CLRL	-(SP)
	CMPB	RAB$B_BID(R3),#RAB$C_BID
	BNEQ	10$
	MOVL	#1,(SP)
10$:	CLRL	-(SP)
	CMPB	FAB$B_BID(R2),#FAB$C_BID
	BNEQ	20$
	MOVL	#1,(SP)
20$:	PUSHL	(R4)
	MOVZBL	(AP),-(SP)
	PUSHAB	MUOA
	CALLS	#5,OUT
	MOVZBL	FAB$B_FSZ(R2),-(SP)
	MOVZWL	FAB$W_BLS(R2),-(SP)
	MOVZBL	FAB$B_BKS(R2),-(SP)
	PUSHL	FAB$L_FOP(R2)
	MOVZWL	FAB$W_DEQ(R2),-(SP)
	PUSHL	FAB$L_ALQ(R2)
	PUSHL	FAB$L_MRN(R2)
	MOVZWL	FAB$W_MRS(R2),-(SP)
	MOVZBL	FAB$B_RAT(R2),-(SP)
	MOVZBL	FAB$B_RFM(R2),-(SP)
	MOVZBL	FAB$B_ORG(R2),-(SP)
	MOVZBL	FAB$B_SHR(R2),-(SP)
	MOVZBL	FAB$B_FAC(R2),-(SP)
	PUSHAB	MFAB
	CALLS	#14,OUT
	CALLS	#0,SHOWR3
	MOVL	FAB$L_NAM(R2),R0
	BEQL	25$
	MOVL	#1,R0
25$:	PUSHL	R0
	PUSHL	FAB$L_DNA(R2)
	MOVZBL	FAB$B_DNS(R2),-(SP)
	PUSHL	FAB$L_FNA(R2)
	MOVZBL	FAB$B_FNS(R2),-(SP)
	PUSHAB	MUOF
	CALLS	#6,OUT
	MOVL	FAB$L_XAB(R2),R5
30$:	BEQL	40$
	MOVZBL	XAB$B_BLN(R5),-(SP)
	MOVZBL	XAB$B_COD(R5),-(SP)
	PUSHAB	MUOX
	CALLS	#3,OUT
	CMPB	XAB$B_COD(R5),#XAB$C_KEY
	BNEQ	35$
	PUSHL	XAB$L_KNM(R5)
	MOVZBL	XAB$B_NUL(R5),-(SP)
	MOVZWL	XAB$W_IFL(R5),-(SP)
	MOVZWL	XAB$W_DFL(R5),-(SP)
	MOVZBL	XAB$B_LAN(R5),-(SP)
	MOVZBL	XAB$B_IAN(R5),-(SP)
	MOVZBL	XAB$B_DAN(R5),-(SP)
	MOVZBL	XAB$B_IBS(R5),-(SP)
	MOVZBL	XAB$B_DBS(R5),-(SP)
	MOVZBL	XAB$B_NSG(R5),-(SP)
	MOVZBL	XAB$B_SIZ0(R5),-(SP)
	MOVZWL	XAB$W_POS0(R5),-(SP)
	MOVZBL	XAB$B_FLG(R5),-(SP)
	MOVZBL	XAB$B_DTP(R5),-(SP)
	MOVZBL	XAB$B_REF(R5),-(SP)
	PUSHAB	MUOK
	CALLS	#16,OUT
35$:	MOVL	XAB$L_NXT(R5),R5
	BRB	30$
40$:	MOVL	UOMODE,R6
	CMPL	R6,#2
	BNEQ	42$
	MOVL	#^X18292,R0
	RET
42$:	CMPL	R6,#4
	BNEQ	44$
	MOVB	#FAB$C_STM,FAB$B_RFM(R2)
44$:	CMPL	R6,#1
	BEQL	50$
	$CREATE	FAB=(R2)
	BRB	60$
50$:	$OPEN	FAB=(R2)
60$:	MOVL	R0,R5
	PUSHL	FAB$L_STV(R2)
	PUSHL	R5
	PUSHAB	MUOS
	CALLS	#3,OUT
	BLBC	R5,90$
	CMPL	R6,#3
	BEQL	90$
	$CONNECT RAB=(R3)
	MOVL	R0,R5
	PUSHL	RAB$L_STV(R3)
	PUSHL	R5
	PUSHAB	MUOS
	CALLS	#3,OUT
90$:	MOVL	R5,R0
	RET
; CLEAN closes units 10 to 19 after each case, saying nothing.
CLH:	.WORD	^M<>
	MOVL	4(AP),R0
