	.TITLE	FOR88F - round 2's program on FTNRTL
;
; for88.mar calls VMS's FORTRAN run-time library, FOR$OPEN and the rest. FTNRTL's
; statements take the compiler's arguments instead (ftn_open.mar's header), so this
; module defines each FOR$ name the program calls, and passes the call on:
;
;	FOR$OPEN(unit, ERR=, keyword, ...)
;	FTN$OPEN(control block, unit, keyword, value, keyword, value, ...)
;
; A FOR$ keyword is a longword, its code in bits 0 to 7 and its mechanism in bits 8
; to 15. Mechanism 1 is the unit, in the high word. Mechanism 2 is a value in the
; high word, and mechanism 0 a keyword with no value at all; FTNRTL takes either as
; a value by mechanism 4. Any other has its value in the next argument, which is
; FTNRTL's form as it stands. Code 3 by mechanism 2 is ERR=, a flag of the control
; block.
;
; FTNRTL returns 0, -1 at an end of file, or a FOR number, where FORRTL returns a
; condition value, which is what the program shows. So R0 is made a condition value.
;
; The record statements take the FOR$ arguments with the control block first, and a
; format's address becoming a run-time format's descriptor. FTNRTL's statement knows
; its routine by its caller's frame, so these can't call it from a frame of their own,
; which would have gone by the time of the statement's items: they run its code in
; theirs, by a jump past the entry's mask to the vector's JMP, each entry saving all
; the registers any FTNRTL entry would. No flags are set, so that a failure is signaled
; as the program's handler expects, and R0 stays as FTNRTL leaves it.
;
; TestFor88OnFTNRTL links this with for88.mar, and FTNRTL decides everything.
;
	.PSECT	FOR88F_DATA,NOEXE,WRT,LONG

CONTROL:
	.WORD	8			; its size
FLAGS:	.WORD	0			; bit 0, ERR=
	.LONG	0
NEWARGS:
	.BLKL	256
FORMAT:	.WORD	0			; a run-time format's descriptor
	.BYTE	14,1
	.ADDRESS 0

	.PSECT	FOR88F_CODE,EXE,NOWRT,LONG

;
; TRANSLATE: this call's arguments into NEWARGS. R4 is 1 if the unit is an argument
; of its own (OPEN, CLOSE), and 0 if a keyword like the others (INQUIRE).
;
TRANSLATE:
	CLRW	FLAGS
	MOVAB	CONTROL,NEWARGS+4
	MOVAB	NEWARGS+8,R3		; where the next one goes
	TSTL	R4
	BEQL	5$
	ADDL2	#4,R3			; past the unit's place
5$:	MOVL	#1,R2
10$:	MOVZBL	(AP),R0
	CMPL	R2,R0
	BGTR	90$
	MOVL	(AP)[R2],R0
	INCL	R2
	EXTZV	#8,#8,R0,R1		; the mechanism
	CMPL	R1,#1
	BEQL	20$
	CMPL	R1,#2
	BEQL	30$
	TSTL	R1
	BEQL	40$
	MOVL	R0,(R3)+		; as it stands
	MOVL	(AP)[R2],(R3)+
	INCL	R2
	BRB	10$
20$:	EXTV	#16,#16,R0,R1		; the unit
	TSTL	R4
	BEQL	25$
	MOVL	R1,NEWARGS+8
	BRB	10$
25$:	MOVL	#^X0401,(R3)+
	MOVL	R1,(R3)+
	BRB	10$
30$:	CMPB	R0,#3			; ERR=
	BNEQ	35$
	BISW2	#1,FLAGS
	BRB	10$
35$:	MOVZBL	R0,R1			; a value in the high word
	BISL3	#^X0400,R1,(R3)+
	EXTZV	#16,#16,R0,(R3)+
	BRB	10$
40$:	MOVZBL	R0,R1			; a keyword with no value
	BISL3	#^X0400,R1,(R3)+
	MOVL	#1,(R3)+
	BRB	10$
90$:	MOVAB	NEWARGS,R0		; the count
	SUBL3	R0,R3,R1
	ASHL	#-2,R1,R1
	DECL	R1
	MOVL	R1,NEWARGS
	RSB

;
; CONDITION: R0, FTNRTL's status, as FORRTL's. A FOR number n is the condition
; ^X188004 + 8n, each with the severity E but for those it doesn't matter to here.
;
CONDITION:
	TSTL	R0
	BNEQ	10$
	MOVL	#1,R0
	RSB
10$:	BGTR	20$
	MOVL	#24,R0			; ENDDURREA
20$:	MULL2	#8,R0
	ADDL2	#^X188004,R0
	RSB

	.ENTRY	FOR$OPEN,^M<R2,R3,R4>
	MOVL	#1,R4
	BSBW	TRANSLATE
	CALLG	NEWARGS,G^FTN$OPEN
	BSBW	CONDITION
	RET

	.ENTRY	FOR$CLOSE,^M<R2,R3,R4>
	MOVL	#1,R4
	BSBW	TRANSLATE
	CALLG	NEWARGS,G^FTN$CLOSE
	BSBW	CONDITION
	RET

	.ENTRY	FOR$INQUIRE,^M<R2,R3,R4>
	CLRL	R4
	BSBW	TRANSLATE
	CALLG	NEWARGS,G^FTN$INQUIRE
	BSBW	CONDITION
	RET

	.ENTRY	FOR$RAB,^M<>
	CALLG	(AP),G^FTN$RAB
	RET

;
; PREPEND: this call's arguments, as they stand, after the control block. Changes R0 to
; R2.
;
PREPEND:
	CLRW	FLAGS
	MOVZBL	(AP),R0
	ADDL3	#1,R0,NEWARGS
	MOVAB	CONTROL,NEWARGS+4
	MOVAB	NEWARGS+8,R1
	MOVL	#1,R2
10$:	CMPL	R2,R0
	BGTR	20$
	MOVL	(AP)[R2],(R1)+
	INCL	R2
	BRB	10$
20$:	RSB

;
; FORMATTED: PREPEND's second argument after the control block, a format's address
; (.ASCIZ), made a run-time format's descriptor. Changes R0 to R3.
;
FORMATTED:
	BSBB	PREPEND
	BISW2	#8,FLAGS
	MOVL	NEWARGS+12,R2
	MOVL	R2,FORMAT+4
	LOCC	#0,#255,(R2)
	SUBL3	R2,R1,R0
	MOVW	R0,FORMAT
	MOVAB	FORMAT,NEWARGS+12
	RSB

	.MACRO	GO	TARGET
	MOVAB	NEWARGS,AP
	MOVAB	G^TARGET,R0
	JMP	2(R0)
	.ENDM	GO

ALL	= ^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>

	.MACRO	PASS	NAME,TARGET		; the control block first
	.ENTRY	NAME,ALL
	BSBW	PREPEND
	GO	TARGET
	.ENDM	PASS

	.MACRO	WITHFMT	NAME,TARGET		; and a format
	.ENTRY	NAME,ALL
	BSBW	FORMATTED
	GO	TARGET
	.ENDM	WITHFMT

	PASS	FOR$BACKSPACE,FTN$BACKSPACE
	PASS	FOR$DELETE,FTN$DELETE
	PASS	FOR$DELETE_D,FTN$DELETE_D
	PASS	FOR$ENDFILE,FTN$ENDFILE
	PASS	FOR$FIND,FTN$FIND
	PASS	FOR$READ_DU,FTN$READ_DU
	PASS	FOR$READ_SU,FTN$READ_SU
	PASS	FOR$REWIND,FTN$REWIND
	PASS	FOR$REWRITE_SU,FTN$REWRITE_SU
	PASS	FOR$UNLOCK,FTN$UNLOCK
	PASS	FOR$WRITE_DU,FTN$WRITE_DU
	PASS	FOR$WRITE_SU,FTN$WRITE_SU
	WITHFMT	FOR$READ_SO,FTN$READ_SF
	WITHFMT	FOR$REWRITE_SO,FTN$REWRITE_SF
	WITHFMT	FOR$WRITE_SO,FTN$WRITE_SF

;
; The keyed READs: KEYID= and the specifier may be left out, the unit's last and 0.
;
	.ENTRY	FOR$READ_KU,ALL
	BSBW	PREPEND
	BSBW	KEYED_U
	GO	FTN$READ_KU

	.ENTRY	FOR$READ_KO,ALL
	BSBW	FORMATTED
	GO	FTN$READ_KF

;
; KEYED_U: FTN$READ_KU's list has 5 arguments, the last two perhaps not given.
;
KEYED_U:
	CMPB	NEWARGS,#3
	BGTRU	10$
	MNEGL	#1,NEWARGS+16
10$:	CMPB	NEWARGS,#4
	BGTRU	20$
	CLRL	NEWARGS+20
20$:	MOVL	#5,NEWARGS
	RSB

	.ENTRY	FOR$IO_END,ALL
	MOVAB	G^FTN$IO_END,R0
	JMP	2(R0)

	.ENTRY	FOR$IO_T_DS,ALL
	MOVAB	G^FTN$IO_ITEM,R0
	JMP	2(R0)

	.END
