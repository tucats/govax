; 14: COPY_DX dynamic kept
	.ENTRY	C14,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	PUSHAB	C14_S
	PUSHAB	C14_D
	CALLS	#2,G^STR$COPY_DX
	MOVL	C14_D+4,SAVEP
	PUSHAB	C14_T
	PUSHAB	C14_D
	CALLS	#2,G^STR$COPY_DX
	PUSHL	R0
	CLRL	C14_Z
	CMPL	C14_D+4,SAVEP
	BNEQ	C14_NZ
	MOVL	#1,C14_Z
	C14_NZ:
	MOVL	(SP)+,R0
	RET

