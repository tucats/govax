$ ! F90R.COM - does a Fortran 90 program govax's compiler made run on VMS, with FTNRTL
$ ! built here from its sources? (docs/planning/PHASE-111 - Fortran 90 milestone.md, subtask
$ ! 11). Written by testdata/f90r/gen.go. There's no Fortran 90 compiler here, and none is
$ ! needed: each program's .MAR files came from govax's compiler, and VMS's MACRO and LINK
$ ! do the rest.
$ !
$ ! Run it with the exchange volume mounted, its [000000] the default directory:
$ !
$ !     @F90R/OUTPUT=F90R.LOG
$ !
$ SET NOON
$ ROOT = F$PARSE(F$ENVIRONMENT("DEFAULT"),,,"DEVICE")
$ !
$ ! FTNRTL, from its sources.
$ !
$ SET DEFAULT 'ROOT'[FTNRTL]
$ WRITE SYS$OUTPUT "==== FTNRTL"
$ MACRO/NOLIST FTN_VECTOR
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_CONTROL
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_UNITS
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_STATEMENT
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_FORMAT
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_EDIT
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_FLOAT
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_LISTOUT
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_LISTIN
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_NAMELIST
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_INTERNAL
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_OPEN
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_INQUIRE
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_POSITION
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_UNFORMATTED
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_DIRECT
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_RECORD
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_KEYED
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_INTRINSICS
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_SYSTEM
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST FTN_ALLOC
$ SHOW SYMBOL $STATUS
$ IF F$TRNLNM("FTNRTL") .NES. "" THEN DEASSIGN FTNRTL
$ LINK/SHAREABLE=FTNRTL/MAP=FTNRTL/FULL FTNRTL/OPTIONS
$ SHOW SYMBOL $STATUS
$ DEFINE FTNRTL 'ROOT'[FTNRTL]FTNRTL.EXE
$ !
$ ! fcalc, the milestone program, in each of its variants: every script run in its
$ ! name's order, as TestFcalcMilestone runs them, since STATE's files are read later;
$ ! then the files the scripts wrote, and ONESHOT.COM, fcalc as a foreign command.
$ !
$ WRITE SYS$OUTPUT "==== FCALC"
$ SET DEFAULT 'ROOT'[FCALC]
$ MACRO/NOLIST FCPLATFORM,FCKINDS,FCMESSAGES,FCVALUES,FCARRAYS,FCLEXER,FCTREE,FCSYMBOLS,FCFUNCS,FCPOLY,FCMATRIX,FCEVAL,FCNUMERIC,FCPLOT,FCSTATE,FCALC
$ LINK/NOMAP/EXECUTABLE=FCALC FCALC,FCPLATFORM,FCKINDS,FCMESSAGES,FCVALUES,FCARRAYS,FCLEXER,FCTREE,FCSYMBOLS,FCFUNCS,FCPOLY,FCMATRIX,FCEVAL,FCNUMERIC,FCPLOT,FCSTATE,'ROOT'[FTNRTL]F90R/OPTIONS
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== FCALC.BASICS"
$ DEFINE/USER_MODE SYS$INPUT BASICS.IN
$ RUN FCALC
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== FCALC.COMPLEX"
$ DEFINE/USER_MODE SYS$INPUT COMPLEX.IN
$ RUN FCALC
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== FCALC.DISPLAY"
$ DEFINE/USER_MODE SYS$INPUT DISPLAY.IN
$ RUN FCALC
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== FCALC.ERRORS"
$ DEFINE/USER_MODE SYS$INPUT ERRORS.IN
$ RUN FCALC
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== FCALC.FUNCTIONS"
$ DEFINE/USER_MODE SYS$INPUT FUNCTIONS.IN
$ RUN FCALC
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== FCALC.MATRICES"
$ DEFINE/USER_MODE SYS$INPUT MATRICES.IN
$ RUN FCALC
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== FCALC.NUMERIC"
$ DEFINE/USER_MODE SYS$INPUT NUMERIC.IN
$ RUN FCALC
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== FCALC.PLOT"
$ DEFINE/USER_MODE SYS$INPUT PLOT.IN
$ RUN FCALC
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== FCALC.STATE"
$ DEFINE/USER_MODE SYS$INPUT STATE.IN
$ RUN FCALC
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== FCALC.USERFUNCS"
$ DEFINE/USER_MODE SYS$INPUT USERFUNCS.IN
$ RUN FCALC
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== FCALC.VECTORS"
$ DEFINE/USER_MODE SYS$INPUT VECTORS.IN
$ RUN FCALC
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== FCALC.SAVED"
$ CALL RECORDS SAVED.FCALC
$ WRITE SYS$OUTPUT "==== FCALC.SESSION"
$ CALL RECORDS SESSION.FCALC
$ WRITE SYS$OUTPUT "==== FCALC.ONESHOT"
$ @ONESHOT
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== FCALCN"
$ SET DEFAULT 'ROOT'[FCALCN]
$ MACRO/NOLIST FCPLATFORM,FCKINDS,FCMESSAGES,FCVALUES,FCARRAYS,FCLEXER,FCTREE,FCSYMBOLS,FCFUNCS,FCPOLY,FCMATRIX,FCEVAL,FCNUMERIC,FCPLOT,FCSTATE,FCALC
$ LINK/NOMAP/EXECUTABLE=FCALC FCALC,FCPLATFORM,FCKINDS,FCMESSAGES,FCVALUES,FCARRAYS,FCLEXER,FCTREE,FCSYMBOLS,FCFUNCS,FCPOLY,FCMATRIX,FCEVAL,FCNUMERIC,FCPLOT,FCSTATE,'ROOT'[FTNRTL]F90R/OPTIONS
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== FCALCN.BASICS"
$ DEFINE/USER_MODE SYS$INPUT BASICS.IN
$ RUN FCALC
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== FCALCN.COMPLEX"
$ DEFINE/USER_MODE SYS$INPUT COMPLEX.IN
$ RUN FCALC
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== FCALCN.DISPLAY"
$ DEFINE/USER_MODE SYS$INPUT DISPLAY.IN
$ RUN FCALC
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== FCALCN.ERRORS"
$ DEFINE/USER_MODE SYS$INPUT ERRORS.IN
$ RUN FCALC
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== FCALCN.FUNCTIONS"
$ DEFINE/USER_MODE SYS$INPUT FUNCTIONS.IN
$ RUN FCALC
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== FCALCN.MATRICES"
$ DEFINE/USER_MODE SYS$INPUT MATRICES.IN
$ RUN FCALC
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== FCALCN.NUMERIC"
$ DEFINE/USER_MODE SYS$INPUT NUMERIC.IN
$ RUN FCALC
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== FCALCN.PLOT"
$ DEFINE/USER_MODE SYS$INPUT PLOT.IN
$ RUN FCALC
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== FCALCN.STATE"
$ DEFINE/USER_MODE SYS$INPUT STATE.IN
$ RUN FCALC
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== FCALCN.USERFUNCS"
$ DEFINE/USER_MODE SYS$INPUT USERFUNCS.IN
$ RUN FCALC
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== FCALCN.VECTORS"
$ DEFINE/USER_MODE SYS$INPUT VECTORS.IN
$ RUN FCALC
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== FCALCN.SAVED"
$ CALL RECORDS SAVED.FCALC
$ WRITE SYS$OUTPUT "==== FCALCN.SESSION"
$ CALL RECORDS SESSION.FCALC
$ WRITE SYS$OUTPUT "==== FCALCN.ONESHOT"
$ @ONESHOT
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== FCALCR"
$ SET DEFAULT 'ROOT'[FCALCR]
$ MACRO/NOLIST FCPLATFORM,FCKINDS,FCMESSAGES,FCVALUES,FCARRAYS,FCLEXER,FCTREE,FCSYMBOLS,FCFUNCS,FCPOLY,FCMATRIX,FCEVAL,FCNUMERIC,FCPLOT,FCSTATE,FCALC
$ LINK/NOMAP/EXECUTABLE=FCALC FCALC,FCPLATFORM,FCKINDS,FCMESSAGES,FCVALUES,FCARRAYS,FCLEXER,FCTREE,FCSYMBOLS,FCFUNCS,FCPOLY,FCMATRIX,FCEVAL,FCNUMERIC,FCPLOT,FCSTATE,'ROOT'[FTNRTL]F90R/OPTIONS
