;  111
;  112    ! NAME_TOKEN takes a name: a letter, then letters, digits, _, and $. It is
;  113    ! lowercased a character at a time by its ASCII code: in ASCII the capital
;  114    ! letters are 65 to 90 and the small ones 97 to 122, the same distance
;  115    ! apart for every letter.
;  116    subroutine name_token(line, at, t)
	.ENTRY	FCLEXER.NAME_TOKEN,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10>
;  117      character(len=*), intent(in) :: line
