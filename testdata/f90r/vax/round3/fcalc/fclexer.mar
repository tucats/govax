	CALLS	#3,G^FTN$VERIFY
	MOVL	R0,FCLEXER.NAME_TOKEN.$T1
	MOVL	FCLEXER.NAME_TOKEN.$T1,FCLEXER.NAME_TOKEN.K
;  123      if (k == 0) then
	BNEQ	FCLEXER.NAME_TOKEN.$3
;  124        length = len(line) - at + 1
	MOVZWL	@FCLEXER.NAME_TOKEN.LINE(AP),R0
	SUBL2	@FCLEXER.NAME_TOKEN.AT(AP),R0
	ADDL3	R0,#1,FCLEXER.NAME_TOKEN.LENGTH
;  125      else
	BRB	FCLEXER.NAME_TOKEN.$5
FCLEXER.NAME_TOKEN.$3:
;  126        length = k - 1
	SUBL3	#1,FCLEXER.NAME_TOKEN.K,FCLEXER.NAME_TOKEN.LENGTH
;  127      end if
FCLEXER.NAME_TOKEN.$5:
;  128      if (length > name_length) then
	CMPL	FCLEXER.NAME_TOKEN.LENGTH,#31
	BLEQ	FCLEXER.NAME_TOKEN.$6
;  129        call fail(e_namelong, at)
	PUSHL	#0
	PUSHAL	@FCLEXER.NAME_TOKEN.AT(AP)
	PUSHAL	FCLEXER.NAME_TOKEN.$K3
	CALLS	#3,G^FCMESSAGES.FAIL
;  130        return
	RET
FCLEXER.NAME_TOKEN.$6:
;  131      end if
;  132
;  133      t%kind = t_name
	MOVL	#2,@FCLEXER.NAME_TOKEN.T(AP)
;  134      t%text = line(at:at + length - 1)
	ADDL3	@FCLEXER.NAME_TOKEN.AT(AP),FCLEXER.NAME_TOKEN.LENGTH,R0
	SUBL3	@FCLEXER.NAME_TOKEN.AT(AP),R0,R6
	BGEQ	FCLEXER.NAME_TOKEN.$8
	CLRL	R6
FCLEXER.NAME_TOKEN.$8:
	MOVL	FCLEXER.NAME_TOKEN.LINE(AP),R0
	SUBL3	#1,@FCLEXER.NAME_TOKEN.AT(AP),R1
	MOVL	FCLEXER.NAME_TOKEN.T(AP),R2
	MOVC5	R6,@4(R0)[R1],#^A/ /,#31,8(R2)
;  135      do k = 1, length
	MOVL	FCLEXER.NAME_TOKEN.LENGTH,R10 ; DO (line 135)'s limit
	MOVL	#1,FCLEXER.NAME_TOKEN.K
	CMPL	#1,R10
	BGTR	FCLEXER.NAME_TOKEN.$10
	MOVL	FCLEXER.NAME_TOKEN.K,R6
	MOVL	FCLEXER.NAME_TOKEN.T(AP),R7
	MOVL	FCLEXER.NAME_TOKEN.C,R8
FCLEXER.NAME_TOKEN.$12:			; DO (line 135)'s body
;  136        c = iachar(t%text(k:k))
	MOVZBL	7(R7)[R6],R8
;  137        if (c >= iachar('A') .and. c <= iachar('Z')) &
;  138          t%text(k:k) = achar(c - iachar('A') + iachar('a'))
	CMPL	R8,#65
	BLSS	FCLEXER.NAME_TOKEN.$13
	CMPL	R8,#90
	BGTR	FCLEXER.NAME_TOKEN.$13
	ADDL3	R8,#32,R0
	MOVB	R0,R9
	MOVB	R9,7(R7)[R6]
FCLEXER.NAME_TOKEN.$13:
;  139      end do
	AOBLEQ	R10,R6,FCLEXER.NAME_TOKEN.$12
	MOVL	R6,FCLEXER.NAME_TOKEN.K
	MOVL	R8,FCLEXER.NAME_TOKEN.C
FCLEXER.NAME_TOKEN.$10:
;  140      at = at + length
	ADDL2	FCLEXER.NAME_TOKEN.LENGTH,@FCLEXER.NAME_TOKEN.AT(AP)
;  141    end subroutine name_token
	RET

; Storage map for FCLEXER.NUMBER_TOKEN, a subroutine
;   LINE   CHARACTER*(*), INTENT(IN)   argument 1  @FCLEXER.NUMBER_TOKEN.LINE(AP)
;   AT     INTEGER, INTENT(INOUT)      argument 2  @FCLEXER.NUMBER_TOKEN.AT(AP)
;   T      TYPE(TOKEN), INTENT(INOUT)  argument 3  @FCLEXER.NUMBER_TOKEN.T(AP)
;   FIRST  INTEGER                     $LOCAL+0    FCLEXER.NUMBER_TOKEN.FIRST
;   K      INTEGER                     $LOCAL+4    FCLEXER.NUMBER_TOKEN.K
;   LEAD   INTEGER                     $LOCAL+8    FCLEXER.NUMBER_TOKEN.LEAD
;   POWER  INTEGER                     $LOCAL+12   FCLEXER.NUMBER_TOKEN.POWER
;   IOS    INTEGER                     $LOCAL+16   FCLEXER.NUMBER_TOKEN.IOS
;   C      INTEGER                     $LOCAL+20   FCLEXER.NUMBER_TOKEN.C
;   POINT  LOGICAL                     $LOCAL+24   FCLEXER.NUMBER_TOKEN.POINT
;   SEEN   LOGICAL                     $LOCAL+28   FCLEXER.NUMBER_TOKEN.SEEN
;   R6 is $T1: temporary
;   R6 is $T2: temporary
;   R6 is $T3: temporary
;   R6 is $U1: temporary
;   R7 is $R1: LEAD, during a loop
;   R8 is $R2: AT's address
;   R9 is $R3: POINT, during a loop
;   R10 is $R4: LINE's address
;   R11 is $R5: SEEN, during a loop
;   R7 is $R6: POWER, during a loop
;   R8 is $R7: LINE's address
;
FCLEXER.NUMBER_TOKEN.LINE = 4		; LINE is argument 1
FCLEXER.NUMBER_TOKEN.AT = 8		; AT is argument 2
FCLEXER.NUMBER_TOKEN.T = 12		; T is argument 3

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCLEXER.NUMBER_TOKEN.FIRST:
	.BLKL	1			; FIRST
FCLEXER.NUMBER_TOKEN.K:
	.BLKL	1			; K
FCLEXER.NUMBER_TOKEN.LEAD:
	.BLKL	1			; LEAD
FCLEXER.NUMBER_TOKEN.POWER:
	.BLKL	1			; POWER
FCLEXER.NUMBER_TOKEN.IOS:
	.BLKL	1			; IOS
FCLEXER.NUMBER_TOKEN.C:
	.BLKL	1			; C
FCLEXER.NUMBER_TOKEN.POINT:
	.BLKL	1			; POINT
FCLEXER.NUMBER_TOKEN.SEEN:
	.BLKL	1			; SEEN
FCLEXER.NUMBER_TOKEN.$D1:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used
FCLEXER.NUMBER_TOKEN.$D2:
	.WORD	8			; length
	.BYTE	DSC$K_DTYPE_G,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used
FCLEXER.NUMBER_TOKEN.$H1:
	.BLKL	1			; a value computed before a loop

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCLEXER.NUMBER_TOKEN.$K8:
	.LONG	10
FCLEXER.NUMBER_TOKEN.$IO1:
	.WORD	8			; an I/O statement's control block: its size
	.WORD	^X0014			; flags: IOSTAT= F90
	.LONG	0			; (not used yet)
FCLEXER.NUMBER_TOKEN.$K9:
	.LONG	2
FCLEXER.NUMBER_TOKEN.$KF1:
	.LONG	^XE43C7E57,^X759C8800	; 1D300
FCLEXER.NUMBER_TOKEN.$KF2:
	.LONG	^X6E1F01C5,^XF359C2F8	; 1D-300
FCLEXER.NUMBER_TOKEN.$K1:
	.ASCII	/0123456789/
FCLEXER.NUMBER_TOKEN.$K7:
	.ASCII	/ /
FCLEXER.NUMBER_TOKEN.$K12:
	.ASCII	/abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_$/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  142
;  143    ! NUMBER_TOKEN takes a number: digits with a point, or a point and
;  144    ! digits; an exponent, E and digits with a sign or none; and an i after
;  145    ! it all for an imaginary one. Its value is read by an internal READ,
;  146    ! after its size is checked, so a number no machine could hold is an
;  147    ! error and not a trap.
;  148    !
;  149    ! The size check counts LEAD, the power of ten of the number's first
;  150    ! digit that isn't zero (2 for 123.4, -3 for 0.00123), and adds the
;  151    ! exponent: the number is about 10**(LEAD + POWER), known before the
;  152    ! READ converts it. READ (text, *) is list-directed: it reads a value in
;  153    ! any form Fortran writes constants, and IOSTAT= gives a nonzero status
;  154    ! instead of stopping the program if it can't.
;  155    subroutine number_token(line, at, t)
	.ENTRY	FCLEXER.NUMBER_TOKEN,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
;  156      character(len=*), intent(in) :: line
;  157      integer, intent(inout) :: at
;  158      type(token), intent(inout) :: t
;  159      integer :: first, k, lead, power, ios, c
;  160      logical :: point, seen
;  161
;  162      if (based_number(line, at, t)) return
	PUSHAB	@FCLEXER.NUMBER_TOKEN.T(AP)
	PUSHAL	@FCLEXER.NUMBER_TOKEN.AT(AP)
	PUSHL	FCLEXER.NUMBER_TOKEN.LINE(AP)
	CALLS	#3,G^FCLEXER.BASED_NUMBER
	MOVL	R0,R6
	BLBC	R6,FCLEXER.NUMBER_TOKEN.$1
	RET
FCLEXER.NUMBER_TOKEN.$1:
;  163
;  164      first = at
	MOVL	@FCLEXER.NUMBER_TOKEN.AT(AP),FCLEXER.NUMBER_TOKEN.FIRST
;  165      point = .false.
	CLRL	FCLEXER.NUMBER_TOKEN.POINT
;  166      seen = .false.
	CLRL	FCLEXER.NUMBER_TOKEN.SEEN
;  167
;  168      ! LEAD is the power of ten of the first digit that isn't zero, counted
;  169      ! as the digits are read.
;  170      lead = 0
	CLRL	FCLEXER.NUMBER_TOKEN.LEAD
;  171      do while (at <= len(line))
	MOVZWL	@FCLEXER.NUMBER_TOKEN.LINE(AP),FCLEXER.NUMBER_TOKEN.$H1 ; from line 171
	MOVL	FCLEXER.NUMBER_TOKEN.LEAD,R7
	MOVL	FCLEXER.NUMBER_TOKEN.AT(AP),R8
	MOVL	FCLEXER.NUMBER_TOKEN.POINT,R9
	MOVL	FCLEXER.NUMBER_TOKEN.LINE(AP),R10
	MOVL	FCLEXER.NUMBER_TOKEN.SEEN,R11
	BRB	FCLEXER.NUMBER_TOKEN.$3
FCLEXER.NUMBER_TOKEN.$4:		; DO (line 171)'s body
;  172        c = index(digit_set, line(at:at)) - 1
	SUBL3	#1,(R8),R0
	MATCHC	#1,@4(R10)[R0],#10,FCLEXER.NUMBER_TOKEN.$K1
	BNEQ	FCLEXER.NUMBER_TOKEN.$5
	SUBL3	R2,#10,R0
	BRB	FCLEXER.NUMBER_TOKEN.$6
FCLEXER.NUMBER_TOKEN.$5:
	CLRL	R0
FCLEXER.NUMBER_TOKEN.$6:
	MOVL	R0,R6
	SUBL3	#1,R6,FCLEXER.NUMBER_TOKEN.C
;  173        if (c >= 0) then
	BLSS	FCLEXER.NUMBER_TOKEN.$7
;  174          if (c > 0 .and. .not. seen) then
	TSTL	FCLEXER.NUMBER_TOKEN.C
	BLEQ	FCLEXER.NUMBER_TOKEN.$9
	BLBS	R11,FCLEXER.NUMBER_TOKEN.$9
;  175            seen = .true.
	MOVL	#-1,R11
;  176            if (point) lead = lead - 1
	BLBC	R9,FCLEXER.NUMBER_TOKEN.$20
	DECL	R7
;  177          else if (seen .and. .not. point) then
	BRB	FCLEXER.NUMBER_TOKEN.$20
FCLEXER.NUMBER_TOKEN.$9:
	BLBC	R11,FCLEXER.NUMBER_TOKEN.$15
	BLBS	R9,FCLEXER.NUMBER_TOKEN.$15
;  178            lead = lead + 1
	INCL	R7
;  179          else if (.not. seen .and. point) then
	BRB	FCLEXER.NUMBER_TOKEN.$20
FCLEXER.NUMBER_TOKEN.$15:
	BLBS	R11,FCLEXER.NUMBER_TOKEN.$20
	BLBC	R9,FCLEXER.NUMBER_TOKEN.$20
;  180            lead = lead - 1
	DECL	R7
;  181          end if
;  182        else if (line(at:at) == '.' .and. .not. point) then
	BRB	FCLEXER.NUMBER_TOKEN.$20
FCLEXER.NUMBER_TOKEN.$7:
	SUBL3	#1,(R8),R0
	CMPB	@4(R10)[R0],#46
	BEQL	FCLEXER.NUMBER_TOKEN.$22
	BRW	FCLEXER.NUMBER_TOKEN.$21
FCLEXER.NUMBER_TOKEN.$22:
	BLBC	R9,FCLEXER.NUMBER_TOKEN.$23
	BRW	FCLEXER.NUMBER_TOKEN.$21
FCLEXER.NUMBER_TOKEN.$23:
;  183          point = .true.
	MOVL	#-1,R9
;  184        else
;  185          exit
FCLEXER.NUMBER_TOKEN.$20:
;  186        end if
;  187        at = at + 1
	INCL	(R8)
;  188      end do
FCLEXER.NUMBER_TOKEN.$3:		; DO (line 171)'s test
	CMPL	(R8),FCLEXER.NUMBER_TOKEN.$H1 ; from line 171
	BLEQ	FCLEXER.NUMBER_TOKEN.$4
	MOVL	R7,FCLEXER.NUMBER_TOKEN.LEAD
	MOVL	R9,FCLEXER.NUMBER_TOKEN.POINT
	MOVL	R11,FCLEXER.NUMBER_TOKEN.SEEN
FCLEXER.NUMBER_TOKEN.$25:
;  189
;  190      ! An exponent, if the E is followed by digits.
;  191      power = 0
	CLRL	FCLEXER.NUMBER_TOKEN.POWER
;  192      if (at <= len(line)) then
	MOVZWL	@FCLEXER.NUMBER_TOKEN.LINE(AP),R0
	CMPL	@FCLEXER.NUMBER_TOKEN.AT(AP),R0
	BLEQ	FCLEXER.NUMBER_TOKEN.$28
	BRW	FCLEXER.NUMBER_TOKEN.$27
FCLEXER.NUMBER_TOKEN.$28:
;  193        if (line(at:at) == 'e' .or. line(at:at) == 'E') then
	MOVL	FCLEXER.NUMBER_TOKEN.LINE(AP),R0
	SUBL3	#1,@FCLEXER.NUMBER_TOKEN.AT(AP),R1
	MOVB	@4(R0)[R1],R6
	CMPB	R6,#101
	BEQL	FCLEXER.NUMBER_TOKEN.$30
	CMPB	R6,#69
	BEQL	FCLEXER.NUMBER_TOKEN.$32
	BRW	FCLEXER.NUMBER_TOKEN.$29
FCLEXER.NUMBER_TOKEN.$32:
FCLEXER.NUMBER_TOKEN.$30:
;  194          k = at + 1
	ADDL3	@FCLEXER.NUMBER_TOKEN.AT(AP),#1,FCLEXER.NUMBER_TOKEN.K
;  195          if (k <= len(line)) then
	MOVZWL	@FCLEXER.NUMBER_TOKEN.LINE(AP),R0
	CMPL	FCLEXER.NUMBER_TOKEN.K,R0
	BGTR	FCLEXER.NUMBER_TOKEN.$33
;  196            if (line(k:k) == '+' .or. line(k:k) == '-') k = k + 1
	MOVL	FCLEXER.NUMBER_TOKEN.LINE(AP),R0
	SUBL3	#1,FCLEXER.NUMBER_TOKEN.K,R1
	MOVB	@4(R0)[R1],R6
	CMPB	R6,#43
	BEQL	FCLEXER.NUMBER_TOKEN.$36
	CMPB	R6,#45
	BNEQ	FCLEXER.NUMBER_TOKEN.$35
FCLEXER.NUMBER_TOKEN.$36:
	INCL	FCLEXER.NUMBER_TOKEN.K
FCLEXER.NUMBER_TOKEN.$35:
;  197          end if
FCLEXER.NUMBER_TOKEN.$33:
;  198          if (next_is_digit(line, k)) then
	PUSHAL	FCLEXER.NUMBER_TOKEN.K
	PUSHL	FCLEXER.NUMBER_TOKEN.LINE(AP)
	CALLS	#2,G^FCLEXER.NEXT_IS_DIGIT
	MOVL	R0,R6
	BLBS	R6,FCLEXER.NUMBER_TOKEN.$40
	BRW	FCLEXER.NUMBER_TOKEN.$39
FCLEXER.NUMBER_TOKEN.$40:
;  199            do while (next_is_digit(line, k))
	MOVL	FCLEXER.NUMBER_TOKEN.POWER,R7
	MOVL	FCLEXER.NUMBER_TOKEN.LINE(AP),R8
	BRB	FCLEXER.NUMBER_TOKEN.$41
FCLEXER.NUMBER_TOKEN.$42:		; DO (line 199)'s body
;  200              if (power < 100000) power = power * 10 + index(digit_set, line(k:k)) - 1
	CMPL	R7,#100000
	BGEQ	FCLEXER.NUMBER_TOKEN.$43
	SUBL3	#1,FCLEXER.NUMBER_TOKEN.K,R0
	MATCHC	#1,@4(R8)[R0],#10,FCLEXER.NUMBER_TOKEN.$K1
	BNEQ	FCLEXER.NUMBER_TOKEN.$45
	SUBL3	R2,#10,R0
	BRB	FCLEXER.NUMBER_TOKEN.$46
FCLEXER.NUMBER_TOKEN.$45:
	CLRL	R0
FCLEXER.NUMBER_TOKEN.$46:
	MOVL	R0,R6
	MULL3	R7,#10,R0
	ADDL2	R6,R0
	SUBL3	#1,R0,R7
FCLEXER.NUMBER_TOKEN.$43:
;  201              k = k + 1
	INCL	FCLEXER.NUMBER_TOKEN.K
;  202            end do
FCLEXER.NUMBER_TOKEN.$41:		; DO (line 199)'s test
	PUSHAL	FCLEXER.NUMBER_TOKEN.K	; from line 199
	PUSHL	FCLEXER.NUMBER_TOKEN.LINE(AP)
	CALLS	#2,G^FCLEXER.NEXT_IS_DIGIT
	MOVL	R0,R6
	BLBS	R6,FCLEXER.NUMBER_TOKEN.$42
	MOVL	R7,FCLEXER.NUMBER_TOKEN.POWER
;  203            if (line(at + 1:at + 1) == '-') power = -power
	MOVL	FCLEXER.NUMBER_TOKEN.LINE(AP),R0
	MOVL	@FCLEXER.NUMBER_TOKEN.AT(AP),R1
	CMPB	@4(R0)[R1],#45
	BNEQ	FCLEXER.NUMBER_TOKEN.$48
	MNEGL	FCLEXER.NUMBER_TOKEN.POWER,FCLEXER.NUMBER_TOKEN.POWER
FCLEXER.NUMBER_TOKEN.$48:
;  204            at = k
	MOVL	FCLEXER.NUMBER_TOKEN.K,@FCLEXER.NUMBER_TOKEN.AT(AP)
;  205          end if
FCLEXER.NUMBER_TOKEN.$39:
;  206        end if
FCLEXER.NUMBER_TOKEN.$29:
;  207      end if
FCLEXER.NUMBER_TOKEN.$27:
;  208
;  209      t%kind = t_number
	MOVL	#1,@FCLEXER.NUMBER_TOKEN.T(AP)
;  210      t%text = ' '
	MOVL	FCLEXER.NUMBER_TOKEN.T(AP),R0
	MOVC5	#1,FCLEXER.NUMBER_TOKEN.$K7,#^A/ /,#31,8(R0)
;  211      if (seen) then
	BLBS	FCLEXER.NUMBER_TOKEN.SEEN,FCLEXER.NUMBER_TOKEN.$51
	BRW	FCLEXER.NUMBER_TOKEN.$50
FCLEXER.NUMBER_TOKEN.$51:
;  212        if (lead + power > 300) then
	ADDL3	FCLEXER.NUMBER_TOKEN.LEAD,FCLEXER.NUMBER_TOKEN.POWER,R0
	CMPL	R0,#300
	BLEQ	FCLEXER.NUMBER_TOKEN.$52
;  213          call fail(e_overflow, first)
	PUSHL	#0
	PUSHAL	FCLEXER.NUMBER_TOKEN.FIRST
	PUSHAL	FCLEXER.NUMBER_TOKEN.$K8
	CALLS	#3,G^FCMESSAGES.FAIL
;  214          return
	RET
FCLEXER.NUMBER_TOKEN.$52:
;  215        end if
;  216        if (lead + power >= -301) then
	ADDL3	FCLEXER.NUMBER_TOKEN.LEAD,FCLEXER.NUMBER_TOKEN.POWER,R0
	CMPL	R0,#-301
	BGEQ	FCLEXER.NUMBER_TOKEN.$55
	BRW	FCLEXER.NUMBER_TOKEN.$54
FCLEXER.NUMBER_TOKEN.$55:
;  217          read (line(first:at - 1), *, iostat=ios) t%number
	SUBL3	FCLEXER.NUMBER_TOKEN.FIRST,@FCLEXER.NUMBER_TOKEN.AT(AP),R6
	BGEQ	FCLEXER.NUMBER_TOKEN.$56
	CLRL	R6
FCLEXER.NUMBER_TOKEN.$56:
	CVTLW	R6,FCLEXER.NUMBER_TOKEN.$D1
	MOVL	FCLEXER.NUMBER_TOKEN.LINE(AP),R0
	SUBL3	#1,FCLEXER.NUMBER_TOKEN.FIRST,R1
	MOVAB	@4(R0)[R1],FCLEXER.NUMBER_TOKEN.$D1+4
	PUSHAQ	FCLEXER.NUMBER_TOKEN.$D1
	PUSHAB	FCLEXER.NUMBER_TOKEN.$IO1
	CALLS	#2,G^FTN$READ_IL
	MOVL	FCLEXER.NUMBER_TOKEN.T(AP),R0
	MOVAG	40(R0),FCLEXER.NUMBER_TOKEN.$D2+4
	PUSHAQ	FCLEXER.NUMBER_TOKEN.$D2
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
	MOVL	R0,R6
	MOVL	R6,FCLEXER.NUMBER_TOKEN.IOS
;  218          if (ios /= 0) then
	BEQL	FCLEXER.NUMBER_TOKEN.$58
;  219            call fail(e_badnumber, first)
	PUSHL	#0
	PUSHAL	FCLEXER.NUMBER_TOKEN.FIRST
	PUSHAL	FCLEXER.NUMBER_TOKEN.$K9
	CALLS	#3,G^FCMESSAGES.FAIL
;  220            return
	RET
FCLEXER.NUMBER_TOKEN.$58:
;  221          end if
;  222          if (abs(t%number) > limit) then
	MOVL	FCLEXER.NUMBER_TOKEN.T(AP),R0
	MOVG	40(R0),R6
	BGEQ	FCLEXER.NUMBER_TOKEN.$60
	MNEGG	R6,R6
FCLEXER.NUMBER_TOKEN.$60:
	CMPG	R6,FCLEXER.NUMBER_TOKEN.$KF1
	BLEQ	FCLEXER.NUMBER_TOKEN.$62
;  223            call fail(e_overflow, first)
	PUSHL	#0
	PUSHAL	FCLEXER.NUMBER_TOKEN.FIRST
	PUSHAL	FCLEXER.NUMBER_TOKEN.$K8
	CALLS	#3,G^FCMESSAGES.FAIL
;  224            return
	RET
FCLEXER.NUMBER_TOKEN.$62:
;  225          end if
;  226          if (abs(t%number) < small) t%number = 0
	MOVL	FCLEXER.NUMBER_TOKEN.T(AP),R0
	MOVG	40(R0),R6
	BGEQ	FCLEXER.NUMBER_TOKEN.$64
	MNEGG	R6,R6
FCLEXER.NUMBER_TOKEN.$64:
	CMPG	R6,FCLEXER.NUMBER_TOKEN.$KF2
	BGEQ	FCLEXER.NUMBER_TOKEN.$66
	MOVL	FCLEXER.NUMBER_TOKEN.T(AP),R0
	CLRG	40(R0)
FCLEXER.NUMBER_TOKEN.$66:
;  227        end if
FCLEXER.NUMBER_TOKEN.$54:
;  228      end if
FCLEXER.NUMBER_TOKEN.$50:
;  229
;  230      ! An i makes the number imaginary, unless it starts a name.
;  231      if (at <= len(line)) then
	MOVZWL	@FCLEXER.NUMBER_TOKEN.LINE(AP),R0
	CMPL	@FCLEXER.NUMBER_TOKEN.AT(AP),R0
	BLEQ	FCLEXER.NUMBER_TOKEN.$69
	RET
FCLEXER.NUMBER_TOKEN.$69:
;  232        if (line(at:at) == 'i' .or. line(at:at) == 'I') then
	MOVL	FCLEXER.NUMBER_TOKEN.LINE(AP),R0
	SUBL3	#1,@FCLEXER.NUMBER_TOKEN.AT(AP),R1
	MOVB	@4(R0)[R1],R6
	CMPB	R6,#105
	BEQL	FCLEXER.NUMBER_TOKEN.$71
	CMPB	R6,#73
	BNEQ	FCLEXER.NUMBER_TOKEN.$70
FCLEXER.NUMBER_TOKEN.$71:
;  233          k = at + 1
	ADDL3	@FCLEXER.NUMBER_TOKEN.AT(AP),#1,FCLEXER.NUMBER_TOKEN.K
;  234          if (k > len(line)) then
	MOVZWL	@FCLEXER.NUMBER_TOKEN.LINE(AP),R0
	CMPL	FCLEXER.NUMBER_TOKEN.K,R0
	BLEQ	FCLEXER.NUMBER_TOKEN.$74
;  235            t%imaginary = .true.
	MOVL	FCLEXER.NUMBER_TOKEN.T(AP),R0
	MOVL	#-1,48(R0)
;  236          else if (index(name_set, line(k:k)) == 0) then
	BRB	FCLEXER.NUMBER_TOKEN.$76
FCLEXER.NUMBER_TOKEN.$74:
	MOVL	FCLEXER.NUMBER_TOKEN.LINE(AP),R0
	SUBL3	#1,FCLEXER.NUMBER_TOKEN.K,R1
	MATCHC	#1,@4(R0)[R1],#64,FCLEXER.NUMBER_TOKEN.$K12
	BNEQ	FCLEXER.NUMBER_TOKEN.$77
	SUBL3	R2,#64,R0
	BRB	FCLEXER.NUMBER_TOKEN.$78
FCLEXER.NUMBER_TOKEN.$77:
	CLRL	R0
FCLEXER.NUMBER_TOKEN.$78:
	MOVL	R0,R6
	BNEQ	FCLEXER.NUMBER_TOKEN.$76
;  237            t%imaginary = .true.
	MOVL	FCLEXER.NUMBER_TOKEN.T(AP),R0
	MOVL	#-1,48(R0)
;  238          end if
FCLEXER.NUMBER_TOKEN.$76:
;  239          if (t%imaginary) at = at + 1
	MOVL	FCLEXER.NUMBER_TOKEN.T(AP),R0
	BLBC	48(R0),FCLEXER.NUMBER_TOKEN.$80
	INCL	@FCLEXER.NUMBER_TOKEN.AT(AP)
FCLEXER.NUMBER_TOKEN.$80:
;  240        end if
FCLEXER.NUMBER_TOKEN.$70:
;  241      end if
;  242    end subroutine number_token
	RET
FCLEXER.NUMBER_TOKEN.$21:		; leaving the loop
	MOVL	R7,FCLEXER.NUMBER_TOKEN.LEAD
	MOVL	R9,FCLEXER.NUMBER_TOKEN.POINT
	MOVL	R11,FCLEXER.NUMBER_TOKEN.SEEN
	BRW	FCLEXER.NUMBER_TOKEN.$25

; Storage map for FCLEXER.BASED_NUMBER, a LOGICAL function
;   LINE          CHARACTER*(*), INTENT(IN)   argument 1  @FCLEXER.BASED_NUMBER.LINE(AP)
;   AT            INTEGER, INTENT(INOUT)      argument 2  @FCLEXER.BASED_NUMBER.AT(AP)
;   T             TYPE(TOKEN), INTENT(INOUT)  argument 3  @FCLEXER.BASED_NUMBER.T(AP)
;   BASED_NUMBER  LOGICAL                     $LOCAL+0    FCLEXER.BASED_NUMBER.$N1
;   RBASE         INTEGER                     $LOCAL+4    FCLEXER.BASED_NUMBER.RBASE
;   K             INTEGER                     $LOCAL+8    FCLEXER.BASED_NUMBER.K
;   FIRST         INTEGER                     $LOCAL+12   FCLEXER.BASED_NUMBER.FIRST
;   C             INTEGER                     $LOCAL+16   FCLEXER.BASED_NUMBER.C
;   X             REAL*8                      $LOCAL+20   FCLEXER.BASED_NUMBER.X
;   R6 is $T1: temporary
;   R7 is $T2: temporary
;   R6 is $R1: K, during a loop
;   R7 is $R2: C, during a loop
;   R8 is $R3: LINE's address
;   R9 is $R4: X, during a loop
;   FCLEXER.BASED_NUMBER.$N1 is FCLEXER.BASED_NUMBER.BASED_NUMBER
;
FCLEXER.BASED_NUMBER.LINE = 4		; LINE is argument 1
FCLEXER.BASED_NUMBER.AT = 8		; AT is argument 2
FCLEXER.BASED_NUMBER.T = 12		; T is argument 3

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCLEXER.BASED_NUMBER.$N1:
