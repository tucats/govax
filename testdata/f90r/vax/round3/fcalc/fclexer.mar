FCLEXER.BASED_NUMBER.RBASE:
	.BLKL	1			; RBASE
FCLEXER.BASED_NUMBER.K:
	.BLKL	1			; K
FCLEXER.BASED_NUMBER.FIRST:
	.BLKL	1			; FIRST
FCLEXER.BASED_NUMBER.C:
	.BLKL	1			; C
FCLEXER.BASED_NUMBER.X:
	.BLKL	2			; X
FCLEXER.BASED_NUMBER.$D1:
	.WORD	1			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used
FCLEXER.BASED_NUMBER.$H1:
	.BLKL	1			; a value computed before a loop
FCLEXER.BASED_NUMBER.$U1:
	.BLKB	1			; temporary
	.BLKB	3
FCLEXER.BASED_NUMBER.$X1:
	.BLKL	2			; a part of an expression, set aside

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCLEXER.BASED_NUMBER.$K8:
	.LONG	10
FCLEXER.BASED_NUMBER.$K12:
	.LONG	2
FCLEXER.BASED_NUMBER.$KF1:
	.LONG	^X6BF5434C,^X00002634	; 4D15
FCLEXER.BASED_NUMBER.$K2:
	.ASCII	/x/
FCLEXER.BASED_NUMBER.$K3:
	.ASCII	/X/
FCLEXER.BASED_NUMBER.$K4:
	.ASCII	/o/
FCLEXER.BASED_NUMBER.$K5:
	.ASCII	/O/
FCLEXER.BASED_NUMBER.$K6:
	.ASCII	/b/
FCLEXER.BASED_NUMBER.$K7:
	.ASCII	/B/
FCLEXER.BASED_NUMBER.$K11:
	.ASCII	/abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_$/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  243
;  244    ! BASED_NUMBER takes a whole number in another base, if LINE(AT:) starts
;  245    ! with one: 0x and hexadecimal digits, 0o and octal ones, or 0b and binary
;  246    ! ones (the prefix's letter in either case, as the digits A to F are), as
;  247    ! fcalc shows whole numbers under SET BASE. An i after it makes it
;  248    ! imaginary, as after any number. The value is added up a digit at a time
;  249    ! in REAL(RK), exact for whole numbers below WHOLE_LIMIT; a larger one is
;  250    ! an overflow, and a letter or digit run on after the digits (0b102) makes
;  251    ! the number invalid. The result is false, and nothing taken, if LINE(AT:)
;  252    ! isn't such a number: 0 followed by anything else is an ordinary number.
;  253    logical function based_number(line, at, t)
	.ENTRY	FCLEXER.BASED_NUMBER,^M<R2,R3,R6,R7,R8,R9,R10>
;  254      character(len=*), intent(in) :: line
;  255      integer, intent(inout) :: at
;  256      type(token), intent(inout) :: t
;  257      character(len=*), parameter :: hex = '0123456789abcdef'
;  258      integer :: rbase, k, first, c
;  259      real(rk) :: x
;  260
;  261      based_number = .false.
	CLRL	FCLEXER.BASED_NUMBER.$N1
;  262      if (at + 2 > len(line)) return
	ADDL3	@FCLEXER.BASED_NUMBER.AT(AP),#2,R0
	MOVZWL	@FCLEXER.BASED_NUMBER.LINE(AP),R1
	CMPL	R0,R1
	BLEQ	FCLEXER.BASED_NUMBER.$1
	CLRL	R0			; the function's value
	RET
FCLEXER.BASED_NUMBER.$1:
;  263      if (line(at:at) /= '0') return
	MOVL	FCLEXER.BASED_NUMBER.LINE(AP),R0
	SUBL3	#1,@FCLEXER.BASED_NUMBER.AT(AP),R1
	CMPB	@4(R0)[R1],#48
	BEQL	FCLEXER.BASED_NUMBER.$3
	CLRL	R0			; the function's value
	RET
FCLEXER.BASED_NUMBER.$3:
;  264      select case (line(at + 1:at + 1))
	MOVL	FCLEXER.BASED_NUMBER.LINE(AP),R0
	MOVL	@FCLEXER.BASED_NUMBER.AT(AP),R1
	MOVAB	@4(R0)[R1],R6
	MOVL	#1,R7
	CMPC3	#1,(R6),FCLEXER.BASED_NUMBER.$K2
	BEQL	FCLEXER.BASED_NUMBER.$5
	CMPC3	#1,(R6),FCLEXER.BASED_NUMBER.$K3
	BEQL	FCLEXER.BASED_NUMBER.$5
	CMPC3	#1,(R6),FCLEXER.BASED_NUMBER.$K4
	BEQL	FCLEXER.BASED_NUMBER.$8
	CMPC3	#1,(R6),FCLEXER.BASED_NUMBER.$K5
	BEQL	FCLEXER.BASED_NUMBER.$8
	CMPC3	#1,(R6),FCLEXER.BASED_NUMBER.$K6
	BEQL	FCLEXER.BASED_NUMBER.$11
	CMPC3	#1,(R6),FCLEXER.BASED_NUMBER.$K7
	BNEQ	FCLEXER.BASED_NUMBER.$14
	BRB	FCLEXER.BASED_NUMBER.$11
FCLEXER.BASED_NUMBER.$5:
;  265      case ('x', 'X')
;  266        rbase = 16
	MOVL	#16,FCLEXER.BASED_NUMBER.RBASE
;  267      case ('o', 'O')
	BRB	FCLEXER.BASED_NUMBER.$15
FCLEXER.BASED_NUMBER.$8:
;  268        rbase = 8
	MOVL	#8,FCLEXER.BASED_NUMBER.RBASE
;  269      case ('b', 'B')
	BRB	FCLEXER.BASED_NUMBER.$15
FCLEXER.BASED_NUMBER.$11:
;  270        rbase = 2
	MOVL	#2,FCLEXER.BASED_NUMBER.RBASE
;  271      case default
	BRB	FCLEXER.BASED_NUMBER.$15
FCLEXER.BASED_NUMBER.$14:
;  272        return
	CLRL	R0			; the function's value
	RET
FCLEXER.BASED_NUMBER.$15:
;  273      end select
;  274      if (digit_of(line(at + 2:at + 2)) < 0) return
	MOVL	FCLEXER.BASED_NUMBER.LINE(AP),R0
	ADDL3	@FCLEXER.BASED_NUMBER.AT(AP),#1,R1
	MOVAB	@4(R0)[R1],FCLEXER.BASED_NUMBER.$D1+4
	PUSHAQ	FCLEXER.BASED_NUMBER.$D1
	CALLS	#1,FCLEXER.BASED_NUMBER.DIGIT_OF
	MOVL	R0,R7
	BGEQ	FCLEXER.BASED_NUMBER.$16
	CLRL	R0			; the function's value
	RET
FCLEXER.BASED_NUMBER.$16:
;  275
;  276      based_number = .true.
;  277      first = at
	MOVL	@FCLEXER.BASED_NUMBER.AT(AP),FCLEXER.BASED_NUMBER.FIRST
;  278      t%kind = t_number
	MOVL	#1,@FCLEXER.BASED_NUMBER.T(AP)
;  279      x = 0
	CLRG	FCLEXER.BASED_NUMBER.X
;  280      k = at + 2
	ADDL3	@FCLEXER.BASED_NUMBER.AT(AP),#2,FCLEXER.BASED_NUMBER.K
;  281      do while (k <= len(line))
	MOVZWL	@FCLEXER.BASED_NUMBER.LINE(AP),FCLEXER.BASED_NUMBER.$H1 ; from line 281
	MOVL	FCLEXER.BASED_NUMBER.K,R6
	MOVL	FCLEXER.BASED_NUMBER.C,R7
	MOVL	FCLEXER.BASED_NUMBER.LINE(AP),R8
	MOVQ	FCLEXER.BASED_NUMBER.X,R9
	BRW	FCLEXER.BASED_NUMBER.$18
FCLEXER.BASED_NUMBER.$19:		; DO (line 281)'s body
;  282        c = digit_of(line(k:k))
	SUBL3	#1,R6,R0
	MOVAB	@4(R8)[R0],FCLEXER.BASED_NUMBER.$D1+4
	PUSHAQ	FCLEXER.BASED_NUMBER.$D1
	CALLS	#1,FCLEXER.BASED_NUMBER.DIGIT_OF
	MOVL	R0,R7
;  283        if (c < 0) exit
	BGEQ	FCLEXER.BASED_NUMBER.$21
	BRW	FCLEXER.BASED_NUMBER.$20
FCLEXER.BASED_NUMBER.$21:
;  284        ! The test before the product: X * RBASE + C stays below WHOLE_LIMIT.
;  285        if (x >= (whole_limit - c) / rbase) then
	CVTLG	R7,R0
	SUBG3	R0,FCLEXER.BASED_NUMBER.$KF1,R0
	CVTLG	FCLEXER.BASED_NUMBER.RBASE,R2
	DIVG3	R2,R0,FCLEXER.BASED_NUMBER.$X1
	CMPG	R9,FCLEXER.BASED_NUMBER.$X1
	BLSS	FCLEXER.BASED_NUMBER.$22
	MOVL	R6,FCLEXER.BASED_NUMBER.K
	MOVL	R7,FCLEXER.BASED_NUMBER.C
	MOVQ	R9,FCLEXER.BASED_NUMBER.X
;  286          call fail(e_overflow, first)
	PUSHL	#0
	PUSHAL	FCLEXER.BASED_NUMBER.FIRST
	PUSHAL	FCLEXER.BASED_NUMBER.$K8
	CALLS	#3,G^FCMESSAGES.FAIL
;  287          return
	MOVL	#-1,R0			; the function's value
	RET
FCLEXER.BASED_NUMBER.$22:
;  288        end if
;  289        x = x * rbase + c
	CVTLG	FCLEXER.BASED_NUMBER.RBASE,R0
	MULG2	R9,R0
	CVTLG	R7,R2
	ADDG3	R0,R2,R9
;  290        k = k + 1
	INCL	R6
;  291      end do
FCLEXER.BASED_NUMBER.$18:		; DO (line 281)'s test
	CMPL	R6,FCLEXER.BASED_NUMBER.$H1 ; from line 281
	BGTR	FCLEXER.BASED_NUMBER.$24
	BRW	FCLEXER.BASED_NUMBER.$19
FCLEXER.BASED_NUMBER.$24:
	MOVL	R6,FCLEXER.BASED_NUMBER.K
	MOVL	R7,FCLEXER.BASED_NUMBER.C
	MOVQ	R9,FCLEXER.BASED_NUMBER.X
FCLEXER.BASED_NUMBER.$25:
;  292      at = k
	MOVL	FCLEXER.BASED_NUMBER.K,@FCLEXER.BASED_NUMBER.AT(AP)
;  293      t%number = x
	MOVL	FCLEXER.BASED_NUMBER.T(AP),R0
	MOVG	FCLEXER.BASED_NUMBER.X,40(R0)
;  294
;  295      ! An i makes it imaginary, unless more of a name follows; anything else
;  296      ! of a name's characters run on is an error.
;  297      if (at <= len(line)) then
	MOVZWL	@FCLEXER.BASED_NUMBER.LINE(AP),R0
	CMPL	@FCLEXER.BASED_NUMBER.AT(AP),R0
	BLEQ	FCLEXER.BASED_NUMBER.$27
	BRW	FCLEXER.BASED_NUMBER.$26
FCLEXER.BASED_NUMBER.$27:
;  298        if (line(at:at) == 'i' .or. line(at:at) == 'I') then
	MOVL	FCLEXER.BASED_NUMBER.LINE(AP),R0
	SUBL3	#1,@FCLEXER.BASED_NUMBER.AT(AP),R1
	MOVB	@4(R0)[R1],FCLEXER.BASED_NUMBER.$U1
	CMPB	FCLEXER.BASED_NUMBER.$U1,#105
	BEQL	FCLEXER.BASED_NUMBER.$29
	CMPB	FCLEXER.BASED_NUMBER.$U1,#73
	BNEQ	FCLEXER.BASED_NUMBER.$28
FCLEXER.BASED_NUMBER.$29:
;  299          if (at == len(line)) then
	MOVZWL	@FCLEXER.BASED_NUMBER.LINE(AP),R0
	CMPL	@FCLEXER.BASED_NUMBER.AT(AP),R0
	BNEQ	FCLEXER.BASED_NUMBER.$32
;  300            t%imaginary = .true.
	MOVL	FCLEXER.BASED_NUMBER.T(AP),R0
	MOVL	#-1,48(R0)
;  301          else if (index(name_set, line(at + 1:at + 1)) == 0) then
	BRB	FCLEXER.BASED_NUMBER.$34
FCLEXER.BASED_NUMBER.$32:
	MOVL	FCLEXER.BASED_NUMBER.LINE(AP),R0
	MOVL	@FCLEXER.BASED_NUMBER.AT(AP),R1
	MATCHC	#1,@4(R0)[R1],#64,FCLEXER.BASED_NUMBER.$K11
	BNEQ	FCLEXER.BASED_NUMBER.$35
	SUBL3	R2,#64,R0
	BRB	FCLEXER.BASED_NUMBER.$36
FCLEXER.BASED_NUMBER.$35:
	CLRL	R0
FCLEXER.BASED_NUMBER.$36:
	MOVL	R0,R7
	BNEQ	FCLEXER.BASED_NUMBER.$34
;  302            t%imaginary = .true.
	MOVL	FCLEXER.BASED_NUMBER.T(AP),R0
	MOVL	#-1,48(R0)
;  303          end if
FCLEXER.BASED_NUMBER.$34:
;  304          if (t%imaginary) at = at + 1
	MOVL	FCLEXER.BASED_NUMBER.T(AP),R0
	BLBC	48(R0),FCLEXER.BASED_NUMBER.$38
	INCL	@FCLEXER.BASED_NUMBER.AT(AP)
FCLEXER.BASED_NUMBER.$38:
;  305        end if
FCLEXER.BASED_NUMBER.$28:
;  306      end if
FCLEXER.BASED_NUMBER.$26:
;  307      if (at <= len(line)) then
	MOVZWL	@FCLEXER.BASED_NUMBER.LINE(AP),R0
	CMPL	@FCLEXER.BASED_NUMBER.AT(AP),R0
	BGTR	FCLEXER.BASED_NUMBER.$40
;  308        if (index(name_set, line(at:at)) > 0) call fail(e_badnumber, first)
	MOVL	FCLEXER.BASED_NUMBER.LINE(AP),R0
	SUBL3	#1,@FCLEXER.BASED_NUMBER.AT(AP),R1
	MATCHC	#1,@4(R0)[R1],#64,FCLEXER.BASED_NUMBER.$K11
	BNEQ	FCLEXER.BASED_NUMBER.$42
	SUBL3	R2,#64,R0
	BRB	FCLEXER.BASED_NUMBER.$43
FCLEXER.BASED_NUMBER.$42:
	CLRL	R0
FCLEXER.BASED_NUMBER.$43:
	MOVL	R0,R7
	BLEQ	FCLEXER.BASED_NUMBER.$44
	PUSHL	#0
	PUSHAL	FCLEXER.BASED_NUMBER.FIRST
	PUSHAL	FCLEXER.BASED_NUMBER.$K12
	CALLS	#3,G^FCMESSAGES.FAIL
FCLEXER.BASED_NUMBER.$44:
;  309      end if
FCLEXER.BASED_NUMBER.$40:
;  310
;  311    contains
	MOVL	#-1,R0			; the function's value
	RET
FCLEXER.BASED_NUMBER.$20:		; leaving the loop
	MOVL	R6,FCLEXER.BASED_NUMBER.K
	MOVL	R7,FCLEXER.BASED_NUMBER.C
	MOVQ	R9,FCLEXER.BASED_NUMBER.X
	BRW	FCLEXER.BASED_NUMBER.$25

; Storage map for FCLEXER.BASED_NUMBER.DIGIT_OF, an INTEGER function
;   CH        CHARACTER*1, INTENT(IN)  argument 1  @FCLEXER.BASED_NUMBER.DIGIT_.$N2(AP)
;   DIGIT_OF  INTEGER                  R6          R6
;   LOW       CHARACTER*1              $LOCAL+4    FCLEXER.BASED_NUMBER.DIGIT_.$N3
;   CODE      INTEGER                  $LOCAL+8    FCLEXER.BASED_NUMBER.DIGIT_.$N4
;   FCLEXER.BASED_NUMBER.DIGIT_.$N2 is FCLEXER.BASED_NUMBER.DIGIT_OF.CH
;   FCLEXER.BASED_NUMBER.DIGIT_.$N3 is FCLEXER.BASED_NUMBER.DIGIT_OF.LOW
;   FCLEXER.BASED_NUMBER.DIGIT_.$N4 is FCLEXER.BASED_NUMBER.DIGIT_OF.CODE
;   FCLEXER.BASED_NUMBER.DIGIT_.$N5 is FCLEXER.BASED_NUMBER.DIGIT_OF.$1
;   FCLEXER.BASED_NUMBER.DIGIT_.$N6 is FCLEXER.BASED_NUMBER.DIGIT_OF.$2
;   FCLEXER.BASED_NUMBER.DIGIT_.$N7 is FCLEXER.BASED_NUMBER.DIGIT_OF.$3
;   FCLEXER.BASED_NUMBER.DIGIT_.$N8 is FCLEXER.BASED_NUMBER.DIGIT_OF.$T1
;   FCLEXER.BASED_NUMBER.DIGIT_.$N9 is FCLEXER.BASED_NUMBER.DIGIT_OF.$K1
;   FCLEXER.BASED_NUMBER.DIGIT.$N10 is FCLEXER.BASED_NUMBER.DIGIT_OF.$4
;   FCLEXER.BASED_NUMBER.DIGIT.$N11 is FCLEXER.BASED_NUMBER.DIGIT_OF.$5
;   FCLEXER.BASED_NUMBER.DIGIT.$N12 is FCLEXER.BASED_NUMBER.DIGIT_OF.$T2
;   FCLEXER.BASED_NUMBER.DIGIT.$N13 is FCLEXER.BASED_NUMBER.DIGIT_OF.$6
;   FCLEXER.BASED_NUMBER.DIGIT.$N14 is FCLEXER.BASED_NUMBER.DIGIT_OF.$7
;
FCLEXER.BASED_NUMBER.DIGIT_.$N2 = 4	; CH is argument 1

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
	.BLKB	4
FCLEXER.BASED_NUMBER.DIGIT_.$N3:
	.BLKB	1			; LOW
	.BLKB	3
FCLEXER.BASED_NUMBER.DIGIT_.$N4:
	.BLKL	1			; CODE
FCLEXER.BASED_NUMBER.DIGIT_.$N8:
	.BLKB	1			; temporary
	.BLKB	3
FCLEXER.BASED_NUMBER.DIGIT.$N12:
	.BLKL	1			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCLEXER.BASED_NUMBER.DIGIT_.$N9:
	.ASCII	/0123456789abcdef/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  312
;  313      ! DIGIT_OF is the digit CH stands for in RBASE, the base, or -1 if it isn't one.
;  314      ! A capital letter is lowered first, by its ASCII code, as NAME_TOKEN
;  315      ! lowers a name.
;  316      integer function digit_of(ch)
FCLEXER.BASED_NUMBER.DIGIT_OF:
	.WORD	^M<R2,R3,R6>		; internal procedure DIGIT_OF of FCLEXER.BASED_NUMBER
;  317        character(len=1), intent(in) :: ch
;  318        character(len=1) :: low
;  319        integer :: code
;  320
;  321        low = ch
	MOVL	FCLEXER.BASED_NUMBER.DIGIT_.$N2(AP),R0
	MOVB	@4(R0),FCLEXER.BASED_NUMBER.DIGIT_.$N3
;  322        code = iachar(ch)
	MOVZBL	FCLEXER.BASED_NUMBER.DIGIT_.$N3,FCLEXER.BASED_NUMBER.DIGIT_.$N4
;  323        if (code >= iachar('A') .and. code <= iachar('Z')) &
;  324          low = achar(code - iachar('A') + iachar('a'))
	CMPL	FCLEXER.BASED_NUMBER.DIGIT_.$N4,#65
	BLSS	FCLEXER.BASED_NUMBER.DIGIT_.$N5
	CMPL	FCLEXER.BASED_NUMBER.DIGIT_.$N4,#90
	BGTR	FCLEXER.BASED_NUMBER.DIGIT_.$N5
	ADDL3	FCLEXER.BASED_NUMBER.DIGIT_.$N4,#32,R0
	MOVB	R0,FCLEXER.BASED_NUMBER.DIGIT_.$N8
	MOVB	FCLEXER.BASED_NUMBER.DIGIT_.$N8,FCLEXER.BASED_NUMBER.DIGIT_.$N3
FCLEXER.BASED_NUMBER.DIGIT_.$N5:
;  325        digit_of = index(hex, low) - 1
	MATCHC	#1,FCLEXER.BASED_NUMBER.DIGIT_.$N3,#16,FCLEXER.BASED_NUMBER.DIGIT_.$N9
	BNEQ	FCLEXER.BASED_NUMBER.DIGIT.$N10
	SUBL3	R2,#16,R0
	BRB	FCLEXER.BASED_NUMBER.DIGIT.$N11
FCLEXER.BASED_NUMBER.DIGIT.$N10:
	CLRL	R0
FCLEXER.BASED_NUMBER.DIGIT.$N11:
	MOVL	R0,FCLEXER.BASED_NUMBER.DIGIT.$N12
	SUBL3	#1,FCLEXER.BASED_NUMBER.DIGIT.$N12,R6
;  326        if (digit_of >= rbase) digit_of = -1
	CMPL	R6,FCLEXER.BASED_NUMBER.RBASE
	BLSS	FCLEXER.BASED_NUMBER.DIGIT.$N13
	MOVL	#-1,R6
FCLEXER.BASED_NUMBER.DIGIT.$N13:
;  327      end function digit_of
	MOVL	R6,R0			; the function's value
	RET

; Storage map for FCLEXER.OPERATOR_TOKEN, a subroutine
;   LINE  CHARACTER*(*), INTENT(IN)   argument 1  @FCLEXER.OPERATOR_TOKEN.LINE(AP)
;   AT    INTEGER, INTENT(INOUT)      argument 2  @FCLEXER.OPERATOR_TOKEN.AT(AP)
;   T     TYPE(TOKEN), INTENT(INOUT)  argument 3  @FCLEXER.OPERATOR_TOKEN.T(AP)
;   K     INTEGER                     $LOCAL+0    FCLEXER.OPERATOR_TOKEN.K
;   R7 is $H1: a value computed before a loop
;   R8 is $R1: an index stepped with K
;   R10 is $R2: an address in an array
;   R6 is $R3: K, during a loop
;   R9 is $R4: LINE's address
;
FCLEXER.OPERATOR_TOKEN.LINE = 4		; LINE is argument 1
FCLEXER.OPERATOR_TOKEN.AT = 8		; AT is argument 2
FCLEXER.OPERATOR_TOKEN.T = 12		; T is argument 3

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCLEXER.OPERATOR_TOKEN.K:
	.BLKL	1			; K
FCLEXER.OPERATOR_TOKEN.$T1:
	.BLKL	1			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCLEXER.OPERATOR_TOKEN.$K5:
	.LONG	1
FCLEXER.OPERATOR_TOKEN.$K1:
	.ASCII	"==<><=>=**.*./.^.'"
FCLEXER.OPERATOR_TOKEN.$K2:
	.ASCII	/**/
FCLEXER.OPERATOR_TOKEN.$K3:
	.ASCII	/^/
FCLEXER.OPERATOR_TOKEN.$K4:
	.ASCII	"+-*/^!(),=<>[];:'\"

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  328    end function based_number
;  329
;  330    ! OPERATOR_TOKEN takes an operator, ** standing for ^.
;  331    subroutine operator_token(line, at, t)
	.ENTRY	FCLEXER.OPERATOR_TOKEN,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10>
;  332      character(len=*), intent(in) :: line
;  333      integer, intent(inout) :: at
;  334      type(token), intent(inout) :: t
;  335      integer :: k
;  336
;  337      t%kind = t_operator
	MOVL	#3,@FCLEXER.OPERATOR_TOKEN.T(AP)
;  338      if (at < len(line)) then
	MOVZWL	@FCLEXER.OPERATOR_TOKEN.LINE(AP),R0
	CMPL	@FCLEXER.OPERATOR_TOKEN.AT(AP),R0
	BLSS	FCLEXER.OPERATOR_TOKEN.$2
	BRW	FCLEXER.OPERATOR_TOKEN.$1
FCLEXER.OPERATOR_TOKEN.$2:
;  339        do k = 1, size(pairs)
	MOVL	#1,FCLEXER.OPERATOR_TOKEN.K
	MOVL	@FCLEXER.OPERATOR_TOKEN.AT(AP),R7 ; from line 340
	MULL3	FCLEXER.OPERATOR_TOKEN.K,#2,R8
	MOVL	FCLEXER.OPERATOR_TOKEN.LINE(AP),R0
	MOVL	4(R0),R10
	MOVL	FCLEXER.OPERATOR_TOKEN.K,R6
	MOVL	FCLEXER.OPERATOR_TOKEN.LINE(AP),R9
FCLEXER.OPERATOR_TOKEN.$3:		; DO (line 339)'s body
;  340          if (line(at:at + 1) == pairs(k)) then
	CMPC3	#2,-1(R10)[R7],FCLEXER.OPERATOR_TOKEN.$K1-2[R8]
	BNEQ	FCLEXER.OPERATOR_TOKEN.$4
	MOVL	R6,FCLEXER.OPERATOR_TOKEN.K
;  341            t%text = pairs(k)
	MULL3	FCLEXER.OPERATOR_TOKEN.K,#2,R0
	MOVL	FCLEXER.OPERATOR_TOKEN.T(AP),R1
	MOVC5	#2,FCLEXER.OPERATOR_TOKEN.$K1-2[R0],#^A/ /,#31,8(R1)
;  342            if (t%text == '**') t%text = '^'
	MOVL	FCLEXER.OPERATOR_TOKEN.T(AP),R0
	CMPC5	#31,8(R0),#^A/ /,#2,FCLEXER.OPERATOR_TOKEN.$K2
	BNEQ	FCLEXER.OPERATOR_TOKEN.$6
	MOVL	FCLEXER.OPERATOR_TOKEN.T(AP),R0
	MOVC5	#1,FCLEXER.OPERATOR_TOKEN.$K3,#^A/ /,#31,8(R0)
FCLEXER.OPERATOR_TOKEN.$6:
;  343            at = at + 2
	ADDL2	#2,@FCLEXER.OPERATOR_TOKEN.AT(AP)
;  344            return
	RET
FCLEXER.OPERATOR_TOKEN.$4:
;  345          end if
;  346        end do
	ADDL2	#2,R8
	AOBLEQ	#9,R6,FCLEXER.OPERATOR_TOKEN.$3
	MOVL	R6,FCLEXER.OPERATOR_TOKEN.K
;  347      end if
FCLEXER.OPERATOR_TOKEN.$1:
;  348
;  349      if (index(singles, line(at:at)) == 0) then
	MOVL	FCLEXER.OPERATOR_TOKEN.LINE(AP),R0
	SUBL3	#1,@FCLEXER.OPERATOR_TOKEN.AT(AP),R1
	MATCHC	#1,@4(R0)[R1],#18,FCLEXER.OPERATOR_TOKEN.$K4
	BNEQ	FCLEXER.OPERATOR_TOKEN.$9
	SUBL3	R2,#18,R0
	BRB	FCLEXER.OPERATOR_TOKEN.$10
FCLEXER.OPERATOR_TOKEN.$9:
	CLRL	R0
FCLEXER.OPERATOR_TOKEN.$10:
	MOVL	R0,FCLEXER.OPERATOR_TOKEN.$T1
	BNEQ	FCLEXER.OPERATOR_TOKEN.$11
;  350        call fail(e_badchar, at)
	PUSHL	#0
	PUSHAL	@FCLEXER.OPERATOR_TOKEN.AT(AP)
	PUSHAL	FCLEXER.OPERATOR_TOKEN.$K5
	CALLS	#3,G^FCMESSAGES.FAIL
;  351        return
	RET
FCLEXER.OPERATOR_TOKEN.$11:
;  352      end if
;  353      t%text = line(at:at)
	MOVL	FCLEXER.OPERATOR_TOKEN.LINE(AP),R0
	SUBL3	#1,@FCLEXER.OPERATOR_TOKEN.AT(AP),R1
	MOVL	FCLEXER.OPERATOR_TOKEN.T(AP),R2
	MOVC5	#1,@4(R0)[R1],#^A/ /,#31,8(R2)
;  354      at = at + 1
	INCL	@FCLEXER.OPERATOR_TOKEN.AT(AP)
;  355    end subroutine operator_token
	RET
;  356  end module fclexer

	.END
