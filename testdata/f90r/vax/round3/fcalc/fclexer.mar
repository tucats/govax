;    1  ! fcalc: the lexer, which turns a line into tokens.
;    2  !
;    3  ! A token is a number (its value, and whether it was written with an i, so
;    4  ! imaginary), a name (in lowercase: fcalc's names are case-insensitive, as
;    5  ! DCL's are), an operator, or the end of the line. Each knows the column it
;    6  ! started in, for an error's pointer.
;    7  !
;    8  ! A lexer (or scanner) is the first stage of reading a language: it groups
;    9  ! characters into tokens, so the parser (module FCTREE) deals in "the
;   10  ! number 2.5" and "the operator <=" rather than in characters. Fortran 90's
;   11  ! character intrinsics do most of the work here: INDEX(set, c) > 0 asks
;   12  ! whether the character C is in the string SET, VERIFY(text, set) finds the
;   13  ! first character of TEXT not in SET (0 if all are), and IACHAR and ACHAR
;   14  ! convert between a character and its ASCII code.
;   15  module fclexer
;   16    use fckinds
;   17    use fcmessages
;   18    implicit none
;   19    private
;   20
;   21    public :: token, tokenize, t_end, t_number, t_name, t_operator
;   22
;   23    integer, parameter :: t_end = 0, t_number = 1, t_name = 2, t_operator = 3
;   24
;   25    type token
;   26      integer :: kind
;   27      integer :: column
;   28      character(len=name_length) :: text
;   29      real(rk) :: number
;   30      logical :: imaginary
;   31    end type token
;   32
;   33    ! The characters, by kind.
;   34    character(len=*), parameter :: letters = &
;   35      'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'
;   36    character(len=*), parameter :: digit_set = '0123456789'
;   37    character(len=*), parameter :: name_set = letters // digit_set // '_$'
;   38    character(len=*), parameter :: blanks = ' ' // achar(9)
;   39
;   40    ! The operators of two characters, then those of one. The element by
;   41    ! element operators start with a period (.* ./ .^), and .' is the
;   42    ! transpose; ' alone is the conjugate transpose, and \ the solve.
;   43    ! "'" is a character constant of one apostrophe (Fortran 90 lets a
;   44    ! character constant be written in either kind of quotes), and ACHAR(92)
;   45    ! is a backslash, written so because some compilers take a backslash in
;   46    ! a character constant as the start of an escape, as C does.
;   47    character(len=2), parameter :: pairs(9) = (/ '==', '<>', '<=', '>=', '**', &
;   48      '.*', './', '.^', ".'" /)
;   49    character(len=*), parameter :: singles = '+-*/^!(),=<>[];:' // "'" // achar(92)
;   50
;   51  contains

