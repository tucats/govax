FCVALUES.FORMAT_REAL.$K1:
	.ASCII	/123456789/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  721
;  722    ! ------------------------------------------------------------------
;  723    ! Showing values.
;  724    !
;  725    ! How a number is shown depends on three settings: DIGITS (SET DIGITS),
;  726    ! NUMBER_FORMAT (SET FORMAT), and NUMBER_BASE (SET BASE). The formats are
;  727    ! a scientific calculator's:
;  728    !
;  729    !   AUTO         DIGITS significant digits, trailing zeros dropped, in
;  730    !                fixed notation from 1E-5 up to where the digits run out,
;  731    !                scientific outside that: 2, 0.125, 6.02214076e+23
;  732    !   FIXED        DIGITS places after the point, every one shown: 2.0000
;  733    !   SCIENTIFIC   DIGITS significant digits, one before the point, every
;  734    !                one shown: 2.00000000000e+0
;  735    !   ENGINEERING  as SCIENTIFIC, but the exponent a multiple of 3, so one to
;  736    !                three digits before the point: 12.3456789012e+3
;  737    !
;  738    ! A whole number (a real value, or both parts of a complex one) shown in
;  739    ! another base (SET BASE) is written with a prefix, 0x, 0o, or 0b, as
;  740    ! fcalc reads it back; any other value is shown in decimal.
;  741
;  742    ! FORMAT_REAL shows X by the format. A negative number is shown with its
;  743    ! minus sign, unless it shows as all zeros (FIXED's 0.0000).
;  744    function format_real(x) result(text)
	.ENTRY	FCVALUES.FORMAT_REAL,^M<R2,R3,R4,R5,R6,R7,R8>
;  745      real(rk), intent(in) :: x
;  746      character(len=32) :: text
;  747
;  748      select case (number_format)
	CMPL	FCVALUES.NUMBER_FORMAT,#2
	BEQL	FCVALUES.FORMAT_REAL.$1
	CMPL	FCVALUES.NUMBER_FORMAT,#3
	BEQL	FCVALUES.FORMAT_REAL.$3
	CMPL	FCVALUES.NUMBER_FORMAT,#4
	BEQL	FCVALUES.FORMAT_REAL.$5
	BRW	FCVALUES.FORMAT_REAL.$7
FCVALUES.FORMAT_REAL.$1:
;  749      case (f_fixed)
;  750        text = fixed_text(abs(x))
	MOVG	@FCVALUES.FORMAT_REAL.X(AP),FCVALUES.FORMAT_REAL.$T2
	BGEQ	FCVALUES.FORMAT_REAL.$8
	MNEGG	FCVALUES.FORMAT_REAL.$T2,FCVALUES.FORMAT_REAL.$T2
FCVALUES.FORMAT_REAL.$8:
	PUSHAG	FCVALUES.FORMAT_REAL.$T2
	PUSHAQ	FCVALUES.FORMAT_REAL.$D1
	CALLS	#2,G^FCVALUES.FIXED_TEXT
	MOVL	FCVALUES.FORMAT_REAL.TEXT(AP),R0
	MOVC3	#32,FCVALUES.FORMAT_REAL.$T1,@4(R0)
;  751      case (f_scientific)
	BRW	FCVALUES.FORMAT_REAL.$10
FCVALUES.FORMAT_REAL.$3:
;  752        text = scientific_text(abs(x), digits)
	MOVG	@FCVALUES.FORMAT_REAL.X(AP),FCVALUES.FORMAT_REAL.$T2
	BGEQ	FCVALUES.FORMAT_REAL.$11
	MNEGG	FCVALUES.FORMAT_REAL.$T2,FCVALUES.FORMAT_REAL.$T2
FCVALUES.FORMAT_REAL.$11:
	PUSHAL	FCVALUES.DIGITS
	PUSHAG	FCVALUES.FORMAT_REAL.$T2
	PUSHAQ	FCVALUES.FORMAT_REAL.$D1
	CALLS	#3,G^FCVALUES.SCIENTIFIC_TEXT
	MOVL	FCVALUES.FORMAT_REAL.TEXT(AP),R0
	MOVC3	#32,FCVALUES.FORMAT_REAL.$T1,@4(R0)
;  753      case (f_engineering)
	BRB	FCVALUES.FORMAT_REAL.$10
FCVALUES.FORMAT_REAL.$5:
;  754        text = engineering_text(abs(x))
	MOVG	@FCVALUES.FORMAT_REAL.X(AP),FCVALUES.FORMAT_REAL.$T2
	BGEQ	FCVALUES.FORMAT_REAL.$13
	MNEGG	FCVALUES.FORMAT_REAL.$T2,FCVALUES.FORMAT_REAL.$T2
FCVALUES.FORMAT_REAL.$13:
	PUSHAG	FCVALUES.FORMAT_REAL.$T2
	PUSHAQ	FCVALUES.FORMAT_REAL.$D1
	CALLS	#2,G^FCVALUES.ENGINEERING_TEXT
	MOVL	FCVALUES.FORMAT_REAL.TEXT(AP),R0
	MOVC3	#32,FCVALUES.FORMAT_REAL.$T1,@4(R0)
;  755      case default
	BRB	FCVALUES.FORMAT_REAL.$10
FCVALUES.FORMAT_REAL.$7:
;  756        text = auto_text(abs(x))
	MOVG	@FCVALUES.FORMAT_REAL.X(AP),FCVALUES.FORMAT_REAL.$T2
	BGEQ	FCVALUES.FORMAT_REAL.$15
	MNEGG	FCVALUES.FORMAT_REAL.$T2,FCVALUES.FORMAT_REAL.$T2
FCVALUES.FORMAT_REAL.$15:
	PUSHAG	FCVALUES.FORMAT_REAL.$T2
	PUSHAQ	FCVALUES.FORMAT_REAL.$D1
	CALLS	#2,G^FCVALUES.AUTO_TEXT
	MOVL	FCVALUES.FORMAT_REAL.TEXT(AP),R0
	MOVC3	#32,FCVALUES.FORMAT_REAL.$T1,@4(R0)
;  757      end select
FCVALUES.FORMAT_REAL.$10:
;  758
;  759      ! SCAN finds the first of a set of characters in a string (0 if none):
;  760      ! here, any digit that isn't zero.
;  761      if (x < 0 .and. scan(text, '123456789') > 0) text = '-' // trim(text)
	MOVL	FCVALUES.FORMAT_REAL.TEXT(AP),R0
	MOVAB	@4(R0),FCVALUES.FORMAT_REAL.$D2+4
	PUSHAL	FCVALUES.FORMAT_REAL.$K2
	PUSHAQ	FCVALUES.FORMAT_REAL.$D3
	PUSHAQ	FCVALUES.FORMAT_REAL.$D2
	CALLS	#3,G^FTN$SCAN
	MOVL	R0,FCVALUES.FORMAT_REAL.$T3
	TSTG	@FCVALUES.FORMAT_REAL.X(AP)
	BLSS	FCVALUES.FORMAT_REAL.$18
	RET
FCVALUES.FORMAT_REAL.$18:
	TSTL	FCVALUES.FORMAT_REAL.$T3
	BLEQ	FCVALUES.FORMAT_REAL.$17
	MOVL	FCVALUES.FORMAT_REAL.TEXT(AP),R0
	MOVAB	@4(R0),R8
	MOVAB	(R8),R7
	MOVL	#32,R6
	BRB	FCVALUES.FORMAT_REAL.$20
FCVALUES.FORMAT_REAL.$21:
	CMPB	-1(R7)[R6],#32
	BNEQ	FCVALUES.FORMAT_REAL.$22
	DECL	R6
FCVALUES.FORMAT_REAL.$20:
	TSTL	R6			; from line 761
	BNEQ	FCVALUES.FORMAT_REAL.$21
FCVALUES.FORMAT_REAL.$22:
	ADDL3	R6,#1,R0
	CVTLW	R0,FCVALUES.FORMAT_REAL.$T7
	PUSHAQ	FCVALUES.FORMAT_REAL.$D4
	PUSHAW	FCVALUES.FORMAT_REAL.$T7
	CALLS	#2,G^LIB$SGET1_DD
	MOVB	#45,@FCVALUES.FORMAT_REAL.$D4+4
	MOVL	FCVALUES.FORMAT_REAL.$D4+4,R0
	MOVC3	R6,(R8),1(R0)
	ADDL3	R6,#1,R0
	MOVL	FCVALUES.FORMAT_REAL.TEXT(AP),R1
	MOVC5	R0,@FCVALUES.FORMAT_REAL.$D4+4,#^A/ /,#32,@4(R1)
	PUSHAQ	FCVALUES.FORMAT_REAL.$D4
	CALLS	#1,G^LIB$SFREE1_DD
FCVALUES.FORMAT_REAL.$17:
;  762    end function format_real
	RET

; Storage map for FCVALUES.DECIMAL_DIGITS, a subroutine
;   A     REAL*8, INTENT(IN)         argument 1  @FCVALUES.DECIMAL_DIGITS.A(AP)
;   N     INTEGER, INTENT(IN)        argument 2  @FCVALUES.DECIMAL_DIGITS.N(AP)
;   D     CHARACTER*15, INTENT(OUT)  argument 3  @FCVALUES.DECIMAL_DIGITS.D(AP)
;   EX    INTEGER, INTENT(OUT)       argument 4  @FCVALUES.DECIMAL_DIGITS.EX(AP)
;   BUF   CHARACTER*40               $LOCAL+0    FCVALUES.DECIMAL_DIGITS.BUF
;   FORM  CHARACTER*20               $LOCAL+40   FCVALUES.DECIMAL_DIGITS.FORM
