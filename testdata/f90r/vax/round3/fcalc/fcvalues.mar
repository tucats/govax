	MOVL	#10,@FCVALUES.R_DIV.ERR(AP)
FCVALUES.R_DIV.$17:
;  247        return
	MOVG	FCVALUES.R_DIV.$KF1,R0	; the function's value
	RET
FCVALUES.R_DIV.$15:
;  248      end if
;  249
;  250      r_div = x / y
;  251    end function r_div
	DIVG3	@FCVALUES.R_DIV.Y(AP),@FCVALUES.R_DIV.X(AP),R0 ; the function's value
	RET

; Storage map for FCVALUES.C_ABS, a REAL*8 function
;   Z           COMPLEX*16, INTENT(IN)  argument 1  @FCVALUES.C_ABS.Z(AP)
;   C_ABS       REAL*8                  R6          R6
;   M           REAL*8                  $LOCAL+8    FCVALUES.C_ABS.M
;   N           REAL*8                  $LOCAL+16   FCVALUES.C_ABS.N
;   Q           REAL*8                  $LOCAL+24   FCVALUES.C_ABS.Q
;   SMALL_PART  LOGICAL                 $LOCAL+32   FCVALUES.C_ABS.SMALL_PART
;   R6 is $T1: temporary
;   R8 is $T3: temporary
;
FCVALUES.C_ABS.Z = 4			; Z is argument 1

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
	.BLKB	8
FCVALUES.C_ABS.M:
	.BLKL	2			; M
FCVALUES.C_ABS.N:
	.BLKL	2			; N
FCVALUES.C_ABS.Q:
	.BLKL	2			; Q
FCVALUES.C_ABS.SMALL_PART:
	.BLKL	1			; SMALL_PART
FCVALUES.C_ABS.$T2:
	.BLKL	2			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCVALUES.C_ABS.$KF1:
	.LONG	^X0EF53C87,^XD4974646	; 1D-17
FCVALUES.C_ABS.$KF2:
	.LONG	^X34574396,^XA00085D8	; 1D17

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  252
;  253    ! C_ABS is a complex number's magnitude, never squaring a part that could
;  254    ! overflow or underflow.
;  255    real(rk) function c_abs(z)
	.ENTRY	FCVALUES.C_ABS,^M<R2,R6,R7,R8,R9>
;  256      complex(rk), intent(in) :: z
;  257      real(rk) :: m, n, q
;  258      logical :: small_part
;  259
;  260      m = max(abs(real(z, rk)), abs(aimag(z)))
	MOVG	@FCVALUES.C_ABS.Z(AP),FCVALUES.C_ABS.$T2
	BGEQ	FCVALUES.C_ABS.$1
	MNEGG	FCVALUES.C_ABS.$T2,FCVALUES.C_ABS.$T2
FCVALUES.C_ABS.$1:
	MOVG	FCVALUES.C_ABS.$T2,R6
	MOVL	#1,R0
	MOVG	@FCVALUES.C_ABS.Z(AP)[R0],R8
	BGEQ	FCVALUES.C_ABS.$3
	MNEGG	R8,R8
FCVALUES.C_ABS.$3:
	CMPG	R8,R6
	BLEQ	FCVALUES.C_ABS.$5
	MOVG	R8,R6
FCVALUES.C_ABS.$5:
	MOVG	R6,FCVALUES.C_ABS.M
;  261      n = min(abs(real(z, rk)), abs(aimag(z)))
	MOVG	@FCVALUES.C_ABS.Z(AP),FCVALUES.C_ABS.$T2
	BGEQ	FCVALUES.C_ABS.$7
	MNEGG	FCVALUES.C_ABS.$T2,FCVALUES.C_ABS.$T2
FCVALUES.C_ABS.$7:
	MOVG	FCVALUES.C_ABS.$T2,R8
	MOVL	#1,R0
	MOVG	@FCVALUES.C_ABS.Z(AP)[R0],R6
	BGEQ	FCVALUES.C_ABS.$9
	MNEGG	R6,R6
FCVALUES.C_ABS.$9:
	CMPG	R6,R8
	BGEQ	FCVALUES.C_ABS.$11
	MOVG	R6,R8
FCVALUES.C_ABS.$11:
	MOVG	R8,FCVALUES.C_ABS.N
;  262      ! N is negligible beside M when N <= M * 1E-17; for M below 1 that
;  263      ! product could underflow, so the test is made as N * 1E17 <= M there.
;  264      if (m >= 1) then
	CMPG	FCVALUES.C_ABS.M,S^#1.0
	BLSS	FCVALUES.C_ABS.$13
;  265        small_part = n <= m * 1.0e-17_rk
	MULG3	FCVALUES.C_ABS.M,FCVALUES.C_ABS.$KF1,R0
	CLRL	R2
	CMPG	FCVALUES.C_ABS.N,R0
	BGTR	FCVALUES.C_ABS.$15
	MNEGL	#1,R2
FCVALUES.C_ABS.$15:
	MOVL	R2,FCVALUES.C_ABS.SMALL_PART
;  266      else
	BRB	FCVALUES.C_ABS.$16
FCVALUES.C_ABS.$13:
;  267        small_part = n * 1.0e17_rk <= m
	MULG3	FCVALUES.C_ABS.N,FCVALUES.C_ABS.$KF2,R0
	CLRL	R2
	CMPG	R0,FCVALUES.C_ABS.M
	BGTR	FCVALUES.C_ABS.$17
	MNEGL	#1,R2
FCVALUES.C_ABS.$17:
	MOVL	R2,FCVALUES.C_ABS.SMALL_PART
;  268      end if
FCVALUES.C_ABS.$16:
;  269      if (small_part) then
	BLBC	FCVALUES.C_ABS.SMALL_PART,FCVALUES.C_ABS.$18
;  270        c_abs = m
	MOVG	FCVALUES.C_ABS.M,R6
;  271      else
	BRB	FCVALUES.C_ABS.$20
FCVALUES.C_ABS.$18:
;  272        q = n / m
	DIVG3	FCVALUES.C_ABS.M,FCVALUES.C_ABS.N,FCVALUES.C_ABS.Q
;  273        c_abs = m * sqrt(1 + q * q)
	MULG3	FCVALUES.C_ABS.Q,FCVALUES.C_ABS.Q,R0
	ADDG3	S^#1.0,R0,FCVALUES.C_ABS.$T2
	PUSHAG	FCVALUES.C_ABS.$T2
	CALLS	#1,G^MTH$GSQRT
	MOVG	R0,R6
	MULG2	FCVALUES.C_ABS.M,R6
;  274      end if
FCVALUES.C_ABS.$20:
;  275    end function c_abs
	MOVG	R6,R0			; the function's value
	RET

; Storage map for FCVALUES.C_ADD, a COMPLEX*16 function
;   C_ADD  COMPLEX*16              hidden argument 1  @FCVALUES.C_ADD.C_ADD(AP)
;   X      COMPLEX*16, INTENT(IN)  argument 2         @FCVALUES.C_ADD.X(AP)
;   Y      COMPLEX*16, INTENT(IN)  argument 3         @FCVALUES.C_ADD.Y(AP)
;   ERR    INTEGER, INTENT(INOUT)  argument 4         @FCVALUES.C_ADD.ERR(AP)
;
FCVALUES.C_ADD.C_ADD = 4		; C_ADD's value goes through hidden argument 1
FCVALUES.C_ADD.X = 8			; X is argument 2
FCVALUES.C_ADD.Y = 12			; Y is argument 3
FCVALUES.C_ADD.ERR = 16			; ERR is argument 4

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCVALUES.C_ADD.$T1:
	.BLKL	2			; temporary
FCVALUES.C_ADD.$T2:
	.BLKL	2			; temporary
FCVALUES.C_ADD.$T3:
	.BLKL	2			; temporary
FCVALUES.C_ADD.$T4:
	.BLKL	2			; temporary
FCVALUES.C_ADD.$T5:
	.BLKL	2			; temporary
FCVALUES.C_ADD.$T6:
	.BLKL	2			; temporary

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  276
;  277    ! ------------------------------------------------------------------
;  278    ! The guarded operations on complex numbers, built on those on real
;  279    ! numbers. Each takes ERR as R_ADD does. The operators below apply them
;  280    ! to VALUEs; module FCMATRIX applies them to the elements of matrices,
;  281    ! where making a VALUE of each element would only be in the way.
;  282
;  283    complex(rk) function c_add(x, y, err)
	.ENTRY	FCVALUES.C_ADD,^M<>
;  284      complex(rk), intent(in) :: x, y
;  285      integer, intent(inout) :: err
;  286
;  287      c_add = cmplx(r_add(real(x, rk), real(y, rk), err), r_add(aimag(x), aimag(y), err), rk)
	MOVG	@FCVALUES.C_ADD.X(AP),FCVALUES.C_ADD.$T2
	MOVG	@FCVALUES.C_ADD.Y(AP),FCVALUES.C_ADD.$T3
	PUSHAL	@FCVALUES.C_ADD.ERR(AP)
	PUSHAG	FCVALUES.C_ADD.$T3
	PUSHAG	FCVALUES.C_ADD.$T2
	CALLS	#3,G^FCVALUES.R_ADD
	MOVG	R0,FCVALUES.C_ADD.$T1
	MOVL	#1,R0
	MOVG	@FCVALUES.C_ADD.X(AP)[R0],FCVALUES.C_ADD.$T5
	MOVL	#1,R0
	MOVG	@FCVALUES.C_ADD.Y(AP)[R0],FCVALUES.C_ADD.$T6
	PUSHAL	@FCVALUES.C_ADD.ERR(AP)
	PUSHAG	FCVALUES.C_ADD.$T6
	PUSHAG	FCVALUES.C_ADD.$T5
	CALLS	#3,G^FCVALUES.R_ADD
	MOVG	R0,FCVALUES.C_ADD.$T4
	MOVG	FCVALUES.C_ADD.$T1,@FCVALUES.C_ADD.C_ADD(AP)
	MOVL	#1,R0
	MOVG	FCVALUES.C_ADD.$T4,@FCVALUES.C_ADD.C_ADD(AP)[R0]
;  288    end function c_add
	RET

; Storage map for FCVALUES.C_SUB, a COMPLEX*16 function
;   C_SUB  COMPLEX*16              hidden argument 1  @FCVALUES.C_SUB.C_SUB(AP)
;   X      COMPLEX*16, INTENT(IN)  argument 2         @FCVALUES.C_SUB.X(AP)
;   Y      COMPLEX*16, INTENT(IN)  argument 3         @FCVALUES.C_SUB.Y(AP)
;   ERR    INTEGER, INTENT(INOUT)  argument 4         @FCVALUES.C_SUB.ERR(AP)
;
FCVALUES.C_SUB.C_SUB = 4		; C_SUB's value goes through hidden argument 1
FCVALUES.C_SUB.X = 8			; X is argument 2
FCVALUES.C_SUB.Y = 12			; Y is argument 3
FCVALUES.C_SUB.ERR = 16			; ERR is argument 4

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCVALUES.C_SUB.$T1:
	.BLKL	4			; temporary
FCVALUES.C_SUB.$T2:
	.BLKL	4			; temporary

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  289
;  290    ! (Negating a number is exact, so X - Y is X + (-Y).)
;  291    complex(rk) function c_sub(x, y, err)
	.ENTRY	FCVALUES.C_SUB,^M<>
;  292      complex(rk), intent(in) :: x, y
;  293      integer, intent(inout) :: err
;  294
;  295      c_sub = c_add(x, -y, err)
	MNEGG	@FCVALUES.C_SUB.Y(AP),FCVALUES.C_SUB.$T2
	MOVL	#1,R0
	MNEGG	@FCVALUES.C_SUB.Y(AP)[R0],FCVALUES.C_SUB.$T2+8
	PUSHAL	@FCVALUES.C_SUB.ERR(AP)
	PUSHAO	FCVALUES.C_SUB.$T2
	PUSHAO	@FCVALUES.C_SUB.X(AP)
	PUSHAO	FCVALUES.C_SUB.$T1
	CALLS	#4,G^FCVALUES.C_ADD
	MOVO	FCVALUES.C_SUB.$T1,@FCVALUES.C_SUB.C_SUB(AP)
;  296    end function c_sub
	RET

; Storage map for FCVALUES.C_MUL, a COMPLEX*16 function
;   C_MUL  COMPLEX*16              hidden argument 1  @FCVALUES.C_MUL.C_MUL(AP)
;   X      COMPLEX*16, INTENT(IN)  argument 2         @FCVALUES.C_MUL.X(AP)
;   Y      COMPLEX*16, INTENT(IN)  argument 3         @FCVALUES.C_MUL.Y(AP)
;   ERR    INTEGER, INTENT(INOUT)  argument 4         @FCVALUES.C_MUL.ERR(AP)
;   P      REAL*8                  $LOCAL+0           FCVALUES.C_MUL.P
;   Q      REAL*8                  $LOCAL+8           FCVALUES.C_MUL.Q
;   R      REAL*8                  $LOCAL+16          FCVALUES.C_MUL.R
;   S      REAL*8                  $LOCAL+24          FCVALUES.C_MUL.S
;
FCVALUES.C_MUL.C_MUL = 4		; C_MUL's value goes through hidden argument 1
FCVALUES.C_MUL.X = 8			; X is argument 2
FCVALUES.C_MUL.Y = 12			; Y is argument 3
FCVALUES.C_MUL.ERR = 16			; ERR is argument 4

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCVALUES.C_MUL.P:
	.BLKL	2			; P
FCVALUES.C_MUL.Q:
	.BLKL	2			; Q
FCVALUES.C_MUL.R:
	.BLKL	2			; R
FCVALUES.C_MUL.S:
	.BLKL	2			; S
FCVALUES.C_MUL.$T1:
	.BLKL	2			; temporary
FCVALUES.C_MUL.$T2:
	.BLKL	2			; temporary
FCVALUES.C_MUL.$T3:
	.BLKL	2			; temporary
FCVALUES.C_MUL.$T4:
	.BLKL	2			; temporary
FCVALUES.C_MUL.$T5:
	.BLKL	2			; temporary
FCVALUES.C_MUL.$T6:
	.BLKL	2			; temporary
FCVALUES.C_MUL.$T7:
	.BLKL	2			; temporary

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  297
;  298    ! C_MUL: (p + qi)(r + si) = (pr - qs) + (ps + qr)i.
;  299    complex(rk) function c_mul(x, y, err)
	.ENTRY	FCVALUES.C_MUL,^M<>
;  300      complex(rk), intent(in) :: x, y
;  301      integer, intent(inout) :: err
;  302      real(rk) :: p, q, r, s
;  303
;  304      p = real(x, rk)
	MOVG	@FCVALUES.C_MUL.X(AP),FCVALUES.C_MUL.P
;  305      q = aimag(x)
	MOVL	#1,R0
	MOVG	@FCVALUES.C_MUL.X(AP)[R0],FCVALUES.C_MUL.Q
;  306      r = real(y, rk)
	MOVG	@FCVALUES.C_MUL.Y(AP),FCVALUES.C_MUL.R
;  307      s = aimag(y)
	MOVL	#1,R0
	MOVG	@FCVALUES.C_MUL.Y(AP)[R0],FCVALUES.C_MUL.S
;  308      c_mul = cmplx(r_add(r_mul(p, r, err), -r_mul(q, s, err), err), &
;  309        r_add(r_mul(p, s, err), r_mul(q, r, err), err), rk)
	PUSHAL	@FCVALUES.C_MUL.ERR(AP)
	PUSHAG	FCVALUES.C_MUL.R
	PUSHAG	FCVALUES.C_MUL.P
	CALLS	#3,G^FCVALUES.R_MUL
	MOVG	R0,FCVALUES.C_MUL.$T2
	PUSHAL	@FCVALUES.C_MUL.ERR(AP)
	PUSHAG	FCVALUES.C_MUL.S
	PUSHAG	FCVALUES.C_MUL.Q
	CALLS	#3,G^FCVALUES.R_MUL
	MOVG	R0,FCVALUES.C_MUL.$T3
	MNEGG	FCVALUES.C_MUL.$T3,FCVALUES.C_MUL.$T4
	PUSHAL	@FCVALUES.C_MUL.ERR(AP)
	PUSHAG	FCVALUES.C_MUL.$T4
	PUSHAG	FCVALUES.C_MUL.$T2
	CALLS	#3,G^FCVALUES.R_ADD
	MOVG	R0,FCVALUES.C_MUL.$T1
	PUSHAL	@FCVALUES.C_MUL.ERR(AP)
	PUSHAG	FCVALUES.C_MUL.S
	PUSHAG	FCVALUES.C_MUL.P
	CALLS	#3,G^FCVALUES.R_MUL
	MOVG	R0,FCVALUES.C_MUL.$T6
	PUSHAL	@FCVALUES.C_MUL.ERR(AP)
	PUSHAG	FCVALUES.C_MUL.R
	PUSHAG	FCVALUES.C_MUL.Q
	CALLS	#3,G^FCVALUES.R_MUL
	MOVG	R0,FCVALUES.C_MUL.$T7
	PUSHAL	@FCVALUES.C_MUL.ERR(AP)
	PUSHAG	FCVALUES.C_MUL.$T7
	PUSHAG	FCVALUES.C_MUL.$T6
	CALLS	#3,G^FCVALUES.R_ADD
	MOVG	R0,FCVALUES.C_MUL.$T5
	MOVG	FCVALUES.C_MUL.$T1,@FCVALUES.C_MUL.C_MUL(AP)
	MOVL	#1,R0
	MOVG	FCVALUES.C_MUL.$T5,@FCVALUES.C_MUL.C_MUL(AP)[R0]
;  310    end function c_mul
	RET

; Storage map for FCVALUES.C_DIV, a COMPLEX*16 function
;   C_DIV  COMPLEX*16              hidden argument 1  @FCVALUES.C_DIV.C_DIV(AP)
;   X      COMPLEX*16, INTENT(IN)  argument 2         @FCVALUES.C_DIV.X(AP)
;   Y      COMPLEX*16, INTENT(IN)  argument 3         @FCVALUES.C_DIV.Y(AP)
;   ERR    INTEGER, INTENT(INOUT)  argument 4         @FCVALUES.C_DIV.ERR(AP)
;   P      REAL*8                  $LOCAL+0           FCVALUES.C_DIV.P
;   Q      REAL*8                  $LOCAL+8           FCVALUES.C_DIV.Q
;   R      REAL*8                  $LOCAL+16          FCVALUES.C_DIV.R
;   S      REAL*8                  $LOCAL+24          FCVALUES.C_DIV.S
;   RATIO  REAL*8                  $LOCAL+32          FCVALUES.C_DIV.RATIO
;   DEN    REAL*8                  $LOCAL+40          FCVALUES.C_DIV.DEN
;   A      REAL*8                  $LOCAL+48          FCVALUES.C_DIV.A
;   B      REAL*8                  $LOCAL+56          FCVALUES.C_DIV.B
;
FCVALUES.C_DIV.C_DIV = 4		; C_DIV's value goes through hidden argument 1
FCVALUES.C_DIV.X = 8			; X is argument 2
FCVALUES.C_DIV.Y = 12			; Y is argument 3
FCVALUES.C_DIV.ERR = 16			; ERR is argument 4

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCVALUES.C_DIV.P:
	.BLKL	2			; P
FCVALUES.C_DIV.Q:
	.BLKL	2			; Q
FCVALUES.C_DIV.R:
	.BLKL	2			; R
FCVALUES.C_DIV.S:
	.BLKL	2			; S
FCVALUES.C_DIV.RATIO:
	.BLKL	2			; RATIO
FCVALUES.C_DIV.DEN:
	.BLKL	2			; DEN
FCVALUES.C_DIV.A:
	.BLKL	2			; A
FCVALUES.C_DIV.B:
	.BLKL	2			; B
FCVALUES.C_DIV.$T1:
	.BLKL	2			; temporary
FCVALUES.C_DIV.$T2:
	.BLKL	2			; temporary
FCVALUES.C_DIV.$T3:
	.BLKL	2			; temporary

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  311
;  312    ! C_DIV divides by Smith's method, which scales by the divisor's larger
;  313    ! part so that no product is larger than it must be. The textbook
;  314    !     (p + qi) / (r + si) = ((pr + qs) + (qr - ps)i) / (r**2 + s**2)
;  315    ! squares the divisor's parts, which overflows for parts near 1E154 and
;  316    ! underflows near 1E-154, although the quotient may be ordinary. Smith
;  317    ! divides through by the larger of r and s first: with |r| >= |s| and
;  318    ! t = s/r (at most 1 in size), the denominator is r + s t, never larger
;  319    ! than 2|r|, and the numerators are p + q t and q - p t.
;  320    complex(rk) function c_div(x, y, err)
	.ENTRY	FCVALUES.C_DIV,^M<>
;  321      complex(rk), intent(in) :: x, y
;  322      integer, intent(inout) :: err
;  323      real(rk) :: p, q, r, s, ratio, den, a, b
;  324
;  325      p = real(x, rk)
	MOVG	@FCVALUES.C_DIV.X(AP),FCVALUES.C_DIV.P
;  326      q = aimag(x)
	MOVL	#1,R0
	MOVG	@FCVALUES.C_DIV.X(AP)[R0],FCVALUES.C_DIV.Q
;  327      r = real(y, rk)
	MOVG	@FCVALUES.C_DIV.Y(AP),FCVALUES.C_DIV.R
;  328      s = aimag(y)
	MOVL	#1,R0
	MOVG	@FCVALUES.C_DIV.Y(AP)[R0],FCVALUES.C_DIV.S
;  329
;  330      if (s == 0) then
	BNEQ	FCVALUES.C_DIV.$1
;  331        a = r_div(p, r, err)
	PUSHAL	@FCVALUES.C_DIV.ERR(AP)
	PUSHAG	FCVALUES.C_DIV.R
	PUSHAG	FCVALUES.C_DIV.P
	CALLS	#3,G^FCVALUES.R_DIV
	MOVG	R0,FCVALUES.C_DIV.A
;  332        b = r_div(q, r, err)
	PUSHAL	@FCVALUES.C_DIV.ERR(AP)
	PUSHAG	FCVALUES.C_DIV.R
	PUSHAG	FCVALUES.C_DIV.Q
	CALLS	#3,G^FCVALUES.R_DIV
	MOVG	R0,FCVALUES.C_DIV.B
;  333      else if (r == 0) then
	BRW	FCVALUES.C_DIV.$3
FCVALUES.C_DIV.$1:
	TSTG	FCVALUES.C_DIV.R
	BNEQ	FCVALUES.C_DIV.$4
;  334        a = r_div(q, s, err)
	PUSHAL	@FCVALUES.C_DIV.ERR(AP)
	PUSHAG	FCVALUES.C_DIV.S
	PUSHAG	FCVALUES.C_DIV.Q
	CALLS	#3,G^FCVALUES.R_DIV
	MOVG	R0,FCVALUES.C_DIV.A
;  335        b = -r_div(p, s, err)
	PUSHAL	@FCVALUES.C_DIV.ERR(AP)
	PUSHAG	FCVALUES.C_DIV.S
	PUSHAG	FCVALUES.C_DIV.P
	CALLS	#3,G^FCVALUES.R_DIV
	MOVG	R0,FCVALUES.C_DIV.$T1
	MNEGG	FCVALUES.C_DIV.$T1,FCVALUES.C_DIV.B
;  336      else if (abs(r) >= abs(s)) then
	BRW	FCVALUES.C_DIV.$3
FCVALUES.C_DIV.$4:
	MOVG	FCVALUES.C_DIV.R,FCVALUES.C_DIV.$T1
	BGEQ	FCVALUES.C_DIV.$6
	MNEGG	FCVALUES.C_DIV.$T1,FCVALUES.C_DIV.$T1
FCVALUES.C_DIV.$6:
	MOVG	FCVALUES.C_DIV.S,FCVALUES.C_DIV.$T2
	BGEQ	FCVALUES.C_DIV.$8
	MNEGG	FCVALUES.C_DIV.$T2,FCVALUES.C_DIV.$T2
FCVALUES.C_DIV.$8:
	CMPG	FCVALUES.C_DIV.$T1,FCVALUES.C_DIV.$T2
	BGEQ	FCVALUES.C_DIV.$11
	BRW	FCVALUES.C_DIV.$10
FCVALUES.C_DIV.$11:
;  337        ratio = s / r
	DIVG3	FCVALUES.C_DIV.R,FCVALUES.C_DIV.S,FCVALUES.C_DIV.RATIO
;  338        den = r_add(r, r_mul(s, ratio, err), err)
	PUSHAL	@FCVALUES.C_DIV.ERR(AP)
	PUSHAG	FCVALUES.C_DIV.RATIO
	PUSHAG	FCVALUES.C_DIV.S
	CALLS	#3,G^FCVALUES.R_MUL
	MOVG	R0,FCVALUES.C_DIV.$T2
	PUSHAL	@FCVALUES.C_DIV.ERR(AP)
	PUSHAG	FCVALUES.C_DIV.$T2
	PUSHAG	FCVALUES.C_DIV.R
	CALLS	#3,G^FCVALUES.R_ADD
	MOVG	R0,FCVALUES.C_DIV.DEN
;  339        a = r_div(r_add(p, r_mul(q, ratio, err), err), den, err)
	PUSHAL	@FCVALUES.C_DIV.ERR(AP)
	PUSHAG	FCVALUES.C_DIV.RATIO
	PUSHAG	FCVALUES.C_DIV.Q
	CALLS	#3,G^FCVALUES.R_MUL
	MOVG	R0,FCVALUES.C_DIV.$T1
	PUSHAL	@FCVALUES.C_DIV.ERR(AP)
	PUSHAG	FCVALUES.C_DIV.$T1
	PUSHAG	FCVALUES.C_DIV.P
	CALLS	#3,G^FCVALUES.R_ADD
	MOVG	R0,FCVALUES.C_DIV.$T2
	PUSHAL	@FCVALUES.C_DIV.ERR(AP)
	PUSHAG	FCVALUES.C_DIV.DEN
	PUSHAG	FCVALUES.C_DIV.$T2
	CALLS	#3,G^FCVALUES.R_DIV
	MOVG	R0,FCVALUES.C_DIV.A
;  340        b = r_div(r_add(q, -r_mul(p, ratio, err), err), den, err)
	PUSHAL	@FCVALUES.C_DIV.ERR(AP)
	PUSHAG	FCVALUES.C_DIV.RATIO
	PUSHAG	FCVALUES.C_DIV.P
	CALLS	#3,G^FCVALUES.R_MUL
	MOVG	R0,FCVALUES.C_DIV.$T2
	MNEGG	FCVALUES.C_DIV.$T2,FCVALUES.C_DIV.$T3
	PUSHAL	@FCVALUES.C_DIV.ERR(AP)
	PUSHAG	FCVALUES.C_DIV.$T3
	PUSHAG	FCVALUES.C_DIV.Q
	CALLS	#3,G^FCVALUES.R_ADD
	MOVG	R0,FCVALUES.C_DIV.$T1
	PUSHAL	@FCVALUES.C_DIV.ERR(AP)
	PUSHAG	FCVALUES.C_DIV.DEN
	PUSHAG	FCVALUES.C_DIV.$T1
	CALLS	#3,G^FCVALUES.R_DIV
	MOVG	R0,FCVALUES.C_DIV.B
;  341      else
	BRW	FCVALUES.C_DIV.$3
FCVALUES.C_DIV.$10:
;  342        ratio = r / s
	DIVG3	FCVALUES.C_DIV.S,FCVALUES.C_DIV.R,FCVALUES.C_DIV.RATIO
;  343        den = r_add(s, r_mul(r, ratio, err), err)
	PUSHAL	@FCVALUES.C_DIV.ERR(AP)
	PUSHAG	FCVALUES.C_DIV.RATIO
	PUSHAG	FCVALUES.C_DIV.R
	CALLS	#3,G^FCVALUES.R_MUL
	MOVG	R0,FCVALUES.C_DIV.$T3
	PUSHAL	@FCVALUES.C_DIV.ERR(AP)
	PUSHAG	FCVALUES.C_DIV.$T3
	PUSHAG	FCVALUES.C_DIV.S
	CALLS	#3,G^FCVALUES.R_ADD
	MOVG	R0,FCVALUES.C_DIV.DEN
;  344        a = r_div(r_add(r_mul(p, ratio, err), q, err), den, err)
	PUSHAL	@FCVALUES.C_DIV.ERR(AP)
	PUSHAG	FCVALUES.C_DIV.RATIO
	PUSHAG	FCVALUES.C_DIV.P
	CALLS	#3,G^FCVALUES.R_MUL
	MOVG	R0,FCVALUES.C_DIV.$T2
	PUSHAL	@FCVALUES.C_DIV.ERR(AP)
	PUSHAG	FCVALUES.C_DIV.Q
	PUSHAG	FCVALUES.C_DIV.$T2
	CALLS	#3,G^FCVALUES.R_ADD
	MOVG	R0,FCVALUES.C_DIV.$T3
	PUSHAL	@FCVALUES.C_DIV.ERR(AP)
	PUSHAG	FCVALUES.C_DIV.DEN
	PUSHAG	FCVALUES.C_DIV.$T3
	CALLS	#3,G^FCVALUES.R_DIV
	MOVG	R0,FCVALUES.C_DIV.A
;  345        b = r_div(r_add(r_mul(q, ratio, err), -p, err), den, err)
	PUSHAL	@FCVALUES.C_DIV.ERR(AP)
	PUSHAG	FCVALUES.C_DIV.RATIO
	PUSHAG	FCVALUES.C_DIV.Q
	CALLS	#3,G^FCVALUES.R_MUL
	MOVG	R0,FCVALUES.C_DIV.$T3
	MNEGG	FCVALUES.C_DIV.P,FCVALUES.C_DIV.$T1
	PUSHAL	@FCVALUES.C_DIV.ERR(AP)
	PUSHAG	FCVALUES.C_DIV.$T1
	PUSHAG	FCVALUES.C_DIV.$T3
	CALLS	#3,G^FCVALUES.R_ADD
	MOVG	R0,FCVALUES.C_DIV.$T2
	PUSHAL	@FCVALUES.C_DIV.ERR(AP)
	PUSHAG	FCVALUES.C_DIV.DEN
	PUSHAG	FCVALUES.C_DIV.$T2
	CALLS	#3,G^FCVALUES.R_DIV
	MOVG	R0,FCVALUES.C_DIV.B
;  346      end if
FCVALUES.C_DIV.$3:
;  347
;  348      ! A part negated above may be an IEEE machine's -0, which a VAX hasn't:
;  349      ! assigning 0 makes it +0, so later functions (ATAN2's branch) agree on
;  350      ! both.
;  351      if (a == 0) a = 0
	TSTG	FCVALUES.C_DIV.A
	BNEQ	FCVALUES.C_DIV.$12
	CLRG	FCVALUES.C_DIV.A
FCVALUES.C_DIV.$12:
;  352      if (b == 0) b = 0
	TSTG	FCVALUES.C_DIV.B
	BNEQ	FCVALUES.C_DIV.$14
	CLRG	FCVALUES.C_DIV.B
FCVALUES.C_DIV.$14:
;  353      c_div = cmplx(a, b, rk)
	MOVG	FCVALUES.C_DIV.A,FCVALUES.C_DIV.$T1
	MOVL	#1,R0
	MOVG	FCVALUES.C_DIV.B,@FCVALUES.C_DIV.C_DIV(AP)[R0]
	MOVG	FCVALUES.C_DIV.$T1,@FCVALUES.C_DIV.C_DIV(AP)
;  354    end function c_div
	RET

; Storage map for FCVALUES.V_PLUS, a TYPE(VALUE) function
;   V     TYPE(VALUE)              hidden argument 1  @FCVALUES.V_PLUS.V(AP)
;   A     TYPE(VALUE), INTENT(IN)  argument 2         @FCVALUES.V_PLUS.A(AP)
;
FCVALUES.V_PLUS.V = 4			; V's value goes through hidden argument 1
FCVALUES.V_PLUS.A = 8			; A is argument 2

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  355
;  356    ! ------------------------------------------------------------------
;  357    ! The operators.
;  358
;  359    function v_plus(a) result(v)
	.ENTRY	FCVALUES.V_PLUS,^M<R2,R3,R4,R5>
;  360      type(value), intent(in) :: a
;  361      type(value) :: v
;  362
;  363      v = a
	MOVC3	#32,@FCVALUES.V_PLUS.A(AP),@FCVALUES.V_PLUS.V(AP)
;  364    end function v_plus
	RET

; Storage map for FCVALUES.V_NEG, a TYPE(VALUE) function
;   V     TYPE(VALUE)              hidden argument 1  @FCVALUES.V_NEG.V(AP)
;   A     TYPE(VALUE), INTENT(IN)  argument 2         @FCVALUES.V_NEG.A(AP)
;
FCVALUES.V_NEG.V = 4			; V's value goes through hidden argument 1
FCVALUES.V_NEG.A = 8			; A is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCVALUES.V_NEG.$T1:
	.BLKL	8			; characters, for one statement
FCVALUES.V_NEG.$T2:
	.BLKL	4			; temporary

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  365
;  366    function v_neg(a) result(v)
	.ENTRY	FCVALUES.V_NEG,^M<R2,R3,R4,R5>
;  367      type(value), intent(in) :: a
;  368      type(value) :: v
;  369
;  370      if (a%err /= 0) then
	MOVL	FCVALUES.V_NEG.A(AP),R0
	TSTL	16(R0)
	BEQL	FCVALUES.V_NEG.$1
;  371        v = a
	MOVC3	#32,@FCVALUES.V_NEG.A(AP),@FCVALUES.V_NEG.V(AP)
;  372      else
	RET
FCVALUES.V_NEG.$1:
;  373        v = clean(-a%z)
	MNEGG	@FCVALUES.V_NEG.A(AP),FCVALUES.V_NEG.$T2
	MOVL	FCVALUES.V_NEG.A(AP),R0
	MNEGG	8(R0),FCVALUES.V_NEG.$T2+8
	PUSHAO	FCVALUES.V_NEG.$T2
	PUSHAB	FCVALUES.V_NEG.$T1
	CALLS	#2,G^FCVALUES.CLEAN
	MOVC3	#32,FCVALUES.V_NEG.$T1,@FCVALUES.V_NEG.V(AP)
;  374      end if
;  375    end function v_neg
	RET

; Storage map for FCVALUES.V_ADD, a TYPE(VALUE) function
;   V     TYPE(VALUE)              hidden argument 1  @FCVALUES.V_ADD.V(AP)
;   A     TYPE(VALUE), INTENT(IN)  argument 2         @FCVALUES.V_ADD.A(AP)
;   B     TYPE(VALUE), INTENT(IN)  argument 3         @FCVALUES.V_ADD.B(AP)
;   ERR   INTEGER                  $LOCAL+0           FCVALUES.V_ADD.ERR
;
FCVALUES.V_ADD.V = 4			; V's value goes through hidden argument 1
FCVALUES.V_ADD.A = 8			; A is argument 2
FCVALUES.V_ADD.B = 12			; B is argument 3

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCVALUES.V_ADD.ERR:
	.BLKL	1			; ERR
FCVALUES.V_ADD.$T1:
