	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCVALUES.EXP_REAL.$K1:
	.LONG	10
FCVALUES.EXP_REAL.$K2:
	.LONG	^X00000000,^X00000000	; 0D0
FCVALUES.EXP_REAL.$KF1:
	.LONG	^X963440A5,^X7FB547F8	; 690.7755278982137D0
FCVALUES.EXP_REAL.$KF2:
	.LONG	^X9634C0A5,^X7FB547F8	; -690.7755278982137D0

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  492
;  493    ! EXP_REAL is EXP(T) as a value: an overflow past LOG_LIMIT, zero below
;  494    ! LOG_SMALL.
;  495    function exp_real(t) result(v)
	.ENTRY	FCVALUES.EXP_REAL,^M<R2,R3,R4,R5>
;  496      real(rk), intent(in) :: t
;  497      type(value) :: v
;  498
;  499      if (t > log_limit) then
	CMPG	@FCVALUES.EXP_REAL.T(AP),FCVALUES.EXP_REAL.$KF1
	BLEQ	FCVALUES.EXP_REAL.$1
;  500        v = error_value(e_overflow)
	PUSHAL	FCVALUES.EXP_REAL.$K1
	PUSHAB	FCVALUES.EXP_REAL.$T1
	CALLS	#2,G^FCVALUES.ERROR_VALUE
	MOVC3	#32,FCVALUES.EXP_REAL.$T1,@FCVALUES.EXP_REAL.V(AP)
;  501      else if (t < log_small) then
	RET
FCVALUES.EXP_REAL.$1:
	CMPG	@FCVALUES.EXP_REAL.T(AP),FCVALUES.EXP_REAL.$KF2
	BGEQ	FCVALUES.EXP_REAL.$4
;  502        v = real_value(0.0_rk)
	PUSHAG	FCVALUES.EXP_REAL.$K2
	PUSHAB	FCVALUES.EXP_REAL.$T1
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCVALUES.EXP_REAL.$T1,@FCVALUES.EXP_REAL.V(AP)
;  503      else
	RET
FCVALUES.EXP_REAL.$4:
;  504        v = real_value(exp(t))
	PUSHAG	@FCVALUES.EXP_REAL.T(AP)
	CALLS	#1,G^MTH$GEXP
	MOVG	R0,FCVALUES.EXP_REAL.$T2
	PUSHAG	FCVALUES.EXP_REAL.$T2
	PUSHAB	FCVALUES.EXP_REAL.$T1
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCVALUES.EXP_REAL.$T1,@FCVALUES.EXP_REAL.V(AP)
;  505      end if
;  506    end function exp_real
	RET

; Storage map for FCVALUES.EXP_VALUE, a TYPE(VALUE) function
;   V     TYPE(VALUE)              hidden argument 1  @FCVALUES.EXP_VALUE.V(AP)
;   A     TYPE(VALUE), INTENT(IN)  argument 2         @FCVALUES.EXP_VALUE.A(AP)
;   M     REAL*8                   $LOCAL+0           FCVALUES.EXP_VALUE.M
;   Y     REAL*8                   $LOCAL+8           FCVALUES.EXP_VALUE.Y
;   ERR   INTEGER                  $LOCAL+16          FCVALUES.EXP_VALUE.ERR
;
FCVALUES.EXP_VALUE.V = 4		; V's value goes through hidden argument 1
FCVALUES.EXP_VALUE.A = 8		; A is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCVALUES.EXP_VALUE.M:
	.BLKL	2			; M
FCVALUES.EXP_VALUE.Y:
	.BLKL	2			; Y
FCVALUES.EXP_VALUE.ERR:
	.BLKL	1			; ERR
FCVALUES.EXP_VALUE.$T1:
	.BLKL	2			; temporary
FCVALUES.EXP_VALUE.$T2:
	.BLKL	8			; characters, for one statement
FCVALUES.EXP_VALUE.$T3:
	.BLKL	2			; temporary
FCVALUES.EXP_VALUE.$T4:
	.BLKL	2			; temporary
FCVALUES.EXP_VALUE.$T5:
	.BLKL	2			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCVALUES.EXP_VALUE.$K1:
	.LONG	11
FCVALUES.EXP_VALUE.$KF1:
	.LONG	^X6BF5432C,^X00002634	; 1D15

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  507
;  508    ! EXP_VALUE is a complex value's exponential, by Euler's formula:
;  509    !     exp(x + iy) = e**x (cos y + i sin y)
;  510    function exp_value(a) result(v)
	.ENTRY	FCVALUES.EXP_VALUE,^M<R2,R3,R4,R5>
;  511      type(value), intent(in) :: a
;  512      type(value) :: v
;  513      real(rk) :: m, y
;  514      integer :: err
;  515
;  516      if (a%err /= 0) then
	MOVL	FCVALUES.EXP_VALUE.A(AP),R0
	TSTL	16(R0)
	BEQL	FCVALUES.EXP_VALUE.$1
;  517        v = a
	MOVC3	#32,@FCVALUES.EXP_VALUE.A(AP),@FCVALUES.EXP_VALUE.V(AP)
;  518        return
	RET
FCVALUES.EXP_VALUE.$1:
;  519      end if
;  520      y = aimag(a%z)
	MOVL	FCVALUES.EXP_VALUE.A(AP),R0
	MOVG	8(R0),FCVALUES.EXP_VALUE.Y
;  521      if (abs(y) > 1.0e15_rk) then
	MOVG	FCVALUES.EXP_VALUE.Y,FCVALUES.EXP_VALUE.$T1
	BGEQ	FCVALUES.EXP_VALUE.$3
	MNEGG	FCVALUES.EXP_VALUE.$T1,FCVALUES.EXP_VALUE.$T1
FCVALUES.EXP_VALUE.$3:
	CMPG	FCVALUES.EXP_VALUE.$T1,FCVALUES.EXP_VALUE.$KF1
	BLEQ	FCVALUES.EXP_VALUE.$5
;  522        ! An angle so large that its sine has no significant digits.
;  523        v = error_value(e_domain)
	PUSHAL	FCVALUES.EXP_VALUE.$K1
	PUSHAB	FCVALUES.EXP_VALUE.$T2
	CALLS	#2,G^FCVALUES.ERROR_VALUE
	MOVC3	#32,FCVALUES.EXP_VALUE.$T2,@FCVALUES.EXP_VALUE.V(AP)
;  524        return
	RET
FCVALUES.EXP_VALUE.$5:
;  525      end if
;  526      v = exp_real(real(a%z, rk))
	MOVG	@FCVALUES.EXP_VALUE.A(AP),FCVALUES.EXP_VALUE.$T1
	PUSHAG	FCVALUES.EXP_VALUE.$T1
	PUSHAB	FCVALUES.EXP_VALUE.$T2
	CALLS	#2,G^FCVALUES.EXP_REAL
	MOVC3	#32,FCVALUES.EXP_VALUE.$T2,@FCVALUES.EXP_VALUE.V(AP)
;  527      if (v%err /= 0 .or. y == 0) return
	MOVL	FCVALUES.EXP_VALUE.V(AP),R0
	TSTL	16(R0)
	BNEQ	FCVALUES.EXP_VALUE.$8
	TSTG	FCVALUES.EXP_VALUE.Y
	BNEQ	FCVALUES.EXP_VALUE.$7
FCVALUES.EXP_VALUE.$8:
	RET
FCVALUES.EXP_VALUE.$7:
;  528      m = real(v%z, rk)
	MOVG	@FCVALUES.EXP_VALUE.V(AP),FCVALUES.EXP_VALUE.M
;  529      err = 0
	CLRL	FCVALUES.EXP_VALUE.ERR
;  530      v%z = cmplx(r_mul(m, cos(y), err), r_mul(m, sin(y), err), rk)
	PUSHAG	FCVALUES.EXP_VALUE.Y
	CALLS	#1,G^MTH$GCOS
	MOVG	R0,FCVALUES.EXP_VALUE.$T3
	PUSHAL	FCVALUES.EXP_VALUE.ERR
	PUSHAG	FCVALUES.EXP_VALUE.$T3
	PUSHAG	FCVALUES.EXP_VALUE.M
	CALLS	#3,G^FCVALUES.R_MUL
	MOVG	R0,FCVALUES.EXP_VALUE.$T1
	PUSHAG	FCVALUES.EXP_VALUE.Y
	CALLS	#1,G^MTH$GSIN
	MOVG	R0,FCVALUES.EXP_VALUE.$T5
	PUSHAL	FCVALUES.EXP_VALUE.ERR
	PUSHAG	FCVALUES.EXP_VALUE.$T5
	PUSHAG	FCVALUES.EXP_VALUE.M
	CALLS	#3,G^FCVALUES.R_MUL
	MOVG	R0,FCVALUES.EXP_VALUE.$T4
	MOVG	FCVALUES.EXP_VALUE.$T1,@FCVALUES.EXP_VALUE.V(AP)
	MOVL	FCVALUES.EXP_VALUE.V(AP),R0
	MOVG	FCVALUES.EXP_VALUE.$T4,8(R0)
;  531      v%err = err
	MOVL	FCVALUES.EXP_VALUE.V(AP),R0
	MOVL	FCVALUES.EXP_VALUE.ERR,16(R0)
;  532    end function exp_value
	RET

; Storage map for FCVALUES.LOG_VALUE, a TYPE(VALUE) function
;   V     TYPE(VALUE)              hidden argument 1  @FCVALUES.LOG_VALUE.V(AP)
;   A     TYPE(VALUE), INTENT(IN)  argument 2         @FCVALUES.LOG_VALUE.A(AP)
;
FCVALUES.LOG_VALUE.V = 4		; V's value goes through hidden argument 1
FCVALUES.LOG_VALUE.A = 8		; A is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCVALUES.LOG_VALUE.$T1:
	.BLKL	8			; characters, for one statement
FCVALUES.LOG_VALUE.$T2:
	.BLKL	2			; temporary
FCVALUES.LOG_VALUE.$T3:
	.BLKL	2			; temporary
FCVALUES.LOG_VALUE.$T4:
	.BLKL	2			; temporary
FCVALUES.LOG_VALUE.$T5:
	.BLKL	2			; temporary
FCVALUES.LOG_VALUE.$T6:
	.BLKL	2			; temporary

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  533
;  534    ! LOG_VALUE is a nonzero value's principal logarithm,
;  535    !     ln z = ln |z| + i arg z,   arg z in (-pi, pi]
;  536    ! A complex number has infinitely many logarithms, 2 pi i apart; the
;  537    ! principal one takes the angle nearest zero, and the negative real axis,
;  538    ! where the angle jumps from pi to -pi, is its branch cut.
;  539    function log_value(a) result(v)
	.ENTRY	FCVALUES.LOG_VALUE,^M<R2,R3,R4,R5>
;  540      type(value), intent(in) :: a
;  541      type(value) :: v
;  542
;  543      v = complex_value(log(c_abs(a%z)), angle_of(aimag(a%z), real(a%z, rk)))
	PUSHAO	@FCVALUES.LOG_VALUE.A(AP)
	CALLS	#1,G^FCVALUES.C_ABS
	MOVG	R0,FCVALUES.LOG_VALUE.$T3
	PUSHAG	FCVALUES.LOG_VALUE.$T3
	CALLS	#1,G^MTH$GLOG
	MOVG	R0,FCVALUES.LOG_VALUE.$T2
	MOVL	FCVALUES.LOG_VALUE.A(AP),R0
	MOVG	8(R0),FCVALUES.LOG_VALUE.$T5
	MOVG	@FCVALUES.LOG_VALUE.A(AP),FCVALUES.LOG_VALUE.$T6
	PUSHAG	FCVALUES.LOG_VALUE.$T6
	PUSHAG	FCVALUES.LOG_VALUE.$T5
	CALLS	#2,G^FCVALUES.ANGLE_OF
	MOVG	R0,FCVALUES.LOG_VALUE.$T4
	PUSHAG	FCVALUES.LOG_VALUE.$T4
	PUSHAG	FCVALUES.LOG_VALUE.$T2
	PUSHAB	FCVALUES.LOG_VALUE.$T1
	CALLS	#3,G^FCVALUES.COMPLEX_VALUE
	MOVC3	#32,FCVALUES.LOG_VALUE.$T1,@FCVALUES.LOG_VALUE.V(AP)
;  544    end function log_value
	RET

; Storage map for FCVALUES.ANGLE_OF, a REAL*8 function
;   Y         REAL*8, INTENT(IN)  argument 1  @FCVALUES.ANGLE_OF.Y(AP)
;   X         REAL*8, INTENT(IN)  argument 2  @FCVALUES.ANGLE_OF.X(AP)
;   ANGLE_OF  REAL*8              R6          R6
;   R6 is $T1: temporary
;   R8 is $T2: temporary
;
FCVALUES.ANGLE_OF.Y = 4			; Y is argument 1
FCVALUES.ANGLE_OF.X = 8			; X is argument 2

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCVALUES.ANGLE_OF.$KF1:
	.LONG	^X7E921688,^XF7AC154E	; 1D-200
FCVALUES.ANGLE_OF.$KF2:
	.LONG	^X21FB4029,^X2D185444	; 3.141592653589793D0
FCVALUES.ANGLE_OF.$KF3:
	.LONG	^X21FBC029,^X2D185444	; -3.141592653589793D0
FCVALUES.ANGLE_OF.$KF4:
	.LONG	^X21FB4019,^X2D185444	; 1.5707963267948966D0
FCVALUES.ANGLE_OF.$KF5:
	.LONG	^X21FBC019,^X2D185444	; -1.5707963267948966D0

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  545
;  546    ! ANGLE_OF is ATAN2(Y, X) for a point other than the origin, where one
;  547    ! coordinate is so much smaller than the other that ATAN2 would
;  548    ! underflow, the angle to the axis it is on.
;  549    real(rk) function angle_of(y, x)
	.ENTRY	FCVALUES.ANGLE_OF,^M<R6,R7,R8,R9>
;  550      real(rk), intent(in) :: y, x
;  551
;  552      if (abs(y) < abs(x) * 1.0e-200_rk) then
	MOVG	@FCVALUES.ANGLE_OF.Y(AP),R6
	BGEQ	FCVALUES.ANGLE_OF.$1
	MNEGG	R6,R6
FCVALUES.ANGLE_OF.$1:
	MOVG	@FCVALUES.ANGLE_OF.X(AP),R8
	BGEQ	FCVALUES.ANGLE_OF.$3
	MNEGG	R8,R8
FCVALUES.ANGLE_OF.$3:
	MULG3	R8,FCVALUES.ANGLE_OF.$KF1,R0
	CMPG	R6,R0
	BGEQ	FCVALUES.ANGLE_OF.$5
;  553        angle_of = 0
	CLRG	R6
;  554        if (x < 0) then
	TSTG	@FCVALUES.ANGLE_OF.X(AP)
	BGEQ	FCVALUES.ANGLE_OF.$11
;  555          angle_of = pi
	MOVG	FCVALUES.ANGLE_OF.$KF2,R6 ; 3.141592653589793D0
;  556          if (y < 0) angle_of = -pi
	TSTG	@FCVALUES.ANGLE_OF.Y(AP)
	BGEQ	FCVALUES.ANGLE_OF.$11
	MOVG	FCVALUES.ANGLE_OF.$KF3,R6 ; -3.141592653589793D0
;  557        end if
;  558      else if (abs(x) < abs(y) * 1.0e-200_rk) then
	BRB	FCVALUES.ANGLE_OF.$11
FCVALUES.ANGLE_OF.$5:
	MOVG	@FCVALUES.ANGLE_OF.X(AP),R8
	BGEQ	FCVALUES.ANGLE_OF.$12
	MNEGG	R8,R8
FCVALUES.ANGLE_OF.$12:
	MOVG	@FCVALUES.ANGLE_OF.Y(AP),R6
	BGEQ	FCVALUES.ANGLE_OF.$14
	MNEGG	R6,R6
FCVALUES.ANGLE_OF.$14:
	MULG3	R6,FCVALUES.ANGLE_OF.$KF1,R0
	CMPG	R8,R0
	BGEQ	FCVALUES.ANGLE_OF.$16
;  559        angle_of = pi / 2
	MOVG	FCVALUES.ANGLE_OF.$KF4,R6 ; 1.5707963267948966D0
;  560        if (y < 0) angle_of = -pi / 2
	TSTG	@FCVALUES.ANGLE_OF.Y(AP)
	BGEQ	FCVALUES.ANGLE_OF.$11
	MOVG	FCVALUES.ANGLE_OF.$KF5,R6 ; -1.5707963267948966D0
;  561      else
	BRB	FCVALUES.ANGLE_OF.$11
FCVALUES.ANGLE_OF.$16:
;  562        angle_of = atan2(y, x)
	PUSHAG	@FCVALUES.ANGLE_OF.X(AP)
	PUSHAG	@FCVALUES.ANGLE_OF.Y(AP)
	CALLS	#2,G^MTH$GATAN2
	MOVG	R0,R6
;  563      end if
FCVALUES.ANGLE_OF.$11:
;  564    end function angle_of
	MOVG	R6,R0			; the function's value
	RET

; Storage map for FCVALUES.V_ABS, a TYPE(VALUE) function
