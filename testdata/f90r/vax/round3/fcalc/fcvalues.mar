;   83
;   84    ! ------------------------------------------------------------------
;   85    ! Making values.
;   86
;   87    ! A FUNCTION's RESULT clause names the variable that holds its value
;   88    ! (V here), so the function's own name needn't be used as one: needed
;   89    ! for a recursive function, and clearer anywhere. CMPLX(x, y, rk) makes a
;   90    ! complex number of kind RK; without the kind, CMPLX's result would be
;   91    ! the default kind, single precision, and digits would be lost.
;   92    function real_value(x) result(v)
	.ENTRY	FCVALUES.REAL_VALUE,^M<R2,R3,R4,R5>
;   93      real(rk), intent(in) :: x
;   94      type(value) :: v
;   95
;   96      v = clean(cmplx(x, 0.0_rk, rk))
	MOVG	@FCVALUES.REAL_VALUE.X(AP),FCVALUES.REAL_VALUE.$T2
	CLRG	FCVALUES.REAL_VALUE.$T2+8
	PUSHAO	FCVALUES.REAL_VALUE.$T2
	PUSHAB	FCVALUES.REAL_VALUE.$T1
	CALLS	#2,G^FCVALUES.CLEAN
	MOVC3	#32,FCVALUES.REAL_VALUE.$T1,@FCVALUES.REAL_VALUE.V(AP)
;   97    end function real_value
	RET

