	MOVL	FCVALUES.AUTO_TEXT.TEXT(AP),R0
	MOVC5	#1,FCVALUES.AUTO_TEXT.D,#^A/ /,#32,@4(R0)
;  843        if (k > 1) text = d(1:1) // '.' // d(2:k)
