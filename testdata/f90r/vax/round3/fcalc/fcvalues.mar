	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  228
;  229    real(rk) function r_div(x, y, err)
	.ENTRY	FCVALUES.R_DIV,^M<R6,R7>
;  230      real(rk), intent(in) :: x, y
;  231      integer, intent(inout) :: err
;  232      real(rk) :: ax, ay
;  233
;  234      r_div = 0
;  235      ax = abs(x)
	MOVG	@FCVALUES.R_DIV.X(AP),R6
	BGEQ	FCVALUES.R_DIV.$1
	MNEGG	R6,R6
FCVALUES.R_DIV.$1:
	MOVG	R6,FCVALUES.R_DIV.AX
;  236      ay = abs(y)
	MOVG	@FCVALUES.R_DIV.Y(AP),R6
	BGEQ	FCVALUES.R_DIV.$3
	MNEGG	R6,R6
FCVALUES.R_DIV.$3:
	MOVG	R6,FCVALUES.R_DIV.AY
;  237      if (ay == 0) then
	BNEQ	FCVALUES.R_DIV.$5
;  238        if (err == 0) err = e_divzero
	TSTL	@FCVALUES.R_DIV.ERR(AP)
	BNEQ	FCVALUES.R_DIV.$7
	MOVL	#9,@FCVALUES.R_DIV.ERR(AP)
FCVALUES.R_DIV.$7:
;  239        return
	MOVG	FCVALUES.R_DIV.$KF1,R0	; the function's value
	RET
FCVALUES.R_DIV.$5:
;  240      end if
;  241      if (ax == 0) return
	TSTG	FCVALUES.R_DIV.AX
	BNEQ	FCVALUES.R_DIV.$9
	MOVG	FCVALUES.R_DIV.$KF1,R0	; the function's value
	RET
FCVALUES.R_DIV.$9:
;  242
;  243      if (ay >= 1) then
	CMPG	FCVALUES.R_DIV.AY,S^#1.0
	BLSS	FCVALUES.R_DIV.$11
;  244        if (ax < small * ay) return
	MULG3	FCVALUES.R_DIV.$KF2,FCVALUES.R_DIV.AY,R0
