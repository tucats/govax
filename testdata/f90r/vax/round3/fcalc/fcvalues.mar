	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  899
;  900    ! FIXED_TEXT shows A (not negative) with DIGITS places after the point,
;  901    ! by Fortran's F editing: (F40.4) writes 3.14159... as 3.1416, rounded.
;  902    ! A number too small to show any digit is all zeros, 0.0000. One so large
;  903    ! that its digits before the point and the places after would pass the
;  904    ! MAX_DIGITS the kind holds is shown in scientific notation instead, with
;  905    ! as many digits after the point, so no digit is shown that the machines'
;  906    ! last bits could make differ. Fortran may write a number below 1 with
;  907    ! no zero before the point (.5000), and fcalc puts one there.
;  908    function fixed_text(a) result(text)
	.ENTRY	FCVALUES.FIXED_TEXT,^M<R2,R3,R4,R5,R6,R7,R8,R9>
;  909      real(rk), intent(in) :: a
;  910      character(len=32) :: text
;  911      character(len=40) :: buf
;  912      character(len=20) :: form
;  913
;  914      if (a < 0.5_rk * 10.0_rk ** (-digits)) then
	MNEGL	FCVALUES.DIGITS,R0
	PUSHL	R0
	MOVQ	FCVALUES.FIXED_TEXT.$KF1,-(SP)
	CALLS	#3,G^OTS$POWGJ
	MOVG	R0,R8
	MULG3	S^#0.5,R8,R0
	CMPG	@FCVALUES.FIXED_TEXT.A(AP),R0
	BLSS	FCVALUES.FIXED_TEXT.$2
	BRW	FCVALUES.FIXED_TEXT.$1
FCVALUES.FIXED_TEXT.$2:
;  915        text = '0.' // repeat('0', digits)
	MOVL	FCVALUES.DIGITS,FCVALUES.FIXED_TEXT.$T2
	PUSHAL	FCVALUES.FIXED_TEXT.$T2
	PUSHAQ	FCVALUES.FIXED_TEXT.$D2
	PUSHAQ	FCVALUES.FIXED_TEXT.$D1
	CALLS	#3,G^FTN$REPEAT
	MOVZWL	FCVALUES.FIXED_TEXT.$D1,R0
	ADDL2	#2,R0
	CVTLW	R0,FCVALUES.FIXED_TEXT.$T3
	PUSHAQ	FCVALUES.FIXED_TEXT.$D3
	PUSHAW	FCVALUES.FIXED_TEXT.$T3
	CALLS	#2,G^LIB$SGET1_DD
	MOVC3	#2,FCVALUES.FIXED_TEXT.$K1,@FCVALUES.FIXED_TEXT.$D3+4
	MOVZWL	FCVALUES.FIXED_TEXT.$D1,FCVALUES.FIXED_TEXT.$U1
	MOVL	FCVALUES.FIXED_TEXT.$D3+4,R0
	MOVC3	FCVALUES.FIXED_TEXT.$U1,@FCVALUES.FIXED_TEXT.$D1+4,2(R0)
	ADDL3	FCVALUES.FIXED_TEXT.$U1,#2,R0
	MOVL	FCVALUES.FIXED_TEXT.TEXT(AP),R1
	MOVC5	R0,@FCVALUES.FIXED_TEXT.$D3+4,#^A/ /,#32,@4(R1)
	PUSHAQ	FCVALUES.FIXED_TEXT.$D1
	CALLS	#1,G^LIB$SFREE1_DD
	PUSHAQ	FCVALUES.FIXED_TEXT.$D3
	CALLS	#1,G^LIB$SFREE1_DD
;  916        return
	RET
FCVALUES.FIXED_TEXT.$1:
;  917      end if
;  918      if (a >= 10.0_rk ** (max_digits - digits)) then
	SUBL3	FCVALUES.DIGITS,#15,R0
	PUSHL	R0
	MOVQ	FCVALUES.FIXED_TEXT.$KF1,-(SP)
	CALLS	#3,G^OTS$POWGJ
	MOVG	R0,R8
	CMPG	@FCVALUES.FIXED_TEXT.A(AP),R8
	BLSS	FCVALUES.FIXED_TEXT.$3
;  919        text = scientific_text(a, min(digits + 1, max_digits))
	ADDL3	FCVALUES.DIGITS,#1,FCVALUES.FIXED_TEXT.$T2
	CMPL	#15,FCVALUES.FIXED_TEXT.$T2
	BGEQ	FCVALUES.FIXED_TEXT.$5
	MOVL	#15,FCVALUES.FIXED_TEXT.$T2
FCVALUES.FIXED_TEXT.$5:
	PUSHAL	FCVALUES.FIXED_TEXT.$T2
	PUSHAG	@FCVALUES.FIXED_TEXT.A(AP)
	PUSHAQ	FCVALUES.FIXED_TEXT.$D4
	CALLS	#3,G^FCVALUES.SCIENTIFIC_TEXT
	MOVL	FCVALUES.FIXED_TEXT.TEXT(AP),R0
	MOVC3	#32,FCVALUES.FIXED_TEXT.$T4,@4(R0)
;  920        return
	RET
FCVALUES.FIXED_TEXT.$3:
