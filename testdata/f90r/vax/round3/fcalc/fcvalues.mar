; Storage map for FCVALUES.V_MOD, a TYPE(VALUE) function
;   V     TYPE(VALUE)              hidden argument 1  @FCVALUES.V_MOD.V(AP)
;   A     TYPE(VALUE), INTENT(IN)  argument 2         @FCVALUES.V_MOD.A(AP)
;   B     TYPE(VALUE), INTENT(IN)  argument 3         @FCVALUES.V_MOD.B(AP)
;   R     REAL*8                   $LOCAL+0           FCVALUES.V_MOD.R
;   D     REAL*8                   $LOCAL+8           FCVALUES.V_MOD.D
;   T     REAL*8                   $LOCAL+16          FCVALUES.V_MOD.T
;   R6 is $T1: temporary
;   R6 is $T4: temporary
;   R8 is $H1: a value computed before a loop
;   R6 is $R1: T, during a loop
;   R10 is $R2: R, during a loop
;
FCVALUES.V_MOD.V = 4			; V's value goes through hidden argument 1
FCVALUES.V_MOD.A = 8			; A is argument 2
FCVALUES.V_MOD.B = 12			; B is argument 3

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCVALUES.V_MOD.R:
	.BLKL	2			; R
FCVALUES.V_MOD.D:
	.BLKL	2			; D
FCVALUES.V_MOD.T:
	.BLKL	2			; T
FCVALUES.V_MOD.$T2:
	.BLKL	1			; temporary
FCVALUES.V_MOD.$T3:
	.BLKL	8			; characters, for one statement

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCVALUES.V_MOD.$K1:
	.LONG	12
FCVALUES.V_MOD.$K2:
	.LONG	9

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  577
;  578    ! V_MOD is A mod B, for real values: the remainder with the divisor's
;  579    ! sign, as MODULO's. It is computed exactly, by subtracting the divisor
;  580    ! doubled as often as fits, so a large quotient loses nothing.
;  581    function v_mod(a, b) result(v)
	.ENTRY	FCVALUES.V_MOD,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
;  582      type(value), intent(in) :: a, b
;  583      type(value) :: v
;  584      real(rk) :: r, d, t
;  585
;  586      if (pass_error(a, b, v)) return
	PUSHAB	@FCVALUES.V_MOD.V(AP)
	PUSHAB	@FCVALUES.V_MOD.B(AP)
	PUSHAB	@FCVALUES.V_MOD.A(AP)
	CALLS	#3,G^FCVALUES.PASS_ERROR
	MOVL	R0,R6
	BLBC	R6,FCVALUES.V_MOD.$1
	RET
FCVALUES.V_MOD.$1:
;  587      if (.not. (is_real(a) .and. is_real(b))) then
	PUSHAB	@FCVALUES.V_MOD.A(AP)
	CALLS	#1,G^FCVALUES.IS_REAL
	MOVL	R0,R6
	PUSHAB	@FCVALUES.V_MOD.B(AP)
	CALLS	#1,G^FCVALUES.IS_REAL
	MOVL	R0,FCVALUES.V_MOD.$T2
	BLBC	R6,FCVALUES.V_MOD.$4
	BLBS	FCVALUES.V_MOD.$T2,FCVALUES.V_MOD.$3
FCVALUES.V_MOD.$4:
;  588        v = error_value(e_notreal)
	PUSHAL	FCVALUES.V_MOD.$K1
	PUSHAB	FCVALUES.V_MOD.$T3
	CALLS	#2,G^FCVALUES.ERROR_VALUE
	MOVC3	#32,FCVALUES.V_MOD.$T3,@FCVALUES.V_MOD.V(AP)
;  589        return
	RET
FCVALUES.V_MOD.$3:
;  590      end if
;  591      d = abs(real(b%z, rk))
	MOVG	@FCVALUES.V_MOD.B(AP),R6
	BGEQ	FCVALUES.V_MOD.$7
	MNEGG	R6,R6
FCVALUES.V_MOD.$7:
	MOVG	R6,FCVALUES.V_MOD.D
;  592      if (d == 0) then
	BNEQ	FCVALUES.V_MOD.$9
;  593        v = error_value(e_divzero)
	PUSHAL	FCVALUES.V_MOD.$K2
	PUSHAB	FCVALUES.V_MOD.$T3
	CALLS	#2,G^FCVALUES.ERROR_VALUE
	MOVC3	#32,FCVALUES.V_MOD.$T3,@FCVALUES.V_MOD.V(AP)
;  594        return
	RET
FCVALUES.V_MOD.$9:
;  595      end if
;  596
;  597      r = abs(real(a%z, rk))
	MOVG	@FCVALUES.V_MOD.A(AP),R6
	BGEQ	FCVALUES.V_MOD.$11
	MNEGG	R6,R6
FCVALUES.V_MOD.$11:
	MOVG	R6,FCVALUES.V_MOD.R
;  598      do while (r >= d)
	MOVQ	FCVALUES.V_MOD.T,R6
	MOVQ	FCVALUES.V_MOD.R,R10
	BRB	FCVALUES.V_MOD.$13
FCVALUES.V_MOD.$14:			; DO (line 598)'s body
;  599        t = d
	MOVG	FCVALUES.V_MOD.D,R6
;  600        do while (t <= r / 2)
	DIVG3	S^#2.0,R10,R8		; from line 600
	BRB	FCVALUES.V_MOD.$15
FCVALUES.V_MOD.$16:			; DO (line 600)'s body
;  601          t = t * 2
	MULG2	S^#2.0,R6
;  602        end do
FCVALUES.V_MOD.$15:			; DO (line 600)'s test
	CMPG	R6,R8			; from line 600
	BLEQ	FCVALUES.V_MOD.$16
;  603        r = r - t
	SUBG2	R6,R10
;  604      end do
FCVALUES.V_MOD.$13:			; DO (line 598)'s test
	CMPG	R10,FCVALUES.V_MOD.D	; from line 598
	BGEQ	FCVALUES.V_MOD.$14
	MOVQ	R6,FCVALUES.V_MOD.T
	MOVQ	R10,FCVALUES.V_MOD.R
;  605
;  606      ! R is |A| mod |B|; give it the divisor's sign.
;  607      if (r /= 0 .and. real(a%z, rk) < 0) r = d - r
	TSTG	FCVALUES.V_MOD.R
	BEQL	FCVALUES.V_MOD.$19
	TSTG	@FCVALUES.V_MOD.A(AP)
	BGEQ	FCVALUES.V_MOD.$19
	SUBG3	FCVALUES.V_MOD.R,FCVALUES.V_MOD.D,FCVALUES.V_MOD.R
FCVALUES.V_MOD.$19:
;  608      if (real(b%z, rk) < 0 .and. r /= 0) r = r - d
	TSTG	@FCVALUES.V_MOD.B(AP)
	BGEQ	FCVALUES.V_MOD.$22
	TSTG	FCVALUES.V_MOD.R
	BEQL	FCVALUES.V_MOD.$22
	SUBG2	FCVALUES.V_MOD.D,FCVALUES.V_MOD.R
FCVALUES.V_MOD.$22:
;  609      v = real_value(r)
	PUSHAG	FCVALUES.V_MOD.R
	PUSHAB	FCVALUES.V_MOD.$T3
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCVALUES.V_MOD.$T3,@FCVALUES.V_MOD.V(AP)
;  610    end function v_mod
	RET

; Storage map for FCVALUES.V_FACTORIAL, a TYPE(VALUE) function
;   V     TYPE(VALUE)              hidden argument 1  @FCVALUES.V_FACTORIAL.V(AP)
;   A     TYPE(VALUE), INTENT(IN)  argument 2         @FCVALUES.V_FACTORIAL.A(AP)
;   N     INTEGER                  $LOCAL+0           FCVALUES.V_FACTORIAL.N
;   K     INTEGER                  $LOCAL+4           FCVALUES.V_FACTORIAL.K
;   X     REAL*8                   $LOCAL+8           FCVALUES.V_FACTORIAL.X
;   R6 is $T1: temporary
;   R8 is $L1: DO (line 644)'s limit
;   R6 is $R1: K, during a loop
;   R7 is $R2: V's address
;
FCVALUES.V_FACTORIAL.V = 4		; V's value goes through hidden argument 1
FCVALUES.V_FACTORIAL.A = 8		; A is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCVALUES.V_FACTORIAL.N:
	.BLKL	1			; N
FCVALUES.V_FACTORIAL.K:
	.BLKL	1			; K
FCVALUES.V_FACTORIAL.X:
	.BLKL	2			; X
FCVALUES.V_FACTORIAL.$T2:
	.BLKL	8			; characters, for one statement
FCVALUES.V_FACTORIAL.$T3:
	.BLKL	2			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCVALUES.V_FACTORIAL.$K1:
	.LONG	12
FCVALUES.V_FACTORIAL.$K2:
	.LONG	16
FCVALUES.V_FACTORIAL.$K3:
	.LONG	11
FCVALUES.V_FACTORIAL.$K4:
	.LONG	10
FCVALUES.V_FACTORIAL.$KF1:
	.LONG	^X00004089,^X00000000	; 200D0

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  611
;  612    ! V_FACTORIAL is N!, for a whole N from 0 up.
;  613    function v_factorial(a) result(v)
	.ENTRY	FCVALUES.V_FACTORIAL,^M<R2,R3,R4,R5,R6,R7,R8>
;  614      type(value), intent(in) :: a
;  615      type(value) :: v
;  616      integer :: n, k
;  617      real(rk) :: x
;  618
;  619      if (a%err /= 0) then
	MOVL	FCVALUES.V_FACTORIAL.A(AP),R0
	TSTL	16(R0)
	BEQL	FCVALUES.V_FACTORIAL.$1
;  620        v = a
	MOVC3	#32,@FCVALUES.V_FACTORIAL.A(AP),@FCVALUES.V_FACTORIAL.V(AP)
;  621        return
	RET
FCVALUES.V_FACTORIAL.$1:
;  622      end if
;  623      if (.not. is_real(a)) then
	PUSHAB	@FCVALUES.V_FACTORIAL.A(AP)
	CALLS	#1,G^FCVALUES.IS_REAL
	MOVL	R0,R6
	BLBS	R6,FCVALUES.V_FACTORIAL.$3
;  624        v = error_value(e_notreal)
	PUSHAL	FCVALUES.V_FACTORIAL.$K1
	PUSHAB	FCVALUES.V_FACTORIAL.$T2
	CALLS	#2,G^FCVALUES.ERROR_VALUE
	MOVC3	#32,FCVALUES.V_FACTORIAL.$T2,@FCVALUES.V_FACTORIAL.V(AP)
;  625        return
	RET
FCVALUES.V_FACTORIAL.$3:
;  626      end if
;  627      if (.not. is_whole(a)) then
	PUSHAB	@FCVALUES.V_FACTORIAL.A(AP)
	CALLS	#1,G^FCVALUES.IS_WHOLE
	MOVL	R0,R6
	BLBS	R6,FCVALUES.V_FACTORIAL.$5
;  628        v = error_value(e_notwhole)
	PUSHAL	FCVALUES.V_FACTORIAL.$K2
	PUSHAB	FCVALUES.V_FACTORIAL.$T2
	CALLS	#2,G^FCVALUES.ERROR_VALUE
	MOVC3	#32,FCVALUES.V_FACTORIAL.$T2,@FCVALUES.V_FACTORIAL.V(AP)
;  629        return
	RET
FCVALUES.V_FACTORIAL.$5:
;  630      end if
;  631      x = real(a%z, rk)
	MOVG	@FCVALUES.V_FACTORIAL.A(AP),FCVALUES.V_FACTORIAL.X
;  632      if (x < 0) then
	BGEQ	FCVALUES.V_FACTORIAL.$7
;  633        v = error_value(e_domain)
	PUSHAL	FCVALUES.V_FACTORIAL.$K3
	PUSHAB	FCVALUES.V_FACTORIAL.$T2
	CALLS	#2,G^FCVALUES.ERROR_VALUE
	MOVC3	#32,FCVALUES.V_FACTORIAL.$T2,@FCVALUES.V_FACTORIAL.V(AP)
;  634        return
	RET
FCVALUES.V_FACTORIAL.$7:
;  635      end if
;  636      if (x > 200) then
	CMPG	FCVALUES.V_FACTORIAL.X,FCVALUES.V_FACTORIAL.$KF1
	BLEQ	FCVALUES.V_FACTORIAL.$9
;  637        v = error_value(e_overflow)
	PUSHAL	FCVALUES.V_FACTORIAL.$K4
	PUSHAB	FCVALUES.V_FACTORIAL.$T2
	CALLS	#2,G^FCVALUES.ERROR_VALUE
	MOVC3	#32,FCVALUES.V_FACTORIAL.$T2,@FCVALUES.V_FACTORIAL.V(AP)
;  638        return
	RET
FCVALUES.V_FACTORIAL.$9:
;  639      end if
;  640
;  641      n = nint(x)
	CVTRGL	FCVALUES.V_FACTORIAL.X,FCVALUES.V_FACTORIAL.N
;  642      v%err = 0
	MOVL	FCVALUES.V_FACTORIAL.V(AP),R0
	CLRL	16(R0)
;  643      x = 1
	MOVG	S^#1.0,FCVALUES.V_FACTORIAL.X ; 1D0
;  644      do k = 2, n
	MOVL	FCVALUES.V_FACTORIAL.N,R8 ; DO (line 644)'s limit
	MOVL	#2,FCVALUES.V_FACTORIAL.K
	CMPL	#2,R8
	BGTR	FCVALUES.V_FACTORIAL.$11
	MOVL	FCVALUES.V_FACTORIAL.K,R6
	MOVL	FCVALUES.V_FACTORIAL.V(AP),R7
FCVALUES.V_FACTORIAL.$13:		; DO (line 644)'s body
;  645        x = r_mul(x, real(k, rk), v%err)
	CVTLG	R6,FCVALUES.V_FACTORIAL.$T3
	PUSHAL	16(R7)
	PUSHAG	FCVALUES.V_FACTORIAL.$T3
	PUSHAG	FCVALUES.V_FACTORIAL.X
	CALLS	#3,G^FCVALUES.R_MUL
	MOVG	R0,FCVALUES.V_FACTORIAL.X
;  646      end do
	AOBLEQ	R8,R6,FCVALUES.V_FACTORIAL.$13
	MOVL	R6,FCVALUES.V_FACTORIAL.K
FCVALUES.V_FACTORIAL.$11:
;  647      if (v%err == 0) v = real_value(x)
	MOVL	FCVALUES.V_FACTORIAL.V(AP),R0
	TSTL	16(R0)
	BNEQ	FCVALUES.V_FACTORIAL.$15
	PUSHAG	FCVALUES.V_FACTORIAL.X
	PUSHAB	FCVALUES.V_FACTORIAL.$T2
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCVALUES.V_FACTORIAL.$T2,@FCVALUES.V_FACTORIAL.V(AP)
FCVALUES.V_FACTORIAL.$15:
;  648    end function v_factorial
	RET

; Storage map for FCVALUES.V_COMPARE, a TYPE(VALUE) function
;   V         TYPE(VALUE)              hidden argument 1  @FCVALUES.V_COMPARE.V(AP)
;   A         TYPE(VALUE), INTENT(IN)  argument 2         @FCVALUES.V_COMPARE.A(AP)
;   B         TYPE(VALUE), INTENT(IN)  argument 3         @FCVALUES.V_COMPARE.B(AP)
;   RELATION  INTEGER, INTENT(IN)      argument 4         @FCVALUES.V_COMPARE.RELATION(AP)
;   SAME      LOGICAL                  $LOCAL+0           FCVALUES.V_COMPARE.SAME
;   LESS      LOGICAL                  $LOCAL+4           FCVALUES.V_COMPARE.LESS
;   X         REAL*8                   $LOCAL+8           FCVALUES.V_COMPARE.X
;   Y         REAL*8                   $LOCAL+16          FCVALUES.V_COMPARE.Y
;
FCVALUES.V_COMPARE.V = 4		; V's value goes through hidden argument 1
FCVALUES.V_COMPARE.A = 8		; A is argument 2
FCVALUES.V_COMPARE.B = 12		; B is argument 3
FCVALUES.V_COMPARE.RELATION = 16	; RELATION is argument 4

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCVALUES.V_COMPARE.SAME:
	.BLKL	1			; SAME
FCVALUES.V_COMPARE.LESS:
	.BLKL	1			; LESS
FCVALUES.V_COMPARE.X:
	.BLKL	2			; X
FCVALUES.V_COMPARE.Y:
	.BLKL	2			; Y
FCVALUES.V_COMPARE.$T1:
	.BLKL	1			; temporary
FCVALUES.V_COMPARE.$T2:
	.BLKL	2			; temporary
FCVALUES.V_COMPARE.$T3:
	.BLKL	2			; temporary
FCVALUES.V_COMPARE.$T4:
	.BLKL	1			; temporary
FCVALUES.V_COMPARE.$T5:
	.BLKL	2			; temporary
FCVALUES.V_COMPARE.$T6:
	.BLKL	2			; temporary
FCVALUES.V_COMPARE.$T7:
	.BLKL	8			; characters, for one statement

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  649
;  650    ! V_COMPARE compares two values by a relation, 1 to 6: ==, <>, <, <=, >,
;  651    ! >=. Equality is the whole value's, to within TOLERANCE; the order is
;  652    ! the real parts'. The result is 1 for true and 0 for false.
;  653    function v_compare(a, b, relation) result(v)
	.ENTRY	FCVALUES.V_COMPARE,^M<R2,R3,R4,R5>
;  654      type(value), intent(in) :: a, b
;  655      integer, intent(in) :: relation
;  656      type(value) :: v
;  657      logical :: same, less
;  658      real(rk) :: x, y
;  659
;  660      if (pass_error(a, b, v)) return
	PUSHAB	@FCVALUES.V_COMPARE.V(AP)
	PUSHAB	@FCVALUES.V_COMPARE.B(AP)
	PUSHAB	@FCVALUES.V_COMPARE.A(AP)
	CALLS	#3,G^FCVALUES.PASS_ERROR
	MOVL	R0,FCVALUES.V_COMPARE.$T1
	BLBC	FCVALUES.V_COMPARE.$T1,FCVALUES.V_COMPARE.$1
	RET
FCVALUES.V_COMPARE.$1:
;  661      same = near(real(a%z, rk), real(b%z, rk)) .and. near(aimag(a%z), aimag(b%z))
	MOVG	@FCVALUES.V_COMPARE.A(AP),FCVALUES.V_COMPARE.$T2
	MOVG	@FCVALUES.V_COMPARE.B(AP),FCVALUES.V_COMPARE.$T3
	PUSHAG	FCVALUES.V_COMPARE.$T3
	PUSHAG	FCVALUES.V_COMPARE.$T2
	CALLS	#2,G^FCVALUES.NEAR
	MOVL	R0,FCVALUES.V_COMPARE.$T1
	MOVL	FCVALUES.V_COMPARE.A(AP),R0
	MOVG	8(R0),FCVALUES.V_COMPARE.$T5
	MOVL	FCVALUES.V_COMPARE.B(AP),R0
	MOVG	8(R0),FCVALUES.V_COMPARE.$T6
	PUSHAG	FCVALUES.V_COMPARE.$T6
	PUSHAG	FCVALUES.V_COMPARE.$T5
	CALLS	#2,G^FCVALUES.NEAR
	MOVL	R0,FCVALUES.V_COMPARE.$T4
	MCOML	FCVALUES.V_COMPARE.$T4,R0
	BICL3	R0,FCVALUES.V_COMPARE.$T1,FCVALUES.V_COMPARE.SAME
;  662      x = real(a%z, rk)
	MOVG	@FCVALUES.V_COMPARE.A(AP),FCVALUES.V_COMPARE.X
;  663      y = real(b%z, rk)
	MOVG	@FCVALUES.V_COMPARE.B(AP),FCVALUES.V_COMPARE.Y
;  664      less = x < y .and. .not. near(x, y)
	PUSHAG	FCVALUES.V_COMPARE.Y
	PUSHAG	FCVALUES.V_COMPARE.X
	CALLS	#2,G^FCVALUES.NEAR
	MOVL	R0,FCVALUES.V_COMPARE.$T4
	CLRL	R0
	CMPG	FCVALUES.V_COMPARE.X,FCVALUES.V_COMPARE.Y
	BGEQ	FCVALUES.V_COMPARE.$3
	MNEGL	#1,R0
FCVALUES.V_COMPARE.$3:
	BICL3	FCVALUES.V_COMPARE.$T4,R0,FCVALUES.V_COMPARE.LESS
;  665      select case (relation)
	CASEL	@FCVALUES.V_COMPARE.RELATION(AP),#1,#4
FCVALUES.V_COMPARE.$4:
	.WORD	FCVALUES.V_COMPARE.$5-FCVALUES.V_COMPARE.$4
	.WORD	FCVALUES.V_COMPARE.$6-FCVALUES.V_COMPARE.$4
	.WORD	FCVALUES.V_COMPARE.$7-FCVALUES.V_COMPARE.$4
	.WORD	FCVALUES.V_COMPARE.$8-FCVALUES.V_COMPARE.$4
	.WORD	FCVALUES.V_COMPARE.$9-FCVALUES.V_COMPARE.$4
	BRW	FCVALUES.V_COMPARE.$10
FCVALUES.V_COMPARE.$5:
;  666      case (1)
;  667        v = logical_value(same)
	PUSHAL	FCVALUES.V_COMPARE.SAME
	PUSHAB	FCVALUES.V_COMPARE.$T7
	CALLS	#2,G^FCVALUES.LOGICAL_VALUE
	MOVC3	#32,FCVALUES.V_COMPARE.$T7,@FCVALUES.V_COMPARE.V(AP)
;  668      case (2)
	RET
FCVALUES.V_COMPARE.$6:
;  669        v = logical_value(.not. same)
	MCOML	FCVALUES.V_COMPARE.SAME,FCVALUES.V_COMPARE.$T4
	PUSHAL	FCVALUES.V_COMPARE.$T4
	PUSHAB	FCVALUES.V_COMPARE.$T7
	CALLS	#2,G^FCVALUES.LOGICAL_VALUE
	MOVC3	#32,FCVALUES.V_COMPARE.$T7,@FCVALUES.V_COMPARE.V(AP)
;  670      case (3)
	RET
FCVALUES.V_COMPARE.$7:
;  671        v = logical_value(less)
	PUSHAL	FCVALUES.V_COMPARE.LESS
	PUSHAB	FCVALUES.V_COMPARE.$T7
	CALLS	#2,G^FCVALUES.LOGICAL_VALUE
	MOVC3	#32,FCVALUES.V_COMPARE.$T7,@FCVALUES.V_COMPARE.V(AP)
;  672      case (4)
	RET
FCVALUES.V_COMPARE.$8:
;  673        v = logical_value(less .or. near(x, y))
	PUSHAG	FCVALUES.V_COMPARE.Y
	PUSHAG	FCVALUES.V_COMPARE.X
	CALLS	#2,G^FCVALUES.NEAR
	MOVL	R0,FCVALUES.V_COMPARE.$T4
	BISL3	FCVALUES.V_COMPARE.LESS,FCVALUES.V_COMPARE.$T4,FCVALUES.V_COMPARE.$T1
	PUSHAL	FCVALUES.V_COMPARE.$T1
	PUSHAB	FCVALUES.V_COMPARE.$T7
	CALLS	#2,G^FCVALUES.LOGICAL_VALUE
	MOVC3	#32,FCVALUES.V_COMPARE.$T7,@FCVALUES.V_COMPARE.V(AP)
;  674      case (5)
	RET
FCVALUES.V_COMPARE.$9:
;  675        v = logical_value(.not. (less .or. near(x, y)))
	PUSHAG	FCVALUES.V_COMPARE.Y
	PUSHAG	FCVALUES.V_COMPARE.X
	CALLS	#2,G^FCVALUES.NEAR
	MOVL	R0,FCVALUES.V_COMPARE.$T1
	BISL3	FCVALUES.V_COMPARE.LESS,FCVALUES.V_COMPARE.$T1,R0
	MCOML	R0,FCVALUES.V_COMPARE.$T4
	PUSHAL	FCVALUES.V_COMPARE.$T4
	PUSHAB	FCVALUES.V_COMPARE.$T7
	CALLS	#2,G^FCVALUES.LOGICAL_VALUE
	MOVC3	#32,FCVALUES.V_COMPARE.$T7,@FCVALUES.V_COMPARE.V(AP)
;  676      case default
	RET
FCVALUES.V_COMPARE.$10:
;  677        v = logical_value(.not. less)
	MCOML	FCVALUES.V_COMPARE.LESS,FCVALUES.V_COMPARE.$T4
	PUSHAL	FCVALUES.V_COMPARE.$T4
	PUSHAB	FCVALUES.V_COMPARE.$T7
	CALLS	#2,G^FCVALUES.LOGICAL_VALUE
	MOVC3	#32,FCVALUES.V_COMPARE.$T7,@FCVALUES.V_COMPARE.V(AP)
;  678      end select
;  679    end function v_compare
	RET

; Storage map for FCVALUES.NEAR, a LOGICAL function
;   X     REAL*8, INTENT(IN)  argument 1  @FCVALUES.NEAR.X(AP)
;   Y     REAL*8, INTENT(IN)  argument 2  @FCVALUES.NEAR.Y(AP)
;   NEAR  LOGICAL             $LOCAL+0    FCVALUES.NEAR.NEAR
;
FCVALUES.NEAR.X = 4			; X is argument 1
FCVALUES.NEAR.Y = 8			; Y is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCVALUES.NEAR.NEAR:
	.BLKL	1			; NEAR, the function's value

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCVALUES.NEAR.$K1:
	.LONG	^X00003D30,^X00000000	; 1.4210854715202004D-14

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  680
;  681    logical function near(x, y)
	.ENTRY	FCVALUES.NEAR,^M<>
;  682      real(rk), intent(in) :: x, y
;  683
;  684      near = near_to(x, y, tolerance)
	PUSHAG	FCVALUES.NEAR.$K1
	PUSHAG	@FCVALUES.NEAR.Y(AP)
	PUSHAG	@FCVALUES.NEAR.X(AP)
	CALLS	#3,G^FCVALUES.NEAR_TO
	MOVL	R0,FCVALUES.NEAR.NEAR
;  685    end function near
	MOVL	FCVALUES.NEAR.NEAR,R0	; the function's value
	RET

; Storage map for FCVALUES.NEAR_TO, a LOGICAL function
;   X        REAL*8, INTENT(IN)  argument 1  @FCVALUES.NEAR_TO.X(AP)
;   Y        REAL*8, INTENT(IN)  argument 2  @FCVALUES.NEAR_TO.Y(AP)
;   TOL      REAL*8, INTENT(IN)  argument 3  @FCVALUES.NEAR_TO.TOL(AP)
;   NEAR_TO  LOGICAL             R6          R6
;   D        REAL*8              $LOCAL+4    FCVALUES.NEAR_TO.D
;   M        REAL*8              $LOCAL+12   FCVALUES.NEAR_TO.M
;   R6 is $T1: temporary
;   R6 is $T2: temporary
;   R8 is $T3: temporary
;
FCVALUES.NEAR_TO.X = 4			; X is argument 1
FCVALUES.NEAR_TO.Y = 8			; Y is argument 2
FCVALUES.NEAR_TO.TOL = 12		; TOL is argument 3

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
	.BLKB	4
FCVALUES.NEAR_TO.D:
	.BLKL	2			; D
FCVALUES.NEAR_TO.M:
	.BLKL	2			; M

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  686
;  687    ! NEAR_TO: X and Y differ by no more than the part TOL of the larger.
;  688    ! (Values within LIMIT can't overflow in X - Y; TOL is well above EPS, so
;  689    ! TOL times the larger can't underflow but where both are near SMALL,
;  690    ! when the test is made as a quotient.)
;  691    logical function near_to(x, y, tol)
	.ENTRY	FCVALUES.NEAR_TO,^M<R2,R6,R7,R8,R9>
;  692      real(rk), intent(in) :: x, y, tol
;  693      real(rk) :: d, m
;  694
;  695      d = abs(x - y)
	SUBG3	@FCVALUES.NEAR_TO.Y(AP),@FCVALUES.NEAR_TO.X(AP),R6
	BGEQ	FCVALUES.NEAR_TO.$1
	MNEGG	R6,R6
FCVALUES.NEAR_TO.$1:
	MOVG	R6,FCVALUES.NEAR_TO.D
;  696      m = max(abs(x), abs(y))
	MOVG	@FCVALUES.NEAR_TO.X(AP),R6
	BGEQ	FCVALUES.NEAR_TO.$3
	MNEGG	R6,R6
FCVALUES.NEAR_TO.$3:
	MOVG	@FCVALUES.NEAR_TO.Y(AP),R8
	BGEQ	FCVALUES.NEAR_TO.$5
	MNEGG	R8,R8
FCVALUES.NEAR_TO.$5:
	CMPG	R8,R6
	BLEQ	FCVALUES.NEAR_TO.$7
	MOVG	R8,R6
FCVALUES.NEAR_TO.$7:
	MOVG	R6,FCVALUES.NEAR_TO.M
;  697      if (m >= 1) then
	CMPG	FCVALUES.NEAR_TO.M,S^#1.0
	BLSS	FCVALUES.NEAR_TO.$9
;  698        near_to = d <= tol * m
	MULG3	@FCVALUES.NEAR_TO.TOL(AP),FCVALUES.NEAR_TO.M,R0
	CLRL	R2
	CMPG	FCVALUES.NEAR_TO.D,R0
	BGTR	FCVALUES.NEAR_TO.$11
	MNEGL	#1,R2
FCVALUES.NEAR_TO.$11:
	MOVL	R2,R6
;  699      else
	BRB	FCVALUES.NEAR_TO.$12
FCVALUES.NEAR_TO.$9:
;  700        near_to = d / tol <= m
	DIVG3	@FCVALUES.NEAR_TO.TOL(AP),FCVALUES.NEAR_TO.D,R0
	CLRL	R2
	CMPG	R0,FCVALUES.NEAR_TO.M
	BGTR	FCVALUES.NEAR_TO.$13
	MNEGL	#1,R2
FCVALUES.NEAR_TO.$13:
	MOVL	R2,R6
;  701      end if
FCVALUES.NEAR_TO.$12:
;  702    end function near_to
	MOVL	R6,R0			; the function's value
	RET

; Storage map for FCVALUES.PASS_ERROR, a LOGICAL function
;   A           TYPE(VALUE), INTENT(IN)   argument 1  @FCVALUES.PASS_ERROR.A(AP)
;   B           TYPE(VALUE), INTENT(IN)   argument 2  @FCVALUES.PASS_ERROR.B(AP)
;   V           TYPE(VALUE), INTENT(OUT)  argument 3  @FCVALUES.PASS_ERROR.V(AP)
;   PASS_ERROR  LOGICAL                   R6          R6
;
FCVALUES.PASS_ERROR.A = 4		; A is argument 1
FCVALUES.PASS_ERROR.B = 8		; B is argument 2
FCVALUES.PASS_ERROR.V = 12		; V is argument 3

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  703
;  704    ! PASS_ERROR: if A or B has an error, V is that value and the result is
;  705    ! true.
;  706    logical function pass_error(a, b, v)
	.ENTRY	FCVALUES.PASS_ERROR,^M<R2,R3,R4,R5,R6>
;  707      type(value), intent(in) :: a, b
;  708      type(value), intent(out) :: v
;  709
;  710      pass_error = .true.
	MOVL	#-1,R6
;  711      if (a%err /= 0) then
	MOVL	FCVALUES.PASS_ERROR.A(AP),R0
	TSTL	16(R0)
	BEQL	FCVALUES.PASS_ERROR.$1
;  712        v = a
	MOVC3	#32,@FCVALUES.PASS_ERROR.A(AP),@FCVALUES.PASS_ERROR.V(AP)
;  713      else if (b%err /= 0) then
	BRB	FCVALUES.PASS_ERROR.$3
FCVALUES.PASS_ERROR.$1:
	MOVL	FCVALUES.PASS_ERROR.B(AP),R0
	TSTL	16(R0)
	BEQL	FCVALUES.PASS_ERROR.$4
;  714        v = b
	MOVC3	#32,@FCVALUES.PASS_ERROR.B(AP),@FCVALUES.PASS_ERROR.V(AP)
;  715      else
	BRB	FCVALUES.PASS_ERROR.$3
FCVALUES.PASS_ERROR.$4:
;  716        pass_error = .false.
	CLRL	R6
;  717        v%err = 0
	MOVL	FCVALUES.PASS_ERROR.V(AP),R0
	CLRL	16(R0)
;  718        v%z = (0.0_rk, 0.0_rk)
	CLRO	@FCVALUES.PASS_ERROR.V(AP)
;  719      end if
FCVALUES.PASS_ERROR.$3:
;  720    end function pass_error
	MOVL	R6,R0			; the function's value
	RET

; Storage map for FCVALUES.FORMAT_REAL, a CHARACTER*32 function
;   TEXT  CHARACTER*32        hidden argument 1  @FCVALUES.FORMAT_REAL.TEXT(AP)
;   X     REAL*8, INTENT(IN)  argument 2         @FCVALUES.FORMAT_REAL.X(AP)
