;  861      else
	BRB	FCVALUES.SCIENTIFIC_TEXT.$3
FCVALUES.SCIENTIFIC_TEXT.$1:
;  862        call decimal_digits(a, n, d, ex)
	PUSHAL	FCVALUES.SCIENTIFIC_TEXT.EX
	PUSHAQ	FCVALUES.SCIENTIFIC_TEXT.$D3
	PUSHAL	@FCVALUES.SCIENTIFIC_TEXT.N(AP)
	PUSHAG	@FCVALUES.SCIENTIFIC_TEXT.A(AP)
	CALLS	#4,G^FCVALUES.DECIMAL_DIGITS
;  863      end if
FCVALUES.SCIENTIFIC_TEXT.$3:
;  864      text = d(1:1)
	MOVL	FCVALUES.SCIENTIFIC_TEXT.TEXT(AP),R0
	MOVC5	#1,FCVALUES.SCIENTIFIC_TEXT.D,#^A/ /,#32,@4(R0)
;  865      if (n > 1) text = d(1:1) // '.' // d(2:n)
	CMPL	@FCVALUES.SCIENTIFIC_TEXT.N(AP),#1
	BLEQ	FCVALUES.SCIENTIFIC_TEXT.$4
	SUBL3	#1,@FCVALUES.SCIENTIFIC_TEXT.N(AP),FCVALUES.SCIENTIFIC_TEXT.$T1
