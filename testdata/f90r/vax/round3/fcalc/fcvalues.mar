FCVALUES.ENGINEERING_TEXT.$21:
	SUBL3	FCVALUES.ENGINEERING_TEXT.SHIFT,FCVALUES.ENGINEERING_TEXT.EX,FCVALUES.ENGINEERING_TEXT.$T7
	PUSHAL	FCVALUES.ENGINEERING_TEXT.$T7
	PUSHAQ	FCVALUES.ENGINEERING_TEXT.$D5
	CALLS	#2,G^FCVALUES.EXPONENT_TEXT
	ADDL3	R6,#6,R0
	CVTLW	R0,FCVALUES.ENGINEERING_TEXT.$T3
	PUSHAQ	FCVALUES.ENGINEERING_TEXT.$D4
	PUSHAW	FCVALUES.ENGINEERING_TEXT.$T3
	CALLS	#2,G^LIB$SGET1_DD
	MOVC3	R6,@FCVALUES.ENGINEERING_TEXT.$T1,@FCVALUES.ENGINEERING_TEXT.$D4+4
