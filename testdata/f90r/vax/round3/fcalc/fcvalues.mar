; Storage map for FCVALUES.V_POWER, a RECURSIVE TYPE(VALUE) function
;   V     TYPE(VALUE)              hidden argument 1  @FCVALUES.V_POWER.V(AP)
;   A     TYPE(VALUE), INTENT(IN)  argument 2         @FCVALUES.V_POWER.A(AP)
;   B     TYPE(VALUE), INTENT(IN)  argument 3         @FCVALUES.V_POWER.B(AP)
;   BASE  TYPE(VALUE)              FP-168             FCVALUES.V_POWER.BASE(FP)
;   N     INTEGER                  R6                 R6
;   X     REAL*8                   FP-132             FCVALUES.V_POWER.X(FP)
;   T     REAL*8                   FP-124             FCVALUES.V_POWER.T(FP)
;   R7 is $T1: temporary
;   R7 is $R1: V's address
;
FCVALUES.V_POWER.V = 4			; V's value goes through hidden argument 1
FCVALUES.V_POWER.A = 8			; A is argument 2
FCVALUES.V_POWER.B = 12			; B is argument 3
FCVALUES.V_POWER.BASE = -168		; BASE, in the frame
FCVALUES.V_POWER.X = -132		; X, in the frame
FCVALUES.V_POWER.T = -124		; T, in the frame
FCVALUES.V_POWER.$T2 = -116		; temporary, in the frame
FCVALUES.V_POWER.$T3 = -108		; characters, for one statement, in the frame
FCVALUES.V_POWER.$T4 = -76		; characters, for one statement, in the frame
FCVALUES.V_POWER.$T5 = -44		; temporary, in the frame
FCVALUES.V_POWER.$T6 = -40		; temporary, in the frame
FCVALUES.V_POWER.$T7 = -32		; characters, for one statement, in the frame

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCVALUES.V_POWER.$K1:
	.LONG	^X00004010,^X00000000	; 1D0
FCVALUES.V_POWER.$K2:
	.LONG	9
FCVALUES.V_POWER.$K3:
	.LONG	^X00000000,^X00000000	; 0D0
FCVALUES.V_POWER.$K4:
	.LONG	11
FCVALUES.V_POWER.$KF1:
	.LONG	^XCD6541ED,^X00000000	; 1D09

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  421
;  422    ! V_POWER is A ** B, fcalc's ^: a whole power by repeated squaring (so
;  423    ! 2^10 is exactly 1024), a positive real number's real power by EXP and
;  424    ! LOG, and anything else as EXP(B * LOG(A)) with LOG's principal branch,
;  425    ! so (-8)^(1/3) is 1 + 1.73205080757i.
;  426    !
;  427    ! Repeated squaring computes a**n in about log2(n) multiplications rather
;  428    ! than n: n's binary digits are read from the lowest, BASE is squared at
;  429    ! each step (a, a**2, a**4, a**8, ...), and multiplied into the result
;  430    ! where a digit is 1. For n = 10 (binary 1010): a**2 * a**8.
;  431    !
;  432    ! RECURSIVE: V_POWER uses the operators *, /, which are other functions,
;  433    ! and (through EXP_VALUE and LOG_VALUE) may come back to itself; a
;  434    ! procedure that may be active twice at once must say RECURSIVE in
;  435    ! Fortran 90, so the compiler gives each activation its own variables.
;  436    recursive function v_power(a, b) result(v)
	.ENTRY	FCVALUES.V_POWER,^M<R2,R3,R4,R5,R6,R7>
	SUBL2	#168,SP			; this activation's own storage
;  437      type(value), intent(in) :: a, b
;  438      type(value) :: v
;  439      type(value) :: base
;  440      integer :: n
;  441      real(rk) :: x, t
;  442
;  443      if (pass_error(a, b, v)) return
	PUSHAB	@FCVALUES.V_POWER.V(AP)
	PUSHAB	@FCVALUES.V_POWER.B(AP)
	PUSHAB	@FCVALUES.V_POWER.A(AP)
	CALLS	#3,G^FCVALUES.PASS_ERROR
	MOVL	R0,R7
	BLBC	R7,FCVALUES.V_POWER.$1
	RET
FCVALUES.V_POWER.$1:
;  444
;  445      if (is_whole(b) .and. abs(real(b%z, rk)) <= 1.0e9_rk) then
	PUSHAB	@FCVALUES.V_POWER.B(AP)
	CALLS	#1,G^FCVALUES.IS_WHOLE
	MOVL	R0,R7
	MOVG	@FCVALUES.V_POWER.B(AP),FCVALUES.V_POWER.$T2(FP)
	BGEQ	FCVALUES.V_POWER.$3
	MNEGG	FCVALUES.V_POWER.$T2(FP),FCVALUES.V_POWER.$T2(FP)
FCVALUES.V_POWER.$3:
	BLBS	R7,FCVALUES.V_POWER.$6
	BRW	FCVALUES.V_POWER.$5
FCVALUES.V_POWER.$6:
	CMPG	FCVALUES.V_POWER.$T2(FP),FCVALUES.V_POWER.$KF1
	BLEQ	FCVALUES.V_POWER.$7
	BRW	FCVALUES.V_POWER.$5
FCVALUES.V_POWER.$7:
;  446        n = nint(real(b%z, rk))
	CVTRGL	@FCVALUES.V_POWER.B(AP),R6
;  447        v = real_value(1.0_rk)
	PUSHAG	FCVALUES.V_POWER.$K1
	PUSHAB	FCVALUES.V_POWER.$T3(FP)
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCVALUES.V_POWER.$T3(FP),@FCVALUES.V_POWER.V(AP)
;  448        if (n == 0) return
	TSTL	R6
	BNEQ	FCVALUES.V_POWER.$8
	RET
FCVALUES.V_POWER.$8:
;  449        base = a
	MOVC3	#32,@FCVALUES.V_POWER.A(AP),FCVALUES.V_POWER.BASE(FP)
;  450        if (n < 0) then
	TSTL	R6
	BGEQ	FCVALUES.V_POWER.$10
;  451          if (.not. truth(a)) then
	PUSHAB	@FCVALUES.V_POWER.A(AP)
	CALLS	#1,G^FCVALUES.TRUTH
	MOVL	R0,R7
	BLBS	R7,FCVALUES.V_POWER.$12
;  452            v = error_value(e_divzero)
	PUSHAL	FCVALUES.V_POWER.$K2
	PUSHAB	FCVALUES.V_POWER.$T3(FP)
	CALLS	#2,G^FCVALUES.ERROR_VALUE
	MOVC3	#32,FCVALUES.V_POWER.$T3(FP),@FCVALUES.V_POWER.V(AP)
;  453            return
	RET
FCVALUES.V_POWER.$12:
;  454          end if
;  455          base = real_value(1.0_rk) / a
	PUSHAG	FCVALUES.V_POWER.$K1
	PUSHAB	FCVALUES.V_POWER.$T4(FP)
	CALLS	#2,G^FCVALUES.REAL_VALUE
	PUSHAB	@FCVALUES.V_POWER.A(AP)
	PUSHAB	FCVALUES.V_POWER.$T4(FP)
	PUSHAB	FCVALUES.V_POWER.$T3(FP)
	CALLS	#3,G^FCVALUES.V_DIV
	MOVC3	#32,FCVALUES.V_POWER.$T3(FP),FCVALUES.V_POWER.BASE(FP)
;  456          n = -n
	MNEGL	R6,R6
;  457        end if
FCVALUES.V_POWER.$10:
;  458        do
	MOVL	FCVALUES.V_POWER.V(AP),R7
FCVALUES.V_POWER.$14:			; DO (line 458)'s body
;  459          if (mod(n, 2) == 1) v = v * base
	DIVL3	#2,R6,R0
	MULL2	#2,R0
	SUBL3	R0,R6,R0
	CMPL	R0,#1
	BNEQ	FCVALUES.V_POWER.$15
	PUSHAB	FCVALUES.V_POWER.BASE(FP)
	PUSHAB	(R7)
	PUSHAB	FCVALUES.V_POWER.$T4(FP)
	CALLS	#3,G^FCVALUES.V_MUL
	MOVC3	#32,FCVALUES.V_POWER.$T4(FP),(R7)
FCVALUES.V_POWER.$15:
;  460          n = n / 2
	DIVL2	#2,R6
;  461          if (n == 0 .or. v%err /= 0) exit
	BEQL	FCVALUES.V_POWER.$17
	TSTL	16(R7)
	BNEQ	FCVALUES.V_POWER.$17
;  462          base = base * base
	PUSHAB	FCVALUES.V_POWER.BASE(FP)
	PUSHAB	FCVALUES.V_POWER.BASE(FP)
	PUSHAB	FCVALUES.V_POWER.$T4(FP)
	CALLS	#3,G^FCVALUES.V_MUL
	MOVC3	#32,FCVALUES.V_POWER.$T4(FP),FCVALUES.V_POWER.BASE(FP)
;  463          if (base%err /= 0) then
	TSTL	FCVALUES.V_POWER.BASE+16(FP)
	BEQL	FCVALUES.V_POWER.$14
;  464            v = base
	MOVC3	#32,FCVALUES.V_POWER.BASE(FP),@FCVALUES.V_POWER.V(AP)
;  465            exit
	RET
;  466          end if
;  467        end do
FCVALUES.V_POWER.$17:
;  468        return
	RET
FCVALUES.V_POWER.$5:
;  469      end if
;  470
;  471      if (.not. truth(a)) then
	PUSHAB	@FCVALUES.V_POWER.A(AP)
	CALLS	#1,G^FCVALUES.TRUTH
	MOVL	R0,R7
	BLBS	R7,FCVALUES.V_POWER.$22
;  472        ! Zero to a power that isn't whole: zero if the power's real part
;  473        ! is positive.
;  474        if (real(b%z, rk) > 0) then
	TSTG	@FCVALUES.V_POWER.B(AP)
	BLEQ	FCVALUES.V_POWER.$24
;  475          v = real_value(0.0_rk)
	PUSHAG	FCVALUES.V_POWER.$K3
	PUSHAB	FCVALUES.V_POWER.$T4(FP)
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCVALUES.V_POWER.$T4(FP),@FCVALUES.V_POWER.V(AP)
;  476        else
	RET
FCVALUES.V_POWER.$24:
;  477          v = error_value(e_domain)
	PUSHAL	FCVALUES.V_POWER.$K4
	PUSHAB	FCVALUES.V_POWER.$T4(FP)
	CALLS	#2,G^FCVALUES.ERROR_VALUE
	MOVC3	#32,FCVALUES.V_POWER.$T4(FP),@FCVALUES.V_POWER.V(AP)
;  478        end if
;  479        return
	RET
FCVALUES.V_POWER.$22:
;  480      end if
;  481
;  482      x = real(a%z, rk)
	MOVG	@FCVALUES.V_POWER.A(AP),FCVALUES.V_POWER.X(FP)
;  483      if (is_real(a) .and. x > 0 .and. is_real(b)) then
	PUSHAB	@FCVALUES.V_POWER.A(AP)
	CALLS	#1,G^FCVALUES.IS_REAL
	MOVL	R0,R7
	PUSHAB	@FCVALUES.V_POWER.B(AP)
	CALLS	#1,G^FCVALUES.IS_REAL
	MOVL	R0,FCVALUES.V_POWER.$T5(FP)
	BLBC	R7,FCVALUES.V_POWER.$27
	TSTG	FCVALUES.V_POWER.X(FP)
	BLEQ	FCVALUES.V_POWER.$27
	BLBC	FCVALUES.V_POWER.$T5(FP),FCVALUES.V_POWER.$27
;  484        v%err = 0
	MOVL	FCVALUES.V_POWER.V(AP),R0
	CLRL	16(R0)
;  485        t = r_mul(real(b%z, rk), log(x), v%err)
	MOVG	@FCVALUES.V_POWER.B(AP),FCVALUES.V_POWER.$T2(FP)
	PUSHAG	FCVALUES.V_POWER.X(FP)
	CALLS	#1,G^MTH$GLOG
	MOVG	R0,FCVALUES.V_POWER.$T6(FP)
	MOVL	FCVALUES.V_POWER.V(AP),R0
	PUSHAL	16(R0)
	PUSHAG	FCVALUES.V_POWER.$T6(FP)
	PUSHAG	FCVALUES.V_POWER.$T2(FP)
	CALLS	#3,G^FCVALUES.R_MUL
	MOVG	R0,FCVALUES.V_POWER.T(FP)
;  486        if (v%err == 0) v = exp_real(t)
	MOVL	FCVALUES.V_POWER.V(AP),R0
	TSTL	16(R0)
	BNEQ	FCVALUES.V_POWER.$31
	PUSHAG	FCVALUES.V_POWER.T(FP)
	PUSHAB	FCVALUES.V_POWER.$T4(FP)
	CALLS	#2,G^FCVALUES.EXP_REAL
	MOVC3	#32,FCVALUES.V_POWER.$T4(FP),@FCVALUES.V_POWER.V(AP)
FCVALUES.V_POWER.$31:
;  487        return
	RET
FCVALUES.V_POWER.$27:
;  488      end if
;  489
;  490      v = exp_value(b * log_value(a))
	PUSHAB	@FCVALUES.V_POWER.A(AP)
	PUSHAB	FCVALUES.V_POWER.$T7(FP)
	CALLS	#2,G^FCVALUES.LOG_VALUE
	PUSHAB	FCVALUES.V_POWER.$T7(FP)
	PUSHAB	@FCVALUES.V_POWER.B(AP)
	PUSHAB	FCVALUES.V_POWER.$T3(FP)
	CALLS	#3,G^FCVALUES.V_MUL
	PUSHAB	FCVALUES.V_POWER.$T3(FP)
	PUSHAB	FCVALUES.V_POWER.$T4(FP)
	CALLS	#2,G^FCVALUES.EXP_VALUE
	MOVC3	#32,FCVALUES.V_POWER.$T4(FP),@FCVALUES.V_POWER.V(AP)
;  491    end function v_power
	RET

; Storage map for FCVALUES.EXP_REAL, a TYPE(VALUE) function
