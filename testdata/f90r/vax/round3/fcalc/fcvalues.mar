;    1  ! fcalc: values and their arithmetic.
;    2  !
;    3  ! A VALUE is a complex number and an error code: an operation that fails
;    4  ! gives a value with its error set, and an operation on such a value passes
;    5  ! the error on, as an IEEE NaN would, so the evaluator need only look at the
;    6  ! last value it gets to know whether everything before it went well.
;    7  !
;    8  ! Arithmetic never goes near the machine's limits (module FCKINDS): each
;    9  ! operation on the real parts is done by R_ADD, R_MUL, or R_DIV, which check
;   10  ! their operands first, report a result past LIMIT as an overflow, and give
;   11  ! zero for one below SMALL, without the machine ever overflowing or
;   12  ! underflowing. So the same expression gives the same value, or the same
;   13  ! error, on a VAX and on an IEEE machine, and nothing fcalc computes traps.
;   14  !
;   15  ! The checks are cheap comparisons made before an operation, never after:
;   16  ! on a VAX the operation itself would already have stopped the program.
;   17  ! For a product x*y, |x*y| > LIMIT exactly when |y| > LIMIT/|x| (for |x| of
;   18  ! 1 or more), and LIMIT/|x| can't overflow; that rewriting of a test so it
;   19  ! is safe to compute is the main trick of the module.
;   20  !
;   21  ! Fortran 90 lets a program give its own meaning to an operator for its
;   22  ! own types: INTERFACE OPERATOR(+) below names the functions + means for
;   23  ! VALUEs, so the evaluator writes a + b, and the compiler calls V_ADD(a, b).
;   24  ! Several functions may share one operator (or one generic name), each for
;   25  ! different argument types; the compiler picks by the arguments, as it
;   26  ! picks real or integer addition.
;   27  module fcvalues
;   28    use fckinds
;   29    use fcmessages
;   30    implicit none
;   31    private
;   32
;   33    public :: value, real_value, complex_value, error_value, format_value
;   34    public :: format_real, is_real, is_whole, truth, logical_value
;   35    public :: v_mod, v_factorial, v_compare, v_abs, c_abs
;   36    public :: operator(+), operator(-), operator(*), operator(/), operator(**)
;   37    public :: digits, r_add, r_mul, r_div, c_add, c_sub, c_mul, c_div, near_to
;   38    public :: exp_real, exp_value, log_value, clean, angle_of
;   39    public :: number_format, number_base, f_auto, f_fixed, f_scientific, f_engineering
;   40
;   41    ! A VALUE: Z, the number, and ERR, 0 or the code of the error that made
;   42    ! it. A function whose result is a VALUE returns both at once.
;   43    type value
;   44      complex(rk) :: z
;   45      integer :: err
;   46    end type value
;   47
;   48    ! The significant digits a value is shown with (SET DIGITS), or under
;   49    ! FIXED the places after the point.
;   50    integer, save :: digits = 12
;   51
;   52    ! How a value is shown (SET FORMAT), and the base a whole number is shown
;   53    ! in (SET BASE): 10, 16, 8, or 2.
;   54    integer, parameter :: f_auto = 1, f_fixed = 2, f_scientific = 3, f_engineering = 4
;   55    integer, save :: number_format = f_auto
;   56    integer, save :: number_base = 10
;   57
;   58    interface operator(+)
;   59      module procedure v_add, v_plus
;   60    end interface
;   61
;   62    interface operator(-)
;   63      module procedure v_sub, v_neg
;   64    end interface
;   65
;   66    interface operator(*)
;   67      module procedure v_mul
;   68    end interface
;   69
;   70    interface operator(/)
;   71      module procedure v_div
;   72    end interface
;   73
;   74    interface operator(**)
;   75      module procedure v_power
;   76    end interface
;   77
;   78    ! Values whose difference is no more than this part of the larger are
;   79    ! equal (V_COMPARE): 0.1 + 0.2 == 0.3, whatever the machine's rounding.
;   80    real(rk), parameter :: tolerance = 64 * eps
