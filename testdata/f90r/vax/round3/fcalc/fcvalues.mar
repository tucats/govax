	ADDL3	FCVALUES.SCIENTIFIC_TEXT.$T1,#2,R0
	MOVL	FCVALUES.SCIENTIFIC_TEXT.TEXT(AP),R1
	MOVC5	R0,FCVALUES.SCIENTIFIC_TEXT.$T2,#^A/ /,#32,@4(R1)
