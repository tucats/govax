;  868
;  869    ! ENGINEERING_TEXT is SCIENTIFIC_TEXT with the exponent a multiple of 3
;  870    ! (the powers that have names: kilo, mega, milli, micro), so the point
;  871    ! moves right by MODULO(EX, 3), leaving one to three digits before it.
;  872    ! MODULO, unlike MOD, takes the sign of the divisor: MODULO(-7, 3) is 2,
;  873    ! so 1.5e-7 is 150e-9. With fewer digits than go before the point, zeros
;  874    ! fill the places: 1.5e+5 to two digits is 150e+3.
;  875    function engineering_text(a) result(text)
	.ENTRY	FCVALUES.ENGINEERING_TEXT,^M<R2,R3,R4,R5,R6>
;  876      real(rk), intent(in) :: a
;  877      character(len=32) :: text
;  878      character(len=max_digits) :: d
;  879      integer :: ex, shift, lead
;  880
;  881      if (a == 0) then
	TSTG	@FCVALUES.ENGINEERING_TEXT.A(AP)
	BNEQ	FCVALUES.ENGINEERING_TEXT.$1
;  882        d = repeat('0', digits)
	MOVL	FCVALUES.DIGITS,FCVALUES.ENGINEERING_TEXT.$T1
	PUSHAL	FCVALUES.ENGINEERING_TEXT.$T1
	PUSHAQ	FCVALUES.ENGINEERING_TEXT.$D2
	PUSHAQ	FCVALUES.ENGINEERING_TEXT.$D1
	CALLS	#3,G^FTN$REPEAT
	MOVZWL	FCVALUES.ENGINEERING_TEXT.$D1,R0
	MOVC5	R0,@FCVALUES.ENGINEERING_TEXT.$D1+4,#^A/ /,#15,FCVALUES.ENGINEERING_TEXT.D
	PUSHAQ	FCVALUES.ENGINEERING_TEXT.$D1
	CALLS	#1,G^LIB$SFREE1_DD
;  883        ex = 0
	CLRL	FCVALUES.ENGINEERING_TEXT.EX
;  884      else
	BRB	FCVALUES.ENGINEERING_TEXT.$3
FCVALUES.ENGINEERING_TEXT.$1:
;  885        call decimal_digits(a, digits, d, ex)
	PUSHAL	FCVALUES.ENGINEERING_TEXT.EX
	PUSHAQ	FCVALUES.ENGINEERING_TEXT.$D3
	PUSHAL	FCVALUES.DIGITS
	PUSHAG	@FCVALUES.ENGINEERING_TEXT.A(AP)
	CALLS	#4,G^FCVALUES.DECIMAL_DIGITS
;  886      end if
FCVALUES.ENGINEERING_TEXT.$3:
;  887      shift = modulo(ex, 3)
	DIVL3	#3,FCVALUES.ENGINEERING_TEXT.EX,R0
	MULL2	#3,R0
	SUBL3	R0,FCVALUES.ENGINEERING_TEXT.EX,FCVALUES.ENGINEERING_TEXT.$T1
	BGEQ	FCVALUES.ENGINEERING_TEXT.$4
	ADDL2	#3,FCVALUES.ENGINEERING_TEXT.$T1
FCVALUES.ENGINEERING_TEXT.$4:
	MOVL	FCVALUES.ENGINEERING_TEXT.$T1,FCVALUES.ENGINEERING_TEXT.SHIFT
;  888      lead = shift + 1
	ADDL3	FCVALUES.ENGINEERING_TEXT.SHIFT,#1,FCVALUES.ENGINEERING_TEXT.LEAD
;  889
;  890      if (digits < lead) then
	CMPL	FCVALUES.DIGITS,FCVALUES.ENGINEERING_TEXT.LEAD
	BLSS	FCVALUES.ENGINEERING_TEXT.$7
	BRW	FCVALUES.ENGINEERING_TEXT.$6
FCVALUES.ENGINEERING_TEXT.$7:
;  891        text = d(1:digits) // repeat('0', lead - digits)
	MOVL	FCVALUES.DIGITS,FCVALUES.ENGINEERING_TEXT.$T1
	BGEQ	FCVALUES.ENGINEERING_TEXT.$8
	CLRL	FCVALUES.ENGINEERING_TEXT.$T1
FCVALUES.ENGINEERING_TEXT.$8:
	SUBL3	FCVALUES.DIGITS,FCVALUES.ENGINEERING_TEXT.LEAD,FCVALUES.ENGINEERING_TEXT.$T2
	PUSHAL	FCVALUES.ENGINEERING_TEXT.$T2
	PUSHAQ	FCVALUES.ENGINEERING_TEXT.$D2
	PUSHAQ	FCVALUES.ENGINEERING_TEXT.$D1
	CALLS	#3,G^FTN$REPEAT
	MOVZWL	FCVALUES.ENGINEERING_TEXT.$D1,R0
	ADDL2	FCVALUES.ENGINEERING_TEXT.$T1,R0
	CVTLW	R0,FCVALUES.ENGINEERING_TEXT.$T3
	PUSHAQ	FCVALUES.ENGINEERING_TEXT.$D4
	PUSHAW	FCVALUES.ENGINEERING_TEXT.$T3
	CALLS	#2,G^LIB$SGET1_DD
	MOVC3	FCVALUES.ENGINEERING_TEXT.$T1,FCVALUES.ENGINEERING_TEXT.D,@FCVALUES.ENGINEERING_TEXT.$D4+4
	MOVZWL	FCVALUES.ENGINEERING_TEXT.$D1,FCVALUES.ENGINEERING_TEXT.$U1
	MOVL	FCVALUES.ENGINEERING_TEXT.$T1,R0
	MOVC3	FCVALUES.ENGINEERING_TEXT.$U1,@FCVALUES.ENGINEERING_TEXT.$D1+4,@FCVALUES.ENGINEERING_TEXT.$D4+4[R0]
	ADDL3	FCVALUES.ENGINEERING_TEXT.$T1,FCVALUES.ENGINEERING_TEXT.$U1,R0
