	PUSHAQ	FCVALUES.ENGINEERING_TEXT.$D1
	CALLS	#1,G^LIB$SFREE1_DD
	PUSHAQ	FCVALUES.ENGINEERING_TEXT.$D4
	CALLS	#1,G^LIB$SFREE1_DD
;  892      else if (digits == lead) then
	BRW	FCVALUES.ENGINEERING_TEXT.$10
FCVALUES.ENGINEERING_TEXT.$6:
	CMPL	FCVALUES.DIGITS,FCVALUES.ENGINEERING_TEXT.LEAD
	BNEQ	FCVALUES.ENGINEERING_TEXT.$11
;  893        text = d(1:lead)
	MOVL	FCVALUES.ENGINEERING_TEXT.LEAD,FCVALUES.ENGINEERING_TEXT.$T2
	BGEQ	FCVALUES.ENGINEERING_TEXT.$13
	CLRL	FCVALUES.ENGINEERING_TEXT.$T2
FCVALUES.ENGINEERING_TEXT.$13:
	MOVL	FCVALUES.ENGINEERING_TEXT.TEXT(AP),R0
	MOVC5	FCVALUES.ENGINEERING_TEXT.$T2,FCVALUES.ENGINEERING_TEXT.D,#^A/ /,#32,@4(R0)
;  894      else
	BRW	FCVALUES.ENGINEERING_TEXT.$10
FCVALUES.ENGINEERING_TEXT.$11:
;  895        text = d(1:lead) // '.' // d(lead + 1:digits)
	MOVL	FCVALUES.ENGINEERING_TEXT.LEAD,FCVALUES.ENGINEERING_TEXT.$T2
	BGEQ	FCVALUES.ENGINEERING_TEXT.$15
	CLRL	FCVALUES.ENGINEERING_TEXT.$T2
FCVALUES.ENGINEERING_TEXT.$15:
	SUBL3	FCVALUES.ENGINEERING_TEXT.LEAD,FCVALUES.DIGITS,FCVALUES.ENGINEERING_TEXT.$T1
	BGEQ	FCVALUES.ENGINEERING_TEXT.$17
	CLRL	FCVALUES.ENGINEERING_TEXT.$T1
FCVALUES.ENGINEERING_TEXT.$17:
	MOVC3	FCVALUES.ENGINEERING_TEXT.$T2,FCVALUES.ENGINEERING_TEXT.D,FCVALUES.ENGINEERING_TEXT.$T4
	MOVL	FCVALUES.ENGINEERING_TEXT.$T2,R0
	MOVB	#46,FCVALUES.ENGINEERING_TEXT.$T4[R0]
	MOVL	FCVALUES.ENGINEERING_TEXT.LEAD,R0
	MOVL	FCVALUES.ENGINEERING_TEXT.$T2,R1
	MOVC3	FCVALUES.ENGINEERING_TEXT.$T1,FCVALUES.ENGINEERING_TEXT.D[R0],FCVALUES.ENGINEERING_TEXT.$T4+1[R1]
	ADDL3	FCVALUES.ENGINEERING_TEXT.$T2,FCVALUES.ENGINEERING_TEXT.$T1,R0
	INCL	R0
	MOVL	FCVALUES.ENGINEERING_TEXT.TEXT(AP),R1
	MOVC5	R0,FCVALUES.ENGINEERING_TEXT.$T4,#^A/ /,#32,@4(R1)
;  896      end if
FCVALUES.ENGINEERING_TEXT.$10:
;  897      text = trim(text) // exponent_text(ex - shift)
	MOVL	FCVALUES.ENGINEERING_TEXT.TEXT(AP),R0
	MOVAB	@4(R0),FCVALUES.ENGINEERING_TEXT.$T1
	MOVAB	@FCVALUES.ENGINEERING_TEXT.$T1,FCVALUES.ENGINEERING_TEXT.$T2
	MOVL	#32,R6
	BRB	FCVALUES.ENGINEERING_TEXT.$19
FCVALUES.ENGINEERING_TEXT.$20:
	SUBL3	#1,R6,R0
	CMPB	@FCVALUES.ENGINEERING_TEXT.$T2[R0],#32
	BNEQ	FCVALUES.ENGINEERING_TEXT.$21
	DECL	R6
FCVALUES.ENGINEERING_TEXT.$19:
	TSTL	R6			; from line 897
