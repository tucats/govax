	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  847
;  848    ! SCIENTIFIC_TEXT shows A (not negative) to N significant digits, every
;  849    ! one shown, one before the point: 3.14159265359e+0. Zero is
;  850    ! 0.00000000000e+0, the same width as the rest.
;  851    function scientific_text(a, n) result(text)
	.ENTRY	FCVALUES.SCIENTIFIC_TEXT,^M<R2,R3,R4,R5,R6,R7>
;  852      real(rk), intent(in) :: a
;  853      integer, intent(in) :: n
;  854      character(len=32) :: text
;  855      character(len=max_digits) :: d
;  856      integer :: ex
;  857
;  858      if (a == 0) then
	TSTG	@FCVALUES.SCIENTIFIC_TEXT.A(AP)
	BNEQ	FCVALUES.SCIENTIFIC_TEXT.$1
;  859        d = repeat('0', n)
	MOVL	@FCVALUES.SCIENTIFIC_TEXT.N(AP),FCVALUES.SCIENTIFIC_TEXT.$T1
	PUSHAL	FCVALUES.SCIENTIFIC_TEXT.$T1
	PUSHAQ	FCVALUES.SCIENTIFIC_TEXT.$D2
	PUSHAQ	FCVALUES.SCIENTIFIC_TEXT.$D1
	CALLS	#3,G^FTN$REPEAT
	MOVZWL	FCVALUES.SCIENTIFIC_TEXT.$D1,R0
	MOVC5	R0,@FCVALUES.SCIENTIFIC_TEXT.$D1+4,#^A/ /,#15,FCVALUES.SCIENTIFIC_TEXT.D
	PUSHAQ	FCVALUES.SCIENTIFIC_TEXT.$D1
	CALLS	#1,G^LIB$SFREE1_DD
