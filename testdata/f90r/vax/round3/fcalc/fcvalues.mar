; 1034
; 1035      ! NEGLIGIBLE: |A| < |B| * PART, A too small beside B to show. The
; 1036      ! product is never formed where it could underflow (B near SMALL),
; 1037      ! which a VAX compiled /CHECK=UNDERFLOW would fault on: for |B| below 1
; 1038      ! the test is |A| / PART < |B|, whose quotient can't underflow, and an
; 1039      ! A of 1 or more can't be smaller than such a B.
; 1040      logical function negligible(a, b)
FCVALUES.FORMAT_VALUE.$N1:
	.WORD	^M<R2,R6,R7,R8,R9>	; internal procedure NEGLIGIBLE of FCVALUES.FORMAT_VALUE
; 1041        real(rk), intent(in) :: a, b
; 1042
; 1043        if (abs(b) >= 1) then
