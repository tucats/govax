	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  565
;  566    ! V_ABS is a value's magnitude.
;  567    function v_abs(a) result(v)
	.ENTRY	FCVALUES.V_ABS,^M<R2,R3,R4,R5>
