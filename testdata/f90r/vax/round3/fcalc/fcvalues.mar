;  795
;  796    ! EXPONENT_TEXT is e+7 or e-12: as few digits as the exponent needs.
;  797    function exponent_text(ex) result(text)
	.ENTRY	FCVALUES.EXPONENT_TEXT,^M<R2,R3,R4,R5>
;  798      integer, intent(in) :: ex
;  799      character(len=6) :: text
;  800      character(len=4) :: buf
;  801
;  802      write (buf, '(I4)') abs(ex)
	PUSHAB	FCVALUES.EXPONENT_TEXT.$FK1
	PUSHAQ	FCVALUES.EXPONENT_TEXT.$D1
	PUSHAB	FCVALUES.EXPONENT_TEXT.$IO1
	CALLS	#3,G^FTN$WRITE_IF
	MOVL	@FCVALUES.EXPONENT_TEXT.EX(AP),FCVALUES.EXPONENT_TEXT.$T1
	BGEQ	FCVALUES.EXPONENT_TEXT.$1
	MNEGL	FCVALUES.EXPONENT_TEXT.$T1,FCVALUES.EXPONENT_TEXT.$T1
FCVALUES.EXPONENT_TEXT.$1:
	PUSHAQ	FCVALUES.EXPONENT_TEXT.$D2
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;  803      if (ex < 0) then
	TSTL	@FCVALUES.EXPONENT_TEXT.EX(AP)
	BGEQ	FCVALUES.EXPONENT_TEXT.$3
;  804        text = 'e-' // adjustl(buf)
	PUSHAQ	FCVALUES.EXPONENT_TEXT.$D1
	PUSHAQ	FCVALUES.EXPONENT_TEXT.$D3
	CALLS	#2,G^FTN$ADJUSTL
	MOVC3	#2,FCVALUES.EXPONENT_TEXT.$K2,FCVALUES.EXPONENT_TEXT.$T3
	MOVC3	#4,FCVALUES.EXPONENT_TEXT.$T2,FCVALUES.EXPONENT_TEXT.$T3+2
	MOVL	FCVALUES.EXPONENT_TEXT.TEXT(AP),R0
	MOVC3	#6,FCVALUES.EXPONENT_TEXT.$T3,@4(R0)
;  805      else
	RET
FCVALUES.EXPONENT_TEXT.$3:
;  806        text = 'e+' // adjustl(buf)
	PUSHAQ	FCVALUES.EXPONENT_TEXT.$D1
	PUSHAQ	FCVALUES.EXPONENT_TEXT.$D3
	CALLS	#2,G^FTN$ADJUSTL
	MOVC3	#2,FCVALUES.EXPONENT_TEXT.$K3,FCVALUES.EXPONENT_TEXT.$T3
	MOVC3	#4,FCVALUES.EXPONENT_TEXT.$T2,FCVALUES.EXPONENT_TEXT.$T3+2
	MOVL	FCVALUES.EXPONENT_TEXT.TEXT(AP),R0
	MOVC3	#6,FCVALUES.EXPONENT_TEXT.$T3,@4(R0)
;  807      end if
;  808    end function exponent_text
	RET

