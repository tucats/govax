	BRB	FCVALUES.FORMAT_VALUE.$N1.$10
FCVALUES.FORMAT_VALUE.$N1.$3:
	MOVG	@FCVALUES.FORMAT_VALUE.$N1.A(AP),R8
	BGEQ	FCVALUES.FORMAT_VALUE.$N1.$11
	MNEGG	R8,R8
FCVALUES.FORMAT_VALUE.$N1.$11:
	CMPG	R8,S^#1.0
	BLSS	FCVALUES.FORMAT_VALUE.$N1.$13
