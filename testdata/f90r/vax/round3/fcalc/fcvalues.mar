FCVALUES.R_ADD.$KF1:
	.LONG	^X0B1505ED,^XEB84A491	; 1D-280
FCVALUES.R_ADD.$KF2:
	.LONG	^XAF1D4435,^X8C4078B5	; 1D20
FCVALUES.R_ADD.$KF3:
	.LONG	^X0B1505ED,^XEB85A491	; 1.0000000000000001D-280
FCVALUES.R_ADD.$KF4:
	.LONG	^XE43C7E57,^X759C8800	; 1D300
FCVALUES.R_ADD.$KF5:
	.LONG	^X00000000,^X00000000	; 0D0
FCVALUES.R_ADD.$KF6:
	.LONG	^X6E1F01C5,^XF359C2F8	; 1D-300

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  170
;  171    ! ------------------------------------------------------------------
;  172    ! The guarded operations on real numbers. Each takes ERR, which it sets
;  173    ! to E_OVERFLOW or E_DIVZERO if it is zero and the operation fails, and
;  174    ! gives a result whose magnitude is zero or between SMALL and LIMIT.
;  175    ! Only the first error is kept (IF (ERR == 0)), so a chain of operations
;  176    ! can share one ERR and report what went wrong first.
;  177    !
;  178    ! A result smaller than SMALL becomes 0, as IEEE's gradual underflow and
;  179    ! a VAX's quiet zero would both nearly do, but alike on both. The
;  180    ! comparisons are arranged so the machine itself never computes a value
;  181    ! below its own smallest number: a VAX compiled /CHECK=UNDERFLOW faults
;  182    ! on that.
;  183
;  184    real(rk) function r_add(x, y, err)
	.ENTRY	FCVALUES.R_ADD,^M<R2,R3,R6,R7,R8,R9,R10,R11>
;  185      real(rk), intent(in) :: x, y
;  186      integer, intent(inout) :: err
;  187      real(rk), parameter :: scale = 1.0e20_rk
;  188      real(rk) :: s
;  189
;  190      r_add = 0
	CLRG	R8
;  191      if (max(abs(x), abs(y)) < 1.0e-280_rk) then
	MOVG	@FCVALUES.R_ADD.X(AP),R6
	BGEQ	FCVALUES.R_ADD.$1
	MNEGG	R6,R6
FCVALUES.R_ADD.$1:
	MOVG	R6,R10
	MOVG	@FCVALUES.R_ADD.Y(AP),R6
	BGEQ	FCVALUES.R_ADD.$3
	MNEGG	R6,R6
FCVALUES.R_ADD.$3:
	CMPG	R6,R10
	BLEQ	FCVALUES.R_ADD.$5
	MOVG	R6,R10
FCVALUES.R_ADD.$5:
	CMPG	R10,FCVALUES.R_ADD.$KF1
	BGEQ	FCVALUES.R_ADD.$7
;  192        ! Two values this small could leave a difference below the VAX's
;  193        ! smallest number: add them scaled up instead.
;  194        s = x * scale + y * scale
	MULG3	@FCVALUES.R_ADD.X(AP),FCVALUES.R_ADD.$KF2,R0
	MULG3	@FCVALUES.R_ADD.Y(AP),FCVALUES.R_ADD.$KF2,R2
	ADDG3	R0,R2,FCVALUES.R_ADD.S
;  195        if (abs(s) >= small * scale) r_add = s / scale
	MOVG	FCVALUES.R_ADD.S,R6
	BGEQ	FCVALUES.R_ADD.$9
	MNEGG	R6,R6
FCVALUES.R_ADD.$9:
	CMPG	R6,FCVALUES.R_ADD.$KF3
	BLSS	FCVALUES.R_ADD.$11
	DIVG3	FCVALUES.R_ADD.$KF2,FCVALUES.R_ADD.S,R8
FCVALUES.R_ADD.$11:
;  196        return
	MOVG	R8,R0			; the function's value
	RET
FCVALUES.R_ADD.$7:
;  197      end if
;  198
;  199      s = x + y
	ADDG3	@FCVALUES.R_ADD.X(AP),@FCVALUES.R_ADD.Y(AP),FCVALUES.R_ADD.S
;  200      if (abs(s) > limit) then
	MOVG	FCVALUES.R_ADD.S,R6
	BGEQ	FCVALUES.R_ADD.$13
	MNEGG	R6,R6
FCVALUES.R_ADD.$13:
	CMPG	R6,FCVALUES.R_ADD.$KF4
	BLEQ	FCVALUES.R_ADD.$15
;  201        if (err == 0) err = e_overflow
	TSTL	@FCVALUES.R_ADD.ERR(AP)
	BNEQ	FCVALUES.R_ADD.$17
	MOVL	#10,@FCVALUES.R_ADD.ERR(AP)
FCVALUES.R_ADD.$17:
;  202        return
	MOVG	FCVALUES.R_ADD.$KF5,R0	; the function's value
	RET
FCVALUES.R_ADD.$15:
;  203      end if
;  204      if (abs(s) >= small) r_add = s
	MOVG	FCVALUES.R_ADD.S,R6
	BGEQ	FCVALUES.R_ADD.$19
	MNEGG	R6,R6
FCVALUES.R_ADD.$19:
	CMPG	R6,FCVALUES.R_ADD.$KF6
	BLSS	FCVALUES.R_ADD.$21
	MOVG	FCVALUES.R_ADD.S,R8
FCVALUES.R_ADD.$21:
;  205    end function r_add
	MOVG	R8,R0			; the function's value
	RET

; Storage map for FCVALUES.R_MUL, a REAL*8 function
;   X      REAL*8, INTENT(IN)      argument 1  @FCVALUES.R_MUL.X(AP)
;   Y      REAL*8, INTENT(IN)      argument 2  @FCVALUES.R_MUL.Y(AP)
;   ERR    INTEGER, INTENT(INOUT)  argument 3  @FCVALUES.R_MUL.ERR(AP)
;   R_MUL  REAL*8                  $LOCAL+0    FCVALUES.R_MUL.R_MUL
;   AX     REAL*8                  $LOCAL+8    FCVALUES.R_MUL.AX
;   AY     REAL*8                  $LOCAL+16   FCVALUES.R_MUL.AY
;   R6 is $T1: temporary
;
FCVALUES.R_MUL.X = 4			; X is argument 1
FCVALUES.R_MUL.Y = 8			; Y is argument 2
FCVALUES.R_MUL.ERR = 12			; ERR is argument 3

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCVALUES.R_MUL.R_MUL:
	.BLKL	2			; R_MUL, the function's value
FCVALUES.R_MUL.AX:
	.BLKL	2			; AX
FCVALUES.R_MUL.AY:
	.BLKL	2			; AY

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCVALUES.R_MUL.$KF1:
	.LONG	^X00000000,^X00000000	; 0D0
FCVALUES.R_MUL.$KF2:
	.LONG	^XE43C7E57,^X759C8800	; 1D300
FCVALUES.R_MUL.$KF3:
	.LONG	^X6E1F01C5,^XF359C2F8	; 1D-300

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  206
;  207    real(rk) function r_mul(x, y, err)
	.ENTRY	FCVALUES.R_MUL,^M<R6,R7>
;  208      real(rk), intent(in) :: x, y
;  209      integer, intent(inout) :: err
;  210      real(rk) :: ax, ay
;  211
;  212      r_mul = 0
;  213      ax = abs(x)
	MOVG	@FCVALUES.R_MUL.X(AP),R6
	BGEQ	FCVALUES.R_MUL.$1
	MNEGG	R6,R6
FCVALUES.R_MUL.$1:
	MOVG	R6,FCVALUES.R_MUL.AX
;  214      ay = abs(y)
	MOVG	@FCVALUES.R_MUL.Y(AP),R6
	BGEQ	FCVALUES.R_MUL.$3
	MNEGG	R6,R6
FCVALUES.R_MUL.$3:
	MOVG	R6,FCVALUES.R_MUL.AY
;  215      if (ax == 0 .or. ay == 0) return
	TSTG	FCVALUES.R_MUL.AX
	BEQL	FCVALUES.R_MUL.$6
	TSTG	FCVALUES.R_MUL.AY
	BNEQ	FCVALUES.R_MUL.$5
FCVALUES.R_MUL.$6:
	MOVG	FCVALUES.R_MUL.$KF1,R0	; the function's value
	RET
FCVALUES.R_MUL.$5:
;  216
;  217      if (ax >= 1) then
	CMPG	FCVALUES.R_MUL.AX,S^#1.0
	BLSS	FCVALUES.R_MUL.$9
;  218        if (ay > limit / ax) then
	DIVG3	FCVALUES.R_MUL.AX,FCVALUES.R_MUL.$KF2,R0
	CMPG	FCVALUES.R_MUL.AY,R0
	BLEQ	FCVALUES.R_MUL.$15
;  219          if (err == 0) err = e_overflow
	TSTL	@FCVALUES.R_MUL.ERR(AP)
	BNEQ	FCVALUES.R_MUL.$13
	MOVL	#10,@FCVALUES.R_MUL.ERR(AP)
FCVALUES.R_MUL.$13:
;  220          return
	MOVG	FCVALUES.R_MUL.$KF1,R0	; the function's value
	RET
;  221        end if
;  222      else if (ay < small / ax) then
FCVALUES.R_MUL.$9:
	DIVG3	FCVALUES.R_MUL.AX,FCVALUES.R_MUL.$KF3,R0
	CMPG	FCVALUES.R_MUL.AY,R0
	BGEQ	FCVALUES.R_MUL.$15
;  223        return
	MOVG	FCVALUES.R_MUL.$KF1,R0	; the function's value
	RET
FCVALUES.R_MUL.$15:
;  224      end if
;  225
;  226      r_mul = x * y
;  227    end function r_mul
	MULG3	@FCVALUES.R_MUL.X(AP),@FCVALUES.R_MUL.Y(AP),R0 ; the function's value
	RET

; Storage map for FCVALUES.R_DIV, a REAL*8 function
;   X      REAL*8, INTENT(IN)      argument 1  @FCVALUES.R_DIV.X(AP)
