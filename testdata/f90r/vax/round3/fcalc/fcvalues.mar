FCVALUES.FORMAT_VALUE.$N1.$19:
	MOVL	R2,R6
; 1049        end if
FCVALUES.FORMAT_VALUE.$N1.$10:
; 1050      end function negligible
	MOVL	R6,R0			; the function's value
	RET
