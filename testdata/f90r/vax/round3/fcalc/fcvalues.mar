	.BYTE	DSC$K_DTYPE_L,DSC$K_CLASS_S
	.ADDRESS FCVALUES.DECIMAL_DIGITS.$T1
FCVALUES.DECIMAL_DIGITS.$D4:
	.WORD	1			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCVALUES.DECIMAL_DIGITS.$K3
FCVALUES.DECIMAL_DIGITS.$D5:
	.WORD	4			; length
