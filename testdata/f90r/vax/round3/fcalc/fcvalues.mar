FCVALUES.DECIMAL_DIGITS.$K4:
	.ASCII	/E3)/
FCVALUES.DECIMAL_DIGITS.$K5:
	.ASCII	/E/
FCVALUES.DECIMAL_DIGITS.$K6:
	.ASCII	/(I4)/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  763
;  764    ! DECIMAL_DIGITS writes A (positive) to N significant digits: D(1:N) the
;  765    ! digits, without the point, and EX the power of ten of the first.
;  766    !
;  767    ! The number is written by Fortran's own conversion, to an internal file:
;  768    ! a WRITE whose unit is a CHARACTER variable writes into the variable
;  769    ! instead of to a device, and a READ from one reads it, so these are
;  770    ! Fortran's way to turn numbers into text and back. The format is itself
;  771    ! built at run time as text, (ESw.dE3): ES is scientific notation with one
;  772    ! digit before the point, w the field's width, d the digits after the
;  773    ! point, E3 a three-digit exponent. Fortran's conversion rounds the decimal
;  774    ! digits correctly, so fcalc needn't; it only rearranges them. (Fortran 90
;  775    ! has no I0, which would write a number in as few characters as it needs:
;  776    ! I2 writes 1 as " 1", and a blank in a format is nothing.)
;  777    subroutine decimal_digits(a, n, d, ex)
	.ENTRY	FCVALUES.DECIMAL_DIGITS,^M<R2,R3,R4,R5>
;  778      real(rk), intent(in) :: a
;  779      integer, intent(in) :: n
;  780      character(len=max_digits), intent(out) :: d
;  781      integer, intent(out) :: ex
;  782      character(len=40) :: buf
;  783      character(len=20) :: form
;  784      integer :: at
;  785
;  786      write (form, '(A, I2, A, I2, A)') '(ES', n + 10, '.', n - 1, 'E3)'
	PUSHAB	FCVALUES.DECIMAL_DIGITS.$FK1
	PUSHAQ	FCVALUES.DECIMAL_DIGITS.$D1
	PUSHAB	FCVALUES.DECIMAL_DIGITS.$IO1
	CALLS	#3,G^FTN$WRITE_IF
	PUSHAQ	FCVALUES.DECIMAL_DIGITS.$D2
	CALLS	#1,G^FTN$IO_ITEM
	ADDL3	@FCVALUES.DECIMAL_DIGITS.N(AP),#10,FCVALUES.DECIMAL_DIGITS.$T1
	PUSHAQ	FCVALUES.DECIMAL_DIGITS.$D3
	CALLS	#1,G^FTN$IO_ITEM
	PUSHAQ	FCVALUES.DECIMAL_DIGITS.$D4
	CALLS	#1,G^FTN$IO_ITEM
	SUBL3	#1,@FCVALUES.DECIMAL_DIGITS.N(AP),FCVALUES.DECIMAL_DIGITS.$T2
	PUSHAQ	FCVALUES.DECIMAL_DIGITS.$D5
	CALLS	#1,G^FTN$IO_ITEM
	PUSHAQ	FCVALUES.DECIMAL_DIGITS.$D6
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;  787      write (buf, form) a
	PUSHAQ	FCVALUES.DECIMAL_DIGITS.$D1
	PUSHAQ	FCVALUES.DECIMAL_DIGITS.$D7
	PUSHAB	FCVALUES.DECIMAL_DIGITS.$IO2
	CALLS	#3,G^FTN$WRITE_IF
	MOVAG	@FCVALUES.DECIMAL_DIGITS.A(AP),FCVALUES.DECIMAL_DIGITS.$D8+4
	PUSHAQ	FCVALUES.DECIMAL_DIGITS.$D8
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;  788      buf = adjustl(buf)
	PUSHAQ	FCVALUES.DECIMAL_DIGITS.$D7
	PUSHAQ	FCVALUES.DECIMAL_DIGITS.$D9
	CALLS	#2,G^FTN$ADJUSTL
	MOVC3	#40,FCVALUES.DECIMAL_DIGITS.$T3,FCVALUES.DECIMAL_DIGITS.BUF
;  789
;  790      ! BUF is d.ddd...E+xxx (or d.E+xxx for one digit).
;  791      d = buf(1:1) // buf(3:n + 1)
	SUBL3	#1,@FCVALUES.DECIMAL_DIGITS.N(AP),FCVALUES.DECIMAL_DIGITS.$T2
	BGEQ	FCVALUES.DECIMAL_DIGITS.$1
	CLRL	FCVALUES.DECIMAL_DIGITS.$T2
FCVALUES.DECIMAL_DIGITS.$1:
	MOVB	FCVALUES.DECIMAL_DIGITS.BUF,FCVALUES.DECIMAL_DIGITS.$T4
	MOVC3	FCVALUES.DECIMAL_DIGITS.$T2,FCVALUES.DECIMAL_DIGITS.BUF+2,FCVALUES.DECIMAL_DIGITS.$T4+1
	ADDL3	FCVALUES.DECIMAL_DIGITS.$T2,#1,R0
	MOVL	FCVALUES.DECIMAL_DIGITS.D(AP),R1
	MOVC5	R0,FCVALUES.DECIMAL_DIGITS.$T4,#^A/ /,#15,@4(R1)
;  792      at = index(buf, 'E')
	MATCHC	#1,FCVALUES.DECIMAL_DIGITS.$K5,#40,FCVALUES.DECIMAL_DIGITS.BUF
	BNEQ	FCVALUES.DECIMAL_DIGITS.$3
	SUBL3	R2,#40,R0
	BRB	FCVALUES.DECIMAL_DIGITS.$4
FCVALUES.DECIMAL_DIGITS.$3:
	CLRL	R0
FCVALUES.DECIMAL_DIGITS.$4:
	MOVL	R0,FCVALUES.DECIMAL_DIGITS.$T2
	MOVL	FCVALUES.DECIMAL_DIGITS.$T2,FCVALUES.DECIMAL_DIGITS.AT
;  793      read (buf(at + 1:at + 4), '(I4)') ex
	MOVL	FCVALUES.DECIMAL_DIGITS.AT,R0
	MOVAB	FCVALUES.DECIMAL_DIGITS.BUF[R0],FCVALUES.DECIMAL_DIGITS.$D10+4
	PUSHAB	FCVALUES.DECIMAL_DIGITS.$FK2
	PUSHAQ	FCVALUES.DECIMAL_DIGITS.$D10
	PUSHAB	FCVALUES.DECIMAL_DIGITS.$IO1
	CALLS	#3,G^FTN$READ_IF
	MOVAL	@FCVALUES.DECIMAL_DIGITS.EX(AP),FCVALUES.DECIMAL_DIGITS.$D11+4
	PUSHAQ	FCVALUES.DECIMAL_DIGITS.$D11
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;  794    end subroutine decimal_digits
	RET

; Storage map for FCVALUES.EXPONENT_TEXT, a CHARACTER*6 function
;   TEXT  CHARACTER*6          hidden argument 1  @FCVALUES.EXPONENT_TEXT.TEXT(AP)
;   EX    INTEGER, INTENT(IN)  argument 2         @FCVALUES.EXPONENT_TEXT.EX(AP)
;   BUF   CHARACTER*4          $LOCAL+0           FCVALUES.EXPONENT_TEXT.BUF
;
