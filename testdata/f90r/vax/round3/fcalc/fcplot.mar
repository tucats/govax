;  312
;  313      ! TABLE_OF_POINTS is the table with FOR. An internal procedure of
;  314      ! TABLE_COMMAND: it sees the command's variables, LIST, NAME, A, B, S,
;  315      ! by host association.
;  316      subroutine table_of_points()
FCPLOT.TABLE_COMMAND.$N3:
	.WORD	^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11> ; internal procedure TABLE_OF_POINTS of FCPLOT.TABLE_COMMAND
	CLRL	FCPLOT.TABLE_COMMAND.$N3.CELLS+4
;  317        character(len=cell_length), allocatable :: cells(:, :)
;  318        character(len=line_length) :: heads(max_columns + 1)
;  319        real(rk) :: x0, x1, step, steps, level
;  320        type(value) :: v, w
;  321        integer :: n, j, k, code, err
;  322
;  323        x0 = real(a%z, rk)
	MOVG	FCPLOT.TABLE_COMMAND.A,FCPLOT.TABLE_COMMAND.$N3.X0
;  324        x1 = real(b%z, rk)
	MOVG	FCPLOT.TABLE_COMMAND.B,FCPLOT.TABLE_COMMAND.$N3.X1
;  325        err = 0
	CLRL	FCPLOT.TABLE_COMMAND.$N3.ERR
;  326
;  327        ! How many rows: the steps from A to B, and one more for A. A count
;  328        ! a rounding error short of a whole number (0.3 / 0.1 is
;  329        ! 2.9999999999999996) is that number, so B's row isn't lost.
;  330        if (x0 == x1) then
	CMPG	FCPLOT.TABLE_COMMAND.$N3.X0,FCPLOT.TABLE_COMMAND.$N3.X1
	BNEQ	FCPLOT.TABLE_COMMAND.$N3.$1
;  331          n = 1
	MOVL	#1,FCPLOT.TABLE_COMMAND.$N3.N
;  332          step = 0
	CLRG	FCPLOT.TABLE_COMMAND.$N3.STEP
;  333        else
	BRW	FCPLOT.TABLE_COMMAND.$N3.$3
