FCPLOT.DRAW.$25:
	CVTLW	FCPLOT.DRAW.$T1,FCPLOT.DRAW.GRID
	MOVL	@FCPLOT.DRAW.$A9,FCPLOT.DRAW.GRID+28
	MOVL	FCPLOT.DRAW.GRID+28,FCPLOT.DRAW.GRID+20
	BGEQ	FCPLOT.DRAW.$27
	CLRL	FCPLOT.DRAW.GRID+20
FCPLOT.DRAW.$27:
	MOVZWL	FCPLOT.DRAW.GRID,R0
