	MOVL	20(R0),FCPLOT.DRAW.$B1+20
	MOVL	FCPLOT.DRAW.XS(AP),R0
	MOVL	FCPLOT.DRAW.XS(AP),R1
	SUBL3	24(R1),28(R0),R0
	ADDL3	R0,#1,FCPLOT.DRAW.$T1
	BRB	FCPLOT.DRAW.$3
