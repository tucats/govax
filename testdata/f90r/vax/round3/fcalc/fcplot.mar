	MULL3	#208,FCPLOT.DRAW.$B4+28,FCPLOT.DRAW.$B4+12
	MOVL	@FCPLOT.DRAW.$A8,FCPLOT.DRAW.$T1
	BGEQ	FCPLOT.DRAW.$25
