;  742      real(rk), intent(in) :: xs(:), ys(:, :), xlo, xhi, ylo, yhi
;  743      logical, intent(in) :: ok(:, :)
;  744      integer, intent(in) :: width, height
;  745      type(expression), intent(in) :: list(:)
;  746      character(len=width) :: grid(height)
;  747      character(len=120) :: top, bottom, left, rightmost
;  748      character(len=2 * max_width + 120) :: across
;  749      integer :: j, k, r, c, r0, c0, labels, at
;  750
;  751      ! The axes first, so a mark covers them.
;  752      grid = ' '
	MOVL	FCPLOT.DRAW.GRID+20,FCPLOT.DRAW.$T1
	BGEQ	FCPLOT.DRAW.$29
	CLRL	FCPLOT.DRAW.$T1
FCPLOT.DRAW.$29:
