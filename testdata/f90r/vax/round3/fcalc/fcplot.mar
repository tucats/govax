	MOVL	4(R0),FCPLOT.READ_LIST.$B1+4
	MOVL	FCPLOT.READ_LIST.LIST(AP),R0
	CMPB	3(R0),#4
	BEQL	FCPLOT.READ_LIST.$1
	MOVL	FCPLOT.READ_LIST.LIST(AP),R0
	MOVL	20(R0),FCPLOT.READ_LIST.$B1+20
	MOVL	FCPLOT.READ_LIST.LIST(AP),R0
	MOVL	FCPLOT.READ_LIST.LIST(AP),R1
	SUBL3	24(R1),28(R0),R0
	ADDL3	R0,#1,R6
