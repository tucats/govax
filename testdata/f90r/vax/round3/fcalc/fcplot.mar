;    1  ! fcalc: TABLE and PLOT, an expression's values in columns and as a graph.
;    2  !
;    3  !     TABLE expr[, expr...] FOR x FROM a TO b [STEP s]
;    4  !     TABLE v[, w...]
;    5  !     PLOT expr[, expr...] FOR x FROM a TO b [SIZE w, h] [Y lo, hi]
;    6  !     PLOT v[, w...] [VERSUS u] [SIZE w, h] [Y lo, hi]
;    7  !
;    8  ! TABLE with FOR evaluates each expression at A, A + S, A + 2S, ..., up to
;    9  ! B (S is (B - A)/10 if no STEP is given), as FCNUMERIC's commands do,
;   10  ! through FCEVAL's EVALUATE_WITH: the name after FOR stands for the point,
;   11  ! and a variable of that name is left alone. Each row shows the point and
;   12  ! the expressions' values there. Without FOR, each expression is a vector,
;   13  ! all of one length, and the table is the vectors side by side.
;   14  !
;   15  ! PLOT with FOR evaluates each expression at as many points as the graph
;   16  ! is wide, from A to B, and marks each value in its column. Without FOR,
;   17  ! each expression is a vector, drawn against its index (1, 2, ...), or,
;   18  ! after VERSUS, against the elements of the vector U. The graph is W
;   19  ! characters wide and H high (61 by 19 unless SIZE says otherwise); its
;   20  ! vertical range is the values' smallest to largest, unless Y gives it.
;   21  ! Each curve has its mark, *, o, #, x, @, %, &, and $ in order, named in
;   22  ! the legend under the graph; a later curve's mark covers an earlier one's.
;   23  ! The axes are drawn where zero is in the range: a row of - for y = 0 and
;   24  ! a column of | for x = 0, + where they cross; at the graph's left edge the
;   25  ! frame is the y axis.
;   26  !
;   27  ! A point where an expression can't be evaluated (1/X at 0) is the error's
;   28  ! name in a table, DIVZERO, and no mark in a graph; so is a point whose
;   29  ! value isn't real, in a graph, which has no place for an imaginary part.
;   30  ! The errors that are a point's are the arithmetic's (POINT_ERROR); any
;   31  ! other, a name not defined or a vector where a number was wanted, stops
;   32  ! the command, at every point alike.
;   33  !
;   34  ! A graph is exact in one way only: a value's row is the nearest to it, in
;   35  ! H rows from the range's top to its bottom, and a point's column the
;   36  ! nearest in W. So a mark is where the value rounds to, by Fortran's NINT,
;   37  ! and a value halfway between two rows goes away from zero, wherever the
;   38  ! arithmetic leaves it; a test chooses values that aren't halfway, so
;   39  ! machines with different last bits draw the same marks.
;   40  !
;   41  ! This module exercises arrays whose size is known only when the program
;   42  ! runs: an automatic CHARACTER array of the graph's rows, whose length and
;   43  ! number are its arguments' (GRID in DRAW); allocatable arrays of the
;   44  ! samples and the table's cells; an array-valued function (SAMPLES); WHERE;
;   45  ! MINVAL and MAXVAL with MASK=; and LEN_TRIM of an array, which, like
;   46  ! every elemental intrinsic, is the array of each element's.
;   47  module fcplot
;   48    use fckinds
;   49    use fcmessages
;   50    use fcvalues
;   51    use fcarrays
;   52    use fctree
;   53    use fceval
;   54    ! USE ... ONLY: the command readers FCNUMERIC's commands share, and
;   55    ! nothing else of FCNUMERIC's.
;   56    use fcnumeric, only: at_word, read_word, read_name, read_bound, at_end_of_line
;   57    implicit none
;   58    private
;   59
;   60    public :: table_command, plot_command
;   61
;   62    ! The most expressions a command takes (one mark each in a graph), and
;   63    ! the most rows a table has.
;   64    integer, parameter :: max_columns = 8, max_rows = 1000
;   65
;   66    ! A graph's size unless SIZE gives it, and the limits SIZE may give:
;   67    ! the widest leaves room on a 132-character line for the labels.
;   68    integer, parameter :: default_width = 61, default_height = 19
;   69    integer, parameter :: min_width = 10, max_width = 100, min_height = 3, max_height = 60
;   70
;   71    ! The curves' marks, in order.
;   72    character(len=max_columns), parameter :: marks = '*o#x@%&$'
;   73
;   74    ! The longest text a table's cell holds: a value as FORMAT_VALUE shows it.
;   75    integer, parameter :: cell_length = 120
;   76
;   77    ! An expression of the command: its tree, the column it starts at, and
;   78    ! its text as the user typed it, for a heading or the legend.
;   79    !
;   80    ! Fortran 90 has no array of pointers: an array's elements can't each
;   81    ! be a pointer. An array of a derived type with a pointer component is
;   82    ! the way to one, LIST(K)%P.
;   83    type expression
;   84      type(node), pointer :: p
;   85      integer :: column
;   86      character(len=line_length) :: text
;   87    end type expression
;   88
;   89    ! How PLOT places its points across: at points it chooses, FOR; at a
;   90    ! vector's elements, VERSUS; or at the index.
;   91    integer, parameter :: by_points = 1, by_versus = 2, by_index = 3
;   92
;   93  contains

