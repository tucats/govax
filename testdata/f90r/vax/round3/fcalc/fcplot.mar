	MOVG	R0,FCPLOT.SAMPLES.$T3
	PUSHAG	FCPLOT.SAMPLES.LEVEL
	PUSHAG	FCPLOT.SAMPLES.$T3
	CALLS	#2,G^FCPLOT.WITHOUT_NOISE
	MOVG	R0,@FCPLOT.SAMPLES.X+16[R6]
;  260      end do
	AOBLEQ	R7,R6,FCPLOT.SAMPLES.$5
	MOVL	R6,FCPLOT.SAMPLES.J
FCPLOT.SAMPLES.$3:
;  261      x(n) = b
