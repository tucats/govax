;   R9 is $T2: temporary
;   R10 is $T3: temporary
;   R11 is $T5: temporary
;   R11 is $L7: array (line 570), dimension 1's limit
;   R6 is $T12: temporary
;   R7 is $R1: an index stepped with K
;   R6 is $R2: K, during a loop
;   FCPLOT.PLOT_COMMAND.$N4 is FCPLOT.PLOT_COMMAND.ACROSS_COLUMN
;   FCPLOT.PLOT_COMMAND.$N5 is FCPLOT.PLOT_COMMAND.POINTS_BY_FOR
;   FCPLOT.PLOT_COMMAND.$N6 is FCPLOT.PLOT_COMMAND.POINTS_BY_VERSUS
;   FCPLOT.PLOT_COMMAND.$N7 is FCPLOT.PLOT_COMMAND.POINTS_BY_INDEX
;
FCPLOT.PLOT_COMMAND.LINE = 4		; LINE is argument 1

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
	.ALIGN	4			; the boundary of this routine's aligned records
FCPLOT.PLOT_COMMAND.LIST:
	.BLKL	416			; LIST, TYPE(EXPRESSION) (8)
FCPLOT.PLOT_COMMAND.ACROSS:
	.BLKL	1			; ACROSS
FCPLOT.PLOT_COMMAND.NAME:
	.BLKB	31			; NAME
	.BLKB	13
FCPLOT.PLOT_COMMAND.A:
	.BLKL	8			; A
FCPLOT.PLOT_COMMAND.B:
	.BLKL	8			; B
FCPLOT.PLOT_COMMAND.BOUND:
	.BLKL	8			; BOUND
FCPLOT.PLOT_COMMAND.COUNT:
	.BLKL	1			; COUNT
FCPLOT.PLOT_COMMAND.K:
	.BLKL	1			; K
FCPLOT.PLOT_COMMAND.COLUMN:
	.BLKL	1			; COLUMN
FCPLOT.PLOT_COMMAND.$N4:
	.BLKL	1			; ACROSS_COLUMN
FCPLOT.PLOT_COMMAND.FORM:
	.BLKL	1			; FORM
FCPLOT.PLOT_COMMAND.WIDTH:
	.BLKL	1			; WIDTH
FCPLOT.PLOT_COMMAND.HEIGHT:
	.BLKL	1			; HEIGHT
FCPLOT.PLOT_COMMAND.YLO:
	.BLKL	2			; YLO
FCPLOT.PLOT_COMMAND.YHI:
	.BLKL	2			; YHI
FCPLOT.PLOT_COMMAND.XLO:
	.BLKL	2			; XLO
FCPLOT.PLOT_COMMAND.XHI:
	.BLKL	2			; XHI
FCPLOT.PLOT_COMMAND.Y_GIVEN:
	.BLKL	1			; Y_GIVEN
FCPLOT.PLOT_COMMAND.XS:
	.WORD	8			; length
	.BYTE	DSC$K_DTYPE_G,DSC$K_CLASS_NCA
	.LONG	0			; XS: not allocated
	.BYTE	0,0,0,1			; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0			; strides, in bytes
	.LONG	0,0			; bounds
FCPLOT.PLOT_COMMAND.YS:
	.WORD	8			; length
	.BYTE	DSC$K_DTYPE_G,DSC$K_CLASS_NCA
	.LONG	0			; YS: not allocated
	.BYTE	0,0,0,2			; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0,0			; strides, in bytes
	.LONG	0,0,0,0			; bounds
FCPLOT.PLOT_COMMAND.OK:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_LU,DSC$K_CLASS_NCA
	.LONG	0			; OK: not allocated
	.BYTE	0,0,0,2			; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0,0			; strides, in bytes
	.LONG	0,0,0,0			; bounds
FCPLOT.PLOT_COMMAND.$D1:
	.WORD	208			; length
	.BYTE	DSC$K_DTYPE_Z,DSC$K_CLASS_NCA
	.LONG	0			; set when the descriptor is used
	.BYTE	0,0,0,1			; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0			; strides, in bytes
	.LONG	0,0			; bounds
FCPLOT.PLOT_COMMAND.$T4:
	.BLKL	1			; temporary
FCPLOT.PLOT_COMMAND.$L2:
	.BLKL	1			; array (line 564), dimension 2's limit
FCPLOT.PLOT_COMMAND.$L3:
	.BLKL	1			; array (line 564), dimension 1's limit
FCPLOT.PLOT_COMMAND.$T6:
	.BLKL	1			; temporary
FCPLOT.PLOT_COMMAND.$T7:
	.BLKL	2			; temporary
FCPLOT.PLOT_COMMAND.$L4:
	.BLKL	1			; array (line 569), dimension 2's limit
FCPLOT.PLOT_COMMAND.$L5:
	.BLKL	1			; array (line 569), dimension 1's limit
FCPLOT.PLOT_COMMAND.$T8:
	.BLKL	2			; temporary
FCPLOT.PLOT_COMMAND.$L6:
	.BLKL	1			; array (line 570), dimension 2's limit
FCPLOT.PLOT_COMMAND.$T9:
	.BLKL	1			; temporary
FCPLOT.PLOT_COMMAND.$T10:
	.BLKL	1			; temporary
FCPLOT.PLOT_COMMAND.$T11:
	.BLKL	1			; temporary
FCPLOT.PLOT_COMMAND.$L8:
	.BLKL	1			; array (line 575), dimension 2's limit
FCPLOT.PLOT_COMMAND.$L9:
	.BLKL	1			; array (line 575), dimension 1's limit

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCPLOT.PLOT_COMMAND.$K1:
	.LONG	1
FCPLOT.PLOT_COMMAND.$D2:
	.WORD	3			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCPLOT.PLOT_COMMAND.$K2
FCPLOT.PLOT_COMMAND.$D3:
	.WORD	31			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCPLOT.PLOT_COMMAND.NAME
FCPLOT.PLOT_COMMAND.$D4:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCPLOT.PLOT_COMMAND.$K3
FCPLOT.PLOT_COMMAND.$D5:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCPLOT.PLOT_COMMAND.$K4
FCPLOT.PLOT_COMMAND.$K5:
	.LONG	-1
FCPLOT.PLOT_COMMAND.$D6:
	.WORD	2			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCPLOT.PLOT_COMMAND.$K6
FCPLOT.PLOT_COMMAND.$D7:
	.WORD	2			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCPLOT.PLOT_COMMAND.$K7
FCPLOT.PLOT_COMMAND.$K8:
	.LONG	43
FCPLOT.PLOT_COMMAND.$D8:
	.WORD	6			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCPLOT.PLOT_COMMAND.$K9
FCPLOT.PLOT_COMMAND.$D9:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCPLOT.PLOT_COMMAND.$K10
FCPLOT.PLOT_COMMAND.$K11:
	.LONG	10
FCPLOT.PLOT_COMMAND.$K12:
	.LONG	100
FCPLOT.PLOT_COMMAND.$K13:
	.LONG	3
FCPLOT.PLOT_COMMAND.$K14:
	.LONG	60
FCPLOT.PLOT_COMMAND.$D10:
	.WORD	1			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCPLOT.PLOT_COMMAND.$K15
FCPLOT.PLOT_COMMAND.$K16:
	.LONG	44
FCPLOT.PLOT_COMMAND.$KF1:
	.LONG	^XFFFF7FFF,^XFFFFFFFF	; 8.988465674311579D307
FCPLOT.PLOT_COMMAND.$KF2:
	.LONG	^XFFFFFFFF,^XFFFFFFFF	; -8.988465674311579D307
FCPLOT.PLOT_COMMAND.$K2:
	.ASCII	/for/
FCPLOT.PLOT_COMMAND.$K3:
	.ASCII	/from/
FCPLOT.PLOT_COMMAND.$K4:
	.ASCII	/FROM/
FCPLOT.PLOT_COMMAND.$K6:
	.ASCII	/to/
FCPLOT.PLOT_COMMAND.$K7:
	.ASCII	/TO/
FCPLOT.PLOT_COMMAND.$K9:
	.ASCII	/versus/
FCPLOT.PLOT_COMMAND.$K10:
	.ASCII	/size/
FCPLOT.PLOT_COMMAND.$K15:
	.ASCII	/y/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  471    end subroutine show_table
;  472
;  473    ! ------------------------------------------------------------------
;  474    ! PLOT.
;  475
;  476    subroutine plot_command(line)
	.ENTRY	FCPLOT.PLOT_COMMAND,^M<R2,R3,R6,R7,R8,R9,R10,R11>
	CLRL	FCPLOT.PLOT_COMMAND.XS+4
	CLRL	FCPLOT.PLOT_COMMAND.YS+4
	CLRL	FCPLOT.PLOT_COMMAND.OK+4
;  477      character(len=*), intent(in) :: line
;  478      type(expression) :: list(max_columns)
;  479      type(node), pointer :: across
;  480      character(len=name_length) :: name
;  481      type(value) :: a, b, bound
;  482      integer :: count, k, column, across_column, form, width, height
;  483      real(rk) :: ylo, yhi, xlo, xhi
;  484      logical :: y_given
;  485      ! The points: each one's place across, XS(J), and each curve's value
;  486      ! there, YS(J, K), if OK(J, K) says it has one.
;  487      real(rk), allocatable :: xs(:), ys(:, :)
;  488      logical, allocatable :: ok(:, :)
;  489
;  490      do k = 1, max_columns
	MOVL	#1,FCPLOT.PLOT_COMMAND.K
	MULL3	FCPLOT.PLOT_COMMAND.K,#52,R7
	MOVL	FCPLOT.PLOT_COMMAND.K,R6
FCPLOT.PLOT_COMMAND.$1:			; DO (line 490)'s body
;  491        nullify (list(k)%p)
	CLRL	FCPLOT.PLOT_COMMAND.LIST-208[R7]
;  492      end do
	ADDL2	#52,R7
	AOBLEQ	#8,R6,FCPLOT.PLOT_COMMAND.$1
	MOVL	R6,FCPLOT.PLOT_COMMAND.K
;  493      nullify (across)
	CLRL	FCPLOT.PLOT_COMMAND.ACROSS
;  494      count = 0
	CLRL	FCPLOT.PLOT_COMMAND.COUNT
;  495      form = by_index
	MOVL	#3,FCPLOT.PLOT_COMMAND.FORM
;  496      width = default_width
	MOVL	#61,FCPLOT.PLOT_COMMAND.WIDTH
;  497      height = default_height
	MOVL	#19,FCPLOT.PLOT_COMMAND.HEIGHT
;  498      y_given = .false.
	CLRL	FCPLOT.PLOT_COMMAND.Y_GIVEN
;  499      ylo = 0
	CLRG	FCPLOT.PLOT_COMMAND.YLO
;  500      yhi = 0
	CLRG	FCPLOT.PLOT_COMMAND.YHI
;  501      call advance(1)
	PUSHAL	FCPLOT.PLOT_COMMAND.$K1
	CALLS	#1,G^FCTREE.ADVANCE
;  502
;  503      read: do
;  504        if (.not. read_list(line, list, count)) exit read
	MOVAB	FCPLOT.PLOT_COMMAND.LIST,FCPLOT.PLOT_COMMAND.$D1+4
	MOVL	#208,FCPLOT.PLOT_COMMAND.$D1+20
	MOVL	#1,FCPLOT.PLOT_COMMAND.$D1+24
	MOVL	#8,FCPLOT.PLOT_COMMAND.$D1+28
	SUBL3	#208,FCPLOT.PLOT_COMMAND.$D1+4,FCPLOT.PLOT_COMMAND.$D1+16
	MOVL	#1664,FCPLOT.PLOT_COMMAND.$D1+12
	PUSHAL	FCPLOT.PLOT_COMMAND.COUNT
	PUSHAQ	FCPLOT.PLOT_COMMAND.$D1
	PUSHL	FCPLOT.PLOT_COMMAND.LINE(AP)
	CALLS	#3,G^FCPLOT.READ_LIST
	MOVL	R0,R8
	BLBS	R8,FCPLOT.PLOT_COMMAND.$4
	BRW	FCPLOT.PLOT_COMMAND.$3
FCPLOT.PLOT_COMMAND.$4:
;  505        if (at_word('for')) then
	PUSHAQ	FCPLOT.PLOT_COMMAND.$D2
	CALLS	#1,G^FCNUMERIC.AT_WORD
	MOVL	R0,R8
	BLBS	R8,FCPLOT.PLOT_COMMAND.$6
	BRW	FCPLOT.PLOT_COMMAND.$5
FCPLOT.PLOT_COMMAND.$6:
;  506          call advance(1)
	PUSHAL	FCPLOT.PLOT_COMMAND.$K1
	CALLS	#1,G^FCTREE.ADVANCE
;  507          form = by_points
	MOVL	#1,FCPLOT.PLOT_COMMAND.FORM
;  508          if (.not. read_name(name)) exit read
	PUSHAQ	FCPLOT.PLOT_COMMAND.$D3
	CALLS	#1,G^FCNUMERIC.READ_NAME
	MOVL	R0,R8
	BLBS	R8,FCPLOT.PLOT_COMMAND.$7
	BRW	FCPLOT.PLOT_COMMAND.$3
FCPLOT.PLOT_COMMAND.$7:
;  509          if (.not. read_word('from', 'FROM')) exit read
	PUSHAQ	FCPLOT.PLOT_COMMAND.$D5
	PUSHAQ	FCPLOT.PLOT_COMMAND.$D4
	CALLS	#2,G^FCNUMERIC.READ_WORD
	MOVL	R0,R8
	BLBS	R8,FCPLOT.PLOT_COMMAND.$8
	BRW	FCPLOT.PLOT_COMMAND.$3
FCPLOT.PLOT_COMMAND.$8:
;  510          if (.not. read_bound(a, .true., column)) exit read
	PUSHAL	FCPLOT.PLOT_COMMAND.COLUMN
	PUSHAL	FCPLOT.PLOT_COMMAND.$K5
	PUSHAB	FCPLOT.PLOT_COMMAND.A
	CALLS	#3,G^FCNUMERIC.READ_BOUND
	MOVL	R0,R8
	BLBS	R8,FCPLOT.PLOT_COMMAND.$9
	BRW	FCPLOT.PLOT_COMMAND.$3
FCPLOT.PLOT_COMMAND.$9:
;  511          if (.not. read_word('to', 'TO')) exit read
	PUSHAQ	FCPLOT.PLOT_COMMAND.$D7
	PUSHAQ	FCPLOT.PLOT_COMMAND.$D6
	CALLS	#2,G^FCNUMERIC.READ_WORD
	MOVL	R0,R8
	BLBS	R8,FCPLOT.PLOT_COMMAND.$10
	BRW	FCPLOT.PLOT_COMMAND.$3
FCPLOT.PLOT_COMMAND.$10:
;  512          if (.not. read_bound(b, .true., column)) exit read
	PUSHAL	FCPLOT.PLOT_COMMAND.COLUMN
	PUSHAL	FCPLOT.PLOT_COMMAND.$K5
	PUSHAB	FCPLOT.PLOT_COMMAND.B
	CALLS	#3,G^FCNUMERIC.READ_BOUND
	MOVL	R0,R8
	BLBS	R8,FCPLOT.PLOT_COMMAND.$11
	BRW	FCPLOT.PLOT_COMMAND.$3
FCPLOT.PLOT_COMMAND.$11:
;  513          if (real(b%z, rk) <= real(a%z, rk)) then
	CMPG	FCPLOT.PLOT_COMMAND.B,FCPLOT.PLOT_COMMAND.A
	BGTR	FCPLOT.PLOT_COMMAND.$14
;  514            call fail(e_badlimits, column)
	PUSHL	#0
	PUSHAL	FCPLOT.PLOT_COMMAND.COLUMN
	PUSHAL	FCPLOT.PLOT_COMMAND.$K8
	CALLS	#3,G^FCMESSAGES.FAIL
;  515            exit read
	BRW	FCPLOT.PLOT_COMMAND.$3
;  516          end if
;  517        else if (at_word('versus')) then
FCPLOT.PLOT_COMMAND.$5:
	PUSHAQ	FCPLOT.PLOT_COMMAND.$D8
	CALLS	#1,G^FCNUMERIC.AT_WORD
	MOVL	R0,R8
	BLBC	R8,FCPLOT.PLOT_COMMAND.$14
;  518          call advance(1)
	PUSHAL	FCPLOT.PLOT_COMMAND.$K1
	CALLS	#1,G^FCTREE.ADVANCE
;  519          form = by_versus
	MOVL	#2,FCPLOT.PLOT_COMMAND.FORM
;  520          across_column = current_column()
	CALLS	#0,G^FCTREE.CURRENT_COLUMN
	MOVL	R0,FCPLOT.PLOT_COMMAND.$N4
;  521          across => parse_expression()
	CALLS	#0,G^FCTREE.PARSE_EXPRESSION
	MOVL	R0,R8
	MOVL	R8,FCPLOT.PLOT_COMMAND.ACROSS
;  522          if (failed()) exit read
	CALLS	#0,G^FCMESSAGES.FAILED
	MOVL	R0,R8
	BLBC	R8,FCPLOT.PLOT_COMMAND.$16
	BRW	FCPLOT.PLOT_COMMAND.$3
FCPLOT.PLOT_COMMAND.$16:
;  523        end if
FCPLOT.PLOT_COMMAND.$14:
;  524
;  525        ! The options, in any order. EXIT READ leaves the outer construct,
;  526        ! READ, from inside this unnamed one: a construct name lets EXIT
;  527        ! leave more than the innermost loop.
;  528        do
FCPLOT.PLOT_COMMAND.$17:		; DO (line 528)'s body
;  529          if (at_word('size')) then
	PUSHAQ	FCPLOT.PLOT_COMMAND.$D9
	CALLS	#1,G^FCNUMERIC.AT_WORD
	MOVL	R0,R8
	BLBC	R8,FCPLOT.PLOT_COMMAND.$18
;  530            call advance(1)
	PUSHAL	FCPLOT.PLOT_COMMAND.$K1
	CALLS	#1,G^FCTREE.ADVANCE
;  531            if (.not. read_whole(width, min_width, max_width)) exit read
	PUSHAL	FCPLOT.PLOT_COMMAND.$K12
	PUSHAL	FCPLOT.PLOT_COMMAND.$K11
	PUSHAL	FCPLOT.PLOT_COMMAND.WIDTH
	CALLS	#3,G^FCPLOT.READ_WHOLE
	MOVL	R0,R8
	BLBS	R8,FCPLOT.PLOT_COMMAND.$20
	BRW	FCPLOT.PLOT_COMMAND.$3
FCPLOT.PLOT_COMMAND.$20:
;  532            if (.not. read_comma()) exit read
	CALLS	#0,G^FCPLOT.READ_COMMA
	MOVL	R0,R8
	BLBS	R8,FCPLOT.PLOT_COMMAND.$21
	BRW	FCPLOT.PLOT_COMMAND.$3
FCPLOT.PLOT_COMMAND.$21:
;  533            if (.not. read_whole(height, min_height, max_height)) exit read
	PUSHAL	FCPLOT.PLOT_COMMAND.$K14
	PUSHAL	FCPLOT.PLOT_COMMAND.$K13
	PUSHAL	FCPLOT.PLOT_COMMAND.HEIGHT
	CALLS	#3,G^FCPLOT.READ_WHOLE
	MOVL	R0,R8
	BLBS	R8,FCPLOT.PLOT_COMMAND.$17
	BRW	FCPLOT.PLOT_COMMAND.$3
;  534          else if (at_word('y')) then
FCPLOT.PLOT_COMMAND.$18:
	PUSHAQ	FCPLOT.PLOT_COMMAND.$D10
	CALLS	#1,G^FCNUMERIC.AT_WORD
	MOVL	R0,R8
	BLBS	R8,FCPLOT.PLOT_COMMAND.$25
	BRW	FCPLOT.PLOT_COMMAND.$31
FCPLOT.PLOT_COMMAND.$25:
;  535            call advance(1)
	PUSHAL	FCPLOT.PLOT_COMMAND.$K1
	CALLS	#1,G^FCTREE.ADVANCE
;  536            if (.not. read_bound(bound, .true., column)) exit read
	PUSHAL	FCPLOT.PLOT_COMMAND.COLUMN
	PUSHAL	FCPLOT.PLOT_COMMAND.$K5
	PUSHAB	FCPLOT.PLOT_COMMAND.BOUND
	CALLS	#3,G^FCNUMERIC.READ_BOUND
	MOVL	R0,R8
	BLBS	R8,FCPLOT.PLOT_COMMAND.$26
	BRW	FCPLOT.PLOT_COMMAND.$3
FCPLOT.PLOT_COMMAND.$26:
;  537            ylo = real(bound%z, rk)
	MOVG	FCPLOT.PLOT_COMMAND.BOUND,FCPLOT.PLOT_COMMAND.YLO
;  538            if (.not. read_comma()) exit read
	CALLS	#0,G^FCPLOT.READ_COMMA
	MOVL	R0,R8
	BLBS	R8,FCPLOT.PLOT_COMMAND.$27
	BRW	FCPLOT.PLOT_COMMAND.$3
FCPLOT.PLOT_COMMAND.$27:
;  539            if (.not. read_bound(bound, .true., column)) exit read
	PUSHAL	FCPLOT.PLOT_COMMAND.COLUMN
	PUSHAL	FCPLOT.PLOT_COMMAND.$K5
	PUSHAB	FCPLOT.PLOT_COMMAND.BOUND
	CALLS	#3,G^FCNUMERIC.READ_BOUND
	MOVL	R0,R8
	BLBS	R8,FCPLOT.PLOT_COMMAND.$28
	BRW	FCPLOT.PLOT_COMMAND.$3
FCPLOT.PLOT_COMMAND.$28:
;  540            yhi = real(bound%z, rk)
	MOVG	FCPLOT.PLOT_COMMAND.BOUND,FCPLOT.PLOT_COMMAND.YHI
;  541            if (yhi <= ylo) then
	CMPG	FCPLOT.PLOT_COMMAND.YHI,FCPLOT.PLOT_COMMAND.YLO
	BGTR	FCPLOT.PLOT_COMMAND.$29
;  542              call fail(e_badlimits, column)
	PUSHL	#0
	PUSHAL	FCPLOT.PLOT_COMMAND.COLUMN
	PUSHAL	FCPLOT.PLOT_COMMAND.$K8
	CALLS	#3,G^FCMESSAGES.FAIL
;  543              exit read
	BRW	FCPLOT.PLOT_COMMAND.$3
FCPLOT.PLOT_COMMAND.$29:
;  544            end if
;  545            y_given = .true.
	MOVL	#-1,FCPLOT.PLOT_COMMAND.Y_GIVEN
;  546          else
	BRW	FCPLOT.PLOT_COMMAND.$17
;  547            exit
;  548          end if
;  549        end do
FCPLOT.PLOT_COMMAND.$31:
;  550        if (.not. at_end_of_line()) exit read
	CALLS	#0,G^FCNUMERIC.AT_END_OF_LINE
	MOVL	R0,R8
	BLBS	R8,FCPLOT.PLOT_COMMAND.$32
	BRW	FCPLOT.PLOT_COMMAND.$3
FCPLOT.PLOT_COMMAND.$32:
;  551
;  552        select case (form)
	CMPL	FCPLOT.PLOT_COMMAND.FORM,#1
	BEQL	FCPLOT.PLOT_COMMAND.$33
	CMPL	FCPLOT.PLOT_COMMAND.FORM,#2
	BNEQ	FCPLOT.PLOT_COMMAND.$37
	BRB	FCPLOT.PLOT_COMMAND.$35
FCPLOT.PLOT_COMMAND.$33:
;  553        case (by_points)
;  554          call points_by_for()
	CALLS	#0,FCPLOT.PLOT_COMMAND.$N5
;  555        case (by_versus)
	BRB	FCPLOT.PLOT_COMMAND.$38
FCPLOT.PLOT_COMMAND.$35:
;  556          call points_by_versus()
	CALLS	#0,FCPLOT.PLOT_COMMAND.$N6
;  557        case default
	BRB	FCPLOT.PLOT_COMMAND.$38
FCPLOT.PLOT_COMMAND.$37:
;  558          call points_by_index()
	CALLS	#0,FCPLOT.PLOT_COMMAND.$N7
;  559        end select
FCPLOT.PLOT_COMMAND.$38:
;  560        if (failed()) exit read
	CALLS	#0,G^FCMESSAGES.FAILED
	MOVL	R0,R8
	BLBC	R8,FCPLOT.PLOT_COMMAND.$39
	BRW	FCPLOT.PLOT_COMMAND.$3
FCPLOT.PLOT_COMMAND.$39:
;  561
;  562        ! The range down: the values', or Y's. (MINVAL and MAXVAL with MASK=
;  563        ! look only at the elements whose MASK is true.)
;  564        if (.not. any(ok)) then
	SUBL3	#1,FCPLOT.PLOT_COMMAND.OK+28,R8
	SUBL3	#1,FCPLOT.PLOT_COMMAND.OK+36,R9
	SUBL3	FCPLOT.PLOT_COMMAND.OK+28,FCPLOT.PLOT_COMMAND.OK+32,R0
	ADDL3	R0,#1,R10
