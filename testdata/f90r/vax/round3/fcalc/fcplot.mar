	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  813
;  814      ! ROW_OF is the row a value Y is nearest, 1 the top (YHI) and HEIGHT
;  815      ! the bottom (YLO): Y's fraction of the way down the range, times the
;  816      ! rows between, rounded. Each subtraction and the division are guarded
;  817      ! (R_ADD, R_DIV), so values near the VAX's smallest can't underflow.
;  818      integer function row_of(y)
FCPLOT.DRAW.ROW_OF:
	.WORD	^M<>			; internal procedure ROW_OF of FCPLOT.DRAW
;  819        real(rk), intent(in) :: y
;  820        integer :: err
;  821
;  822        err = 0
	CLRL	FCPLOT.DRAW.ROW_OF.ERR
;  823        row_of = 1 + nint(r_div(r_add(yhi, -y, err), r_add(yhi, -ylo, err), err) * (height - 1))
	MNEGG	@FCPLOT.DRAW.ROW_OF.Y(AP),FCPLOT.DRAW.ROW_OF.$T3
	PUSHAL	FCPLOT.DRAW.ROW_OF.ERR
	PUSHAG	FCPLOT.DRAW.ROW_OF.$T3
	PUSHAG	@FCPLOT.DRAW.$A7
	CALLS	#3,G^FCVALUES.R_ADD
	MOVG	R0,FCPLOT.DRAW.ROW_OF.$T2
	MNEGG	@FCPLOT.DRAW.$A6,FCPLOT.DRAW.ROW_OF.$T5
	PUSHAL	FCPLOT.DRAW.ROW_OF.ERR
	PUSHAG	FCPLOT.DRAW.ROW_OF.$T5
	PUSHAG	@FCPLOT.DRAW.$A7
	CALLS	#3,G^FCVALUES.R_ADD
	MOVG	R0,FCPLOT.DRAW.ROW_OF.$T4
	PUSHAL	FCPLOT.DRAW.ROW_OF.ERR
	PUSHAG	FCPLOT.DRAW.ROW_OF.$T4
	PUSHAG	FCPLOT.DRAW.ROW_OF.$T2
	CALLS	#3,G^FCVALUES.R_DIV
	MOVG	R0,FCPLOT.DRAW.ROW_OF.$T1
;  824      end function row_of
	SUBL3	#1,@FCPLOT.DRAW.$A9,R0	; the function's value
	CVTLG	R0,R0
	MULG2	FCPLOT.DRAW.ROW_OF.$T1,R0
	CVTRGL	R0,R0
	INCL	R0
	RET

