;  734
;  735    ! DRAW draws the graph: the points' marks in a grid WIDTH by HEIGHT, the
;  736    ! axes, a frame with the range's labels, and the legend.
;  737    !
;  738    ! GRID is an automatic array: a local array whose size (here, and its
;  739    ! elements' length too) is given by the procedure's arguments, made when
;  740    ! the procedure is called and gone when it returns.
;  741    subroutine draw(xs, ys, ok, xlo, xhi, ylo, yhi, width, height, list)
	.ENTRY	FCPLOT.DRAW,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
