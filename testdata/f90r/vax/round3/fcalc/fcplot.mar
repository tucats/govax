;  721    end subroutine plot_command
;  722
;  723    ! WIDEN makes a range of one value, LO = HI, into one around it: V less
;  724    ! and more max(1, |V|), so a constant's line is in the middle.
;  725    subroutine widen(lo, hi)
	.ENTRY	FCPLOT.WIDEN,^M<R6,R7,R8,R9>
;  726      real(rk), intent(inout) :: lo, hi
;  727      real(rk) :: d
;  728
;  729      if (lo /= hi) return
