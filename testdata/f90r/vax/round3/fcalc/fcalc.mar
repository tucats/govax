;  137
;  138    ! RUN runs the line TEXT.
;  139    recursive subroutine run(text)
FCALC.RUN:
	.WORD	^M<R2,R3,R4,R5,R6>	; internal procedure RUN of FCALC
	SUBL2	#180,SP			; this activation's own storage
;  140      character(len=*), intent(in) :: text
;  141      type(token) :: first, second
;  142
;  143      ! The commands that name a file come first: a file's name isn't made
;  144      ! of fcalc's tokens (it may have [ ] and ; on VMS, / elsewhere).
;  145      if (file_command(text)) return
	PUSHL	FCALC.RUN.TEXT(AP)
	CALLS	#1,FCALC.FILE_COMMAND
	MOVL	R0,R6
	BLBC	R6,FCALC.RUN.$1
	RET
FCALC.RUN.$1:
;  146
;  147      call scan_line(text)
	PUSHL	FCALC.RUN.TEXT(AP)
	CALLS	#1,G^FCTREE.SCAN_LINE
;  148      if (failed()) return
	CALLS	#0,G^FCMESSAGES.FAILED
	MOVL	R0,R6
	BLBC	R6,FCALC.RUN.$3
	RET
FCALC.RUN.$3:
;  149
;  150      first = token_at(1)
	PUSHAL	FCALC.RUN.$K1
	PUSHAB	FCALC.RUN.$T2(FP)
	CALLS	#2,G^FCTREE.TOKEN_AT
	MOVC3	#56,FCALC.RUN.$T2(FP),FCALC.RUN.FIRST(FP)
;  151      second = token_at(2)
	PUSHAL	FCALC.RUN.$K2
	PUSHAB	FCALC.RUN.$T2(FP)
	CALLS	#2,G^FCTREE.TOKEN_AT
	MOVC3	#56,FCALC.RUN.$T2(FP),FCALC.RUN.SECOND(FP)
;  152
;  153      if (first%kind == t_name .and. .not. (second%kind == t_operator .and. &
;  154          (second%text == '=' .or. second%text == '('))) then
	CMPL	FCALC.RUN.FIRST(FP),#2
	BEQL	FCALC.RUN.$6
	BRW	FCALC.RUN.$5
FCALC.RUN.$6:
	CMPL	FCALC.RUN.SECOND(FP),#3
	BNEQ	FCALC.RUN.$7
	CMPC5	#31,FCALC.RUN.SECOND+8(FP),#^A/ /,#1,FCALC.RUN.$K3
	BNEQ	FCALC.RUN.$9
	BRW	FCALC.RUN.$5
FCALC.RUN.$9:
	CMPC5	#31,FCALC.RUN.SECOND+8(FP),#^A/ /,#1,FCALC.RUN.$K4
	BNEQ	FCALC.RUN.$10
	BRW	FCALC.RUN.$5
FCALC.RUN.$10:
FCALC.RUN.$7:
;  155        select case (first%text)
	CMPC5	#31,FCALC.RUN.FIRST+8(FP),#^A/ /,#4,FCALC.RUN.$K5
	BEQL	FCALC.RUN.$11
	CMPC5	#31,FCALC.RUN.FIRST+8(FP),#^A/ /,#4,FCALC.RUN.$K6
	BEQL	FCALC.RUN.$11
	CMPC5	#31,FCALC.RUN.FIRST+8(FP),#^A/ /,#4,FCALC.RUN.$K7
	BEQL	FCALC.RUN.$14
	CMPC5	#31,FCALC.RUN.FIRST+8(FP),#^A/ /,#5,FCALC.RUN.$K8
	BEQL	FCALC.RUN.$16
	CMPC5	#31,FCALC.RUN.FIRST+8(FP),#^A/ /,#3,FCALC.RUN.$K9
	BEQL	FCALC.RUN.$18
	CMPC5	#31,FCALC.RUN.FIRST+8(FP),#^A/ /,#4,FCALC.RUN.$K10
	BEQL	FCALC.RUN.$20
	CMPC5	#31,FCALC.RUN.FIRST+8(FP),#^A/ /,#5,FCALC.RUN.$K11
	BNEQ	FCALC.RUN.$24
	BRB	FCALC.RUN.$22
FCALC.RUN.$11:
;  156        case ('quit', 'exit')
;  157          done = .true.
	MOVL	#-1,FCALC.DONE
;  158          return
	RET
FCALC.RUN.$14:
;  159        case ('list')
;  160          call list_command()
	CALLS	#0,FCALC.LIST_COMMAND
;  161          return
	RET
FCALC.RUN.$16:
;  162        case ('clear')
;  163          call clear_command()
	CALLS	#0,FCALC.CLEAR_COMMAND
;  164          return
	RET
FCALC.RUN.$18:
;  165        case ('set')
;  166          call set_command()
	CALLS	#0,FCALC.SET_COMMAND
;  167          return
	RET
FCALC.RUN.$20:
;  168        case ('show')
;  169          call show_command()
	CALLS	#0,FCALC.SHOW_COMMAND
;  170          return
	RET
FCALC.RUN.$22:
;  171        case ('roots')
;  172          call roots_command()
	CALLS	#0,G^FCNUMERIC.ROOTS_COMMAND
;  173          return
	RET
FCALC.RUN.$24:
;  174        end select
;  175      end if
FCALC.RUN.$5:
;  176
;  177      ! SOLVE, INTEGRATE, DIFF, TABLE, and PLOT are reserved words, so they
;  178      ! may be followed by a parenthesis: DIFF (X + 1)^2 FOR X AT 1.
;  179      if (first%kind == t_name .and. .not. (second%kind == t_operator .and. &
;  180          second%text == '=')) then
	CMPL	FCALC.RUN.FIRST(FP),#2
	BEQL	FCALC.RUN.$26
	BRW	FCALC.RUN.$25
FCALC.RUN.$26:
	CMPL	FCALC.RUN.SECOND(FP),#3
	BNEQ	FCALC.RUN.$27
	CMPC5	#31,FCALC.RUN.SECOND+8(FP),#^A/ /,#1,FCALC.RUN.$K3
	BEQL	FCALC.RUN.$25
FCALC.RUN.$27:
;  181        select case (first%text)
	CMPC5	#31,FCALC.RUN.FIRST+8(FP),#^A/ /,#5,FCALC.RUN.$K12
	BEQL	FCALC.RUN.$30
	CMPC5	#31,FCALC.RUN.FIRST+8(FP),#^A/ /,#9,FCALC.RUN.$K13
	BEQL	FCALC.RUN.$32
	CMPC5	#31,FCALC.RUN.FIRST+8(FP),#^A/ /,#4,FCALC.RUN.$K14
	BEQL	FCALC.RUN.$34
	CMPC5	#31,FCALC.RUN.FIRST+8(FP),#^A/ /,#5,FCALC.RUN.$K15
	BEQL	FCALC.RUN.$36
	CMPC5	#31,FCALC.RUN.FIRST+8(FP),#^A/ /,#4,FCALC.RUN.$K16
	BNEQ	FCALC.RUN.$40
	BRB	FCALC.RUN.$38
FCALC.RUN.$30:
;  182        case ('solve')
;  183          call solve_command()
	CALLS	#0,G^FCNUMERIC.SOLVE_COMMAND
;  184          return
	RET
FCALC.RUN.$32:
;  185        case ('integrate')
;  186          call integrate_command()
	CALLS	#0,G^FCNUMERIC.INTEGRATE_COMMAND
;  187          return
	RET
FCALC.RUN.$34:
;  188        case ('diff')
;  189          call diff_command()
	CALLS	#0,G^FCNUMERIC.DIFF_COMMAND
;  190          return
	RET
FCALC.RUN.$36:
;  191        case ('table')
;  192          call table_command(text)
	PUSHL	FCALC.RUN.TEXT(AP)
	CALLS	#1,G^FCPLOT.TABLE_COMMAND
;  193          return
	RET
FCALC.RUN.$38:
;  194        case ('plot')
;  195          call plot_command(text)
	PUSHL	FCALC.RUN.TEXT(AP)
	CALLS	#1,G^FCPLOT.PLOT_COMMAND
;  196          return
	RET
FCALC.RUN.$40:
;  197        end select
;  198      end if
FCALC.RUN.$25:
;  199
;  200      if (first%kind == t_name .and. second%kind == t_operator .and. second%text == '=') then
	CMPL	FCALC.RUN.FIRST(FP),#2
	BNEQ	FCALC.RUN.$41
	CMPL	FCALC.RUN.SECOND(FP),#3
	BNEQ	FCALC.RUN.$41
	CMPC5	#31,FCALC.RUN.SECOND+8(FP),#^A/ /,#1,FCALC.RUN.$K3
	BNEQ	FCALC.RUN.$41
;  201        call assignment(first)
	PUSHAB	FCALC.RUN.FIRST(FP)
	CALLS	#1,FCALC.ASSIGNMENT
;  202      else if (is_definition() .and. .not. indexes_array(first%text)) then
	RET
FCALC.RUN.$41:
	CALLS	#0,FCALC.IS_DEFINITION
	MOVL	R0,R6
	MOVL	#17694751,FCALC.RUN.$D1(FP) ; the descriptor's length, 31, type, and class
	MOVAB	FCALC.RUN.FIRST+8(FP),FCALC.RUN.$D1+4(FP)
	PUSHAQ	FCALC.RUN.$D1(FP)
	CALLS	#1,FCALC.INDEXES_ARRAY
	MOVL	R0,FCALC.RUN.$T3(FP)
	BLBC	R6,FCALC.RUN.$46
	BLBS	FCALC.RUN.$T3(FP),FCALC.RUN.$46
;  203        call definition(text)
	PUSHL	FCALC.RUN.TEXT(AP)
	CALLS	#1,FCALC.DEFINITION
;  204      else
	RET
FCALC.RUN.$46:
;  205        call statement()
	CALLS	#0,FCALC.STATEMENT
;  206      end if
;  207    end subroutine run
	RET

; Storage map for FCALC.FILE_COMMAND, a RECURSIVE LOGICAL function
;   TEXT          CHARACTER*(*), INTENT(IN)  argument 1  @FCALC.FILE_COMMAND.TEXT(AP)
;   FILE_COMMAND  LOGICAL                    FP-48       FCALC.FILE_COMMAND.FILE_COMMAND(FP)
;   WORD          CHARACTER*8                FP-44       FCALC.FILE_COMMAND.WORD(FP)
;   AT            INTEGER                    R10         R10
;   NEXT          INTEGER                    FP-32       FCALC.FILE_COMMAND.NEXT(FP)
;   K             INTEGER                    R7          R7
;   R7 is $T1: temporary
;   R6 is $T2: temporary
;   R9 is $H1: a value computed before a loop
;   R6 is $U1: temporary
;   R6 is $R1: NEXT, during a loop
;   R8 is $R2: TEXT's address
;
FCALC.FILE_COMMAND.TEXT = 4		; TEXT is argument 1
FCALC.FILE_COMMAND.FILE_COMMAND = -48	; FILE_COMMAND, the function's value, in the frame
FCALC.FILE_COMMAND.WORD = -44		; WORD, in the frame
FCALC.FILE_COMMAND.NEXT = -32		; NEXT, in the frame
FCALC.FILE_COMMAND.$D2 = -24		; a descriptor, written whole at each use, in the frame
FCALC.FILE_COMMAND.$D3 = -16		; a descriptor, written whole at each use, in the frame
FCALC.FILE_COMMAND.$D4 = -8		; a descriptor, written whole at each use, in the frame

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCALC.FILE_COMMAND.$D1:
	.WORD	2			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCALC.FILE_COMMAND.$K1
FCALC.FILE_COMMAND.$K2:
	.LONG	0
FCALC.FILE_COMMAND.$K1:
	.ASCII	/ /<9>
FCALC.FILE_COMMAND.$K3:
	.ASCII	/@/
FCALC.FILE_COMMAND.$K4:
	.ASCII	/abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ/
FCALC.FILE_COMMAND.$K5:
	.ASCII	/run/
FCALC.FILE_COMMAND.$K6:
	.ASCII	/load/
FCALC.FILE_COMMAND.$K7:
	.ASCII	/save/
FCALC.FILE_COMMAND.$K8:
	.ASCII	/log/
FCALC.FILE_COMMAND.$K9:
	.ASCII	/help/
FCALC.FILE_COMMAND.$K12:
	.ASCII	/0123456789_$/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  208
;  209    ! FILE_COMMAND runs TEXT and is true, if it is a command that names a
;  210    ! file: @file, RUN file, LOAD file, SAVE file, LOG file, or LOG OFF. As
;  211    ! with the other commands, a word followed by = or ( isn't one: RUN = 3
;  212    ! assigns a variable, and LOG(8, 2) is the logarithm.
;  213    recursive logical function file_command(text)
FCALC.FILE_COMMAND:
	.WORD	^M<R2,R3,R4,R5,R6,R7,R8,R9,R10> ; internal procedure FILE_COMMAND of FCALC
	SUBL2	#48,SP			; this activation's own storage
;  214      character(len=*), intent(in) :: text
;  215      character(len=8) :: word
;  216      integer :: at, next, k
;  217
;  218      file_command = .false.
;  219      at = verify(text, ' ' // achar(9))
	PUSHAL	FCALC.FILE_COMMAND.$K2
	PUSHAQ	FCALC.FILE_COMMAND.$D1
	PUSHL	FCALC.FILE_COMMAND.TEXT(AP)
	CALLS	#3,G^FTN$VERIFY
	MOVL	R0,R7
	MOVL	R7,R10
;  220      if (at == 0) return
	BNEQ	FCALC.FILE_COMMAND.$1
	CLRL	R0			; the function's value
	RET
FCALC.FILE_COMMAND.$1:
;  221
;  222      if (text(at:at) == '@') then
	MOVL	FCALC.FILE_COMMAND.TEXT(AP),R0
	SUBL3	#1,R10,R1
	CMPB	@4(R0)[R1],#64
	BNEQ	FCALC.FILE_COMMAND.$3
;  223        word = '@'
	MOVC5	#1,FCALC.FILE_COMMAND.$K3,#^A/ /,#8,FCALC.FILE_COMMAND.WORD(FP)
;  224        next = at + 1
	ADDL3	R10,#1,FCALC.FILE_COMMAND.NEXT(FP)
;  225      else
	BRW	FCALC.FILE_COMMAND.$5
FCALC.FILE_COMMAND.$3:
;  226        ! The word: the letters from AT, lowercased.
;  227        next = at
	MOVL	R10,FCALC.FILE_COMMAND.NEXT(FP)
;  228        do while (next <= len(text))
	MOVZWL	@FCALC.FILE_COMMAND.TEXT(AP),R9 ; from line 228
	MOVL	FCALC.FILE_COMMAND.NEXT(FP),R6
	MOVL	FCALC.FILE_COMMAND.TEXT(AP),R8
	BRB	FCALC.FILE_COMMAND.$6
FCALC.FILE_COMMAND.$7:			; DO (line 228)'s body
;  229          if (index('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ', text(next:next)) == 0) exit
	SUBL3	#1,R6,R0
	MATCHC	#1,@4(R8)[R0],#52,FCALC.FILE_COMMAND.$K4
	BNEQ	FCALC.FILE_COMMAND.$8
	SUBL3	R2,#52,R0
	BRB	FCALC.FILE_COMMAND.$9
FCALC.FILE_COMMAND.$8:
	CLRL	R0
FCALC.FILE_COMMAND.$9:
	MOVL	R0,R7
	BNEQ	FCALC.FILE_COMMAND.$11
	BRW	FCALC.FILE_COMMAND.$10
FCALC.FILE_COMMAND.$11:
;  230          next = next + 1
	INCL	R6
;  231        end do
FCALC.FILE_COMMAND.$6:			; DO (line 228)'s test
	CMPL	R6,R9			; from line 228
	BLEQ	FCALC.FILE_COMMAND.$7
	MOVL	R6,FCALC.FILE_COMMAND.NEXT(FP)
FCALC.FILE_COMMAND.$13:
;  232        if (next - at > len(word)) return
	SUBL3	R10,FCALC.FILE_COMMAND.NEXT(FP),R0
	CMPL	R0,#8
	BLEQ	FCALC.FILE_COMMAND.$14
	CLRL	R0			; the function's value
	RET
FCALC.FILE_COMMAND.$14:
;  233        word = lowercase(text(at:next - 1))
	MOVL	#34471936,FCALC.FILE_COMMAND.$D2(FP) ; the descriptor's length, 0, type, and class
	CLRL	FCALC.FILE_COMMAND.$D2+4(FP) ; no string yet
	SUBL3	R10,FCALC.FILE_COMMAND.NEXT(FP),R7
	BGEQ	FCALC.FILE_COMMAND.$16
	CLRL	R7
FCALC.FILE_COMMAND.$16:
	MOVL	#17694720,FCALC.FILE_COMMAND.$D3(FP) ; the descriptor's length, 0, type, and class
	CVTLW	R7,FCALC.FILE_COMMAND.$D3(FP)
	MOVL	FCALC.FILE_COMMAND.TEXT(AP),R0
	SUBL3	#1,R10,R1
	MOVAB	@4(R0)[R1],FCALC.FILE_COMMAND.$D3+4(FP)
	PUSHAQ	FCALC.FILE_COMMAND.$D3(FP)
	PUSHAQ	FCALC.FILE_COMMAND.$D2(FP)
	CALLS	#2,FCALC.LOWERCASE
	MOVZWL	FCALC.FILE_COMMAND.$D2(FP),R0
	MOVC5	R0,@FCALC.FILE_COMMAND.$D2+4(FP),#^A/ /,#8,FCALC.FILE_COMMAND.WORD(FP)
	PUSHAQ	FCALC.FILE_COMMAND.$D2(FP)
	CALLS	#1,G^LIB$SFREE1_DD
;  234        if (word /= 'run' .and. word /= 'load' .and. word /= 'save' .and. word /= 'log' .and. &
;  235          word /= 'help') return
	CMPC5	#8,FCALC.FILE_COMMAND.WORD(FP),#^A/ /,#3,FCALC.FILE_COMMAND.$K5
	BEQL	FCALC.FILE_COMMAND.$18
	CMPC5	#8,FCALC.FILE_COMMAND.WORD(FP),#^A/ /,#4,FCALC.FILE_COMMAND.$K6
	BEQL	FCALC.FILE_COMMAND.$18
	CMPC5	#8,FCALC.FILE_COMMAND.WORD(FP),#^A/ /,#4,FCALC.FILE_COMMAND.$K7
	BEQL	FCALC.FILE_COMMAND.$18
	CMPC5	#8,FCALC.FILE_COMMAND.WORD(FP),#^A/ /,#3,FCALC.FILE_COMMAND.$K8
	BEQL	FCALC.FILE_COMMAND.$18
	CMPC5	#8,FCALC.FILE_COMMAND.WORD(FP),#^A/ /,#4,FCALC.FILE_COMMAND.$K9
	BEQL	FCALC.FILE_COMMAND.$18
	CLRL	R0			; the function's value
	RET
FCALC.FILE_COMMAND.$18:
;  236        ! The next character that isn't blank: = or ( makes the line no
;  237        ! command, and so does a word's going on (RUNNING = 1).
;  238        k = verify(text(next:), ' ' // achar(9))
	MOVZWL	@FCALC.FILE_COMMAND.TEXT(AP),R0
	SUBL2	FCALC.FILE_COMMAND.NEXT(FP),R0
	ADDL3	R0,#1,R6
	BGEQ	FCALC.FILE_COMMAND.$24
	CLRL	R6
FCALC.FILE_COMMAND.$24:
	MOVL	#17694720,FCALC.FILE_COMMAND.$D3(FP) ; the descriptor's length, 0, type, and class
	CVTLW	R6,FCALC.FILE_COMMAND.$D3(FP)
	MOVL	FCALC.FILE_COMMAND.TEXT(AP),R0
	SUBL3	#1,FCALC.FILE_COMMAND.NEXT(FP),R1
	MOVAB	@4(R0)[R1],FCALC.FILE_COMMAND.$D3+4(FP)
	PUSHAL	FCALC.FILE_COMMAND.$K2
	PUSHAQ	FCALC.FILE_COMMAND.$D1
	PUSHAQ	FCALC.FILE_COMMAND.$D3(FP)
	CALLS	#3,G^FTN$VERIFY
	MOVL	R0,R7
;  239        if (k > 0) then
	BLEQ	FCALC.FILE_COMMAND.$26
;  240          k = next + k - 1
	ADDL3	FCALC.FILE_COMMAND.NEXT(FP),R7,R0
	SUBL3	#1,R0,R7
;  241          if (text(k:k) == '=' .or. text(k:k) == '(') return
	MOVL	FCALC.FILE_COMMAND.TEXT(AP),R0
	SUBL3	#1,R7,R1
	MOVB	@4(R0)[R1],R6
	CMPB	R6,#61
	BEQL	FCALC.FILE_COMMAND.$29
	CMPB	R6,#40
	BNEQ	FCALC.FILE_COMMAND.$28
FCALC.FILE_COMMAND.$29:
	CLRL	R0			; the function's value
	RET
FCALC.FILE_COMMAND.$28:
;  242          if (k == next .and. index('0123456789_$', text(k:k)) > 0) return
	MOVL	FCALC.FILE_COMMAND.TEXT(AP),R0
	SUBL3	#1,R7,R1
	MATCHC	#1,@4(R0)[R1],#12,FCALC.FILE_COMMAND.$K12
	BNEQ	FCALC.FILE_COMMAND.$32
	SUBL3	R2,#12,R0
	BRB	FCALC.FILE_COMMAND.$33
FCALC.FILE_COMMAND.$32:
	CLRL	R0
FCALC.FILE_COMMAND.$33:
	MOVL	R0,R6
	CMPL	R7,FCALC.FILE_COMMAND.NEXT(FP)
	BNEQ	FCALC.FILE_COMMAND.$34
	TSTL	R6
	BLEQ	FCALC.FILE_COMMAND.$34
	CLRL	R0			; the function's value
	RET
FCALC.FILE_COMMAND.$34:
;  243        end if
FCALC.FILE_COMMAND.$26:
;  244      end if
FCALC.FILE_COMMAND.$5:
;  245
;  246      file_command = .true.
;  247      if (word == 'help') then
	CMPC5	#8,FCALC.FILE_COMMAND.WORD(FP),#^A/ /,#4,FCALC.FILE_COMMAND.$K9
	BNEQ	FCALC.FILE_COMMAND.$37
;  248        call help_command(text(next:))
	MOVZWL	@FCALC.FILE_COMMAND.TEXT(AP),R0
	SUBL2	FCALC.FILE_COMMAND.NEXT(FP),R0
	ADDL3	R0,#1,R6
	BGEQ	FCALC.FILE_COMMAND.$39
	CLRL	R6
FCALC.FILE_COMMAND.$39:
	MOVL	#17694720,FCALC.FILE_COMMAND.$D3(FP) ; the descriptor's length, 0, type, and class
	CVTLW	R6,FCALC.FILE_COMMAND.$D3(FP)
	MOVL	FCALC.FILE_COMMAND.TEXT(AP),R0
	SUBL3	#1,FCALC.FILE_COMMAND.NEXT(FP),R1
	MOVAB	@4(R0)[R1],FCALC.FILE_COMMAND.$D3+4(FP)
	PUSHAQ	FCALC.FILE_COMMAND.$D3(FP)
	CALLS	#1,FCALC.HELP_COMMAND
;  249      else
	BRB	FCALC.FILE_COMMAND.$41
FCALC.FILE_COMMAND.$37:
;  250        call file_argument(text, next, word)
	MOVL	#17694728,FCALC.FILE_COMMAND.$D4(FP) ; the descriptor's length, 8, type, and class
	MOVAB	FCALC.FILE_COMMAND.WORD(FP),FCALC.FILE_COMMAND.$D4+4(FP)
	PUSHAQ	FCALC.FILE_COMMAND.$D4(FP)
	PUSHAL	FCALC.FILE_COMMAND.NEXT(FP)
	PUSHL	FCALC.FILE_COMMAND.TEXT(AP)
	CALLS	#3,FCALC.FILE_ARGUMENT
;  251      end if
FCALC.FILE_COMMAND.$41:
;  252    end function file_command
	MOVL	#-1,R0			; the function's value
	RET
FCALC.FILE_COMMAND.$10:			; leaving the loop
	MOVL	R6,FCALC.FILE_COMMAND.NEXT(FP)
	BRW	FCALC.FILE_COMMAND.$13

; Storage map for FCALC.HELP_COMMAND, a subroutine
;   TOPICS  CHARACTER*(*), INTENT(IN)  argument 1  @FCALC.HELP_COMMAND.TOPICS(AP)
;   R8 is $T2: temporary
;   R9 is $T4: temporary
;   R7 is $T5: temporary
;   R6 is $T6: temporary
;
FCALC.HELP_COMMAND.TOPICS = 4		; TOPICS is argument 1

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCALC.HELP_COMMAND.$T1:
	.BLKL	1			; temporary
FCALC.HELP_COMMAND.$D1:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_D
	.LONG	0			; set when the descriptor is used
FCALC.HELP_COMMAND.$T3:
	.BLKB	2			; temporary
	.BLKB	2
FCALC.HELP_COMMAND.$D2:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used
FCALC.HELP_COMMAND.$D3:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used
FCALC.HELP_COMMAND.$D4:
	.WORD	0			; length
