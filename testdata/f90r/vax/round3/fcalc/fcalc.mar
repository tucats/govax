	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;    1  ! fcalc, a scientific calculator: the main program.
;    2  !
;    3  ! fcalc reads lines at the prompt until QUIT, EXIT, or the end of the
;    4  ! input. A line that starts with a command word is a command; NAME = EXPR
;    5  ! assigns a variable; F(X, Y) = EXPR defines a function; V(I, J) = EXPR
;    6  ! assigns elements of an array; anything else is an expression, whose value
;    7  ! is shown and kept as ANS. A line starting with ! is a comment.
;    8  !
;    9  ! Run as a foreign command with text after its name ($ FCALC 2^10 + 1), it
;   10  ! runs that one line and ends.
;   11  !
;   12  ! HELP shows the FCALC topic of VMS's help library, SYS$HELP:HELPLIB.HLB,
;   13  ! the text DCL's HELP FCALC shows, through FCPLATFORM's SHOW_HELP.
;   14  !
;   15  ! The modules each do one part of the work, and this program joins them:
;   16  ! a line is read (READ_LINE), cut into tokens (FCLEXER, through SCAN_LINE),
;   17  ! classified by its first tokens (EXECUTE), parsed into a tree (FCTREE),
;   18  ! and evaluated (FCEVAL); an error anywhere is recorded (FCMESSAGES) and
;   19  ! reported once the line is done. @ (or RUN) and LOAD run a file's lines
;   20  ! the same way, a line at a time (RUN_FILE); FCSTATE reads the files, and
;   21  ! saves the state and keeps the log.
;   22  !
;   23  ! The procedures after CONTAINS are internal procedures of the program:
;   24  ! they see the program's variables (LINE, ECHO, DONE, ...) by host
;   25  ! association, as if declared in each of them, which is how they share
;   26  ! the state of the session without passing it around.
;   27  program fcalc
	.ENTRY	FCALC,^M<R6,R7>
;   28    use fckinds
;   29    use fcmessages
;   30    use fcvalues
;   31    use fcarrays
;   32    use fclexer
;   33    use fctree
;   34    use fceval
;   35    use fcsymbols
;   36    use fcfuncs
;   37    use fcnumeric
;   38    use fcplot
;   39    use fcstate
;   40    use fcplatform, only: foreign_text, show_help
;   41    implicit none
;   42
;   43    character(len=line_length + 1) :: line
;   44    integer :: length, status
;   45    logical :: echo, done, echoed, quiet
;   46
;   47    ! DEPTH is how many files of commands are running, one inside another;
;   48    ! LOADING is true while LOAD runs one, whose lines are all quiet;
;   49    ! ABANDON is true after an error in a file, while every file running
;   50    ! ends, each saying where it was.
;   51    integer :: depth
;   52    logical :: loading, abandon
;   53
;   54    echo = .false.
	CLRL	FCALC.ECHO
;   55    done = .false.
	CLRL	FCALC.DONE
;   56    depth = 0
	CLRL	FCALC.DEPTH
;   57    loading = .false.
	CLRL	FCALC.LOADING
;   58    abandon = .false.
	CLRL	FCALC.ABANDON
;   59    call start_symbols()
	CALLS	#0,G^FCSYMBOLS.START_SYMBOLS
;   60    call set_variable('ans', real_quantity(0.0_rk))
	PUSHAG	FCALC.$K2
	PUSHAB	FCALC.$T1
	CALLS	#2,G^FCARRAYS.REAL_QUANTITY
	PUSHAB	FCALC.$T1
	PUSHAQ	FCALC.$D1
	CALLS	#2,G^FCSYMBOLS.SET_VARIABLE
;   61
;   62    ! The foreign command's text, if there is any: that line alone, shown
;   63    ! (if it fails) with the pointer under it at the line's start, and then
;   64    ! fcalc is done. (Not STOP, which on VMS says FORTRAN STOP.)
;   65    call foreign_text(line, length)
	PUSHAL	FCALC.LENGTH
	PUSHAQ	FCALC.$D2
	CALLS	#2,G^FCPLATFORM.FOREIGN_TEXT
;   66    if (length > 0) then
	TSTL	FCALC.LENGTH
	BGTR	FCALC.$2
	BRW	FCALC.$1
FCALC.$2:
;   67      indent = 0
	CLRL	FCALC.INDENT
;   68      if (length > line_length) then
	CMPL	FCALC.LENGTH,#199
	BLEQ	FCALC.$3
;   69        call fail(e_linelong, 0)
	PUSHL	#0
	PUSHAL	FCALC.$K4
	PUSHAL	FCALC.$K3
	CALLS	#3,G^FCMESSAGES.FAIL
;   70        call report()
	PUSHL	#0
	CALLS	#1,G^FCMESSAGES.REPORT
;   71      else
	BRB	FCALC.$5
FCALC.$3:
;   72        call execute(line(:length))
	MOVL	FCALC.LENGTH,R6
	BGEQ	FCALC.$6
	CLRL	R6
FCALC.$6:
	CVTLW	R6,FCALC.$D3
	MOVAB	FCALC.LINE,FCALC.$D3+4
	PUSHAQ	FCALC.$D3
	CALLS	#1,FCALC.EXECUTE
;   73        call report(line(:length))
	MOVL	FCALC.LENGTH,R6
	BGEQ	FCALC.$8
	CLRL	R6
FCALC.$8:
	CVTLW	R6,FCALC.$D3
	MOVAB	FCALC.LINE,FCALC.$D3+4
	PUSHAQ	FCALC.$D3
	CALLS	#1,G^FCMESSAGES.REPORT
;   74      end if
FCALC.$5:
;   75      done = .true.
	MOVL	#-1,FCALC.DONE
;   76    end if
FCALC.$1:
;   77
;   78    do while (.not. done)
	MOVL	FCALC.ECHOED,R7
	BRW	FCALC.$10
FCALC.$11:				; DO (line 78)'s body
;   79      call say_more('fcalc> ')
	PUSHAQ	FCALC.$D4
	CALLS	#1,G^FCMESSAGES.SAY_MORE
;   80      call read_line(line, length, status)
	PUSHL	#0
	PUSHAL	FCALC.STATUS
	PUSHAL	FCALC.LENGTH
	PUSHAQ	FCALC.$D2
	CALLS	#4,G^FCSTATE.READ_LINE
;   81      if (status < 0) then
	TSTL	FCALC.STATUS
	BGEQ	FCALC.$12
	MOVL	R7,FCALC.ECHOED
;   82        ! The end of the input: end the prompt's line.
;   83        call say('')
	PUSHAQ	FCALC.$D5
	CALLS	#1,G^FCMESSAGES.SAY
;   84        exit
	BRW	FCALC.$14
FCALC.$12:
;   85      end if
;   86
;   87      ! A line too long isn't echoed: VMS's FORTRAN gives none of it. A line
;   88      ! the terminal shows itself (it echoes what is typed) goes to the log.
;   89      echoed = echo .and. status == 0
	CLRL	R0
	TSTL	FCALC.STATUS
	BNEQ	FCALC.$15
	MNEGL	#1,R0
FCALC.$15:
	MCOML	R0,R0
	BICL3	R0,FCALC.ECHO,R7
;   90      if (echoed) then
	BLBC	R7,FCALC.$16
;   91        call say(line(:length))
	MOVL	FCALC.LENGTH,R6
	BGEQ	FCALC.$18
	CLRL	R6
FCALC.$18:
	CVTLW	R6,FCALC.$D3
	MOVAB	FCALC.LINE,FCALC.$D3+4
	PUSHAQ	FCALC.$D3
	CALLS	#1,G^FCMESSAGES.SAY
;   92      else if (status == 0) then
	BRB	FCALC.$20
FCALC.$16:
	TSTL	FCALC.STATUS
	BNEQ	FCALC.$21
;   93        call log_line(line(:length))
	MOVL	FCALC.LENGTH,R6
	BGEQ	FCALC.$23
	CLRL	R6
FCALC.$23:
	CVTLW	R6,FCALC.$D3
	MOVAB	FCALC.LINE,FCALC.$D3+4
	PUSHAQ	FCALC.$D3
	CALLS	#1,G^FCMESSAGES.LOG_LINE
;   94      else
	BRB	FCALC.$20
FCALC.$21:
;   95        call log_line('')
	PUSHAQ	FCALC.$D5
	CALLS	#1,G^FCMESSAGES.LOG_LINE
;   96      end if
FCALC.$20:
;   97
;   98      if (status > 0) then
	TSTL	FCALC.STATUS
	BLEQ	FCALC.$25
;   99        call fail(e_linelong, 0)
	PUSHL	#0
	PUSHAL	FCALC.$K4
	PUSHAL	FCALC.$K3
	CALLS	#3,G^FCMESSAGES.FAIL
;  100      else
	BRB	FCALC.$27
FCALC.$25:
;  101        call execute(line(:length))
	MOVL	FCALC.LENGTH,R6
	BGEQ	FCALC.$28
	CLRL	R6
FCALC.$28:
	CVTLW	R6,FCALC.$D3
	MOVAB	FCALC.LINE,FCALC.$D3+4
	PUSHAQ	FCALC.$D3
	CALLS	#1,FCALC.EXECUTE
;  102      end if
FCALC.$27:
;  103
;  104      ! SET ECHO echoes the line that set it.
;  105      if (echo .and. .not. echoed .and. status == 0) call say(line(:length))
	BLBC	FCALC.ECHO,FCALC.$30
	BLBS	R7,FCALC.$30
	TSTL	FCALC.STATUS
	BNEQ	FCALC.$30
	MOVL	FCALC.LENGTH,R6
	BGEQ	FCALC.$34
	CLRL	R6
FCALC.$34:
	CVTLW	R6,FCALC.$D3
	MOVAB	FCALC.LINE,FCALC.$D3+4
	PUSHAQ	FCALC.$D3
	CALLS	#1,G^FCMESSAGES.SAY
FCALC.$30:
;  106
;  107      call report()
	PUSHL	#0
	CALLS	#1,G^FCMESSAGES.REPORT
;  108      abandon = .false.
	CLRL	FCALC.ABANDON
;  109    end do
FCALC.$10:				; DO (line 78)'s test
	BLBS	FCALC.DONE,FCALC.$36	; from line 78
	BRW	FCALC.$11
FCALC.$36:
	MOVL	R7,FCALC.ECHOED
FCALC.$14:
;  110
;  111  contains
	MOVL	#1,R0			; SS$_NORMAL
	RET

; Storage map for FCALC.EXECUTE, a RECURSIVE subroutine
;   LINE_TEXT  CHARACTER*(*), INTENT(IN)  argument 1  @FCALC.EXECUTE.LINE_TEXT(AP)
