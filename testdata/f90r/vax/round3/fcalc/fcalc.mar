	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  818
;  819    ! WHOLE_ARGUMENT: SET's third token is a whole number from LOW to HIGH,
;  820    ! N, and the line's last. (A minus sign is a token of its own, so a
;  821    ! negative number is out of range at the sign.)
;  822    logical function whole_argument(low, high, n)
FCALC.WHOLE_ARGUMENT:
	.WORD	^M<R2,R3,R4,R5,R6>	; internal procedure WHOLE_ARGUMENT of FCALC
;  823      integer, intent(in) :: low, high
;  824      integer, intent(out) :: n
;  825      type(token) :: how
;  826
;  827      whole_argument = .false.
	CLRL	R6
;  828      n = 0
	CLRL	@FCALC.WHOLE_ARGUMENT.N(AP)
;  829      how = token_at(3)
	PUSHAL	FCALC.WHOLE_ARGUMENT.$K1
	PUSHAB	FCALC.WHOLE_ARGUMENT.$T1
	CALLS	#2,G^FCTREE.TOKEN_AT
	MOVC3	#56,FCALC.WHOLE_ARGUMENT.$T1,FCALC.WHOLE_ARGUMENT.HOW
;  830      if (how%kind == t_operator .and. how%text == '-' .and. kind_at(4) == t_number) then
	PUSHAL	FCALC.WHOLE_ARGUMENT.$K3
	CALLS	#1,G^FCTREE.KIND_AT
	MOVL	R0,FCALC.WHOLE_ARGUMENT.$T2
	CMPL	FCALC.WHOLE_ARGUMENT.HOW,#3
	BNEQ	FCALC.WHOLE_ARGUMENT.$1
	CMPC5	#31,FCALC.WHOLE_ARGUMENT.HOW+8,#^A/ /,#1,FCALC.WHOLE_ARGUMENT.$K2
	BNEQ	FCALC.WHOLE_ARGUMENT.$1
	CMPL	FCALC.WHOLE_ARGUMENT.$T2,#1
	BNEQ	FCALC.WHOLE_ARGUMENT.$1
;  831        call fail(e_domain, how%column)
	PUSHL	#0
	PUSHAL	FCALC.WHOLE_ARGUMENT.HOW+4
	PUSHAL	FCALC.WHOLE_ARGUMENT.$K4
	CALLS	#3,G^FCMESSAGES.FAIL
;  832      else if (how%kind /= t_number .or. how%imaginary) then
	BRW	FCALC.WHOLE_ARGUMENT.$5
FCALC.WHOLE_ARGUMENT.$1:
	CMPL	FCALC.WHOLE_ARGUMENT.HOW,#1
	BNEQ	FCALC.WHOLE_ARGUMENT.$7
	BLBC	FCALC.WHOLE_ARGUMENT.HOW+48,FCALC.WHOLE_ARGUMENT.$6
FCALC.WHOLE_ARGUMENT.$7:
;  833        call fail(e_badset, how%column)
	PUSHL	#0
	PUSHAL	FCALC.WHOLE_ARGUMENT.HOW+4
	PUSHAL	FCALC.WHOLE_ARGUMENT.$K5
	CALLS	#3,G^FCMESSAGES.FAIL
;  834      else if (kind_at(4) /= t_end) then
	BRW	FCALC.WHOLE_ARGUMENT.$5
FCALC.WHOLE_ARGUMENT.$6:
	PUSHAL	FCALC.WHOLE_ARGUMENT.$K3
	CALLS	#1,G^FCTREE.KIND_AT
	MOVL	R0,FCALC.WHOLE_ARGUMENT.$T2
	BEQL	FCALC.WHOLE_ARGUMENT.$10
;  835        call fail(e_extra, token_column(4))
	PUSHAL	FCALC.WHOLE_ARGUMENT.$K3
	CALLS	#1,FCALC.TOKEN_COLUMN
	MOVL	R0,FCALC.WHOLE_ARGUMENT.$T2
	PUSHL	#0
	PUSHAL	FCALC.WHOLE_ARGUMENT.$T2
	PUSHAL	FCALC.WHOLE_ARGUMENT.$K6
	CALLS	#3,G^FCMESSAGES.FAIL
;  836      else if (aint(how%number) /= how%number .or. how%number < low .or. &
;  837          how%number > high) then
	BRB	FCALC.WHOLE_ARGUMENT.$5
FCALC.WHOLE_ARGUMENT.$10:
	PUSHAG	FCALC.WHOLE_ARGUMENT.HOW+40
	CALLS	#1,G^MTH$GINT
	MOVG	R0,FCALC.WHOLE_ARGUMENT.$T3
	CMPG	FCALC.WHOLE_ARGUMENT.$T3,FCALC.WHOLE_ARGUMENT.HOW+40
	BNEQ	FCALC.WHOLE_ARGUMENT.$13
	CVTLG	@FCALC.WHOLE_ARGUMENT.LOW(AP),R0
	CMPG	FCALC.WHOLE_ARGUMENT.HOW+40,R0
	BLSS	FCALC.WHOLE_ARGUMENT.$13
	CVTLG	@FCALC.WHOLE_ARGUMENT.HIGH(AP),R0
	CMPG	FCALC.WHOLE_ARGUMENT.HOW+40,R0
	BLEQ	FCALC.WHOLE_ARGUMENT.$12
FCALC.WHOLE_ARGUMENT.$13:
;  838        call fail(e_domain, how%column)
	PUSHL	#0
	PUSHAL	FCALC.WHOLE_ARGUMENT.HOW+4
	PUSHAL	FCALC.WHOLE_ARGUMENT.$K4
	CALLS	#3,G^FCMESSAGES.FAIL
;  839      else
	BRB	FCALC.WHOLE_ARGUMENT.$5
FCALC.WHOLE_ARGUMENT.$12:
;  840        n = nint(how%number)
	CVTRGL	FCALC.WHOLE_ARGUMENT.HOW+40,@FCALC.WHOLE_ARGUMENT.N(AP)
;  841        whole_argument = .true.
	MOVL	#-1,R6
;  842      end if
FCALC.WHOLE_ARGUMENT.$5:
;  843    end function whole_argument
	MOVL	R6,R0			; the function's value
	RET

; Storage map for FCALC.TOKEN_COLUMN, an INTEGER function
;   K             INTEGER, INTENT(IN)  argument 1  @FCALC.TOKEN_COLUMN.K(AP)
;   TOKEN_COLUMN  INTEGER              $LOCAL+0    FCALC.TOKEN_COLUMN.TOKEN_COLUMN
;   T             TYPE(TOKEN)          $LOCAL+8    FCALC.TOKEN_COLUMN.T
;
FCALC.TOKEN_COLUMN.K = 4		; K is argument 1

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
	.ALIGN	QUAD			; the boundary of this routine's aligned records
FCALC.TOKEN_COLUMN.TOKEN_COLUMN:
	.BLKL	1			; TOKEN_COLUMN, the function's value
	.BLKB	4
FCALC.TOKEN_COLUMN.T:
	.BLKL	14			; T
FCALC.TOKEN_COLUMN.$T1:
	.BLKL	14			; characters, for one statement

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  844
;  845    ! TOKEN_COLUMN is the column of the Kth token.
;  846    integer function token_column(k)
FCALC.TOKEN_COLUMN:
	.WORD	^M<R2,R3,R4,R5>		; internal procedure TOKEN_COLUMN of FCALC
;  847      integer, intent(in) :: k
;  848      type(token) :: t
;  849
;  850      t = token_at(k)
	PUSHAL	@FCALC.TOKEN_COLUMN.K(AP)
	PUSHAB	FCALC.TOKEN_COLUMN.$T1
	CALLS	#2,G^FCTREE.TOKEN_AT
	MOVC3	#56,FCALC.TOKEN_COLUMN.$T1,FCALC.TOKEN_COLUMN.T
;  851      token_column = t%column
;  852    end function token_column
	MOVL	FCALC.TOKEN_COLUMN.T+4,R0 ; the function's value
	RET
;  853  end program fcalc

	.END	FCALC
