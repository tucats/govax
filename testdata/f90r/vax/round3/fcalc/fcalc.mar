;  253
;  254    ! HELP_COMMAND is HELP [topic ...]: the help library's FCALC topic, or a
;  255    ! topic under it (HELP COMMANDS SOLVE), shown as DCL's HELP FCALC shows it
;  256    ! (module FCPLATFORM's SHOW_HELP). HELP is with the commands that name a
;  257    ! file because its topics needn't be fcalc's tokens (HELP @).
;  258    subroutine help_command(topics)
FCALC.HELP_COMMAND:
	.WORD	^M<R2,R3,R4,R5,R6,R7,R8,R9> ; internal procedure HELP_COMMAND of FCALC
;  259      character(len=*), intent(in) :: topics
;  260
;  261      if (.not. show_help('FCALC ' // trim(adjustl(topics)), help_line)) call fail(e_nohelp, 0)
	MOVZWL	@FCALC.HELP_COMMAND.TOPICS(AP),R8
	CVTLW	R8,FCALC.HELP_COMMAND.$T3
	PUSHAQ	FCALC.HELP_COMMAND.$D1
	PUSHAW	FCALC.HELP_COMMAND.$T3
	CALLS	#2,G^LIB$SGET1_DD
	CVTLW	R8,FCALC.HELP_COMMAND.$D2
	MOVAB	@FCALC.HELP_COMMAND.$D1+4,FCALC.HELP_COMMAND.$D2+4
	CVTLW	R8,FCALC.HELP_COMMAND.$D3
	MOVL	FCALC.HELP_COMMAND.TOPICS(AP),R0
	MOVAB	@4(R0),FCALC.HELP_COMMAND.$D3+4
	PUSHAQ	FCALC.HELP_COMMAND.$D3
	PUSHAQ	FCALC.HELP_COMMAND.$D2
	CALLS	#2,G^FTN$ADJUSTL
	MOVAB	@FCALC.HELP_COMMAND.$D1+4,R9
	MOVAB	(R9),R7
	MOVL	R8,R6
	BRB	FCALC.HELP_COMMAND.$1
FCALC.HELP_COMMAND.$2:
	CMPB	-1(R7)[R6],#32
	BNEQ	FCALC.HELP_COMMAND.$3
	DECL	R6
FCALC.HELP_COMMAND.$1:
	TSTL	R6			; from line 261
	BNEQ	FCALC.HELP_COMMAND.$2
FCALC.HELP_COMMAND.$3:
	ADDL3	R6,#6,R0
	CVTLW	R0,FCALC.HELP_COMMAND.$T7
	PUSHAQ	FCALC.HELP_COMMAND.$D4
	PUSHAW	FCALC.HELP_COMMAND.$T7
	CALLS	#2,G^LIB$SGET1_DD
	MOVC3	#6,FCALC.HELP_COMMAND.$K1,@FCALC.HELP_COMMAND.$D4+4
	MOVL	FCALC.HELP_COMMAND.$D4+4,R0
	MOVC3	R6,(R9),6(R0)
	ADDL3	R6,#6,R0
	CVTLW	R0,FCALC.HELP_COMMAND.$D5
	MOVAB	@FCALC.HELP_COMMAND.$D4+4,FCALC.HELP_COMMAND.$D5+4
	PUSHAB	G^FCMESSAGES.HELP_LINE
	PUSHAQ	FCALC.HELP_COMMAND.$D5
	CALLS	#2,G^FCPLATFORM.SHOW_HELP
	MOVL	R0,FCALC.HELP_COMMAND.$T1
	PUSHAQ	FCALC.HELP_COMMAND.$D1
	CALLS	#1,G^LIB$SFREE1_DD
	PUSHAQ	FCALC.HELP_COMMAND.$D4
	CALLS	#1,G^LIB$SFREE1_DD
	BLBS	FCALC.HELP_COMMAND.$T1,FCALC.HELP_COMMAND.$6
	PUSHL	#0
	PUSHAL	FCALC.HELP_COMMAND.$K3
	PUSHAL	FCALC.HELP_COMMAND.$K2
	CALLS	#3,G^FCMESSAGES.FAIL
FCALC.HELP_COMMAND.$6:
;  262    end subroutine help_command
	RET

