; Storage map for FCALC.WHOLE_NUMBER, a CHARACTER*12 function
;   TEXT  CHARACTER*12         hidden argument 1  @FCALC.WHOLE_NUMBER.TEXT(AP)
;   N     INTEGER, INTENT(IN)  argument 2         @FCALC.WHOLE_NUMBER.N(AP)
;
FCALC.WHOLE_NUMBER.TEXT = 4		; TEXT's value goes through hidden argument 1
FCALC.WHOLE_NUMBER.N = 8		; N is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCALC.WHOLE_NUMBER.$D1:
	.WORD	12			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used
FCALC.WHOLE_NUMBER.$FKC1:
	.BLKL	1			; the parsed form of a constant format, FTNRTL's
FCALC.WHOLE_NUMBER.$D2:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_L,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used
FCALC.WHOLE_NUMBER.$T1:
	.BLKL	3			; characters, for one statement

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCALC.WHOLE_NUMBER.$IO1:
	.WORD	8			; an I/O statement's control block: its size
	.WORD	^X0010			; flags: F90
	.LONG	0			; (not used yet)
FCALC.WHOLE_NUMBER.$FK1:
	.ADDRESS FCALC.WHOLE_NUMBER.$FKC1 ; a constant format's block: its parsed form's cell
	.WORD	5			; the text's length
	.WORD	0			; flags
	.ADDRESS FCALC.WHOLE_NUMBER.$K1	; the text
FCALC.WHOLE_NUMBER.$D3:
	.WORD	12			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCALC.WHOLE_NUMBER.$T1
FCALC.WHOLE_NUMBER.$K1:
	.ASCII	/(I12)/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  380
;  381    ! WHOLE_NUMBER is N in as few characters as it takes.
;  382    function whole_number(n) result(text)
FCALC.WHOLE_NUMBER:
	.WORD	^M<R2,R3,R4,R5>		; internal procedure WHOLE_NUMBER of FCALC
;  383      integer, intent(in) :: n
;  384      character(len=12) :: text
;  385
;  386      write (text, '(I12)') n
	MOVL	FCALC.WHOLE_NUMBER.TEXT(AP),R0
	MOVAB	@4(R0),FCALC.WHOLE_NUMBER.$D1+4
	PUSHAB	FCALC.WHOLE_NUMBER.$FK1
	PUSHAQ	FCALC.WHOLE_NUMBER.$D1
	PUSHAB	FCALC.WHOLE_NUMBER.$IO1
	CALLS	#3,G^FTN$WRITE_IF
	MOVAL	@FCALC.WHOLE_NUMBER.N(AP),FCALC.WHOLE_NUMBER.$D2+4
	PUSHAQ	FCALC.WHOLE_NUMBER.$D2
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;  387      text = adjustl(text)
	MOVL	FCALC.WHOLE_NUMBER.TEXT(AP),R0
	MOVAB	@4(R0),FCALC.WHOLE_NUMBER.$D1+4
	PUSHAQ	FCALC.WHOLE_NUMBER.$D1
	PUSHAQ	FCALC.WHOLE_NUMBER.$D3
	CALLS	#2,G^FTN$ADJUSTL
	MOVL	FCALC.WHOLE_NUMBER.TEXT(AP),R0
	MOVC3	#12,FCALC.WHOLE_NUMBER.$T1,@4(R0)
;  388    end function whole_number
	RET

