	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  626
;  627    ! LIST [VARIABLES | FUNCTIONS | ALL]: with no word, ALL, the variables
;  628    ! and then the functions.
;  629    subroutine list_command()
FCALC.LIST_COMMAND:
	.WORD	^M<R2,R3,R4,R5>		; internal procedure LIST_COMMAND of FCALC
;  630      type(token) :: what
;  631      character(len=name_length) :: which
;  632
;  633      which = 'all'
	MOVC5	#3,FCALC.LIST_COMMAND.$K1,#^A/ /,#31,FCALC.LIST_COMMAND.WHICH
;  634      what = token_at(2)
	PUSHAL	FCALC.LIST_COMMAND.$K2
	PUSHAB	FCALC.LIST_COMMAND.$T1
	CALLS	#2,G^FCTREE.TOKEN_AT
	MOVC3	#56,FCALC.LIST_COMMAND.$T1,FCALC.LIST_COMMAND.WHAT
;  635      if (what%kind == t_name) then
	CMPL	FCALC.LIST_COMMAND.WHAT,#2
	BNEQ	FCALC.LIST_COMMAND.$1
;  636        which = what%text
	MOVC3	#31,FCALC.LIST_COMMAND.WHAT+8,FCALC.LIST_COMMAND.WHICH
;  637        if (which /= 'variables' .and. which /= 'functions' .and. which /= 'all') then
	CMPC5	#31,FCALC.LIST_COMMAND.WHICH,#^A/ /,#9,FCALC.LIST_COMMAND.$K3
	BEQL	FCALC.LIST_COMMAND.$3
	CMPC5	#31,FCALC.LIST_COMMAND.WHICH,#^A/ /,#9,FCALC.LIST_COMMAND.$K4
	BEQL	FCALC.LIST_COMMAND.$3
	CMPC5	#31,FCALC.LIST_COMMAND.WHICH,#^A/ /,#3,FCALC.LIST_COMMAND.$K1
	BEQL	FCALC.LIST_COMMAND.$3
;  638          call fail(e_badcmd, what%column)
	PUSHL	#0
	PUSHAL	FCALC.LIST_COMMAND.WHAT+4
	PUSHAL	FCALC.LIST_COMMAND.$K5
	CALLS	#3,G^FCMESSAGES.FAIL
;  639          return
	RET
FCALC.LIST_COMMAND.$3:
;  640        end if
;  641        call advance(1)
	PUSHAL	FCALC.LIST_COMMAND.$K6
	CALLS	#1,G^FCTREE.ADVANCE
;  642      end if
FCALC.LIST_COMMAND.$1:
;  643      call advance(1)
	PUSHAL	FCALC.LIST_COMMAND.$K6
	CALLS	#1,G^FCTREE.ADVANCE
;  644      if (.not. at_end()) then
	CALLS	#0,G^FCTREE.AT_END
	MOVL	R0,FCALC.LIST_COMMAND.$T2
	BLBS	FCALC.LIST_COMMAND.$T2,FCALC.LIST_COMMAND.$7
;  645        call fail(e_extra, current_column())
	CALLS	#0,G^FCTREE.CURRENT_COLUMN
	MOVL	R0,FCALC.LIST_COMMAND.$T2
	PUSHL	#0
	PUSHAL	FCALC.LIST_COMMAND.$T2
