	.TITLE	FCPLATFORM
	.IDENT	/01/
; TBT$ FORTRAN: a traceback's line numbers are the FORTRAN lines below
;
; Compiled by GOVAX FORTRAN V0.0-0 on 24-NOV-2026 14:22:47.22
; from DUA5:[FCALC]FCPLATFORM.F90;1
; by the command FORTRAN/G_FLOATING FCPLATFORM
; Optimized by /OPTIMIZE's passes: do limits, one character, forward, unreachable, dead code, deferred indexes, loop invariants,
; common subexpressions, registers, rotate, peephole, branches
;
; Each line of the FORTRAN source appears as a comment, with its line number, before
; the instructions it became. An INCLUDE file's lines appear only with INCLUDE's
; /LIST, their include depth before the number; a comment names the file either way.
; Each routine's storage map says where its variables are.
;
	$DSCDEF				; descriptor codes, DSC$K_

; Storage map for FCPLATFORM, a module
;   (no variables)
;
$MOD$FCPLATFORM.F0D79AA2 == 0		; this module's stamp, which its users' objects refer to

;    1  ! fcalc: what differs from one system to another, VMS's version. Every other
;    2  ! file is the same source on VMS and under gfortran, whose twin of this file
;    3  ! is gfortran/fcplatform.f90. Keeping what differs in one small module is
;    4  ! the usual way to write a portable program: the build picks the module's
;    5  ! version for the system, and nothing else changes.
;    6  module fcplatform
;    7    implicit none
;    8    public
;    9
;   10    ! VMS's FORTRAN treats the first character of each record written to the
;   11    ! terminal as carriage control, a blank meaning "on a new line", as the
;   12    ! standard's printing rule (9.4.5) allows. Each line fcalc writes starts
;   13    ! with CC, so a blank here and nothing in the twin print the same lines.
;   14    ! LEN=* takes the constant's length from its value: here, 1.
;   15    character(len=*), parameter :: cc = ' '
;   16
;   17    ! A record written to the terminal holds 133 bytes, the carriage control
;   18    ! among them: RECORD_ROOM is what is left for text.
;   19    integer, parameter :: record_room = 132
;   20
;   21  contains

; Storage map for FCPLATFORM.PROMPT_ENDS, a LOGICAL function
;   PROMPT_ENDS  LOGICAL  $LOCAL+0   FCPLATFORM.PROMPT_ENDS.$N1
;   KNOWN        INTEGER  $LOCAL+4   FCPLATFORM.PROMPT_ENDS.KNOWN
;   STATUS       INTEGER  $LOCAL+8   FCPLATFORM.PROMPT_ENDS.STATUS
;   TERMINAL     INTEGER  $LOCAL+12  FCPLATFORM.PROMPT_ENDS.TERMINAL
;   FCPLATFORM.PROMPT_ENDS.$N1 is FCPLATFORM.PROMPT_ENDS.PROMPT_ENDS
;
	.EXTRN	LIB$GETDVI		; named in an EXTERNAL statement

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCPLATFORM.PROMPT_ENDS.$N1:
	.BLKL	1			; PROMPT_ENDS, the function's value
FCPLATFORM.PROMPT_ENDS.KNOWN:
	.LONG	0			; KNOWN = 0
FCPLATFORM.PROMPT_ENDS.STATUS:
	.BLKL	1			; STATUS
FCPLATFORM.PROMPT_ENDS.TERMINAL:
	.BLKL	1			; TERMINAL

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCPLATFORM.PROMPT_ENDS.$K1:
	.LONG	74
FCPLATFORM.PROMPT_ENDS.$D1:
	.WORD	9			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCPLATFORM.PROMPT_ENDS.$K2
FCPLATFORM.PROMPT_ENDS.$K2:
	.ASCII	/SYS$INPUT/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;   22
;   23    ! PROMPT_ENDS says whether a READ ends the record a prompt left open
;   24    ! (module FCMESSAGES's SAY_MORE). VMS's FORTRAN writes such a record as the
;   25    ! READ's prompt when it reads a terminal, and the next line is a record of
;   26    ! its own; reading anything else (a file, in a command procedure), it
;   27    ! leaves the record open, and the next WRITE goes on with it, as Fortran
;   28    ! 90's nonadvancing output says it should. So the answer is whether
;   29    ! SYS$INPUT is a terminal, which LIB$GETDVI tells: its arguments are the
;   30    ! item code (DVI$_TRM, 74 in VMS's $DVIDEF), no channel (a null argument
;   31    ! again), the device's name, and a longword for the answer, whose low bit
;   32    ! is set for a terminal. A SAVE'd variable keeps the answer, so VMS is
;   33    ! asked once.
;   34    logical function prompt_ends()
	.ENTRY	FCPLATFORM.PROMPT_ENDS,^M<>
;   35      integer, parameter :: dvi_trm = 74
;   36      integer, save :: known = 0 ! 0 not yet asked, 1 a terminal, 2 not
;   37      integer :: status, terminal
;   38      integer, external :: lib$getdvi
;   39
;   40      if (known == 0) then
	TSTL	FCPLATFORM.PROMPT_ENDS.KNOWN
	BNEQ	FCPLATFORM.PROMPT_ENDS.$1
;   41        terminal = 0
	CLRL	FCPLATFORM.PROMPT_ENDS.TERMINAL
;   42        status = lib$getdvi(dvi_trm, , 'SYS$INPUT', terminal)
	PUSHAL	FCPLATFORM.PROMPT_ENDS.TERMINAL
	PUSHAQ	FCPLATFORM.PROMPT_ENDS.$D1
	PUSHL	#0
	PUSHAL	FCPLATFORM.PROMPT_ENDS.$K1
	CALLS	#4,G^LIB$GETDVI
	MOVL	R0,FCPLATFORM.PROMPT_ENDS.STATUS
;   43        known = 2
	MOVL	#2,FCPLATFORM.PROMPT_ENDS.KNOWN
;   44        if (btest(status, 0) .and. btest(terminal, 0)) known = 1
	EXTZV	#0,#1,FCPLATFORM.PROMPT_ENDS.STATUS,R0
	MNEGL	R0,R0
	BLBC	R0,FCPLATFORM.PROMPT_ENDS.$3
	EXTZV	#0,#1,FCPLATFORM.PROMPT_ENDS.TERMINAL,R0
	MNEGL	R0,R0
	BLBC	R0,FCPLATFORM.PROMPT_ENDS.$3
	MOVL	#1,FCPLATFORM.PROMPT_ENDS.KNOWN
FCPLATFORM.PROMPT_ENDS.$3:
;   45      end if
FCPLATFORM.PROMPT_ENDS.$1:
;   46      prompt_ends = known == 1
;   47    end function prompt_ends
	CLRL	R0			; the function's value
	CMPL	FCPLATFORM.PROMPT_ENDS.KNOWN,#1
	BNEQ	FCPLATFORM.PROMPT_ENDS.$6
	MNEGL	#1,R0
FCPLATFORM.PROMPT_ENDS.$6:
	RET

; Storage map for FCPLATFORM.FOREIGN_TEXT, a subroutine
;   TEXT    CHARACTER*(*), INTENT(OUT)  argument 1  @FCPLATFORM.FOREIGN_TEXT.TEXT(AP)
;   LENGTH  INTEGER, INTENT(OUT)        argument 2  @FCPLATFORM.FOREIGN_TEXT.LENGTH(AP)
;   STATUS  INTEGER                     $LOCAL+0    FCPLATFORM.FOREIGN_TEXT.STATUS
;   SHORT   INTEGER*2                   $LOCAL+4    FCPLATFORM.FOREIGN_TEXT.SHORT
;
FCPLATFORM.FOREIGN_TEXT.TEXT = 4	; TEXT is argument 1
FCPLATFORM.FOREIGN_TEXT.LENGTH = 8	; LENGTH is argument 2
	.EXTRN	LIB$GET_FOREIGN		; named in an EXTERNAL statement

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCPLATFORM.FOREIGN_TEXT.STATUS:
	.BLKL	1			; STATUS
FCPLATFORM.FOREIGN_TEXT.SHORT:
	.BLKB	2			; SHORT
	.BLKB	2

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCPLATFORM.FOREIGN_TEXT.$K1:
	.ASCII	/ /

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;   48
;   49    ! FOREIGN_TEXT gives the text typed after fcalc's name when it is run as
;   50    ! a foreign command,
;   51    !
;   52    !     $ FCALC == "$SYS$SYSTEM:FCALC"
;   53    !     $ FCALC 2^10 + 1
;   54    !
;   55    ! TEXT(:LENGTH), with LENGTH 0 when there is none (RUN FCALC, or FCALC
;   56    ! alone). DCL keeps the text, and LIB$GET_FOREIGN, a routine of VMS's
;   57    ! run-time library, gives it to the program: its arguments are the text
;   58    ! (a CHARACTER variable, which VMS passes by descriptor), a prompt for
;   59    ! when there is none (left out here: the two commas with nothing between
;   60    ! them are VMS's null argument, so LIB$GET_FOREIGN asks for nothing),
;   61    ! and the text's length, a word, INTEGER(2). Its value is a VMS status,
;   62    ! odd for success, which BTEST(STATUS, 0) tests. Calling a run-time
;   63    ! library routine is no different from calling a Fortran function:
;   64    ! EXTERNAL says the name is a procedure outside the program, and its type
;   65    ! is the type of its value.
;   66    subroutine foreign_text(text, length)
	.ENTRY	FCPLATFORM.FOREIGN_TEXT,^M<R2,R3,R4,R5>
;   67      character(len=*), intent(out) :: text
;   68      integer, intent(out) :: length
;   69      integer :: status
;   70      integer(2) :: short
;   71      integer, external :: lib$get_foreign
;   72
;   73      text = ' '
	MOVZWL	@FCPLATFORM.FOREIGN_TEXT.TEXT(AP),R0
	MOVL	FCPLATFORM.FOREIGN_TEXT.TEXT(AP),R1
	MOVC5	#1,FCPLATFORM.FOREIGN_TEXT.$K1,#^A/ /,R0,@4(R1)
;   74      short = 0
	CLRW	FCPLATFORM.FOREIGN_TEXT.SHORT
;   75      status = lib$get_foreign(text, , short)
	PUSHAW	FCPLATFORM.FOREIGN_TEXT.SHORT
	PUSHL	#0
	PUSHL	FCPLATFORM.FOREIGN_TEXT.TEXT(AP)
	CALLS	#3,G^LIB$GET_FOREIGN
	MOVL	R0,FCPLATFORM.FOREIGN_TEXT.STATUS
;   76      length = short
	CVTWL	FCPLATFORM.FOREIGN_TEXT.SHORT,@FCPLATFORM.FOREIGN_TEXT.LENGTH(AP)
;   77      if (.not. btest(status, 0)) length = 0
	EXTZV	#0,#1,FCPLATFORM.FOREIGN_TEXT.STATUS,R0
	MNEGL	R0,R0
	BLBS	R0,FCPLATFORM.FOREIGN_TEXT.$1
	CLRL	@FCPLATFORM.FOREIGN_TEXT.LENGTH(AP)
FCPLATFORM.FOREIGN_TEXT.$1:
;   78    end subroutine foreign_text
	RET

; Storage map for FCPLATFORM.SHOW_HELP, a LOGICAL function
;   REQUEST    CHARACTER*(*), INTENT(IN)  argument 1  @FCPLATFORM.SHOW_HELP.REQUEST(AP)
;   WRITER     INTEGER                    argument 2  @FCPLATFORM.SHOW_HELP.WRITER(AP)
;   SHOW_HELP  LOGICAL                    $LOCAL+0    FCPLATFORM.SHOW_HELP.SHOW_HELP
;   STATUS     INTEGER                    $LOCAL+4    FCPLATFORM.SHOW_HELP.STATUS
;
FCPLATFORM.SHOW_HELP.REQUEST = 4	; REQUEST is argument 1
FCPLATFORM.SHOW_HELP.WRITER = 8		; WRITER is argument 2
	.EXTRN	LBR$OUTPUT_HELP		; named in an EXTERNAL statement

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCPLATFORM.SHOW_HELP.SHOW_HELP:
	.BLKL	1			; SHOW_HELP, the function's value
FCPLATFORM.SHOW_HELP.STATUS:
	.BLKL	1			; STATUS

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCPLATFORM.SHOW_HELP.$K1:
	.LONG	0

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;   79
;   80    ! SHOW_HELP shows the help text REQUEST names, "FCALC" and the topics
;   81    ! after it, and is false if there is none to show. fcalc's help is the
;   82    ! FCALC topic of the system's help library, SYS$HELP:HELPLIB.HLB, the text
;   83    ! DCL's HELP FCALC shows, so it is written once, in VMS's help format, and
;   84    ! the library is its one copy. LBR$OUTPUT_HELP, a routine of VMS's
;   85    ! librarian, finds the topics and lays the text out, as HELP does: its
;   86    ! arguments are a routine to write each line, the line's width (left out:
;   87    ! 80), the request, the library (left out: SYS$HELP:HELPLIB), and flags
;   88    ! (0: no prompting for more topics, and no user libraries). It doesn't
;   89    ! write the lines itself: it calls WRITER with each, as a CHARACTER
;   90    ! argument, so they go where all of fcalc's output goes (module
;   91    ! FCMESSAGES's HELP_LINE). A procedure passed as an argument this way is
;   92    ! a dummy procedure: INTEGER, EXTERNAL says WRITER is a function, and
;   93    ! here it is passed on to LBR$OUTPUT_HELP as it came.
;   94    logical function show_help(request, writer)
	.ENTRY	FCPLATFORM.SHOW_HELP,^M<>
;   95      character(len=*), intent(in) :: request
;   96      integer, external :: writer
;   97      integer, parameter :: no_flags = 0
;   98      integer :: status
;   99      integer, external :: lbr$output_help
;  100
;  101      status = lbr$output_help(writer, , request, , no_flags)
	PUSHAL	FCPLATFORM.SHOW_HELP.$K1
	PUSHL	#0
	PUSHL	FCPLATFORM.SHOW_HELP.REQUEST(AP)
	PUSHL	#0
	PUSHL	FCPLATFORM.SHOW_HELP.WRITER(AP)
	CALLS	#5,G^LBR$OUTPUT_HELP
	MOVL	R0,FCPLATFORM.SHOW_HELP.STATUS
;  102      show_help = btest(status, 0)
;  103    end function show_help
	EXTZV	#0,#1,FCPLATFORM.SHOW_HELP.STATUS,R0 ; the function's value
	MNEGL	R0,R0
	RET
;  104  end module fcplatform

	.END
