;
$MOD$FCKINDS.9C225BC4 == 0		; this module's stamp, which its users' objects refer to

;    1  ! fcalc, a scientific calculator: the kinds and limits every module shares.
;    2  !
;    3  ! A note for readers new to Fortran 90 (the rest of fcalc's files build on
;    4  ! it). A program is units: a main program (fcalc.f90's PROGRAM FCALC) and
;    5  ! any number of MODULEs. A module holds declarations (constants, types,
;    6  ! variables) and, after CONTAINS, procedures; another unit gets them by
;    7  ! naming the module in a USE statement, as `use fckinds`. A module must be
;    8  ! compiled before any unit that USEs it, which is why compiles.txt lists
;    9  ! fcalc's files in an order: each file uses only those before it.
;   10  !
;   11  ! Every module starts IMPLICIT NONE: without it, Fortran gives an
;   12  ! undeclared name a type by its first letter (I to N INTEGER, the rest
;   13  ! REAL), so a misspelled name is silently a new variable. With it, every
;   14  ! name must be declared, and a misspelling is a compile error.
;   15  !
;   16  ! fcalc keeps every number as a COMPLEX of kind RK. In Fortran 90 a type
;   17  ! may come in several KINDs, each a different precision or range: REAL(4)
;   18  ! and REAL(8) are two kinds of REAL. Kind numbers differ from compiler to
;   19  ! compiler, so a portable program never writes one; it asks for the
;   20  ! precision it needs, with SELECTED_REAL_KIND(p, r): the kind with at least
;   21  ! p significant decimal digits and a decimal exponent range of at least r.
;   22  ! Here that is the kind with 15 digits and a range of 300, which is
;   23  ! G_floating on a VAX, where fcalc is compiled /G_FLOATING, and IEEE double
;   24  ! precision elsewhere. (Under the VAX's default D_floating REAL(8) reaches
;   25  ! only 1E38, so the kind is REAL(16), H_floating, larger and slower; hence
;   26  ! /G_FLOATING.) A constant of the kind is written with the kind after
;   27  ! an underscore: 1.0_rk. Without it, 1.0 would be a default REAL, single
;   28  ! precision, and 0.1 would be correct to only 7 digits.
;   29  !
;   30  ! Why "every number is complex"? A calculator meets complex numbers as soon
;   31  ! as it takes the square root of a negative number; keeping every value
;   32  ! complex means one kind of value everywhere, with a real number just one
;   33  ! whose imaginary part is zero.
;   34  !
;   35  ! The two machines' arithmetic differs at its edges: a VAX's largest G value
;   36  ! is about 8.98E307 and IEEE's 1.80E308, a VAX has no denormal numbers (the
;   37  ! tiny values IEEE keeps below its smallest normal number), and a VAX traps
;   38  ! (stops the program with a fault) on overflow and division by zero where
;   39  ! IEEE quietly makes an infinity. fcalc must print the same lines on both,
;   40  ! so it never goes near either edge: no value it keeps is larger than
;   41  ! LIMIT or, but for zero, smaller than SMALL, and every operation checks its
;   42  ! operands before it is done (module FCVALUES). This is a common discipline
;   43  ! in numerical programming: decide the range your values live in, and make
;   44  ! every operation either stay in it or report that it can't.
;   45  module fckinds
;   46    implicit none
;   47
;   48    ! PUBLIC: everything in this module may be used by a unit that USEs it.
;   49    ! (The other modules start PRIVATE instead, and list what they share.)
;   50    public
;   51
;   52    ! A named constant: PARAMETER makes RK a constant fixed when compiling,
;   53    ! so it may be used as a kind, in REAL(RK) and 1.0_RK.
;   54    integer, parameter :: rk = selected_real_kind(15, 300)
;   55
;   56    ! The largest and smallest magnitudes fcalc keeps, well inside both
;   57    ! machines' ranges (RANGE(1.0_RK) is 307 on both).
;   58    real(rk), parameter :: limit = 1.0e300_rk
;   59    real(rk), parameter :: small = 1.0e-300_rk
;   60
;   61    ! LOG(LIMIT) and LOG(SMALL): EXP of anything outside them is out of
;   62    ! range. (Written out: a constant's value in Fortran 90 may call only the
;   63    ! intrinsic functions of INTEGER and CHARACTER values, and inquiries such
;   64    ! as EPSILON below, not LOG of a REAL.)
;   65    real(rk), parameter :: log_limit = 690.775527898213705205_rk
;   66    real(rk), parameter :: log_small = -690.775527898213705205_rk
;   67
;   68    ! More digits than the kind holds: the compiler rounds them to the
;   69    ! nearest value the kind has, the best it can do.
;   70    real(rk), parameter :: pi = 3.14159265358979323846264338328_rk
;   71    real(rk), parameter :: e_value = 2.71828182845904523536028747135_rk
;   72
;   73    ! The machine's epsilon, the difference between 1 and the next larger
;   74    ! number of the kind: 2**-52 on both machines. EPSILON is an inquiry
;   75    ! function: it looks only at its argument's kind, never its value.
;   76    real(rk), parameter :: eps = epsilon(1.0_rk)
;   77
;   78    ! The longest line fcalc reads (VMS's FORTRAN reads a terminal's records
;   79    ! of up to 199 bytes), and the longest name.
;   80    integer, parameter :: line_length = 199
;   81    integer, parameter :: name_length = 31
;   82
;   83    ! The most significant digits a value is shown with.
;   84    integer, parameter :: max_digits = 15
;   85
;   86    ! The largest whole number fcalc counts as one: below 2**52, where every
;   87    ! whole number of the kind is exact on both machines and the next one up
;   88    ! differs by 1. A value this large or larger is never shown in another
;   89    ! base or used as a count.
;   90    real(rk), parameter :: whole_limit = 4.0e15_rk
;   91  end module fckinds

	.END
