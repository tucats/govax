;  629
;  630    ! INVERSE is inv(A): A \ I.
;  631    function inverse(a) result(q)
	.ENTRY	FCMATRIX.INVERSE,^M<R2,R3,R4,R5,R6>
;  632      type(quantity), intent(in) :: a
;  633      type(quantity) :: q
;  634
;  635      if (.not. square(a)) then
	PUSHAB	@FCMATRIX.INVERSE.A(AP)
