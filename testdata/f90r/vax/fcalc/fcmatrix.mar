; Storage map for FCMATRIX.SAMENESS, a REAL*8 function
;   BIG       REAL*8, INTENT(IN)  argument 1  @FCMATRIX.SAMENESS.BIG(AP)
;   SAMENESS  REAL*8              $LOCAL+0    FCMATRIX.SAMENESS.SAMENESS
;   ERR       INTEGER             $LOCAL+8    FCMATRIX.SAMENESS.ERR
;
FCMATRIX.SAMENESS.BIG = 4		; BIG is argument 1

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCMATRIX.SAMENESS.SAMENESS:
	.BLKL	2			; SAMENESS, the function's value
FCMATRIX.SAMENESS.ERR:
	.BLKL	1			; ERR
FCMATRIX.SAMENESS.$T1:
	.BLKL	2			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCMATRIX.SAMENESS.$KF1:
	.LONG	^X00004044,^X00000000	; 10D0

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
; 1184
; 1185    ! SAMENESS is how far apart two parts may be and count as the same in
; 1186    ! sorting: as far as the digits shown can't tell, beside BIG, the
; 1187    ! largest magnitude among the values sorted. Computed by R_MUL, so a
; 1188    ! tiny BIG gives 0 and never an underflow.
; 1189    real(rk) function sameness(big)
	.ENTRY	FCMATRIX.SAMENESS,^M<>
; 1190      real(rk), intent(in) :: big
; 1191      integer :: err
; 1192
; 1193      err = 0
	CLRL	FCMATRIX.SAMENESS.ERR
; 1194      sameness = r_mul(big, 10.0_rk ** (-digits), err)
	MNEGL	FCMATRIX.DIGITS,R0
	PUSHL	R0
	MOVQ	FCMATRIX.SAMENESS.$KF1,-(SP)
	CALLS	#3,G^OTS$POWGJ
	MOVG	R0,FCMATRIX.SAMENESS.$T1
	PUSHAL	FCMATRIX.SAMENESS.ERR
	PUSHAG	FCMATRIX.SAMENESS.$T1
	PUSHAG	@FCMATRIX.SAMENESS.BIG(AP)
	CALLS	#3,G^FCVALUES.R_MUL
	MOVG	R0,FCMATRIX.SAMENESS.SAMENESS
; 1195    end function sameness
	MOVG	FCMATRIX.SAMENESS.SAMENESS,R0 ; the function's value
	RET

; Storage map for FCMATRIX.BEFORE, a LOGICAL function
;   X       COMPLEX*16, INTENT(IN)  argument 1  @FCMATRIX.BEFORE.X(AP)
;   Y       COMPLEX*16, INTENT(IN)  argument 2  @FCMATRIX.BEFORE.Y(AP)
;   SCALE   REAL*8, INTENT(IN)      argument 3  @FCMATRIX.BEFORE.SCALE(AP)
;   BEFORE  LOGICAL                 R6          R6
;   R6 is $T1: temporary
;
FCMATRIX.BEFORE.X = 4			; X is argument 1
FCMATRIX.BEFORE.Y = 8			; Y is argument 2
FCMATRIX.BEFORE.SCALE = 12		; SCALE is argument 3

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
; 1196
; 1197    ! BEFORE: X comes before Y: its real part is less, by more than SCALE,
; 1198    ! or the real parts are the same and its imaginary part is less. Real
; 1199    ! parts that differ only by rounding count as the same, so a conjugate
; 1200    ! pair's member with the negative imaginary part comes first however
; 1201    ! their computed real parts differ, on any machine.
; 1202    logical function before(x, y, scale)
	.ENTRY	FCMATRIX.BEFORE,^M<R2,R6,R7>
; 1203      complex(rk), intent(in) :: x, y
; 1204      real(rk), intent(in) :: scale
; 1205
; 1206      if (abs(real(x, rk) - real(y, rk)) > scale) then
	SUBG3	@FCMATRIX.BEFORE.Y(AP),@FCMATRIX.BEFORE.X(AP),R6
	BGEQ	FCMATRIX.BEFORE.$1
	MNEGG	R6,R6
FCMATRIX.BEFORE.$1:
	CMPG	R6,@FCMATRIX.BEFORE.SCALE(AP)
	BLEQ	FCMATRIX.BEFORE.$3
; 1207        before = real(x, rk) < real(y, rk)
	CLRL	R0
	CMPG	@FCMATRIX.BEFORE.X(AP),@FCMATRIX.BEFORE.Y(AP)
	BGEQ	FCMATRIX.BEFORE.$5
	MNEGL	#1,R0
FCMATRIX.BEFORE.$5:
	MOVL	R0,R6
; 1208      else
	BRB	FCMATRIX.BEFORE.$6
FCMATRIX.BEFORE.$3:
; 1209        before = aimag(y) - aimag(x) > scale
	MOVL	#1,R0
	MOVL	#1,R1
	SUBG3	@FCMATRIX.BEFORE.X(AP)[R1],@FCMATRIX.BEFORE.Y(AP)[R0],R0
	CLRL	R2
	CMPG	R0,@FCMATRIX.BEFORE.SCALE(AP)
	BLEQ	FCMATRIX.BEFORE.$7
	MNEGL	#1,R2
FCMATRIX.BEFORE.$7:
	MOVL	R2,R6
; 1210      end if
FCMATRIX.BEFORE.$6:
; 1211    end function before
	MOVL	R6,R0			; the function's value
	RET

