	MOVL	FCMATRIX.DETERMINANT.A(AP),R0
	MOVAL	48(R0),FCMATRIX.DETERMINANT.$T8
	MOVL	FCMATRIX.DETERMINANT.$T8,R0
	SUBL3	#1,36(R0),FCMATRIX.DETERMINANT.$T9
	MOVL	FCMATRIX.DETERMINANT.A(AP),R0
	MOVAL	48(R0),FCMATRIX.DETERMINANT.$T10
	MOVL	FCMATRIX.DETERMINANT.$T10,R0
	MOVL	FCMATRIX.DETERMINANT.$T10,R1
	SUBL3	28(R1),32(R0),R0
	ADDL3	R0,#1,FCMATRIX.DETERMINANT.$T11
	BGEQ	FCMATRIX.DETERMINANT.$10
	CLRL	FCMATRIX.DETERMINANT.$T11
FCMATRIX.DETERMINANT.$10:
