;  661
;  662    ! MATRIX_POWER is A ^ B, for a square A and a whole B: by squaring, as
;  663    ! FCVALUES' V_POWER computes a number's power, and through the inverse
;  664    ! for a negative B. A ^ 0 is the identity.
;  665    function matrix_power(a, b) result(q)
	.ENTRY	FCMATRIX.MATRIX_POWER,^M<R2,R3,R4,R5,R6,R7,R8,R9>
