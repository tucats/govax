	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  440
;  441    ! ------------------------------------------------------------------
;  442    ! The LU factorization, and what is built on it.
;  443
;  444    ! LU_FACTOR factors the N by N matrix W in place as P W = L U, by
;  445    ! Gaussian elimination with partial pivoting: L is unit lower triangular
;  446    ! (its multipliers are kept below W's diagonal), U upper triangular (on
;  447    ! and above it), and P the row interchanges, PIV(k) the row swapped with
;  448    ! row k at step k. SIGN is the determinant of P, +1 or -1.
;  449    !
;  450    ! At each step the pivot is the column's largest element below the
;  451    ! diagonal (MAXLOC finds where it is), so no multiplier is larger than 1
;  452    ! and the elimination is stable in practice. A pivot no larger than N EPS
;  453    ! times the matrix's largest element is taken as zero: the matrix is
;  454    ! SINGULAR, to within what its digits can tell, and the factorization
;  455    ! stops there. [1, 2, 3; 4, 5, 6; 7, 8, 9] has a pivot of about 1E-16 at
;  456    ! its last step, rounding's noise, and is singular.
;  457    !
;  458    ! W is an explicit-shape array, W(N, N), the FORTRAN 77 way: the caller
;  459    ! says how large it is. The other arrays here are assumed-shape, the
;  460    ! Fortran 90 way.
;  461    subroutine lu_factor(w, n, piv, sign, singular, err)
	.ENTRY	FCMATRIX.LU_FACTOR,^M<R6,R7,R8,R9,R10,R11>
	MOVAO	@FCMATRIX.LU_FACTOR.W(AP),FCMATRIX.LU_FACTOR.$B1+4
	MOVL	@FCMATRIX.LU_FACTOR.N(AP),FCMATRIX.LU_FACTOR.$B1+32
	MOVL	FCMATRIX.LU_FACTOR.$B1+32,FCMATRIX.LU_FACTOR.$B1+20
	MOVL	@FCMATRIX.LU_FACTOR.N(AP),FCMATRIX.LU_FACTOR.$B1+40
	MOVL	FCMATRIX.LU_FACTOR.$B1+40,FCMATRIX.LU_FACTOR.$B1+24
	MNEGL	FCMATRIX.LU_FACTOR.$B1+20,R0
	DECL	R0
	MOVAO	@FCMATRIX.LU_FACTOR.W(AP)[R0],FCMATRIX.LU_FACTOR.$B1+16
	MULL3	#16,FCMATRIX.LU_FACTOR.$B1+20,R0
	MULL3	R0,FCMATRIX.LU_FACTOR.$B1+24,FCMATRIX.LU_FACTOR.$B1+12
	MOVAL	@FCMATRIX.LU_FACTOR.PIV(AP),FCMATRIX.LU_FACTOR.$B2+4
	MOVL	@FCMATRIX.LU_FACTOR.N(AP),FCMATRIX.LU_FACTOR.$B2+28
	MOVL	FCMATRIX.LU_FACTOR.$B2+28,FCMATRIX.LU_FACTOR.$B2+20
	MOVL	#-1,R0
	MOVAL	@FCMATRIX.LU_FACTOR.PIV(AP)[R0],FCMATRIX.LU_FACTOR.$B2+16
	MULL3	#4,FCMATRIX.LU_FACTOR.$B2+20,FCMATRIX.LU_FACTOR.$B2+12
	MOVL	@FCMATRIX.LU_FACTOR.N(AP),FCMATRIX.LU_FACTOR.MAG+28
	MOVL	FCMATRIX.LU_FACTOR.MAG+28,FCMATRIX.LU_FACTOR.MAG+20
	BGEQ	FCMATRIX.LU_FACTOR.$1
	CLRL	FCMATRIX.LU_FACTOR.MAG+20
FCMATRIX.LU_FACTOR.$1:
	MULL3	#8,FCMATRIX.LU_FACTOR.MAG+20,FCMATRIX.LU_FACTOR.MAG+12
	SUBL2	FCMATRIX.LU_FACTOR.MAG+12,SP ; storage of a size known only now
	BICL2	#3,SP
	MOVL	SP,FCMATRIX.LU_FACTOR.MAG+4
	MOVL	FCMATRIX.LU_FACTOR.MAG+4,R0
	MOVAG	-8(R0),FCMATRIX.LU_FACTOR.MAG+16
	MOVL	@FCMATRIX.LU_FACTOR.N(AP),FCMATRIX.LU_FACTOR.ROW+28
	MOVL	FCMATRIX.LU_FACTOR.ROW+28,FCMATRIX.LU_FACTOR.ROW+20
	BGEQ	FCMATRIX.LU_FACTOR.$3
	CLRL	FCMATRIX.LU_FACTOR.ROW+20
FCMATRIX.LU_FACTOR.$3:
	MULL3	#16,FCMATRIX.LU_FACTOR.ROW+20,FCMATRIX.LU_FACTOR.ROW+12
	SUBL2	FCMATRIX.LU_FACTOR.ROW+12,SP ; storage of a size known only now
	BICL2	#3,SP
	MOVL	SP,FCMATRIX.LU_FACTOR.ROW+4
	MOVL	FCMATRIX.LU_FACTOR.ROW+4,R0
	MOVAO	-16(R0),FCMATRIX.LU_FACTOR.ROW+16
;  462      integer, intent(in) :: n
;  463      complex(rk), intent(inout) :: w(n, n)
;  464      integer, intent(out) :: piv(n)
;  465      real(rk), intent(out) :: sign
;  466      logical, intent(out) :: singular
;  467      integer, intent(inout) :: err
;  468      real(rk) :: mag(n), big, tol
;  469      complex(rk) :: row(n), l
;  470      integer :: i, j, k, p, at(1)
;  471
;  472      sign = 1
	MOVG	FCMATRIX.LU_FACTOR.$KF1,@FCMATRIX.LU_FACTOR.SIGN(AP) ; 1D0
;  473      singular = .false.
	CLRL	@FCMATRIX.LU_FACTOR.SINGULAR(AP)
;  474      piv = (/ (k, k = 1, n) /)
	CLRL	R7
	MOVL	@FCMATRIX.LU_FACTOR.N(AP),R8 ; constructor (line 474), implied DO of K's limit
	MOVL	#1,R6
	CMPL	#1,R8
	BGTR	FCMATRIX.LU_FACTOR.$5
	MOVL	FCMATRIX.LU_FACTOR.$B2+16,R9
FCMATRIX.LU_FACTOR.$7:			; constructor (line 474), implied DO of K's body
	INCL	R7
	MOVL	R6,(R9)[R7]
	AOBLEQ	R8,R6,FCMATRIX.LU_FACTOR.$7
FCMATRIX.LU_FACTOR.$5:
;  475
;  476      big = 0
	CLRG	FCMATRIX.LU_FACTOR.BIG
;  477      do j = 1, n
	MOVL	@FCMATRIX.LU_FACTOR.N(AP),FCMATRIX.LU_FACTOR.$L2 ; DO (line 477)'s limit
	MOVL	#1,FCMATRIX.LU_FACTOR.J
	CMPL	#1,FCMATRIX.LU_FACTOR.$L2
	BLEQ	FCMATRIX.LU_FACTOR.$10
	BRW	FCMATRIX.LU_FACTOR.$9
FCMATRIX.LU_FACTOR.$10:
	MULL3	FCMATRIX.LU_FACTOR.J,FCMATRIX.LU_FACTOR.$B1+20,R11
	MOVL	FCMATRIX.LU_FACTOR.I,R6
	MOVL	FCMATRIX.LU_FACTOR.J,R10
FCMATRIX.LU_FACTOR.$11:			; DO (line 477)'s body
;  478        do i = 1, n
	MOVL	@FCMATRIX.LU_FACTOR.N(AP),R8 ; DO (line 478)'s limit
	MOVL	#1,R6
	CMPL	#1,R8
	BGTR	FCMATRIX.LU_FACTOR.$12
	MOVL	R11,R9			; from line 479
	MOVAO	@FCMATRIX.LU_FACTOR.$B1+16[R9],R7
