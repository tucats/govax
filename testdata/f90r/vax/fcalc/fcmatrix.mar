;    1  ! fcalc: matrices, their products and solutions, and the matrix functions.
;    2  !
;    3  ! The matrix product, the linear solve (A \ B), the inverse and the
;    4  ! determinant, a matrix's powers, rank, norms, and eigenvalues, and the
;    5  ! functions that make and reshape arrays (eye, zeros, linspace, reshape,
;    6  ! diag, ...), and the polynomials' roots, poly, and polyval (module FCPOLY
;    7  ! computes them), as a table like FCFUNCS': a row for each function, and a
;    8  ! CASE in APPLY_MATRIX.
;    9  !
;   10  ! Nothing here may trap, as nothing in FCVALUES may (module FCKINDS says
;   11  ! why). Three ways of keeping to that are used, each where it fits:
;   12  !
;   13  ! - Guarded arithmetic. The LU factorization and everything built on it
;   14  !   (solve, inverse, determinant, rank) does each operation on elements by
;   15  !   FCVALUES' C_ADD, C_MUL, and C_DIV, which check before they compute.
;   16  !   Slower than plain arithmetic, but fcalc's matrices are small.
;   17  !
;   18  ! - A safe band. MATMUL and DOT_PRODUCT, Fortran 90's own matrix product
;   19  !   and dot product, can't be guarded inside; but if every element's parts
;   20  !   are zero or between 1E-100 and 1E100, no product of two is outside
;   21  !   1E-200 to 1E200, and no sum of fewer than 10,000 of them can overflow.
;   22  !   So the intrinsics are used when the operands are in that band
;   23  !   (IN_BAND), and a guarded loop otherwise.
;   24  !
;   25  ! - Scaling. The eigenvalue iteration divides the matrix by its largest
;   26  !   element first, so every element is at most 1 and a unitary similarity
;   27  !   keeps them so; values that would only underflow are set to zero as
;   28  !   they appear (FLUSH_SPECKS), being far below anything the eigenvalues'
;   29  !   digits can show. The iteration then runs in plain complex arithmetic,
;   30  !   and the eigenvalues are scaled back.
;   31  !
;   32  ! Fortran 90's array language is used throughout: whole-array expressions
;   33  ! (W = Z, X = X - M), sections (H(K+1:N, K)), sections with a stride (a
;   34  ! diagonal is every (M+1)th element of the array laid out flat), vector
;   35  ! subscripts (a permutation), and the intrinsics that work on arrays:
;   36  ! MATMUL, DOT_PRODUCT, TRANSPOSE, RESHAPE, CSHIFT, MAXLOC, SUM, CONJG.
;   37  module fcmatrix
;   38    use fckinds
;   39    use fcmessages
;   40    use fcvalues
;   41    use fcarrays
;   42    use fcfuncs, only: builtin
;   43    use fcpoly
;   44    implicit none
;   45    private
;   46
;   47    public :: quantity
;   48    public :: matrix_index, matrix_arity_ok, apply_matrix
;   49    public :: matrix_product, solve, right_divide, matrix_power, transposed
;   50
;   51    type(builtin), parameter :: functions(26) = (/ &
;   52      builtin('size', 1, 2), builtin('rows', 1, 1), builtin('cols', 1, 1), &
;   53      builtin('numel', 1, 1), builtin('transpose', 1, 1), builtin('trace', 1, 1), &
;   54      builtin('det', 1, 1), builtin('inv', 1, 1), builtin('rank', 1, 1), &
;   55      builtin('norm', 1, 2), builtin('dot', 2, 2), builtin('cross', 2, 2), &
;   56      builtin('kron', 2, 2), builtin('reshape', 3, 3), builtin('diag', 1, 1), &
;   57      builtin('eye', 1, 1), builtin('zeros', 1, 2), builtin('ones', 1, 2), &
;   58      builtin('linspace', 3, 3), builtin('range', 2, 3), builtin('cumsum', 1, 1), &
;   59      builtin('sort', 1, 1), builtin('eig', 1, 1), builtin('roots', 1, 1), &
;   60      builtin('poly', 1, 1), builtin('polyval', 2, 2) /)
;   61
;   62    ! The safe band for MATMUL and DOT_PRODUCT.
;   63    real(rk), parameter :: band_low = 1.0e-100_rk, band_high = 1.0e100_rk
;   64
;   65    ! In the eigenvalue iteration, on a matrix scaled to at most 1: a part
;   66    ! below SPECK is set to zero, and a subdiagonal element below
;   67    ! DEFLATE_LEVEL is taken as zero, splitting the matrix.
;   68    real(rk), parameter :: speck = 1.0e-50_rk, deflate_level = 1.0e-30_rk
;   69
;   70    ! How many QR steps an eigenvalue may take to converge.
;   71    integer, parameter :: step_limit = 30
;   72
;   73  contains

