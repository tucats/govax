FCMATRIX.TRACE_OF.$K1:
	.LONG	28

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  413
;  414    ! TRACE_OF is the sum of a square matrix's diagonal.
;  415    function trace_of(a) result(q)
	.ENTRY	FCMATRIX.TRACE_OF,^M<R2,R3,R4,R5,R6,R7,R8>
;  416      type(quantity), intent(in) :: a
;  417      type(quantity) :: q
;  418      complex(rk) :: s
;  419      integer :: k, err
;  420
;  421      if (.not. square(a)) then
	PUSHAB	@FCMATRIX.TRACE_OF.A(AP)
	CALLS	#1,G^FCMATRIX.SQUARE
	MOVL	R0,R6
	BLBS	R6,FCMATRIX.TRACE_OF.$1
;  422        q = failure(e_notsquare)
	PUSHAL	FCMATRIX.TRACE_OF.$K1
	PUSHAB	FCMATRIX.TRACE_OF.$T2
	CALLS	#2,G^FCARRAYS.FAILURE
	MOVC3	#96,FCMATRIX.TRACE_OF.$T2,@FCMATRIX.TRACE_OF.Q(AP)
;  423        return
	RET
FCMATRIX.TRACE_OF.$1:
;  424      end if
;  425      if (.not. is_array(a)) then
	PUSHAB	@FCMATRIX.TRACE_OF.A(AP)
	CALLS	#1,G^FCARRAYS.IS_ARRAY
	MOVL	R0,R6
	BLBS	R6,FCMATRIX.TRACE_OF.$3
;  426        q = scalar_quantity(a%s)
	MOVL	FCMATRIX.TRACE_OF.A(AP),R0
	PUSHAB	16(R0)
	PUSHAB	FCMATRIX.TRACE_OF.$T2
	CALLS	#2,G^FCARRAYS.SCALAR_QUANTITY
	MOVC3	#96,FCMATRIX.TRACE_OF.$T2,@FCMATRIX.TRACE_OF.Q(AP)
;  427        return
	RET
FCMATRIX.TRACE_OF.$3:
;  428      end if
;  429      err = 0
	CLRL	FCMATRIX.TRACE_OF.ERR
;  430      s = (0.0_rk, 0.0_rk)
	CLRO	FCMATRIX.TRACE_OF.S
;  431      do k = 1, a%rows
	MOVL	@FCMATRIX.TRACE_OF.A(AP),R8 ; DO (line 431)'s limit
	MOVL	#1,FCMATRIX.TRACE_OF.K
	CMPL	#1,R8
	BGTR	FCMATRIX.TRACE_OF.$5
	MOVL	FCMATRIX.TRACE_OF.A(AP),R7
FCMATRIX.TRACE_OF.$7:			; DO (line 431)'s body
;  432        s = c_add(s, a%e(k, k), err)
	MOVAL	48(R7),R6
	PUSHAL	FCMATRIX.TRACE_OF.ERR
	MULL3	FCMATRIX.TRACE_OF.K,20(R6),R0
	ADDL2	16(R6),R0
	MULL3	FCMATRIX.TRACE_OF.K,24(R6),R1
	ADDL2	R1,R0
	PUSHAO	(R0)
	PUSHAO	FCMATRIX.TRACE_OF.S
	PUSHAO	FCMATRIX.TRACE_OF.$T3
	CALLS	#4,G^FCVALUES.C_ADD
	MOVO	FCMATRIX.TRACE_OF.$T3,FCMATRIX.TRACE_OF.S
;  433      end do
	AOBLEQ	R8,FCMATRIX.TRACE_OF.K,FCMATRIX.TRACE_OF.$7
FCMATRIX.TRACE_OF.$5:
;  434      if (err /= 0) then
	TSTL	FCMATRIX.TRACE_OF.ERR
	BEQL	FCMATRIX.TRACE_OF.$9
;  435        q = failure(err)
	PUSHAL	FCMATRIX.TRACE_OF.ERR
	PUSHAB	FCMATRIX.TRACE_OF.$T2
	CALLS	#2,G^FCARRAYS.FAILURE
	MOVC3	#96,FCMATRIX.TRACE_OF.$T2,@FCMATRIX.TRACE_OF.Q(AP)
;  436      else
	RET
FCMATRIX.TRACE_OF.$9:
;  437        q = scalar_quantity(clean(s))
	PUSHAO	FCMATRIX.TRACE_OF.S
	PUSHAB	FCMATRIX.TRACE_OF.$T4
	CALLS	#2,G^FCVALUES.CLEAN
	PUSHAB	FCMATRIX.TRACE_OF.$T4
	PUSHAB	FCMATRIX.TRACE_OF.$T2
	CALLS	#2,G^FCARRAYS.SCALAR_QUANTITY
	MOVC3	#96,FCMATRIX.TRACE_OF.$T2,@FCMATRIX.TRACE_OF.Q(AP)
;  438      end if
;  439    end function trace_of
	RET

