	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
; 1344
; 1345    ! HESSENBERG reduces H to upper Hessenberg form by Householder
; 1346    ! reflections. At step k, the part of column k below the subdiagonal,
; 1347    ! x = H(k+1:n, k), is reflected onto its first element: with
; 1348    !     alpha = -(x1 / |x1|) |x|,   v = x - alpha e1,
; 1349    ! the reflector P = I - 2 v v* / (v* v) takes x to alpha e1. (Taking alpha
; 1350    ! against x1's direction makes v1 = x1 - alpha a sum of two numbers of
; 1351    ! the same direction, so nothing cancels.) H becomes P H P, a similarity
; 1352    ! (P is its own inverse), which zeroes column k below the subdiagonal.
; 1353    !
; 1354    ! DOT_PRODUCT(v, c) is v* c, conjugating v; SUM(r * v) is r v without.
; 1355    subroutine hessenberg(h, n)
	.ENTRY	FCMATRIX.HESSENBERG,^M<R2,R3,R6,R7,R8,R9,R10,R11>
	MOVAO	@FCMATRIX.HESSENBERG.H(AP),FCMATRIX.HESSENBERG.$B1+4
	MOVL	@FCMATRIX.HESSENBERG.N(AP),FCMATRIX.HESSENBERG.$B1+32
	MOVL	FCMATRIX.HESSENBERG.$B1+32,FCMATRIX.HESSENBERG.$B1+20
	MOVL	@FCMATRIX.HESSENBERG.N(AP),FCMATRIX.HESSENBERG.$B1+40
	MOVL	FCMATRIX.HESSENBERG.$B1+40,FCMATRIX.HESSENBERG.$B1+24
	MNEGL	FCMATRIX.HESSENBERG.$B1+20,R0
	DECL	R0
	MOVAO	@FCMATRIX.HESSENBERG.H(AP)[R0],FCMATRIX.HESSENBERG.$B1+16
	MULL3	#16,FCMATRIX.HESSENBERG.$B1+20,R0
	MULL3	R0,FCMATRIX.HESSENBERG.$B1+24,FCMATRIX.HESSENBERG.$B1+12
	MOVL	@FCMATRIX.HESSENBERG.N(AP),FCMATRIX.HESSENBERG.V+28
	MOVL	FCMATRIX.HESSENBERG.V+28,FCMATRIX.HESSENBERG.V+20
	BGEQ	FCMATRIX.HESSENBERG.$1
	CLRL	FCMATRIX.HESSENBERG.V+20
FCMATRIX.HESSENBERG.$1:
	MULL3	#16,FCMATRIX.HESSENBERG.V+20,FCMATRIX.HESSENBERG.V+12
	SUBL2	FCMATRIX.HESSENBERG.V+12,SP ; storage of a size known only now
	BICL2	#3,SP
	MOVL	SP,FCMATRIX.HESSENBERG.V+4
	MOVL	FCMATRIX.HESSENBERG.V+4,R0
	MOVAO	-16(R0),FCMATRIX.HESSENBERG.V+16
; 1356      integer, intent(in) :: n
; 1357      complex(rk), intent(inout) :: h(n, n)
; 1358      complex(rk) :: v(n), alpha, w
; 1359      real(rk) :: xnorm, f
; 1360      integer :: i, j, k, m
; 1361
; 1362      call flush_specks(h)
	MOVAO	@FCMATRIX.HESSENBERG.H(AP),FCMATRIX.HESSENBERG.$D1+4
	MOVL	#16,FCMATRIX.HESSENBERG.$D1+20
	MOVL	#1,FCMATRIX.HESSENBERG.$D1+28
	MOVL	FCMATRIX.HESSENBERG.$B1+32,FCMATRIX.HESSENBERG.$D1+32
	MULL3	#16,FCMATRIX.HESSENBERG.$B1+20,FCMATRIX.HESSENBERG.$D1+24
