;  746
;  747    function logical_quantity(b) result(q)
	.ENTRY	FCMATRIX.LOGICAL_QUANTITY,^M<R2,R3,R4,R5>
;  748      logical, intent(in) :: b
;  749      type(quantity) :: q
;  750
