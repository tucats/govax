;  375
;  376    ! KRON_OF is the Kronecker product: A's every element times the whole of
;  377    ! B, laid out as A's elements are.
;  378    function kron_of(a, b) result(q)
	.ENTRY	FCMATRIX.KRON_OF,^M<R2,R3,R4,R5>
;  379      type(quantity), intent(in) :: a, b
;  380      type(quantity) :: q
;  381
;  382      if (numel(a) > max_elements / numel(b)) then
	PUSHAB	@FCMATRIX.KRON_OF.A(AP)
	CALLS	#1,G^FCARRAYS.NUMEL
	MOVL	R0,FCMATRIX.KRON_OF.$T1
	PUSHAB	@FCMATRIX.KRON_OF.B(AP)
	CALLS	#1,G^FCARRAYS.NUMEL
	MOVL	R0,FCMATRIX.KRON_OF.$T2
	DIVL3	FCMATRIX.KRON_OF.$T2,#10000,R0
	CMPL	FCMATRIX.KRON_OF.$T1,R0
	BLEQ	FCMATRIX.KRON_OF.$1
;  383        q = failure(e_toobig)
	PUSHAL	FCMATRIX.KRON_OF.$K1
	PUSHAB	FCMATRIX.KRON_OF.$T3
	CALLS	#2,G^FCARRAYS.FAILURE
	MOVC3	#96,FCMATRIX.KRON_OF.$T3,@FCMATRIX.KRON_OF.Q(AP)
;  384      else
	RET
FCMATRIX.KRON_OF.$1:
;  385        q = kron_elements(elements_of(a), elements_of(b))
	TSTL	FCMATRIX.KRON_OF.$G1+4
	BEQL	FCMATRIX.KRON_OF.$4
	PUSHL	#0
	PUSHAQ	FCMATRIX.KRON_OF.$G1
	CALLS	#2,G^FTN$DEALLOCATE
FCMATRIX.KRON_OF.$4:
	PUSHAB	@FCMATRIX.KRON_OF.A(AP)
	PUSHAQ	FCMATRIX.KRON_OF.$G1
	CALLS	#2,G^FCARRAYS.ELEMENTS_OF
	TSTL	FCMATRIX.KRON_OF.$G2+4
	BEQL	FCMATRIX.KRON_OF.$6
	PUSHL	#0
	PUSHAQ	FCMATRIX.KRON_OF.$G2
	CALLS	#2,G^FTN$DEALLOCATE
FCMATRIX.KRON_OF.$6:
	PUSHAB	@FCMATRIX.KRON_OF.B(AP)
	PUSHAQ	FCMATRIX.KRON_OF.$G2
	CALLS	#2,G^FCARRAYS.ELEMENTS_OF
	PUSHAQ	FCMATRIX.KRON_OF.$G2
	PUSHAQ	FCMATRIX.KRON_OF.$G1
	PUSHAB	FCMATRIX.KRON_OF.$T3
	CALLS	#3,G^FCMATRIX.KRON_ELEMENTS
	MOVC3	#96,FCMATRIX.KRON_OF.$T3,@FCMATRIX.KRON_OF.Q(AP)
	TSTL	FCMATRIX.KRON_OF.$G1+4
	BEQL	FCMATRIX.KRON_OF.$8
	PUSHL	#0
	PUSHAQ	FCMATRIX.KRON_OF.$G1
	CALLS	#2,G^FTN$DEALLOCATE
FCMATRIX.KRON_OF.$8:
	TSTL	FCMATRIX.KRON_OF.$G2+4
	BEQL	FCMATRIX.KRON_OF.$10
	PUSHL	#0
	PUSHAQ	FCMATRIX.KRON_OF.$G2
	CALLS	#2,G^FTN$DEALLOCATE
FCMATRIX.KRON_OF.$10:
;  386      end if
;  387    end function kron_of
	RET

