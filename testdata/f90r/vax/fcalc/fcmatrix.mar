;  555
;  556    ! SOLVE is A \ B, the X with A X = B, for a square A and a B of as many
;  557    ! rows (each column of B a right-hand side).
;  558    function solve(a, b) result(q)
	.ENTRY	FCMATRIX.SOLVE,^M<R2,R3,R4,R5>
;  559      type(quantity), intent(in) :: a, b
;  560      type(quantity) :: q
;  561
;  562      if (.not. square(a)) then
	PUSHAB	@FCMATRIX.SOLVE.A(AP)
	CALLS	#1,G^FCMATRIX.SQUARE
	MOVL	R0,FCMATRIX.SOLVE.$T1
	BLBS	FCMATRIX.SOLVE.$T1,FCMATRIX.SOLVE.$1
;  563        q = failure(e_notsquare)
	PUSHAL	FCMATRIX.SOLVE.$K1
	PUSHAB	FCMATRIX.SOLVE.$T2
	CALLS	#2,G^FCARRAYS.FAILURE
	MOVC3	#96,FCMATRIX.SOLVE.$T2,@FCMATRIX.SOLVE.Q(AP)
;  564      else if (a%rows /= b%rows) then
	RET
FCMATRIX.SOLVE.$1:
	CMPL	@FCMATRIX.SOLVE.A(AP),@FCMATRIX.SOLVE.B(AP)
	BEQL	FCMATRIX.SOLVE.$4
;  565        q = failure(e_notconform)
	PUSHAL	FCMATRIX.SOLVE.$K2
	PUSHAB	FCMATRIX.SOLVE.$T2
	CALLS	#2,G^FCARRAYS.FAILURE
	MOVC3	#96,FCMATRIX.SOLVE.$T2,@FCMATRIX.SOLVE.Q(AP)
;  566      else
	RET
FCMATRIX.SOLVE.$4:
;  567        q = lu_solve(elements_of(a), elements_of(b))
	TSTL	FCMATRIX.SOLVE.$G1+4
	BEQL	FCMATRIX.SOLVE.$6
	PUSHL	#0
	PUSHAQ	FCMATRIX.SOLVE.$G1
	CALLS	#2,G^FTN$DEALLOCATE
FCMATRIX.SOLVE.$6:
	PUSHAB	@FCMATRIX.SOLVE.A(AP)
	PUSHAQ	FCMATRIX.SOLVE.$G1
	CALLS	#2,G^FCARRAYS.ELEMENTS_OF
	TSTL	FCMATRIX.SOLVE.$G2+4
