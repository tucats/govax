; Storage map for FCMATRIX.COUNT_ARGUMENT, a LOGICAL function
;   Q               TYPE(QUANTITY), INTENT(IN)   argument 1  @FCMATRIX.COUNT_ARGUMENT.Q(AP)
;   N               INTEGER, INTENT(OUT)         argument 2  @FCMATRIX.COUNT_ARGUMENT.N(AP)
;   BAD             TYPE(QUANTITY), INTENT(OUT)  argument 3  @FCMATRIX.COUNT_ARGUMENT.BAD(AP)
;   COUNT_ARGUMENT  LOGICAL                      R6          R6
;   X               REAL*8                       $LOCAL+4    FCMATRIX.COUNT_ARGUMENT.X
;
FCMATRIX.COUNT_ARGUMENT.Q = 4		; Q is argument 1
FCMATRIX.COUNT_ARGUMENT.N = 8		; N is argument 2
FCMATRIX.COUNT_ARGUMENT.BAD = 12	; BAD is argument 3

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
	.BLKB	4
FCMATRIX.COUNT_ARGUMENT.X:
	.BLKL	2			; X
FCMATRIX.COUNT_ARGUMENT.$T1:
	.BLKL	24			; characters, for one statement
FCMATRIX.COUNT_ARGUMENT.$T2:
	.BLKL	1			; temporary
FCMATRIX.COUNT_ARGUMENT.$T3:
	.BLKL	2			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCMATRIX.COUNT_ARGUMENT.$K1:
	.LONG	^X00000000,^X00000000	; 0D0
FCMATRIX.COUNT_ARGUMENT.$K2:
	.LONG	16
FCMATRIX.COUNT_ARGUMENT.$K3:
	.LONG	11
FCMATRIX.COUNT_ARGUMENT.$K4:
	.LONG	34
FCMATRIX.COUNT_ARGUMENT.$KF1:
	.LONG	^X00004010,^X00000000	; 1D0
FCMATRIX.COUNT_ARGUMENT.$KF2:
	.LONG	^X880040E3,^X00000000	; 10000D0

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  177
;  178    ! ------------------------------------------------------------------
;  179    ! Arguments.
;  180
;  181    ! COUNT_ARGUMENT: Q is a whole number from 1 to MAX_ELEMENTS, N; if not,
;  182    ! BAD says why.
;  183    logical function count_argument(q, n, bad)
	.ENTRY	FCMATRIX.COUNT_ARGUMENT,^M<R2,R3,R4,R5,R6>
;  184      type(quantity), intent(in) :: q
;  185      integer, intent(out) :: n
;  186      type(quantity), intent(out) :: bad
;  187      real(rk) :: x
;  188
;  189      count_argument = .false.
	CLRL	R6
;  190      n = 0
	CLRL	@FCMATRIX.COUNT_ARGUMENT.N(AP)
;  191      bad = real_quantity(0.0_rk)
	PUSHAG	FCMATRIX.COUNT_ARGUMENT.$K1
	PUSHAB	FCMATRIX.COUNT_ARGUMENT.$T1
	CALLS	#2,G^FCARRAYS.REAL_QUANTITY
	MOVC3	#96,FCMATRIX.COUNT_ARGUMENT.$T1,@FCMATRIX.COUNT_ARGUMENT.BAD(AP)
;  192      if (.not. real_scalar(q, x, bad)) return
