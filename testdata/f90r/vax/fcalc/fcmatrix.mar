;  728
;  729    ! ------------------------------------------------------------------
;  730    ! Rank and norms.
;  731
;  732    ! RANK_OF is the number of A's rows (or columns) that are independent, to
;  733    ! within its digits: Gaussian elimination with complete pivoting, each
;  734    ! step's pivot the largest element left anywhere, counting the pivots
;  735    ! larger than max(m, n) EPS times A's largest element.
;  736    function rank_of(a) result(q)
	.ENTRY	FCMATRIX.RANK_OF,^M<R2,R3,R4,R5,R6>
;  737      type(quantity), intent(in) :: a
;  738      type(quantity) :: q
;  739
;  740      if (.not. is_array(a)) then
	PUSHAB	@FCMATRIX.RANK_OF.A(AP)
	CALLS	#1,G^FCARRAYS.IS_ARRAY
	MOVL	R0,FCMATRIX.RANK_OF.$T1
	BLBS	FCMATRIX.RANK_OF.$T1,FCMATRIX.RANK_OF.$1
;  741        q = logical_quantity(truth(a%s))
	MOVL	FCMATRIX.RANK_OF.A(AP),R0
	PUSHAB	16(R0)
	CALLS	#1,G^FCVALUES.TRUTH
	MOVL	R0,FCMATRIX.RANK_OF.$T1
	PUSHAL	FCMATRIX.RANK_OF.$T1
	PUSHAB	FCMATRIX.RANK_OF.$T2
	CALLS	#2,G^FCMATRIX.LOGICAL_QUANTITY
	MOVC3	#96,FCMATRIX.RANK_OF.$T2,@FCMATRIX.RANK_OF.Q(AP)
;  742      else
	RET
FCMATRIX.RANK_OF.$1:
;  743        q = real_quantity(real(rank_count(a%e), rk))
	MOVL	FCMATRIX.RANK_OF.A(AP),R0
	MOVAL	48(R0),R6
	PUSHAL	(R6)
	CALLS	#1,G^FCMATRIX.RANK_COUNT
	MOVL	R0,FCMATRIX.RANK_OF.$T1
	CVTLG	FCMATRIX.RANK_OF.$T1,FCMATRIX.RANK_OF.$T4
	PUSHAG	FCMATRIX.RANK_OF.$T4
	PUSHAB	FCMATRIX.RANK_OF.$T2
	CALLS	#2,G^FCARRAYS.REAL_QUANTITY
	MOVC3	#96,FCMATRIX.RANK_OF.$T2,@FCMATRIX.RANK_OF.Q(AP)
;  744      end if
;  745    end function rank_of
	RET

