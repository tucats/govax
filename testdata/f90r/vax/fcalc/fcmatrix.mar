	MOVAL	48(R0),FCMATRIX.DETERMINANT.$T12
	MOVL	FCMATRIX.DETERMINANT.$T12,R0
	MOVL	FCMATRIX.DETERMINANT.$T12,R1
	SUBL3	36(R1),40(R0),R0
	ADDL3	R0,#1,FCMATRIX.DETERMINANT.$T13
	BGEQ	FCMATRIX.DETERMINANT.$12
	CLRL	FCMATRIX.DETERMINANT.$T13
FCMATRIX.DETERMINANT.$12:
	MOVL	FCMATRIX.DETERMINANT.$T11,FCMATRIX.DETERMINANT.$R1+20
	MOVL	FCMATRIX.DETERMINANT.$R1+20,FCMATRIX.DETERMINANT.$R1+32
	MOVL	FCMATRIX.DETERMINANT.$T13,FCMATRIX.DETERMINANT.$R1+24
	MOVL	FCMATRIX.DETERMINANT.$R1+24,FCMATRIX.DETERMINANT.$R1+40
	MULL3	#16,FCMATRIX.DETERMINANT.$R1+20,R0
