;  711            started = .true.
	MOVL	#-1,R9
;  712          end if
FCMATRIX.MATRIX_POWER.$27:
;  713          if (quantity_error(q) /= 0) exit
	PUSHAB	(R6)
	CALLS	#1,G^FCARRAYS.QUANTITY_ERROR
	MOVL	R0,R7
	BEQL	FCMATRIX.MATRIX_POWER.$29
	BRW	FCMATRIX.MATRIX_POWER.$28
FCMATRIX.MATRIX_POWER.$29:
;  714        end if
FCMATRIX.MATRIX_POWER.$23:
;  715        k = k / 2
	DIVL2	#2,R8
;  716        if (k == 0) exit
