FCMATRIX.WILKINSON.M:
	.BLKL	4			; M
FCMATRIX.WILKINSON.R:
	.BLKL	4			; R
FCMATRIX.WILKINSON.$T1:
	.BLKL	4			; temporary
FCMATRIX.WILKINSON.$T2:
	.BLKL	4			; temporary
FCMATRIX.WILKINSON.$T3:
	.BLKL	4			; temporary
FCMATRIX.WILKINSON.$T4:
	.BLKL	4			; temporary
FCMATRIX.WILKINSON.$T5:
	.BLKL	4			; temporary
FCMATRIX.WILKINSON.$T6:
	.BLKL	2			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCMATRIX.WILKINSON.$KF1:
	.LONG	^X00000000,^X00000000	; 0D0
FCMATRIX.WILKINSON.$KF2:
	.LONG	^X00004020,^X00000000	; 2D0

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
; 1494
; 1495    ! WILKINSON is the eigenvalue of [a, b; c, d] nearer d: with
; 1496    ! m = (a + d) / 2 and r = sqrt(((a - d) / 2)**2 + b c), m + r or m - r.
; 1497    complex(rk) function wilkinson(a, b, c, d)
	.ENTRY	FCMATRIX.WILKINSON,^M<R2,R3,R6,R7>
; 1498      complex(rk), intent(in) :: a, b, c, d
; 1499      complex(rk) :: m, r
; 1500
; 1501      m = (a + d) / 2
	MOVQ	FCMATRIX.WILKINSON.$KF1,-(SP)
	MOVQ	FCMATRIX.WILKINSON.$KF2,-(SP)
	MOVL	#1,R0
	MOVL	#1,R1
	ADDG3	@FCMATRIX.WILKINSON.A(AP)[R0],@FCMATRIX.WILKINSON.D(AP)[R1],R0
	MOVQ	R0,-(SP)
	ADDG3	@FCMATRIX.WILKINSON.A(AP),@FCMATRIX.WILKINSON.D(AP),R0
	MOVQ	R0,-(SP)
	CALLS	#8,G^OTS$DIVCG_R3
	MOVO	R0,FCMATRIX.WILKINSON.$T1
	MOVG	FCMATRIX.WILKINSON.$T1,FCMATRIX.WILKINSON.M
	MOVG	FCMATRIX.WILKINSON.$T1+8,FCMATRIX.WILKINSON.M+8
; 1502      r = sqrt(((a - d) / 2) ** 2 + b * c)
	MOVQ	FCMATRIX.WILKINSON.$KF1,-(SP)
	MOVQ	FCMATRIX.WILKINSON.$KF2,-(SP)
	MOVL	#1,R0
	MOVL	#1,R1
	SUBG3	@FCMATRIX.WILKINSON.D(AP)[R1],@FCMATRIX.WILKINSON.A(AP)[R0],R0
	MOVQ	R0,-(SP)
	SUBG3	@FCMATRIX.WILKINSON.D(AP),@FCMATRIX.WILKINSON.A(AP),R0
	MOVQ	R0,-(SP)
	CALLS	#8,G^OTS$DIVCG_R3
	MOVO	R0,FCMATRIX.WILKINSON.$T3
	PUSHL	#2
	MOVQ	FCMATRIX.WILKINSON.$T3+8,-(SP)
	MOVQ	FCMATRIX.WILKINSON.$T3,-(SP)
	CALLS	#5,G^OTS$POWCGJ_R3
	MOVO	R0,FCMATRIX.WILKINSON.$T4
	MOVL	#1,R0
	MOVQ	@FCMATRIX.WILKINSON.C(AP)[R0],-(SP)
	MOVQ	@FCMATRIX.WILKINSON.C(AP),-(SP)
	MOVL	#1,R0
	MOVQ	@FCMATRIX.WILKINSON.B(AP)[R0],-(SP)
	MOVQ	@FCMATRIX.WILKINSON.B(AP),-(SP)
	CALLS	#8,G^OTS$MULCG_R3
	MOVO	R0,FCMATRIX.WILKINSON.$T5
	ADDG3	FCMATRIX.WILKINSON.$T4,FCMATRIX.WILKINSON.$T5,FCMATRIX.WILKINSON.$T2
	ADDG3	FCMATRIX.WILKINSON.$T4+8,FCMATRIX.WILKINSON.$T5+8,FCMATRIX.WILKINSON.$T2+8
	PUSHAO	FCMATRIX.WILKINSON.$T2
	PUSHAO	FCMATRIX.WILKINSON.$T1
	CALLS	#2,G^MTH$CGSQRT
	MOVO	FCMATRIX.WILKINSON.$T1,FCMATRIX.WILKINSON.R
; 1503      if (abs(m + r - d) <= abs(m - r - d)) then
	ADDG3	FCMATRIX.WILKINSON.M,FCMATRIX.WILKINSON.R,R0
	SUBG3	@FCMATRIX.WILKINSON.D(AP),R0,FCMATRIX.WILKINSON.$T5
	ADDG3	FCMATRIX.WILKINSON.M+8,FCMATRIX.WILKINSON.R+8,R0
	MOVL	#1,R2
	SUBG3	@FCMATRIX.WILKINSON.D(AP)[R2],R0,FCMATRIX.WILKINSON.$T5+8
	PUSHAO	FCMATRIX.WILKINSON.$T5
	CALLS	#1,G^MTH$CGABS
	MOVG	R0,FCMATRIX.WILKINSON.$T6
	SUBG3	FCMATRIX.WILKINSON.R,FCMATRIX.WILKINSON.M,R0
	SUBG3	@FCMATRIX.WILKINSON.D(AP),R0,FCMATRIX.WILKINSON.$T4
	SUBG3	FCMATRIX.WILKINSON.R+8,FCMATRIX.WILKINSON.M+8,R0
	MOVL	#1,R2
	SUBG3	@FCMATRIX.WILKINSON.D(AP)[R2],R0,FCMATRIX.WILKINSON.$T4+8
	PUSHAO	FCMATRIX.WILKINSON.$T4
	CALLS	#1,G^MTH$CGABS
	MOVG	R0,R6
	CMPG	FCMATRIX.WILKINSON.$T6,R6
	BGTR	FCMATRIX.WILKINSON.$1
; 1504        wilkinson = m + r
	ADDG3	FCMATRIX.WILKINSON.M,FCMATRIX.WILKINSON.R,R6
	MOVL	#1,R0
	ADDG3	FCMATRIX.WILKINSON.M+8,FCMATRIX.WILKINSON.R+8,@FCMATRIX.WILKINSON.WILKINSON(AP)[R0]
	MOVG	R6,@FCMATRIX.WILKINSON.WILKINSON(AP)
; 1505      else
	RET
FCMATRIX.WILKINSON.$1:
; 1506        wilkinson = m - r
	SUBG3	FCMATRIX.WILKINSON.R,FCMATRIX.WILKINSON.M,R6
	MOVL	#1,R0
	SUBG3	FCMATRIX.WILKINSON.R+8,FCMATRIX.WILKINSON.M+8,@FCMATRIX.WILKINSON.WILKINSON(AP)[R0]
	MOVG	R6,@FCMATRIX.WILKINSON.WILKINSON(AP)
; 1507      end if
; 1508    end function wilkinson
	RET
; 1509  end module fcmatrix

	.END
