;  700      end if
FCMATRIX.MATRIX_POWER.$21:
;  701
;  702      started = .false.
	CLRL	FCMATRIX.MATRIX_POWER.STARTED
;  703      do
	MOVL	FCMATRIX.MATRIX_POWER.Q(AP),R6
	MOVL	FCMATRIX.MATRIX_POWER.K,R8
