FCMATRIX.KRON_ELEMENTS.$67:
;  410        q = array_of(z)
	MOVAO	@FCMATRIX.KRON_ELEMENTS.Z+4,FCMATRIX.KRON_ELEMENTS.$D1+4
	MOVL	#16,FCMATRIX.KRON_ELEMENTS.$D1+20
	MOVL	#1,FCMATRIX.KRON_ELEMENTS.$D1+28
