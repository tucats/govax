;   Q     TYPE(QUANTITY)              hidden argument 1  @FCMATRIX.TRACE_OF.Q(AP)
;   A     TYPE(QUANTITY), INTENT(IN)  argument 2         @FCMATRIX.TRACE_OF.A(AP)
;   S     COMPLEX*16                  $LOCAL+0           FCMATRIX.TRACE_OF.S
;   K     INTEGER                     $LOCAL+16          FCMATRIX.TRACE_OF.K
;   ERR   INTEGER                     $LOCAL+20          FCMATRIX.TRACE_OF.ERR
;   R6 is $T1: temporary
;   R8 is $L1: DO (line 431)'s limit
;   R7 is $R1: A's address
;
FCMATRIX.TRACE_OF.Q = 4			; Q's value goes through hidden argument 1
FCMATRIX.TRACE_OF.A = 8			; A is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCMATRIX.TRACE_OF.S:
	.BLKL	4			; S
FCMATRIX.TRACE_OF.K:
	.BLKL	1			; K
FCMATRIX.TRACE_OF.ERR:
