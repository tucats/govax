; Storage map for FCMATRIX.ROTATION, a subroutine
;   A     COMPLEX*16, INTENT(IN)   argument 1  @FCMATRIX.ROTATION.A(AP)
;   B     COMPLEX*16, INTENT(IN)   argument 2  @FCMATRIX.ROTATION.B(AP)
;   C     REAL*8, INTENT(OUT)      argument 3  @FCMATRIX.ROTATION.C(AP)
;   S     COMPLEX*16, INTENT(OUT)  argument 4  @FCMATRIX.ROTATION.S(AP)
;   AA    REAL*8                   $LOCAL+0    FCMATRIX.ROTATION.AA
;   R     REAL*8                   $LOCAL+8    FCMATRIX.ROTATION.R
;   R6 is $T1: temporary
;   R6 is $T2: temporary
;
FCMATRIX.ROTATION.A = 4			; A is argument 1
FCMATRIX.ROTATION.B = 8			; B is argument 2
FCMATRIX.ROTATION.C = 12		; C is argument 3
FCMATRIX.ROTATION.S = 16		; S is argument 4

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCMATRIX.ROTATION.AA:
	.BLKL	2			; AA
FCMATRIX.ROTATION.R:
	.BLKL	2			; R
FCMATRIX.ROTATION.$T3:
	.BLKL	2			; temporary
FCMATRIX.ROTATION.$T4:
	.BLKL	4			; temporary
FCMATRIX.ROTATION.$T5:
	.BLKL	4			; temporary
FCMATRIX.ROTATION.$T6:
	.BLKL	4			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCMATRIX.ROTATION.$KF1:
	.LONG	^X00004010,^X00000000	; 1D0
FCMATRIX.ROTATION.$KF2:
	.LONG	^X00004010,^X00000000,^X00000000,^X00000000 ; (1D0, 0D0)
FCMATRIX.ROTATION.$KF3:
	.LONG	^X00000000,^X00000000	; 0D0

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
; 1471
; 1472    ! ROTATION is the plane rotation G = [c, s; -conj(s), c], c real, with
; 1473    ! G [a; b] = [r; 0]: c = |a| / r, s = (a / |a|) conj(b) / r, where
; 1474    ! r = sqrt(|a|**2 + |b|**2).
; 1475    subroutine rotation(a, b, c, s)
	.ENTRY	FCMATRIX.ROTATION,^M<R2,R3,R6,R7>
; 1476      complex(rk), intent(in) :: a, b
; 1477      real(rk), intent(out) :: c
; 1478      complex(rk), intent(out) :: s
; 1479      real(rk) :: aa, r
; 1480
; 1481      if (b == (0.0_rk, 0.0_rk)) then
	TSTG	@FCMATRIX.ROTATION.B(AP)
	BNEQ	FCMATRIX.ROTATION.$1
	MOVL	#1,R0
	TSTG	@FCMATRIX.ROTATION.B(AP)[R0]
	BNEQ	FCMATRIX.ROTATION.$1
; 1482        c = 1
	MOVG	FCMATRIX.ROTATION.$KF1,@FCMATRIX.ROTATION.C(AP) ; 1D0
; 1483        s = (0.0_rk, 0.0_rk)
	CLRO	@FCMATRIX.ROTATION.S(AP)
; 1484      else if (a == (0.0_rk, 0.0_rk)) then
	RET
FCMATRIX.ROTATION.$1:
	TSTG	@FCMATRIX.ROTATION.A(AP)
	BNEQ	FCMATRIX.ROTATION.$5
	MOVL	#1,R0
	TSTG	@FCMATRIX.ROTATION.A(AP)[R0]
	BNEQ	FCMATRIX.ROTATION.$5
; 1485        c = 0
	CLRG	@FCMATRIX.ROTATION.C(AP)
; 1486        s = (1.0_rk, 0.0_rk)
	MOVO	FCMATRIX.ROTATION.$KF2,@FCMATRIX.ROTATION.S(AP) ; (1D0, 0D0)
; 1487      else
	RET
FCMATRIX.ROTATION.$5:
; 1488        aa = abs(a)
	PUSHAO	@FCMATRIX.ROTATION.A(AP)
	CALLS	#1,G^MTH$CGABS
	MOVG	R0,R6
	MOVG	R6,FCMATRIX.ROTATION.AA
; 1489        r = sqrt(aa ** 2 + abs(b) ** 2)
	PUSHAO	@FCMATRIX.ROTATION.B(AP)
	CALLS	#1,G^MTH$CGABS
	MOVG	R0,R6
	MULG3	FCMATRIX.ROTATION.AA,FCMATRIX.ROTATION.AA,R0
	MULG3	R6,R6,R2
	ADDG3	R0,R2,FCMATRIX.ROTATION.$T3
	PUSHAG	FCMATRIX.ROTATION.$T3
	CALLS	#1,G^MTH$GSQRT
	MOVG	R0,R6
	MOVG	R6,FCMATRIX.ROTATION.R
; 1490        c = aa / r
	DIVG3	FCMATRIX.ROTATION.R,FCMATRIX.ROTATION.AA,@FCMATRIX.ROTATION.C(AP)
; 1491        s = (a / aa) * conjg(b) / r
	MOVQ	FCMATRIX.ROTATION.$KF3,-(SP)
	MOVQ	FCMATRIX.ROTATION.AA,-(SP)
	MOVL	#1,R0
	MOVQ	@FCMATRIX.ROTATION.A(AP)[R0],-(SP)
	MOVQ	@FCMATRIX.ROTATION.A(AP),-(SP)
	CALLS	#8,G^OTS$DIVCG_R3
	MOVO	R0,FCMATRIX.ROTATION.$T4
	MOVL	#1,R0
	MNEGG	@FCMATRIX.ROTATION.B(AP)[R0],R0
	MOVQ	R0,-(SP)
	MOVQ	@FCMATRIX.ROTATION.B(AP),-(SP)
	MOVQ	FCMATRIX.ROTATION.$T4+8,-(SP)
	MOVQ	FCMATRIX.ROTATION.$T4,-(SP)
	CALLS	#8,G^OTS$MULCG_R3
	MOVO	R0,FCMATRIX.ROTATION.$T5
	MOVQ	FCMATRIX.ROTATION.$KF3,-(SP)
	MOVQ	FCMATRIX.ROTATION.R,-(SP)
	MOVQ	FCMATRIX.ROTATION.$T5+8,-(SP)
	MOVQ	FCMATRIX.ROTATION.$T5,-(SP)
	CALLS	#8,G^OTS$DIVCG_R3
	MOVO	R0,FCMATRIX.ROTATION.$T6
	MOVG	FCMATRIX.ROTATION.$T6,@FCMATRIX.ROTATION.S(AP)
	MOVL	#1,R0
	MOVG	FCMATRIX.ROTATION.$T6+8,@FCMATRIX.ROTATION.S(AP)[R0]
; 1492      end if
; 1493    end subroutine rotation
	RET

