;  673      if (.not. square(a)) then
	PUSHAB	@FCMATRIX.MATRIX_POWER.A(AP)
	CALLS	#1,G^FCMATRIX.SQUARE
	MOVL	R0,R7
	BLBS	R7,FCMATRIX.MATRIX_POWER.$1
;  674        q = failure(e_notsquare)
