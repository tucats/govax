FCMATRIX.TRACE_OF.$T2:
	.BLKL	24			; characters, for one statement
FCMATRIX.TRACE_OF.$T3:
	.BLKL	4			; temporary
FCMATRIX.TRACE_OF.$T4:
	.BLKL	8			; characters, for one statement

