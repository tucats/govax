	MOVL	R8,FCMATRIX.KRON_ELEMENTS.L
FCMATRIX.KRON_ELEMENTS.$54:
;  406      end do
	ACBL	FCMATRIX.KRON_ELEMENTS.$L1,#1,FCMATRIX.KRON_ELEMENTS.J,FCMATRIX.KRON_ELEMENTS.$49
	MOVL	R11,FCMATRIX.KRON_ELEMENTS.I
FCMATRIX.KRON_ELEMENTS.$47:
