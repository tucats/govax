	PUSHAG	FCMATRIX.MATRIX_POWER.X
	PUSHAB	@FCMATRIX.MATRIX_POWER.B(AP)
	CALLS	#3,G^FCMATRIX.REAL_SCALAR
	MOVL	R0,R7
	BLBS	R7,FCMATRIX.MATRIX_POWER.$3
