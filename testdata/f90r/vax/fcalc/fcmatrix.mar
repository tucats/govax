;  513
;  514    ! DETERMINANT is det(A): U's diagonal multiplied, times P's sign; 0 for a
;  515    ! singular matrix.
;  516    function determinant(a) result(q)
	.ENTRY	FCMATRIX.DETERMINANT,^M<R2,R3,R4,R5,R6,R7,R8>
;  517      type(quantity), intent(in) :: a
;  518      type(quantity) :: q
;  519
;  520      if (.not. square(a)) then
	PUSHAB	@FCMATRIX.DETERMINANT.A(AP)
	CALLS	#1,G^FCMATRIX.SQUARE
	MOVL	R0,R8
	BLBS	R8,FCMATRIX.DETERMINANT.$1
;  521        q = failure(e_notsquare)
	PUSHAL	FCMATRIX.DETERMINANT.$K1
	PUSHAB	FCMATRIX.DETERMINANT.$T2
	CALLS	#2,G^FCARRAYS.FAILURE
	MOVC3	#96,FCMATRIX.DETERMINANT.$T2,@FCMATRIX.DETERMINANT.Q(AP)
;  522      else if (.not. is_array(a)) then
	RET
FCMATRIX.DETERMINANT.$1:
	PUSHAB	@FCMATRIX.DETERMINANT.A(AP)
	CALLS	#1,G^FCARRAYS.IS_ARRAY
	MOVL	R0,R8
	BLBS	R8,FCMATRIX.DETERMINANT.$4
;  523        q = scalar_quantity(a%s)
	MOVL	FCMATRIX.DETERMINANT.A(AP),R0
	PUSHAB	16(R0)
	PUSHAB	FCMATRIX.DETERMINANT.$T2
	CALLS	#2,G^FCARRAYS.SCALAR_QUANTITY
	MOVC3	#96,FCMATRIX.DETERMINANT.$T2,@FCMATRIX.DETERMINANT.Q(AP)
;  524      else
	RET
FCMATRIX.DETERMINANT.$4:
;  525        q = lu_determinant(a%e, a%rows)
	MOVL	FCMATRIX.DETERMINANT.A(AP),R0
	MOVAL	48(R0),R8
	MOVL	SP,FCMATRIX.DETERMINANT.$T5 ; where the statement's storage starts
	MOVZWL	(R8),R0
	CMPL	20(R8),R0
	BNEQ	FCMATRIX.DETERMINANT.$6
	SUBL3	28(R8),32(R8),R0
	INCL	R0
	MULL2	20(R8),R0
	CMPL	24(R8),R0
	BNEQ	FCMATRIX.DETERMINANT.$9
	BRW	FCMATRIX.DETERMINANT.$8
