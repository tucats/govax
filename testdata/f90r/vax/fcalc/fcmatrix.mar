;  346    ! left, the first ones coming round to the end: CSHIFT(u, 1) is
;  347    ! (u2, u3, u1), so the product is CSHIFT(u, 1) CSHIFT(v, 2) - CSHIFT(u, 2)
;  348    ! CSHIFT(v, 1), element by element.
