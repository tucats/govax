;  580
;  581    ! INVERSE_TRIG: a real argument in the real domain has the real inverse;
;  582    ! any other the principal value of
;  583    !     asin z = -i ln(iz + sqrt(1 - z**2))
;  584    !     acos z = pi/2 - asin z
;  585    !     atan z = (i/2) ln((i + z) / (i - z))
;  586    function inverse_trig(name, a) result(v)
	.ENTRY	FCFUNCS.INVERSE_TRIG,^M<R2,R3,R4,R5,R6,R7>
;  587      character(len=*), intent(in) :: name
;  588      type(value), intent(in) :: a
;  589      type(value) :: v
;  590      type(value) :: i, one
;  591      real(rk) :: x
;  592
;  593      x = real(a%z, rk)
	MOVG	@FCFUNCS.INVERSE_TRIG.A(AP),FCFUNCS.INVERSE_TRIG.X
;  594      i = complex_value(0.0_rk, 1.0_rk)
	PUSHAG	FCFUNCS.INVERSE_TRIG.$K2
	PUSHAG	FCFUNCS.INVERSE_TRIG.$K1
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T1
	CALLS	#3,G^FCVALUES.COMPLEX_VALUE
	MOVC3	#32,FCFUNCS.INVERSE_TRIG.$T1,FCFUNCS.INVERSE_TRIG.I
;  595      one = real_value(1.0_rk)
	PUSHAG	FCFUNCS.INVERSE_TRIG.$K2
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T1
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCFUNCS.INVERSE_TRIG.$T1,FCFUNCS.INVERSE_TRIG.ONE
;  596
;  597      if (is_real(a) .and. (abs(x) <= 1 .or. name == 'atan')) then
	PUSHAB	@FCFUNCS.INVERSE_TRIG.A(AP)
	CALLS	#1,G^FCVALUES.IS_REAL
	MOVL	R0,R6
	MOVG	FCFUNCS.INVERSE_TRIG.X,FCFUNCS.INVERSE_TRIG.$T3
	BGEQ	FCFUNCS.INVERSE_TRIG.$1
	MNEGG	FCFUNCS.INVERSE_TRIG.$T3,FCFUNCS.INVERSE_TRIG.$T3
FCFUNCS.INVERSE_TRIG.$1:
	BLBS	R6,FCFUNCS.INVERSE_TRIG.$4
	BRW	FCFUNCS.INVERSE_TRIG.$3
FCFUNCS.INVERSE_TRIG.$4:
	CMPG	FCFUNCS.INVERSE_TRIG.$T3,S^#1.0
	BLEQ	FCFUNCS.INVERSE_TRIG.$5
	MOVZWL	@FCFUNCS.INVERSE_TRIG.NAME(AP),R0
	MOVL	FCFUNCS.INVERSE_TRIG.NAME(AP),R1
	CMPC5	R0,@4(R1),#^A/ /,#4,FCFUNCS.INVERSE_TRIG.$K3
	BEQL	FCFUNCS.INVERSE_TRIG.$7
	BRW	FCFUNCS.INVERSE_TRIG.$3
FCFUNCS.INVERSE_TRIG.$7:
FCFUNCS.INVERSE_TRIG.$5:
;  598        select case (name)
	MOVL	FCFUNCS.INVERSE_TRIG.NAME(AP),R0
	MOVAB	@4(R0),R6
	MOVZWL	@FCFUNCS.INVERSE_TRIG.NAME(AP),R7
	CMPC5	R7,(R6),#^A/ /,#4,FCFUNCS.INVERSE_TRIG.$K4
	BEQL	FCFUNCS.INVERSE_TRIG.$8
	CMPC5	R7,(R6),#^A/ /,#4,FCFUNCS.INVERSE_TRIG.$K5
	BNEQ	FCFUNCS.INVERSE_TRIG.$12
	BRB	FCFUNCS.INVERSE_TRIG.$10
FCFUNCS.INVERSE_TRIG.$8:
;  599        case ('asin')
;  600          v = real_value(asin(x))
	PUSHAG	FCFUNCS.INVERSE_TRIG.X
	CALLS	#1,G^MTH$GASIN
	MOVG	R0,FCFUNCS.INVERSE_TRIG.$T3
	PUSHAG	FCFUNCS.INVERSE_TRIG.$T3
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T1
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCFUNCS.INVERSE_TRIG.$T1,@FCFUNCS.INVERSE_TRIG.V(AP)
;  601        case ('acos')
	BRW	FCFUNCS.INVERSE_TRIG.$14
FCFUNCS.INVERSE_TRIG.$10:
;  602          v = real_value(acos(x))
	PUSHAG	FCFUNCS.INVERSE_TRIG.X
	CALLS	#1,G^MTH$GACOS
	MOVG	R0,FCFUNCS.INVERSE_TRIG.$T3
	PUSHAG	FCFUNCS.INVERSE_TRIG.$T3
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T1
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCFUNCS.INVERSE_TRIG.$T1,@FCFUNCS.INVERSE_TRIG.V(AP)
;  603        case default
	BRW	FCFUNCS.INVERSE_TRIG.$14
FCFUNCS.INVERSE_TRIG.$12:
;  604          v = real_value(atan(x))
	PUSHAG	FCFUNCS.INVERSE_TRIG.X
	CALLS	#1,G^MTH$GATAN
	MOVG	R0,FCFUNCS.INVERSE_TRIG.$T3
	PUSHAG	FCFUNCS.INVERSE_TRIG.$T3
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T1
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCFUNCS.INVERSE_TRIG.$T1,@FCFUNCS.INVERSE_TRIG.V(AP)
;  605        end select
;  606      else
	BRW	FCFUNCS.INVERSE_TRIG.$14
FCFUNCS.INVERSE_TRIG.$3:
;  607        select case (name)
	MOVL	FCFUNCS.INVERSE_TRIG.NAME(AP),R0
	MOVAB	@4(R0),R7
	MOVZWL	@FCFUNCS.INVERSE_TRIG.NAME(AP),R6
	CMPC5	R6,(R7),#^A/ /,#4,FCFUNCS.INVERSE_TRIG.$K4
	BEQL	FCFUNCS.INVERSE_TRIG.$15
	CMPC5	R6,(R7),#^A/ /,#4,FCFUNCS.INVERSE_TRIG.$K5
	BEQL	FCFUNCS.INVERSE_TRIG.$15
	BRW	FCFUNCS.INVERSE_TRIG.$18
FCFUNCS.INVERSE_TRIG.$15:
;  608        case ('asin', 'acos')
;  609          v = -i * ln_value(i * a + sqrt_value(one - a * a))
	PUSHAB	@FCFUNCS.INVERSE_TRIG.A(AP)
	PUSHAB	FCFUNCS.INVERSE_TRIG.I
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T8
	CALLS	#3,G^FCVALUES.V_MUL
	PUSHAB	@FCFUNCS.INVERSE_TRIG.A(AP)
	PUSHAB	@FCFUNCS.INVERSE_TRIG.A(AP)
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T11
	CALLS	#3,G^FCVALUES.V_MUL
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T11
	PUSHAB	FCFUNCS.INVERSE_TRIG.ONE
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T10
	CALLS	#3,G^FCVALUES.V_SUB
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T10
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T9
	CALLS	#2,G^FCFUNCS.SQRT_VALUE
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T9
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T8
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T7
	CALLS	#3,G^FCVALUES.V_ADD
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T7
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T6
	CALLS	#2,G^FCFUNCS.LN_VALUE
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T6
	PUSHAB	FCFUNCS.INVERSE_TRIG.I
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T5
	CALLS	#3,G^FCVALUES.V_MUL
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T5
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T1
	CALLS	#2,G^FCVALUES.V_NEG
	MOVC3	#32,FCFUNCS.INVERSE_TRIG.$T1,@FCFUNCS.INVERSE_TRIG.V(AP)
;  610          if (name == 'acos' .and. v%err == 0) v = real_value(pi / 2) - v
	MOVZWL	@FCFUNCS.INVERSE_TRIG.NAME(AP),R0
	MOVL	FCFUNCS.INVERSE_TRIG.NAME(AP),R1
	CMPC5	R0,@4(R1),#^A/ /,#4,FCFUNCS.INVERSE_TRIG.$K5
	BNEQ	FCFUNCS.INVERSE_TRIG.$19
	MOVL	FCFUNCS.INVERSE_TRIG.V(AP),R0
	TSTL	16(R0)
	BNEQ	FCFUNCS.INVERSE_TRIG.$19
	PUSHAG	FCFUNCS.INVERSE_TRIG.$K6
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T10
	CALLS	#2,G^FCVALUES.REAL_VALUE
	PUSHAB	@FCFUNCS.INVERSE_TRIG.V(AP)
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T10
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T11
	CALLS	#3,G^FCVALUES.V_SUB
	MOVC3	#32,FCFUNCS.INVERSE_TRIG.$T11,@FCFUNCS.INVERSE_TRIG.V(AP)
FCFUNCS.INVERSE_TRIG.$19:
;  611        case default
	BRW	FCFUNCS.INVERSE_TRIG.$22
FCFUNCS.INVERSE_TRIG.$18:
;  612          if (a%z == (0.0_rk, 1.0_rk) .or. a%z == (0.0_rk, -1.0_rk)) then
	TSTG	@FCFUNCS.INVERSE_TRIG.A(AP)
	BNEQ	FCFUNCS.INVERSE_TRIG.$25
	MOVL	FCFUNCS.INVERSE_TRIG.A(AP),R0
	CMPG	8(R0),S^#1.0
	BEQL	FCFUNCS.INVERSE_TRIG.$24
FCFUNCS.INVERSE_TRIG.$25:
	TSTG	@FCFUNCS.INVERSE_TRIG.A(AP)
	BNEQ	FCFUNCS.INVERSE_TRIG.$23
	MOVL	FCFUNCS.INVERSE_TRIG.A(AP),R0
	CMPG	8(R0),FCFUNCS.INVERSE_TRIG.$KF1
	BNEQ	FCFUNCS.INVERSE_TRIG.$23
FCFUNCS.INVERSE_TRIG.$24:
;  613            v = error_value(e_domain)
	PUSHAL	FCFUNCS.INVERSE_TRIG.$K7
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T10
	CALLS	#2,G^FCVALUES.ERROR_VALUE
	MOVC3	#32,FCFUNCS.INVERSE_TRIG.$T10,@FCFUNCS.INVERSE_TRIG.V(AP)
;  614          else
	BRW	FCFUNCS.INVERSE_TRIG.$30
FCFUNCS.INVERSE_TRIG.$23:
;  615            v = complex_value(0.0_rk, 0.5_rk) * ln_value((i + a) / (i - a))
	PUSHAG	FCFUNCS.INVERSE_TRIG.$K8
	PUSHAG	FCFUNCS.INVERSE_TRIG.$K1
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T11
	CALLS	#3,G^FCVALUES.COMPLEX_VALUE
	PUSHAB	@FCFUNCS.INVERSE_TRIG.A(AP)
	PUSHAB	FCFUNCS.INVERSE_TRIG.I
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T7
	CALLS	#3,G^FCVALUES.V_ADD
	PUSHAB	@FCFUNCS.INVERSE_TRIG.A(AP)
	PUSHAB	FCFUNCS.INVERSE_TRIG.I
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T6
	CALLS	#3,G^FCVALUES.V_SUB
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T6
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T7
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T8
	CALLS	#3,G^FCVALUES.V_DIV
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T8
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T9
	CALLS	#2,G^FCFUNCS.LN_VALUE
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T9
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T11
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T10
	CALLS	#3,G^FCVALUES.V_MUL
	MOVC3	#32,FCFUNCS.INVERSE_TRIG.$T10,@FCFUNCS.INVERSE_TRIG.V(AP)
;  616          end if
FCFUNCS.INVERSE_TRIG.$30:
;  617        end select
FCFUNCS.INVERSE_TRIG.$22:
;  618      end if
FCFUNCS.INVERSE_TRIG.$14:
;  619      v = from_radians(v)
	PUSHAB	@FCFUNCS.INVERSE_TRIG.V(AP)
	PUSHAB	FCFUNCS.INVERSE_TRIG.$T6
	CALLS	#2,G^FCFUNCS.FROM_RADIANS
	MOVC3	#32,FCFUNCS.INVERSE_TRIG.$T6,@FCFUNCS.INVERSE_TRIG.V(AP)
