	CALLS	#3,G^FCVALUES.COMPLEX_VALUE
	MOVC3	#32,FCFUNCS.TRIG.$T3,FCFUNCS.TRIG.C
;  563      end if
FCFUNCS.TRIG.$5:
;  564
;  565      select case (name)
	MOVL	FCFUNCS.TRIG.NAME(AP),R0
	MOVAB	@4(R0),R6
	MOVZWL	@FCFUNCS.TRIG.NAME(AP),R7
