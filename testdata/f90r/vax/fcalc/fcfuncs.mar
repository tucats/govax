	PUSHAB	FCFUNCS.FACTORIAL_VALUE.$T2
	CALLS	#2,G^FCVALUES.V_FACTORIAL
	MOVC3	#32,FCFUNCS.FACTORIAL_VALUE.$T2,@FCFUNCS.FACTORIAL_VALUE.V(AP)
; 1003      else
	RET
FCFUNCS.FACTORIAL_VALUE.$3:
; 1004        v = gamma_value(x + 1)
	ADDG3	FCFUNCS.FACTORIAL_VALUE.X,S^#1.0,FCFUNCS.FACTORIAL_VALUE.$T3
	PUSHAG	FCFUNCS.FACTORIAL_VALUE.$T3
	PUSHAB	FCFUNCS.FACTORIAL_VALUE.$T2
	CALLS	#2,G^FCFUNCS.GAMMA_VALUE
	MOVC3	#32,FCFUNCS.FACTORIAL_VALUE.$T2,@FCFUNCS.FACTORIAL_VALUE.V(AP)
; 1005      end if
; 1006    end function factorial_value
	RET

; Storage map for FCFUNCS.SPECIAL, a TYPE(VALUE) function
;   V     TYPE(VALUE)                hidden argument 1  @FCFUNCS.SPECIAL.V(AP)
;   NAME  CHARACTER*(*), INTENT(IN)  argument 2         @FCFUNCS.SPECIAL.NAME(AP)
;   A     TYPE(VALUE), INTENT(IN)    argument 3         @FCFUNCS.SPECIAL.A(AP)
;   X     REAL*8                     $LOCAL+0           FCFUNCS.SPECIAL.X
;   R6 is $T1: temporary
;   R7 is $T2: temporary
;
FCFUNCS.SPECIAL.V = 4			; V's value goes through hidden argument 1
FCFUNCS.SPECIAL.NAME = 8		; NAME is argument 2
FCFUNCS.SPECIAL.A = 12			; A is argument 3

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCFUNCS.SPECIAL.X:
	.BLKL	2			; X
FCFUNCS.SPECIAL.$T3:
	.BLKL	8			; characters, for one statement
FCFUNCS.SPECIAL.$T4:
	.BLKL	2			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCFUNCS.SPECIAL.$K1:
	.ASCII	/gamma/
FCFUNCS.SPECIAL.$K2:
	.ASCII	/lgamma/
FCFUNCS.SPECIAL.$K3:
	.ASCII	/erf/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
; 1007
; 1008    function special(name, a) result(v)
	.ENTRY	FCFUNCS.SPECIAL,^M<R2,R3,R4,R5,R6,R7>
; 1009      character(len=*), intent(in) :: name
; 1010      type(value), intent(in) :: a
; 1011      type(value) :: v
; 1012      real(rk) :: x
; 1013
; 1014      if (.not. real_argument(a, x, v)) return
	PUSHAB	@FCFUNCS.SPECIAL.V(AP)
	PUSHAG	FCFUNCS.SPECIAL.X
	PUSHAB	@FCFUNCS.SPECIAL.A(AP)
	CALLS	#3,G^FCFUNCS.REAL_ARGUMENT
	MOVL	R0,R6
	BLBS	R6,FCFUNCS.SPECIAL.$1
	RET
FCFUNCS.SPECIAL.$1:
; 1015      select case (name)
	MOVL	FCFUNCS.SPECIAL.NAME(AP),R0
	MOVAB	@4(R0),R6
	MOVZWL	@FCFUNCS.SPECIAL.NAME(AP),R7
	CMPC5	R7,(R6),#^A/ /,#5,FCFUNCS.SPECIAL.$K1
	BEQL	FCFUNCS.SPECIAL.$3
	CMPC5	R7,(R6),#^A/ /,#6,FCFUNCS.SPECIAL.$K2
	BEQL	FCFUNCS.SPECIAL.$5
	CMPC5	R7,(R6),#^A/ /,#3,FCFUNCS.SPECIAL.$K3
	BNEQ	FCFUNCS.SPECIAL.$9
	BRB	FCFUNCS.SPECIAL.$7
FCFUNCS.SPECIAL.$3:
; 1016      case ('gamma')
; 1017        v = gamma_value(x)
	PUSHAG	FCFUNCS.SPECIAL.X
	PUSHAB	FCFUNCS.SPECIAL.$T3
	CALLS	#2,G^FCFUNCS.GAMMA_VALUE
	MOVC3	#32,FCFUNCS.SPECIAL.$T3,@FCFUNCS.SPECIAL.V(AP)
; 1018      case ('lgamma')
	RET
FCFUNCS.SPECIAL.$5:
; 1019        v = lgamma_value(x)
	PUSHAG	FCFUNCS.SPECIAL.X
	PUSHAB	FCFUNCS.SPECIAL.$T3
	CALLS	#2,G^FCFUNCS.LGAMMA_VALUE
	MOVC3	#32,FCFUNCS.SPECIAL.$T3,@FCFUNCS.SPECIAL.V(AP)
; 1020      case ('erf')
	RET
FCFUNCS.SPECIAL.$7:
; 1021        v = real_value(erf_real(x))
	PUSHAG	FCFUNCS.SPECIAL.X
	CALLS	#1,G^FCFUNCS.ERF_REAL
	MOVG	R0,FCFUNCS.SPECIAL.$T4
	PUSHAG	FCFUNCS.SPECIAL.$T4
	PUSHAB	FCFUNCS.SPECIAL.$T3
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCFUNCS.SPECIAL.$T3,@FCFUNCS.SPECIAL.V(AP)
; 1022      case default
	RET
FCFUNCS.SPECIAL.$9:
; 1023        v = real_value(erfc_real(x))
	PUSHAG	FCFUNCS.SPECIAL.X
	CALLS	#1,G^FCFUNCS.ERFC_REAL
	MOVG	R0,FCFUNCS.SPECIAL.$T4
	PUSHAG	FCFUNCS.SPECIAL.$T4
	PUSHAB	FCFUNCS.SPECIAL.$T3
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCFUNCS.SPECIAL.$T3,@FCFUNCS.SPECIAL.V(AP)
; 1024      end select
; 1025    end function special
	RET

; Storage map for FCFUNCS.LANCZOS_LOG, a REAL*8 function
;   X            REAL*8, INTENT(IN)  argument 1  @FCFUNCS.LANCZOS_LOG.X(AP)
;   LANCZOS_LOG  REAL*8              $LOCAL+0    FCFUNCS.LANCZOS_LOG.LANCZOS_LOG
;   Y            REAL*8              $LOCAL+8    FCFUNCS.LANCZOS_LOG.Y
;   A            REAL*8              $LOCAL+16   FCFUNCS.LANCZOS_LOG.A
;   T            REAL*8              $LOCAL+24   FCFUNCS.LANCZOS_LOG.T
;   K            INTEGER             $LOCAL+32   FCFUNCS.LANCZOS_LOG.K
;   R6 is $R1: K, during a loop
;   R7 is $R2: A, during a loop
;   R9 is $R3: Y, during a loop
;
FCFUNCS.LANCZOS_LOG.X = 4		; X is argument 1

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCFUNCS.LANCZOS_LOG.LANCZOS_LOG:
	.BLKL	2			; LANCZOS_LOG, the function's value
FCFUNCS.LANCZOS_LOG.Y:
	.BLKL	2			; Y
FCFUNCS.LANCZOS_LOG.A:
	.BLKL	2			; A
FCFUNCS.LANCZOS_LOG.T:
	.BLKL	2			; T
FCFUNCS.LANCZOS_LOG.K:
	.BLKL	1			; K
FCFUNCS.LANCZOS_LOG.$T1:
	.BLKL	2			; temporary
FCFUNCS.LANCZOS_LOG.$T2:
	.BLKL	2			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCFUNCS.LANCZOS_LOG.$K1:
	.LONG	^XFFFF400F,^XF950FFFF,^X242940A5,^X0B05B6C3,^XAC8EC0B3,^X171B8ED4,^X1A9640A8,^XB4D861D3
	.LONG	^X13AEC086,^X2F5D51A3,^X03C24049,^X9C817F8B,^XBCB2BFE1,^X2855992B,^XF0513F04,^X324F4E4E
	.LONG	^X35503EA4,^XAEEF8F3F
FCFUNCS.LANCZOS_LOG.$KF1:
	.LONG	^XFFFF400F,^XF950FFFF	; 0.9999999999998099D0
FCFUNCS.LANCZOS_LOG.$KF2:
	.LONG	^X67F1400D,^XBEB5C864	; 0.9189385332046728D0

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
; 1026
; 1027    ! LANCZOS_LOG is LOG(GAMMA(X)) for X from 0.5 up, by Lanczos's formula
; 1028    !     gamma(y + 1) = sqrt(2 pi) t**(y + 1/2) e**-t A(y),  t = y + g + 1/2
; 1029    ! in logarithms, so it never overflows.
; 1030    !
; 1031    ! The gamma function extends the factorial to real numbers: gamma(n + 1)
; 1032    ! = n!, and gamma(1/2) = sqrt(pi). Lanczos's approximation is Stirling's
; 1033    ! formula (the t**(y+1/2) e**-t part) times a correction A(y), a short sum
; 1034    ! of fractions c(k) / (y + k) whose coefficients were fitted once (with
; 1035    ! g = 7 and nine terms they give about 15 digits); they are the widely
; 1036    ! published values. Its error is relative, so a value far from 1 is still
; 1037    ! good to its 15th digit, but LOG(GAMMA(x)) near x = 1 or 2, where it is
; 1038    ! near 0, is only as good as that absolute error: lgamma gives exact 0s
; 1039    ! at 1 and 2 for that reason.
; 1040    real(rk) function lanczos_log(x)
	.ENTRY	FCFUNCS.LANCZOS_LOG,^M<R6,R7,R8,R9,R10>
; 1041      real(rk), intent(in) :: x
; 1042      real(rk) :: y, a, t
; 1043      integer :: k
; 1044
; 1045      y = x - 1
	SUBG3	S^#1.0,@FCFUNCS.LANCZOS_LOG.X(AP),FCFUNCS.LANCZOS_LOG.Y
; 1046      a = lanczos(0)
	MOVG	FCFUNCS.LANCZOS_LOG.$KF1,FCFUNCS.LANCZOS_LOG.A ; 0.9999999999998099D0
; 1047      do k = 1, 8
	MOVL	#1,FCFUNCS.LANCZOS_LOG.K
	MOVL	FCFUNCS.LANCZOS_LOG.K,R6
	MOVQ	FCFUNCS.LANCZOS_LOG.A,R7
	MOVQ	FCFUNCS.LANCZOS_LOG.Y,R9
FCFUNCS.LANCZOS_LOG.$1:			; DO (line 1047)'s body
; 1048        a = a + lanczos(k) / (y + k)
	CVTLG	R6,R0
	ADDG2	R9,R0
	DIVG3	R0,FCFUNCS.LANCZOS_LOG.$K1[R6],R0
	ADDG2	R0,R7
; 1049      end do
	AOBLEQ	#8,R6,FCFUNCS.LANCZOS_LOG.$1
	MOVL	R6,FCFUNCS.LANCZOS_LOG.K
	MOVQ	R7,FCFUNCS.LANCZOS_LOG.A
; 1050      t = y + lanczos_g + 0.5_rk
	ADDG3	FCFUNCS.LANCZOS_LOG.Y,S^#7.0,R0
	ADDG3	R0,S^#0.5,FCFUNCS.LANCZOS_LOG.T
; 1051      lanczos_log = half_log_2pi + (y + 0.5_rk) * log(t) - t + log(a)
	PUSHAG	FCFUNCS.LANCZOS_LOG.T
	CALLS	#1,G^MTH$GLOG
	MOVG	R0,FCFUNCS.LANCZOS_LOG.$T1
	PUSHAG	FCFUNCS.LANCZOS_LOG.A
	CALLS	#1,G^MTH$GLOG
	MOVG	R0,FCFUNCS.LANCZOS_LOG.$T2
; 1052    end function lanczos_log
	ADDG3	FCFUNCS.LANCZOS_LOG.Y,S^#0.5,R0 ; the function's value
	MULG2	FCFUNCS.LANCZOS_LOG.$T1,R0
	ADDG2	FCFUNCS.LANCZOS_LOG.$KF2,R0
	SUBG2	FCFUNCS.LANCZOS_LOG.T,R0
	ADDG2	FCFUNCS.LANCZOS_LOG.$T2,R0
	RET

; Storage map for FCFUNCS.SIN_PI, a REAL*8 function
;   X       REAL*8, INTENT(IN)  argument 1  @FCFUNCS.SIN_PI.X(AP)
;   SIN_PI  REAL*8              $LOCAL+0    FCFUNCS.SIN_PI.SIN_PI
;   R       REAL*8              $LOCAL+8    FCFUNCS.SIN_PI.R
;
FCFUNCS.SIN_PI.X = 4			; X is argument 1

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCFUNCS.SIN_PI.SIN_PI:
	.BLKL	2			; SIN_PI, the function's value
FCFUNCS.SIN_PI.R:
	.BLKL	2			; R
FCFUNCS.SIN_PI.$T1:
	.BLKL	2			; temporary
FCFUNCS.SIN_PI.$T2:
	.BLKL	2			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCFUNCS.SIN_PI.$KF1:
	.LONG	^X0000C000,^X00000000	; -0.5D0
FCFUNCS.SIN_PI.$KF2:
	.LONG	^X0000C010,^X00000000	; -1D0
FCFUNCS.SIN_PI.$KF3:
	.LONG	^X21FB4029,^X2D185444	; 3.141592653589793D0

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
; 1053
; 1054    ! SIN_PI is SIN(PI * X) for a number X that isn't whole, X reduced
; 1055    ! exactly to [-1/2, 1/2] first, so the sine near a whole number keeps its
; 1056    ! digits.
; 1057    real(rk) function sin_pi(x)
	.ENTRY	FCFUNCS.SIN_PI,^M<>
; 1058      real(rk), intent(in) :: x
; 1059      real(rk) :: r
; 1060
; 1061      r = x - 2 * anint(x / 2)
	DIVG3	S^#2.0,@FCFUNCS.SIN_PI.X(AP),FCFUNCS.SIN_PI.$T2
	PUSHAG	FCFUNCS.SIN_PI.$T2
	CALLS	#1,G^MTH$GNINT
	MOVG	R0,FCFUNCS.SIN_PI.$T1
	MULG3	S^#2.0,FCFUNCS.SIN_PI.$T1,R0
	SUBG3	R0,@FCFUNCS.SIN_PI.X(AP),FCFUNCS.SIN_PI.R
; 1062      if (r > 0.5_rk) then
	CMPG	FCFUNCS.SIN_PI.R,S^#0.5
	BLEQ	FCFUNCS.SIN_PI.$1
; 1063        r = 1 - r
	SUBG3	FCFUNCS.SIN_PI.R,S^#1.0,FCFUNCS.SIN_PI.R
; 1064      else if (r < -0.5_rk) then
	BRB	FCFUNCS.SIN_PI.$3
FCFUNCS.SIN_PI.$1:
	CMPG	FCFUNCS.SIN_PI.R,FCFUNCS.SIN_PI.$KF1
	BGEQ	FCFUNCS.SIN_PI.$3
; 1065        r = -1 - r
	SUBG3	FCFUNCS.SIN_PI.R,FCFUNCS.SIN_PI.$KF2,FCFUNCS.SIN_PI.R
; 1066      end if
FCFUNCS.SIN_PI.$3:
; 1067      sin_pi = sin(pi * r)
	MULG3	FCFUNCS.SIN_PI.$KF3,FCFUNCS.SIN_PI.R,FCFUNCS.SIN_PI.$T1
	PUSHAG	FCFUNCS.SIN_PI.$T1
	CALLS	#1,G^MTH$GSIN
	MOVG	R0,FCFUNCS.SIN_PI.$T2
; 1068    end function sin_pi
	MOVG	FCFUNCS.SIN_PI.$T2,R0	; the function's value
	RET

; Storage map for FCFUNCS.GAMMA_VALUE, a RECURSIVE TYPE(VALUE) function
;   V     TYPE(VALUE)         hidden argument 1  @FCFUNCS.GAMMA_VALUE.V(AP)
;   X     REAL*8, INTENT(IN)  argument 2         @FCFUNCS.GAMMA_VALUE.X(AP)
;   S     REAL*8              FP-156             FCFUNCS.GAMMA_VALUE.S(FP)
;   D     REAL*8              FP-148             FCFUNCS.GAMMA_VALUE.D(FP)
;   G     TYPE(VALUE)         FP-140             FCFUNCS.GAMMA_VALUE.G(FP)
;   ERR   INTEGER             FP-108             FCFUNCS.GAMMA_VALUE.ERR(FP)
;   R6 is $T1: temporary
;
FCFUNCS.GAMMA_VALUE.V = 4		; V's value goes through hidden argument 1
FCFUNCS.GAMMA_VALUE.X = 8		; X is argument 2
FCFUNCS.GAMMA_VALUE.S = -156		; S, in the frame
FCFUNCS.GAMMA_VALUE.D = -148		; D, in the frame
FCFUNCS.GAMMA_VALUE.G = -140		; G, in the frame
FCFUNCS.GAMMA_VALUE.ERR = -108		; ERR, in the frame
FCFUNCS.GAMMA_VALUE.$T2 = -104		; temporary, in the frame
FCFUNCS.GAMMA_VALUE.$T3 = -96		; characters, for one statement, in the frame
FCFUNCS.GAMMA_VALUE.$T4 = -64		; characters, for one statement, in the frame
FCFUNCS.GAMMA_VALUE.$T5 = -32		; temporary, in the frame
FCFUNCS.GAMMA_VALUE.$T6 = -24		; temporary, in the frame
FCFUNCS.GAMMA_VALUE.$T7 = -16		; temporary, in the frame
FCFUNCS.GAMMA_VALUE.$T8 = -8		; temporary, in the frame

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCFUNCS.GAMMA_VALUE.$K1:
	.LONG	11
FCFUNCS.GAMMA_VALUE.$K2:
	.LONG	10
FCFUNCS.GAMMA_VALUE.$K3:
	.LONG	^X21FB4029,^X2D185444	; 3.141592653589793D0
FCFUNCS.GAMMA_VALUE.$KF1:
	.LONG	^X6BF5434C,^X00002634	; 4D15
FCFUNCS.GAMMA_VALUE.$KF2:
	.LONG	^X60004085,^X00000000	; 171D0
FCFUNCS.GAMMA_VALUE.$KF3:
	.LONG	^X6BF5C34C,^X00002634	; -4D15
FCFUNCS.GAMMA_VALUE.$KF4:
	.LONG	^X00004084,^X00000000	; 160D0

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
; 1069
; 1070    ! GAMMA_VALUE is the gamma function: a factorial at a whole number, and
; 1071    ! Lanczos's formula elsewhere, below 1/2 through the reflection
; 1072    !     gamma(x) = pi / (sin(pi x) gamma(1 - x))
; 1073    ! The whole numbers from 0 down are its poles (it goes to infinity
; 1074    ! there), out of its domain.
; 1075    !
; 1076    ! The reflection formula carries a value from the left half, where
; 1077    ! Lanczos's sum would divide by numbers near zero, to the right, where it
; 1078    ! is accurate. For 1 - x past 160, gamma(1 - x) is past the machines'
; 1079    ! range though the answer isn't, so the formula is used in logarithms.
; 1080    recursive function gamma_value(x) result(v)
	.ENTRY	FCFUNCS.GAMMA_VALUE,^M<R2,R3,R4,R5,R6,R7>
	SUBL2	#156,SP			; this activation's own storage
; 1081      real(rk), intent(in) :: x
; 1082      type(value) :: v
; 1083      real(rk) :: s, d
; 1084      type(value) :: g
; 1085      integer :: err
; 1086
; 1087      if (abs(x) < counting .and. aint(x) == x) then
	MOVG	@FCFUNCS.GAMMA_VALUE.X(AP),R6
	BGEQ	FCFUNCS.GAMMA_VALUE.$1
	MNEGG	R6,R6
FCFUNCS.GAMMA_VALUE.$1:
	PUSHAG	@FCFUNCS.GAMMA_VALUE.X(AP)
	CALLS	#1,G^MTH$GINT
	MOVG	R0,FCFUNCS.GAMMA_VALUE.$T2(FP)
	CMPG	R6,FCFUNCS.GAMMA_VALUE.$KF1
	BGEQ	FCFUNCS.GAMMA_VALUE.$3
	CMPG	FCFUNCS.GAMMA_VALUE.$T2(FP),@FCFUNCS.GAMMA_VALUE.X(AP)
	BNEQ	FCFUNCS.GAMMA_VALUE.$3
; 1088        if (x <= 0) then
	TSTG	@FCFUNCS.GAMMA_VALUE.X(AP)
	BGTR	FCFUNCS.GAMMA_VALUE.$6
; 1089          v = error_value(e_domain)
	PUSHAL	FCFUNCS.GAMMA_VALUE.$K1
	PUSHAB	FCFUNCS.GAMMA_VALUE.$T3(FP)
	CALLS	#2,G^FCVALUES.ERROR_VALUE
	MOVC3	#32,FCFUNCS.GAMMA_VALUE.$T3(FP),@FCFUNCS.GAMMA_VALUE.V(AP)
; 1090        else
	RET
FCFUNCS.GAMMA_VALUE.$6:
; 1091          v = v_factorial(real_value(x - 1))
	SUBG3	S^#1.0,@FCFUNCS.GAMMA_VALUE.X(AP),FCFUNCS.GAMMA_VALUE.$T2(FP)
	PUSHAG	FCFUNCS.GAMMA_VALUE.$T2(FP)
	PUSHAB	FCFUNCS.GAMMA_VALUE.$T4(FP)
	CALLS	#2,G^FCVALUES.REAL_VALUE
	PUSHAB	FCFUNCS.GAMMA_VALUE.$T4(FP)
	PUSHAB	FCFUNCS.GAMMA_VALUE.$T3(FP)
	CALLS	#2,G^FCVALUES.V_FACTORIAL
	MOVC3	#32,FCFUNCS.GAMMA_VALUE.$T3(FP),@FCFUNCS.GAMMA_VALUE.V(AP)
; 1092        end if
; 1093        return
	RET
FCFUNCS.GAMMA_VALUE.$3:
; 1094      end if
; 1095      if (x > 171) then
	CMPG	@FCFUNCS.GAMMA_VALUE.X(AP),FCFUNCS.GAMMA_VALUE.$KF2
	BLEQ	FCFUNCS.GAMMA_VALUE.$9
; 1096        v = error_value(e_overflow)
	PUSHAL	FCFUNCS.GAMMA_VALUE.$K2
	PUSHAB	FCFUNCS.GAMMA_VALUE.$T4(FP)
	CALLS	#2,G^FCVALUES.ERROR_VALUE
	MOVC3	#32,FCFUNCS.GAMMA_VALUE.$T4(FP),@FCFUNCS.GAMMA_VALUE.V(AP)
; 1097        return
	RET
FCFUNCS.GAMMA_VALUE.$9:
; 1098      end if
; 1099      if (x <= -counting) then
	CMPG	@FCFUNCS.GAMMA_VALUE.X(AP),FCFUNCS.GAMMA_VALUE.$KF3
	BGTR	FCFUNCS.GAMMA_VALUE.$11
; 1100        v = error_value(e_domain)
	PUSHAL	FCFUNCS.GAMMA_VALUE.$K1
	PUSHAB	FCFUNCS.GAMMA_VALUE.$T4(FP)
	CALLS	#2,G^FCVALUES.ERROR_VALUE
	MOVC3	#32,FCFUNCS.GAMMA_VALUE.$T4(FP),@FCFUNCS.GAMMA_VALUE.V(AP)
; 1101        return
	RET
FCFUNCS.GAMMA_VALUE.$11:
; 1102      end if
; 1103
; 1104      if (x >= 0.5_rk) then
	CMPG	@FCFUNCS.GAMMA_VALUE.X(AP),S^#0.5
	BLSS	FCFUNCS.GAMMA_VALUE.$13
; 1105        v = exp_real(lanczos_log(x))
	PUSHAG	@FCFUNCS.GAMMA_VALUE.X(AP)
	CALLS	#1,G^FCFUNCS.LANCZOS_LOG
	MOVG	R0,FCFUNCS.GAMMA_VALUE.$T2(FP)
	PUSHAG	FCFUNCS.GAMMA_VALUE.$T2(FP)
	PUSHAB	FCFUNCS.GAMMA_VALUE.$T4(FP)
	CALLS	#2,G^FCVALUES.EXP_REAL
	MOVC3	#32,FCFUNCS.GAMMA_VALUE.$T4(FP),@FCFUNCS.GAMMA_VALUE.V(AP)
; 1106        return
	RET
FCFUNCS.GAMMA_VALUE.$13:
; 1107      end if
; 1108
; 1109      s = sin_pi(x)
	PUSHAG	@FCFUNCS.GAMMA_VALUE.X(AP)
	CALLS	#1,G^FCFUNCS.SIN_PI
	MOVG	R0,FCFUNCS.GAMMA_VALUE.S(FP)
; 1110      if (1 - x <= 160) then
	SUBG3	@FCFUNCS.GAMMA_VALUE.X(AP),S^#1.0,R0
	CMPG	R0,FCFUNCS.GAMMA_VALUE.$KF4
	BLEQ	FCFUNCS.GAMMA_VALUE.$16
	BRW	FCFUNCS.GAMMA_VALUE.$15
FCFUNCS.GAMMA_VALUE.$16:
; 1111        g = gamma_value(1 - x)
	SUBG3	@FCFUNCS.GAMMA_VALUE.X(AP),S^#1.0,FCFUNCS.GAMMA_VALUE.$T2(FP)
	PUSHAG	FCFUNCS.GAMMA_VALUE.$T2(FP)
	PUSHAB	FCFUNCS.GAMMA_VALUE.$T4(FP)
	CALLS	#2,FCFUNCS.GAMMA_VALUE
