FCFUNCS.ARG_VALUE.$1:
;  645        v = from_radians(real_value(angle_of(aimag(a%z), real(a%z, rk))))
	MOVL	FCFUNCS.ARG_VALUE.A(AP),R0
	MOVG	8(R0),FCFUNCS.ARG_VALUE.$T5
	MOVG	@FCFUNCS.ARG_VALUE.A(AP),FCFUNCS.ARG_VALUE.$T6
	PUSHAG	FCFUNCS.ARG_VALUE.$T6
	PUSHAG	FCFUNCS.ARG_VALUE.$T5
	CALLS	#2,G^FCVALUES.ANGLE_OF
	MOVG	R0,FCFUNCS.ARG_VALUE.$T4
	PUSHAG	FCFUNCS.ARG_VALUE.$T4
	PUSHAB	FCFUNCS.ARG_VALUE.$T3
	CALLS	#2,G^FCVALUES.REAL_VALUE
	PUSHAB	FCFUNCS.ARG_VALUE.$T3
	PUSHAB	FCFUNCS.ARG_VALUE.$T2
	CALLS	#2,G^FCFUNCS.FROM_RADIANS
	MOVC3	#32,FCFUNCS.ARG_VALUE.$T2,@FCFUNCS.ARG_VALUE.V(AP)
;  646      end if
;  647    end function arg_value
	RET

