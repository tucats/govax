;  841
;  842    ! REMAINDER is X mod Y for whole X and Y from 0 to COUNTING: X / Y may be
;  843    ! rounded up to the next whole number, but Y * AINT(X / Y) is exact, so
;  844    ! one correction puts it right.
;  845    real(rk) function remainder(x, y)
	.ENTRY	FCFUNCS.REMAINDER,^M<R6,R7>
;  846      real(rk), intent(in) :: x, y
;  847
;  848      remainder = x - y * aint(x / y)
	DIVG3	@FCFUNCS.REMAINDER.Y(AP),@FCFUNCS.REMAINDER.X(AP),FCFUNCS.REMAINDER.$T2
	PUSHAG	FCFUNCS.REMAINDER.$T2
	CALLS	#1,G^MTH$GINT
	MOVG	R0,FCFUNCS.REMAINDER.$T1
	MULG3	@FCFUNCS.REMAINDER.Y(AP),FCFUNCS.REMAINDER.$T1,R0
	SUBG3	R0,@FCFUNCS.REMAINDER.X(AP),R6
;  849      if (remainder < 0) remainder = remainder + y
	BGEQ	FCFUNCS.REMAINDER.$1
	ADDG2	@FCFUNCS.REMAINDER.Y(AP),R6
FCFUNCS.REMAINDER.$1:
;  850      if (remainder >= y) remainder = remainder - y
	CMPG	R6,@FCFUNCS.REMAINDER.Y(AP)
	BLSS	FCFUNCS.REMAINDER.$3
	SUBG2	@FCFUNCS.REMAINDER.Y(AP),R6
FCFUNCS.REMAINDER.$3:
;  851    end function remainder
	MOVG	R6,R0			; the function's value
	RET

