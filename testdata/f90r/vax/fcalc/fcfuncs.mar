FCFUNCS.TRIG.$T4:
	.BLKL	2			; temporary
FCFUNCS.TRIG.$T5:
	.BLKL	2			; temporary
FCFUNCS.TRIG.$T6:
	.BLKL	2			; temporary
FCFUNCS.TRIG.$T7:
	.BLKL	2			; temporary
FCFUNCS.TRIG.$T8:
	.BLKL	2			; temporary
FCFUNCS.TRIG.$T9:
	.BLKL	2			; temporary
FCFUNCS.TRIG.$T11:
	.BLKL	8			; characters, for one statement

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCFUNCS.TRIG.$K1:
	.LONG	11
FCFUNCS.TRIG.$K2:
	.LONG	10
FCFUNCS.TRIG.$K8:
	.LONG	^X00004010,^X00000000	; 1D0
FCFUNCS.TRIG.$KF1:
	.LONG	^X6BF5432C,^X00002634	; 1D15
FCFUNCS.TRIG.$KF2:
	.LONG	^X900040A5,^X00000000	; 690D0
FCFUNCS.TRIG.$K3:
	.ASCII	/sin/
FCFUNCS.TRIG.$K4:
	.ASCII	/cos/
FCFUNCS.TRIG.$K5:
	.ASCII	/tan/
FCFUNCS.TRIG.$K6:
	.ASCII	/sec/
FCFUNCS.TRIG.$K7:
	.ASCII	/csc/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  522
;  523    ! TRIG is a trigonometric function. A real angle's are the real sine and
;  524    ! cosine's; a complex angle x + iy's come from
;  525    !     sin(x + iy) = sin x cosh y + i cos x sinh y
;  526    !     cos(x + iy) = cos x cosh y - i sin x sinh y
;  527    ! and the other four are quotients of the two.
;  528    function trig(name, a) result(v)
	.ENTRY	FCFUNCS.TRIG,^M<R2,R3,R4,R5,R6,R7>
;  529      character(len=*), intent(in) :: name
;  530      type(value), intent(in) :: a
;  531      type(value) :: v
;  532      type(value) :: s, c, angle
;  533      real(rk) :: x, y, sx, cx
;  534      integer :: err
;  535
;  536      err = 0
	CLRL	FCFUNCS.TRIG.ERR
;  537      if (is_real(a)) then
	PUSHAB	@FCFUNCS.TRIG.A(AP)
	CALLS	#1,G^FCVALUES.IS_REAL
	MOVL	R0,R6
	BLBS	R6,FCFUNCS.TRIG.$2
	BRW	FCFUNCS.TRIG.$1
FCFUNCS.TRIG.$2:
;  538        call sine_cosine(real(a%z, rk), sx, cx, err)
	MOVG	@FCFUNCS.TRIG.A(AP),FCFUNCS.TRIG.$T2
	PUSHAL	FCFUNCS.TRIG.ERR
	PUSHAG	FCFUNCS.TRIG.CX
	PUSHAG	FCFUNCS.TRIG.SX
	PUSHAG	FCFUNCS.TRIG.$T2
	CALLS	#4,G^FCFUNCS.SINE_COSINE
;  539        if (err /= 0) then
	TSTL	FCFUNCS.TRIG.ERR
	BEQL	FCFUNCS.TRIG.$3
;  540          v = error_value(err)
	PUSHAL	FCFUNCS.TRIG.ERR
	PUSHAB	FCFUNCS.TRIG.$T3
	CALLS	#2,G^FCVALUES.ERROR_VALUE
	MOVC3	#32,FCFUNCS.TRIG.$T3,@FCFUNCS.TRIG.V(AP)
;  541          return
	RET
FCFUNCS.TRIG.$3:
;  542        end if
;  543        s = real_value(sx)
	PUSHAG	FCFUNCS.TRIG.SX
	PUSHAB	FCFUNCS.TRIG.$T3
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCFUNCS.TRIG.$T3,FCFUNCS.TRIG.S
;  544        c = real_value(cx)
	PUSHAG	FCFUNCS.TRIG.CX
	PUSHAB	FCFUNCS.TRIG.$T3
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCFUNCS.TRIG.$T3,FCFUNCS.TRIG.C
;  545      else
	BRW	FCFUNCS.TRIG.$5
FCFUNCS.TRIG.$1:
;  546        angle = to_radians(a)
	PUSHAB	@FCFUNCS.TRIG.A(AP)
	PUSHAB	FCFUNCS.TRIG.$T3
	CALLS	#2,G^FCFUNCS.TO_RADIANS
	MOVC3	#32,FCFUNCS.TRIG.$T3,FCFUNCS.TRIG.ANGLE
;  547        if (angle%err /= 0) then
	TSTL	FCFUNCS.TRIG.ANGLE+16
	BEQL	FCFUNCS.TRIG.$6
;  548          v = angle
	MOVC3	#32,FCFUNCS.TRIG.ANGLE,@FCFUNCS.TRIG.V(AP)
;  549          return
	RET
FCFUNCS.TRIG.$6:
;  550        end if
;  551        x = real(angle%z, rk)
	MOVG	FCFUNCS.TRIG.ANGLE,FCFUNCS.TRIG.X
;  552        y = aimag(angle%z)
	MOVG	FCFUNCS.TRIG.ANGLE+8,FCFUNCS.TRIG.Y
;  553        if (abs(x) > angle_limit) then
	MOVG	FCFUNCS.TRIG.X,FCFUNCS.TRIG.$T2
	BGEQ	FCFUNCS.TRIG.$8
	MNEGG	FCFUNCS.TRIG.$T2,FCFUNCS.TRIG.$T2
FCFUNCS.TRIG.$8:
	CMPG	FCFUNCS.TRIG.$T2,FCFUNCS.TRIG.$KF1
	BLEQ	FCFUNCS.TRIG.$10
;  554          v = error_value(e_domain)
	PUSHAL	FCFUNCS.TRIG.$K1
	PUSHAB	FCFUNCS.TRIG.$T3
	CALLS	#2,G^FCVALUES.ERROR_VALUE
	MOVC3	#32,FCFUNCS.TRIG.$T3,@FCFUNCS.TRIG.V(AP)
;  555          return
	RET
FCFUNCS.TRIG.$10:
;  556        end if
;  557        if (abs(y) > hyper_limit) then
	MOVG	FCFUNCS.TRIG.Y,FCFUNCS.TRIG.$T2
	BGEQ	FCFUNCS.TRIG.$12
	MNEGG	FCFUNCS.TRIG.$T2,FCFUNCS.TRIG.$T2
FCFUNCS.TRIG.$12:
	CMPG	FCFUNCS.TRIG.$T2,FCFUNCS.TRIG.$KF2
	BLEQ	FCFUNCS.TRIG.$14
;  558          v = error_value(e_overflow)
	PUSHAL	FCFUNCS.TRIG.$K2
	PUSHAB	FCFUNCS.TRIG.$T3
	CALLS	#2,G^FCVALUES.ERROR_VALUE
	MOVC3	#32,FCFUNCS.TRIG.$T3,@FCFUNCS.TRIG.V(AP)
;  559          return
	RET
FCFUNCS.TRIG.$14:
;  560        end if
;  561        s = complex_value(r_mul(sin(x), cosh(y), err), r_mul(cos(x), sinh(y), err))
	PUSHAG	FCFUNCS.TRIG.X
	CALLS	#1,G^MTH$GSIN
	MOVG	R0,FCFUNCS.TRIG.$T4
	PUSHAG	FCFUNCS.TRIG.Y
	CALLS	#1,G^MTH$GCOSH
	MOVG	R0,FCFUNCS.TRIG.$T5
	PUSHAL	FCFUNCS.TRIG.ERR
	PUSHAG	FCFUNCS.TRIG.$T5
