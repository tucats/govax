	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  621
;  622    ! ATAN2_VALUE is the angle of the point (x, y), from -pi to pi.
;  623    function atan2_value(a, b) result(v)
	.ENTRY	FCFUNCS.ATAN2_VALUE,^M<R2,R3,R4,R5,R6>
;  624      type(value), intent(in) :: a, b
;  625      type(value) :: v
;  626      real(rk) :: y, x
;  627
;  628      if (.not. real_argument(a, y, v)) return
	PUSHAB	@FCFUNCS.ATAN2_VALUE.V(AP)
	PUSHAG	FCFUNCS.ATAN2_VALUE.Y
	PUSHAB	@FCFUNCS.ATAN2_VALUE.A(AP)
	CALLS	#3,G^FCFUNCS.REAL_ARGUMENT
	MOVL	R0,R6
	BLBS	R6,FCFUNCS.ATAN2_VALUE.$1
	RET
FCFUNCS.ATAN2_VALUE.$1:
;  629      if (.not. real_argument(b, x, v)) return
	PUSHAB	@FCFUNCS.ATAN2_VALUE.V(AP)
	PUSHAG	FCFUNCS.ATAN2_VALUE.X
	PUSHAB	@FCFUNCS.ATAN2_VALUE.B(AP)
	CALLS	#3,G^FCFUNCS.REAL_ARGUMENT
	MOVL	R0,R6
	BLBS	R6,FCFUNCS.ATAN2_VALUE.$3
	RET
FCFUNCS.ATAN2_VALUE.$3:
;  630      if (x == 0 .and. y == 0) then
	TSTG	FCFUNCS.ATAN2_VALUE.X
	BNEQ	FCFUNCS.ATAN2_VALUE.$5
	TSTG	FCFUNCS.ATAN2_VALUE.Y
	BNEQ	FCFUNCS.ATAN2_VALUE.$5
;  631        v = error_value(e_domain)
	PUSHAL	FCFUNCS.ATAN2_VALUE.$K1
	PUSHAB	FCFUNCS.ATAN2_VALUE.$T2
	CALLS	#2,G^FCVALUES.ERROR_VALUE
	MOVC3	#32,FCFUNCS.ATAN2_VALUE.$T2,@FCFUNCS.ATAN2_VALUE.V(AP)
;  632        return
	RET
FCFUNCS.ATAN2_VALUE.$5:
;  633      end if
;  634      v = from_radians(real_value(angle_of(y, x)))
	PUSHAG	FCFUNCS.ATAN2_VALUE.X
	PUSHAG	FCFUNCS.ATAN2_VALUE.Y
	CALLS	#2,G^FCVALUES.ANGLE_OF
	MOVG	R0,FCFUNCS.ATAN2_VALUE.$T4
	PUSHAG	FCFUNCS.ATAN2_VALUE.$T4
	PUSHAB	FCFUNCS.ATAN2_VALUE.$T3
	CALLS	#2,G^FCVALUES.REAL_VALUE
	PUSHAB	FCFUNCS.ATAN2_VALUE.$T3
	PUSHAB	FCFUNCS.ATAN2_VALUE.$T2
	CALLS	#2,G^FCFUNCS.FROM_RADIANS
	MOVC3	#32,FCFUNCS.ATAN2_VALUE.$T2,@FCFUNCS.ATAN2_VALUE.V(AP)
;  635    end function atan2_value
	RET

