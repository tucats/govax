	.BLKL	8			; characters, for one statement
FCFUNCS.HYPERBOLIC.$T3:
	.BLKL	2			; temporary
FCFUNCS.HYPERBOLIC.$T4:
	.BLKL	2			; temporary
FCFUNCS.HYPERBOLIC.$T5:
	.BLKL	2			; temporary
FCFUNCS.HYPERBOLIC.$T6:
	.BLKL	2			; temporary
