	.BLKL	2			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCFUNCS.HYPERBOLIC.$K2:
	.LONG	10
FCFUNCS.HYPERBOLIC.$K3:
	.LONG	11
FCFUNCS.HYPERBOLIC.$KF1:
	.LONG	^X0000C010,^X00000000	; -1D0
FCFUNCS.HYPERBOLIC.$KF2:
	.LONG	^X900040A5,^X00000000	; 690D0
FCFUNCS.HYPERBOLIC.$KF3:
	.LONG	^X6BF5432C,^X00002634	; 1D15
FCFUNCS.HYPERBOLIC.$K1:
	.ASCII	/tanh/
FCFUNCS.HYPERBOLIC.$K4:
	.ASCII	/sinh/
FCFUNCS.HYPERBOLIC.$K5:
	.ASCII	/cosh/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  668
;  669    ! ------------------------------------------------------------------
;  670    ! Hyperbolic functions.
;  671
;  672    ! HYPERBOLIC: a real argument's are the intrinsics' (TANH is 1 to the
;  673    ! digits past 20); a complex one's come from
;  674    !     sinh(x + iy) = sinh x cos y + i cosh x sin y
;  675    !     cosh(x + iy) = cosh x cos y + i sinh x sin y
;  676    function hyperbolic(name, a) result(v)
	.ENTRY	FCFUNCS.HYPERBOLIC,^M<R2,R3,R4,R5,R6,R7>
;  677      character(len=*), intent(in) :: name
;  678      type(value), intent(in) :: a
;  679      type(value) :: v
;  680      type(value) :: s, c
;  681      real(rk) :: x, y
;  682      integer :: err
;  683
;  684      x = real(a%z, rk)
	MOVG	@FCFUNCS.HYPERBOLIC.A(AP),FCFUNCS.HYPERBOLIC.X
;  685      y = aimag(a%z)
	MOVL	FCFUNCS.HYPERBOLIC.A(AP),R0
	MOVG	8(R0),FCFUNCS.HYPERBOLIC.Y
;  686
;  687      if (name == 'tanh' .and. y == 0) then
	MOVZWL	@FCFUNCS.HYPERBOLIC.NAME(AP),R0
	MOVL	FCFUNCS.HYPERBOLIC.NAME(AP),R1
	CMPC5	R0,@4(R1),#^A/ /,#4,FCFUNCS.HYPERBOLIC.$K1
	BEQL	FCFUNCS.HYPERBOLIC.$2
	BRW	FCFUNCS.HYPERBOLIC.$1
FCFUNCS.HYPERBOLIC.$2:
	TSTG	FCFUNCS.HYPERBOLIC.Y
	BEQL	FCFUNCS.HYPERBOLIC.$3
	BRW	FCFUNCS.HYPERBOLIC.$1
FCFUNCS.HYPERBOLIC.$3:
;  688        if (abs(x) > 20) then
	MOVG	FCFUNCS.HYPERBOLIC.X,FCFUNCS.HYPERBOLIC.$T1
	BGEQ	FCFUNCS.HYPERBOLIC.$4
	MNEGG	FCFUNCS.HYPERBOLIC.$T1,FCFUNCS.HYPERBOLIC.$T1
FCFUNCS.HYPERBOLIC.$4:
	CMPG	FCFUNCS.HYPERBOLIC.$T1,S^#20.0
	BLEQ	FCFUNCS.HYPERBOLIC.$6
;  689          v = real_value(sign(1.0_rk, x))
	MOVG	S^#1.0,FCFUNCS.HYPERBOLIC.$T1 ; 1D0
	TSTG	FCFUNCS.HYPERBOLIC.X
	BGEQ	FCFUNCS.HYPERBOLIC.$10
	MOVG	FCFUNCS.HYPERBOLIC.$KF1,FCFUNCS.HYPERBOLIC.$T1 ; -1D0
FCFUNCS.HYPERBOLIC.$10:
	PUSHAG	FCFUNCS.HYPERBOLIC.$T1
	PUSHAB	FCFUNCS.HYPERBOLIC.$T2
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCFUNCS.HYPERBOLIC.$T2,@FCFUNCS.HYPERBOLIC.V(AP)
;  690        else
	RET
FCFUNCS.HYPERBOLIC.$6:
;  691          v = real_value(tanh(x))
	PUSHAG	FCFUNCS.HYPERBOLIC.X
	CALLS	#1,G^MTH$GTANH
	MOVG	R0,FCFUNCS.HYPERBOLIC.$T1
	PUSHAG	FCFUNCS.HYPERBOLIC.$T1
	PUSHAB	FCFUNCS.HYPERBOLIC.$T2
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCFUNCS.HYPERBOLIC.$T2,@FCFUNCS.HYPERBOLIC.V(AP)
;  692        end if
;  693        return
	RET
FCFUNCS.HYPERBOLIC.$1:
;  694      end if
;  695
;  696      if (abs(x) > hyper_limit) then
	MOVG	FCFUNCS.HYPERBOLIC.X,FCFUNCS.HYPERBOLIC.$T1
	BGEQ	FCFUNCS.HYPERBOLIC.$12
	MNEGG	FCFUNCS.HYPERBOLIC.$T1,FCFUNCS.HYPERBOLIC.$T1
FCFUNCS.HYPERBOLIC.$12:
	CMPG	FCFUNCS.HYPERBOLIC.$T1,FCFUNCS.HYPERBOLIC.$KF2
	BLEQ	FCFUNCS.HYPERBOLIC.$14
;  697        v = error_value(e_overflow)
	PUSHAL	FCFUNCS.HYPERBOLIC.$K2
	PUSHAB	FCFUNCS.HYPERBOLIC.$T2
	CALLS	#2,G^FCVALUES.ERROR_VALUE
	MOVC3	#32,FCFUNCS.HYPERBOLIC.$T2,@FCFUNCS.HYPERBOLIC.V(AP)
;  698        return
	RET
FCFUNCS.HYPERBOLIC.$14:
;  699      end if
;  700      if (abs(y) > angle_limit) then
	MOVG	FCFUNCS.HYPERBOLIC.Y,FCFUNCS.HYPERBOLIC.$T1
	BGEQ	FCFUNCS.HYPERBOLIC.$16
	MNEGG	FCFUNCS.HYPERBOLIC.$T1,FCFUNCS.HYPERBOLIC.$T1
FCFUNCS.HYPERBOLIC.$16:
	CMPG	FCFUNCS.HYPERBOLIC.$T1,FCFUNCS.HYPERBOLIC.$KF3
	BLEQ	FCFUNCS.HYPERBOLIC.$18
;  701        v = error_value(e_domain)
	PUSHAL	FCFUNCS.HYPERBOLIC.$K3
	PUSHAB	FCFUNCS.HYPERBOLIC.$T2
	CALLS	#2,G^FCVALUES.ERROR_VALUE
	MOVC3	#32,FCFUNCS.HYPERBOLIC.$T2,@FCFUNCS.HYPERBOLIC.V(AP)
;  702        return
	RET
FCFUNCS.HYPERBOLIC.$18:
;  703      end if
;  704
;  705      if (y == 0) then
	TSTG	FCFUNCS.HYPERBOLIC.Y
	BNEQ	FCFUNCS.HYPERBOLIC.$20
;  706        s = real_value(sinh(x))
	PUSHAG	FCFUNCS.HYPERBOLIC.X
	CALLS	#1,G^MTH$GSINH
	MOVG	R0,FCFUNCS.HYPERBOLIC.$T1
	PUSHAG	FCFUNCS.HYPERBOLIC.$T1
	PUSHAB	FCFUNCS.HYPERBOLIC.$T2
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCFUNCS.HYPERBOLIC.$T2,FCFUNCS.HYPERBOLIC.S
;  707        c = real_value(cosh(x))
	PUSHAG	FCFUNCS.HYPERBOLIC.X
	CALLS	#1,G^MTH$GCOSH
	MOVG	R0,FCFUNCS.HYPERBOLIC.$T1
	PUSHAG	FCFUNCS.HYPERBOLIC.$T1
	PUSHAB	FCFUNCS.HYPERBOLIC.$T2
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCFUNCS.HYPERBOLIC.$T2,FCFUNCS.HYPERBOLIC.C
;  708      else
	BRW	FCFUNCS.HYPERBOLIC.$22
FCFUNCS.HYPERBOLIC.$20:
;  709        err = 0
	CLRL	FCFUNCS.HYPERBOLIC.ERR
;  710        s = complex_value(r_mul(sinh(x), cos(y), err), r_mul(cosh(x), sin(y), err))
	PUSHAG	FCFUNCS.HYPERBOLIC.X
	CALLS	#1,G^MTH$GSINH
	MOVG	R0,FCFUNCS.HYPERBOLIC.$T3
	PUSHAG	FCFUNCS.HYPERBOLIC.Y
	CALLS	#1,G^MTH$GCOS
	MOVG	R0,FCFUNCS.HYPERBOLIC.$T4
	PUSHAL	FCFUNCS.HYPERBOLIC.ERR
	PUSHAG	FCFUNCS.HYPERBOLIC.$T4
	PUSHAG	FCFUNCS.HYPERBOLIC.$T3
	CALLS	#3,G^FCVALUES.R_MUL
	MOVG	R0,FCFUNCS.HYPERBOLIC.$T1
	PUSHAG	FCFUNCS.HYPERBOLIC.X
	CALLS	#1,G^MTH$GCOSH
	MOVG	R0,FCFUNCS.HYPERBOLIC.$T6
	PUSHAG	FCFUNCS.HYPERBOLIC.Y
	CALLS	#1,G^MTH$GSIN
	MOVG	R0,FCFUNCS.HYPERBOLIC.$T7
	PUSHAL	FCFUNCS.HYPERBOLIC.ERR
	PUSHAG	FCFUNCS.HYPERBOLIC.$T7
	PUSHAG	FCFUNCS.HYPERBOLIC.$T6
	CALLS	#3,G^FCVALUES.R_MUL
	MOVG	R0,FCFUNCS.HYPERBOLIC.$T5
	PUSHAG	FCFUNCS.HYPERBOLIC.$T5
	PUSHAG	FCFUNCS.HYPERBOLIC.$T1
	PUSHAB	FCFUNCS.HYPERBOLIC.$T2
	CALLS	#3,G^FCVALUES.COMPLEX_VALUE
	MOVC3	#32,FCFUNCS.HYPERBOLIC.$T2,FCFUNCS.HYPERBOLIC.S
;  711        c = complex_value(r_mul(cosh(x), cos(y), err), r_mul(sinh(x), sin(y), err))
	PUSHAG	FCFUNCS.HYPERBOLIC.X
	CALLS	#1,G^MTH$GCOSH
	MOVG	R0,FCFUNCS.HYPERBOLIC.$T6
	PUSHAG	FCFUNCS.HYPERBOLIC.Y
	CALLS	#1,G^MTH$GCOS
	MOVG	R0,FCFUNCS.HYPERBOLIC.$T5
	PUSHAL	FCFUNCS.HYPERBOLIC.ERR
	PUSHAG	FCFUNCS.HYPERBOLIC.$T5
	PUSHAG	FCFUNCS.HYPERBOLIC.$T6
	CALLS	#3,G^FCVALUES.R_MUL
	MOVG	R0,FCFUNCS.HYPERBOLIC.$T7
	PUSHAG	FCFUNCS.HYPERBOLIC.X
	CALLS	#1,G^MTH$GSINH
	MOVG	R0,FCFUNCS.HYPERBOLIC.$T3
	PUSHAG	FCFUNCS.HYPERBOLIC.Y
	CALLS	#1,G^MTH$GSIN
	MOVG	R0,FCFUNCS.HYPERBOLIC.$T1
	PUSHAL	FCFUNCS.HYPERBOLIC.ERR
	PUSHAG	FCFUNCS.HYPERBOLIC.$T1
	PUSHAG	FCFUNCS.HYPERBOLIC.$T3
	CALLS	#3,G^FCVALUES.R_MUL
	MOVG	R0,FCFUNCS.HYPERBOLIC.$T4
	PUSHAG	FCFUNCS.HYPERBOLIC.$T4
	PUSHAG	FCFUNCS.HYPERBOLIC.$T7
	PUSHAB	FCFUNCS.HYPERBOLIC.$T2
	CALLS	#3,G^FCVALUES.COMPLEX_VALUE
	MOVC3	#32,FCFUNCS.HYPERBOLIC.$T2,FCFUNCS.HYPERBOLIC.C
;  712      end if
FCFUNCS.HYPERBOLIC.$22:
;  713
;  714      select case (name)
	MOVL	FCFUNCS.HYPERBOLIC.NAME(AP),R0
	MOVAB	@4(R0),R6
	MOVZWL	@FCFUNCS.HYPERBOLIC.NAME(AP),R7
