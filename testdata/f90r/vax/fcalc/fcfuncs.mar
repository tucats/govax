	CALLS	#3,G^FCVALUES.COMPLEX_VALUE
	MOVC3	#32,FCFUNCS.TRIG.$T3,FCFUNCS.TRIG.S
;  562        c = complex_value(r_mul(cos(x), cosh(y), err), -r_mul(sin(x), sinh(y), err))
	PUSHAG	FCFUNCS.TRIG.X
	CALLS	#1,G^MTH$GCOS
	MOVG	R0,FCFUNCS.TRIG.$T7
	PUSHAG	FCFUNCS.TRIG.Y
	CALLS	#1,G^MTH$GCOSH
	MOVG	R0,FCFUNCS.TRIG.$T6
	PUSHAL	FCFUNCS.TRIG.ERR
	PUSHAG	FCFUNCS.TRIG.$T6
	PUSHAG	FCFUNCS.TRIG.$T7
