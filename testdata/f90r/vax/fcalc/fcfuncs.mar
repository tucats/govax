;  823
;  824    ! SIGN_VALUE is -1, 0, or 1 for a real number, and z / |z| for another.
;  825    function sign_value(a) result(v)
	.ENTRY	FCFUNCS.SIGN_VALUE,^M<R2,R3,R4,R5>
;  826      type(value), intent(in) :: a
