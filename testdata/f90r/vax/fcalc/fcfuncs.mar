	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCFUNCS.CBRT_VALUE.$K1:
	.LONG	^X00004028,^X00000000	; 3D0
FCFUNCS.CBRT_VALUE.$K2:
	.LONG	^X00000000,^X00000000	; 0D0

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  343
;  344    ! CBRT_VALUE is a real number's real cube root, and a complex number's
;  345    ! principal one. The real root is EXP(LOG|x| / 3) made exact by a step
;  346    ! of Newton's method, so cbrt(27) is 3.
;  347    function cbrt_value(a) result(v)
	.ENTRY	FCFUNCS.CBRT_VALUE,^M<R2,R3,R4,R5>
;  348      type(value), intent(in) :: a
;  349      type(value) :: v
;  350      real(rk) :: x, r
;  351
;  352      x = real(a%z, rk)
	MOVG	@FCFUNCS.CBRT_VALUE.A(AP),FCFUNCS.CBRT_VALUE.X
;  353      if (.not. is_real(a)) then
	PUSHAB	@FCFUNCS.CBRT_VALUE.A(AP)
	CALLS	#1,G^FCVALUES.IS_REAL
	MOVL	R0,FCFUNCS.CBRT_VALUE.$T1
	BLBS	FCFUNCS.CBRT_VALUE.$T1,FCFUNCS.CBRT_VALUE.$1
;  354        v = exp_value(ln_value(a) / real_value(3.0_rk))
	PUSHAB	@FCFUNCS.CBRT_VALUE.A(AP)
	PUSHAB	FCFUNCS.CBRT_VALUE.$T4
	CALLS	#2,G^FCFUNCS.LN_VALUE
	PUSHAG	FCFUNCS.CBRT_VALUE.$K1
	PUSHAB	FCFUNCS.CBRT_VALUE.$T5
	CALLS	#2,G^FCVALUES.REAL_VALUE
	PUSHAB	FCFUNCS.CBRT_VALUE.$T5
	PUSHAB	FCFUNCS.CBRT_VALUE.$T4
	PUSHAB	FCFUNCS.CBRT_VALUE.$T3
	CALLS	#3,G^FCVALUES.V_DIV
	PUSHAB	FCFUNCS.CBRT_VALUE.$T3
	PUSHAB	FCFUNCS.CBRT_VALUE.$T2
	CALLS	#2,G^FCVALUES.EXP_VALUE
	MOVC3	#32,FCFUNCS.CBRT_VALUE.$T2,@FCFUNCS.CBRT_VALUE.V(AP)
;  355        return
	RET
FCFUNCS.CBRT_VALUE.$1:
;  356      end if
;  357      if (x == 0) then
	TSTG	FCFUNCS.CBRT_VALUE.X
