	CALLS	#1,G^MTH$GCOS
	MOVG	R0,FCFUNCS.TRIG.$T7
	PUSHAG	FCFUNCS.TRIG.Y
	CALLS	#1,G^MTH$GSINH
	MOVG	R0,FCFUNCS.TRIG.$T8
