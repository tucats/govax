	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  167
;  168    ! TAKES_LIST: the function ID takes a list of any length, so the
;  169    ! evaluator gives it every element of an array argument (sum([1, 2, 3])
;  170    ! is sum(1, 2, 3)), where it applies any other function to each element.
;  171    logical function takes_list(id)
	.ENTRY	FCFUNCS.TAKES_LIST,^M<R2,R3,R4,R5>
;  172      integer, intent(in) :: id
;  173      type(builtin) :: b
;  174
;  175      b = row(id)
