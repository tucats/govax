	PUSHAB	FCFUNCS.SIGN_VALUE.$T3
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCFUNCS.SIGN_VALUE.$T3,@FCFUNCS.SIGN_VALUE.V(AP)
;  835      else if (x < 0) then
	RET
FCFUNCS.SIGN_VALUE.$4:
