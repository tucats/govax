	PUSHAB	FCFUNCS.TAKES_LIST.$T1
	CALLS	#2,G^FCFUNCS.ROW
	MOVC3	#20,FCFUNCS.TAKES_LIST.$T1,FCFUNCS.TAKES_LIST.B
;  176      takes_list = b%most == many
;  177    end function takes_list
	CLRL	R0			; the function's value
	CMPL	FCFUNCS.TAKES_LIST.B+16,#1000
	BNEQ	FCFUNCS.TAKES_LIST.$1
	MNEGL	#1,R0
FCFUNCS.TAKES_LIST.$1:
	RET

