;  458
;  459    ! TO_RADIANS and FROM_RADIANS convert an angle between the angle mode and
;  460    ! radians.
;  461    function to_radians(a) result(v)
	.ENTRY	FCFUNCS.TO_RADIANS,^M<R2,R3,R4,R5>
;  462      type(value), intent(in) :: a
;  463      type(value) :: v
;  464
;  465      if (angle_mode == a_radians) then
	CMPL	FCFUNCS.ANGLE_MODE,#1
	BNEQ	FCFUNCS.TO_RADIANS.$1
;  466        v = a
	MOVC3	#32,@FCFUNCS.TO_RADIANS.A(AP),@FCFUNCS.TO_RADIANS.V(AP)
;  467      else
	RET
FCFUNCS.TO_RADIANS.$1:
;  468        v = a * real_value(2 * pi / turn())
	CALLS	#0,G^FCFUNCS.TURN
	MOVG	R0,FCFUNCS.TO_RADIANS.$T3
	DIVG3	FCFUNCS.TO_RADIANS.$T3,FCFUNCS.TO_RADIANS.$KF1,FCFUNCS.TO_RADIANS.$T4
	PUSHAG	FCFUNCS.TO_RADIANS.$T4
	PUSHAB	FCFUNCS.TO_RADIANS.$T2
	CALLS	#2,G^FCVALUES.REAL_VALUE
	PUSHAB	FCFUNCS.TO_RADIANS.$T2
	PUSHAB	@FCFUNCS.TO_RADIANS.A(AP)
	PUSHAB	FCFUNCS.TO_RADIANS.$T1
	CALLS	#3,G^FCVALUES.V_MUL
	MOVC3	#32,FCFUNCS.TO_RADIANS.$T1,@FCFUNCS.TO_RADIANS.V(AP)
;  469      end if
;  470    end function to_radians
	RET

