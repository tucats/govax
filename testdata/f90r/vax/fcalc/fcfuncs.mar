	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  471
;  472    function from_radians(a) result(v)
	.ENTRY	FCFUNCS.FROM_RADIANS,^M<R2,R3,R4,R5>
;  473      type(value), intent(in) :: a
;  474      type(value) :: v
;  475
;  476      if (angle_mode == a_radians .or. a%err /= 0) then
	CMPL	FCFUNCS.ANGLE_MODE,#1
	BEQL	FCFUNCS.FROM_RADIANS.$2
	MOVL	FCFUNCS.FROM_RADIANS.A(AP),R0
	TSTL	16(R0)
	BEQL	FCFUNCS.FROM_RADIANS.$1
FCFUNCS.FROM_RADIANS.$2:
;  477        v = a
	MOVC3	#32,@FCFUNCS.FROM_RADIANS.A(AP),@FCFUNCS.FROM_RADIANS.V(AP)
;  478      else
	RET
FCFUNCS.FROM_RADIANS.$1:
;  479        v = complex_value(real(a%z, rk) * turn() / (2 * pi), aimag(a%z) * turn() / (2 * pi))
	CALLS	#0,G^FCFUNCS.TURN
	MOVG	R0,FCFUNCS.FROM_RADIANS.$T2
	MULG3	@FCFUNCS.FROM_RADIANS.A(AP),FCFUNCS.FROM_RADIANS.$T2,R0
	DIVG3	FCFUNCS.FROM_RADIANS.$KF1,R0,FCFUNCS.FROM_RADIANS.$T3
	CALLS	#0,G^FCFUNCS.TURN
	MOVG	R0,FCFUNCS.FROM_RADIANS.$T4
	MOVL	FCFUNCS.FROM_RADIANS.A(AP),R0
	MULG3	8(R0),FCFUNCS.FROM_RADIANS.$T4,R0
	DIVG3	FCFUNCS.FROM_RADIANS.$KF1,R0,FCFUNCS.FROM_RADIANS.$T5
	PUSHAG	FCFUNCS.FROM_RADIANS.$T5
	PUSHAG	FCFUNCS.FROM_RADIANS.$T3
	PUSHAB	FCFUNCS.FROM_RADIANS.$T1
	CALLS	#3,G^FCVALUES.COMPLEX_VALUE
	MOVC3	#32,FCFUNCS.FROM_RADIANS.$T1,@FCFUNCS.FROM_RADIANS.V(AP)
;  480      end if
;  481    end function from_radians
	RET

