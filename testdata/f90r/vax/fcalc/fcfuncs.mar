;  790
;  791    ! ------------------------------------------------------------------
;  792    ! Rounding and whole numbers.
;  793
;  794    ! ROUNDED rounds X as HOW says. A number past COUNTING is whole already
;  795    ! (and AINT isn't asked about it).
;  796    real(rk) function rounded(how, x)
	.ENTRY	FCFUNCS.ROUNDED,^M<R2,R3,R6,R7,R8,R9>
;  797      character(len=*), intent(in) :: how
;  798      real(rk), intent(in) :: x
;  799      real(rk) :: t
;  800
;  801      if (abs(x) >= counting) then
	MOVG	@FCFUNCS.ROUNDED.X(AP),R8
	BGEQ	FCFUNCS.ROUNDED.$1
	MNEGG	R8,R8
FCFUNCS.ROUNDED.$1:
	CMPG	R8,FCFUNCS.ROUNDED.$KF1
	BLSS	FCFUNCS.ROUNDED.$3
;  802        rounded = x
	MOVG	@FCFUNCS.ROUNDED.X(AP),FCFUNCS.ROUNDED.ROUNDED
;  803        if (how == 'frac') rounded = 0
	MOVZWL	@FCFUNCS.ROUNDED.HOW(AP),R0
	MOVL	FCFUNCS.ROUNDED.HOW(AP),R1
	CMPC5	R0,@4(R1),#^A/ /,#4,FCFUNCS.ROUNDED.$K1
	BNEQ	FCFUNCS.ROUNDED.$5
	CLRG	FCFUNCS.ROUNDED.ROUNDED
FCFUNCS.ROUNDED.$5:
;  804        return
	MOVG	FCFUNCS.ROUNDED.ROUNDED,R0 ; the function's value
	RET
FCFUNCS.ROUNDED.$3:
;  805      end if
;  806
;  807      t = aint(x)
	PUSHAG	@FCFUNCS.ROUNDED.X(AP)
	CALLS	#1,G^MTH$GINT
	MOVG	R0,R8
	MOVG	R8,FCFUNCS.ROUNDED.T
;  808      select case (how)
	MOVL	FCFUNCS.ROUNDED.HOW(AP),R0
	MOVAB	@4(R0),R6
	MOVZWL	@FCFUNCS.ROUNDED.HOW(AP),R7
	CMPC5	R7,(R6),#^A/ /,#5,FCFUNCS.ROUNDED.$K2
	BEQL	FCFUNCS.ROUNDED.$7
	CMPC5	R7,(R6),#^A/ /,#4,FCFUNCS.ROUNDED.$K3
	BEQL	FCFUNCS.ROUNDED.$9
	CMPC5	R7,(R6),#^A/ /,#5,FCFUNCS.ROUNDED.$K4
	BEQL	FCFUNCS.ROUNDED.$11
	CMPC5	R7,(R6),#^A/ /,#5,FCFUNCS.ROUNDED.$K5
	BNEQ	FCFUNCS.ROUNDED.$15
	BRB	FCFUNCS.ROUNDED.$13
FCFUNCS.ROUNDED.$7:
;  809      case ('floor')
;  810        if (t > x) t = t - 1
	CMPG	FCFUNCS.ROUNDED.T,@FCFUNCS.ROUNDED.X(AP)
	BLEQ	FCFUNCS.ROUNDED.$16
	SUBG2	S^#1.0,FCFUNCS.ROUNDED.T
FCFUNCS.ROUNDED.$16:
;  811        rounded = t
	MOVG	FCFUNCS.ROUNDED.T,FCFUNCS.ROUNDED.ROUNDED
;  812      case ('ceil')
	BRB	FCFUNCS.ROUNDED.$18
FCFUNCS.ROUNDED.$9:
;  813        if (t < x) t = t + 1
	CMPG	FCFUNCS.ROUNDED.T,@FCFUNCS.ROUNDED.X(AP)
	BGEQ	FCFUNCS.ROUNDED.$19
	ADDG2	S^#1.0,FCFUNCS.ROUNDED.T
FCFUNCS.ROUNDED.$19:
;  814        rounded = t
	MOVG	FCFUNCS.ROUNDED.T,FCFUNCS.ROUNDED.ROUNDED
;  815      case ('round')
	BRB	FCFUNCS.ROUNDED.$18
FCFUNCS.ROUNDED.$11:
;  816        rounded = anint(x)
	PUSHAG	@FCFUNCS.ROUNDED.X(AP)
	CALLS	#1,G^MTH$GNINT
	MOVG	R0,R8
	MOVG	R8,FCFUNCS.ROUNDED.ROUNDED
;  817      case ('trunc')
	BRB	FCFUNCS.ROUNDED.$18
FCFUNCS.ROUNDED.$13:
;  818        rounded = t
	MOVG	FCFUNCS.ROUNDED.T,FCFUNCS.ROUNDED.ROUNDED
;  819      case default
	BRB	FCFUNCS.ROUNDED.$18
FCFUNCS.ROUNDED.$15:
;  820        rounded = x - t
	SUBG3	FCFUNCS.ROUNDED.T,@FCFUNCS.ROUNDED.X(AP),FCFUNCS.ROUNDED.ROUNDED
;  821      end select
FCFUNCS.ROUNDED.$18:
;  822    end function rounded
	MOVG	FCFUNCS.ROUNDED.ROUNDED,R0 ; the function's value
	RET

