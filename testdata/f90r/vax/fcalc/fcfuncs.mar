; Storage map for FCFUNCS.REAL_ARGUMENT, a LOGICAL function
;   A              TYPE(VALUE), INTENT(IN)     argument 1  @FCFUNCS.REAL_ARGUMENT.A(AP)
;   X              REAL*8, INTENT(OUT)         argument 2  @FCFUNCS.REAL_ARGUMENT.X(AP)
;   V              TYPE(VALUE), INTENT(INOUT)  argument 3  @FCFUNCS.REAL_ARGUMENT.V(AP)
;   REAL_ARGUMENT  LOGICAL                     R6          R6
;
FCFUNCS.REAL_ARGUMENT.A = 4		; A is argument 1
FCFUNCS.REAL_ARGUMENT.X = 8		; X is argument 2
FCFUNCS.REAL_ARGUMENT.V = 12		; V is argument 3

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
	.BLKB	4
FCFUNCS.REAL_ARGUMENT.$T1:
	.BLKL	8			; characters, for one statement

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCFUNCS.REAL_ARGUMENT.$K1:
	.LONG	12

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  275
;  276    ! ------------------------------------------------------------------
;  277    ! Arguments.
;  278
;  279    ! REAL_ARGUMENT: A is real, and X its value; otherwise V is NOTREAL.
;  280    logical function real_argument(a, x, v)
	.ENTRY	FCFUNCS.REAL_ARGUMENT,^M<R2,R3,R4,R5,R6>
;  281      type(value), intent(in) :: a
;  282      real(rk), intent(out) :: x
;  283      type(value), intent(inout) :: v
;  284
;  285      x = real(a%z, rk)
	MOVG	@FCFUNCS.REAL_ARGUMENT.A(AP),@FCFUNCS.REAL_ARGUMENT.X(AP)
;  286      real_argument = is_real(a)
	PUSHAB	@FCFUNCS.REAL_ARGUMENT.A(AP)
	CALLS	#1,G^FCVALUES.IS_REAL
	MOVL	R0,R6
;  287      if (.not. real_argument) v = error_value(e_notreal)
	BLBS	R6,FCFUNCS.REAL_ARGUMENT.$1
	PUSHAL	FCFUNCS.REAL_ARGUMENT.$K1
	PUSHAB	FCFUNCS.REAL_ARGUMENT.$T1
	CALLS	#2,G^FCVALUES.ERROR_VALUE
	MOVC3	#32,FCFUNCS.REAL_ARGUMENT.$T1,@FCFUNCS.REAL_ARGUMENT.V(AP)
FCFUNCS.REAL_ARGUMENT.$1:
;  288    end function real_argument
	MOVL	R6,R0			; the function's value
	RET

; Storage map for FCFUNCS.WHOLE_ARGUMENT, a LOGICAL function
