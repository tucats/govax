	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  636
;  637    ! ARG_VALUE is a complex number's angle, from -pi to pi (0 for zero).
;  638    function arg_value(a) result(v)
	.ENTRY	FCFUNCS.ARG_VALUE,^M<R2,R3,R4,R5>
;  639      type(value), intent(in) :: a
;  640      type(value) :: v
;  641
;  642      if (.not. truth(a)) then
	PUSHAB	@FCFUNCS.ARG_VALUE.A(AP)
	CALLS	#1,G^FCVALUES.TRUTH
	MOVL	R0,FCFUNCS.ARG_VALUE.$T1
	BLBS	FCFUNCS.ARG_VALUE.$T1,FCFUNCS.ARG_VALUE.$1
;  643        v = real_value(0.0_rk)
	PUSHAG	FCFUNCS.ARG_VALUE.$K1
	PUSHAB	FCFUNCS.ARG_VALUE.$T2
