;   S      TYPE(VALUE)                $LOCAL+0           FCFUNCS.TRIG.S
;   C      TYPE(VALUE)                $LOCAL+32          FCFUNCS.TRIG.C
;   ANGLE  TYPE(VALUE)                $LOCAL+64          FCFUNCS.TRIG.ANGLE
;   X      REAL*8                     $LOCAL+96          FCFUNCS.TRIG.X
;   Y      REAL*8                     $LOCAL+104         FCFUNCS.TRIG.Y
;   SX     REAL*8                     $LOCAL+112         FCFUNCS.TRIG.SX
;   CX     REAL*8                     $LOCAL+120         FCFUNCS.TRIG.CX
;   ERR    INTEGER                    $LOCAL+128         FCFUNCS.TRIG.ERR
;   R6 is $T1: temporary
;   R7 is $T10: temporary
;
FCFUNCS.TRIG.V = 4			; V's value goes through hidden argument 1
