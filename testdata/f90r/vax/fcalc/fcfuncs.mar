	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  482
;  483    ! SINE_COSINE gives a real angle X's sine and cosine. In degrees and
;  484    ! grads the angle is reduced exactly to [0, a turn), and a multiple of a
;  485    ! quarter turn has its exact values. In radians an angle past
;  486    ! ANGLE_LIMIT has no significant digits, and is out of the domain.
;  487    subroutine sine_cosine(x, s, c, err)
	.ENTRY	FCFUNCS.SINE_COSINE,^M<R2,R3,R4,R5>
;  488      real(rk), intent(in) :: x
;  489      real(rk), intent(out) :: s, c
;  490      integer, intent(inout) :: err
;  491      real(rk), parameter :: sines(0:3) = (/ 0.0_rk, 1.0_rk, 0.0_rk, -1.0_rk /)
;  492      real(rk), parameter :: cosines(0:3) = (/ 1.0_rk, 0.0_rk, -1.0_rk, 0.0_rk /)
;  493      type(value) :: r
;  494      real(rk) :: t, quarter
;  495      integer :: k
;  496
;  497      s = 0
	CLRG	@FCFUNCS.SINE_COSINE.S(AP)
;  498      c = 1
	MOVG	S^#1.0,@FCFUNCS.SINE_COSINE.C(AP) ; 1D0
;  499      if (angle_mode == a_radians) then
	CMPL	FCFUNCS.ANGLE_MODE,#1
	BNEQ	FCFUNCS.SINE_COSINE.$1
;  500        if (abs(x) > angle_limit) then
	MOVG	@FCFUNCS.SINE_COSINE.X(AP),FCFUNCS.SINE_COSINE.$T1
	BGEQ	FCFUNCS.SINE_COSINE.$3
	MNEGG	FCFUNCS.SINE_COSINE.$T1,FCFUNCS.SINE_COSINE.$T1
FCFUNCS.SINE_COSINE.$3:
	CMPG	FCFUNCS.SINE_COSINE.$T1,FCFUNCS.SINE_COSINE.$KF1
	BLEQ	FCFUNCS.SINE_COSINE.$5
;  501          if (err == 0) err = e_domain
	TSTL	@FCFUNCS.SINE_COSINE.ERR(AP)
	BNEQ	FCFUNCS.SINE_COSINE.$7
	MOVL	#11,@FCFUNCS.SINE_COSINE.ERR(AP)
FCFUNCS.SINE_COSINE.$7:
;  502          return
	RET
FCFUNCS.SINE_COSINE.$5:
;  503        end if
;  504        s = sin(x)
	PUSHAG	@FCFUNCS.SINE_COSINE.X(AP)
	CALLS	#1,G^MTH$GSIN
	MOVG	R0,FCFUNCS.SINE_COSINE.$T1
	MOVG	FCFUNCS.SINE_COSINE.$T1,@FCFUNCS.SINE_COSINE.S(AP)
;  505        c = cos(x)
	PUSHAG	@FCFUNCS.SINE_COSINE.X(AP)
	CALLS	#1,G^MTH$GCOS
	MOVG	R0,FCFUNCS.SINE_COSINE.$T1
	MOVG	FCFUNCS.SINE_COSINE.$T1,@FCFUNCS.SINE_COSINE.C(AP)
;  506        return
	RET
FCFUNCS.SINE_COSINE.$1:
;  507      end if
;  508
;  509      r = v_mod(real_value(x), real_value(turn()))
	PUSHAG	@FCFUNCS.SINE_COSINE.X(AP)
	PUSHAB	FCFUNCS.SINE_COSINE.$T3
	CALLS	#2,G^FCVALUES.REAL_VALUE
	CALLS	#0,G^FCFUNCS.TURN
	MOVG	R0,FCFUNCS.SINE_COSINE.$T1
	PUSHAG	FCFUNCS.SINE_COSINE.$T1
	PUSHAB	FCFUNCS.SINE_COSINE.$T4
	CALLS	#2,G^FCVALUES.REAL_VALUE
	PUSHAB	FCFUNCS.SINE_COSINE.$T4
	PUSHAB	FCFUNCS.SINE_COSINE.$T3
	PUSHAB	FCFUNCS.SINE_COSINE.$T2
	CALLS	#3,G^FCVALUES.V_MOD
	MOVC3	#32,FCFUNCS.SINE_COSINE.$T2,FCFUNCS.SINE_COSINE.R
;  510      t = real(r%z, rk)
	MOVG	FCFUNCS.SINE_COSINE.R,FCFUNCS.SINE_COSINE.T
;  511      quarter = turn() / 4
	CALLS	#0,G^FCFUNCS.TURN
	MOVG	R0,FCFUNCS.SINE_COSINE.$T1
	DIVG3	S^#4.0,FCFUNCS.SINE_COSINE.$T1,FCFUNCS.SINE_COSINE.QUARTER
;  512      if (aint(t / quarter) * quarter == t) then
	DIVG3	FCFUNCS.SINE_COSINE.QUARTER,FCFUNCS.SINE_COSINE.T,FCFUNCS.SINE_COSINE.$T5
	PUSHAG	FCFUNCS.SINE_COSINE.$T5
	CALLS	#1,G^MTH$GINT
	MOVG	R0,FCFUNCS.SINE_COSINE.$T1
	MULG3	FCFUNCS.SINE_COSINE.$T1,FCFUNCS.SINE_COSINE.QUARTER,R0
	CMPG	R0,FCFUNCS.SINE_COSINE.T
	BNEQ	FCFUNCS.SINE_COSINE.$9
;  513        k = nint(t / quarter)
	DIVG3	FCFUNCS.SINE_COSINE.QUARTER,FCFUNCS.SINE_COSINE.T,R0
	CVTRGL	R0,FCFUNCS.SINE_COSINE.K
;  514        s = sines(k)
	MOVL	FCFUNCS.SINE_COSINE.K,R0
	MOVG	FCFUNCS.SINE_COSINE.$K1[R0],@FCFUNCS.SINE_COSINE.S(AP)
;  515        c = cosines(k)
	MOVL	FCFUNCS.SINE_COSINE.K,R0
	MOVG	FCFUNCS.SINE_COSINE.$K2[R0],@FCFUNCS.SINE_COSINE.C(AP)
;  516      else
	RET
FCFUNCS.SINE_COSINE.$9:
;  517        t = t * (2 * pi / turn())
	CALLS	#0,G^FCFUNCS.TURN
	MOVG	R0,FCFUNCS.SINE_COSINE.$T5
	DIVG3	FCFUNCS.SINE_COSINE.$T5,FCFUNCS.SINE_COSINE.$KF2,R0
	MULG2	R0,FCFUNCS.SINE_COSINE.T
;  518        s = sin(t)
	PUSHAG	FCFUNCS.SINE_COSINE.T
	CALLS	#1,G^MTH$GSIN
	MOVG	R0,FCFUNCS.SINE_COSINE.$T5
	MOVG	FCFUNCS.SINE_COSINE.$T5,@FCFUNCS.SINE_COSINE.S(AP)
;  519        c = cos(t)
	PUSHAG	FCFUNCS.SINE_COSINE.T
	CALLS	#1,G^MTH$GCOS
	MOVG	R0,FCFUNCS.SINE_COSINE.$T5
	MOVG	FCFUNCS.SINE_COSINE.$T5,@FCFUNCS.SINE_COSINE.C(AP)
;  520      end if
;  521    end subroutine sine_cosine
	RET

