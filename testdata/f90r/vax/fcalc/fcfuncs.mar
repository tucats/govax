FCFUNCS.RANDOM_VALUE.$T4:
	.BLKL	2			; temporary
FCFUNCS.RANDOM_VALUE.$T5:
	.BLKL	2			; temporary
FCFUNCS.RANDOM_VALUE.$T6:
	.BLKL	2			; temporary
FCFUNCS.RANDOM_VALUE.$T7:
	.BLKL	8			; characters, for one statement
FCFUNCS.RANDOM_VALUE.$T8:
	.BLKL	8			; characters, for one statement
FCFUNCS.RANDOM_VALUE.$T9:
	.BLKL	8			; characters, for one statement
FCFUNCS.RANDOM_VALUE.$T10:
	.BLKL	8			; characters, for one statement

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCFUNCS.RANDOM_VALUE.$K1:
	.LONG	11

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
; 1383
; 1384    ! RANDOM_VALUE is rand(), a number in [0, 1), or rand(a, b), one in
; 1385    ! [a, b), from RANDOM_NUMBER; rand(n) is a whole number from 1 to n.
; 1386    function random_value(args) result(v)
	.ENTRY	FCFUNCS.RANDOM_VALUE,^M<R2,R3,R4,R5,R6>
	MOVL	FCFUNCS.RANDOM_VALUE.ARGS(AP),R0
	MOVL	4(R0),FCFUNCS.RANDOM_VALUE.$B1+4
	MOVL	FCFUNCS.RANDOM_VALUE.ARGS(AP),R0
	CMPB	3(R0),#4
	BEQL	FCFUNCS.RANDOM_VALUE.$1
	MOVL	FCFUNCS.RANDOM_VALUE.ARGS(AP),R0
	MOVL	20(R0),FCFUNCS.RANDOM_VALUE.$B1+20
	MOVL	FCFUNCS.RANDOM_VALUE.ARGS(AP),R0
	MOVL	FCFUNCS.RANDOM_VALUE.ARGS(AP),R1
	SUBL3	24(R1),28(R0),R0
	ADDL3	R0,#1,R6
	BRB	FCFUNCS.RANDOM_VALUE.$3
FCFUNCS.RANDOM_VALUE.$1:
	MOVL	#32,FCFUNCS.RANDOM_VALUE.$B1+20
	MOVL	FCFUNCS.RANDOM_VALUE.ARGS(AP),R0
	MOVL	20(R0),R6
FCFUNCS.RANDOM_VALUE.$3:
	MOVL	#1,FCFUNCS.RANDOM_VALUE.$B1+24
	TSTL	R6
	BGEQ	FCFUNCS.RANDOM_VALUE.$4
	CLRL	R6
FCFUNCS.RANDOM_VALUE.$4:
	MOVL	R6,FCFUNCS.RANDOM_VALUE.$B1+28
	SUBL3	FCFUNCS.RANDOM_VALUE.$B1+20,FCFUNCS.RANDOM_VALUE.$B1+4,FCFUNCS.RANDOM_VALUE.$B1+16
	MULL3	#32,FCFUNCS.RANDOM_VALUE.$B1+28,FCFUNCS.RANDOM_VALUE.$B1+12
; 1387      type(value), intent(in) :: args(:)
; 1388      type(value) :: v
; 1389      real(rk) :: r, a, b
; 1390
; 1391      call random_number(r)
	PUSHAG	FCFUNCS.RANDOM_VALUE.R
	CALLS	#1,G^FTN$RANDOM_G
; 1392      select case (size(args))
	MOVL	FCFUNCS.RANDOM_VALUE.$B1+28,R6
	BGEQ	FCFUNCS.RANDOM_VALUE.$6
	CLRL	R6
FCFUNCS.RANDOM_VALUE.$6:
	TSTL	R6
	BEQL	FCFUNCS.RANDOM_VALUE.$8
	CMPL	R6,#1
	BEQL	FCFUNCS.RANDOM_VALUE.$10
	BRW	FCFUNCS.RANDOM_VALUE.$12
FCFUNCS.RANDOM_VALUE.$8:
; 1393      case (0)
; 1394        v = real_value(r)
	PUSHAG	FCFUNCS.RANDOM_VALUE.R
	PUSHAB	FCFUNCS.RANDOM_VALUE.$T3
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCFUNCS.RANDOM_VALUE.$T3,@FCFUNCS.RANDOM_VALUE.V(AP)
; 1395      case (1)
	RET
FCFUNCS.RANDOM_VALUE.$10:
; 1396        if (.not. whole_argument(args(1), b, v)) return
	PUSHAB	@FCFUNCS.RANDOM_VALUE.V(AP)
	PUSHAG	FCFUNCS.RANDOM_VALUE.B
	ADDL3	FCFUNCS.RANDOM_VALUE.$B1+16,FCFUNCS.RANDOM_VALUE.$B1+20,R0
	PUSHAB	(R0)
	CALLS	#3,G^FCFUNCS.WHOLE_ARGUMENT
	MOVL	R0,R6
	BLBS	R6,FCFUNCS.RANDOM_VALUE.$14
	RET
FCFUNCS.RANDOM_VALUE.$14:
; 1397        if (b < 1) then
	CMPG	FCFUNCS.RANDOM_VALUE.B,S^#1.0
	BGEQ	FCFUNCS.RANDOM_VALUE.$16
; 1398          v = error_value(e_domain)
	PUSHAL	FCFUNCS.RANDOM_VALUE.$K1
	PUSHAB	FCFUNCS.RANDOM_VALUE.$T3
	CALLS	#2,G^FCVALUES.ERROR_VALUE
	MOVC3	#32,FCFUNCS.RANDOM_VALUE.$T3,@FCFUNCS.RANDOM_VALUE.V(AP)
; 1399        else
	RET
FCFUNCS.RANDOM_VALUE.$16:
; 1400          v = real_value(min(aint(r * b) + 1, b))
	MULG3	FCFUNCS.RANDOM_VALUE.R,FCFUNCS.RANDOM_VALUE.B,FCFUNCS.RANDOM_VALUE.$T6
	PUSHAG	FCFUNCS.RANDOM_VALUE.$T6
	CALLS	#1,G^MTH$GINT
	MOVG	R0,FCFUNCS.RANDOM_VALUE.$T5
	ADDG3	FCFUNCS.RANDOM_VALUE.$T5,S^#1.0,FCFUNCS.RANDOM_VALUE.$T4
	CMPG	FCFUNCS.RANDOM_VALUE.B,FCFUNCS.RANDOM_VALUE.$T4
	BGEQ	FCFUNCS.RANDOM_VALUE.$19
	MOVG	FCFUNCS.RANDOM_VALUE.B,FCFUNCS.RANDOM_VALUE.$T4
FCFUNCS.RANDOM_VALUE.$19:
	PUSHAG	FCFUNCS.RANDOM_VALUE.$T4
	PUSHAB	FCFUNCS.RANDOM_VALUE.$T3
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCFUNCS.RANDOM_VALUE.$T3,@FCFUNCS.RANDOM_VALUE.V(AP)
; 1401        end if
; 1402      case default
	RET
FCFUNCS.RANDOM_VALUE.$12:
; 1403        if (.not. real_argument(args(1), a, v)) return
	PUSHAB	@FCFUNCS.RANDOM_VALUE.V(AP)
	PUSHAG	FCFUNCS.RANDOM_VALUE.A
	ADDL3	FCFUNCS.RANDOM_VALUE.$B1+16,FCFUNCS.RANDOM_VALUE.$B1+20,R0
	PUSHAB	(R0)
	CALLS	#3,G^FCFUNCS.REAL_ARGUMENT
	MOVL	R0,R6
	BLBS	R6,FCFUNCS.RANDOM_VALUE.$21
	RET
FCFUNCS.RANDOM_VALUE.$21:
; 1404        if (.not. real_argument(args(2), b, v)) return
	PUSHAB	@FCFUNCS.RANDOM_VALUE.V(AP)
	PUSHAG	FCFUNCS.RANDOM_VALUE.B
	MULL3	#2,FCFUNCS.RANDOM_VALUE.$B1+20,R0
	ADDL2	FCFUNCS.RANDOM_VALUE.$B1+16,R0
	PUSHAB	(R0)
	CALLS	#3,G^FCFUNCS.REAL_ARGUMENT
	MOVL	R0,R6
	BLBS	R6,FCFUNCS.RANDOM_VALUE.$23
	RET
FCFUNCS.RANDOM_VALUE.$23:
; 1405        v = real_value(a) + real_value(b - a) * real_value(r)
	PUSHAG	FCFUNCS.RANDOM_VALUE.A
	PUSHAB	FCFUNCS.RANDOM_VALUE.$T7
	CALLS	#2,G^FCVALUES.REAL_VALUE
	SUBG3	FCFUNCS.RANDOM_VALUE.A,FCFUNCS.RANDOM_VALUE.B,FCFUNCS.RANDOM_VALUE.$T6
	PUSHAG	FCFUNCS.RANDOM_VALUE.$T6
	PUSHAB	FCFUNCS.RANDOM_VALUE.$T9
	CALLS	#2,G^FCVALUES.REAL_VALUE
	PUSHAG	FCFUNCS.RANDOM_VALUE.R
	PUSHAB	FCFUNCS.RANDOM_VALUE.$T10
	CALLS	#2,G^FCVALUES.REAL_VALUE
	PUSHAB	FCFUNCS.RANDOM_VALUE.$T10
	PUSHAB	FCFUNCS.RANDOM_VALUE.$T9
	PUSHAB	FCFUNCS.RANDOM_VALUE.$T8
	CALLS	#3,G^FCVALUES.V_MUL
	PUSHAB	FCFUNCS.RANDOM_VALUE.$T8
	PUSHAB	FCFUNCS.RANDOM_VALUE.$T7
	PUSHAB	FCFUNCS.RANDOM_VALUE.$T3
	CALLS	#3,G^FCVALUES.V_ADD
	MOVC3	#32,FCFUNCS.RANDOM_VALUE.$T3,@FCFUNCS.RANDOM_VALUE.V(AP)
; 1406      end select
; 1407    end function random_value
	RET

; Storage map for FCFUNCS.SEED_RANDOM, a subroutine
;   N      INTEGER, INTENT(IN)       argument 1              @FCFUNCS.SEED_RANDOM.N(AP)
;   SEED   INTEGER, ALLOCATABLE (:)  descriptor at $LOCAL+0  FCFUNCS.SEED_RANDOM.SEED
;   COUNT  INTEGER                   $LOCAL+32               FCFUNCS.SEED_RANDOM.COUNT
;   K      INTEGER                   $LOCAL+36               FCFUNCS.SEED_RANDOM.K
;   R8 is $I1: an array statement's loop index
;   R10 is $T1: temporary
;   R6 is $I2: an array statement's loop index
;   R9 is $L1: constructor (line 1426), implied DO of K's limit
;   R11 is $H1: a value computed before a loop
;   R7 is $R1: an index stepped with $I2
;
FCFUNCS.SEED_RANDOM.N = 4		; N is argument 1

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCFUNCS.SEED_RANDOM.SEED:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_L,DSC$K_CLASS_NCA
	.LONG	0			; SEED: not allocated
	.BYTE	0,0,0,1			; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0			; strides, in bytes
	.LONG	0,0			; bounds
FCFUNCS.SEED_RANDOM.COUNT:
	.BLKL	1			; COUNT
FCFUNCS.SEED_RANDOM.K:
	.BLKL	1			; K

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
; 1408
; 1409    ! SEED_RANDOM is SET SEED N: RANDOM_NUMBER's sequence started again from
; 1410    ! a seed made of N, so the same N gives the same numbers after it.
; 1411    !
; 1412    ! RANDOM_SEED is the intrinsic subroutine that reads or sets the random
; 1413    ! number generator's state, a vector of default integers whose length is
; 1414    ! the compiler's own choice (one on govax, eight under gfortran), which
; 1415    ! SIZE= asks for. So the seed is an allocatable array of that size: each
; 1416    ! element N plus a different amount, since some generators do poorly on
; 1417    ! a seed whose elements are all alike. The sequences themselves differ
; 1418    ! between compilers; only the repetition is the same everywhere.
; 1419    subroutine seed_random(n)
	.ENTRY	FCFUNCS.SEED_RANDOM,^M<R6,R7,R8,R9,R10,R11>
	CLRL	FCFUNCS.SEED_RANDOM.SEED+4
; 1420      integer, intent(in) :: n
; 1421      integer, allocatable :: seed(:)
; 1422      integer :: count, k
; 1423
; 1424      call random_seed(size=count)
	PUSHL	#0
	PUSHL	#0
	PUSHAL	FCFUNCS.SEED_RANDOM.COUNT
	CALLS	#3,G^FTN$RANDOM_SEED
; 1425      allocate (seed(count))
	PUSHL	FCFUNCS.SEED_RANDOM.COUNT
	PUSHL	#1
	PUSHL	#0
	PUSHAQ	FCFUNCS.SEED_RANDOM.SEED
	CALLS	#4,G^FTN$ALLOCATE
; 1426      seed = (/ (n + 7919 * k, k = 1, count) /)
	SUBL3	#1,FCFUNCS.SEED_RANDOM.SEED+24,R10
	CLRL	R8
	MOVL	FCFUNCS.SEED_RANDOM.COUNT,R9 ; constructor (line 1426), implied DO of K's limit
	MOVL	#1,R6
	CMPL	#1,R9
	BGTR	FCFUNCS.SEED_RANDOM.$1
	MOVL	@FCFUNCS.SEED_RANDOM.N(AP),R11 ; from line 1426
	MULL3	#7919,R6,R0
	ADDL3	R11,R0,R7
FCFUNCS.SEED_RANDOM.$3:			; constructor (line 1426), implied DO of K's body
	INCL	R8
	ADDL3	R8,R10,R0
	MOVL	R7,@FCFUNCS.SEED_RANDOM.SEED+16[R0]
	ADDL2	#7919,R7
	AOBLEQ	R9,R6,FCFUNCS.SEED_RANDOM.$3
FCFUNCS.SEED_RANDOM.$1:
; 1427      call random_seed(put=seed)
	PUSHL	#0
	PUSHAL	@FCFUNCS.SEED_RANDOM.SEED+4
	PUSHL	#0
	CALLS	#3,G^FTN$RANDOM_SEED
; 1428      deallocate (seed)
	PUSHL	#0
	PUSHAQ	FCFUNCS.SEED_RANDOM.SEED
	CALLS	#2,G^FTN$DEALLOCATE
; 1429      seed_given = .true.
	MOVL	#-1,FCFUNCS.SEED_GIVEN
; 1430      seed_number = n
	MOVL	@FCFUNCS.SEED_RANDOM.N(AP),FCFUNCS.SEED_NUMBER
; 1431    end subroutine seed_random
	TSTL	FCFUNCS.SEED_RANDOM.SEED+4
	BEQL	FCFUNCS.SEED_RANDOM.$5
	PUSHL	#0
	PUSHAQ	FCFUNCS.SEED_RANDOM.SEED
	CALLS	#2,G^FTN$DEALLOCATE
FCFUNCS.SEED_RANDOM.$5:
	RET
; 1432  end module fcfuncs

	.END
