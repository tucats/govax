;   X               REAL*8, INTENT(OUT)         argument 2  @FCFUNCS.WHOLE_ARGUMENT.X(AP)
;   V               TYPE(VALUE), INTENT(INOUT)  argument 3  @FCFUNCS.WHOLE_ARGUMENT.V(AP)
;   WHOLE_ARGUMENT  LOGICAL                     R8          R8
;   R6 is $T2: temporary
;
FCFUNCS.WHOLE_ARGUMENT.A = 4		; A is argument 1
FCFUNCS.WHOLE_ARGUMENT.X = 8		; X is argument 2
FCFUNCS.WHOLE_ARGUMENT.V = 12		; V is argument 3

