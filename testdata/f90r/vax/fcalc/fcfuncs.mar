	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  648
;  649    ! CIS_VALUE is cos t + i sin t: EXP(it).
;  650    function cis_value(a) result(v)
	.ENTRY	FCFUNCS.CIS_VALUE,^M<R2,R3,R4,R5>
;  651      type(value), intent(in) :: a
;  652      type(value) :: v
;  653      real(rk) :: s, c
;  654      integer :: err
;  655
;  656      if (is_real(a)) then
	PUSHAB	@FCFUNCS.CIS_VALUE.A(AP)
	CALLS	#1,G^FCVALUES.IS_REAL
	MOVL	R0,FCFUNCS.CIS_VALUE.$T1
	BLBC	FCFUNCS.CIS_VALUE.$T1,FCFUNCS.CIS_VALUE.$1
;  657        err = 0
	CLRL	FCFUNCS.CIS_VALUE.ERR
;  658        call sine_cosine(real(a%z, rk), s, c, err)
	MOVG	@FCFUNCS.CIS_VALUE.A(AP),FCFUNCS.CIS_VALUE.$T2
	PUSHAL	FCFUNCS.CIS_VALUE.ERR
	PUSHAG	FCFUNCS.CIS_VALUE.C
	PUSHAG	FCFUNCS.CIS_VALUE.S
	PUSHAG	FCFUNCS.CIS_VALUE.$T2
	CALLS	#4,G^FCFUNCS.SINE_COSINE
;  659        if (err /= 0) then
	TSTL	FCFUNCS.CIS_VALUE.ERR
	BEQL	FCFUNCS.CIS_VALUE.$3
;  660          v = error_value(err)
	PUSHAL	FCFUNCS.CIS_VALUE.ERR
	PUSHAB	FCFUNCS.CIS_VALUE.$T3
	CALLS	#2,G^FCVALUES.ERROR_VALUE
	MOVC3	#32,FCFUNCS.CIS_VALUE.$T3,@FCFUNCS.CIS_VALUE.V(AP)
;  661        else
	RET
FCFUNCS.CIS_VALUE.$3:
;  662          v = complex_value(c, s)
	PUSHAG	FCFUNCS.CIS_VALUE.S
	PUSHAG	FCFUNCS.CIS_VALUE.C
	PUSHAB	FCFUNCS.CIS_VALUE.$T3
	CALLS	#3,G^FCVALUES.COMPLEX_VALUE
	MOVC3	#32,FCFUNCS.CIS_VALUE.$T3,@FCFUNCS.CIS_VALUE.V(AP)
;  663        end if
;  664      else
	RET
FCFUNCS.CIS_VALUE.$1:
;  665        v = exp_value(complex_value(0.0_rk, 1.0_rk) * to_radians(a))
	PUSHAG	FCFUNCS.CIS_VALUE.$K2
	PUSHAG	FCFUNCS.CIS_VALUE.$K1
	PUSHAB	FCFUNCS.CIS_VALUE.$T5
	CALLS	#3,G^FCVALUES.COMPLEX_VALUE
	PUSHAB	@FCFUNCS.CIS_VALUE.A(AP)
	PUSHAB	FCFUNCS.CIS_VALUE.$T6
	CALLS	#2,G^FCFUNCS.TO_RADIANS
	PUSHAB	FCFUNCS.CIS_VALUE.$T6
	PUSHAB	FCFUNCS.CIS_VALUE.$T5
	PUSHAB	FCFUNCS.CIS_VALUE.$T4
	CALLS	#3,G^FCVALUES.V_MUL
	PUSHAB	FCFUNCS.CIS_VALUE.$T4
	PUSHAB	FCFUNCS.CIS_VALUE.$T3
	CALLS	#2,G^FCVALUES.EXP_VALUE
	MOVC3	#32,FCFUNCS.CIS_VALUE.$T3,@FCFUNCS.CIS_VALUE.V(AP)
;  666      end if
;  667    end function cis_value
	RET

