	MOVG	R0,FCFUNCS.TRIG.$T8
	PUSHAG	FCFUNCS.TRIG.X
	CALLS	#1,G^MTH$GSIN
	MOVG	R0,FCFUNCS.TRIG.$T4
	PUSHAG	FCFUNCS.TRIG.Y
	CALLS	#1,G^MTH$GSINH
	MOVG	R0,FCFUNCS.TRIG.$T2
	PUSHAL	FCFUNCS.TRIG.ERR
