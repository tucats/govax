	BEQL	FCFUNCS.TRIG.$18
	CMPC5	R7,(R6),#^A/ /,#3,FCFUNCS.TRIG.$K5
	BEQL	FCFUNCS.TRIG.$20
	CMPC5	R7,(R6),#^A/ /,#3,FCFUNCS.TRIG.$K6
	BEQL	FCFUNCS.TRIG.$22
	CMPC5	R7,(R6),#^A/ /,#3,FCFUNCS.TRIG.$K7
	BEQL	FCFUNCS.TRIG.$24
	BRW	FCFUNCS.TRIG.$26
FCFUNCS.TRIG.$16:
;  566      case ('sin')
;  567        v = s
	MOVC3	#32,FCFUNCS.TRIG.S,@FCFUNCS.TRIG.V(AP)
;  568      case ('cos')
	RET
FCFUNCS.TRIG.$18:
;  569        v = c
	MOVC3	#32,FCFUNCS.TRIG.C,@FCFUNCS.TRIG.V(AP)
