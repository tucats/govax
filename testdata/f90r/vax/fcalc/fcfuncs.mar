FCFUNCS.TRIG.A = 12			; A is argument 3

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
	.ALIGN	4			; the boundary of this routine's aligned records
FCFUNCS.TRIG.S:
	.BLKL	8			; S
FCFUNCS.TRIG.C:
	.BLKL	8			; C
FCFUNCS.TRIG.ANGLE:
	.BLKL	8			; ANGLE
FCFUNCS.TRIG.X:
	.BLKL	2			; X
FCFUNCS.TRIG.Y:
	.BLKL	2			; Y
