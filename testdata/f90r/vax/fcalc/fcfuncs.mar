FCFUNCS.WHOLE_ARGUMENT.$K1:
	.LONG	11
FCFUNCS.WHOLE_ARGUMENT.$K2:
	.LONG	16
FCFUNCS.WHOLE_ARGUMENT.$KF1:
	.LONG	^X6BF5434C,^X00002634	; 4D15

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  289
;  290    ! WHOLE_ARGUMENT: A is a whole number small enough to count with exactly,
;  291    ! and X its value; otherwise V says why not.
;  292    logical function whole_argument(a, x, v)
	.ENTRY	FCFUNCS.WHOLE_ARGUMENT,^M<R2,R3,R4,R5,R6,R7,R8>
;  293      type(value), intent(in) :: a
;  294      real(rk), intent(out) :: x
;  295      type(value), intent(inout) :: v
;  296
;  297      whole_argument = .false.
	CLRL	R8
;  298      if (.not. real_argument(a, x, v)) return
	PUSHAB	@FCFUNCS.WHOLE_ARGUMENT.V(AP)
	PUSHAG	@FCFUNCS.WHOLE_ARGUMENT.X(AP)
	PUSHAB	@FCFUNCS.WHOLE_ARGUMENT.A(AP)
	CALLS	#3,G^FCFUNCS.REAL_ARGUMENT
	MOVL	R0,FCFUNCS.WHOLE_ARGUMENT.$T1
	BLBS	FCFUNCS.WHOLE_ARGUMENT.$T1,FCFUNCS.WHOLE_ARGUMENT.$1
	CLRL	R0			; the function's value
	RET
FCFUNCS.WHOLE_ARGUMENT.$1:
;  299      if (abs(x) >= counting) then
	MOVG	@FCFUNCS.WHOLE_ARGUMENT.X(AP),R6
	BGEQ	FCFUNCS.WHOLE_ARGUMENT.$3
	MNEGG	R6,R6
FCFUNCS.WHOLE_ARGUMENT.$3:
	CMPG	R6,FCFUNCS.WHOLE_ARGUMENT.$KF1
	BLSS	FCFUNCS.WHOLE_ARGUMENT.$5
;  300        v = error_value(e_domain)
	PUSHAL	FCFUNCS.WHOLE_ARGUMENT.$K1
	PUSHAB	FCFUNCS.WHOLE_ARGUMENT.$T3
	CALLS	#2,G^FCVALUES.ERROR_VALUE
	MOVC3	#32,FCFUNCS.WHOLE_ARGUMENT.$T3,@FCFUNCS.WHOLE_ARGUMENT.V(AP)
;  301      else if (aint(x) /= x) then
	BRB	FCFUNCS.WHOLE_ARGUMENT.$7
FCFUNCS.WHOLE_ARGUMENT.$5:
	PUSHAG	@FCFUNCS.WHOLE_ARGUMENT.X(AP)
	CALLS	#1,G^MTH$GINT
	MOVG	R0,R6
	CMPG	R6,@FCFUNCS.WHOLE_ARGUMENT.X(AP)
	BEQL	FCFUNCS.WHOLE_ARGUMENT.$8
;  302        v = error_value(e_notwhole)
	PUSHAL	FCFUNCS.WHOLE_ARGUMENT.$K2
	PUSHAB	FCFUNCS.WHOLE_ARGUMENT.$T3
	CALLS	#2,G^FCVALUES.ERROR_VALUE
	MOVC3	#32,FCFUNCS.WHOLE_ARGUMENT.$T3,@FCFUNCS.WHOLE_ARGUMENT.V(AP)
;  303      else
	BRB	FCFUNCS.WHOLE_ARGUMENT.$7
FCFUNCS.WHOLE_ARGUMENT.$8:
;  304        whole_argument = .true.
	MOVL	#-1,R8
;  305      end if
FCFUNCS.WHOLE_ARGUMENT.$7:
;  306    end function whole_argument
	MOVL	R8,R0			; the function's value
	RET

; Storage map for FCFUNCS.SQRT_VALUE, a TYPE(VALUE) function
;   V     TYPE(VALUE)              hidden argument 1  @FCFUNCS.SQRT_VALUE.V(AP)
;   A     TYPE(VALUE), INTENT(IN)  argument 2         @FCFUNCS.SQRT_VALUE.A(AP)
;   X     REAL*8                   $LOCAL+0           FCFUNCS.SQRT_VALUE.X
;   Y     REAL*8                   $LOCAL+8           FCFUNCS.SQRT_VALUE.Y
;   T     REAL*8                   $LOCAL+16          FCFUNCS.SQRT_VALUE.T
;   Q     REAL*8                   $LOCAL+24          FCFUNCS.SQRT_VALUE.Q
;   ERR   INTEGER                  $LOCAL+32          FCFUNCS.SQRT_VALUE.ERR
;
FCFUNCS.SQRT_VALUE.V = 4		; V's value goes through hidden argument 1
FCFUNCS.SQRT_VALUE.A = 8		; A is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCFUNCS.SQRT_VALUE.X:
	.BLKL	2			; X
FCFUNCS.SQRT_VALUE.Y:
	.BLKL	2			; Y
FCFUNCS.SQRT_VALUE.T:
	.BLKL	2			; T
FCFUNCS.SQRT_VALUE.Q:
	.BLKL	2			; Q
FCFUNCS.SQRT_VALUE.ERR:
	.BLKL	1			; ERR
FCFUNCS.SQRT_VALUE.$T1:
	.BLKL	8			; characters, for one statement
FCFUNCS.SQRT_VALUE.$T2:
	.BLKL	2			; temporary
FCFUNCS.SQRT_VALUE.$T3:
	.BLKL	2			; temporary
FCFUNCS.SQRT_VALUE.$T4:
	.BLKL	2			; temporary
FCFUNCS.SQRT_VALUE.$T5:
	.BLKL	2			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCFUNCS.SQRT_VALUE.$K1:
	.LONG	^X00000000,^X00000000	; 0D0

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  307
;  308    ! ------------------------------------------------------------------
;  309    ! Roots, exponentials, and logarithms.
;  310
;  311    ! SQRT_VALUE is the principal square root, the one with a positive real
;  312    ! part, by the stable formula: T = SQRT((|x| + |z|) / 2) is the larger
;  313    ! part's magnitude, and the other is y / 2T.
;  314    function sqrt_value(a) result(v)
	.ENTRY	FCFUNCS.SQRT_VALUE,^M<R2,R3,R4,R5>
;  315      type(value), intent(in) :: a
;  316      type(value) :: v
;  317      real(rk) :: x, y, t, q
;  318      integer :: err
;  319
;  320      x = real(a%z, rk)
	MOVG	@FCFUNCS.SQRT_VALUE.A(AP),FCFUNCS.SQRT_VALUE.X
;  321      y = aimag(a%z)
	MOVL	FCFUNCS.SQRT_VALUE.A(AP),R0
	MOVG	8(R0),FCFUNCS.SQRT_VALUE.Y
;  322      if (y == 0) then
	BEQL	FCFUNCS.SQRT_VALUE.$2
	BRW	FCFUNCS.SQRT_VALUE.$1
FCFUNCS.SQRT_VALUE.$2:
;  323        if (x >= 0) then
	TSTG	FCFUNCS.SQRT_VALUE.X
	BLSS	FCFUNCS.SQRT_VALUE.$3
;  324          v = real_value(sqrt(x))
	PUSHAG	FCFUNCS.SQRT_VALUE.X
	CALLS	#1,G^MTH$GSQRT
	MOVG	R0,FCFUNCS.SQRT_VALUE.$T2
	PUSHAG	FCFUNCS.SQRT_VALUE.$T2
	PUSHAB	FCFUNCS.SQRT_VALUE.$T1
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCFUNCS.SQRT_VALUE.$T1,@FCFUNCS.SQRT_VALUE.V(AP)
;  325        else
	RET
FCFUNCS.SQRT_VALUE.$3:
;  326          v = complex_value(0.0_rk, sqrt(-x))
	MNEGG	FCFUNCS.SQRT_VALUE.X,FCFUNCS.SQRT_VALUE.$T3
	PUSHAG	FCFUNCS.SQRT_VALUE.$T3
	CALLS	#1,G^MTH$GSQRT
	MOVG	R0,FCFUNCS.SQRT_VALUE.$T2
	PUSHAG	FCFUNCS.SQRT_VALUE.$T2
	PUSHAG	FCFUNCS.SQRT_VALUE.$K1
	PUSHAB	FCFUNCS.SQRT_VALUE.$T1
	CALLS	#3,G^FCVALUES.COMPLEX_VALUE
	MOVC3	#32,FCFUNCS.SQRT_VALUE.$T1,@FCFUNCS.SQRT_VALUE.V(AP)
;  327        end if
;  328        return
	RET
FCFUNCS.SQRT_VALUE.$1:
;  329      end if
;  330
;  331      t = sqrt((abs(x) + c_abs(a%z)) / 2)
	MOVG	FCFUNCS.SQRT_VALUE.X,FCFUNCS.SQRT_VALUE.$T2
	BGEQ	FCFUNCS.SQRT_VALUE.$6
	MNEGG	FCFUNCS.SQRT_VALUE.$T2,FCFUNCS.SQRT_VALUE.$T2
FCFUNCS.SQRT_VALUE.$6:
	PUSHAO	@FCFUNCS.SQRT_VALUE.A(AP)
	CALLS	#1,G^FCVALUES.C_ABS
	MOVG	R0,FCFUNCS.SQRT_VALUE.$T4
	ADDG3	FCFUNCS.SQRT_VALUE.$T2,FCFUNCS.SQRT_VALUE.$T4,R0
	DIVG3	S^#2.0,R0,FCFUNCS.SQRT_VALUE.$T5
	PUSHAG	FCFUNCS.SQRT_VALUE.$T5
	CALLS	#1,G^MTH$GSQRT
	MOVG	R0,FCFUNCS.SQRT_VALUE.$T3
	MOVG	FCFUNCS.SQRT_VALUE.$T3,FCFUNCS.SQRT_VALUE.T
;  332      err = 0
	CLRL	FCFUNCS.SQRT_VALUE.ERR
;  333      q = r_div(abs(y), 2 * t, err)
	MOVG	FCFUNCS.SQRT_VALUE.Y,FCFUNCS.SQRT_VALUE.$T5
	BGEQ	FCFUNCS.SQRT_VALUE.$8
	MNEGG	FCFUNCS.SQRT_VALUE.$T5,FCFUNCS.SQRT_VALUE.$T5
FCFUNCS.SQRT_VALUE.$8:
	MULG3	S^#2.0,FCFUNCS.SQRT_VALUE.T,FCFUNCS.SQRT_VALUE.$T4
	PUSHAL	FCFUNCS.SQRT_VALUE.ERR
	PUSHAG	FCFUNCS.SQRT_VALUE.$T4
	PUSHAG	FCFUNCS.SQRT_VALUE.$T5
	CALLS	#3,G^FCVALUES.R_DIV
	MOVG	R0,FCFUNCS.SQRT_VALUE.Q
;  334      if (x >= 0) then
	TSTG	FCFUNCS.SQRT_VALUE.X
	BLSS	FCFUNCS.SQRT_VALUE.$10
;  335        if (y < 0) q = -q
	TSTG	FCFUNCS.SQRT_VALUE.Y
	BGEQ	FCFUNCS.SQRT_VALUE.$12
	MNEGG	FCFUNCS.SQRT_VALUE.Q,FCFUNCS.SQRT_VALUE.Q
FCFUNCS.SQRT_VALUE.$12:
;  336        v = complex_value(t, q)
	PUSHAG	FCFUNCS.SQRT_VALUE.Q
	PUSHAG	FCFUNCS.SQRT_VALUE.T
	PUSHAB	FCFUNCS.SQRT_VALUE.$T1
	CALLS	#3,G^FCVALUES.COMPLEX_VALUE
	MOVC3	#32,FCFUNCS.SQRT_VALUE.$T1,@FCFUNCS.SQRT_VALUE.V(AP)
;  337      else if (y > 0) then
	RET
FCFUNCS.SQRT_VALUE.$10:
	TSTG	FCFUNCS.SQRT_VALUE.Y
	BLEQ	FCFUNCS.SQRT_VALUE.$15
;  338        v = complex_value(q, t)
	PUSHAG	FCFUNCS.SQRT_VALUE.T
	PUSHAG	FCFUNCS.SQRT_VALUE.Q
	PUSHAB	FCFUNCS.SQRT_VALUE.$T1
	CALLS	#3,G^FCVALUES.COMPLEX_VALUE
	MOVC3	#32,FCFUNCS.SQRT_VALUE.$T1,@FCFUNCS.SQRT_VALUE.V(AP)
;  339      else
	RET
FCFUNCS.SQRT_VALUE.$15:
;  340        v = complex_value(q, -t)
	MNEGG	FCFUNCS.SQRT_VALUE.T,FCFUNCS.SQRT_VALUE.$T4
	PUSHAG	FCFUNCS.SQRT_VALUE.$T4
	PUSHAG	FCFUNCS.SQRT_VALUE.Q
	PUSHAB	FCFUNCS.SQRT_VALUE.$T1
	CALLS	#3,G^FCVALUES.COMPLEX_VALUE
	MOVC3	#32,FCFUNCS.SQRT_VALUE.$T1,@FCFUNCS.SQRT_VALUE.V(AP)
;  341      end if
;  342    end function sqrt_value
	RET

; Storage map for FCFUNCS.CBRT_VALUE, a TYPE(VALUE) function
