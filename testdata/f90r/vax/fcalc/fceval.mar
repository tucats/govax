FCEVAL.MAP_BUILTIN.$32:
;  752          r = apply_builtin(id, these)
	MOVAB	@FCEVAL.MAP_BUILTIN.THESE+4,FCEVAL.MAP_BUILTIN.$D1+4
	MOVL	#32,FCEVAL.MAP_BUILTIN.$D1+20
	MOVL	#1,FCEVAL.MAP_BUILTIN.$D1+24
