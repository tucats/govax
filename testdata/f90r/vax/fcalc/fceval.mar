	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  853
;  854    ! PICKED is the elements of X that LIST names, counted in array element
;  855    ! order: X laid out flat by RESHAPE, then picked by LIST as a vector
;  856    ! subscript, FLAT(LIST).
;  857    function picked(x, list) result(v)
	.ENTRY	FCEVAL.PICKED,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVL	FCEVAL.PICKED.LIST(AP),R0
	MOVL	4(R0),FCEVAL.PICKED.$B1+4
	MOVL	FCEVAL.PICKED.LIST(AP),R0
	CMPB	3(R0),#4
	BEQL	FCEVAL.PICKED.$1
	MOVL	FCEVAL.PICKED.LIST(AP),R0
	MOVL	20(R0),FCEVAL.PICKED.$B1+20
	MOVL	FCEVAL.PICKED.LIST(AP),R0
	MOVL	FCEVAL.PICKED.LIST(AP),R1
	SUBL3	24(R1),28(R0),R0
	ADDL3	R0,#1,FCEVAL.PICKED.$T1
	BRB	FCEVAL.PICKED.$3
FCEVAL.PICKED.$1:
	MOVL	#4,FCEVAL.PICKED.$B1+20
	MOVL	FCEVAL.PICKED.LIST(AP),R0
	MOVL	20(R0),FCEVAL.PICKED.$T1
FCEVAL.PICKED.$3:
	MOVL	#1,FCEVAL.PICKED.$B1+24
	TSTL	FCEVAL.PICKED.$T1
	BGEQ	FCEVAL.PICKED.$4
	CLRL	FCEVAL.PICKED.$T1
FCEVAL.PICKED.$4:
	MOVL	FCEVAL.PICKED.$T1,FCEVAL.PICKED.$B1+28
	SUBL3	FCEVAL.PICKED.$B1+20,FCEVAL.PICKED.$B1+4,FCEVAL.PICKED.$B1+16
	MULL3	#4,FCEVAL.PICKED.$B1+28,FCEVAL.PICKED.$B1+12
	MOVL	FCEVAL.PICKED.X(AP),R0
	MULL3	@FCEVAL.PICKED.X(AP),4(R0),FCEVAL.PICKED.FLAT+28
	MOVL	FCEVAL.PICKED.FLAT+28,FCEVAL.PICKED.FLAT+20
	BGEQ	FCEVAL.PICKED.$6
	CLRL	FCEVAL.PICKED.FLAT+20
FCEVAL.PICKED.$6:
	MULL3	#16,FCEVAL.PICKED.FLAT+20,FCEVAL.PICKED.FLAT+12
	SUBL2	FCEVAL.PICKED.FLAT+12,SP ; storage of a size known only now
	BICL2	#3,SP
	MOVL	SP,FCEVAL.PICKED.FLAT+4
	MOVL	FCEVAL.PICKED.FLAT+4,R0
	MOVAO	-16(R0),FCEVAL.PICKED.FLAT+16
;  858      type(quantity), intent(in) :: x
;  859      integer, intent(in) :: list(:)
;  860      type(quantity) :: v
;  861      complex(rk) :: flat(x%rows * x%cols)
;  862
;  863      flat = reshape(elements_of(x), (/ numel(x) /))
	PUSHAB	@FCEVAL.PICKED.X(AP)
	CALLS	#1,G^FCARRAYS.NUMEL
	MOVL	R0,FCEVAL.PICKED.$W2
	MOVL	#1,R6
FCEVAL.PICKED.$8:			; array (line 863), dimension 1's body
	MOVL	FCEVAL.PICKED.$W2-4[R6],FCEVAL.PICKED.$W1-4[R6]
	AOBLEQ	#1,R6,FCEVAL.PICKED.$8
	MOVL	FCEVAL.PICKED.$W1,FCEVAL.PICKED.$T1
	BGEQ	FCEVAL.PICKED.$10
	CLRL	FCEVAL.PICKED.$T1
FCEVAL.PICKED.$10:
	MOVL	FCEVAL.PICKED.$T1,FCEVAL.PICKED.$R1+20
	MOVL	FCEVAL.PICKED.$R1+20,FCEVAL.PICKED.$R1+28
	MULL3	#16,FCEVAL.PICKED.$R1+20,FCEVAL.PICKED.$R1+12
	MOVL	SP,FCEVAL.PICKED.$T2	; where the statement's storage starts
	CMPL	FCEVAL.PICKED.$R1+12,#65536
	BGTR	FCEVAL.PICKED.$12
	SUBL2	FCEVAL.PICKED.$R1+12,SP	; storage of a size known only now
	BICL2	#3,SP
	MOVL	SP,FCEVAL.PICKED.$R1+4
	BRB	FCEVAL.PICKED.$14
FCEVAL.PICKED.$12:
	PUSHAQ	FCEVAL.PICKED.$R1
	CALLS	#1,G^FTN$GET_TEMP
FCEVAL.PICKED.$14:
	MOVL	FCEVAL.PICKED.$R1+4,R0
	MOVAO	-16(R0),FCEVAL.PICKED.$R1+16
	TSTL	FCEVAL.PICKED.$G1+4
	BEQL	FCEVAL.PICKED.$15
	PUSHL	#0
	PUSHAQ	FCEVAL.PICKED.$G1
	CALLS	#2,G^FTN$DEALLOCATE
FCEVAL.PICKED.$15:
	PUSHAB	@FCEVAL.PICKED.X(AP)
	PUSHAQ	FCEVAL.PICKED.$G1
	CALLS	#2,G^FCARRAYS.ELEMENTS_OF
	SUBL3	FCEVAL.PICKED.$G1+28,FCEVAL.PICKED.$G1+32,R0
	ADDL3	R0,#1,FCEVAL.PICKED.$T5
	BGEQ	FCEVAL.PICKED.$17
	CLRL	FCEVAL.PICKED.$T5
FCEVAL.PICKED.$17:
	SUBL3	FCEVAL.PICKED.$G1+36,FCEVAL.PICKED.$G1+40,R0
