	.LONG	0			; $W: not allocated
	.BYTE	0,0,^XE0,2		; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0,0			; multipliers
	.LONG	1,0,1,0			; bounds
	.BLKB	8
FCEVAL.PICKED.$L8:
	.BLKL	1			; array (line 865), dimension 2's limit
	.BLKB	4
FCEVAL.PICKED.$R4:
	.WORD	16			; length
	.BYTE	DSC$K_DTYPE_GC,DSC$K_CLASS_A
	.LONG	0			; $W: not allocated
	.BYTE	0,0,^XE0,2		; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0,0			; multipliers
