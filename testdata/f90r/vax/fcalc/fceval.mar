;  498
;  499      subroutine release_parts(n)
FCEVAL.LITERAL_PARTS.$N3:
	.WORD	^M<R6,R7,R8,R10>	; internal procedure RELEASE_PARTS of FCEVAL.LITERAL_PARTS
	MOVL	FCEVAL.LITERAL_PARTS.$N3.$HOST(AP),R10 ; the FP of FCEVAL.LITERAL_PARTS, for its frame
