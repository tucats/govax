FCEVAL.INDEX_LIST.$19:
;  938        if (lo + (n - 1) * stride < 1 .or. lo + (n - 1) * stride > extent) return
	SUBL3	#1,R6,R0
	MULL2	FCEVAL.INDEX_LIST.STRIDE(FP),R0
