	MOVL	R0,R7
	BLBS	R7,FCEVAL.INDEX_LIST.$5
	CLRL	R0			; the function's value
	RET
FCEVAL.INDEX_LIST.$5:
;  919          part => part%next
	MOVL	FCEVAL.INDEX_LIST.PART(FP),R0
	MOVL	84(R0),FCEVAL.INDEX_LIST.PART(FP)
;  920        end if
FCEVAL.INDEX_LIST.$3:
;  921        if (iand(p%op, range_hi) /= 0) then
	MOVL	@FCEVAL.INDEX_LIST.P(AP),R0
	BICL3	#-3,4(R0),R0
	BEQL	FCEVAL.INDEX_LIST.$7
;  922          if (.not. index_number(part, hi, err, f)) return
	PUSHAB	@FCEVAL.INDEX_LIST.$A5(FP)
	PUSHAL	@FCEVAL.INDEX_LIST.ERR(AP)
	PUSHAL	FCEVAL.INDEX_LIST.HI(FP)
	PUSHAL	FCEVAL.INDEX_LIST.PART(FP)
