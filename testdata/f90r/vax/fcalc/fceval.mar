FCEVAL.CALL_FUNCTION.FN = -124		; FN, in the frame
FCEVAL.CALL_FUNCTION.N = -120		; N, in the frame
FCEVAL.CALL_FUNCTION.ID = -116		; ID, in the frame
FCEVAL.CALL_FUNCTION.$A4 = -112		; F's longword of the argument list, set at each entry point, in the frame
FCEVAL.CALL_FUNCTION.$D1 = -108		; a descriptor, written whole at each use, in the frame
FCEVAL.CALL_FUNCTION.$T1 = -100		; temporary, in the frame
FCEVAL.CALL_FUNCTION.$T3 = -96		; characters, for one statement, in the frame

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCEVAL.CALL_FUNCTION.$K2:
	.LONG	7
FCEVAL.CALL_FUNCTION.$K1:
	.ASCII	/if/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  534
;  535    ! CALL_FUNCTION is the value of the call P: of IF, a built-in function,
;  536    ! an index of a parameter, a user's function, or an index of a variable,
;  537    ! in that order.
;  538    recursive function call_function(p, at, f) result(v)
	.ENTRY	FCEVAL.CALL_FUNCTION,^M<R2,R3,R4,R5,R6>
	SUBL2	#220,SP			; this activation's own storage
	CLRL	FCEVAL.CALL_FUNCTION.$A4(FP) ; F is argument 4, if the caller passed it
	CMPB	(AP),#4
	BLSSU	FCEVAL.CALL_FUNCTION.$23
	MOVL	16(AP),FCEVAL.CALL_FUNCTION.$A4(FP)
FCEVAL.CALL_FUNCTION.$23:
	CLRL	FCEVAL.CALL_FUNCTION.X+52(FP)
	CLRL	FCEVAL.CALL_FUNCTION.FN(FP)
;  539      type(node), pointer :: p
;  540      integer, intent(in) :: at
;  541      type(frame), intent(in), optional :: f
;  542      type(quantity) :: v
;  543      type(quantity) :: x
;  544      type(function_entry), pointer :: fn
;  545      integer :: n, id
;  546
;  547      n = argument_count(p)
	PUSHAL	@FCEVAL.CALL_FUNCTION.P(AP)
	CALLS	#1,G^FCEVAL.ARGUMENT_COUNT
	MOVL	R0,FCEVAL.CALL_FUNCTION.N(FP)
;  548
;  549      id = builtin_index(p%name)
	MOVL	#17694751,FCEVAL.CALL_FUNCTION.$D1(FP) ; the descriptor's length, 31, type, and class
	MOVL	@FCEVAL.CALL_FUNCTION.P(AP),R0
	MOVAB	12(R0),FCEVAL.CALL_FUNCTION.$D1+4(FP)
	PUSHAQ	FCEVAL.CALL_FUNCTION.$D1(FP)
	CALLS	#1,G^FCFUNCS.BUILTIN_INDEX
	MOVL	R0,FCEVAL.CALL_FUNCTION.ID(FP)
;  550      if (id > 0) then
	BGTR	FCEVAL.CALL_FUNCTION.$2
	BRW	FCEVAL.CALL_FUNCTION.$1
FCEVAL.CALL_FUNCTION.$2:
;  551        if (.not. takes_list(id) .and. .not. arity_ok(id, n)) then
	PUSHAL	FCEVAL.CALL_FUNCTION.ID(FP)
	CALLS	#1,G^FCFUNCS.TAKES_LIST
	MOVL	R0,FCEVAL.CALL_FUNCTION.$T1(FP)
	PUSHAL	FCEVAL.CALL_FUNCTION.N(FP)
	PUSHAL	FCEVAL.CALL_FUNCTION.ID(FP)
	CALLS	#2,G^FCFUNCS.ARITY_OK
	MOVL	R0,R6
	BLBS	FCEVAL.CALL_FUNCTION.$T1(FP),FCEVAL.CALL_FUNCTION.$3
	BLBS	R6,FCEVAL.CALL_FUNCTION.$3
;  552          v = wrong_count(p, at)
	PUSHAL	@FCEVAL.CALL_FUNCTION.AT(AP)
	PUSHAL	@FCEVAL.CALL_FUNCTION.P(AP)
	PUSHAB	FCEVAL.CALL_FUNCTION.$T3(FP)
	CALLS	#3,G^FCEVAL.WRONG_COUNT
	MOVC3	#96,FCEVAL.CALL_FUNCTION.$T3(FP),@FCEVAL.CALL_FUNCTION.V(AP)
;  553        else if (p%name == 'if') then
	RET
FCEVAL.CALL_FUNCTION.$3:
	MOVL	@FCEVAL.CALL_FUNCTION.P(AP),R0
	CMPC5	#31,12(R0),#^A/ /,#2,FCEVAL.CALL_FUNCTION.$K1
	BNEQ	FCEVAL.CALL_FUNCTION.$7
;  554          v = choose(p, f)
	PUSHAB	@FCEVAL.CALL_FUNCTION.$A4(FP)
	PUSHAL	@FCEVAL.CALL_FUNCTION.P(AP)
	PUSHAB	FCEVAL.CALL_FUNCTION.$T3(FP)
	CALLS	#3,G^FCEVAL.CHOOSE
	MOVC3	#96,FCEVAL.CALL_FUNCTION.$T3(FP),@FCEVAL.CALL_FUNCTION.V(AP)
;  555        else
	RET
FCEVAL.CALL_FUNCTION.$7:
;  556          v = call_builtin(p, id, n, at, f)
	PUSHAB	@FCEVAL.CALL_FUNCTION.$A4(FP)
	PUSHAL	@FCEVAL.CALL_FUNCTION.AT(AP)
	PUSHAL	FCEVAL.CALL_FUNCTION.N(FP)
	PUSHAL	FCEVAL.CALL_FUNCTION.ID(FP)
	PUSHAL	@FCEVAL.CALL_FUNCTION.P(AP)
	PUSHAB	FCEVAL.CALL_FUNCTION.$T3(FP)
	CALLS	#6,G^FCEVAL.CALL_BUILTIN
	MOVC3	#96,FCEVAL.CALL_FUNCTION.$T3(FP),@FCEVAL.CALL_FUNCTION.V(AP)
;  557        end if
;  558        return
	RET
FCEVAL.CALL_FUNCTION.$1:
;  559      end if
;  560
;  561      id = matrix_index(p%name)
	MOVL	#17694751,FCEVAL.CALL_FUNCTION.$D1(FP) ; the descriptor's length, 31, type, and class
	MOVL	@FCEVAL.CALL_FUNCTION.P(AP),R0
	MOVAB	12(R0),FCEVAL.CALL_FUNCTION.$D1+4(FP)
	PUSHAQ	FCEVAL.CALL_FUNCTION.$D1(FP)
	CALLS	#1,G^FCMATRIX.MATRIX_INDEX
	MOVL	R0,FCEVAL.CALL_FUNCTION.ID(FP)
;  562      if (id > 0) then
	BLEQ	FCEVAL.CALL_FUNCTION.$9
;  563        if (.not. matrix_arity_ok(id, n)) then
	PUSHAL	FCEVAL.CALL_FUNCTION.N(FP)
	PUSHAL	FCEVAL.CALL_FUNCTION.ID(FP)
	CALLS	#2,G^FCMATRIX.MATRIX_ARITY_OK
	MOVL	R0,R6
	BLBS	R6,FCEVAL.CALL_FUNCTION.$11
;  564          v = wrong_count(p, at)
	PUSHAL	@FCEVAL.CALL_FUNCTION.AT(AP)
	PUSHAL	@FCEVAL.CALL_FUNCTION.P(AP)
	PUSHAB	FCEVAL.CALL_FUNCTION.$T3(FP)
	CALLS	#3,G^FCEVAL.WRONG_COUNT
	MOVC3	#96,FCEVAL.CALL_FUNCTION.$T3(FP),@FCEVAL.CALL_FUNCTION.V(AP)
;  565        else
	RET
FCEVAL.CALL_FUNCTION.$11:
;  566          v = call_matrix(p, id, n, f)
	PUSHAB	@FCEVAL.CALL_FUNCTION.$A4(FP)
	PUSHAL	FCEVAL.CALL_FUNCTION.N(FP)
	PUSHAL	FCEVAL.CALL_FUNCTION.ID(FP)
	PUSHAL	@FCEVAL.CALL_FUNCTION.P(AP)
	PUSHAB	FCEVAL.CALL_FUNCTION.$T3(FP)
	CALLS	#5,G^FCEVAL.CALL_MATRIX
	MOVC3	#96,FCEVAL.CALL_FUNCTION.$T3(FP),@FCEVAL.CALL_FUNCTION.V(AP)
;  567        end if
;  568        return
	RET
FCEVAL.CALL_FUNCTION.$9:
;  569      end if
;  570
;  571      if (parameter_value(p%name, x, f)) then
	MOVL	#17694751,FCEVAL.CALL_FUNCTION.$D1(FP) ; the descriptor's length, 31, type, and class
	MOVL	@FCEVAL.CALL_FUNCTION.P(AP),R0
	MOVAB	12(R0),FCEVAL.CALL_FUNCTION.$D1+4(FP)
	PUSHAB	@FCEVAL.CALL_FUNCTION.$A4(FP)
	PUSHAB	FCEVAL.CALL_FUNCTION.X(FP)
	PUSHAQ	FCEVAL.CALL_FUNCTION.$D1(FP)
	CALLS	#3,G^FCEVAL.PARAMETER_VALUE
	MOVL	R0,R6
	BLBC	R6,FCEVAL.CALL_FUNCTION.$14
;  572        v = index_of(x, p, at, f)
	PUSHAB	@FCEVAL.CALL_FUNCTION.$A4(FP)
	PUSHAL	@FCEVAL.CALL_FUNCTION.AT(AP)
	PUSHAL	@FCEVAL.CALL_FUNCTION.P(AP)
	PUSHAB	FCEVAL.CALL_FUNCTION.X(FP)
	PUSHAB	FCEVAL.CALL_FUNCTION.$T3(FP)
	CALLS	#5,G^FCEVAL.INDEX_OF
	MOVC3	#96,FCEVAL.CALL_FUNCTION.$T3(FP),@FCEVAL.CALL_FUNCTION.V(AP)
;  573        call release(x)
	PUSHAB	FCEVAL.CALL_FUNCTION.X(FP)
	CALLS	#1,G^FCARRAYS.RELEASE
;  574        return
	RET
FCEVAL.CALL_FUNCTION.$14:
;  575      end if
;  576
;  577      fn => find_function(p%name)
	MOVL	#17694751,FCEVAL.CALL_FUNCTION.$D1(FP) ; the descriptor's length, 31, type, and class
	MOVL	@FCEVAL.CALL_FUNCTION.P(AP),R0
	MOVAB	12(R0),FCEVAL.CALL_FUNCTION.$D1+4(FP)
	PUSHAQ	FCEVAL.CALL_FUNCTION.$D1(FP)
	CALLS	#1,G^FCSYMBOLS.FIND_FUNCTION
	MOVL	R0,R6
	MOVL	R6,FCEVAL.CALL_FUNCTION.FN(FP)
;  578      if (associated(fn)) then
	BEQL	FCEVAL.CALL_FUNCTION.$16
;  579        if (fn%count /= n) then
	MOVL	FCEVAL.CALL_FUNCTION.FN(FP),R0
	CMPL	32(R0),FCEVAL.CALL_FUNCTION.N(FP)
	BEQL	FCEVAL.CALL_FUNCTION.$18
;  580          v = wrong_count(p, at)
	PUSHAL	@FCEVAL.CALL_FUNCTION.AT(AP)
	PUSHAL	@FCEVAL.CALL_FUNCTION.P(AP)
	PUSHAB	FCEVAL.CALL_FUNCTION.$T3(FP)
	CALLS	#3,G^FCEVAL.WRONG_COUNT
	MOVC3	#96,FCEVAL.CALL_FUNCTION.$T3(FP),@FCEVAL.CALL_FUNCTION.V(AP)
;  581        else
	RET
FCEVAL.CALL_FUNCTION.$18:
;  582          v = call_user(p, fn, at, f)
	PUSHAB	@FCEVAL.CALL_FUNCTION.$A4(FP)
	PUSHAL	@FCEVAL.CALL_FUNCTION.AT(AP)
	PUSHAL	FCEVAL.CALL_FUNCTION.FN(FP)
	PUSHAL	@FCEVAL.CALL_FUNCTION.P(AP)
	PUSHAB	FCEVAL.CALL_FUNCTION.$T3(FP)
	CALLS	#5,G^FCEVAL.CALL_USER
	MOVC3	#96,FCEVAL.CALL_FUNCTION.$T3(FP),@FCEVAL.CALL_FUNCTION.V(AP)
;  583        end if
;  584        return
	RET
FCEVAL.CALL_FUNCTION.$16:
;  585      end if
;  586
;  587      if (find_variable(p%name, x)) then
	MOVL	#17694751,FCEVAL.CALL_FUNCTION.$D1(FP) ; the descriptor's length, 31, type, and class
	MOVL	@FCEVAL.CALL_FUNCTION.P(AP),R0
	MOVAB	12(R0),FCEVAL.CALL_FUNCTION.$D1+4(FP)
	PUSHAB	FCEVAL.CALL_FUNCTION.X(FP)
	PUSHAQ	FCEVAL.CALL_FUNCTION.$D1(FP)
	CALLS	#2,G^FCSYMBOLS.FIND_VARIABLE
	MOVL	R0,R6
	BLBC	R6,FCEVAL.CALL_FUNCTION.$21
;  588        v = index_of(x, p, at, f)
	PUSHAB	@FCEVAL.CALL_FUNCTION.$A4(FP)
	PUSHAL	@FCEVAL.CALL_FUNCTION.AT(AP)
	PUSHAL	@FCEVAL.CALL_FUNCTION.P(AP)
	PUSHAB	FCEVAL.CALL_FUNCTION.X(FP)
	PUSHAB	FCEVAL.CALL_FUNCTION.$T3(FP)
	CALLS	#5,G^FCEVAL.INDEX_OF
	MOVC3	#96,FCEVAL.CALL_FUNCTION.$T3(FP),@FCEVAL.CALL_FUNCTION.V(AP)
;  589        call release(x)
	PUSHAB	FCEVAL.CALL_FUNCTION.X(FP)
	CALLS	#1,G^FCARRAYS.RELEASE
;  590        return
	RET
FCEVAL.CALL_FUNCTION.$21:
;  591      end if
;  592
;  593      call fail(e_nofunc, at, text=p%name)
	MOVL	#17694751,FCEVAL.CALL_FUNCTION.$D1(FP) ; the descriptor's length, 31, type, and class
	MOVL	@FCEVAL.CALL_FUNCTION.P(AP),R0
	MOVAB	12(R0),FCEVAL.CALL_FUNCTION.$D1+4(FP)
	PUSHAQ	FCEVAL.CALL_FUNCTION.$D1(FP)
	PUSHAL	@FCEVAL.CALL_FUNCTION.AT(AP)
	PUSHAL	FCEVAL.CALL_FUNCTION.$K2
	CALLS	#3,G^FCMESSAGES.FAIL
;  594      v = failure(e_nofunc)
	PUSHAL	FCEVAL.CALL_FUNCTION.$K2
	PUSHAB	FCEVAL.CALL_FUNCTION.$T3(FP)
	CALLS	#2,G^FCARRAYS.FAILURE
	MOVC3	#96,FCEVAL.CALL_FUNCTION.$T3(FP),@FCEVAL.CALL_FUNCTION.V(AP)
;  595    end function call_function
	RET

; Storage map for FCEVAL.WRONG_COUNT, a TYPE(QUANTITY) function
;   V     TYPE(QUANTITY)       hidden argument 1  @FCEVAL.WRONG_COUNT.V(AP)
;   P     TYPE(NODE), POINTER  argument 2         @FCEVAL.WRONG_COUNT.P(AP)
;   AT    INTEGER, INTENT(IN)  argument 3         @FCEVAL.WRONG_COUNT.AT(AP)
;
FCEVAL.WRONG_COUNT.V = 4		; V's value goes through hidden argument 1
FCEVAL.WRONG_COUNT.P = 8		; P is argument 2
FCEVAL.WRONG_COUNT.AT = 12		; AT is argument 3

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCEVAL.WRONG_COUNT.$D1:
	.WORD	31			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used
FCEVAL.WRONG_COUNT.$T1:
	.BLKL	24			; characters, for one statement

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCEVAL.WRONG_COUNT.$K1:
	.LONG	22

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  596
;  597    function wrong_count(p, at) result(v)
	.ENTRY	FCEVAL.WRONG_COUNT,^M<R2,R3,R4,R5>
;  598      type(node), pointer :: p
;  599      integer, intent(in) :: at
;  600      type(quantity) :: v
;  601
;  602      call fail(e_argcount, at, text=p%name)
	MOVL	@FCEVAL.WRONG_COUNT.P(AP),R0
	MOVAB	12(R0),FCEVAL.WRONG_COUNT.$D1+4
	PUSHAQ	FCEVAL.WRONG_COUNT.$D1
	PUSHAL	@FCEVAL.WRONG_COUNT.AT(AP)
	PUSHAL	FCEVAL.WRONG_COUNT.$K1
	CALLS	#3,G^FCMESSAGES.FAIL
;  603      v = failure(e_argcount)
	PUSHAL	FCEVAL.WRONG_COUNT.$K1
	PUSHAB	FCEVAL.WRONG_COUNT.$T1
	CALLS	#2,G^FCARRAYS.FAILURE
	MOVC3	#96,FCEVAL.WRONG_COUNT.$T1,@FCEVAL.WRONG_COUNT.V(AP)
;  604    end function wrong_count
	RET

; Storage map for FCEVAL.CHOOSE, a RECURSIVE TYPE(QUANTITY) function
;   V       TYPE(QUANTITY)                     hidden argument 1  @FCEVAL.CHOOSE.V(AP)
;   P       TYPE(NODE), POINTER                argument 2         @FCEVAL.CHOOSE.P(AP)
;   F       TYPE(FRAME), INTENT(IN), OPTIONAL  an argument        @FCEVAL.CHOOSE.$A3(FP)
;   ARM     TYPE(NODE), POINTER                FP-112             FCEVAL.CHOOSE.ARM(FP)
;   CHOSEN  LOGICAL                            FP-108             FCEVAL.CHOOSE.CHOSEN(FP)
;
FCEVAL.CHOOSE.V = 4			; V's value goes through hidden argument 1
FCEVAL.CHOOSE.P = 8			; P is argument 2
FCEVAL.CHOOSE.ARM = -112		; ARM, in the frame
FCEVAL.CHOOSE.CHOSEN = -108		; CHOSEN, in the frame
FCEVAL.CHOOSE.$A3 = -104		; F's longword of the argument list, set at each entry point, in the frame
FCEVAL.CHOOSE.$T1 = -100		; characters, for one statement, in the frame
FCEVAL.CHOOSE.$T2 = -4			; temporary, in the frame

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  605
;  606    ! CHOOSE is if(c, a, b): A's value if C is true (not zero; an array is
;  607    ! true if no element is zero), and B's if not. Only the arm chosen is
;  608    ! evaluated, so a recursive function can stop: in if(n < 2, 1, n *
;  609    ! fact(n - 1)) the call is made only while n is 2 or more.
;  610    recursive function choose(p, f) result(v)
	.ENTRY	FCEVAL.CHOOSE,^M<R2,R3,R4,R5>
	SUBL2	#112,SP			; this activation's own storage
	CLRL	FCEVAL.CHOOSE.$A3(FP)	; F is argument 3, if the caller passed it
	CMPB	(AP),#3
	BLSSU	FCEVAL.CHOOSE.$6
	MOVL	12(AP),FCEVAL.CHOOSE.$A3(FP)
FCEVAL.CHOOSE.$6:
	CLRL	FCEVAL.CHOOSE.ARM(FP)
;  611      type(node), pointer :: p
;  612      type(frame), intent(in), optional :: f
;  613      type(quantity) :: v
;  614      type(node), pointer :: arm
;  615      logical :: chosen
;  616
;  617      v = evaluate(p%kid, f)
	PUSHAB	@FCEVAL.CHOOSE.$A3(FP)
	MOVL	@FCEVAL.CHOOSE.P(AP),R0
	PUSHAL	80(R0)
	PUSHAB	FCEVAL.CHOOSE.$T1(FP)
	CALLS	#3,G^FCEVAL.EVALUATE
	MOVC3	#96,FCEVAL.CHOOSE.$T1(FP),@FCEVAL.CHOOSE.V(AP)
;  618      if (quantity_error(v) /= 0) return
	PUSHAB	@FCEVAL.CHOOSE.V(AP)
	CALLS	#1,G^FCARRAYS.QUANTITY_ERROR
	MOVL	R0,FCEVAL.CHOOSE.$T2(FP)
	BEQL	FCEVAL.CHOOSE.$1
	RET
FCEVAL.CHOOSE.$1:
;  619      chosen = quantity_truth(v)
	PUSHAB	@FCEVAL.CHOOSE.V(AP)
	CALLS	#1,G^FCARRAYS.QUANTITY_TRUTH
	MOVL	R0,FCEVAL.CHOOSE.CHOSEN(FP)
;  620      call release(v)
	PUSHAB	@FCEVAL.CHOOSE.V(AP)
	CALLS	#1,G^FCARRAYS.RELEASE
;  621      if (chosen) then
	BLBC	FCEVAL.CHOOSE.CHOSEN(FP),FCEVAL.CHOOSE.$3
;  622        arm => p%kid%next
	MOVL	@FCEVAL.CHOOSE.P(AP),R0
	MOVL	80(R0),R0
	MOVL	84(R0),FCEVAL.CHOOSE.ARM(FP)
;  623      else
	BRB	FCEVAL.CHOOSE.$5
FCEVAL.CHOOSE.$3:
;  624        arm => p%kid%next%next
	MOVL	@FCEVAL.CHOOSE.P(AP),R0
	MOVL	80(R0),R0
	MOVL	84(R0),R0
	MOVL	84(R0),FCEVAL.CHOOSE.ARM(FP)
;  625      end if
FCEVAL.CHOOSE.$5:
;  626      v = evaluate(arm, f)
	PUSHAB	@FCEVAL.CHOOSE.$A3(FP)
	PUSHAL	FCEVAL.CHOOSE.ARM(FP)
	PUSHAB	FCEVAL.CHOOSE.$T1(FP)
	CALLS	#3,G^FCEVAL.EVALUATE
	MOVC3	#96,FCEVAL.CHOOSE.$T1(FP),@FCEVAL.CHOOSE.V(AP)
;  627    end function choose
	RET

; Storage map for FCEVAL.EVALUATE_ARGUMENTS, a RECURSIVE LOGICAL function
;   P     TYPE(NODE), POINTER                argument 1   @FCEVAL.EVALUATE_ARGUMENTS.P(AP)
;   N     INTEGER, INTENT(IN)                argument 2   @FCEVAL.EVALUATE_ARGUMENTS.N(AP)
;   ARGS  TYPE(QUANTITY), INTENT(OUT) (?)    argument 3   @FCEVAL.EVALUATE_ARGUMENTS.ARGS(AP)
;   BAD   TYPE(QUANTITY), INTENT(OUT)        argument 4   @FCEVAL.EVALUATE_ARGUMENTS.BAD(AP)
;   F     TYPE(FRAME), INTENT(IN), OPTIONAL  an argument  @FCEVAL.EVALUATE_ARGUMENTS.$A5(FP)
;   OK    LOGICAL                            FP-148       FCEVAL.EVALUATE_ARGUMENTS.OK(FP)
;   A     TYPE(NODE), POINTER                FP-144       FCEVAL.EVALUATE_ARGUMENTS.A(FP)
;   K     INTEGER                            R7           R7
;   J     INTEGER                            R6           R6
;   R10 is $L1: DO (line 644)'s limit
;   R6 is $T2: temporary
;   R8 is $L2: DO (line 648)'s limit
;   R6 is $U1: temporary
;   R8 is $R1: an index stepped with K
;   R7 is $R2: an index stepped with J
;   R9 is $R3: an address in $B1
;   R9 is $R4: an address in $B1
;   R11 is $R5: F's address
;
FCEVAL.EVALUATE_ARGUMENTS.P = 4		; P is argument 1
FCEVAL.EVALUATE_ARGUMENTS.N = 8		; N is argument 2
FCEVAL.EVALUATE_ARGUMENTS.ARGS = 12	; ARGS is argument 3
FCEVAL.EVALUATE_ARGUMENTS.BAD = 16	; BAD is argument 4
FCEVAL.EVALUATE_ARGUMENTS.OK = -148	; OK, the function's value, in the frame
FCEVAL.EVALUATE_ARGUMENTS.A = -144	; A, in the frame
FCEVAL.EVALUATE_ARGUMENTS.$A5 = -132	; F's longword of the argument list, set at each entry point, in the frame
FCEVAL.EVALUATE_ARGUMENTS.$B1 = -128	; ARGS's descriptor, filled in at each entry point, in the frame
FCEVAL.EVALUATE_ARGUMENTS.$T1 = -96	; characters, for one statement, in the frame

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCEVAL.EVALUATE_ARGUMENTS.$K1:
	.LONG	^X00000000,^X00000000	; 0D0

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  628
;  629    ! EVALUATE_ARGUMENTS evaluates the call P's N arguments into ARGS; if one
;  630    ! fails, those before it are released and the result is false, BAD the
;  631    ! failure.
;  632    recursive logical function evaluate_arguments(p, n, args, bad, f) result(ok)
	.ENTRY	FCEVAL.EVALUATE_ARGUMENTS,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	SUBL2	#148,SP			; this activation's own storage
	CLRL	FCEVAL.EVALUATE_ARGUMENTS.$A5(FP) ; F is argument 5, if the caller passed it
	CMPB	(AP),#5
	BLSSU	FCEVAL.EVALUATE_ARGUMENTS.$11
	MOVL	20(AP),FCEVAL.EVALUATE_ARGUMENTS.$A5(FP)
FCEVAL.EVALUATE_ARGUMENTS.$11:
	MOVL	#67108960,FCEVAL.EVALUATE_ARGUMENTS.$B1(FP) ; the descriptor's length, 96, type, and class
	MOVL	#31457280,FCEVAL.EVALUATE_ARGUMENTS.$B1+8(FP) ; its flags and dimensions
	CLRL	FCEVAL.EVALUATE_ARGUMENTS.$B1+12(FP) ; the array's size in bytes
	CLRL	FCEVAL.EVALUATE_ARGUMENTS.$B1+20(FP) ; dimension 1's multiplier
	MOVL	#1,FCEVAL.EVALUATE_ARGUMENTS.$B1+24(FP) ; dimension 1's lower bound
	CLRL	FCEVAL.EVALUATE_ARGUMENTS.$B1+28(FP) ; dimension 1's upper bound
	MOVAB	@FCEVAL.EVALUATE_ARGUMENTS.ARGS(AP),FCEVAL.EVALUATE_ARGUMENTS.$B1+4(FP)
	MOVL	@FCEVAL.EVALUATE_ARGUMENTS.N(AP),FCEVAL.EVALUATE_ARGUMENTS.$B1+28(FP)
	MOVL	FCEVAL.EVALUATE_ARGUMENTS.$B1+28(FP),FCEVAL.EVALUATE_ARGUMENTS.$B1+20(FP)
	MOVL	#-96,R0
	MOVAB	@FCEVAL.EVALUATE_ARGUMENTS.ARGS(AP)[R0],FCEVAL.EVALUATE_ARGUMENTS.$B1+16(FP)
