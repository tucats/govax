;  894    ! ALLOCATABLE (Fortran 2003 does), so a routine that allocates an array
;  895    ! for its caller allocates a pointer's target, which the caller must
;  896    ! DEALLOCATE.
;  897    recursive logical function index_list(p, extent, list, err, f) result(ok)
	.ENTRY	FCEVAL.INDEX_LIST,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	SUBL2	#288,SP			; this activation's own storage
