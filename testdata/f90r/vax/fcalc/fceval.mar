	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;   84
;   85    ! COLUMN_OF is the column an error at the node P is reported at: P's own,
;   86    ! or, inside a user's function, the call's.
;   87    !
;   88    ! (F is tested and used in two IF statements, not one: Fortran doesn't
;   89    ! promise to skip .AND.'s right operand when its left is false, so
;   90    ! PRESENT(F) .AND. F%COLUMN > 0 could touch an absent F.)
;   91    integer function column_of(p, f)
	.ENTRY	FCEVAL.COLUMN_OF,^M<R6>
	CLRL	FCEVAL.COLUMN_OF.$A2	; F is argument 2, if the caller passed it
	CMPB	(AP),#2
	BLSSU	FCEVAL.COLUMN_OF.$5
	MOVL	8(AP),FCEVAL.COLUMN_OF.$A2
FCEVAL.COLUMN_OF.$5:
;   92      type(node), pointer :: p
;   93      type(frame), intent(in), optional :: f
;   94
;   95      column_of = p%column
	MOVL	@FCEVAL.COLUMN_OF.P(AP),R0
	MOVL	8(R0),R6
;   96      if (present(f)) then
	TSTL	FCEVAL.COLUMN_OF.$A2
	BEQL	FCEVAL.COLUMN_OF.$1
;   97        if (f%column > 0) column_of = f%column
	MOVL	FCEVAL.COLUMN_OF.$A2,R0
	TSTL	4(R0)
	BLEQ	FCEVAL.COLUMN_OF.$3
	MOVL	FCEVAL.COLUMN_OF.$A2,R0
	MOVL	4(R0),R6
FCEVAL.COLUMN_OF.$3:
;   98      end if
FCEVAL.COLUMN_OF.$1:
;   99    end function column_of
	MOVL	R6,R0			; the function's value
	RET

