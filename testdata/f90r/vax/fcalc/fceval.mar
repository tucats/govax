FCEVAL.PICKED.$T5:
	.BLKL	1			; temporary
	.BLKB	4
FCEVAL.PICKED.$T7:
	.BLKL	1			; temporary
FCEVAL.PICKED.$R2:
	.WORD	16			; length
	.BYTE	DSC$K_DTYPE_GC,DSC$K_CLASS_A
	.LONG	0			; $W: not allocated
	.BYTE	0,0,^XE0,1		; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0			; multipliers
	.LONG	1,0			; bounds
	.BLKB	20
FCEVAL.PICKED.$T11:
	.BLKL	1			; temporary
	.BLKB	4
FCEVAL.PICKED.$L2:
	.BLKL	1			; array (line 863), dimension 2's limit
	.BLKB	4
FCEVAL.PICKED.$T13:
