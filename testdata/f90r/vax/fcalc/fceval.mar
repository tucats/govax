;    1  ! fcalc: the evaluator, which walks a tree to its value.
;    2  !
;    3  ! EVALUATE is recursive: an operation's value is its operands' values,
;    4  ! combined by FCVALUES' operators. An error in a value (a division by zero,
;    5  ! an overflow) is reported at the node it arose in, with that node's
;    6  ! column, the first one found being the one FAIL keeps: so the pointer goes
;    7  ! to the innermost operation that failed.
;    8  !
;    9  ! Values are QUANTITYs (module FCARRAYS), scalars or arrays, and EVALUATE
;   10  ! keeps FCARRAYS' rule of ownership: every quantity it returns is new, the
;   11  ! caller's to release, and each operation releases its operands once it
;   12  ! has its result. An operation on arrays is done element by element (+, -,
;   13  ! .*, ./, .^, mod, the comparisons, and, or, not, and every function of
;   14  ! FCFUNCS but those of lists), a scalar operand combining with every
;   15  ! element of the other; or is a matrix operation of FCMATRIX's (*, /, \,
;   16  ! ^, and the transposes ' and .').
;   17  !
;   18  ! A call of a user's function, f(2, 3), evaluates its arguments, puts them
;   19  ! in a FRAME beside the names of the function's parameters, and evaluates
;   20  ! the function's tree with that frame: a name in the tree is looked for
;   21  ! among the frame's parameters first, then among the constants and the
;   22  ! variables. Each call has a frame of its own, a local variable of the
;   23  ! recursive CALL_USER, so a function that calls itself,
;   24  !
;   25  !     fact(n) = if(n < 2, 1, n * fact(n - 1))
;   26  !
;   27  ! has a frame for each level, as a compiled recursive routine has a stack
;   28  ! frame for each. The depth of such calls is limited to CALL_LIMIT, so a
;   29  ! function that never stops calling itself is an error, not the end of
;   30  ! the stack.
;   31  !
;   32  ! NAME(...) is, in this order: a built-in function's call, an index of a
;   33  ! parameter, a user's function's call, an index of a variable. So a
;   34  ! variable named like a function is reached by its name alone, and v(2)
;   35  ! is an element of v unless v is also a function.
;   36  !
;   37  ! The tree of a function was parsed from the line that defined it, so its
;   38  ! columns are that line's, not the one being evaluated. Inside a function
;   39  ! an error is reported at the column of the call the user typed: the
;   40  ! frame carries it (FRAME%COLUMN), and every node evaluated with a frame
;   41  ! reports there.
;   42  module fceval
;   43    use fckinds
;   44    use fcmessages
;   45    use fcvalues
;   46    use fcarrays
;   47    use fctree
;   48    use fcsymbols
;   49    use fcfuncs
;   50    use fcmatrix
;   51    implicit none
;   52    private
;   53
;   54    ! NODE, VALUE, QUANTITY, and FRAME are public here too: a public
;   55    ! procedure's argument and value may not be of a type private in this
;   56    ! module.
;   57    public :: node, value, quantity, frame
;   58    public :: evaluate, evaluate_with, assign_into, known_function
;   59
;   60    ! The values of one call's parameters, by name. VALUES(1:COUNT) are the
;   61    ! frame's to release when the call ends. COLUMN is where an error inside
;   62    ! the call is reported, or 0 to report it at the node it arose in (as
;   63    ! EVALUATE_WITH's frames do).
;   64    type frame
;   65      integer :: count
;   66      integer :: column
;   67      character(len=name_length) :: names(max_params)
;   68      type(quantity) :: values(max_params)
;   69    end type frame
;   70
;   71    ! How deeply calls of users' functions may nest, and how deeply they are
;   72    ! nested now.
;   73    integer, parameter :: call_limit = 200
;   74    integer, save :: calls = 0
;   75
;   76  contains

; Storage map for FCEVAL.KNOWN_FUNCTION, a LOGICAL function
;   NAME            CHARACTER*(*), INTENT(IN)  argument 1  @FCEVAL.KNOWN_FUNCTION.NAME(AP)
;   KNOWN_FUNCTION  LOGICAL                    $LOCAL+0    FCEVAL.KNOWN_FUNCTION.$N1
;   FCEVAL.KNOWN_FUNCTION.$N1 is FCEVAL.KNOWN_FUNCTION.KNOWN_FUNCTION
;
FCEVAL.KNOWN_FUNCTION.NAME = 4		; NAME is argument 1

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCEVAL.KNOWN_FUNCTION.$N1:
	.BLKL	1			; KNOWN_FUNCTION, the function's value
FCEVAL.KNOWN_FUNCTION.$T1:
	.BLKL	1			; temporary
FCEVAL.KNOWN_FUNCTION.$T2:
	.BLKL	1			; temporary

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;   77
;   78    ! KNOWN_FUNCTION: NAME is a built-in function, of FCFUNCS' or FCMATRIX's.
;   79    logical function known_function(name)
	.ENTRY	FCEVAL.KNOWN_FUNCTION,^M<>
;   80      character(len=*), intent(in) :: name
;   81
;   82      known_function = builtin_index(name) > 0 .or. matrix_index(name) > 0
	PUSHL	FCEVAL.KNOWN_FUNCTION.NAME(AP)
	CALLS	#1,G^FCFUNCS.BUILTIN_INDEX
	MOVL	R0,FCEVAL.KNOWN_FUNCTION.$T1
	PUSHL	FCEVAL.KNOWN_FUNCTION.NAME(AP)
	CALLS	#1,G^FCMATRIX.MATRIX_INDEX
	MOVL	R0,FCEVAL.KNOWN_FUNCTION.$T2
;   83    end function known_function
	CLRL	R0			; the function's value
	TSTL	FCEVAL.KNOWN_FUNCTION.$T1
	BLEQ	FCEVAL.KNOWN_FUNCTION.$1
	MNEGL	#1,R0
FCEVAL.KNOWN_FUNCTION.$1:
	CLRL	R1
	TSTL	FCEVAL.KNOWN_FUNCTION.$T2
	BLEQ	FCEVAL.KNOWN_FUNCTION.$2
	MNEGL	#1,R1
FCEVAL.KNOWN_FUNCTION.$2:
	BISL2	R1,R0
	RET

