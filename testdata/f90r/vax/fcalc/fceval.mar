;  932          return
	CLRL	R0			; the function's value
	RET
FCEVAL.INDEX_LIST.$15:
;  933        end if
;  934        n = (hi - lo + stride) / stride
	SUBL3	FCEVAL.INDEX_LIST.LO(FP),FCEVAL.INDEX_LIST.HI(FP),R0
