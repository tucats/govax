	ADDL2	FCEVAL.INDEX_LIST.STRIDE(FP),R6
	AOBLEQ	R11,R8,FCEVAL.INDEX_LIST.$29
FCEVAL.INDEX_LIST.$27:
;  944        ok = .true.
;  945        return
	MOVL	#-1,R0			; the function's value
	RET
FCEVAL.INDEX_LIST.$1:
;  946      end if
;  947
;  948      x = evaluate(p, f)
	PUSHAB	@FCEVAL.INDEX_LIST.$A5(FP)
	PUSHAL	@FCEVAL.INDEX_LIST.P(AP)
	PUSHAB	FCEVAL.INDEX_LIST.$T2(FP)
	CALLS	#3,G^FCEVAL.EVALUATE
	MOVC3	#96,FCEVAL.INDEX_LIST.$T2(FP),FCEVAL.INDEX_LIST.X(FP)
