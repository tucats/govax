	BEQL	FCEVAL.INDEX_LIST.$31
;  950        err = quantity_error(x)
	PUSHAB	FCEVAL.INDEX_LIST.X(FP)
	CALLS	#1,G^FCARRAYS.QUANTITY_ERROR
