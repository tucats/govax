; 1070      subroutine put(l, k)
FCEVAL.ASSIGN_INTO.PUT:
	.WORD	^M<R2,R3,R4,R5,R6,R7>	; internal procedure PUT of FCEVAL.ASSIGN_INTO
; 1071        integer, intent(in) :: l, k
