;  118      v = evaluate(p, f)
	PUSHAB	FCEVAL.EVALUATE_WITH.F
	PUSHAL	@FCEVAL.EVALUATE_WITH.P(AP)
	PUSHAB	FCEVAL.EVALUATE_WITH.$T1
	CALLS	#3,G^FCEVAL.EVALUATE
	MOVC3	#96,FCEVAL.EVALUATE_WITH.$T1,@FCEVAL.EVALUATE_WITH.V(AP)
;  119      call release(f%values(1))
	PUSHAB	FCEVAL.EVALUATE_WITH.F+256
	CALLS	#1,G^FCARRAYS.RELEASE
;  120    end function evaluate_with
	RET

