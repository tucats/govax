; Storage map for FCEVAL.CALL_MATRIX, a RECURSIVE TYPE(QUANTITY) function
;   V     TYPE(QUANTITY)                     hidden argument 1  @FCEVAL.CALL_MATRIX.V(AP)
;   P     TYPE(NODE), POINTER                argument 2         @FCEVAL.CALL_MATRIX.P(AP)
;   ID    INTEGER, INTENT(IN)                argument 3         @FCEVAL.CALL_MATRIX.ID(AP)
;   N     INTEGER, INTENT(IN)                argument 4         @FCEVAL.CALL_MATRIX.N(AP)
;   F     TYPE(FRAME), INTENT(IN), OPTIONAL  an argument        @FCEVAL.CALL_MATRIX.$A5(FP)
;   ARGS  TYPE(QUANTITY) (?)                 FP-164             FCEVAL.CALL_MATRIX.ARGS(FP)
;   R6 is $T1: temporary
;   R7 is $T2: temporary
;
FCEVAL.CALL_MATRIX.V = 4		; V's value goes through hidden argument 1
FCEVAL.CALL_MATRIX.P = 8		; P is argument 2
FCEVAL.CALL_MATRIX.ID = 12		; ID is argument 3
FCEVAL.CALL_MATRIX.N = 16		; N is argument 4
FCEVAL.CALL_MATRIX.ARGS = -164		; ARGS, TYPE(QUANTITY) (?), automatic: its descriptor, in the frame
FCEVAL.CALL_MATRIX.$A5 = -132		; F's longword of the argument list, set at each entry point, in the frame
FCEVAL.CALL_MATRIX.$T3 = -128		; characters, for one statement, in the frame
FCEVAL.CALL_MATRIX.$D1 = -32		; a descriptor, written whole at each use, in the frame

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  762
;  763    ! CALL_MATRIX is a call of one of FCMATRIX's functions.
;  764    recursive function call_matrix(p, id, n, f) result(v)
	.ENTRY	FCEVAL.CALL_MATRIX,^M<R2,R3,R4,R5,R6,R7>
	SUBL2	#164,SP			; this activation's own storage
	CLRL	FCEVAL.CALL_MATRIX.$A5(FP) ; F is argument 5, if the caller passed it
	CMPB	(AP),#5
	BLSSU	FCEVAL.CALL_MATRIX.$9
	MOVL	20(AP),FCEVAL.CALL_MATRIX.$A5(FP)
FCEVAL.CALL_MATRIX.$9:
	MOVL	#67108960,FCEVAL.CALL_MATRIX.ARGS(FP) ; the descriptor's length, 96, type, and class
	MOVL	#31457280,FCEVAL.CALL_MATRIX.ARGS+8(FP) ; its flags and dimensions
	CLRL	FCEVAL.CALL_MATRIX.ARGS+12(FP) ; the array's size in bytes
	CLRL	FCEVAL.CALL_MATRIX.ARGS+20(FP) ; dimension 1's multiplier
	MOVL	#1,FCEVAL.CALL_MATRIX.ARGS+24(FP) ; dimension 1's lower bound
	CLRL	FCEVAL.CALL_MATRIX.ARGS+28(FP) ; dimension 1's upper bound
	MOVL	@FCEVAL.CALL_MATRIX.N(AP),FCEVAL.CALL_MATRIX.ARGS+28(FP)
	MOVL	FCEVAL.CALL_MATRIX.ARGS+28(FP),FCEVAL.CALL_MATRIX.ARGS+20(FP)
	BGEQ	FCEVAL.CALL_MATRIX.$1
	CLRL	FCEVAL.CALL_MATRIX.ARGS+20(FP) ; dimension 1's multiplier
FCEVAL.CALL_MATRIX.$1:
	MULL3	#96,FCEVAL.CALL_MATRIX.ARGS+20(FP),FCEVAL.CALL_MATRIX.ARGS+12(FP)
	SUBL2	FCEVAL.CALL_MATRIX.ARGS+12(FP),SP ; storage of a size known only now
	BICL2	#3,SP
	MOVL	SP,FCEVAL.CALL_MATRIX.ARGS+4(FP)
	MOVAB	@FCEVAL.CALL_MATRIX.ARGS+4(FP),R6
	DIVL3	#96,FCEVAL.CALL_MATRIX.ARGS+12(FP),R7
	BLEQ	FCEVAL.CALL_MATRIX.$3
FCEVAL.CALL_MATRIX.$5:			; clears QUANTITY's pointers
	CLRL	52(R6)
	ADDL2	#96,R6
	SOBGTR	R7,FCEVAL.CALL_MATRIX.$5
FCEVAL.CALL_MATRIX.$3:
	MOVL	FCEVAL.CALL_MATRIX.ARGS+4(FP),R0
	MOVAB	-96(R0),FCEVAL.CALL_MATRIX.ARGS+16(FP)
;  765      type(node), pointer :: p
;  766      integer, intent(in) :: id, n
;  767      type(frame), intent(in), optional :: f
;  768      type(quantity) :: v
;  769      type(quantity) :: args(n)
;  770
;  771      if (.not. evaluate_arguments(p, n, args, v, f)) return
	PUSHAB	@FCEVAL.CALL_MATRIX.$A5(FP)
	PUSHAB	@FCEVAL.CALL_MATRIX.V(AP)
	PUSHAB	@FCEVAL.CALL_MATRIX.ARGS+4(FP)
	PUSHAL	@FCEVAL.CALL_MATRIX.N(AP)
	PUSHAL	@FCEVAL.CALL_MATRIX.P(AP)
	CALLS	#5,G^FCEVAL.EVALUATE_ARGUMENTS
	MOVL	R0,R7
	BLBS	R7,FCEVAL.CALL_MATRIX.$7
	RET
FCEVAL.CALL_MATRIX.$7:
;  772      v = apply_matrix(id, args)
	MOVL	#167772256,FCEVAL.CALL_MATRIX.$D1(FP) ; the descriptor's length, 96, type, and class
	CLRL	FCEVAL.CALL_MATRIX.$D1+4(FP) ; no string yet
	MOVL	#16777216,FCEVAL.CALL_MATRIX.$D1+8(FP) ; its flags and dimensions
	MOVAB	@FCEVAL.CALL_MATRIX.ARGS+4(FP),FCEVAL.CALL_MATRIX.$D1+4(FP)
	MOVL	#96,FCEVAL.CALL_MATRIX.$D1+20(FP) ; dimension 1's multiplier
	MOVL	#1,FCEVAL.CALL_MATRIX.$D1+24(FP) ; dimension 1's lower bound
	MOVL	FCEVAL.CALL_MATRIX.ARGS+28(FP),FCEVAL.CALL_MATRIX.$D1+28(FP)
	SUBL3	#96,FCEVAL.CALL_MATRIX.$D1+4(FP),FCEVAL.CALL_MATRIX.$D1+16(FP)
	MULL3	#96,FCEVAL.CALL_MATRIX.ARGS+20(FP),FCEVAL.CALL_MATRIX.$D1+12(FP)
	PUSHAQ	FCEVAL.CALL_MATRIX.$D1(FP)
	PUSHAL	@FCEVAL.CALL_MATRIX.ID(AP)
	PUSHAB	FCEVAL.CALL_MATRIX.$T3(FP)
	CALLS	#3,G^FCMATRIX.APPLY_MATRIX
	MOVC3	#96,FCEVAL.CALL_MATRIX.$T3(FP),@FCEVAL.CALL_MATRIX.V(AP)
;  773      call release_all(args)
	MOVL	#167772256,FCEVAL.CALL_MATRIX.$D1(FP) ; the descriptor's length, 96, type, and class
	CLRL	FCEVAL.CALL_MATRIX.$D1+4(FP) ; no string yet
	MOVL	#16777216,FCEVAL.CALL_MATRIX.$D1+8(FP) ; its flags and dimensions
	MOVAB	@FCEVAL.CALL_MATRIX.ARGS+4(FP),FCEVAL.CALL_MATRIX.$D1+4(FP)
	MOVL	#96,FCEVAL.CALL_MATRIX.$D1+20(FP) ; dimension 1's multiplier
	MOVL	#1,FCEVAL.CALL_MATRIX.$D1+24(FP) ; dimension 1's lower bound
	MOVL	FCEVAL.CALL_MATRIX.ARGS+28(FP),FCEVAL.CALL_MATRIX.$D1+28(FP)
	SUBL3	#96,FCEVAL.CALL_MATRIX.$D1+4(FP),FCEVAL.CALL_MATRIX.$D1+16(FP)
	MULL3	#96,FCEVAL.CALL_MATRIX.ARGS+20(FP),FCEVAL.CALL_MATRIX.$D1+12(FP)
	PUSHAQ	FCEVAL.CALL_MATRIX.$D1(FP)
	CALLS	#1,G^FCEVAL.RELEASE_ALL
;  774    end function call_matrix
	RET

; Storage map for FCEVAL.CALL_USER, a RECURSIVE TYPE(QUANTITY) function
;   V      TYPE(QUANTITY)                     hidden argument 1  @FCEVAL.CALL_USER.V(AP)
;   P      TYPE(NODE), POINTER                argument 2         @FCEVAL.CALL_USER.P(AP)
;   FN     TYPE(FUNCTION_ENTRY), POINTER      argument 3         @FCEVAL.CALL_USER.FN(AP)
;   AT     INTEGER, INTENT(IN)                argument 4         @FCEVAL.CALL_USER.AT(AP)
;   F      TYPE(FRAME), INTENT(IN), OPTIONAL  an argument        @FCEVAL.CALL_USER.$A5(FP)
;   INNER  TYPE(FRAME)                        FP-1160            FCEVAL.CALL_USER.INNER(FP)
;   R7 is $I1: an array statement's loop index
;   R6 is $T2: temporary
;   R6 is $T3: temporary
;   R9 is $L1: array (line 790), dimension 1's limit
;   R6 is $U1: temporary
;   R8 is $R1: an index stepped with $I1
;   R10 is $R2: FN's address
;
FCEVAL.CALL_USER.V = 4			; V's value goes through hidden argument 1
FCEVAL.CALL_USER.P = 8			; P is argument 2
FCEVAL.CALL_USER.FN = 12		; FN is argument 3
FCEVAL.CALL_USER.AT = 16		; AT is argument 4
FCEVAL.CALL_USER.INNER = -1160		; INNER, in the frame
FCEVAL.CALL_USER.$A5 = -136		; F's longword of the argument list, set at each entry point, in the frame
FCEVAL.CALL_USER.$T1 = -132		; temporary, in the frame
FCEVAL.CALL_USER.$T4 = -128		; characters, for one statement, in the frame
FCEVAL.CALL_USER.$D1 = -32		; a descriptor, written whole at each use, in the frame

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCEVAL.CALL_USER.$K1:
	.LONG	24

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  775
;  776    ! CALL_USER is the call P of the user's function FN: its arguments,
;  777    ! evaluated in the caller's frame F, become a new frame, INNER, in which
;  778    ! FN's tree is evaluated. INNER owns its values, and releases them when
;  779    ! the call is done.
;  780    recursive function call_user(p, fn, at, f) result(v)
	.ENTRY	FCEVAL.CALL_USER,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10>
	SUBL2	#1160,SP		; this activation's own storage
	CLRL	FCEVAL.CALL_USER.$A5(FP) ; F is argument 5, if the caller passed it
	CMPB	(AP),#5
	BLSSU	FCEVAL.CALL_USER.$14
	MOVL	20(AP),FCEVAL.CALL_USER.$A5(FP)
FCEVAL.CALL_USER.$14:
	CLRL	FCEVAL.CALL_USER.INNER+308(FP)
	CLRL	FCEVAL.CALL_USER.INNER+404(FP)
	CLRL	FCEVAL.CALL_USER.INNER+500(FP)
	CLRL	FCEVAL.CALL_USER.INNER+596(FP)
	CLRL	FCEVAL.CALL_USER.INNER+692(FP)
	CLRL	FCEVAL.CALL_USER.INNER+788(FP)
	CLRL	FCEVAL.CALL_USER.INNER+884(FP)
	CLRL	FCEVAL.CALL_USER.INNER+980(FP)
;  781      type(node), pointer :: p
;  782      type(function_entry), pointer :: fn
;  783      integer, intent(in) :: at
;  784      type(frame), intent(in), optional :: f
;  785      type(quantity) :: v
;  786      type(frame) :: inner
;  787
;  788      inner%count = fn%count
	MOVL	@FCEVAL.CALL_USER.FN(AP),R0
	MOVL	32(R0),FCEVAL.CALL_USER.INNER(FP)
;  789      inner%column = at
	MOVL	@FCEVAL.CALL_USER.AT(AP),FCEVAL.CALL_USER.INNER+4(FP)
;  790      inner%names(1:fn%count) = fn%params(1:fn%count)
	MOVL	FCEVAL.CALL_USER.INNER(FP),FCEVAL.CALL_USER.$T1(FP)
	MOVL	FCEVAL.CALL_USER.$T1(FP),R6
	BGEQ	FCEVAL.CALL_USER.$1
	CLRL	R6
FCEVAL.CALL_USER.$1:
	MOVL	R6,R9			; array (line 790), dimension 1's limit
	MOVL	#1,R7
	CMPL	#1,R9
	BGTR	FCEVAL.CALL_USER.$3
	MULL3	R7,#31,R8
	MOVL	FCEVAL.CALL_USER.FN(AP),R10
FCEVAL.CALL_USER.$5:			; array (line 790), dimension 1's body
	MOVL	R8,R6
	ADDL3	R6,#5,R0
	MOVC3	#31,@(R10)[R0],FCEVAL.CALL_USER.INNER-23(FP)[R6]
	ADDL2	#31,R8
	AOBLEQ	R9,R7,FCEVAL.CALL_USER.$5
FCEVAL.CALL_USER.$3:
;  791      if (.not. evaluate_arguments(p, fn%count, inner%values, v, f)) return
	PUSHAB	@FCEVAL.CALL_USER.$A5(FP)
	PUSHAB	@FCEVAL.CALL_USER.V(AP)
	PUSHAB	FCEVAL.CALL_USER.INNER+256(FP)
	MOVL	@FCEVAL.CALL_USER.FN(AP),R0
	PUSHAL	32(R0)
	PUSHAL	@FCEVAL.CALL_USER.P(AP)
	CALLS	#5,G^FCEVAL.EVALUATE_ARGUMENTS
	MOVL	R0,R6
	BLBS	R6,FCEVAL.CALL_USER.$7
	RET
FCEVAL.CALL_USER.$7:
;  792
;  793      if (calls >= call_limit) then
	CMPL	FCEVAL.CALLS,#200
	BLSS	FCEVAL.CALL_USER.$9
;  794        v = failure(e_recursion)
	PUSHAL	FCEVAL.CALL_USER.$K1
	PUSHAB	FCEVAL.CALL_USER.$T4(FP)
	CALLS	#2,G^FCARRAYS.FAILURE
	MOVC3	#96,FCEVAL.CALL_USER.$T4(FP),@FCEVAL.CALL_USER.V(AP)
;  795      else
	BRB	FCEVAL.CALL_USER.$11
FCEVAL.CALL_USER.$9:
;  796        calls = calls + 1
	INCL	FCEVAL.CALLS
;  797        v = evaluate(fn%body, inner)
	PUSHAB	FCEVAL.CALL_USER.INNER(FP)
	MOVL	@FCEVAL.CALL_USER.FN(AP),R0
	PUSHAL	284(R0)
	PUSHAB	FCEVAL.CALL_USER.$T4(FP)
	CALLS	#3,G^FCEVAL.EVALUATE
	MOVC3	#96,FCEVAL.CALL_USER.$T4(FP),@FCEVAL.CALL_USER.V(AP)
;  798        calls = calls - 1
	DECL	FCEVAL.CALLS
;  799      end if
FCEVAL.CALL_USER.$11:
;  800      call release_all(inner%values(1:fn%count))
	MOVL	@FCEVAL.CALL_USER.FN(AP),R0
	MOVL	32(R0),R6
	BGEQ	FCEVAL.CALL_USER.$12
	CLRL	R6
FCEVAL.CALL_USER.$12:
	MOVL	#167772256,FCEVAL.CALL_USER.$D1(FP) ; the descriptor's length, 96, type, and class
	CLRL	FCEVAL.CALL_USER.$D1+4(FP) ; no string yet
	MOVL	#16777216,FCEVAL.CALL_USER.$D1+8(FP) ; its flags and dimensions
	MOVAB	FCEVAL.CALL_USER.INNER+256(FP),FCEVAL.CALL_USER.$D1+4(FP)
	MOVL	#96,FCEVAL.CALL_USER.$D1+20(FP) ; dimension 1's multiplier
	MOVL	#1,FCEVAL.CALL_USER.$D1+24(FP) ; dimension 1's lower bound
	MOVL	R6,FCEVAL.CALL_USER.$D1+28(FP)
	SUBL3	#96,FCEVAL.CALL_USER.$D1+4(FP),FCEVAL.CALL_USER.$D1+16(FP)
	MULL3	#96,R6,FCEVAL.CALL_USER.$D1+12(FP)
	PUSHAQ	FCEVAL.CALL_USER.$D1(FP)
	CALLS	#1,G^FCEVAL.RELEASE_ALL
;  801    end function call_user
	RET

; Storage map for FCEVAL.INDEX_OF, a RECURSIVE TYPE(QUANTITY) function
;   V     TYPE(QUANTITY)                     hidden argument 1  @FCEVAL.INDEX_OF.V(AP)
;   X     TYPE(QUANTITY), INTENT(IN)         argument 2         @FCEVAL.INDEX_OF.X(AP)
;   P     TYPE(NODE), POINTER                argument 3         @FCEVAL.INDEX_OF.P(AP)
;   AT    INTEGER, INTENT(IN)                argument 4         @FCEVAL.INDEX_OF.AT(AP)
;   F     TYPE(FRAME), INTENT(IN), OPTIONAL  an argument        @FCEVAL.INDEX_OF.$A5(FP)
;   LIST  INTEGER, POINTER (:)               FP-204             FCEVAL.INDEX_OF.LIST(FP)
;   ROWS  INTEGER, POINTER (:)               FP-172             FCEVAL.INDEX_OF.ROWS(FP)
;   COLS  INTEGER, POINTER (:)               FP-140             FCEVAL.INDEX_OF.COLS(FP)
;   ERR   INTEGER                            FP-108             FCEVAL.INDEX_OF.ERR(FP)
;   R6 is $T1: temporary
;
FCEVAL.INDEX_OF.V = 4			; V's value goes through hidden argument 1
FCEVAL.INDEX_OF.X = 8			; X is argument 2
FCEVAL.INDEX_OF.P = 12			; P is argument 3
FCEVAL.INDEX_OF.AT = 16			; AT is argument 4
FCEVAL.INDEX_OF.LIST = -204		; LIST, INTEGER, POINTER (:): its descriptor, in the frame
FCEVAL.INDEX_OF.ROWS = -172		; ROWS, INTEGER, POINTER (:): its descriptor, in the frame
FCEVAL.INDEX_OF.COLS = -140		; COLS, INTEGER, POINTER (:): its descriptor, in the frame
FCEVAL.INDEX_OF.ERR = -108		; ERR, in the frame
FCEVAL.INDEX_OF.$A5 = -104		; F's longword of the argument list, set at each entry point, in the frame
FCEVAL.INDEX_OF.$T2 = -100		; temporary, in the frame
FCEVAL.INDEX_OF.$T3 = -96		; characters, for one statement, in the frame

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  802
;  803    ! ------------------------------------------------------------------
;  804    ! Indexes.
;  805
;  806    ! INDEX_OF is X(...), the call P's arguments its indexes: one, which
;  807    ! counts X's elements in array element order (down each column in turn),
;  808    ! or two, a row and a column. Each index is a number, an array of
;  809    ! numbers (a vector subscript, picking those elements in that order), or
;  810    ! a range. A single index gives a row of the elements it picks, or a
;  811    ! column if X is a column.
;  812    recursive function index_of(x, p, at, f) result(v)
	.ENTRY	FCEVAL.INDEX_OF,^M<R2,R3,R4,R5,R6>
	SUBL2	#204,SP			; this activation's own storage
	CLRL	FCEVAL.INDEX_OF.$A5(FP)	; F is argument 5, if the caller passed it
	CMPB	(AP),#5
	BLSSU	FCEVAL.INDEX_OF.$13
	MOVL	20(AP),FCEVAL.INDEX_OF.$A5(FP)
FCEVAL.INDEX_OF.$13:
	MOVL	#168296452,FCEVAL.INDEX_OF.LIST(FP) ; the descriptor's length, 4, type, and class
	CLRL	FCEVAL.INDEX_OF.LIST+4(FP) ; no string yet
	MOVL	#16777216,FCEVAL.INDEX_OF.LIST+8(FP) ; its flags and dimensions
	MOVL	#168296452,FCEVAL.INDEX_OF.ROWS(FP) ; the descriptor's length, 4, type, and class
	CLRL	FCEVAL.INDEX_OF.ROWS+4(FP) ; no string yet
	MOVL	#16777216,FCEVAL.INDEX_OF.ROWS+8(FP) ; its flags and dimensions
	MOVL	#168296452,FCEVAL.INDEX_OF.COLS(FP) ; the descriptor's length, 4, type, and class
	CLRL	FCEVAL.INDEX_OF.COLS+4(FP) ; no string yet
	MOVL	#16777216,FCEVAL.INDEX_OF.COLS+8(FP) ; its flags and dimensions
;  813      type(quantity), intent(in) :: x
;  814      type(node), pointer :: p
;  815      integer, intent(in) :: at
;  816      type(frame), intent(in), optional :: f
;  817      type(quantity) :: v
;  818      integer, pointer :: list(:), rows(:), cols(:)
;  819      integer :: err
;  820
;  821      select case (argument_count(p))
	PUSHAL	@FCEVAL.INDEX_OF.P(AP)
	CALLS	#1,G^FCEVAL.ARGUMENT_COUNT
	MOVL	R0,R6
	CMPL	R6,#1
	BEQL	FCEVAL.INDEX_OF.$1
	CMPL	R6,#2
	BEQL	FCEVAL.INDEX_OF.$3
	BRW	FCEVAL.INDEX_OF.$5
FCEVAL.INDEX_OF.$1:
;  822      case (1)
;  823        if (.not. index_list(p%kid, numel(x), list, err, f)) then
	PUSHAB	@FCEVAL.INDEX_OF.X(AP)
	CALLS	#1,G^FCARRAYS.NUMEL
	MOVL	R0,FCEVAL.INDEX_OF.$T2(FP)
	PUSHAB	@FCEVAL.INDEX_OF.$A5(FP)
	PUSHAL	FCEVAL.INDEX_OF.ERR(FP)
	PUSHAQ	FCEVAL.INDEX_OF.LIST(FP)
	PUSHAL	FCEVAL.INDEX_OF.$T2(FP)
	MOVL	@FCEVAL.INDEX_OF.P(AP),R0
	PUSHAL	80(R0)
	CALLS	#5,G^FCEVAL.INDEX_LIST
	MOVL	R0,R6
	BLBS	R6,FCEVAL.INDEX_OF.$6
;  824          v = index_failure(err, at)
	PUSHAL	@FCEVAL.INDEX_OF.AT(AP)
	PUSHAL	FCEVAL.INDEX_OF.ERR(FP)
	PUSHAB	FCEVAL.INDEX_OF.$T3(FP)
	CALLS	#3,G^FCEVAL.INDEX_FAILURE
	MOVC3	#96,FCEVAL.INDEX_OF.$T3(FP),@FCEVAL.INDEX_OF.V(AP)
;  825          return
	RET
FCEVAL.INDEX_OF.$6:
;  826        end if
;  827        v = picked(x, list)
	PUSHAQ	FCEVAL.INDEX_OF.LIST(FP)
	PUSHAB	@FCEVAL.INDEX_OF.X(AP)
	PUSHAB	FCEVAL.INDEX_OF.$T3(FP)
	CALLS	#3,G^FCEVAL.PICKED
	MOVC3	#96,FCEVAL.INDEX_OF.$T3(FP),@FCEVAL.INDEX_OF.V(AP)
;  828        deallocate (list)
	PUSHL	#2
	PUSHAQ	FCEVAL.INDEX_OF.LIST(FP)
	CALLS	#2,G^FTN$DEALLOCATE
;  829      case (2)
	RET
FCEVAL.INDEX_OF.$3:
;  830        if (.not. index_list(p%kid, x%rows, rows, err, f)) then
	PUSHAB	@FCEVAL.INDEX_OF.$A5(FP)
	PUSHAL	FCEVAL.INDEX_OF.ERR(FP)
	PUSHAQ	FCEVAL.INDEX_OF.ROWS(FP)
	PUSHAL	@FCEVAL.INDEX_OF.X(AP)
	MOVL	@FCEVAL.INDEX_OF.P(AP),R0
	PUSHAL	80(R0)
	CALLS	#5,G^FCEVAL.INDEX_LIST
	MOVL	R0,FCEVAL.INDEX_OF.$T2(FP)
	BLBS	FCEVAL.INDEX_OF.$T2(FP),FCEVAL.INDEX_OF.$9
;  831          v = index_failure(err, at)
	PUSHAL	@FCEVAL.INDEX_OF.AT(AP)
	PUSHAL	FCEVAL.INDEX_OF.ERR(FP)
	PUSHAB	FCEVAL.INDEX_OF.$T3(FP)
	CALLS	#3,G^FCEVAL.INDEX_FAILURE
	MOVC3	#96,FCEVAL.INDEX_OF.$T3(FP),@FCEVAL.INDEX_OF.V(AP)
;  832          return
	RET
FCEVAL.INDEX_OF.$9:
;  833        end if
;  834        if (.not. index_list(p%kid%next, x%cols, cols, err, f)) then
	PUSHAB	@FCEVAL.INDEX_OF.$A5(FP)
	PUSHAL	FCEVAL.INDEX_OF.ERR(FP)
	PUSHAQ	FCEVAL.INDEX_OF.COLS(FP)
	MOVL	FCEVAL.INDEX_OF.X(AP),R0
	PUSHAL	4(R0)
	MOVL	@FCEVAL.INDEX_OF.P(AP),R0
	MOVL	80(R0),R0
	PUSHAL	84(R0)
	CALLS	#5,G^FCEVAL.INDEX_LIST
	MOVL	R0,FCEVAL.INDEX_OF.$T2(FP)
	BLBS	FCEVAL.INDEX_OF.$T2(FP),FCEVAL.INDEX_OF.$11
;  835          deallocate (rows)
	PUSHL	#2
	PUSHAQ	FCEVAL.INDEX_OF.ROWS(FP)
	CALLS	#2,G^FTN$DEALLOCATE
;  836          v = index_failure(err, at)
	PUSHAL	@FCEVAL.INDEX_OF.AT(AP)
	PUSHAL	FCEVAL.INDEX_OF.ERR(FP)
	PUSHAB	FCEVAL.INDEX_OF.$T3(FP)
	CALLS	#3,G^FCEVAL.INDEX_FAILURE
	MOVC3	#96,FCEVAL.INDEX_OF.$T3(FP),@FCEVAL.INDEX_OF.V(AP)
;  837          return
	RET
FCEVAL.INDEX_OF.$11:
;  838        end if
;  839        v = section(x, rows, cols)
	PUSHAQ	FCEVAL.INDEX_OF.COLS(FP)
	PUSHAQ	FCEVAL.INDEX_OF.ROWS(FP)
	PUSHAB	@FCEVAL.INDEX_OF.X(AP)
	PUSHAB	FCEVAL.INDEX_OF.$T3(FP)
	CALLS	#4,G^FCEVAL.SECTION
	MOVC3	#96,FCEVAL.INDEX_OF.$T3(FP),@FCEVAL.INDEX_OF.V(AP)
;  840        deallocate (rows, cols)
	PUSHL	#2
	PUSHAQ	FCEVAL.INDEX_OF.ROWS(FP)
	CALLS	#2,G^FTN$DEALLOCATE
	PUSHL	#2
	PUSHAQ	FCEVAL.INDEX_OF.COLS(FP)
	CALLS	#2,G^FTN$DEALLOCATE
;  841      case default
	RET
FCEVAL.INDEX_OF.$5:
;  842        v = wrong_count(p, at)
	PUSHAL	@FCEVAL.INDEX_OF.AT(AP)
	PUSHAL	@FCEVAL.INDEX_OF.P(AP)
	PUSHAB	FCEVAL.INDEX_OF.$T3(FP)
	CALLS	#3,G^FCEVAL.WRONG_COUNT
	MOVC3	#96,FCEVAL.INDEX_OF.$T3(FP),@FCEVAL.INDEX_OF.V(AP)
;  843      end select
;  844    end function index_of
	RET

; Storage map for FCEVAL.INDEX_FAILURE, a TYPE(QUANTITY) function
;   V     TYPE(QUANTITY)       hidden argument 1  @FCEVAL.INDEX_FAILURE.V(AP)
;   ERR   INTEGER, INTENT(IN)  argument 2         @FCEVAL.INDEX_FAILURE.ERR(AP)
;   AT    INTEGER, INTENT(IN)  argument 3         @FCEVAL.INDEX_FAILURE.AT(AP)
;
FCEVAL.INDEX_FAILURE.V = 4		; V's value goes through hidden argument 1
FCEVAL.INDEX_FAILURE.ERR = 8		; ERR is argument 2
FCEVAL.INDEX_FAILURE.AT = 12		; AT is argument 3

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCEVAL.INDEX_FAILURE.$T1:
	.BLKL	24			; characters, for one statement

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  845
;  846    function index_failure(err, at) result(v)
	.ENTRY	FCEVAL.INDEX_FAILURE,^M<R2,R3,R4,R5>
;  847      integer, intent(in) :: err, at
;  848      type(quantity) :: v
;  849
;  850      call fail(err, at)
	PUSHL	#0
	PUSHAL	@FCEVAL.INDEX_FAILURE.AT(AP)
	PUSHAL	@FCEVAL.INDEX_FAILURE.ERR(AP)
	CALLS	#3,G^FCMESSAGES.FAIL
;  851      v = failure(err)
	PUSHAL	@FCEVAL.INDEX_FAILURE.ERR(AP)
	PUSHAB	FCEVAL.INDEX_FAILURE.$T1
	CALLS	#2,G^FCARRAYS.FAILURE
	MOVC3	#96,FCEVAL.INDEX_FAILURE.$T1,@FCEVAL.INDEX_FAILURE.V(AP)
;  852    end function index_failure
	RET

; Storage map for FCEVAL.PICKED, a TYPE(QUANTITY) function
;   V     TYPE(QUANTITY)              hidden argument 1       @FCEVAL.PICKED.V(AP)
;   X     TYPE(QUANTITY), INTENT(IN)  argument 2              @FCEVAL.PICKED.X(AP)
;   LIST  INTEGER, INTENT(IN) (:)     argument 3              @FCEVAL.PICKED.LIST(AP)
;   FLAT  COMPLEX*16 (?)              descriptor at $LOCAL+0  FCEVAL.PICKED.FLAT
;   R7 is $I1: an array statement's loop index
;   R6 is $I2: an array statement's loop index
;   R7 is $I4: an array statement's loop index
;   R6 is $I5: an array statement's loop index
;   R11 is $T4: temporary
;   R6 is $T6: temporary
;   R9 is $T8: temporary
;   R8 is $I6: an array statement's loop index
;   R6 is $I7: an array statement's loop index
;   R10 is $T9: temporary
;   R7 is $T10: temporary
;   R8 is $T12: temporary
;   R11 is $L3: array (line 863), dimension 1's limit
;   R10 is $I8: an array statement's loop index
;   R6 is $L4: array (line 863), dimension 1's limit
;   R6 is $T15: temporary
;   R6 is $L5: array (line 863), dimension 1's limit
;   R11 is $L7: array (line 865), dimension 1's limit
;   R9 is $I9: an array statement's loop index
;   R8 is $L9: array (line 865), dimension 1's limit
;   R6 is $I10: an array statement's loop index
;   R10 is $I11: an array statement's loop index
;   R7 is $L11: array (line 865), dimension 1's limit
;   R8 is $L13: array (line 867), dimension 1's limit
;   R9 is $L15: array (line 867), dimension 1's limit
;   R7 is $L17: array (line 867), dimension 1's limit
;   R10 is $H1: a value computed before a loop
;   R8 is $H2: a value computed before a loop
;   R9 is $H3: a value computed before a loop
;   R11 is $H4: a value computed before a loop
;   R8 is $H5: a value computed before a loop
;   R9 is $H6: a value computed before a loop
;   R6 is $R5: an index stepped with $I4
;   R7 is $R6: an index stepped with $I2
;   R11 is $R7: an index stepped with $I6
;   R11 is $R8: an index stepped with $I8
;   R11 is $R9: an index stepped with $I11
;
FCEVAL.PICKED.V = 4			; V's value goes through hidden argument 1
FCEVAL.PICKED.X = 8			; X is argument 2
FCEVAL.PICKED.LIST = 12			; LIST is argument 3

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCEVAL.PICKED.FLAT:
	.WORD	16			; length
	.BYTE	DSC$K_DTYPE_GC,DSC$K_CLASS_A
	.LONG	0			; FLAT: not allocated
	.BYTE	0,0,^XE0,1		; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0			; multipliers
	.LONG	1,0			; bounds
FCEVAL.PICKED.$B1:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_L,DSC$K_CLASS_NCA
	.LONG	0			; LIST's bounds: set at each entry point
	.BYTE	0,0,0,1			; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0			; strides, in bytes
	.LONG	0,0			; bounds
FCEVAL.PICKED.$T1:
	.BLKL	1			; temporary
	.BLKB	4
FCEVAL.PICKED.$W1:
	.BLKL	1			; an array temporary of 4 bytes, for one statement
	.BLKB	4
FCEVAL.PICKED.$W2:
	.BLKL	1			; an array temporary of 4 bytes, for one statement
FCEVAL.PICKED.$I3:
	.BLKL	1			; an array statement's loop index
FCEVAL.PICKED.$C1:
	.BLKL	1			; array (line 863), dimension 1's count
FCEVAL.PICKED.$R1:
	.WORD	16			; length
	.BYTE	DSC$K_DTYPE_GC,DSC$K_CLASS_A
	.LONG	0			; $W: not allocated
