;  951        return
	CLRL	R0			; the function's value
	RET
FCEVAL.INDEX_LIST.$31:
;  952      end if
;  953      allocate (list(numel(x)))
	PUSHAB	FCEVAL.INDEX_LIST.X(FP)
	CALLS	#1,G^FCARRAYS.NUMEL
	MOVL	R0,R7
	PUSHL	R7
	PUSHL	#1
	PUSHL	#2
