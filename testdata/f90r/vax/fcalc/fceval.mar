FCEVAL.EVALUATE.$7:
;  158        v = failure(e_badrange)
	PUSHAL	FCEVAL.EVALUATE.$K2
	PUSHAB	FCEVAL.EVALUATE.$T2(FP)
	CALLS	#2,G^FCARRAYS.FAILURE
	MOVC3	#96,FCEVAL.EVALUATE.$T2(FP),@FCEVAL.EVALUATE.V(AP)
;  159
;  160      case default
	BRB	FCEVAL.EVALUATE.$8
FCEVAL.EVALUATE.$5:
;  161        v = operate(p, f)
	PUSHAB	@FCEVAL.EVALUATE.$A3(FP)
	PUSHAL	@FCEVAL.EVALUATE.P(AP)
	PUSHAB	FCEVAL.EVALUATE.$T2(FP)
	CALLS	#3,G^FCEVAL.OPERATE
	MOVC3	#96,FCEVAL.EVALUATE.$T2(FP),@FCEVAL.EVALUATE.V(AP)
;  162      end select
FCEVAL.EVALUATE.$8:
;  163
;  164      if (quantity_error(v) /= 0) call fail(quantity_error(v), at)
	PUSHAB	@FCEVAL.EVALUATE.V(AP)
	CALLS	#1,G^FCARRAYS.QUANTITY_ERROR
	MOVL	R0,R6
	BEQL	FCEVAL.EVALUATE.$15
	PUSHAB	@FCEVAL.EVALUATE.V(AP)
	CALLS	#1,G^FCARRAYS.QUANTITY_ERROR
	MOVL	R0,FCEVAL.EVALUATE.$T3(FP)
	PUSHL	#0
	PUSHAL	FCEVAL.EVALUATE.AT(FP)
	PUSHAL	FCEVAL.EVALUATE.$T3(FP)
	CALLS	#3,G^FCMESSAGES.FAIL
FCEVAL.EVALUATE.$15:
;  165    end function evaluate
	RET

; Storage map for FCEVAL.PARAMETER_VALUE, a LOGICAL function
;   NAME             CHARACTER*(*), INTENT(IN)          argument 1   @FCEVAL.PARAMETER_VALUE.NAME(AP)
;   V                TYPE(QUANTITY), INTENT(OUT)        argument 2   @FCEVAL.PARAMETER_VALUE.V(AP)
;   F                TYPE(FRAME), INTENT(IN), OPTIONAL  an argument  @FCEVAL.PARAMETER_VALUE.$A3
;   PARAMETER_VALUE  LOGICAL                            $LOCAL+0     FCEVAL.PARAMETER_VALUE.$N2
;   K                INTEGER                            $LOCAL+4     FCEVAL.PARAMETER_VALUE.K
;   R10 is $L1: DO (line 178)'s limit
;   R11 is $H1: a value computed before a loop
;   R7 is $R1: an index stepped with K
;   R6 is $R2: K, during a loop
;   R8 is $R3: NAME's address
;   R9 is $R4: F's address
;   FCEVAL.PARAMETER_VALUE.$N2 is FCEVAL.PARAMETER_VALUE.PARAMETER_VALUE
;
FCEVAL.PARAMETER_VALUE.NAME = 4		; NAME is argument 1
FCEVAL.PARAMETER_VALUE.V = 8		; V is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCEVAL.PARAMETER_VALUE.$N2:
	.BLKL	1			; PARAMETER_VALUE, the function's value
FCEVAL.PARAMETER_VALUE.K:
	.BLKL	1			; K
FCEVAL.PARAMETER_VALUE.$A3:
	.BLKL	1			; F's longword of the argument list, set at each entry point
FCEVAL.PARAMETER_VALUE.$T1:
	.BLKL	24			; characters, for one statement

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCEVAL.PARAMETER_VALUE.$K1:
	.LONG	^X00000000,^X00000000	; 0D0

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  166
;  167    ! PARAMETER_VALUE: if F is given and NAME is one of its parameters, V is
;  168    ! a copy of the parameter's value and the result is true.
;  169    logical function parameter_value(name, v, f)
	.ENTRY	FCEVAL.PARAMETER_VALUE,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	CLRL	FCEVAL.PARAMETER_VALUE.$A3 ; F is argument 3, if the caller passed it
	CMPB	(AP),#3
	BLSSU	FCEVAL.PARAMETER_VALUE.$9
	MOVL	12(AP),FCEVAL.PARAMETER_VALUE.$A3
FCEVAL.PARAMETER_VALUE.$9:
;  170      character(len=*), intent(in) :: name
;  171      type(quantity), intent(out) :: v
;  172      type(frame), intent(in), optional :: f
;  173      integer :: k
;  174
;  175      parameter_value = .false.
;  176      v = real_quantity(0.0_rk)
	PUSHAG	FCEVAL.PARAMETER_VALUE.$K1
	PUSHAB	FCEVAL.PARAMETER_VALUE.$T1
	CALLS	#2,G^FCARRAYS.REAL_QUANTITY
	MOVC3	#96,FCEVAL.PARAMETER_VALUE.$T1,@FCEVAL.PARAMETER_VALUE.V(AP)
;  177      if (.not. present(f)) return
	TSTL	FCEVAL.PARAMETER_VALUE.$A3
	BNEQ	FCEVAL.PARAMETER_VALUE.$1
	CLRL	R0			; the function's value
	RET
FCEVAL.PARAMETER_VALUE.$1:
;  178      do k = 1, f%count
	MOVL	@FCEVAL.PARAMETER_VALUE.$A3,R10 ; DO (line 178)'s limit
	MOVL	#1,FCEVAL.PARAMETER_VALUE.K
	CMPL	#1,R10
	BGTR	FCEVAL.PARAMETER_VALUE.$3
	MOVZWL	@FCEVAL.PARAMETER_VALUE.NAME(AP),R11 ; from line 179
	MULL3	FCEVAL.PARAMETER_VALUE.K,#31,R7
	MOVL	FCEVAL.PARAMETER_VALUE.K,R6
	MOVL	FCEVAL.PARAMETER_VALUE.NAME(AP),R8
	MOVL	FCEVAL.PARAMETER_VALUE.$A3,R9
FCEVAL.PARAMETER_VALUE.$5:		; DO (line 178)'s body
;  179        if (f%names(k) == name) then
	CMPC5	#31,-23(R9)[R7],#^A/ /,R11,@4(R8)
	BNEQ	FCEVAL.PARAMETER_VALUE.$6
	MOVL	R6,FCEVAL.PARAMETER_VALUE.K
;  180          v = duplicate(f%values(k))
	MULL3	FCEVAL.PARAMETER_VALUE.K,#96,R0
	ADDL2	#160,R0
	PUSHAB	@FCEVAL.PARAMETER_VALUE.$A3[R0]
	PUSHAB	FCEVAL.PARAMETER_VALUE.$T1
	CALLS	#2,G^FCARRAYS.DUPLICATE
	MOVC3	#96,FCEVAL.PARAMETER_VALUE.$T1,@FCEVAL.PARAMETER_VALUE.V(AP)
;  181          parameter_value = .true.
;  182          return
	MOVL	#-1,R0			; the function's value
	RET
FCEVAL.PARAMETER_VALUE.$6:
;  183        end if
;  184      end do
	ADDL2	#31,R7
	AOBLEQ	R10,R6,FCEVAL.PARAMETER_VALUE.$5
	MOVL	R6,FCEVAL.PARAMETER_VALUE.K
FCEVAL.PARAMETER_VALUE.$3:
;  185    end function parameter_value
	CLRL	R0			; the function's value
	RET

; Storage map for FCEVAL.OPERATE, a RECURSIVE TYPE(QUANTITY) function
;   V     TYPE(QUANTITY)                     hidden argument 1  @FCEVAL.OPERATE.V(AP)
;   P     TYPE(NODE), POINTER                argument 2         @FCEVAL.OPERATE.P(AP)
;   F     TYPE(FRAME), INTENT(IN), OPTIONAL  an argument        @FCEVAL.OPERATE.$A3(FP)
;   A     TYPE(QUANTITY)                     FP-328             FCEVAL.OPERATE.A(FP)
;   B     TYPE(QUANTITY)                     FP-232             FCEVAL.OPERATE.B(FP)
;   R6 is $T4: temporary
;
FCEVAL.OPERATE.V = 4			; V's value goes through hidden argument 1
FCEVAL.OPERATE.P = 8			; P is argument 2
FCEVAL.OPERATE.A = -328			; A, in the frame
FCEVAL.OPERATE.B = -232			; B, in the frame
FCEVAL.OPERATE.$A3 = -136		; F's longword of the argument list, set at each entry point, in the frame
FCEVAL.OPERATE.$T1 = -132		; characters, for one statement, in the frame
FCEVAL.OPERATE.$T2 = -36		; temporary, in the frame
FCEVAL.OPERATE.$T3 = -32		; characters, for one statement, in the frame

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCEVAL.OPERATE.$K1:
	.LONG	3
FCEVAL.OPERATE.$K2:
	.LONG	4
FCEVAL.OPERATE.$K3:
	.LONG	31
FCEVAL.OPERATE.$K4:
	.LONG	6

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  186
;  187    ! ------------------------------------------------------------------
;  188    ! Operations.
;  189
;  190    ! OPERATE is an operation's value. AND and OR evaluate their right
;  191    ! operand only if they must, so x <> 0 and 1/x > 2 is safe: a scalar
;  192    ! left operand that settles the result alone ends it.
;  193    recursive function operate(p, f) result(v)
	.ENTRY	FCEVAL.OPERATE,^M<R2,R3,R4,R5,R6>
	SUBL2	#328,SP			; this activation's own storage
	CLRL	FCEVAL.OPERATE.$A3(FP)	; F is argument 3, if the caller passed it
	CMPB	(AP),#3
	BLSSU	FCEVAL.OPERATE.$42
	MOVL	12(AP),FCEVAL.OPERATE.$A3(FP)
FCEVAL.OPERATE.$42:
	CLRL	FCEVAL.OPERATE.A+52(FP)
	CLRL	FCEVAL.OPERATE.B+52(FP)
;  194      type(node), pointer :: p
;  195      type(frame), intent(in), optional :: f
;  196      type(quantity) :: v
;  197      type(quantity) :: a, b
;  198
;  199      a = evaluate(p%kid, f)
	PUSHAB	@FCEVAL.OPERATE.$A3(FP)
	MOVL	@FCEVAL.OPERATE.P(AP),R0
	PUSHAL	80(R0)
	PUSHAB	FCEVAL.OPERATE.$T1(FP)
	CALLS	#3,G^FCEVAL.EVALUATE
	MOVC3	#96,FCEVAL.OPERATE.$T1(FP),FCEVAL.OPERATE.A(FP)
;  200      if (quantity_error(a) /= 0) then
	PUSHAB	FCEVAL.OPERATE.A(FP)
	CALLS	#1,G^FCARRAYS.QUANTITY_ERROR
	MOVL	R0,FCEVAL.OPERATE.$T2(FP)
	BEQL	FCEVAL.OPERATE.$1
;  201        v = a
	MOVC3	#96,FCEVAL.OPERATE.A(FP),@FCEVAL.OPERATE.V(AP)
;  202        return
	RET
FCEVAL.OPERATE.$1:
;  203      end if
;  204
;  205      select case (p%op)
	MOVL	@FCEVAL.OPERATE.P(AP),R0
	MOVL	4(R0),FCEVAL.OPERATE.$T2(FP)
	CASEL	FCEVAL.OPERATE.$T2(FP),#7,#11
FCEVAL.OPERATE.$3:
	.WORD	FCEVAL.OPERATE.$4-FCEVAL.OPERATE.$3
	.WORD	FCEVAL.OPERATE.$4-FCEVAL.OPERATE.$3
	.WORD	FCEVAL.OPERATE.$4-FCEVAL.OPERATE.$3
	.WORD	FCEVAL.OPERATE.$5-FCEVAL.OPERATE.$3
	.WORD	FCEVAL.OPERATE.$5-FCEVAL.OPERATE.$3
	.WORD	FCEVAL.OPERATE.$4-FCEVAL.OPERATE.$3
	.WORD	FCEVAL.OPERATE.$6-FCEVAL.OPERATE.$3
	.WORD	FCEVAL.OPERATE.$6-FCEVAL.OPERATE.$3
	.WORD	FCEVAL.OPERATE.$6-FCEVAL.OPERATE.$3
	.WORD	FCEVAL.OPERATE.$6-FCEVAL.OPERATE.$3
	.WORD	FCEVAL.OPERATE.$7-FCEVAL.OPERATE.$3
	.WORD	FCEVAL.OPERATE.$7-FCEVAL.OPERATE.$3
	BRW	FCEVAL.OPERATE.$6
FCEVAL.OPERATE.$4:
;  206      case (op_neg, op_plus, op_not, op_factorial)
;  207        v = unary(a, p%op)
	MOVL	@FCEVAL.OPERATE.P(AP),R0
	PUSHAL	4(R0)
	PUSHAB	FCEVAL.OPERATE.A(FP)
	PUSHAB	FCEVAL.OPERATE.$T1(FP)
	CALLS	#3,G^FCEVAL.UNARY
	MOVC3	#96,FCEVAL.OPERATE.$T1(FP),@FCEVAL.OPERATE.V(AP)
;  208        call release(a)
	PUSHAB	FCEVAL.OPERATE.A(FP)
	CALLS	#1,G^FCARRAYS.RELEASE
;  209        return
	RET
FCEVAL.OPERATE.$7:
;  210      case (op_transpose, op_ctranspose)
;  211        v = transposed(a, p%op == op_ctranspose)
	MOVL	@FCEVAL.OPERATE.P(AP),R0
	CLRL	R1
	CMPL	4(R0),#18
	BNEQ	FCEVAL.OPERATE.$8
	MNEGL	#1,R1
FCEVAL.OPERATE.$8:
	MOVL	R1,FCEVAL.OPERATE.$T2(FP)
	PUSHAL	FCEVAL.OPERATE.$T2(FP)
	PUSHAB	FCEVAL.OPERATE.A(FP)
	PUSHAB	FCEVAL.OPERATE.$T1(FP)
	CALLS	#3,G^FCMATRIX.TRANSPOSED
	MOVC3	#96,FCEVAL.OPERATE.$T1(FP),@FCEVAL.OPERATE.V(AP)
;  212        call release(a)
	PUSHAB	FCEVAL.OPERATE.A(FP)
	CALLS	#1,G^FCARRAYS.RELEASE
;  213        return
	RET
FCEVAL.OPERATE.$5:
;  214      case (op_and, op_or)
;  215        if (.not. is_array(a)) then
	PUSHAB	FCEVAL.OPERATE.A(FP)
	CALLS	#1,G^FCARRAYS.IS_ARRAY
	MOVL	R0,FCEVAL.OPERATE.$T2(FP)
	BLBS	FCEVAL.OPERATE.$T2(FP),FCEVAL.OPERATE.$9
;  216          if (truth(a%s) .eqv. p%op == op_or) then
	PUSHAB	FCEVAL.OPERATE.A+16(FP)
	CALLS	#1,G^FCVALUES.TRUTH
	MOVL	R0,FCEVAL.OPERATE.$T2(FP)
	MOVL	@FCEVAL.OPERATE.P(AP),R0
	CLRL	R1
	CMPL	4(R0),#11
	BNEQ	FCEVAL.OPERATE.$12
	MNEGL	#1,R1
FCEVAL.OPERATE.$12:
	XORL3	FCEVAL.OPERATE.$T2(FP),R1,R0
	BLBS	R0,FCEVAL.OPERATE.$11
;  217            v = scalar_quantity(logical_value(p%op == op_or))
	MOVL	@FCEVAL.OPERATE.P(AP),R0
	CLRL	R1
	CMPL	4(R0),#11
	BNEQ	FCEVAL.OPERATE.$14
	MNEGL	#1,R1
FCEVAL.OPERATE.$14:
	MOVL	R1,FCEVAL.OPERATE.$T2(FP)
	PUSHAL	FCEVAL.OPERATE.$T2(FP)
	PUSHAB	FCEVAL.OPERATE.$T3(FP)
	CALLS	#2,G^FCVALUES.LOGICAL_VALUE
	PUSHAB	FCEVAL.OPERATE.$T3(FP)
	PUSHAB	FCEVAL.OPERATE.$T1(FP)
	CALLS	#2,G^FCARRAYS.SCALAR_QUANTITY
	MOVC3	#96,FCEVAL.OPERATE.$T1(FP),@FCEVAL.OPERATE.V(AP)
;  218            return
	RET
FCEVAL.OPERATE.$11:
;  219          end if
;  220        end if
FCEVAL.OPERATE.$9:
;  221      end select
FCEVAL.OPERATE.$6:
;  222
;  223      b = evaluate(p%kid%next, f)
	PUSHAB	@FCEVAL.OPERATE.$A3(FP)
	MOVL	@FCEVAL.OPERATE.P(AP),R0
	MOVL	80(R0),R0
	PUSHAL	84(R0)
	PUSHAB	FCEVAL.OPERATE.$T1(FP)
	CALLS	#3,G^FCEVAL.EVALUATE
	MOVC3	#96,FCEVAL.OPERATE.$T1(FP),FCEVAL.OPERATE.B(FP)
;  224      if (quantity_error(b) /= 0) then
	PUSHAB	FCEVAL.OPERATE.B(FP)
	CALLS	#1,G^FCARRAYS.QUANTITY_ERROR
	MOVL	R0,FCEVAL.OPERATE.$T2(FP)
	BEQL	FCEVAL.OPERATE.$15
;  225        call release(a)
	PUSHAB	FCEVAL.OPERATE.A(FP)
	CALLS	#1,G^FCARRAYS.RELEASE
;  226        v = b
	MOVC3	#96,FCEVAL.OPERATE.B(FP),@FCEVAL.OPERATE.V(AP)
;  227        return
	RET
FCEVAL.OPERATE.$15:
;  228      end if
;  229
;  230      select case (p%op)
	MOVL	@FCEVAL.OPERATE.P(AP),R0
	MOVL	4(R0),FCEVAL.OPERATE.$T2(FP)
	CASEL	FCEVAL.OPERATE.$T2(FP),#3,#13
FCEVAL.OPERATE.$17:
	.WORD	FCEVAL.OPERATE.$18-FCEVAL.OPERATE.$17
	.WORD	FCEVAL.OPERATE.$19-FCEVAL.OPERATE.$17
	.WORD	FCEVAL.OPERATE.$20-FCEVAL.OPERATE.$17
	.WORD	FCEVAL.OPERATE.$21-FCEVAL.OPERATE.$17
	.WORD	FCEVAL.OPERATE.$20-FCEVAL.OPERATE.$17
	.WORD	FCEVAL.OPERATE.$20-FCEVAL.OPERATE.$17
	.WORD	FCEVAL.OPERATE.$20-FCEVAL.OPERATE.$17
	.WORD	FCEVAL.OPERATE.$20-FCEVAL.OPERATE.$17
	.WORD	FCEVAL.OPERATE.$20-FCEVAL.OPERATE.$17
	.WORD	FCEVAL.OPERATE.$20-FCEVAL.OPERATE.$17
	.WORD	FCEVAL.OPERATE.$22-FCEVAL.OPERATE.$17
	.WORD	FCEVAL.OPERATE.$23-FCEVAL.OPERATE.$17
	.WORD	FCEVAL.OPERATE.$24-FCEVAL.OPERATE.$17
	.WORD	FCEVAL.OPERATE.$25-FCEVAL.OPERATE.$17
	BRW	FCEVAL.OPERATE.$20
FCEVAL.OPERATE.$18:
;  231      case (op_mul)
;  232        if (is_array(a) .and. is_array(b)) then
	PUSHAB	FCEVAL.OPERATE.A(FP)
	CALLS	#1,G^FCARRAYS.IS_ARRAY
	MOVL	R0,FCEVAL.OPERATE.$T2(FP)
	PUSHAB	FCEVAL.OPERATE.B(FP)
	CALLS	#1,G^FCARRAYS.IS_ARRAY
	MOVL	R0,R6
	BLBC	FCEVAL.OPERATE.$T2(FP),FCEVAL.OPERATE.$26
	BLBC	R6,FCEVAL.OPERATE.$26
;  233          v = matrix_product(a, b)
	PUSHAB	FCEVAL.OPERATE.B(FP)
	PUSHAB	FCEVAL.OPERATE.A(FP)
	PUSHAB	FCEVAL.OPERATE.$T1(FP)
	CALLS	#3,G^FCMATRIX.MATRIX_PRODUCT
	MOVC3	#96,FCEVAL.OPERATE.$T1(FP),@FCEVAL.OPERATE.V(AP)
;  234        else
	BRW	FCEVAL.OPERATE.$30
FCEVAL.OPERATE.$26:
;  235          v = combine(a, b, op_mul)
	PUSHAL	FCEVAL.OPERATE.$K1
	PUSHAB	FCEVAL.OPERATE.B(FP)
	PUSHAB	FCEVAL.OPERATE.A(FP)
	PUSHAB	FCEVAL.OPERATE.$T1(FP)
	CALLS	#4,G^FCEVAL.COMBINE
	MOVC3	#96,FCEVAL.OPERATE.$T1(FP),@FCEVAL.OPERATE.V(AP)
;  236        end if
;  237      case (op_div)
	BRW	FCEVAL.OPERATE.$30
FCEVAL.OPERATE.$19:
;  238        if (is_array(b)) then
	PUSHAB	FCEVAL.OPERATE.B(FP)
	CALLS	#1,G^FCARRAYS.IS_ARRAY
	MOVL	R0,R6
	BLBC	R6,FCEVAL.OPERATE.$31
;  239          v = right_divide(a, b)
	PUSHAB	FCEVAL.OPERATE.B(FP)
	PUSHAB	FCEVAL.OPERATE.A(FP)
	PUSHAB	FCEVAL.OPERATE.$T1(FP)
	CALLS	#3,G^FCMATRIX.RIGHT_DIVIDE
	MOVC3	#96,FCEVAL.OPERATE.$T1(FP),@FCEVAL.OPERATE.V(AP)
;  240        else
	BRW	FCEVAL.OPERATE.$30
FCEVAL.OPERATE.$31:
;  241          v = combine(a, b, op_div)
	PUSHAL	FCEVAL.OPERATE.$K2
	PUSHAB	FCEVAL.OPERATE.B(FP)
	PUSHAB	FCEVAL.OPERATE.A(FP)
	PUSHAB	FCEVAL.OPERATE.$T1(FP)
	CALLS	#4,G^FCEVAL.COMBINE
	MOVC3	#96,FCEVAL.OPERATE.$T1(FP),@FCEVAL.OPERATE.V(AP)
;  242        end if
;  243      case (op_solve)
	BRW	FCEVAL.OPERATE.$30
FCEVAL.OPERATE.$25:
;  244        ! A \ B with a scalar A is B divided by it.
;  245        if (is_array(a)) then
	PUSHAB	FCEVAL.OPERATE.A(FP)
	CALLS	#1,G^FCARRAYS.IS_ARRAY
	MOVL	R0,R6
	BLBC	R6,FCEVAL.OPERATE.$34
;  246          v = solve(a, b)
	PUSHAB	FCEVAL.OPERATE.B(FP)
	PUSHAB	FCEVAL.OPERATE.A(FP)
	PUSHAB	FCEVAL.OPERATE.$T1(FP)
	CALLS	#3,G^FCMATRIX.SOLVE
	MOVC3	#96,FCEVAL.OPERATE.$T1(FP),@FCEVAL.OPERATE.V(AP)
;  247        else
	BRW	FCEVAL.OPERATE.$30
FCEVAL.OPERATE.$34:
;  248          v = combine(b, a, op_div)
	PUSHAL	FCEVAL.OPERATE.$K2
	PUSHAB	FCEVAL.OPERATE.A(FP)
	PUSHAB	FCEVAL.OPERATE.B(FP)
	PUSHAB	FCEVAL.OPERATE.$T1(FP)
	CALLS	#4,G^FCEVAL.COMBINE
	MOVC3	#96,FCEVAL.OPERATE.$T1(FP),@FCEVAL.OPERATE.V(AP)
;  249        end if
;  250      case (op_power)
	BRW	FCEVAL.OPERATE.$30
FCEVAL.OPERATE.$21:
;  251        if (is_array(a)) then
	PUSHAB	FCEVAL.OPERATE.A(FP)
	CALLS	#1,G^FCARRAYS.IS_ARRAY
	MOVL	R0,R6
	BLBC	R6,FCEVAL.OPERATE.$37
;  252          v = matrix_power(a, b)
	PUSHAB	FCEVAL.OPERATE.B(FP)
	PUSHAB	FCEVAL.OPERATE.A(FP)
	PUSHAB	FCEVAL.OPERATE.$T1(FP)
	CALLS	#3,G^FCMATRIX.MATRIX_POWER
	MOVC3	#96,FCEVAL.OPERATE.$T1(FP),@FCEVAL.OPERATE.V(AP)
;  253        else if (is_array(b)) then
	BRW	FCEVAL.OPERATE.$30
FCEVAL.OPERATE.$37:
	PUSHAB	FCEVAL.OPERATE.B(FP)
	CALLS	#1,G^FCARRAYS.IS_ARRAY
	MOVL	R0,R6
	BLBC	R6,FCEVAL.OPERATE.$40
;  254          v = failure(e_notscalar)
	PUSHAL	FCEVAL.OPERATE.$K3
	PUSHAB	FCEVAL.OPERATE.$T1(FP)
	CALLS	#2,G^FCARRAYS.FAILURE
	MOVC3	#96,FCEVAL.OPERATE.$T1(FP),@FCEVAL.OPERATE.V(AP)
;  255        else
	BRW	FCEVAL.OPERATE.$30
FCEVAL.OPERATE.$40:
;  256          v = combine(a, b, op_power)
	PUSHAL	FCEVAL.OPERATE.$K4
	PUSHAB	FCEVAL.OPERATE.B(FP)
	PUSHAB	FCEVAL.OPERATE.A(FP)
	PUSHAB	FCEVAL.OPERATE.$T1(FP)
	CALLS	#4,G^FCEVAL.COMBINE
	MOVC3	#96,FCEVAL.OPERATE.$T1(FP),@FCEVAL.OPERATE.V(AP)
;  257        end if
;  258      case (op_emul)
	BRW	FCEVAL.OPERATE.$30
FCEVAL.OPERATE.$22:
;  259        v = combine(a, b, op_mul)
	PUSHAL	FCEVAL.OPERATE.$K1
	PUSHAB	FCEVAL.OPERATE.B(FP)
	PUSHAB	FCEVAL.OPERATE.A(FP)
	PUSHAB	FCEVAL.OPERATE.$T1(FP)
	CALLS	#4,G^FCEVAL.COMBINE
	MOVC3	#96,FCEVAL.OPERATE.$T1(FP),@FCEVAL.OPERATE.V(AP)
;  260      case (op_ediv)
	BRB	FCEVAL.OPERATE.$30
FCEVAL.OPERATE.$23:
;  261        v = combine(a, b, op_div)
	PUSHAL	FCEVAL.OPERATE.$K2
	PUSHAB	FCEVAL.OPERATE.B(FP)
	PUSHAB	FCEVAL.OPERATE.A(FP)
	PUSHAB	FCEVAL.OPERATE.$T1(FP)
	CALLS	#4,G^FCEVAL.COMBINE
	MOVC3	#96,FCEVAL.OPERATE.$T1(FP),@FCEVAL.OPERATE.V(AP)
;  262      case (op_epower)
	BRB	FCEVAL.OPERATE.$30
FCEVAL.OPERATE.$24:
;  263        v = combine(a, b, op_power)
	PUSHAL	FCEVAL.OPERATE.$K4
	PUSHAB	FCEVAL.OPERATE.B(FP)
	PUSHAB	FCEVAL.OPERATE.A(FP)
	PUSHAB	FCEVAL.OPERATE.$T1(FP)
	CALLS	#4,G^FCEVAL.COMBINE
	MOVC3	#96,FCEVAL.OPERATE.$T1(FP),@FCEVAL.OPERATE.V(AP)
;  264      case default
	BRB	FCEVAL.OPERATE.$30
FCEVAL.OPERATE.$20:
;  265        v = combine(a, b, p%op)
	MOVL	@FCEVAL.OPERATE.P(AP),R0
	PUSHAL	4(R0)
	PUSHAB	FCEVAL.OPERATE.B(FP)
	PUSHAB	FCEVAL.OPERATE.A(FP)
	PUSHAB	FCEVAL.OPERATE.$T1(FP)
	CALLS	#4,G^FCEVAL.COMBINE
	MOVC3	#96,FCEVAL.OPERATE.$T1(FP),@FCEVAL.OPERATE.V(AP)
;  266      end select
FCEVAL.OPERATE.$30:
;  267      call release(a)
	PUSHAB	FCEVAL.OPERATE.A(FP)
	CALLS	#1,G^FCARRAYS.RELEASE
;  268      call release(b)
	PUSHAB	FCEVAL.OPERATE.B(FP)
	CALLS	#1,G^FCARRAYS.RELEASE
;  269    end function operate
	RET

; Storage map for FCEVAL.SCALAR_OP, a TYPE(VALUE) function
;   V     TYPE(VALUE)              hidden argument 1  @FCEVAL.SCALAR_OP.V(AP)
;   X     TYPE(VALUE), INTENT(IN)  argument 2         @FCEVAL.SCALAR_OP.X(AP)
;   Y     TYPE(VALUE), INTENT(IN)  argument 3         @FCEVAL.SCALAR_OP.Y(AP)
;   OP    INTEGER, INTENT(IN)      argument 4         @FCEVAL.SCALAR_OP.OP(AP)
;   R6 is $T3: temporary
;
FCEVAL.SCALAR_OP.V = 4			; V's value goes through hidden argument 1
FCEVAL.SCALAR_OP.X = 8			; X is argument 2
FCEVAL.SCALAR_OP.Y = 12			; Y is argument 3
FCEVAL.SCALAR_OP.OP = 16		; OP is argument 4

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCEVAL.SCALAR_OP.$T1:
	.BLKL	8			; characters, for one statement
FCEVAL.SCALAR_OP.$T2:
	.BLKL	1			; temporary
FCEVAL.SCALAR_OP.$T4:
	.BLKL	1			; temporary

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  270
;  271    ! SCALAR_OP is X op Y for two scalar values.
;  272    function scalar_op(x, y, op) result(v)
	.ENTRY	FCEVAL.SCALAR_OP,^M<R2,R3,R4,R5,R6>
;  273      type(value), intent(in) :: x, y
;  274      integer, intent(in) :: op
;  275      type(value) :: v
;  276
;  277      select case (op)
	CASEL	@FCEVAL.SCALAR_OP.OP(AP),#1,#10
FCEVAL.SCALAR_OP.$1:
	.WORD	FCEVAL.SCALAR_OP.$2-FCEVAL.SCALAR_OP.$1
	.WORD	FCEVAL.SCALAR_OP.$3-FCEVAL.SCALAR_OP.$1
	.WORD	FCEVAL.SCALAR_OP.$4-FCEVAL.SCALAR_OP.$1
	.WORD	FCEVAL.SCALAR_OP.$5-FCEVAL.SCALAR_OP.$1
	.WORD	FCEVAL.SCALAR_OP.$6-FCEVAL.SCALAR_OP.$1
	.WORD	FCEVAL.SCALAR_OP.$7-FCEVAL.SCALAR_OP.$1
	.WORD	FCEVAL.SCALAR_OP.$8-FCEVAL.SCALAR_OP.$1
	.WORD	FCEVAL.SCALAR_OP.$8-FCEVAL.SCALAR_OP.$1
	.WORD	FCEVAL.SCALAR_OP.$8-FCEVAL.SCALAR_OP.$1
	.WORD	FCEVAL.SCALAR_OP.$9-FCEVAL.SCALAR_OP.$1
	.WORD	FCEVAL.SCALAR_OP.$10-FCEVAL.SCALAR_OP.$1
	BRW	FCEVAL.SCALAR_OP.$8
FCEVAL.SCALAR_OP.$2:
;  278      case (op_add)
;  279        v = x + y
	PUSHAB	@FCEVAL.SCALAR_OP.Y(AP)
	PUSHAB	@FCEVAL.SCALAR_OP.X(AP)
	PUSHAB	FCEVAL.SCALAR_OP.$T1
	CALLS	#3,G^FCVALUES.V_ADD
	MOVC3	#32,FCEVAL.SCALAR_OP.$T1,@FCEVAL.SCALAR_OP.V(AP)
;  280      case (op_sub)
	RET
FCEVAL.SCALAR_OP.$3:
;  281        v = x - y
	PUSHAB	@FCEVAL.SCALAR_OP.Y(AP)
	PUSHAB	@FCEVAL.SCALAR_OP.X(AP)
	PUSHAB	FCEVAL.SCALAR_OP.$T1
	CALLS	#3,G^FCVALUES.V_SUB
	MOVC3	#32,FCEVAL.SCALAR_OP.$T1,@FCEVAL.SCALAR_OP.V(AP)
;  282      case (op_mul)
	RET
FCEVAL.SCALAR_OP.$4:
;  283        v = x * y
	PUSHAB	@FCEVAL.SCALAR_OP.Y(AP)
	PUSHAB	@FCEVAL.SCALAR_OP.X(AP)
	PUSHAB	FCEVAL.SCALAR_OP.$T1
	CALLS	#3,G^FCVALUES.V_MUL
	MOVC3	#32,FCEVAL.SCALAR_OP.$T1,@FCEVAL.SCALAR_OP.V(AP)
;  284      case (op_div)
	RET
FCEVAL.SCALAR_OP.$5:
;  285        v = x / y
	PUSHAB	@FCEVAL.SCALAR_OP.Y(AP)
	PUSHAB	@FCEVAL.SCALAR_OP.X(AP)
	PUSHAB	FCEVAL.SCALAR_OP.$T1
	CALLS	#3,G^FCVALUES.V_DIV
	MOVC3	#32,FCEVAL.SCALAR_OP.$T1,@FCEVAL.SCALAR_OP.V(AP)
;  286      case (op_mod)
	RET
FCEVAL.SCALAR_OP.$6:
;  287        v = v_mod(x, y)
	PUSHAB	@FCEVAL.SCALAR_OP.Y(AP)
	PUSHAB	@FCEVAL.SCALAR_OP.X(AP)
	PUSHAB	FCEVAL.SCALAR_OP.$T1
	CALLS	#3,G^FCVALUES.V_MOD
	MOVC3	#32,FCEVAL.SCALAR_OP.$T1,@FCEVAL.SCALAR_OP.V(AP)
;  288      case (op_power)
	RET
FCEVAL.SCALAR_OP.$7:
;  289        v = x ** y
	PUSHAB	@FCEVAL.SCALAR_OP.Y(AP)
	PUSHAB	@FCEVAL.SCALAR_OP.X(AP)
	PUSHAB	FCEVAL.SCALAR_OP.$T1
	CALLS	#3,G^FCVALUES.V_POWER
	MOVC3	#32,FCEVAL.SCALAR_OP.$T1,@FCEVAL.SCALAR_OP.V(AP)
;  290      case (op_and)
	RET
FCEVAL.SCALAR_OP.$9:
;  291        v = logical_value(truth(x) .and. truth(y))
	PUSHAB	@FCEVAL.SCALAR_OP.X(AP)
	CALLS	#1,G^FCVALUES.TRUTH
	MOVL	R0,FCEVAL.SCALAR_OP.$T2
	PUSHAB	@FCEVAL.SCALAR_OP.Y(AP)
	CALLS	#1,G^FCVALUES.TRUTH
	MOVL	R0,R6
	MCOML	R6,R0
	BICL3	R0,FCEVAL.SCALAR_OP.$T2,FCEVAL.SCALAR_OP.$T4
	PUSHAL	FCEVAL.SCALAR_OP.$T4
	PUSHAB	FCEVAL.SCALAR_OP.$T1
	CALLS	#2,G^FCVALUES.LOGICAL_VALUE
	MOVC3	#32,FCEVAL.SCALAR_OP.$T1,@FCEVAL.SCALAR_OP.V(AP)
;  292      case (op_or)
	RET
FCEVAL.SCALAR_OP.$10:
;  293        v = logical_value(truth(x) .or. truth(y))
	PUSHAB	@FCEVAL.SCALAR_OP.X(AP)
	CALLS	#1,G^FCVALUES.TRUTH
	MOVL	R0,FCEVAL.SCALAR_OP.$T4
	PUSHAB	@FCEVAL.SCALAR_OP.Y(AP)
	CALLS	#1,G^FCVALUES.TRUTH
	MOVL	R0,R6
	BISL3	FCEVAL.SCALAR_OP.$T4,R6,FCEVAL.SCALAR_OP.$T2
	PUSHAL	FCEVAL.SCALAR_OP.$T2
	PUSHAB	FCEVAL.SCALAR_OP.$T1
	CALLS	#2,G^FCVALUES.LOGICAL_VALUE
	MOVC3	#32,FCEVAL.SCALAR_OP.$T1,@FCEVAL.SCALAR_OP.V(AP)
;  294      case default
	RET
FCEVAL.SCALAR_OP.$8:
;  295        v = v_compare(x, y, op - op_compare)
	SUBL3	#20,@FCEVAL.SCALAR_OP.OP(AP),FCEVAL.SCALAR_OP.$T2
	PUSHAL	FCEVAL.SCALAR_OP.$T2
	PUSHAB	@FCEVAL.SCALAR_OP.Y(AP)
	PUSHAB	@FCEVAL.SCALAR_OP.X(AP)
	PUSHAB	FCEVAL.SCALAR_OP.$T1
	CALLS	#4,G^FCVALUES.V_COMPARE
	MOVC3	#32,FCEVAL.SCALAR_OP.$T1,@FCEVAL.SCALAR_OP.V(AP)
;  296      end select
;  297    end function scalar_op
	RET

; Storage map for FCEVAL.COMBINE, a TYPE(QUANTITY) function
;   Q     TYPE(QUANTITY)              hidden argument 1  @FCEVAL.COMBINE.Q(AP)
;   A     TYPE(QUANTITY), INTENT(IN)  argument 2         @FCEVAL.COMBINE.A(AP)
;   B     TYPE(QUANTITY), INTENT(IN)  argument 3         @FCEVAL.COMBINE.B(AP)
;   OP    INTEGER, INTENT(IN)         argument 4         @FCEVAL.COMBINE.OP(AP)
;   R     TYPE(VALUE)                 $LOCAL+0           FCEVAL.COMBINE.R
;   I     INTEGER                     $LOCAL+32          FCEVAL.COMBINE.I
;   J     INTEGER                     $LOCAL+36          FCEVAL.COMBINE.J
;   R6 is $T5: temporary
;   R7 is $C2: DO (line 324)'s count
;   R9 is $R1: A's address
;   R10 is $R2: B's address
;   R11 is $R3: OP's address
;   R8 is $R4: Q's address
;
FCEVAL.COMBINE.Q = 4			; Q's value goes through hidden argument 1
FCEVAL.COMBINE.A = 8			; A is argument 2
FCEVAL.COMBINE.B = 12			; B is argument 3
FCEVAL.COMBINE.OP = 16			; OP is argument 4

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
	.ALIGN	4			; the boundary of this routine's aligned records
FCEVAL.COMBINE.R:
	.BLKL	8			; R
FCEVAL.COMBINE.I:
	.BLKL	1			; I
FCEVAL.COMBINE.J:
	.BLKL	1			; J
FCEVAL.COMBINE.$T1:
	.BLKL	1			; temporary
FCEVAL.COMBINE.$T2:
	.BLKL	1			; temporary
FCEVAL.COMBINE.$T3:
	.BLKL	24			; characters, for one statement
FCEVAL.COMBINE.$T4:
	.BLKL	8			; characters, for one statement
FCEVAL.COMBINE.$C1:
	.BLKL	1			; DO (line 323)'s count
FCEVAL.COMBINE.$T6:
	.BLKL	8			; characters, for one statement
FCEVAL.COMBINE.$T7:
	.BLKL	8			; characters, for one statement

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCEVAL.COMBINE.$K1:
	.LONG	27

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  298
;  299    ! COMBINE is A op B, element by element: two arrays of one shape element
;  300    ! with element, a scalar with each element of an array. The first
;  301    ! element's error is the whole result's.
;  302    function combine(a, b, op) result(q)
	.ENTRY	FCEVAL.COMBINE,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
;  303      type(quantity), intent(in) :: a, b
;  304      integer, intent(in) :: op
;  305      type(quantity) :: q
;  306      type(value) :: r
;  307      integer :: i, j
;  308
;  309      if (.not. is_array(a) .and. .not. is_array(b)) then
	PUSHAB	@FCEVAL.COMBINE.A(AP)
	CALLS	#1,G^FCARRAYS.IS_ARRAY
	MOVL	R0,FCEVAL.COMBINE.$T1
	PUSHAB	@FCEVAL.COMBINE.B(AP)
	CALLS	#1,G^FCARRAYS.IS_ARRAY
	MOVL	R0,FCEVAL.COMBINE.$T2
	BLBS	FCEVAL.COMBINE.$T1,FCEVAL.COMBINE.$1
	BLBS	FCEVAL.COMBINE.$T2,FCEVAL.COMBINE.$1
;  310        q = scalar_quantity(scalar_op(a%s, b%s, op))
	PUSHAL	@FCEVAL.COMBINE.OP(AP)
	MOVL	FCEVAL.COMBINE.B(AP),R0
	PUSHAB	16(R0)
	MOVL	FCEVAL.COMBINE.A(AP),R0
	PUSHAB	16(R0)
	PUSHAB	FCEVAL.COMBINE.$T4
	CALLS	#4,G^FCEVAL.SCALAR_OP
	PUSHAB	FCEVAL.COMBINE.$T4
	PUSHAB	FCEVAL.COMBINE.$T3
	CALLS	#2,G^FCARRAYS.SCALAR_QUANTITY
	MOVC3	#96,FCEVAL.COMBINE.$T3,@FCEVAL.COMBINE.Q(AP)
;  311        return
	RET
FCEVAL.COMBINE.$1:
;  312      end if
;  313      if (is_array(a) .and. is_array(b) .and. .not. same_shape(a, b)) then
	PUSHAB	@FCEVAL.COMBINE.A(AP)
	CALLS	#1,G^FCARRAYS.IS_ARRAY
	MOVL	R0,FCEVAL.COMBINE.$T2
	PUSHAB	@FCEVAL.COMBINE.B(AP)
	CALLS	#1,G^FCARRAYS.IS_ARRAY
	MOVL	R0,FCEVAL.COMBINE.$T1
	PUSHAB	@FCEVAL.COMBINE.B(AP)
	PUSHAB	@FCEVAL.COMBINE.A(AP)
	CALLS	#2,G^FCARRAYS.SAME_SHAPE
	MOVL	R0,R6
	BLBC	FCEVAL.COMBINE.$T2,FCEVAL.COMBINE.$4
	BLBC	FCEVAL.COMBINE.$T1,FCEVAL.COMBINE.$4
	BLBS	R6,FCEVAL.COMBINE.$4
;  314        q = failure(e_notconform)
	PUSHAL	FCEVAL.COMBINE.$K1
	PUSHAB	FCEVAL.COMBINE.$T3
	CALLS	#2,G^FCARRAYS.FAILURE
	MOVC3	#96,FCEVAL.COMBINE.$T3,@FCEVAL.COMBINE.Q(AP)
;  315        return
	RET
FCEVAL.COMBINE.$4:
;  316      end if
;  317      if (is_array(a)) then
	PUSHAB	@FCEVAL.COMBINE.A(AP)
	CALLS	#1,G^FCARRAYS.IS_ARRAY
	MOVL	R0,R6
	BLBC	R6,FCEVAL.COMBINE.$8
;  318        q = new_array(a%rows, a%cols)
	MOVL	FCEVAL.COMBINE.A(AP),R0
	PUSHAL	4(R0)
	PUSHAL	@FCEVAL.COMBINE.A(AP)
	PUSHAB	FCEVAL.COMBINE.$T3
	CALLS	#3,G^FCARRAYS.NEW_ARRAY
	MOVC3	#96,FCEVAL.COMBINE.$T3,@FCEVAL.COMBINE.Q(AP)
;  319      else
	BRB	FCEVAL.COMBINE.$10
FCEVAL.COMBINE.$8:
;  320        q = new_array(b%rows, b%cols)
	MOVL	FCEVAL.COMBINE.B(AP),R0
	PUSHAL	4(R0)
	PUSHAL	@FCEVAL.COMBINE.B(AP)
	PUSHAB	FCEVAL.COMBINE.$T3
	CALLS	#3,G^FCARRAYS.NEW_ARRAY
	MOVC3	#96,FCEVAL.COMBINE.$T3,@FCEVAL.COMBINE.Q(AP)
;  321      end if
FCEVAL.COMBINE.$10:
;  322      if (quantity_error(q) /= 0) return
	PUSHAB	@FCEVAL.COMBINE.Q(AP)
	CALLS	#1,G^FCARRAYS.QUANTITY_ERROR
	MOVL	R0,R6
	BEQL	FCEVAL.COMBINE.$11
	RET
FCEVAL.COMBINE.$11:
;  323      do j = 1, q%cols
	MOVL	FCEVAL.COMBINE.Q(AP),R0	; DO (line 323)'s count
	MOVL	4(R0),FCEVAL.COMBINE.$C1
	MOVL	#1,FCEVAL.COMBINE.J
	TSTL	FCEVAL.COMBINE.$C1
	BGTR	FCEVAL.COMBINE.$14
	RET
FCEVAL.COMBINE.$14:
	MOVL	FCEVAL.COMBINE.Q(AP),R8
FCEVAL.COMBINE.$15:			; DO (line 323)'s body
;  324        do i = 1, q%rows
	MOVL	(R8),R7			; DO (line 324)'s count
	MOVL	#1,FCEVAL.COMBINE.I
	TSTL	R7
	BGTR	FCEVAL.COMBINE.$17
	BRW	FCEVAL.COMBINE.$16
FCEVAL.COMBINE.$17:
	MOVL	FCEVAL.COMBINE.A(AP),R9
	MOVL	FCEVAL.COMBINE.B(AP),R10
	MOVL	FCEVAL.COMBINE.OP(AP),R11
FCEVAL.COMBINE.$18:			; DO (line 324)'s body
;  325          r = scalar_op(element(a, i, j), element(b, i, j), op)
	PUSHAL	FCEVAL.COMBINE.J
	PUSHAL	FCEVAL.COMBINE.I
	PUSHAB	(R9)
	PUSHAB	FCEVAL.COMBINE.$T6
	CALLS	#4,G^FCARRAYS.ELEMENT
	PUSHAL	FCEVAL.COMBINE.J
	PUSHAL	FCEVAL.COMBINE.I
	PUSHAB	(R10)
	PUSHAB	FCEVAL.COMBINE.$T7
	CALLS	#4,G^FCARRAYS.ELEMENT
	PUSHAL	(R11)
	PUSHAB	FCEVAL.COMBINE.$T7
	PUSHAB	FCEVAL.COMBINE.$T6
	PUSHAB	FCEVAL.COMBINE.$T4
	CALLS	#4,G^FCEVAL.SCALAR_OP
	MOVC3	#32,FCEVAL.COMBINE.$T4,FCEVAL.COMBINE.R
;  326          if (r%err /= 0) then
	TSTL	FCEVAL.COMBINE.R+16
	BEQL	FCEVAL.COMBINE.$19
;  327            call release(q)
	PUSHAB	@FCEVAL.COMBINE.Q(AP)
	CALLS	#1,G^FCARRAYS.RELEASE
;  328            q = failure(r%err)
	PUSHAL	FCEVAL.COMBINE.R+16
	PUSHAB	FCEVAL.COMBINE.$T3
	CALLS	#2,G^FCARRAYS.FAILURE
	MOVC3	#96,FCEVAL.COMBINE.$T3,@FCEVAL.COMBINE.Q(AP)
;  329            return
	RET
FCEVAL.COMBINE.$19:
;  330          end if
;  331          q%e(i, j) = r%z
	MOVAL	48(R8),R6
	MULL3	FCEVAL.COMBINE.I,20(R6),R0
	ADDL2	16(R6),R0
	MULL3	FCEVAL.COMBINE.J,24(R6),R1
	ADDL2	R1,R0
	MOVO	FCEVAL.COMBINE.R,(R0)
;  332        end do
	INCL	FCEVAL.COMBINE.I
	DECL	R7			; one pass fewer
	BLEQ	FCEVAL.COMBINE.$21
	BRW	FCEVAL.COMBINE.$18
FCEVAL.COMBINE.$21:
FCEVAL.COMBINE.$16:
;  333      end do
	INCL	FCEVAL.COMBINE.J
	DECL	FCEVAL.COMBINE.$C1	; one pass fewer
	BLEQ	FCEVAL.COMBINE.$22
	BRW	FCEVAL.COMBINE.$15
FCEVAL.COMBINE.$22:
;  334    end function combine
	RET

; Storage map for FCEVAL.UNARY, a TYPE(QUANTITY) function
;   Q     TYPE(QUANTITY)              hidden argument 1  @FCEVAL.UNARY.Q(AP)
;   A     TYPE(QUANTITY), INTENT(IN)  argument 2         @FCEVAL.UNARY.A(AP)
;   OP    INTEGER, INTENT(IN)         argument 3         @FCEVAL.UNARY.OP(AP)
;   R     TYPE(VALUE)                 $LOCAL+0           FCEVAL.UNARY.R
;   I     INTEGER                     $LOCAL+32          FCEVAL.UNARY.I
;   J     INTEGER                     $LOCAL+36          FCEVAL.UNARY.J
;   R6 is $T1: temporary
;   R11 is $C1: DO (line 350)'s count
;   R7 is $C2: DO (line 351)'s count
;   R9 is $R1: A's address
;   R10 is $R2: OP's address
;   R8 is $R3: Q's address
;
FCEVAL.UNARY.Q = 4			; Q's value goes through hidden argument 1
FCEVAL.UNARY.A = 8			; A is argument 2
FCEVAL.UNARY.OP = 12			; OP is argument 3

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
	.ALIGN	4			; the boundary of this routine's aligned records
FCEVAL.UNARY.R:
	.BLKL	8			; R
FCEVAL.UNARY.I:
	.BLKL	1			; I
FCEVAL.UNARY.J:
	.BLKL	1			; J
FCEVAL.UNARY.$T2:
	.BLKL	24			; characters, for one statement
FCEVAL.UNARY.$T3:
	.BLKL	8			; characters, for one statement
FCEVAL.UNARY.$T4:
	.BLKL	8			; characters, for one statement

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  335
;  336    ! UNARY is -A, +A, not A, or A!, element by element.
;  337    function unary(a, op) result(q)
	.ENTRY	FCEVAL.UNARY,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
;  338      type(quantity), intent(in) :: a
;  339      integer, intent(in) :: op
;  340      type(quantity) :: q
;  341      type(value) :: r
;  342      integer :: i, j
;  343
;  344      if (.not. is_array(a)) then
	PUSHAB	@FCEVAL.UNARY.A(AP)
	CALLS	#1,G^FCARRAYS.IS_ARRAY
	MOVL	R0,R6
	BLBS	R6,FCEVAL.UNARY.$1
;  345        q = scalar_quantity(scalar_unary(a%s, op))
	PUSHAL	@FCEVAL.UNARY.OP(AP)
	MOVL	FCEVAL.UNARY.A(AP),R0
	PUSHAB	16(R0)
	PUSHAB	FCEVAL.UNARY.$T3
	CALLS	#3,G^FCEVAL.SCALAR_UNARY
	PUSHAB	FCEVAL.UNARY.$T3
	PUSHAB	FCEVAL.UNARY.$T2
	CALLS	#2,G^FCARRAYS.SCALAR_QUANTITY
	MOVC3	#96,FCEVAL.UNARY.$T2,@FCEVAL.UNARY.Q(AP)
;  346        return
	RET
FCEVAL.UNARY.$1:
;  347      end if
;  348      q = new_array(a%rows, a%cols)
	MOVL	FCEVAL.UNARY.A(AP),R0
	PUSHAL	4(R0)
	PUSHAL	@FCEVAL.UNARY.A(AP)
	PUSHAB	FCEVAL.UNARY.$T2
	CALLS	#3,G^FCARRAYS.NEW_ARRAY
	MOVC3	#96,FCEVAL.UNARY.$T2,@FCEVAL.UNARY.Q(AP)
;  349      if (quantity_error(q) /= 0) return
	PUSHAB	@FCEVAL.UNARY.Q(AP)
	CALLS	#1,G^FCARRAYS.QUANTITY_ERROR
	MOVL	R0,R6
	BEQL	FCEVAL.UNARY.$3
	RET
FCEVAL.UNARY.$3:
;  350      do j = 1, q%cols
	MOVL	FCEVAL.UNARY.Q(AP),R0	; DO (line 350)'s count
	MOVL	4(R0),R11
	MOVL	#1,FCEVAL.UNARY.J
	TSTL	R11
	BGTR	FCEVAL.UNARY.$6
	RET
FCEVAL.UNARY.$6:
	MOVL	FCEVAL.UNARY.Q(AP),R8
FCEVAL.UNARY.$7:			; DO (line 350)'s body
;  351        do i = 1, q%rows
	MOVL	(R8),R7			; DO (line 351)'s count
	MOVL	#1,FCEVAL.UNARY.I
	TSTL	R7
	BGTR	FCEVAL.UNARY.$9
	BRW	FCEVAL.UNARY.$8
FCEVAL.UNARY.$9:
	MOVL	FCEVAL.UNARY.A(AP),R9
	MOVL	FCEVAL.UNARY.OP(AP),R10
FCEVAL.UNARY.$10:			; DO (line 351)'s body
;  352          r = scalar_unary(element(a, i, j), op)
	PUSHAL	FCEVAL.UNARY.J
	PUSHAL	FCEVAL.UNARY.I
	PUSHAB	(R9)
	PUSHAB	FCEVAL.UNARY.$T4
	CALLS	#4,G^FCARRAYS.ELEMENT
	PUSHAL	(R10)
	PUSHAB	FCEVAL.UNARY.$T4
	PUSHAB	FCEVAL.UNARY.$T3
	CALLS	#3,G^FCEVAL.SCALAR_UNARY
	MOVC3	#32,FCEVAL.UNARY.$T3,FCEVAL.UNARY.R
;  353          if (r%err /= 0) then
	TSTL	FCEVAL.UNARY.R+16
	BEQL	FCEVAL.UNARY.$11
;  354            call release(q)
	PUSHAB	@FCEVAL.UNARY.Q(AP)
	CALLS	#1,G^FCARRAYS.RELEASE
;  355            q = failure(r%err)
	PUSHAL	FCEVAL.UNARY.R+16
	PUSHAB	FCEVAL.UNARY.$T2
	CALLS	#2,G^FCARRAYS.FAILURE
	MOVC3	#96,FCEVAL.UNARY.$T2,@FCEVAL.UNARY.Q(AP)
;  356            return
	RET
FCEVAL.UNARY.$11:
;  357          end if
;  358          q%e(i, j) = r%z
	MOVAL	48(R8),R6
	MULL3	FCEVAL.UNARY.I,20(R6),R0
	ADDL2	16(R6),R0
	MULL3	FCEVAL.UNARY.J,24(R6),R1
	ADDL2	R1,R0
	MOVO	FCEVAL.UNARY.R,(R0)
;  359        end do
	INCL	FCEVAL.UNARY.I
	DECL	R7			; one pass fewer
	BLEQ	FCEVAL.UNARY.$13
	BRW	FCEVAL.UNARY.$10
FCEVAL.UNARY.$13:
FCEVAL.UNARY.$8:
;  360      end do
	INCL	FCEVAL.UNARY.J
	DECL	R11			; one pass fewer
	BLEQ	FCEVAL.UNARY.$14
	BRW	FCEVAL.UNARY.$7
FCEVAL.UNARY.$14:
;  361    end function unary
	RET

; Storage map for FCEVAL.SCALAR_UNARY, a TYPE(VALUE) function
;   V     TYPE(VALUE)              hidden argument 1  @FCEVAL.SCALAR_UNARY.V(AP)
;   X     TYPE(VALUE), INTENT(IN)  argument 2         @FCEVAL.SCALAR_UNARY.X(AP)
;   OP    INTEGER, INTENT(IN)      argument 3         @FCEVAL.SCALAR_UNARY.OP(AP)
;
FCEVAL.SCALAR_UNARY.V = 4		; V's value goes through hidden argument 1
FCEVAL.SCALAR_UNARY.X = 8		; X is argument 2
FCEVAL.SCALAR_UNARY.OP = 12		; OP is argument 3

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCEVAL.SCALAR_UNARY.$T1:
	.BLKL	8			; characters, for one statement
FCEVAL.SCALAR_UNARY.$T2:
	.BLKL	1			; temporary
FCEVAL.SCALAR_UNARY.$T3:
	.BLKL	1			; temporary

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  362
;  363    function scalar_unary(x, op) result(v)
	.ENTRY	FCEVAL.SCALAR_UNARY,^M<R2,R3,R4,R5>
;  364      type(value), intent(in) :: x
;  365      integer, intent(in) :: op
;  366      type(value) :: v
;  367
;  368      select case (op)
	CMPL	@FCEVAL.SCALAR_UNARY.OP(AP),#7
	BEQL	FCEVAL.SCALAR_UNARY.$1
	CMPL	@FCEVAL.SCALAR_UNARY.OP(AP),#8
	BEQL	FCEVAL.SCALAR_UNARY.$3
	CMPL	@FCEVAL.SCALAR_UNARY.OP(AP),#9
	BNEQ	FCEVAL.SCALAR_UNARY.$7
	BRB	FCEVAL.SCALAR_UNARY.$5
FCEVAL.SCALAR_UNARY.$1:
;  369      case (op_neg)
;  370        v = -x
	PUSHAB	@FCEVAL.SCALAR_UNARY.X(AP)
	PUSHAB	FCEVAL.SCALAR_UNARY.$T1
	CALLS	#2,G^FCVALUES.V_NEG
	MOVC3	#32,FCEVAL.SCALAR_UNARY.$T1,@FCEVAL.SCALAR_UNARY.V(AP)
;  371      case (op_plus)
	RET
FCEVAL.SCALAR_UNARY.$3:
;  372        v = +x
	PUSHAB	@FCEVAL.SCALAR_UNARY.X(AP)
	PUSHAB	FCEVAL.SCALAR_UNARY.$T1
	CALLS	#2,G^FCVALUES.V_PLUS
	MOVC3	#32,FCEVAL.SCALAR_UNARY.$T1,@FCEVAL.SCALAR_UNARY.V(AP)
;  373      case (op_not)
	RET
FCEVAL.SCALAR_UNARY.$5:
;  374        v = logical_value(.not. truth(x))
	PUSHAB	@FCEVAL.SCALAR_UNARY.X(AP)
	CALLS	#1,G^FCVALUES.TRUTH
	MOVL	R0,FCEVAL.SCALAR_UNARY.$T2
	MCOML	FCEVAL.SCALAR_UNARY.$T2,FCEVAL.SCALAR_UNARY.$T3
	PUSHAL	FCEVAL.SCALAR_UNARY.$T3
	PUSHAB	FCEVAL.SCALAR_UNARY.$T1
	CALLS	#2,G^FCVALUES.LOGICAL_VALUE
	MOVC3	#32,FCEVAL.SCALAR_UNARY.$T1,@FCEVAL.SCALAR_UNARY.V(AP)
;  375      case default
	RET
FCEVAL.SCALAR_UNARY.$7:
;  376        v = factorial_value(x)
	PUSHAB	@FCEVAL.SCALAR_UNARY.X(AP)
	PUSHAB	FCEVAL.SCALAR_UNARY.$T1
	CALLS	#2,G^FCFUNCS.FACTORIAL_VALUE
	MOVC3	#32,FCEVAL.SCALAR_UNARY.$T1,@FCEVAL.SCALAR_UNARY.V(AP)
;  377      end select
;  378    end function scalar_unary
	RET

; Storage map for FCEVAL.MATRIX_LITERAL, a RECURSIVE TYPE(QUANTITY) function
;   V      TYPE(QUANTITY)                     hidden argument 1  @FCEVAL.MATRIX_LITERAL.V(AP)
;   P      TYPE(NODE), POINTER                argument 2         @FCEVAL.MATRIX_LITERAL.P(AP)
;   F      TYPE(FRAME), INTENT(IN), OPTIONAL  an argument        @FCEVAL.MATRIX_LITERAL.$A3(FP)
;   ROW    TYPE(NODE), POINTER                FP-112             FCEVAL.MATRIX_LITERAL.ROW(FP)
;   E      TYPE(NODE), POINTER                FP-108             FCEVAL.MATRIX_LITERAL.E(FP)
;   TOTAL  INTEGER                            FP-104             FCEVAL.MATRIX_LITERAL.TOTAL(FP)
;   R6 is $R1: TOTAL, during a loop
;
FCEVAL.MATRIX_LITERAL.V = 4		; V's value goes through hidden argument 1
FCEVAL.MATRIX_LITERAL.P = 8		; P is argument 2
FCEVAL.MATRIX_LITERAL.ROW = -112	; ROW, in the frame
FCEVAL.MATRIX_LITERAL.E = -108		; E, in the frame
FCEVAL.MATRIX_LITERAL.TOTAL = -104	; TOTAL, in the frame
FCEVAL.MATRIX_LITERAL.$A3 = -100	; F's longword of the argument list, set at each entry point, in the frame
FCEVAL.MATRIX_LITERAL.$T1 = -96		; characters, for one statement, in the frame

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  379
;  380    ! ------------------------------------------------------------------
;  381    ! Matrices written out.
;  382
;  383    ! MATRIX_LITERAL is [a, b; c, d]. Each element is evaluated, and may
;  384    ! itself be an array: the elements of a row are put side by side, so
;  385    ! each must have as many rows as the row's first, and the rows one under
;  386    ! another, so each must be as wide as the first. [v, 4] is v with a 4
;  387    ! after it; [m; 0, 0] is m with a row of zeros under it.
;  388    recursive function matrix_literal(p, f) result(v)
	.ENTRY	FCEVAL.MATRIX_LITERAL,^M<R2,R3,R4,R5,R6>
	SUBL2	#112,SP			; this activation's own storage
	CLRL	FCEVAL.MATRIX_LITERAL.$A3(FP) ; F is argument 3, if the caller passed it
	CMPB	(AP),#3
	BLSSU	FCEVAL.MATRIX_LITERAL.$7
	MOVL	12(AP),FCEVAL.MATRIX_LITERAL.$A3(FP)
FCEVAL.MATRIX_LITERAL.$7:
;  389      type(node), pointer :: p
;  390      type(frame), intent(in), optional :: f
;  391      type(quantity) :: v
;  392      type(node), pointer :: row, e
;  393      integer :: total
;  394
;  395      total = 0
	CLRL	FCEVAL.MATRIX_LITERAL.TOTAL(FP)
;  396      row => p%kid
	MOVL	@FCEVAL.MATRIX_LITERAL.P(AP),R0
	MOVL	80(R0),FCEVAL.MATRIX_LITERAL.ROW(FP)
;  397      do while (associated(row))
	BRB	FCEVAL.MATRIX_LITERAL.$1
FCEVAL.MATRIX_LITERAL.$2:		; DO (line 397)'s body
;  398        e => row%kid
	MOVL	FCEVAL.MATRIX_LITERAL.ROW(FP),R0
	MOVL	80(R0),FCEVAL.MATRIX_LITERAL.E(FP)
;  399        do while (associated(e))
	MOVL	FCEVAL.MATRIX_LITERAL.TOTAL(FP),R6
	BRB	FCEVAL.MATRIX_LITERAL.$3
FCEVAL.MATRIX_LITERAL.$4:		; DO (line 399)'s body
;  400          total = total + 1
	INCL	R6
;  401          e => e%next
	MOVL	FCEVAL.MATRIX_LITERAL.E(FP),R0
	MOVL	84(R0),FCEVAL.MATRIX_LITERAL.E(FP)
;  402        end do
FCEVAL.MATRIX_LITERAL.$3:		; DO (line 399)'s test
	TSTL	FCEVAL.MATRIX_LITERAL.E(FP) ; from line 399
	BNEQ	FCEVAL.MATRIX_LITERAL.$4
	MOVL	R6,FCEVAL.MATRIX_LITERAL.TOTAL(FP)
;  403        row => row%next
	MOVL	FCEVAL.MATRIX_LITERAL.ROW(FP),R0
	MOVL	84(R0),FCEVAL.MATRIX_LITERAL.ROW(FP)
;  404      end do
FCEVAL.MATRIX_LITERAL.$1:		; DO (line 397)'s test
	TSTL	FCEVAL.MATRIX_LITERAL.ROW(FP) ; from line 397
	BNEQ	FCEVAL.MATRIX_LITERAL.$2
;  405      v = literal_parts(p, total, f)
	PUSHAB	@FCEVAL.MATRIX_LITERAL.$A3(FP)
	PUSHAL	FCEVAL.MATRIX_LITERAL.TOTAL(FP)
	PUSHAL	@FCEVAL.MATRIX_LITERAL.P(AP)
	PUSHAB	FCEVAL.MATRIX_LITERAL.$T1(FP)
	CALLS	#4,G^FCEVAL.LITERAL_PARTS
	MOVC3	#96,FCEVAL.MATRIX_LITERAL.$T1(FP),@FCEVAL.MATRIX_LITERAL.V(AP)
;  406    end function matrix_literal
	RET

; Storage map for FCEVAL.LITERAL_PARTS, a RECURSIVE TYPE(QUANTITY) function
;   V       TYPE(QUANTITY)                     a hidden argument  @FCEVAL.LITERAL_PARTS.$A1(FP)
;   P       TYPE(NODE), POINTER                argument 2         @FCEVAL.LITERAL_PARTS.P(AP)
;   TOTAL   INTEGER, INTENT(IN)                an argument        @FCEVAL.LITERAL_PARTS.$A3(FP)
;   F       TYPE(FRAME), INTENT(IN), OPTIONAL  an argument        @FCEVAL.LITERAL_PARTS.$A4(FP)
;   PARTS   TYPE(QUANTITY) (?)                 FP-292             FCEVAL.LITERAL_PARTS.PARTS(FP)
;   ROW     TYPE(NODE), POINTER                FP-260             FCEVAL.LITERAL_PARTS.ROW(FP)
;   E       TYPE(NODE), POINTER                FP-256             FCEVAL.LITERAL_PARTS.E(FP)
;   K       INTEGER                            FP-252             FCEVAL.LITERAL_PARTS.K(FP)
;   H       INTEGER                            FP-248             FCEVAL.LITERAL_PARTS.H(FP)
;   W       INTEGER                            FP-244             FCEVAL.LITERAL_PARTS.W(FP)
;   WIDTH   INTEGER                            FP-240             FCEVAL.LITERAL_PARTS.WIDTH(FP)
;   HEIGHT  INTEGER                            FP-236             FCEVAL.LITERAL_PARTS.HEIGHT(FP)
;   R0      INTEGER                            FP-232             FCEVAL.LITERAL_PARTS.R0(FP)
;   C0      INTEGER                            FP-228             FCEVAL.LITERAL_PARTS.C0(FP)
;   R7 is $I1: an array statement's loop index
;   R8 is $I2: an array statement's loop index
;   R11 is $T4: temporary
;   R10 is $L2: array (line 488), dimension 1's limit
;   R6 is $T12: temporary
;   R6 is $R1: an index stepped with K
;   R6 is $R2: an index stepped with K
;   R8 is $R3: an index stepped with K
;   R9 is $R4: V's address
;   R7 is $R5: F's address
;   R7 is $R6: WIDTH, during a loop
;   R9 is $R7: HEIGHT, during a loop
;   FCEVAL.LITERAL_PARTS.$N3 is FCEVAL.LITERAL_PARTS.RELEASE_PARTS
;
FCEVAL.LITERAL_PARTS.P = 8		; P is argument 2
FCEVAL.LITERAL_PARTS.PARTS = -292	; PARTS, TYPE(QUANTITY) (?), automatic: its descriptor, in the frame
FCEVAL.LITERAL_PARTS.ROW = -260		; ROW, in the frame
FCEVAL.LITERAL_PARTS.E = -256		; E, in the frame
FCEVAL.LITERAL_PARTS.K = -252		; K, in the frame
FCEVAL.LITERAL_PARTS.H = -248		; H, in the frame
FCEVAL.LITERAL_PARTS.W = -244		; W, in the frame
FCEVAL.LITERAL_PARTS.WIDTH = -240	; WIDTH, in the frame
FCEVAL.LITERAL_PARTS.HEIGHT = -236	; HEIGHT, in the frame
FCEVAL.LITERAL_PARTS.R0 = -232		; R0, in the frame
FCEVAL.LITERAL_PARTS.C0 = -228		; C0, in the frame
FCEVAL.LITERAL_PARTS.$A4 = -224		; F's longword of the argument list, set at each entry point, in the frame
FCEVAL.LITERAL_PARTS.$A1 = -220		; V's longword of the argument list, set at each entry point, in the frame
FCEVAL.LITERAL_PARTS.$A3 = -216		; TOTAL's longword of the argument list, set at each entry point, in the frame
FCEVAL.LITERAL_PARTS.$T1 = -212		; temporary, in the frame
FCEVAL.LITERAL_PARTS.$T2 = -208		; temporary, in the frame
FCEVAL.LITERAL_PARTS.$T3 = -204		; characters, for one statement, in the frame
FCEVAL.LITERAL_PARTS.$T5 = -96		; temporary, in the frame
FCEVAL.LITERAL_PARTS.$T6 = -92		; temporary, in the frame
FCEVAL.LITERAL_PARTS.$T7 = -88		; temporary, in the frame
FCEVAL.LITERAL_PARTS.$G1 = -84		; a function's value of run-time shape, for one statement: its descriptor, in the frame
FCEVAL.LITERAL_PARTS.$T8 = -40		; temporary, in the frame
FCEVAL.LITERAL_PARTS.$T9 = -36		; temporary, in the frame
FCEVAL.LITERAL_PARTS.$T10 = -32		; temporary, in the frame
FCEVAL.LITERAL_PARTS.$T11 = -28		; temporary, in the frame
FCEVAL.LITERAL_PARTS.$L1 = -24		; array (line 488), dimension 2's limit, in the frame
FCEVAL.LITERAL_PARTS.$H1 = -12		; a value computed before a loop, in the frame
FCEVAL.LITERAL_PARTS.$H2 = -8		; a value computed before a loop, in the frame
FCEVAL.LITERAL_PARTS.$U1 = -4		; temporary, in the frame

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCEVAL.LITERAL_PARTS.$K1:
	.LONG	34

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  407
;  408    ! LITERAL_PARTS evaluates the literal P's TOTAL elements into PARTS, an
;  409    ! automatic array of quantities, then puts them in place. Each part is
;  410    ! released once its elements are copied.
;  411    recursive function literal_parts(p, total, f) result(v)
	.ENTRY	FCEVAL.LITERAL_PARTS,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	SUBL2	#292,SP			; this activation's own storage
	CLRL	FCEVAL.LITERAL_PARTS.$A4(FP) ; F is argument 4, if the caller passed it
	CMPB	(AP),#4
	BLSSU	FCEVAL.LITERAL_PARTS.$52
	MOVL	16(AP),FCEVAL.LITERAL_PARTS.$A4(FP)
FCEVAL.LITERAL_PARTS.$52:
	MOVL	4(AP),FCEVAL.LITERAL_PARTS.$A1(FP) ; V is argument 1
	MOVL	12(AP),FCEVAL.LITERAL_PARTS.$A3(FP) ; TOTAL is argument 3
	MOVL	#67108960,FCEVAL.LITERAL_PARTS.PARTS(FP) ; the descriptor's length, 96, type, and class
	MOVL	#31457280,FCEVAL.LITERAL_PARTS.PARTS+8(FP) ; its flags and dimensions
	CLRL	FCEVAL.LITERAL_PARTS.PARTS+12(FP) ; the array's size in bytes
	CLRL	FCEVAL.LITERAL_PARTS.PARTS+20(FP) ; dimension 1's multiplier
	MOVL	#1,FCEVAL.LITERAL_PARTS.PARTS+24(FP) ; dimension 1's lower bound
	CLRL	FCEVAL.LITERAL_PARTS.PARTS+28(FP) ; dimension 1's upper bound
	MOVL	@FCEVAL.LITERAL_PARTS.$A3(FP),FCEVAL.LITERAL_PARTS.PARTS+28(FP)
	MOVL	FCEVAL.LITERAL_PARTS.PARTS+28(FP),FCEVAL.LITERAL_PARTS.PARTS+20(FP)
	BGEQ	FCEVAL.LITERAL_PARTS.$1
	CLRL	FCEVAL.LITERAL_PARTS.PARTS+20(FP) ; dimension 1's multiplier
FCEVAL.LITERAL_PARTS.$1:
	MULL3	#96,FCEVAL.LITERAL_PARTS.PARTS+20(FP),FCEVAL.LITERAL_PARTS.PARTS+12(FP)
	SUBL2	FCEVAL.LITERAL_PARTS.PARTS+12(FP),SP ; storage of a size known only now
	BICL2	#3,SP
	MOVL	SP,FCEVAL.LITERAL_PARTS.PARTS+4(FP)
	MOVAB	@FCEVAL.LITERAL_PARTS.PARTS+4(FP),FCEVAL.LITERAL_PARTS.$T1(FP)
	DIVL3	#96,FCEVAL.LITERAL_PARTS.PARTS+12(FP),FCEVAL.LITERAL_PARTS.$T2(FP)
	BLEQ	FCEVAL.LITERAL_PARTS.$3
FCEVAL.LITERAL_PARTS.$5:		; clears QUANTITY's pointers
	MOVL	FCEVAL.LITERAL_PARTS.$T1(FP),R0
	CLRL	52(R0)
	ADDL2	#96,FCEVAL.LITERAL_PARTS.$T1(FP)
	SOBGTR	FCEVAL.LITERAL_PARTS.$T2(FP),FCEVAL.LITERAL_PARTS.$5
FCEVAL.LITERAL_PARTS.$3:
	MOVL	FCEVAL.LITERAL_PARTS.PARTS+4(FP),R0
	MOVAB	-96(R0),FCEVAL.LITERAL_PARTS.PARTS+16(FP)
	CLRL	FCEVAL.LITERAL_PARTS.E(FP)
	CLRL	FCEVAL.LITERAL_PARTS.$G1+4(FP) ; no string yet
;  412      type(node), pointer :: p
;  413      integer, intent(in) :: total
;  414      type(frame), intent(in), optional :: f
;  415      type(quantity) :: v
;  416      type(quantity) :: parts(total)
;  417      type(node), pointer :: row, e
;  418      integer :: k, h, w, width, height, r0, c0
;  419
;  420      ! The elements, in order.
;  421      k = 0
	CLRL	FCEVAL.LITERAL_PARTS.K(FP)
;  422      row => p%kid
	MOVL	@FCEVAL.LITERAL_PARTS.P(AP),R0
	MOVL	80(R0),FCEVAL.LITERAL_PARTS.ROW(FP)
;  423      do while (associated(row))
	BRW	FCEVAL.LITERAL_PARTS.$7
FCEVAL.LITERAL_PARTS.$8:		; DO (line 423)'s body
;  424        e => row%kid
	MOVL	FCEVAL.LITERAL_PARTS.ROW(FP),R0
	MOVL	80(R0),FCEVAL.LITERAL_PARTS.E(FP)
;  425        do while (associated(e))
	MULL3	FCEVAL.LITERAL_PARTS.K(FP),#96,R6
	MOVL	FCEVAL.LITERAL_PARTS.$A4(FP),R7
	BRW	FCEVAL.LITERAL_PARTS.$9
FCEVAL.LITERAL_PARTS.$10:		; DO (line 425)'s body
;  426          k = k + 1
	ADDL2	#96,R6
	INCL	FCEVAL.LITERAL_PARTS.K(FP)
;  427          parts(k) = evaluate(e, f)
	PUSHAB	(R7)
	PUSHAL	FCEVAL.LITERAL_PARTS.E(FP)
	PUSHAB	FCEVAL.LITERAL_PARTS.$T3(FP)
	CALLS	#3,G^FCEVAL.EVALUATE
	MOVL	R6,FCEVAL.LITERAL_PARTS.$U1(FP)
	MOVL	FCEVAL.LITERAL_PARTS.$U1(FP),R0
	MOVC3	#96,FCEVAL.LITERAL_PARTS.$T3(FP),@FCEVAL.LITERAL_PARTS.PARTS+16(FP)[R0]
;  428          if (quantity_error(parts(k)) /= 0) then
	MOVL	FCEVAL.LITERAL_PARTS.$U1(FP),R0
	PUSHAB	@FCEVAL.LITERAL_PARTS.PARTS+16(FP)[R0]
	CALLS	#1,G^FCARRAYS.QUANTITY_ERROR
	MOVL	R0,FCEVAL.LITERAL_PARTS.$T2(FP)
	BEQL	FCEVAL.LITERAL_PARTS.$11
;  429            v = parts(k)
	MULL3	FCEVAL.LITERAL_PARTS.K(FP),#96,R0
	MOVC3	#96,@FCEVAL.LITERAL_PARTS.PARTS+16(FP)[R0],@FCEVAL.LITERAL_PARTS.$A1(FP)
;  430            call release_parts(k - 1)
	SUBL3	#1,FCEVAL.LITERAL_PARTS.K(FP),FCEVAL.LITERAL_PARTS.$T2(FP)
	PUSHL	FP
	PUSHAL	FCEVAL.LITERAL_PARTS.$T2(FP)
	CALLS	#2,FCEVAL.LITERAL_PARTS.$N3
;  431            return
	RET
FCEVAL.LITERAL_PARTS.$11:
;  432          end if
;  433          e => e%next
	MOVL	FCEVAL.LITERAL_PARTS.E(FP),R0
	MOVL	84(R0),FCEVAL.LITERAL_PARTS.E(FP)
;  434        end do
FCEVAL.LITERAL_PARTS.$9:		; DO (line 425)'s test
	TSTL	FCEVAL.LITERAL_PARTS.E(FP) ; from line 425
