;   94      message('E', 'TOOBIG', 'array is too large'), &
;   95      message('E', 'RBRACKET', 'missing right bracket'), &
;   96      message('E', 'NOTVECTOR', 'operand must be a vector'), &
;   97      message('E', 'KEYWORD', '!AS expected'), message('E', 'NOROOT', 'no root was found'), &
;   98      message('E', 'SAMESIGN', 'no change of sign between the bounds'), &
;   99      message('W', 'INACCURATE', 'error may be as large as !AS'), &
;  100      message('E', 'BADSTEP', 'step does not lead from FROM to TO'), message('E', 'TOOMANY', 'too many !AS'), &
;  101      message('E', 'BADLIMITS', 'lower limit must be below upper limit'), &
;  102      message('E', 'NOPOINTS', 'no point can be plotted'), &
;  103      message('E', 'FILEREQ', 'file name expected'), message('E', 'NOFILE', 'file !AS was not found'), &
