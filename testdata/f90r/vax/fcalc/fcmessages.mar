;   28    ! that USEs it sees only what a PUBLIC statement names. This keeps the
;   29    ! module's own variables (the error waiting, below) safe from change by
;   30    ! anything but its own procedures.
;   31    private
;   32
;   33    public :: say, say_more, fail, failed, clear_error, report, error_code
;   34    public :: indent, say_part, say_end, error_ident, error_is_warning
;   35    public :: also, log_unit, log_line
;   36
;   37    ! The message codes, an index into MESSAGES.
;   38    integer, parameter, public :: e_badchar = 1, e_badnumber = 2, e_operand = 3, &
;   39      e_rparen = 4, e_extra = 5, e_undefined = 6, e_nofunc = 7, e_constant = 8, &
;   40      e_divzero = 9, e_overflow = 10, e_domain = 11, e_notreal = 12, &
;   41      e_toodeep = 13, e_linelong = 14, e_namelong = 15, e_notwhole = 16, &
;   42      e_badset = 17, w_notdef = 18, e_badcmd = 19, e_namereq = 20, &
;   43      e_reserved = 21, e_argcount = 22, e_builtin = 23, e_recursion = 24, &
;   44      e_params = 25, e_dupparam = 26, e_notconform = 27, e_notsquare = 28, &
;   45      e_singular = 29, e_index = 30, e_notscalar = 31, e_noconverge = 32, &
;   46      e_badrange = 33, e_toobig = 34, e_rbracket = 35, e_notvector = 36, &
;   47      e_keyword = 37, e_noroot = 38, e_samesign = 39, w_inaccurate = 40, &
;   48      e_badstep = 41, e_toomany = 42, e_badlimits = 43, e_nopoints = 44, &
;   49      e_filereq = 45, e_nofile = 46, e_fileerr = 47, e_nesting = 48, &
