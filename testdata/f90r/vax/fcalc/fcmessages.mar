;   58      character(len=10) :: ident
;   59      character(len=40) :: text
;   60    end type message
;   61
;   62    ! The table itself: a constant array of MESSAGEs, made by an array
;   63    ! constructor, (/ ... /), whose elements are structure constructors,
;   64    ! message('E', 'BADCHAR', ...), each giving the components in order. A
;   65    ! shorter text is padded with blanks to the component's length. & at a
