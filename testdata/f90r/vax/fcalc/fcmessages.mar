;    1  ! fcalc: output and messages.
;    2  !
;    3  ! Every line fcalc writes goes through SAY, so the carriage control the
;    4  ! system wants is in one place (module FCPLATFORM). An error is a code, the
;    5  ! column of the line it is about, and a text it names (a variable's name),
;    6  ! kept here until it is reported: the parser and the evaluator stop at the
;    7  ! first, and the main program reports it in VMS's form,
;    8  !
;    9  !     fcalc> 1/0
;   10  !             ^
;   11  !     %FCALC-E-DIVZERO, division by zero
;   12  !
;   13  ! the pointer under the column of the line the user typed after the prompt.
;   14  !
;   15  ! Why keep an error instead of printing it at once? The parser and the
;   16  ! evaluator are deep in recursive calls when they find one; recording it
;   17  ! and returning lets every level unwind normally, freeing what it built,
;   18  ! and the main program prints the message once everything is tidy. (Fortran
;   19  ! 90 has no exceptions: a program carries its errors back itself.)
;   20  module fcmessages
;   21    ! USE ... ONLY takes just the names listed, so a reader sees at once
;   22    ! what this module needs from each other one.
;   23    use fcplatform, only: cc, record_room, prompt_ends
;   24    use fckinds, only: line_length
;   25    implicit none
;   26
