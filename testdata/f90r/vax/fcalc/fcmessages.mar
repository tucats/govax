;  194
;  195    ! LOG_LINE writes TEXT to the log, if one is open, ending its record:
;  196    ! a line the terminal showed and the log must have too (one typed after
;  197    ! the prompt, which the terminal echoes itself).
;  198    subroutine log_line(text)
	.ENTRY	FCMESSAGES.LOG_LINE,^M<>
;  199      character(len=*), intent(in) :: text
;  200
;  201      if (log_unit /= 0) write (log_unit, '(A)') text
	TSTL	FCMESSAGES.LOG_UNIT
	BEQL	FCMESSAGES.LOG_LINE.$1
	PUSHAQ	FCMESSAGES.LOG_LINE.$D1
	PUSHL	FCMESSAGES.LOG_UNIT
	PUSHAB	FCMESSAGES.LOG_LINE.$IO1
	CALLS	#3,G^FTN$WRITE_SF
	MOVW	@FCMESSAGES.LOG_LINE.TEXT(AP),FCMESSAGES.LOG_LINE.$D2
	MOVL	FCMESSAGES.LOG_LINE.TEXT(AP),R0
	MOVAB	@4(R0),FCMESSAGES.LOG_LINE.$D2+4
	PUSHAQ	FCMESSAGES.LOG_LINE.$D2
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
FCMESSAGES.LOG_LINE.$1:
;  202    end subroutine log_line
	RET

; Storage map for FCMESSAGES.SAY_MORE, a subroutine
;   TEXT  CHARACTER*(*), INTENT(IN)  argument 1  @FCMESSAGES.SAY_MORE.TEXT(AP)
;
FCMESSAGES.SAY_MORE.TEXT = 4		; TEXT is argument 1

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCMESSAGES.SAY_MORE.$D3:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCMESSAGES.SAY_MORE.$IO1:
	.WORD	8			; an I/O statement's control block: its size
	.WORD	^X0038			; flags: run-time format F90 nonadvancing
	.LONG	0			; (not used yet)
FCMESSAGES.SAY_MORE.$D1:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCMESSAGES.SAY_MORE.$K1
FCMESSAGES.SAY_MORE.$D2:
	.WORD	1			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCMESSAGES.SAY_MORE.$K2
FCMESSAGES.SAY_MORE.$D4:
	.WORD	3			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCMESSAGES.SAY_MORE.$K3
FCMESSAGES.SAY_MORE.$K1:
	.ASCII	/(2A)/
FCMESSAGES.SAY_MORE.$K2:
	.ASCII	/ /
FCMESSAGES.SAY_MORE.$K3:
	.ASCII	/(A)/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  203
;  204    ! SAY_MORE writes text and leaves the line open, for a prompt: ADVANCE='NO'
;  205    ! is Fortran 90's nonadvancing output, which writes a record without
;  206    ! ending it, so the next output or input goes on the same line.
;  207    subroutine say_more(text)
	.ENTRY	FCMESSAGES.SAY_MORE,^M<>
;  208      character(len=*), intent(in) :: text
;  209
;  210      write (*, '(2A)', advance='NO') cc, text
	PUSHAQ	FCMESSAGES.SAY_MORE.$D1
	PUSHL	#-1
	PUSHAB	FCMESSAGES.SAY_MORE.$IO1
	CALLS	#3,G^FTN$WRITE_SF
	PUSHAQ	FCMESSAGES.SAY_MORE.$D2
	CALLS	#1,G^FTN$IO_ITEM
	MOVW	@FCMESSAGES.SAY_MORE.TEXT(AP),FCMESSAGES.SAY_MORE.$D3
	MOVL	FCMESSAGES.SAY_MORE.TEXT(AP),R0
	MOVAB	@4(R0),FCMESSAGES.SAY_MORE.$D3+4
	PUSHAQ	FCMESSAGES.SAY_MORE.$D3
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;  211      if (log_unit /= 0) write (log_unit, '(A)', advance='NO') text
	TSTL	FCMESSAGES.LOG_UNIT
	BEQL	FCMESSAGES.SAY_MORE.$1
	PUSHAQ	FCMESSAGES.SAY_MORE.$D4
	PUSHL	FCMESSAGES.LOG_UNIT
	PUSHAB	FCMESSAGES.SAY_MORE.$IO1
	CALLS	#3,G^FTN$WRITE_SF
	MOVW	@FCMESSAGES.SAY_MORE.TEXT(AP),FCMESSAGES.SAY_MORE.$D3
	MOVL	FCMESSAGES.SAY_MORE.TEXT(AP),R0
	MOVAB	@4(R0),FCMESSAGES.SAY_MORE.$D3+4
	PUSHAQ	FCMESSAGES.SAY_MORE.$D3
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
FCMESSAGES.SAY_MORE.$1:
;  212      open_prompt = len(text)
	MOVZWL	@FCMESSAGES.SAY_MORE.TEXT(AP),FCMESSAGES.OPEN_PROMPT
;  213    end subroutine say_more
	RET

; Storage map for FCMESSAGES.SAY_PART, a subroutine
;   TEXT  CHARACTER*(*), INTENT(IN)  argument 1  @FCMESSAGES.SAY_PART.TEXT(AP)
;   AT    INTEGER                    $LOCAL+0    FCMESSAGES.SAY_PART.AT
;   K     INTEGER                    $LOCAL+4    FCMESSAGES.SAY_PART.K
;   R6 is $T1: temporary
;   R8 is $T2: temporary
;   R10 is $H1: a value computed before a loop
;   R7 is $R1: AT, during a loop
;   R9 is $R2: K, during a loop
;   R11 is $R3: TEXT's address
;
FCMESSAGES.SAY_PART.TEXT = 4		; TEXT is argument 1

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCMESSAGES.SAY_PART.AT:
	.BLKL	1			; AT
FCMESSAGES.SAY_PART.K:
	.BLKL	1			; K

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCMESSAGES.SAY_PART.$D1:
	.WORD	132			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCMESSAGES.PENDING

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  214
;  215    ! SAY_PART adds text to a line being built a piece at a time, and SAY_END
;  216    ! writes what is left of it: together they write the same records SAY
;  217    ! would of the whole line, for a line too long to hold in one variable
;  218    ! (LIST's of a large matrix). Fortran 90 has no strings that grow, so a
;  219    ! long line is written as it is made: each time PENDING is full and more
;  220    ! comes, PENDING is written as a record.
;  221    subroutine say_part(text)
	.ENTRY	FCMESSAGES.SAY_PART,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
;  222      character(len=*), intent(in) :: text
;  223      integer :: at, k
;  224
;  225      at = 1
	MOVL	#1,FCMESSAGES.SAY_PART.AT
;  226      do while (at <= len(text))
	MOVZWL	@FCMESSAGES.SAY_PART.TEXT(AP),R10 ; from line 226
	MOVL	FCMESSAGES.SAY_PART.AT,R7
	MOVL	FCMESSAGES.SAY_PART.K,R9
	MOVL	FCMESSAGES.SAY_PART.TEXT(AP),R11
	BRW	FCMESSAGES.SAY_PART.$1
FCMESSAGES.SAY_PART.$2:			; DO (line 226)'s body
;  227        if (filled == width) then
	CMPL	FCMESSAGES.FILLED,#132
	BNEQ	FCMESSAGES.SAY_PART.$3
;  228          call say(pending)
	PUSHAQ	FCMESSAGES.SAY_PART.$D1
	CALLS	#1,G^FCMESSAGES.SAY
;  229          filled = 0
	CLRL	FCMESSAGES.FILLED
;  230        end if
FCMESSAGES.SAY_PART.$3:
;  231        k = min(len(text) - at + 1, width - filled)
	SUBL3	R7,R10,R0
	ADDL3	R0,#1,R6
	SUBL3	FCMESSAGES.FILLED,#132,R8
	CMPL	R8,R6
	BGEQ	FCMESSAGES.SAY_PART.$5
	MOVL	R8,R6
FCMESSAGES.SAY_PART.$5:
	MOVL	R6,R9
;  232        pending(filled + 1:filled + k) = text(at:at + k - 1)
	ADDL3	FCMESSAGES.FILLED,R9,R0
	SUBL3	FCMESSAGES.FILLED,R0,R8
	BGEQ	FCMESSAGES.SAY_PART.$7
	CLRL	R8
FCMESSAGES.SAY_PART.$7:
	ADDL3	R7,R9,R0
	SUBL3	R7,R0,R6
	BGEQ	FCMESSAGES.SAY_PART.$9
	CLRL	R6
FCMESSAGES.SAY_PART.$9:
	SUBL3	#1,R7,R0
	MOVL	FCMESSAGES.FILLED,R1
	MOVC5	R6,@4(R11)[R0],#^A/ /,R8,FCMESSAGES.PENDING[R1]
;  233        filled = filled + k
	ADDL2	R9,FCMESSAGES.FILLED
;  234        at = at + k
	ADDL2	R9,R7
;  235      end do
FCMESSAGES.SAY_PART.$1:			; DO (line 226)'s test
	CMPL	R7,R10			; from line 226
	BGTR	FCMESSAGES.SAY_PART.$11
	BRW	FCMESSAGES.SAY_PART.$2
FCMESSAGES.SAY_PART.$11:
	MOVL	R7,FCMESSAGES.SAY_PART.AT
	MOVL	R9,FCMESSAGES.SAY_PART.K
;  236    end subroutine say_part
	RET

; Storage map for FCMESSAGES.SAY_END, a subroutine
;   (no variables)
;   R6 is $T1: temporary
;

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCMESSAGES.SAY_END.$D1:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  237
;  238    subroutine say_end()
	.ENTRY	FCMESSAGES.SAY_END,^M<R6>
;  239      call say(pending(:filled))
	MOVL	FCMESSAGES.FILLED,R6
	BGEQ	FCMESSAGES.SAY_END.$1
	CLRL	R6
FCMESSAGES.SAY_END.$1:
	CVTLW	R6,FCMESSAGES.SAY_END.$D1
	MOVAB	FCMESSAGES.PENDING,FCMESSAGES.SAY_END.$D1+4
	PUSHAQ	FCMESSAGES.SAY_END.$D1
	CALLS	#1,G^FCMESSAGES.SAY
;  240      filled = 0
	CLRL	FCMESSAGES.FILLED
;  241    end subroutine say_end
	RET

; Storage map for FCMESSAGES.FAIL, a subroutine
;   WHAT   INTEGER, INTENT(IN)                  argument 1   @FCMESSAGES.FAIL.WHAT(AP)
;   WHERE  INTEGER, INTENT(IN)                  argument 2   @FCMESSAGES.FAIL.WHERE(AP)
;   TEXT   CHARACTER*(*), INTENT(IN), OPTIONAL  an argument  @FCMESSAGES.FAIL.$A3
;
FCMESSAGES.FAIL.WHAT = 4		; WHAT is argument 1
FCMESSAGES.FAIL.WHERE = 8		; WHERE is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCMESSAGES.FAIL.$A3:
	.BLKL	1			; TEXT's longword of the argument list, set at each entry point

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCMESSAGES.FAIL.$K1:
	.ASCII	/ /

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  242
;  243    ! FAIL records an error, unless one is already waiting: the first is the
;  244    ! one reported.
;  245    !
;  246    ! INTENT(IN) promises the routine won't change an argument (the compiler
;  247    ! holds it to that); INTENT(OUT) that it will give it a value, and
;  248    ! INTENT(INOUT) both. CHARACTER(LEN=*) takes its length from whatever
;  249    ! string the caller passes. OPTIONAL means a caller may leave TEXT out;
;  250    ! PRESENT(TEXT) tells whether it did, and an absent argument must not be
;  251    ! touched. A procedure with an OPTIONAL argument needs an explicit
;  252    ! interface where it is called, which a module procedure always has.
;  253    subroutine fail(what, where, text)
	.ENTRY	FCMESSAGES.FAIL,^M<R2,R3,R4,R5>
	CLRL	FCMESSAGES.FAIL.$A3	; TEXT is argument 3, if the caller passed it
	CMPB	(AP),#3
	BLSSU	FCMESSAGES.FAIL.$5
	MOVL	12(AP),FCMESSAGES.FAIL.$A3
FCMESSAGES.FAIL.$5:
;  254      integer, intent(in) :: what, where
;  255      character(len=*), intent(in), optional :: text
;  256
;  257      if (code /= 0) return
	TSTL	FCMESSAGES.CODE
	BEQL	FCMESSAGES.FAIL.$1
	RET
FCMESSAGES.FAIL.$1:
;  258      code = what
	MOVL	@FCMESSAGES.FAIL.WHAT(AP),FCMESSAGES.CODE
;  259      column = where
	MOVL	@FCMESSAGES.FAIL.WHERE(AP),FCMESSAGES.COLUMN
;  260      argument = ' '
	MOVC5	#1,FCMESSAGES.FAIL.$K1,#^A/ /,#199,FCMESSAGES.ARGUMENT
;  261      if (present(text)) argument = text
	TSTL	FCMESSAGES.FAIL.$A3
	BEQL	FCMESSAGES.FAIL.$3
	MOVZWL	@FCMESSAGES.FAIL.$A3,R0
	MOVL	FCMESSAGES.FAIL.$A3,R1
	MOVC5	R0,@4(R1),#^A/ /,#199,FCMESSAGES.ARGUMENT
FCMESSAGES.FAIL.$3:
;  262    end subroutine fail
	RET

; Storage map for FCMESSAGES.ERROR_IDENT, a CHARACTER*10 function
;   IDENT  CHARACTER*10         hidden argument 1  @FCMESSAGES.ERROR_IDENT.IDENT(AP)
;   WHAT   INTEGER, INTENT(IN)  argument 2         @FCMESSAGES.ERROR_IDENT.WHAT(AP)
;
FCMESSAGES.ERROR_IDENT.IDENT = 4	; IDENT's value goes through hidden argument 1
FCMESSAGES.ERROR_IDENT.WHAT = 8		; WHAT is argument 2

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCMESSAGES.ERROR_IDENT.$K1:
	.ASCII	/EBADCHAR   invalid character                       EBADNUMBER in/
	.ASCII	/valid number                          EOPERAND   operand expecte/
	.ASCII	/d                        ERPAREN    missing right parenthesis   /
	.ASCII	/            EEXTRA     unexpected text                         E/
	.ASCII	/UNDEFINED !AS is not defined                      ENOFUNC    no /
	.ASCII	/function named !AS                   ECONSTANT  !AS is a constan/
	.ASCII	/t                       EDIVZERO   division by zero             /
	.ASCII	/           EOVERFLOW  result is too large                     ED/
	.ASCII	/OMAIN    argument is out of range                ENOTREAL   oper/
	.ASCII	/and must be real                    ETOODEEP   expression is nes/
	.ASCII	/ted too deeply         ELINELONG  line is too long              /
	.ASCII	/          ENAMELONG  name is too long                        ENO/
	.ASCII	/TWHOLE  operand must be a whole number          EBADSET    unkno/
	.ASCII	/wn setting                         WNOTDEF    !AS was not define/
	.ASCII	/d                     EBADCMD    invalid command                /
	.ASCII	/         ENAMEREQ   name expected                           ERES/
	.ASCII	/ERVED  !AS is a reserved word                  EARGCOUNT  wrong /
	.ASCII	/number of arguments for !AS       EBUILTIN   !AS is a built-in f/
	.ASCII	/unction              ERECURSION functions call each other too de/
	.ASCII	/eply    EPARAMS    too many parameters                     EDUPP/
	.ASCII	/ARAM  !AS is already a parameter              ENOTCONFORMshapes /
	.ASCII	/of the operands do not agree     ENOTSQUARE matrix must be squar/
	.ASCII	/e                   ESINGULAR  matrix is singular               /
	.ASCII	/       EINDEX     index is out of range                   ENOTSC/
	.ASCII	/ALAR operand must be a scalar                ENOCONVERGEeigenval/
	.ASCII	/ues did not converge            EBADRANGE  a range is allowed on/
	.ASCII	/ly in an index     ETOOBIG    array is too large                /
	.ASCII	/      ERBRACKET  missing right bracket                   ENOTVEC/
	.ASCII	/TOR operand must be a vector                EKEYWORD   !AS expec/
	.ASCII	/ted                            ENOROOT    no root was found     /
	.ASCII	/                  ESAMESIGN  no change of sign between the bound/
	.ASCII	/s    WINACCURATEerror may be as large as !AS            EBADSTEP/
	.ASCII	/   step does not lead from FROM to TO      ETOOMANY   too many !/
	.ASCII	/AS                            EBADLIMITS lower limit must be bel/
	.ASCII	/ow upper limit   ENOPOINTS  no point can be plotted             /
	.ASCII	/    EFILEREQ   file name expected                      ENOFILE  /
	.ASCII	/  file !AS was not found                  EFILEERR   file !AS co/
	.ASCII	/uld not be used              ENESTING   files are nested too dee/
	.ASCII	/ply             EFILELOOP  file !AS is already running          /
	.ASCII	/   WNOLOG     no log file is open                     IINFILE   /
	.ASCII	/ in line !AS                             /

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  263
;  264    ! ERROR_IDENT is the identifier of the message CODE, DIVZERO: TABLE shows
;  265    ! it in place of a value it couldn't compute.
;  266    function error_ident(what) result(ident)
	.ENTRY	FCMESSAGES.ERROR_IDENT,^M<R2,R3,R4,R5>
;  267      integer, intent(in) :: what
;  268      character(len=10) :: ident
;  269
;  270      ident = messages(what)%ident
	MULL3	@FCMESSAGES.ERROR_IDENT.WHAT(AP),#51,R0
	MOVL	FCMESSAGES.ERROR_IDENT.IDENT(AP),R1
	MOVC3	#10,FCMESSAGES.ERROR_IDENT.$K1-50[R0],@4(R1)
;  271    end function error_ident
	RET

; Storage map for FCMESSAGES.FAILED, a LOGICAL function
;   FAILED  LOGICAL  $LOCAL+0  FCMESSAGES.FAILED.FAILED
;

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCMESSAGES.FAILED.FAILED:
	.BLKL	1			; FAILED, the function's value

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  272
;  273    logical function failed()
	.ENTRY	FCMESSAGES.FAILED,^M<>
;  274      failed = code /= 0
;  275    end function failed
	CLRL	R0			; the function's value
	TSTL	FCMESSAGES.CODE
	BEQL	FCMESSAGES.FAILED.$1
	MNEGL	#1,R0
FCMESSAGES.FAILED.$1:
	RET

