	.ASCII	/   WNOLOG     no log file is open                     IINFILE   /
	.ASCII	/ in line !AS                             /

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  276
;  277    ! ERROR_IS_WARNING: the error waiting is only a warning (or a note), after
;  278    ! which a file of commands goes on.
;  279    logical function error_is_warning()
	.ENTRY	FCMESSAGES.ERROR_IS_WARNING,^M<R6>
;  280      error_is_warning = .false.
	CLRL	R6
;  281      if (code /= 0) error_is_warning = messages(code)%severity /= 'E'
	TSTL	FCMESSAGES.CODE
	BEQL	FCMESSAGES.ERROR_IS_WARNING.$1
	MULL3	FCMESSAGES.CODE,#51,R0
	CLRL	R1
	CMPB	FCMESSAGES.ERROR_IS_WARNING.$K1-51[R0],#69
	BEQL	FCMESSAGES.ERROR_IS_WARNING.$3
	MNEGL	#1,R1
FCMESSAGES.ERROR_IS_WARNING.$3:
	MOVL	R1,R6
FCMESSAGES.ERROR_IS_WARNING.$1:
;  282    end function error_is_warning
	MOVL	R6,R0			; the function's value
	RET

; Storage map for FCMESSAGES.ERROR_CODE, an INTEGER function
;   ERROR_CODE  INTEGER  $LOCAL+0  FCMESSAGES.ERROR_CODE.$N1
;   FCMESSAGES.ERROR_CODE.$N1 is FCMESSAGES.ERROR_CODE.ERROR_CODE
;

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCMESSAGES.ERROR_CODE.$N1:
	.BLKL	1			; ERROR_CODE, the function's value

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  283
;  284    integer function error_code()
	.ENTRY	FCMESSAGES.ERROR_CODE,^M<>
;  285      error_code = code
;  286    end function error_code
	MOVL	FCMESSAGES.CODE,R0	; the function's value
	RET

; Storage map for FCMESSAGES.CLEAR_ERROR, a subroutine
;   (no variables)
;

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCMESSAGES.CLEAR_ERROR.$K1:
	.ASCII	/ /

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  287
;  288    subroutine clear_error()
	.ENTRY	FCMESSAGES.CLEAR_ERROR,^M<R2,R3,R4,R5>
;  289      code = 0
	CLRL	FCMESSAGES.CODE
;  290      column = 0
	CLRL	FCMESSAGES.COLUMN
;  291      argument = ' '
	MOVC5	#1,FCMESSAGES.CLEAR_ERROR.$K1,#^A/ /,#199,FCMESSAGES.ARGUMENT
;  292    end subroutine clear_error
	RET

; Storage map for FCMESSAGES.REPORT, a subroutine
;   SHOWN  CHARACTER*(*), INTENT(IN), OPTIONAL  an argument  @FCMESSAGES.REPORT.$A1
;   R7 is $T4: temporary
;   R6 is $T5: temporary
;

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCMESSAGES.REPORT.$A1:
	.BLKL	1			; SHOWN's longword of the argument list, set at each entry point
FCMESSAGES.REPORT.$D1:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_D
	.LONG	0			; set when the descriptor is used
FCMESSAGES.REPORT.$T1:
	.BLKL	1			; temporary
FCMESSAGES.REPORT.$D3:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_D
	.LONG	0			; set when the descriptor is used
FCMESSAGES.REPORT.$T2:
	.BLKB	2			; temporary
	.BLKB	2
FCMESSAGES.REPORT.$D4:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used
FCMESSAGES.REPORT.$T3:
	.BLKB	259			; characters, for one statement
	.BLKB	1
FCMESSAGES.REPORT.$U1:
	.BLKL	1			; temporary
FCMESSAGES.REPORT.$U2:
	.BLKL	1			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCMESSAGES.REPORT.$D2:
	.WORD	1			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCMESSAGES.REPORT.$K1
FCMESSAGES.REPORT.$D5:
	.WORD	199			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCMESSAGES.ARGUMENT
FCMESSAGES.REPORT.$D6:
	.WORD	259			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCMESSAGES.REPORT.$T3
FCMESSAGES.REPORT.$K1:
	.ASCII	/ /

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  293
;  294    ! REPORT writes the waiting error, with a pointer to its column, and
;  295    ! clears it. SHOWN, if given, is the line the error is about, which the
;  296    ! terminal doesn't show (a line of a file, or the foreign command's): it
;  297    ! is written first, indented as a typed line is, for the pointer.
;  298    subroutine report(shown)
	.ENTRY	FCMESSAGES.REPORT,^M<R2,R3,R4,R5,R6,R7>
	CLRL	FCMESSAGES.REPORT.$A1	; SHOWN is argument 1, if the caller passed it
	CMPB	(AP),#1
	BLSSU	FCMESSAGES.REPORT.$12
	MOVL	4(AP),FCMESSAGES.REPORT.$A1
FCMESSAGES.REPORT.$12:
;  299      character(len=*), intent(in), optional :: shown
;  300
;  301      if (code == 0) return
	TSTL	FCMESSAGES.CODE
	BNEQ	FCMESSAGES.REPORT.$1
	RET
FCMESSAGES.REPORT.$1:
;  302
;  303      ! REPEAT(' ', n) is n blanks, and // joins strings: the ^ goes under
;  304      ! the column, past the prompt.
;  305      if (column > 0) then
	TSTL	FCMESSAGES.COLUMN
	BGTR	FCMESSAGES.REPORT.$4
	BRW	FCMESSAGES.REPORT.$3
FCMESSAGES.REPORT.$4:
;  306        if (present(shown)) call say(repeat(' ', indent) // shown)
	TSTL	FCMESSAGES.REPORT.$A1
	BNEQ	FCMESSAGES.REPORT.$6
	BRW	FCMESSAGES.REPORT.$5
FCMESSAGES.REPORT.$6:
	MOVL	FCMESSAGES.INDENT,FCMESSAGES.REPORT.$T1
	PUSHAL	FCMESSAGES.REPORT.$T1
	PUSHAQ	FCMESSAGES.REPORT.$D2
	PUSHAQ	FCMESSAGES.REPORT.$D1
	CALLS	#3,G^FTN$REPEAT
	MOVZWL	@FCMESSAGES.REPORT.$A1,FCMESSAGES.REPORT.$U1
	MOVZWL	FCMESSAGES.REPORT.$D1,R0
	ADDL2	FCMESSAGES.REPORT.$U1,R0
	CVTLW	R0,FCMESSAGES.REPORT.$T2
	PUSHAQ	FCMESSAGES.REPORT.$D3
	PUSHAW	FCMESSAGES.REPORT.$T2
	CALLS	#2,G^LIB$SGET1_DD
	MOVZWL	FCMESSAGES.REPORT.$D1,FCMESSAGES.REPORT.$U2
	MOVC3	FCMESSAGES.REPORT.$U2,@FCMESSAGES.REPORT.$D1+4,@FCMESSAGES.REPORT.$D3+4
	MOVL	FCMESSAGES.REPORT.$A1,R0
	MOVL	FCMESSAGES.REPORT.$U2,R1
	MOVC3	FCMESSAGES.REPORT.$U1,@4(R0),@FCMESSAGES.REPORT.$D3+4[R1]
	ADDL3	FCMESSAGES.REPORT.$U2,FCMESSAGES.REPORT.$U1,R0
	CVTLW	R0,FCMESSAGES.REPORT.$D4
	MOVAB	@FCMESSAGES.REPORT.$D3+4,FCMESSAGES.REPORT.$D4+4
	PUSHAQ	FCMESSAGES.REPORT.$D4
	CALLS	#1,G^FCMESSAGES.SAY
	PUSHAQ	FCMESSAGES.REPORT.$D1
	CALLS	#1,G^LIB$SFREE1_DD
	PUSHAQ	FCMESSAGES.REPORT.$D3
	CALLS	#1,G^LIB$SFREE1_DD
FCMESSAGES.REPORT.$5:
;  307        call say(repeat(' ', indent + column - 1) // '^')
	ADDL3	FCMESSAGES.INDENT,FCMESSAGES.COLUMN,R0
	SUBL3	#1,R0,FCMESSAGES.REPORT.$T1
	PUSHAL	FCMESSAGES.REPORT.$T1
	PUSHAQ	FCMESSAGES.REPORT.$D2
	PUSHAQ	FCMESSAGES.REPORT.$D3
	CALLS	#3,G^FTN$REPEAT
	MOVZWL	FCMESSAGES.REPORT.$D3,R0
	INCL	R0
	CVTLW	R0,FCMESSAGES.REPORT.$T2
	PUSHAQ	FCMESSAGES.REPORT.$D1
	PUSHAW	FCMESSAGES.REPORT.$T2
	CALLS	#2,G^LIB$SGET1_DD
	MOVZWL	FCMESSAGES.REPORT.$D3,FCMESSAGES.REPORT.$U2
	MOVC3	FCMESSAGES.REPORT.$U2,@FCMESSAGES.REPORT.$D3+4,@FCMESSAGES.REPORT.$D1+4
	MOVL	FCMESSAGES.REPORT.$U2,R0
	MOVB	#94,@FCMESSAGES.REPORT.$D1+4[R0]
	ADDL3	FCMESSAGES.REPORT.$U2,#1,R0
	CVTLW	R0,FCMESSAGES.REPORT.$D4
	MOVAB	@FCMESSAGES.REPORT.$D1+4,FCMESSAGES.REPORT.$D4+4
	PUSHAQ	FCMESSAGES.REPORT.$D4
	CALLS	#1,G^FCMESSAGES.SAY
	PUSHAQ	FCMESSAGES.REPORT.$D3
	CALLS	#1,G^LIB$SFREE1_DD
	PUSHAQ	FCMESSAGES.REPORT.$D1
	CALLS	#1,G^LIB$SFREE1_DD
;  308      end if
FCMESSAGES.REPORT.$3:
;  309
;  310      call say('%' // trim(message_text(code, argument)))
	PUSHAQ	FCMESSAGES.REPORT.$D5
	PUSHAL	FCMESSAGES.CODE
	PUSHAQ	FCMESSAGES.REPORT.$D6
	CALLS	#3,G^FCMESSAGES.MESSAGE_TEXT
	MOVAB	FCMESSAGES.REPORT.$T3,FCMESSAGES.REPORT.$T1
	MOVAB	@FCMESSAGES.REPORT.$T1,R7
	MOVL	#259,R6
	BRB	FCMESSAGES.REPORT.$7
FCMESSAGES.REPORT.$8:
	CMPB	-1(R7)[R6],#32
	BNEQ	FCMESSAGES.REPORT.$9
	DECL	R6
FCMESSAGES.REPORT.$7:
	TSTL	R6			; from line 310
	BNEQ	FCMESSAGES.REPORT.$8
FCMESSAGES.REPORT.$9:
	ADDL3	R6,#1,R0
	CVTLW	R0,FCMESSAGES.REPORT.$T2
	PUSHAQ	FCMESSAGES.REPORT.$D1
	PUSHAW	FCMESSAGES.REPORT.$T2
	CALLS	#2,G^LIB$SGET1_DD
	MOVB	#37,@FCMESSAGES.REPORT.$D1+4
	MOVL	FCMESSAGES.REPORT.$D1+4,R0
	MOVC3	R6,@FCMESSAGES.REPORT.$T1,1(R0)
	ADDL3	R6,#1,R0
	CVTLW	R0,FCMESSAGES.REPORT.$D4
	MOVAB	@FCMESSAGES.REPORT.$D1+4,FCMESSAGES.REPORT.$D4+4
	PUSHAQ	FCMESSAGES.REPORT.$D4
	CALLS	#1,G^FCMESSAGES.SAY
	PUSHAQ	FCMESSAGES.REPORT.$D1
	CALLS	#1,G^LIB$SFREE1_DD
;  311      call clear_error()
	CALLS	#0,G^FCMESSAGES.CLEAR_ERROR
;  312    end subroutine report
	RET

; Storage map for FCMESSAGES.ALSO, a subroutine
;   WHAT  INTEGER, INTENT(IN)        argument 1  @FCMESSAGES.ALSO.WHAT(AP)
;   TEXT  CHARACTER*(*), INTENT(IN)  argument 2  @FCMESSAGES.ALSO.TEXT(AP)
;   R8 is $T2: temporary
;   R7 is $T3: temporary
;   R6 is $T4: temporary
;
FCMESSAGES.ALSO.WHAT = 4		; WHAT is argument 1
FCMESSAGES.ALSO.TEXT = 8		; TEXT is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCMESSAGES.ALSO.$T1:
	.BLKB	259			; characters, for one statement
	.BLKB	1
FCMESSAGES.ALSO.$D2:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_D
	.LONG	0			; set when the descriptor is used
FCMESSAGES.ALSO.$T5:
	.BLKB	2			; temporary
	.BLKB	2
FCMESSAGES.ALSO.$D3:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCMESSAGES.ALSO.$D1:
	.WORD	259			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCMESSAGES.ALSO.$T1

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  313
;  314    ! ALSO writes a message that goes on from the one before, with - in place
;  315    ! of %, as VMS writes the second and later messages of one condition:
;  316    !     -FCALC-I-INFILE, in line 3 of setup.fcalc
;  317    subroutine also(what, text)
	.ENTRY	FCMESSAGES.ALSO,^M<R2,R3,R4,R5,R6,R7,R8>
;  318      integer, intent(in) :: what
;  319      character(len=*), intent(in) :: text
;  320
;  321      call say('-' // trim(message_text(what, text)))
	PUSHL	FCMESSAGES.ALSO.TEXT(AP)
	PUSHAL	@FCMESSAGES.ALSO.WHAT(AP)
	PUSHAQ	FCMESSAGES.ALSO.$D1
	CALLS	#3,G^FCMESSAGES.MESSAGE_TEXT
	MOVAB	FCMESSAGES.ALSO.$T1,R8
	MOVAB	(R8),R7
	MOVL	#259,R6
	BRB	FCMESSAGES.ALSO.$1
FCMESSAGES.ALSO.$2:
	CMPB	-1(R7)[R6],#32
	BNEQ	FCMESSAGES.ALSO.$3
	DECL	R6
FCMESSAGES.ALSO.$1:
	TSTL	R6			; from line 321
	BNEQ	FCMESSAGES.ALSO.$2
FCMESSAGES.ALSO.$3:
	ADDL3	R6,#1,R0
	CVTLW	R0,FCMESSAGES.ALSO.$T5
	PUSHAQ	FCMESSAGES.ALSO.$D2
	PUSHAW	FCMESSAGES.ALSO.$T5
	CALLS	#2,G^LIB$SGET1_DD
	MOVB	#45,@FCMESSAGES.ALSO.$D2+4
	MOVL	FCMESSAGES.ALSO.$D2+4,R0
	MOVC3	R6,(R8),1(R0)
	ADDL3	R6,#1,R0
	CVTLW	R0,FCMESSAGES.ALSO.$D3
	MOVAB	@FCMESSAGES.ALSO.$D2+4,FCMESSAGES.ALSO.$D3+4
	PUSHAQ	FCMESSAGES.ALSO.$D3
	CALLS	#1,G^FCMESSAGES.SAY
	PUSHAQ	FCMESSAGES.ALSO.$D2
	CALLS	#1,G^LIB$SFREE1_DD
;  322    end subroutine also
	RET

; Storage map for FCMESSAGES.MESSAGE_TEXT, a CHARACTER*259 function
;   LINE  CHARACTER*259              hidden argument 1  @FCMESSAGES.MESSAGE_TEXT.LINE(AP)
;   WHAT  INTEGER, INTENT(IN)        argument 2         @FCMESSAGES.MESSAGE_TEXT.WHAT(AP)
;   TEXT  CHARACTER*(*), INTENT(IN)  argument 3         @FCMESSAGES.MESSAGE_TEXT.TEXT(AP)
;   AT    INTEGER                    $LOCAL+0           FCMESSAGES.MESSAGE_TEXT.AT
;   R8 is $T1: temporary
;   R6 is $T3: temporary
;   R7 is $T4: temporary
;
FCMESSAGES.MESSAGE_TEXT.LINE = 4	; LINE's value goes through hidden argument 1
FCMESSAGES.MESSAGE_TEXT.WHAT = 8	; WHAT is argument 2
FCMESSAGES.MESSAGE_TEXT.TEXT = 12	; TEXT is argument 3

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCMESSAGES.MESSAGE_TEXT.AT:
	.BLKL	1			; AT
FCMESSAGES.MESSAGE_TEXT.$T2:
	.BLKL	1			; temporary
FCMESSAGES.MESSAGE_TEXT.$T5:
	.BLKL	1			; temporary
FCMESSAGES.MESSAGE_TEXT.$D1:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_D
	.LONG	0			; set when the descriptor is used
FCMESSAGES.MESSAGE_TEXT.$T6:
	.BLKB	2			; temporary
	.BLKB	2
FCMESSAGES.MESSAGE_TEXT.$T7:
	.BLKL	1			; temporary
FCMESSAGES.MESSAGE_TEXT.$U1:
	.BLKL	1			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCMESSAGES.MESSAGE_TEXT.$K1:
	.ASCII	/EBADCHAR   invalid character                       EBADNUMBER in/
	.ASCII	/valid number                          EOPERAND   operand expecte/
	.ASCII	/d                        ERPAREN    missing right parenthesis   /
	.ASCII	/            EEXTRA     unexpected text                         E/
	.ASCII	/UNDEFINED !AS is not defined                      ENOFUNC    no /
	.ASCII	/function named !AS                   ECONSTANT  !AS is a constan/
	.ASCII	/t                       EDIVZERO   division by zero             /
	.ASCII	/           EOVERFLOW  result is too large                     ED/
	.ASCII	/OMAIN    argument is out of range                ENOTREAL   oper/
	.ASCII	/and must be real                    ETOODEEP   expression is nes/
	.ASCII	/ted too deeply         ELINELONG  line is too long              /
	.ASCII	/          ENAMELONG  name is too long                        ENO/
	.ASCII	/TWHOLE  operand must be a whole number          EBADSET    unkno/
	.ASCII	/wn setting                         WNOTDEF    !AS was not define/
	.ASCII	/d                     EBADCMD    invalid command                /
	.ASCII	/         ENAMEREQ   name expected                           ERES/
	.ASCII	/ERVED  !AS is a reserved word                  EARGCOUNT  wrong /
	.ASCII	/number of arguments for !AS       EBUILTIN   !AS is a built-in f/
	.ASCII	/unction              ERECURSION functions call each other too de/
	.ASCII	/eply    EPARAMS    too many parameters                     EDUPP/
	.ASCII	/ARAM  !AS is already a parameter              ENOTCONFORMshapes /
	.ASCII	/of the operands do not agree     ENOTSQUARE matrix must be squar/
	.ASCII	/e                   ESINGULAR  matrix is singular               /
	.ASCII	/       EINDEX     index is out of range                   ENOTSC/
	.ASCII	/ALAR operand must be a scalar                ENOCONVERGEeigenval/
	.ASCII	/ues did not converge            EBADRANGE  a range is allowed on/
	.ASCII	/ly in an index     ETOOBIG    array is too large                /
	.ASCII	/      ERBRACKET  missing right bracket                   ENOTVEC/
	.ASCII	/TOR operand must be a vector                EKEYWORD   !AS expec/
	.ASCII	/ted                            ENOROOT    no root was found     /
	.ASCII	/                  ESAMESIGN  no change of sign between the bound/
	.ASCII	/s    WINACCURATEerror may be as large as !AS            EBADSTEP/
	.ASCII	/   step does not lead from FROM to TO      ETOOMANY   too many !/
	.ASCII	/AS                            EBADLIMITS lower limit must be bel/
	.ASCII	/ow upper limit   ENOPOINTS  no point can be plotted             /
	.ASCII	/    EFILEREQ   file name expected                      ENOFILE  /
	.ASCII	/  file !AS was not found                  EFILEERR   file !AS co/
	.ASCII	/uld not be used              ENESTING   files are nested too dee/
	.ASCII	/ply             EFILELOOP  file !AS is already running          /
	.ASCII	/   WNOLOG     no log file is open                     IINFILE   /
	.ASCII	/ in line !AS                             /
FCMESSAGES.MESSAGE_TEXT.$K2:
	.ASCII	/!AS/
FCMESSAGES.MESSAGE_TEXT.$K3:
	.ASCII	/FCALC-/
FCMESSAGES.MESSAGE_TEXT.$K5:
	.ASCII	/, /

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  323
;  324    ! MESSAGE_TEXT is the message WHAT naming TEXT, without its first
;  325    ! character: FCALC-E-NOFILE, file x.fcalc was not found.
;  326    function message_text(what, text) result(line)
	.ENTRY	FCMESSAGES.MESSAGE_TEXT,^M<R2,R3,R4,R5,R6,R7,R8>
;  327      integer, intent(in) :: what
;  328      character(len=*), intent(in) :: text
;  329      character(len=line_length + 60) :: line
;  330      integer :: at
;  331
;  332      ! INDEX finds where one string starts in another (0 if nowhere); the
;  333      ! !AS is replaced by the text the error names. TRIM drops trailing
;  334      ! blanks, which a fixed-length CHARACTER variable is padded with.
;  335      line = messages(what)%text
	MULL3	@FCMESSAGES.MESSAGE_TEXT.WHAT(AP),#51,R0
	MOVL	FCMESSAGES.MESSAGE_TEXT.LINE(AP),R1
	MOVC5	#40,FCMESSAGES.MESSAGE_TEXT.$K1-40[R0],#^A/ /,#259,@4(R1)
;  336      at = index(line, '!AS')
	MOVL	FCMESSAGES.MESSAGE_TEXT.LINE(AP),R0
	MATCHC	#3,FCMESSAGES.MESSAGE_TEXT.$K2,#259,@4(R0)
	BNEQ	FCMESSAGES.MESSAGE_TEXT.$1
	SUBL3	R2,#257,R0
	BRB	FCMESSAGES.MESSAGE_TEXT.$2
FCMESSAGES.MESSAGE_TEXT.$1:
	CLRL	R0
FCMESSAGES.MESSAGE_TEXT.$2:
	MOVL	R0,R8
	MOVL	R8,FCMESSAGES.MESSAGE_TEXT.AT
;  337      if (at > 0) line = line(:at - 1) // trim(text) // line(at + 3:)
	BGTR	FCMESSAGES.MESSAGE_TEXT.$4
	BRW	FCMESSAGES.MESSAGE_TEXT.$3
FCMESSAGES.MESSAGE_TEXT.$4:
	SUBL3	#1,FCMESSAGES.MESSAGE_TEXT.AT,R8
	BGEQ	FCMESSAGES.MESSAGE_TEXT.$5
	CLRL	R8
FCMESSAGES.MESSAGE_TEXT.$5:
	MOVL	FCMESSAGES.MESSAGE_TEXT.TEXT(AP),R0
	MOVAB	@4(R0),FCMESSAGES.MESSAGE_TEXT.$T2
	MOVAB	@FCMESSAGES.MESSAGE_TEXT.$T2,R6
	MOVZWL	@FCMESSAGES.MESSAGE_TEXT.TEXT(AP),R7
	BRB	FCMESSAGES.MESSAGE_TEXT.$7
FCMESSAGES.MESSAGE_TEXT.$8:
	CMPB	-1(R6)[R7],#32
	BNEQ	FCMESSAGES.MESSAGE_TEXT.$9
	DECL	R7
FCMESSAGES.MESSAGE_TEXT.$7:
	TSTL	R7			; from line 337
	BNEQ	FCMESSAGES.MESSAGE_TEXT.$8
FCMESSAGES.MESSAGE_TEXT.$9:
	SUBL3	FCMESSAGES.MESSAGE_TEXT.AT,#257,FCMESSAGES.MESSAGE_TEXT.$T5
	BGEQ	FCMESSAGES.MESSAGE_TEXT.$12
	CLRL	FCMESSAGES.MESSAGE_TEXT.$T5
FCMESSAGES.MESSAGE_TEXT.$12:
	ADDL3	R8,R7,R0
	ADDL3	R0,FCMESSAGES.MESSAGE_TEXT.$T5,FCMESSAGES.MESSAGE_TEXT.$U1
	CVTLW	FCMESSAGES.MESSAGE_TEXT.$U1,FCMESSAGES.MESSAGE_TEXT.$T6
	PUSHAQ	FCMESSAGES.MESSAGE_TEXT.$D1
	PUSHAW	FCMESSAGES.MESSAGE_TEXT.$T6
	CALLS	#2,G^LIB$SGET1_DD
	MOVL	FCMESSAGES.MESSAGE_TEXT.LINE(AP),R0
	MOVC3	R8,@4(R0),@FCMESSAGES.MESSAGE_TEXT.$D1+4
	MOVC3	R7,@FCMESSAGES.MESSAGE_TEXT.$T2,@FCMESSAGES.MESSAGE_TEXT.$D1+4[R8]
	MOVL	FCMESSAGES.MESSAGE_TEXT.LINE(AP),R0
	ADDL3	FCMESSAGES.MESSAGE_TEXT.AT,#2,R1
	ADDL3	R8,R7,R2
	MOVC3	FCMESSAGES.MESSAGE_TEXT.$T5,@4(R0)[R1],@FCMESSAGES.MESSAGE_TEXT.$D1+4[R2]
	MOVL	FCMESSAGES.MESSAGE_TEXT.LINE(AP),R0
	MOVC5	FCMESSAGES.MESSAGE_TEXT.$U1,@FCMESSAGES.MESSAGE_TEXT.$D1+4,#^A/ /,#259,@4(R0)
	PUSHAQ	FCMESSAGES.MESSAGE_TEXT.$D1
	CALLS	#1,G^LIB$SFREE1_DD
FCMESSAGES.MESSAGE_TEXT.$3:
;  338      line = 'FCALC-' // messages(what)%severity // '-' // &
;  339        trim(messages(what)%ident) // ', ' // trim(line)
	MULL3	@FCMESSAGES.MESSAGE_TEXT.WHAT(AP),#51,R0
	MOVAB	FCMESSAGES.MESSAGE_TEXT.$K1-50[R0],FCMESSAGES.MESSAGE_TEXT.$T5
	MOVAB	@FCMESSAGES.MESSAGE_TEXT.$T5,R7
	MOVL	#10,R6
	BRB	FCMESSAGES.MESSAGE_TEXT.$14
FCMESSAGES.MESSAGE_TEXT.$15:
	CMPB	-1(R7)[R6],#32
	BNEQ	FCMESSAGES.MESSAGE_TEXT.$16
	DECL	R6
FCMESSAGES.MESSAGE_TEXT.$14:
	TSTL	R6			; from line 338
	BNEQ	FCMESSAGES.MESSAGE_TEXT.$15
FCMESSAGES.MESSAGE_TEXT.$16:
	MOVL	FCMESSAGES.MESSAGE_TEXT.LINE(AP),R0
	MOVAB	@4(R0),FCMESSAGES.MESSAGE_TEXT.$T2
	MOVAB	@FCMESSAGES.MESSAGE_TEXT.$T2,R8
	MOVL	#259,FCMESSAGES.MESSAGE_TEXT.$T7
	BRB	FCMESSAGES.MESSAGE_TEXT.$19
FCMESSAGES.MESSAGE_TEXT.$20:
	MOVL	FCMESSAGES.MESSAGE_TEXT.$T7,R0
	CMPB	-1(R8)[R0],#32
	BNEQ	FCMESSAGES.MESSAGE_TEXT.$21
	DECL	FCMESSAGES.MESSAGE_TEXT.$T7
FCMESSAGES.MESSAGE_TEXT.$19:
	TSTL	FCMESSAGES.MESSAGE_TEXT.$T7 ; from line 338
	BNEQ	FCMESSAGES.MESSAGE_TEXT.$20
FCMESSAGES.MESSAGE_TEXT.$21:
	ADDL3	R6,FCMESSAGES.MESSAGE_TEXT.$T7,R0
	ADDL3	R0,#10,FCMESSAGES.MESSAGE_TEXT.$U1
	CVTLW	FCMESSAGES.MESSAGE_TEXT.$U1,FCMESSAGES.MESSAGE_TEXT.$T6
	PUSHAQ	FCMESSAGES.MESSAGE_TEXT.$D1
	PUSHAW	FCMESSAGES.MESSAGE_TEXT.$T6
	CALLS	#2,G^LIB$SGET1_DD
	MOVC3	#6,FCMESSAGES.MESSAGE_TEXT.$K3,@FCMESSAGES.MESSAGE_TEXT.$D1+4
