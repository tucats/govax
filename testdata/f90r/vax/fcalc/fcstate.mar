	CALLS	#2,G^LIB$SGET1_DD
	MOVC3	#2,FCSTATE.EXACT_TEXT.$K7,@FCSTATE.EXACT_TEXT.$D14+4
	MOVZWL	FCSTATE.EXACT_TEXT.$D16,FCSTATE.EXACT_TEXT.$U1
	MOVL	FCSTATE.EXACT_TEXT.$D14+4,R0
	MOVC3	FCSTATE.EXACT_TEXT.$U1,@FCSTATE.EXACT_TEXT.$D16+4,2(R0)
	ADDL3	FCSTATE.EXACT_TEXT.$U1,#2,R0
	MOVC3	FCSTATE.EXACT_TEXT.$T2,FCSTATE.EXACT_TEXT.D,@FCSTATE.EXACT_TEXT.$D14+4[R0]
	ADDL3	FCSTATE.EXACT_TEXT.$U1,FCSTATE.EXACT_TEXT.$T2,R0
	ADDL2	#2,R0
	MOVL	FCSTATE.EXACT_TEXT.TEXT(AP),R1
	MOVC5	R0,@FCSTATE.EXACT_TEXT.$D14+4,#^A/ /,#30,@4(R1)
	PUSHAQ	FCSTATE.EXACT_TEXT.$D16
	CALLS	#1,G^LIB$SFREE1_DD
