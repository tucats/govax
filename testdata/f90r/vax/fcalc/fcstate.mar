FCSTATE.EXACT_TEXT.$8:			; leaving the loop
	MOVL	R6,FCSTATE.EXACT_TEXT.N
	MOVL	R8,FCSTATE.EXACT_TEXT.IOS
	BRW	FCSTATE.EXACT_TEXT.$13

; Storage map for FCSTATE.EXPONENT_TEXT, a CHARACTER*13 function
;   TEXT  CHARACTER*13         hidden argument 1  @FCSTATE.EXPONENT_TEXT.TEXT(AP)
;   EX    INTEGER, INTENT(IN)  argument 2         @FCSTATE.EXPONENT_TEXT.EX(AP)
;
FCSTATE.EXPONENT_TEXT.TEXT = 4		; TEXT's value goes through hidden argument 1
FCSTATE.EXPONENT_TEXT.EX = 8		; EX is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCSTATE.EXPONENT_TEXT.$T1:
	.BLKL	3			; characters, for one statement
FCSTATE.EXPONENT_TEXT.$T2:
	.BLKB	13			; characters, for one statement
	.BLKB	3

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCSTATE.EXPONENT_TEXT.$D1:
	.WORD	12			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCSTATE.EXPONENT_TEXT.$T1

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  446
;  447    ! EXPONENT_TEXT is EX with its sign: +23, -7.
;  448    function exponent_text(ex) result(text)
	.ENTRY	FCSTATE.EXPONENT_TEXT,^M<R2,R3,R4,R5>
;  449      integer, intent(in) :: ex
;  450      character(len=13) :: text
;  451
;  452      if (ex < 0) then
	TSTL	@FCSTATE.EXPONENT_TEXT.EX(AP)
	BGEQ	FCSTATE.EXPONENT_TEXT.$1
;  453        text = whole_text(ex)
	PUSHAL	@FCSTATE.EXPONENT_TEXT.EX(AP)
	PUSHAQ	FCSTATE.EXPONENT_TEXT.$D1
	CALLS	#2,G^FCSTATE.WHOLE_TEXT
	MOVL	FCSTATE.EXPONENT_TEXT.TEXT(AP),R0
	MOVC5	#12,FCSTATE.EXPONENT_TEXT.$T1,#^A/ /,#13,@4(R0)
;  454      else
	RET
FCSTATE.EXPONENT_TEXT.$1:
;  455        text = '+' // whole_text(ex)
	PUSHAL	@FCSTATE.EXPONENT_TEXT.EX(AP)
	PUSHAQ	FCSTATE.EXPONENT_TEXT.$D1
	CALLS	#2,G^FCSTATE.WHOLE_TEXT
	MOVB	#43,FCSTATE.EXPONENT_TEXT.$T2
	MOVC3	#12,FCSTATE.EXPONENT_TEXT.$T1,FCSTATE.EXPONENT_TEXT.$T2+1
	MOVL	FCSTATE.EXPONENT_TEXT.TEXT(AP),R0
	MOVC3	#13,FCSTATE.EXPONENT_TEXT.$T2,@4(R0)
;  456      end if
;  457    end function exponent_text
	RET

; Storage map for FCSTATE.OPEN_LOG, a subroutine
;   NAME    CHARACTER*(*), INTENT(IN)  argument 1  @FCSTATE.OPEN_LOG.NAME(AP)
;   COLUMN  INTEGER, INTENT(IN)        argument 2  @FCSTATE.OPEN_LOG.COLUMN(AP)
;   IOS     INTEGER                    $LOCAL+0    FCSTATE.OPEN_LOG.IOS
;
FCSTATE.OPEN_LOG.NAME = 4		; NAME is argument 1
FCSTATE.OPEN_LOG.COLUMN = 8		; COLUMN is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCSTATE.OPEN_LOG.IOS:
	.BLKL	1			; IOS
FCSTATE.OPEN_LOG.$D1:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used
FCSTATE.OPEN_LOG.$T1:
	.BLKL	1			; temporary
FCSTATE.OPEN_LOG.$T2:
	.BLKB	19			; characters, for one statement
	.BLKB	1

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCSTATE.OPEN_LOG.$IO1:
	.WORD	8			; an I/O statement's control block: its size
	.WORD	^X0004			; flags: IOSTAT=
	.LONG	0			; (not used yet)
FCSTATE.OPEN_LOG.$K1:
	.LONG	47
FCSTATE.OPEN_LOG.$IO2:
	.WORD	8			; an I/O statement's control block: its size
	.WORD	^X0018			; flags: run-time format F90
	.LONG	0			; (not used yet)
FCSTATE.OPEN_LOG.$D2:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCSTATE.OPEN_LOG.$K2
FCSTATE.OPEN_LOG.$D3:
	.WORD	20			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCSTATE.OPEN_LOG.$K3
FCSTATE.OPEN_LOG.$D4:
	.WORD	19			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCSTATE.OPEN_LOG.$T2
FCSTATE.OPEN_LOG.$K2:
	.ASCII	/(2A)/
FCSTATE.OPEN_LOG.$K3:
	.ASCII	/! fcalc log, opened /

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  458
;  459    ! ------------------------------------------------------------------
;  460    ! LOG.
;  461
;  462    ! OPEN_LOG starts a transcript in the file NAME, closing any other first:
;  463    ! everything SAY writes is added to it (module FCMESSAGES' LOG_UNIT),
;  464    ! after a heading with the time. POSITION='APPEND' opens a file at its end,
;  465    ! so a log is added to; STATUS='UNKNOWN' makes the file if there is none.
;  466    subroutine open_log(name, column)
	.ENTRY	FCSTATE.OPEN_LOG,^M<>
;  467      character(len=*), intent(in) :: name
;  468      integer, intent(in) :: column
;  469      integer :: ios
;  470
;  471      if (log_unit /= 0) call close_log(column)
	TSTL	FCSTATE.LOG_UNIT
	BEQL	FCSTATE.OPEN_LOG.$1
	PUSHAL	@FCSTATE.OPEN_LOG.COLUMN(AP)
	CALLS	#1,G^FCSTATE.CLOSE_LOG
FCSTATE.OPEN_LOG.$1:
;  472      open (unit=log_file, file=name, status='UNKNOWN', action='WRITE', &
;  473        position='APPEND', iostat=ios)
	MOVW	@FCSTATE.OPEN_LOG.NAME(AP),FCSTATE.OPEN_LOG.$D1
	MOVL	FCSTATE.OPEN_LOG.NAME(AP),R0
	MOVAB	@4(R0),FCSTATE.OPEN_LOG.$D1+4
	PUSHL	#2
	PUSHL	#1048
	PUSHL	#3
	PUSHL	#1073
	PUSHL	#2
	PUSHL	#1074
	PUSHL	#4
	PUSHL	#1039
	PUSHAQ	FCSTATE.OPEN_LOG.$D1
	PUSHL	#1806
	PUSHL	#30
	PUSHAB	FCSTATE.OPEN_LOG.$IO1
	CALLS	#12,G^FTN$OPEN
	MOVL	R0,FCSTATE.OPEN_LOG.$T1
	MOVL	FCSTATE.OPEN_LOG.$T1,FCSTATE.OPEN_LOG.IOS
;  474      if (ios /= 0) then
	BEQL	FCSTATE.OPEN_LOG.$3
;  475        call fail(e_fileerr, column, name)
	PUSHL	FCSTATE.OPEN_LOG.NAME(AP)
	PUSHAL	@FCSTATE.OPEN_LOG.COLUMN(AP)
	PUSHAL	FCSTATE.OPEN_LOG.$K1
	CALLS	#3,G^FCMESSAGES.FAIL
;  476        return
	RET
FCSTATE.OPEN_LOG.$3:
;  477      end if
;  478      log_unit = log_file
	MOVL	#30,FCSTATE.LOG_UNIT
;  479      write (log_unit, '(2A)') '! fcalc log, opened ', now()
	PUSHAQ	FCSTATE.OPEN_LOG.$D2
	PUSHL	#30
	PUSHAB	FCSTATE.OPEN_LOG.$IO2
	CALLS	#3,G^FTN$WRITE_SF
	PUSHAQ	FCSTATE.OPEN_LOG.$D3
	CALLS	#1,G^FTN$IO_ITEM
	PUSHAQ	FCSTATE.OPEN_LOG.$D4
	CALLS	#1,G^FCSTATE.NOW
	PUSHAQ	FCSTATE.OPEN_LOG.$D4
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;  480    end subroutine open_log
	RET

; Storage map for FCSTATE.CLOSE_LOG, a subroutine
;   COLUMN  INTEGER, INTENT(IN)  argument 1  @FCSTATE.CLOSE_LOG.COLUMN(AP)
;
FCSTATE.CLOSE_LOG.COLUMN = 4		; COLUMN is argument 1

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCSTATE.CLOSE_LOG.$K1:
	.LONG	50
FCSTATE.CLOSE_LOG.$IO1:
	.WORD	8			; an I/O statement's control block: its size
	.WORD	^X0000			; flags: none
	.LONG	0			; (not used yet)

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  481
;  482    ! CLOSE_LOG ends the transcript: LOG OFF, a warning at COLUMN if there was
;  483    ! none.
;  484    subroutine close_log(column)
	.ENTRY	FCSTATE.CLOSE_LOG,^M<>
;  485      integer, intent(in) :: column
;  486
;  487      if (log_unit == 0) then
	TSTL	FCSTATE.LOG_UNIT
	BNEQ	FCSTATE.CLOSE_LOG.$1
;  488        call fail(w_nolog, column)
	PUSHL	#0
	PUSHAL	@FCSTATE.CLOSE_LOG.COLUMN(AP)
	PUSHAL	FCSTATE.CLOSE_LOG.$K1
	CALLS	#3,G^FCMESSAGES.FAIL
;  489        return
	RET
FCSTATE.CLOSE_LOG.$1:
;  490      end if
;  491      close (log_unit)
	PUSHL	FCSTATE.LOG_UNIT
	PUSHAB	FCSTATE.CLOSE_LOG.$IO1
	CALLS	#2,G^FTN$CLOSE
;  492      log_unit = 0
	CLRL	FCSTATE.LOG_UNIT
;  493    end subroutine close_log
	RET
;  494  end module fcstate

	.END
