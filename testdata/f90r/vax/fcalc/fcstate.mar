; Storage map for FCSTATE.SAVE_VARIABLE.LITERAL_FITS, a LOGICAL function
;   LITERAL_FITS  LOGICAL  $LOCAL+0   FCSTATE.SAVE_VARIABLE.$N1.$N2
;   R             INTEGER  $LOCAL+4   FCSTATE.SAVE_VARIABLE.$N1.R
;   C             INTEGER  $LOCAL+8   FCSTATE.SAVE_VARIABLE.$N1.C
;   USED          INTEGER  $LOCAL+12  FCSTATE.SAVE_VARIABLE.$N1.USED
;   R8 is $L1: DO (line 346)'s limit
;   R7 is $L2: DO (line 347)'s limit
;   R6 is $T2: temporary
;   FCSTATE.SAVE_VARIABLE.$N1.$N2 is FCSTATE.SAVE_VARIABLE.LITERAL_FITS.LITERAL_FITS
;

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCSTATE.SAVE_VARIABLE.$N1.$N2:
	.BLKL	1			; LITERAL_FITS, the function's value
FCSTATE.SAVE_VARIABLE.$N1.R:
	.BLKL	1			; R
FCSTATE.SAVE_VARIABLE.$N1.C:
	.BLKL	1			; C
FCSTATE.SAVE_VARIABLE.$N1.USED:
	.BLKL	1			; USED
FCSTATE.SAVE_VARIABLE.$N1.$T1:
