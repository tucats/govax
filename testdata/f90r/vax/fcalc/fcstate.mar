;    1  ! fcalc: the state of a session, and files.
;    2  !
;    3  ! SAVE writes the state (the settings, the variables, the functions) to a
;    4  ! file of fcalc's own commands, which LOAD runs again, and a user can read and
;    5  ! change in an editor:
;    6  !
;    7  !     ! fcalc state, saved 2026-11-21 10:42:17
;    8  !     set digits 12
;    9  !     set format auto
;   10  !     ...
;   11  !     r = 2.5;
;   12  !     v = [1, 2, 3];
;   13  !     f(x) = x^3 - 2*x - 5;
;   14  !
;   15  ! Each line ends in ;, fcalc's quiet line, so running the file with @ shows
;   16  ! nothing either. A variable's value is written with as many digits as it
;   17  ! takes to read back the very same number (A.3 of the phase doc: no digit
;   18  ! more), so LOAD restores it exactly, whatever SET DIGITS shows.
;   19  !
;   20  ! LOG writes a transcript of the session to a file, appended to what is
;   21  ! there; module FCMESSAGES' SAY writes every line to it.
;   22  !
;   23  ! The files of commands that @ and LOAD run are read here, a line at a time,
;   24  ! by the same nonadvancing READ as the terminal's lines. The main program
;   25  ! runs each line, since only it knows the commands; it keeps a file open
;   26  ! for each level of @ (a file may run another, up to MAX_DEPTH deep), each
;   27  ! on a unit of its own.
;   28  !
;   29  ! Fortran's I/O is by unit number: OPEN connects a unit to a file, READ and
;   30  ! WRITE name the unit, and CLOSE ends the connection. The units here are
;   31  ! chosen clear of the terminal's (5 and 6 by custom; * is the terminal).
;   32  ! IOSTAT= on an OPEN, READ, or WRITE gives 0 on success and something else on
;   33  ! failure instead of stopping the program, so fcalc reports the failure as one
;   34  ! of its own messages and goes on.
;   35  module fcstate
;   36    use fckinds
;   37    use fcmessages
;   38    use fcvalues, only: value, digits, number_format, number_base
;   39    use fcarrays, only: quantity, is_array
;   40    use fcsymbols, only: each_variable, each_function
;   41    use fcfuncs, only: angle_mode, seed_given, seed_number
;   42    implicit none
;   43    private
;   44
;   45    public :: format_names, angle_names, setting_names, setting_line
;   46    public :: file_name, open_input, close_input, read_line, max_depth
;   47    public :: save_state, open_log, close_log
;   48
;   49    ! The words SET and SHOW know, each list in the order of the settings'
;   50    ! codes (FCVALUES' F_AUTO to F_ENGINEERING, FCFUNCS' A_RADIANS to
;   51    ! A_GRADS), so a code is a word's place. The elements of an array
;   52    ! constructor must all have the same length, hence the blanks.
;   53    character(len=11), parameter :: format_names(4) = (/ 'auto       ', &
;   54      'fixed      ', 'scientific ', 'engineering' /)
;   55    character(len=7), parameter :: angle_names(3) = (/ 'radians', 'degrees', 'grads  ' /)
;   56    character(len=8), parameter :: setting_names(6) = (/ 'digits  ', 'format  ', &
;   57      'angle   ', 'base    ', 'seed    ', 'echo    ' /)
;   58
;   59    ! How deep files of commands may run one another.
;   60    integer, parameter :: max_depth = 8
;   61
;   62    ! The units: a file of commands at depth d is unit INPUT_UNIT + d, the log
;   63    ! LOG_FILE, and a file being saved SAVE_FILE.
;   64    integer, parameter :: input_unit = 20, log_file = 30, save_file = 31
;   65
;   66    ! The longest line SAVE writes: well within the 199 characters a line
;   67    ! may have, and easy to read in an editor.
;   68    integer, parameter :: save_width = 100
;   69
;   70  contains

; Storage map for FCSTATE.SETTING_LINE, a CHARACTER*40 function
;   TEXT  CHARACTER*40               hidden argument 1  @FCSTATE.SETTING_LINE.TEXT(AP)
;   WHAT  CHARACTER*(*), INTENT(IN)  argument 2         @FCSTATE.SETTING_LINE.WHAT(AP)
;   ECHO  LOGICAL, INTENT(IN)        argument 3         @FCSTATE.SETTING_LINE.ECHO(AP)
;   R6 is $T1: temporary
;   R7 is $T2: temporary
;
FCSTATE.SETTING_LINE.TEXT = 4		; TEXT's value goes through hidden argument 1
FCSTATE.SETTING_LINE.WHAT = 8		; WHAT is argument 2
FCSTATE.SETTING_LINE.ECHO = 12		; ECHO is argument 3

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCSTATE.SETTING_LINE.$T3:
	.BLKL	3			; characters, for one statement
FCSTATE.SETTING_LINE.$T4:
	.BLKB	23			; characters, for one statement
	.BLKB	1
FCSTATE.SETTING_LINE.$T5:
	.BLKB	22			; characters, for one statement
	.BLKB	2
FCSTATE.SETTING_LINE.$T6:
	.BLKB	17			; characters, for one statement
	.BLKB	3
FCSTATE.SETTING_LINE.$T7:
	.BLKB	21			; characters, for one statement
	.BLKB	3

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCSTATE.SETTING_LINE.$D1:
	.WORD	12			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCSTATE.SETTING_LINE.$T3
FCSTATE.SETTING_LINE.$K1:
	.ASCII	/digits/
FCSTATE.SETTING_LINE.$K2:
	.ASCII	/format/
FCSTATE.SETTING_LINE.$K3:
	.ASCII	/angle/
FCSTATE.SETTING_LINE.$K4:
	.ASCII	/base/
FCSTATE.SETTING_LINE.$K5:
	.ASCII	/seed/
FCSTATE.SETTING_LINE.$K6:
	.ASCII	/set digits /
FCSTATE.SETTING_LINE.$K7:
	.ASCII	/set format /
FCSTATE.SETTING_LINE.$K8:
	.ASCII	/auto       fixed      scientific engineering/
FCSTATE.SETTING_LINE.$K9:
	.ASCII	/set angle /
FCSTATE.SETTING_LINE.$K10:
	.ASCII	/radiansdegreesgrads  /
FCSTATE.SETTING_LINE.$K11:
	.ASCII	/set base hex/
FCSTATE.SETTING_LINE.$K12:
	.ASCII	/set base octal/
FCSTATE.SETTING_LINE.$K13:
	.ASCII	/set base binary/
FCSTATE.SETTING_LINE.$K14:
	.ASCII	/set base decimal/
FCSTATE.SETTING_LINE.$K15:
	.ASCII	/set seed /
FCSTATE.SETTING_LINE.$K16:
	.ASCII	/! no seed has been set/
FCSTATE.SETTING_LINE.$K17:
	.ASCII	/set echo/
FCSTATE.SETTING_LINE.$K18:
	.ASCII	/set noecho/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;   71
;   72    ! SETTING_LINE is the SET command that makes the setting WHAT as it is
;   73    ! now: set digits 12. A seed never given is a comment, which fcalc
;   74    ! passes over if it is typed back. ECHO is the main program's setting.
;   75    function setting_line(what, echo) result(text)
	.ENTRY	FCSTATE.SETTING_LINE,^M<R2,R3,R4,R5,R6,R7>
;   76      character(len=*), intent(in) :: what
;   77      logical, intent(in) :: echo
;   78      character(len=40) :: text
;   79
;   80      select case (what)
	MOVL	FCSTATE.SETTING_LINE.WHAT(AP),R0
	MOVAB	@4(R0),R6
	MOVZWL	@FCSTATE.SETTING_LINE.WHAT(AP),R7
	CMPC5	R7,(R6),#^A/ /,#6,FCSTATE.SETTING_LINE.$K1
	BEQL	FCSTATE.SETTING_LINE.$1
	CMPC5	R7,(R6),#^A/ /,#6,FCSTATE.SETTING_LINE.$K2
	BEQL	FCSTATE.SETTING_LINE.$3
	CMPC5	R7,(R6),#^A/ /,#5,FCSTATE.SETTING_LINE.$K3
	BNEQ	FCSTATE.SETTING_LINE.$6
	BRW	FCSTATE.SETTING_LINE.$5
FCSTATE.SETTING_LINE.$6:
	CMPC5	R7,(R6),#^A/ /,#4,FCSTATE.SETTING_LINE.$K4
	BNEQ	FCSTATE.SETTING_LINE.$8
	BRW	FCSTATE.SETTING_LINE.$7
FCSTATE.SETTING_LINE.$8:
	CMPC5	R7,(R6),#^A/ /,#4,FCSTATE.SETTING_LINE.$K5
	BNEQ	FCSTATE.SETTING_LINE.$10
	BRW	FCSTATE.SETTING_LINE.$9
FCSTATE.SETTING_LINE.$10:
	BRW	FCSTATE.SETTING_LINE.$11
FCSTATE.SETTING_LINE.$1:
;   81      case ('digits')
;   82        text = 'set digits ' // whole_text(digits)
	PUSHAL	FCSTATE.DIGITS
	PUSHAQ	FCSTATE.SETTING_LINE.$D1
	CALLS	#2,G^FCSTATE.WHOLE_TEXT
	MOVC3	#11,FCSTATE.SETTING_LINE.$K6,FCSTATE.SETTING_LINE.$T4
	MOVC3	#12,FCSTATE.SETTING_LINE.$T3,FCSTATE.SETTING_LINE.$T4+11
	MOVL	FCSTATE.SETTING_LINE.TEXT(AP),R0
	MOVC5	#23,FCSTATE.SETTING_LINE.$T4,#^A/ /,#40,@4(R0)
;   83      case ('format')
	RET
FCSTATE.SETTING_LINE.$3:
;   84        text = 'set format ' // format_names(number_format)
	MOVC3	#11,FCSTATE.SETTING_LINE.$K7,FCSTATE.SETTING_LINE.$T5
	MULL3	FCSTATE.NUMBER_FORMAT,#11,R0
	MOVC3	#11,FCSTATE.SETTING_LINE.$K8-11[R0],FCSTATE.SETTING_LINE.$T5+11
	MOVL	FCSTATE.SETTING_LINE.TEXT(AP),R0
	MOVC5	#22,FCSTATE.SETTING_LINE.$T5,#^A/ /,#40,@4(R0)
;   85      case ('angle')
	RET
FCSTATE.SETTING_LINE.$5:
;   86        text = 'set angle ' // angle_names(angle_mode)
	MOVC3	#10,FCSTATE.SETTING_LINE.$K9,FCSTATE.SETTING_LINE.$T6
	MULL3	FCSTATE.ANGLE_MODE,#7,R0
	MOVC3	#7,FCSTATE.SETTING_LINE.$K10-7[R0],FCSTATE.SETTING_LINE.$T6+10
	MOVL	FCSTATE.SETTING_LINE.TEXT(AP),R0
	MOVC5	#17,FCSTATE.SETTING_LINE.$T6,#^A/ /,#40,@4(R0)
;   87      case ('base')
	RET
FCSTATE.SETTING_LINE.$7:
;   88        select case (number_base)
	CMPL	FCSTATE.NUMBER_BASE,#16
	BEQL	FCSTATE.SETTING_LINE.$13
	CMPL	FCSTATE.NUMBER_BASE,#8
	BEQL	FCSTATE.SETTING_LINE.$15
	CMPL	FCSTATE.NUMBER_BASE,#2
	BNEQ	FCSTATE.SETTING_LINE.$19
	BRB	FCSTATE.SETTING_LINE.$17
FCSTATE.SETTING_LINE.$13:
;   89        case (16)
;   90          text = 'set base hex'
	MOVL	FCSTATE.SETTING_LINE.TEXT(AP),R0
	MOVC5	#12,FCSTATE.SETTING_LINE.$K11,#^A/ /,#40,@4(R0)
;   91        case (8)
	RET
FCSTATE.SETTING_LINE.$15:
;   92          text = 'set base octal'
	MOVL	FCSTATE.SETTING_LINE.TEXT(AP),R0
	MOVC5	#14,FCSTATE.SETTING_LINE.$K12,#^A/ /,#40,@4(R0)
;   93        case (2)
	RET
FCSTATE.SETTING_LINE.$17:
;   94          text = 'set base binary'
	MOVL	FCSTATE.SETTING_LINE.TEXT(AP),R0
	MOVC5	#15,FCSTATE.SETTING_LINE.$K13,#^A/ /,#40,@4(R0)
;   95        case default
	RET
FCSTATE.SETTING_LINE.$19:
;   96          text = 'set base decimal'
	MOVL	FCSTATE.SETTING_LINE.TEXT(AP),R0
	MOVC5	#16,FCSTATE.SETTING_LINE.$K14,#^A/ /,#40,@4(R0)
;   97        end select
;   98      case ('seed')
	RET
FCSTATE.SETTING_LINE.$9:
;   99        if (seed_given) then
	BLBC	FCSTATE.SEED_GIVEN,FCSTATE.SETTING_LINE.$21
;  100          text = 'set seed ' // whole_text(seed_number)
	PUSHAL	FCSTATE.SEED_NUMBER
	PUSHAQ	FCSTATE.SETTING_LINE.$D1
	CALLS	#2,G^FCSTATE.WHOLE_TEXT
	MOVC3	#9,FCSTATE.SETTING_LINE.$K15,FCSTATE.SETTING_LINE.$T7
	MOVC3	#12,FCSTATE.SETTING_LINE.$T3,FCSTATE.SETTING_LINE.$T7+9
	MOVL	FCSTATE.SETTING_LINE.TEXT(AP),R0
	MOVC5	#21,FCSTATE.SETTING_LINE.$T7,#^A/ /,#40,@4(R0)
;  101        else
	RET
FCSTATE.SETTING_LINE.$21:
;  102          text = '! no seed has been set'
	MOVL	FCSTATE.SETTING_LINE.TEXT(AP),R0
	MOVC5	#22,FCSTATE.SETTING_LINE.$K16,#^A/ /,#40,@4(R0)
;  103        end if
;  104      case default
	RET
FCSTATE.SETTING_LINE.$11:
;  105        if (echo) then
	BLBC	@FCSTATE.SETTING_LINE.ECHO(AP),FCSTATE.SETTING_LINE.$24
;  106          text = 'set echo'
	MOVL	FCSTATE.SETTING_LINE.TEXT(AP),R0
	MOVC5	#8,FCSTATE.SETTING_LINE.$K17,#^A/ /,#40,@4(R0)
;  107        else
	RET
FCSTATE.SETTING_LINE.$24:
;  108          text = 'set noecho'
	MOVL	FCSTATE.SETTING_LINE.TEXT(AP),R0
	MOVC5	#10,FCSTATE.SETTING_LINE.$K18,#^A/ /,#40,@4(R0)
;  109        end if
;  110      end select
;  111    end function setting_line
	RET

; Storage map for FCSTATE.WHOLE_TEXT, a CHARACTER*12 function
;   TEXT  CHARACTER*12         hidden argument 1  @FCSTATE.WHOLE_TEXT.TEXT(AP)
;   N     INTEGER, INTENT(IN)  argument 2         @FCSTATE.WHOLE_TEXT.N(AP)
;
FCSTATE.WHOLE_TEXT.TEXT = 4		; TEXT's value goes through hidden argument 1
FCSTATE.WHOLE_TEXT.N = 8		; N is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCSTATE.WHOLE_TEXT.$D1:
	.WORD	12			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used
FCSTATE.WHOLE_TEXT.$D3:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_L,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used
FCSTATE.WHOLE_TEXT.$T1:
	.BLKL	3			; characters, for one statement

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCSTATE.WHOLE_TEXT.$IO1:
	.WORD	8			; an I/O statement's control block: its size
	.WORD	^X0018			; flags: run-time format F90
	.LONG	0			; (not used yet)
FCSTATE.WHOLE_TEXT.$D2:
	.WORD	5			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCSTATE.WHOLE_TEXT.$K1
FCSTATE.WHOLE_TEXT.$D4:
	.WORD	12			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCSTATE.WHOLE_TEXT.$T1
FCSTATE.WHOLE_TEXT.$K1:
	.ASCII	/(I12)/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  112
;  113    ! WHOLE_TEXT is N in as few characters as it takes: 12, -3. (Fortran 95's
;  114    ! I0 edit descriptor does this; Fortran 90 has none, so the number is
;  115    ! written in a field wide enough for any, and ADJUSTL moves it to the
;  116    ! left, leaving the blanks for TRIM.)
;  117    function whole_text(n) result(text)
	.ENTRY	FCSTATE.WHOLE_TEXT,^M<R2,R3,R4,R5>
;  118      integer, intent(in) :: n
;  119      character(len=12) :: text
;  120
;  121      write (text, '(I12)') n
	MOVL	FCSTATE.WHOLE_TEXT.TEXT(AP),R0
	MOVAB	@4(R0),FCSTATE.WHOLE_TEXT.$D1+4
	PUSHAQ	FCSTATE.WHOLE_TEXT.$D2
	PUSHAQ	FCSTATE.WHOLE_TEXT.$D1
	PUSHAB	FCSTATE.WHOLE_TEXT.$IO1
	CALLS	#3,G^FTN$WRITE_IF
	MOVAL	@FCSTATE.WHOLE_TEXT.N(AP),FCSTATE.WHOLE_TEXT.$D3+4
	PUSHAQ	FCSTATE.WHOLE_TEXT.$D3
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;  122      text = adjustl(text)
	MOVL	FCSTATE.WHOLE_TEXT.TEXT(AP),R0
	MOVAB	@4(R0),FCSTATE.WHOLE_TEXT.$D1+4
	PUSHAQ	FCSTATE.WHOLE_TEXT.$D1
	PUSHAQ	FCSTATE.WHOLE_TEXT.$D4
	CALLS	#2,G^FTN$ADJUSTL
	MOVL	FCSTATE.WHOLE_TEXT.TEXT(AP),R0
	MOVC3	#12,FCSTATE.WHOLE_TEXT.$T1,@4(R0)
;  123    end function whole_text
	RET

; Storage map for FCSTATE.FILE_NAME, a CHARACTER*(*) function
;   $VALUE  CHARACTER*(LEN(TEXT)+6)    hidden argument 1       @FCSTATE.FILE_NAME.$VALUE(AP)
;   TEXT    CHARACTER*(*), INTENT(IN)  argument 2              @FCSTATE.FILE_NAME.TEXT(AP)
;   NAME    CHARACTER*(LEN(TEXT)+6)    descriptor at $LOCAL+4  FCSTATE.FILE_NAME.NAME
;   K       INTEGER                    $LOCAL+0                FCSTATE.FILE_NAME.K
;   R6 is $T1: temporary
;   R6 is $U1: temporary
;
FCSTATE.FILE_NAME.$VALUE = 4		; $VALUE's value goes through hidden argument 1
FCSTATE.FILE_NAME.TEXT = 8		; TEXT is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCSTATE.FILE_NAME.K:
	.BLKL	1			; K
FCSTATE.FILE_NAME.NAME:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.LONG	0			; NAME: not allocated
FCSTATE.FILE_NAME.$T2:
	.BLKL	1			; temporary
FCSTATE.FILE_NAME.$D2:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_D
	.LONG	0			; set when the descriptor is used
FCSTATE.FILE_NAME.$T3:
	.BLKB	2			; temporary
	.BLKB	2

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCSTATE.FILE_NAME.$D1:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCSTATE.FILE_NAME.$K1
FCSTATE.FILE_NAME.$K2:
	.LONG	-1
FCSTATE.FILE_NAME.$K1:
	.ASCII	"]>:/"
FCSTATE.FILE_NAME.$K3:
	.ASCII	/./
FCSTATE.FILE_NAME.$K4:
	.ASCII	/.fcalc/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  124
;  125    ! FILE_NAME is the file TEXT names, with .fcalc after it if it has no type
;  126    ! of its own: state is state.fcalc, notes.txt itself. The type is looked
;  127    ! for after the directory, which ends in ] or > on VMS and / on Unix.
;  128    ! The result's length depends on the argument's, LEN(TEXT) + 6: a
;  129    ! function's result may have a length known only when it is called.
;  130    function file_name(text) result(name)
	.ENTRY	FCSTATE.FILE_NAME,^M<R2,R3,R4,R5,R6>
	MOVZWL	@FCSTATE.FILE_NAME.TEXT(AP),R0
	ADDL3	R0,#6,R6
	BGEQ	FCSTATE.FILE_NAME.$1
	CLRL	R6
FCSTATE.FILE_NAME.$1:
	CVTLW	R6,FCSTATE.FILE_NAME.NAME
	PUSHL	FCSTATE.FILE_NAME.$VALUE(AP)
	PUSHAQ	FCSTATE.FILE_NAME.NAME
	CALLS	#2,G^LIB$SGET1_DD
	MOVL	FCSTATE.FILE_NAME.$VALUE(AP),R0
	MOVL	4(R0),FCSTATE.FILE_NAME.NAME+4
;  131      character(len=*), intent(in) :: text
;  132      character(len=len(text) + 6) :: name
;  133      integer :: k
;  134
;  135      ! SCAN with BACK=.TRUE. finds the last of the characters in the set.
;  136      k = scan(text, ']>:/', back=.true.)
	PUSHAL	FCSTATE.FILE_NAME.$K2
	PUSHAQ	FCSTATE.FILE_NAME.$D1
	PUSHL	FCSTATE.FILE_NAME.TEXT(AP)
	CALLS	#3,G^FTN$SCAN
	MOVL	R0,R6
	MOVL	R6,FCSTATE.FILE_NAME.K
;  137      name = text
	MOVZWL	@FCSTATE.FILE_NAME.TEXT(AP),R6
	MOVL	FCSTATE.FILE_NAME.TEXT(AP),R0
	MOVZWL	FCSTATE.FILE_NAME.NAME,R1
	MOVC5	R6,@4(R0),#^A/ /,R1,@FCSTATE.FILE_NAME.NAME+4
;  138      if (index(text(k + 1:), '.') == 0) name = text // '.fcalc'
	SUBL2	FCSTATE.FILE_NAME.K,R6
	BGEQ	FCSTATE.FILE_NAME.$3
	CLRL	R6
FCSTATE.FILE_NAME.$3:
	MOVL	FCSTATE.FILE_NAME.TEXT(AP),R0
	MOVL	FCSTATE.FILE_NAME.K,R1
	MATCHC	#1,FCSTATE.FILE_NAME.$K3,R6,@4(R0)[R1]
	BNEQ	FCSTATE.FILE_NAME.$5
	SUBL3	R2,R6,R0
	BRB	FCSTATE.FILE_NAME.$6
FCSTATE.FILE_NAME.$5:
	CLRL	R0
FCSTATE.FILE_NAME.$6:
	MOVL	R0,FCSTATE.FILE_NAME.$T2
	BNEQ	FCSTATE.FILE_NAME.$7
	MOVZWL	@FCSTATE.FILE_NAME.TEXT(AP),R6
	ADDL3	R6,#6,R0
	CVTLW	R0,FCSTATE.FILE_NAME.$T3
	PUSHAQ	FCSTATE.FILE_NAME.$D2
	PUSHAW	FCSTATE.FILE_NAME.$T3
	CALLS	#2,G^LIB$SGET1_DD
	MOVL	FCSTATE.FILE_NAME.TEXT(AP),R0
	MOVC3	R6,@4(R0),@FCSTATE.FILE_NAME.$D2+4
	MOVC3	#6,FCSTATE.FILE_NAME.$K4,@FCSTATE.FILE_NAME.$D2+4[R6]
	ADDL3	R6,#6,R0
	MOVZWL	FCSTATE.FILE_NAME.NAME,R1
	MOVC5	R0,@FCSTATE.FILE_NAME.$D2+4,#^A/ /,R1,@FCSTATE.FILE_NAME.NAME+4
	PUSHAQ	FCSTATE.FILE_NAME.$D2
	CALLS	#1,G^LIB$SFREE1_DD
FCSTATE.FILE_NAME.$7:
;  139    end function file_name
	RET

; Storage map for FCSTATE.OPEN_INPUT, a LOGICAL function
;   NAME        CHARACTER*(*), INTENT(IN)  argument 1  @FCSTATE.OPEN_INPUT.NAME(AP)
;   DEPTH       INTEGER, INTENT(IN)        argument 2  @FCSTATE.OPEN_INPUT.DEPTH(AP)
;   COLUMN      INTEGER, INTENT(IN)        argument 3  @FCSTATE.OPEN_INPUT.COLUMN(AP)
;   OPEN_INPUT  LOGICAL                    $LOCAL+0    FCSTATE.OPEN_INPUT.OPEN_INPUT
;   THERE       LOGICAL                    $LOCAL+4    FCSTATE.OPEN_INPUT.THERE
;   RUNNING     LOGICAL                    $LOCAL+8    FCSTATE.OPEN_INPUT.RUNNING
;   IOS         INTEGER                    $LOCAL+12   FCSTATE.OPEN_INPUT.IOS
;   R6 is $T1: temporary
;
FCSTATE.OPEN_INPUT.NAME = 4		; NAME is argument 1
FCSTATE.OPEN_INPUT.DEPTH = 8		; DEPTH is argument 2
FCSTATE.OPEN_INPUT.COLUMN = 12		; COLUMN is argument 3

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCSTATE.OPEN_INPUT.OPEN_INPUT:
	.BLKL	1			; OPEN_INPUT, the function's value
FCSTATE.OPEN_INPUT.THERE:
	.BLKL	1			; THERE
FCSTATE.OPEN_INPUT.RUNNING:
	.BLKL	1			; RUNNING
FCSTATE.OPEN_INPUT.IOS:
	.BLKL	1			; IOS
FCSTATE.OPEN_INPUT.$D1:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCSTATE.OPEN_INPUT.$IO1:
	.WORD	8			; an I/O statement's control block: its size
	.WORD	^X0004			; flags: IOSTAT=
	.LONG	0			; (not used yet)
FCSTATE.OPEN_INPUT.$K1:
	.LONG	46
FCSTATE.OPEN_INPUT.$K2:
	.LONG	49
FCSTATE.OPEN_INPUT.$K3:
	.LONG	47

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  140
;  141    ! OPEN_INPUT opens the file NAME to read, at DEPTH (1 for the first): false
;  142    ! after an error at COLUMN, NOFILE if there is no such file, FILELOOP if
;  143    ! it is one already running (which would run itself forever: fcalc has no
;  144    ! way to stop it). INQUIRE asks about a file without opening it: EXIST=
;  145    ! says whether it is there, and OPENED= whether a unit is connected to it,
;  146    ! which the system answers however the name is written (on VMS, x and
;  147    ! X.FCALC;1 are one file). STATUS='OLD' opens one that must be there, and
;  148    ! ACTION='READ' only to read it.
;  149    logical function open_input(name, depth, column)
	.ENTRY	FCSTATE.OPEN_INPUT,^M<R6>
;  150      character(len=*), intent(in) :: name
;  151      integer, intent(in) :: depth, column
;  152      logical :: there, running
;  153      integer :: ios
;  154
;  155      open_input = .false.
;  156      inquire (file=name, exist=there, opened=running, iostat=ios)
	MOVW	@FCSTATE.OPEN_INPUT.NAME(AP),FCSTATE.OPEN_INPUT.$D1
	MOVL	FCSTATE.OPEN_INPUT.NAME(AP),R0
	MOVAB	@4(R0),FCSTATE.OPEN_INPUT.$D1+4
	PUSHAL	FCSTATE.OPEN_INPUT.RUNNING
	PUSHL	#1311
	PUSHAL	FCSTATE.OPEN_INPUT.THERE
	PUSHL	#1310
	PUSHAQ	FCSTATE.OPEN_INPUT.$D1
	PUSHL	#1806
	PUSHAB	FCSTATE.OPEN_INPUT.$IO1
	CALLS	#7,G^FTN$INQUIRE
	MOVL	R0,R6
	MOVL	R6,FCSTATE.OPEN_INPUT.IOS
;  157      if (ios /= 0 .or. .not. there) then
	BNEQ	FCSTATE.OPEN_INPUT.$2
	BLBS	FCSTATE.OPEN_INPUT.THERE,FCSTATE.OPEN_INPUT.$1
FCSTATE.OPEN_INPUT.$2:
;  158        call fail(e_nofile, column, name)
	PUSHL	FCSTATE.OPEN_INPUT.NAME(AP)
	PUSHAL	@FCSTATE.OPEN_INPUT.COLUMN(AP)
	PUSHAL	FCSTATE.OPEN_INPUT.$K1
	CALLS	#3,G^FCMESSAGES.FAIL
;  159        return
	CLRL	R0			; the function's value
	RET
FCSTATE.OPEN_INPUT.$1:
;  160      end if
;  161      if (running) then
	BLBC	FCSTATE.OPEN_INPUT.RUNNING,FCSTATE.OPEN_INPUT.$5
;  162        call fail(e_fileloop, column, name)
	PUSHL	FCSTATE.OPEN_INPUT.NAME(AP)
	PUSHAL	@FCSTATE.OPEN_INPUT.COLUMN(AP)
	PUSHAL	FCSTATE.OPEN_INPUT.$K2
	CALLS	#3,G^FCMESSAGES.FAIL
;  163        return
	CLRL	R0			; the function's value
	RET
FCSTATE.OPEN_INPUT.$5:
;  164      end if
;  165      open (unit=input_unit + depth, file=name, status='OLD', action='READ', iostat=ios)
	MOVW	@FCSTATE.OPEN_INPUT.NAME(AP),FCSTATE.OPEN_INPUT.$D1
	MOVL	FCSTATE.OPEN_INPUT.NAME(AP),R0
	MOVAB	@4(R0),FCSTATE.OPEN_INPUT.$D1+4
	PUSHL	#2
	PUSHL	#1048
	PUSHL	#1
	PUSHL	#1074
	PUSHL	#1
	PUSHL	#1039
	PUSHAQ	FCSTATE.OPEN_INPUT.$D1
	PUSHL	#1806
	ADDL3	@FCSTATE.OPEN_INPUT.DEPTH(AP),#20,R0
	PUSHL	R0
	PUSHAB	FCSTATE.OPEN_INPUT.$IO1
	CALLS	#10,G^FTN$OPEN
	MOVL	R0,R6
	MOVL	R6,FCSTATE.OPEN_INPUT.IOS
;  166      if (ios /= 0) then
	BEQL	FCSTATE.OPEN_INPUT.$7
;  167        call fail(e_fileerr, column, name)
	PUSHL	FCSTATE.OPEN_INPUT.NAME(AP)
	PUSHAL	@FCSTATE.OPEN_INPUT.COLUMN(AP)
	PUSHAL	FCSTATE.OPEN_INPUT.$K3
	CALLS	#3,G^FCMESSAGES.FAIL
;  168        return
	CLRL	R0			; the function's value
	RET
FCSTATE.OPEN_INPUT.$7:
;  169      end if
;  170      open_input = .true.
;  171    end function open_input
	MOVL	#-1,R0			; the function's value
	RET

; Storage map for FCSTATE.CLOSE_INPUT, a subroutine
;   DEPTH  INTEGER, INTENT(IN)  argument 1  @FCSTATE.CLOSE_INPUT.DEPTH(AP)
;
FCSTATE.CLOSE_INPUT.DEPTH = 4		; DEPTH is argument 1

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCSTATE.CLOSE_INPUT.$IO1:
	.WORD	8			; an I/O statement's control block: its size
	.WORD	^X0000			; flags: none
	.LONG	0			; (not used yet)

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  172
;  173    ! CLOSE_INPUT closes the file of commands at DEPTH.
;  174    subroutine close_input(depth)
	.ENTRY	FCSTATE.CLOSE_INPUT,^M<>
;  175      integer, intent(in) :: depth
;  176
;  177      close (input_unit + depth)
	ADDL3	@FCSTATE.CLOSE_INPUT.DEPTH(AP),#20,R0
	PUSHL	R0
	PUSHAB	FCSTATE.CLOSE_INPUT.$IO1
	CALLS	#2,G^FTN$CLOSE
;  178    end subroutine close_input
	RET

; Storage map for FCSTATE.READ_LINE, a subroutine
;   TEXT    CHARACTER*(*), INTENT(OUT)     argument 1   @FCSTATE.READ_LINE.TEXT(AP)
;   LENGTH  INTEGER, INTENT(OUT)           argument 2   @FCSTATE.READ_LINE.LENGTH(AP)
;   STATUS  INTEGER, INTENT(OUT)           argument 3   @FCSTATE.READ_LINE.STATUS(AP)
;   DEPTH   INTEGER, INTENT(IN), OPTIONAL  an argument  @FCSTATE.READ_LINE.$A4
;   REST    CHARACTER*80                   $LOCAL+0     FCSTATE.READ_LINE.REST
;   IOS     INTEGER                        $LOCAL+80    FCSTATE.READ_LINE.IOS
;   R6 is $R1: IOS, during a loop
;   R7 is $R2: DEPTH's address
;
FCSTATE.READ_LINE.TEXT = 4		; TEXT is argument 1
FCSTATE.READ_LINE.LENGTH = 8		; LENGTH is argument 2
FCSTATE.READ_LINE.STATUS = 12		; STATUS is argument 3

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCSTATE.READ_LINE.REST:
	.BLKL	20			; REST
FCSTATE.READ_LINE.IOS:
	.BLKL	1			; IOS
FCSTATE.READ_LINE.$A4:
	.BLKL	1			; DEPTH's longword of the argument list, set at each entry point
FCSTATE.READ_LINE.$D2:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used
FCSTATE.READ_LINE.$T1:
	.BLKL	1			; temporary
FCSTATE.READ_LINE.$T2:
	.BLKL	1			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCSTATE.READ_LINE.$IO1:
	.WORD	8			; an I/O statement's control block: its size
	.WORD	^X007E			; flags: END= IOSTAT= run-time format F90 nonadvancing EOR=
	.LONG	0			; (not used yet)
FCSTATE.READ_LINE.$D1:
	.WORD	3			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCSTATE.READ_LINE.$K1
FCSTATE.READ_LINE.$D3:
	.WORD	80			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCSTATE.READ_LINE.REST
FCSTATE.READ_LINE.$K1:
	.ASCII	/(A)/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  179
;  180    ! READ_LINE reads the next line into TEXT(:LENGTH), from the terminal, or
;  181    ! from the file of commands at DEPTH if it is given: STATUS is 0, or 1 for
;  182    ! a line too long (whose rest is passed over), or -1 at the end of the
;  183    ! input. TEXT's last character is room to tell a line too long from one
;  184    ! that just fits.
;  185    !
;  186    ! A nonadvancing READ (ADVANCE='NO') reads part of a record and leaves
;  187    ! the rest for the next READ. SIZE= gives how many characters it read,
;  188    ! so a line's length is known without counting trailing blanks; EOR=
;  189    ! names a statement label to go to when the record (the line) ends before
;  190    ! the variable is full, which is the usual case, and END= one for the end
;  191    ! of the input. These labels, 10, 20, and 30, are the old-fashioned GO TO
;  192    ! targets Fortran's I/O statements still use. A line too long for the
;  193    ! system to read (on VMS, a terminal's line past 199 characters) is an
;  194    ! error the READ's IOSTAT= catches, after which the next READ reads the
;  195    ! next line.
;  196    !
;  197    ! The terminal is unit *, which isn't a number, so each READ is written
;  198    ! twice, once for each.
;  199    subroutine read_line(text, length, status, depth)
	.ENTRY	FCSTATE.READ_LINE,^M<R6,R7>
	CLRL	FCSTATE.READ_LINE.$A4	; DEPTH is argument 4, if the caller passed it
	CMPB	(AP),#4
	BLSSU	FCSTATE.READ_LINE.$26
	MOVL	16(AP),FCSTATE.READ_LINE.$A4
FCSTATE.READ_LINE.$26:
;  200      character(len=*), intent(out) :: text
;  201      integer, intent(out) :: length, status
;  202      integer, intent(in), optional :: depth
;  203      character(len=80) :: rest
;  204      integer :: ios
;  205
;  206      status = 0
	CLRL	@FCSTATE.READ_LINE.STATUS(AP)
;  207      length = 0
	CLRL	@FCSTATE.READ_LINE.LENGTH(AP)
;  208      if (present(depth)) then
	TSTL	FCSTATE.READ_LINE.$A4
	BNEQ	FCSTATE.READ_LINE.$2
	BRW	FCSTATE.READ_LINE.$1
FCSTATE.READ_LINE.$2:
;  209        read (input_unit + depth, '(A)', advance='NO', size=length, eor=10, end=30, &
;  210          iostat=ios) text
	PUSHAQ	FCSTATE.READ_LINE.$D1
	ADDL3	@FCSTATE.READ_LINE.$A4,#20,R0
	PUSHL	R0
	PUSHAB	FCSTATE.READ_LINE.$IO1
	CALLS	#3,G^FTN$READ_SF
	MOVW	@FCSTATE.READ_LINE.TEXT(AP),FCSTATE.READ_LINE.$D2
	MOVL	FCSTATE.READ_LINE.TEXT(AP),R0
	MOVAB	@4(R0),FCSTATE.READ_LINE.$D2+4
	PUSHAQ	FCSTATE.READ_LINE.$D2
	CALLS	#1,G^FTN$IO_ITEM
	PUSHAL	FCSTATE.READ_LINE.$T1
	CALLS	#1,G^FTN$IO_END
	MOVL	R0,FCSTATE.READ_LINE.$T2
	MOVL	FCSTATE.READ_LINE.$T1,@FCSTATE.READ_LINE.LENGTH(AP)
	MOVL	FCSTATE.READ_LINE.$T2,FCSTATE.READ_LINE.IOS
	CMPL	FCSTATE.READ_LINE.$T2,#-2
	BNEQ	FCSTATE.READ_LINE.$3
	BRW	FCSTATE.READ_LINE.L10
FCSTATE.READ_LINE.$3:
	TSTL	FCSTATE.READ_LINE.$T2
	BGEQ	FCSTATE.READ_LINE.$4
	BRW	FCSTATE.READ_LINE.L30
FCSTATE.READ_LINE.$4:
;  211      else
	BRB	FCSTATE.READ_LINE.$5
FCSTATE.READ_LINE.$1:
;  212        read (*, '(A)', advance='NO', size=length, eor=10, end=30, iostat=ios) text
	PUSHAQ	FCSTATE.READ_LINE.$D1
	PUSHL	#-4
	PUSHAB	FCSTATE.READ_LINE.$IO1
	CALLS	#3,G^FTN$READ_SF
	MOVW	@FCSTATE.READ_LINE.TEXT(AP),FCSTATE.READ_LINE.$D2
	MOVL	FCSTATE.READ_LINE.TEXT(AP),R0
	MOVAB	@4(R0),FCSTATE.READ_LINE.$D2+4
	PUSHAQ	FCSTATE.READ_LINE.$D2
	CALLS	#1,G^FTN$IO_ITEM
	PUSHAL	FCSTATE.READ_LINE.$T2
	CALLS	#1,G^FTN$IO_END
	MOVL	R0,FCSTATE.READ_LINE.$T1
	MOVL	FCSTATE.READ_LINE.$T2,@FCSTATE.READ_LINE.LENGTH(AP)
	MOVL	FCSTATE.READ_LINE.$T1,FCSTATE.READ_LINE.IOS
	CMPL	FCSTATE.READ_LINE.$T1,#-2
	BNEQ	FCSTATE.READ_LINE.$6
	BRW	FCSTATE.READ_LINE.L10
FCSTATE.READ_LINE.$6:
	TSTL	FCSTATE.READ_LINE.$T1
	BGEQ	FCSTATE.READ_LINE.$7
	BRW	FCSTATE.READ_LINE.L30
FCSTATE.READ_LINE.$7:
;  213      end if
FCSTATE.READ_LINE.$5:
;  214      status = 1
	MOVL	#1,@FCSTATE.READ_LINE.STATUS(AP)
;  215      if (ios /= 0) return
	TSTL	FCSTATE.READ_LINE.IOS
	BEQL	FCSTATE.READ_LINE.$8
	RET
FCSTATE.READ_LINE.$8:
;  216
;  217      ! The line filled TEXT without ending: pass over the rest, a piece at a
;  218      ! time. Each piece is read into REST only to be dropped (so /WARNINGS
;  219      ! reports REST as UNREAD): a nonadvancing READ with no item reads nothing,
;  220      ! so it would never reach the end of the record.
;  221      do
	MOVL	FCSTATE.READ_LINE.IOS,R6
	MOVL	FCSTATE.READ_LINE.$A4,R7
FCSTATE.READ_LINE.$10:			; DO (line 221)'s body
;  222        if (present(depth)) then
	TSTL	FCSTATE.READ_LINE.$A4
	BEQL	FCSTATE.READ_LINE.$11
;  223          read (input_unit + depth, '(A)', advance='NO', eor=20, end=20, iostat=ios) rest
	PUSHAQ	FCSTATE.READ_LINE.$D1
	ADDL3	(R7),#20,R0
	PUSHL	R0
	PUSHAB	FCSTATE.READ_LINE.$IO1
	CALLS	#3,G^FTN$READ_SF
	PUSHAQ	FCSTATE.READ_LINE.$D3
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
	MOVL	R0,FCSTATE.READ_LINE.$T1
	MOVL	FCSTATE.READ_LINE.$T1,R6
	CMPL	FCSTATE.READ_LINE.$T1,#-2
	BNEQ	FCSTATE.READ_LINE.$14
	BRW	FCSTATE.READ_LINE.$13
FCSTATE.READ_LINE.$14:
	TSTL	FCSTATE.READ_LINE.$T1
	BGEQ	FCSTATE.READ_LINE.$17
	BRW	FCSTATE.READ_LINE.$15
;  224        else
FCSTATE.READ_LINE.$11:
;  225          read (*, '(A)', advance='NO', eor=20, end=20, iostat=ios) rest
	PUSHAQ	FCSTATE.READ_LINE.$D1
	PUSHL	#-4
	PUSHAB	FCSTATE.READ_LINE.$IO1
	CALLS	#3,G^FTN$READ_SF
	PUSHAQ	FCSTATE.READ_LINE.$D3
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
	MOVL	R0,FCSTATE.READ_LINE.$T1
	MOVL	FCSTATE.READ_LINE.$T1,R6
	CMPL	FCSTATE.READ_LINE.$T1,#-2
	BEQL	FCSTATE.READ_LINE.$18
	TSTL	FCSTATE.READ_LINE.$T1
	BLSS	FCSTATE.READ_LINE.$20
;  226        end if
FCSTATE.READ_LINE.$17:
;  227        if (ios /= 0) return
	TSTL	R6
	BEQL	FCSTATE.READ_LINE.$22
	MOVL	R6,FCSTATE.READ_LINE.IOS
	RET
FCSTATE.READ_LINE.$22:
;  228      end do
	BRW	FCSTATE.READ_LINE.$10
;  229  10  if (length > len(text) - 1) status = 1
FCSTATE.READ_LINE.L10:
	MOVZWL	@FCSTATE.READ_LINE.TEXT(AP),R0
	DECL	R0
	CMPL	@FCSTATE.READ_LINE.LENGTH(AP),R0
	BLEQ	FCSTATE.READ_LINE.$24
	MOVL	#1,@FCSTATE.READ_LINE.STATUS(AP)
FCSTATE.READ_LINE.$24:
;  230  20  return
FCSTATE.READ_LINE.L20:
	RET
;  231  30  status = -1
FCSTATE.READ_LINE.L30:
	MOVL	#-1,@FCSTATE.READ_LINE.STATUS(AP)
;  232    end subroutine read_line
	RET
FCSTATE.READ_LINE.$18:			; leaving the loop
	MOVL	R6,FCSTATE.READ_LINE.IOS
	RET
FCSTATE.READ_LINE.$20:			; leaving the loop
	MOVL	R6,FCSTATE.READ_LINE.IOS
	RET
FCSTATE.READ_LINE.$13:			; leaving the loop
	MOVL	R6,FCSTATE.READ_LINE.IOS
	RET
FCSTATE.READ_LINE.$15:			; leaving the loop
	MOVL	R6,FCSTATE.READ_LINE.IOS
	RET

; Storage map for FCSTATE.NOW, a CHARACTER*19 function
;   TEXT  CHARACTER*19  hidden argument 1  @FCSTATE.NOW.TEXT(AP)
;   DATE  CHARACTER*8   $LOCAL+0           FCSTATE.NOW.DATE
;   TIME  CHARACTER*10  $LOCAL+8           FCSTATE.NOW.TIME
;
FCSTATE.NOW.TEXT = 4			; TEXT's value goes through hidden argument 1

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCSTATE.NOW.DATE:
	.BLKL	2			; DATE
FCSTATE.NOW.TIME:
	.BLKB	10			; TIME
	.BLKB	2
FCSTATE.NOW.$T1:
	.BLKB	19			; characters, for one statement
	.BLKB	1

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCSTATE.NOW.$D1:
	.WORD	8			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCSTATE.NOW.DATE
FCSTATE.NOW.$D2:
	.WORD	10			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCSTATE.NOW.TIME

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  233
;  234    ! NOW is the date and time, 2026-11-21 10:42:17, from the intrinsic
;  235    ! subroutine DATE_AND_TIME, whose DATE is CCYYMMDD and TIME hhmmss.sss.
;  236    function now() result(text)
	.ENTRY	FCSTATE.NOW,^M<R2,R3,R4,R5>
;  237      character(len=19) :: text
;  238      character(len=8) :: date
;  239      character(len=10) :: time
;  240
;  241      call date_and_time(date, time)
	PUSHL	#0
	PUSHL	#0
	PUSHAQ	FCSTATE.NOW.$D2
	PUSHAQ	FCSTATE.NOW.$D1
	CALLS	#4,G^FTN$DATE_AND_TIME
;  242      text = date(1:4) // '-' // date(5:6) // '-' // date(7:8) // ' ' // &
;  243        time(1:2) // ':' // time(3:4) // ':' // time(5:6)
	MOVC3	#4,FCSTATE.NOW.DATE,FCSTATE.NOW.$T1
	MOVB	#45,FCSTATE.NOW.$T1+4
	MOVC3	#2,FCSTATE.NOW.DATE+4,FCSTATE.NOW.$T1+5
	MOVB	#45,FCSTATE.NOW.$T1+7
	MOVC3	#2,FCSTATE.NOW.DATE+6,FCSTATE.NOW.$T1+8
	MOVB	#32,FCSTATE.NOW.$T1+10
	MOVC3	#2,FCSTATE.NOW.TIME,FCSTATE.NOW.$T1+11
	MOVB	#58,FCSTATE.NOW.$T1+13
	MOVC3	#2,FCSTATE.NOW.TIME+2,FCSTATE.NOW.$T1+14
	MOVB	#58,FCSTATE.NOW.$T1+16
	MOVC3	#2,FCSTATE.NOW.TIME+4,FCSTATE.NOW.$T1+17
	MOVL	FCSTATE.NOW.TEXT(AP),R0
	MOVC3	#19,FCSTATE.NOW.$T1,@4(R0)
;  244    end function now
	RET

; Storage map for FCSTATE.SAVE_STATE, a subroutine
;   NAME    CHARACTER*(*), INTENT(IN)  argument 1  @FCSTATE.SAVE_STATE.NAME(AP)
;   COLUMN  INTEGER, INTENT(IN)        argument 2  @FCSTATE.SAVE_STATE.COLUMN(AP)
;   K       INTEGER                    $LOCAL+0    FCSTATE.SAVE_STATE.K
;   IOS     INTEGER                    $LOCAL+4    FCSTATE.SAVE_STATE.IOS
;   R8 is $T1: temporary
;   R7 is $T4: temporary
;   R6 is $T5: temporary
;   R9 is $R1: an index stepped with K
;
FCSTATE.SAVE_STATE.NAME = 4		; NAME is argument 1
FCSTATE.SAVE_STATE.COLUMN = 8		; COLUMN is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCSTATE.SAVE_STATE.K:
	.BLKL	1			; K
FCSTATE.SAVE_STATE.IOS:
	.BLKL	1			; IOS
FCSTATE.SAVE_STATE.$D1:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used
FCSTATE.SAVE_STATE.$T2:
	.BLKB	19			; characters, for one statement
	.BLKB	1
FCSTATE.SAVE_STATE.$T3:
	.BLKL	10			; characters, for one statement
FCSTATE.SAVE_STATE.$D6:
	.WORD	8			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCSTATE.SAVE_STATE.$IO1:
	.WORD	8			; an I/O statement's control block: its size
	.WORD	^X0004			; flags: IOSTAT=
	.LONG	0			; (not used yet)
FCSTATE.SAVE_STATE.$K1:
	.LONG	47
FCSTATE.SAVE_STATE.$IO2:
	.WORD	8			; an I/O statement's control block: its size
	.WORD	^X0018			; flags: run-time format F90
	.LONG	0			; (not used yet)
FCSTATE.SAVE_STATE.$D2:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCSTATE.SAVE_STATE.$K2
FCSTATE.SAVE_STATE.$D3:
	.WORD	21			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCSTATE.SAVE_STATE.$K3
FCSTATE.SAVE_STATE.$D4:
	.WORD	19			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCSTATE.SAVE_STATE.$T2
FCSTATE.SAVE_STATE.$D5:
	.WORD	3			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCSTATE.SAVE_STATE.$K4
FCSTATE.SAVE_STATE.$K6:
	.LONG	0
FCSTATE.SAVE_STATE.$D7:
	.WORD	40			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCSTATE.SAVE_STATE.$T3
FCSTATE.SAVE_STATE.$IO3:
	.WORD	8			; an I/O statement's control block: its size
	.WORD	^X0000			; flags: none
	.LONG	0			; (not used yet)
FCSTATE.SAVE_STATE.$K2:
	.ASCII	/(2A)/
FCSTATE.SAVE_STATE.$K3:
	.ASCII	/! fcalc state, saved /
FCSTATE.SAVE_STATE.$K4:
	.ASCII	/(A)/
FCSTATE.SAVE_STATE.$K5:
	.ASCII	/digits  format  angle   base    seed    echo    /

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  245
;  246    ! ------------------------------------------------------------------
;  247    ! SAVE.
;  248
;  249    ! SAVE_STATE writes the state to the file NAME, replacing it: false after
;  250    ! an error at COLUMN. STATUS='REPLACE' makes a new file whether or not
;  251    ! there was one (on VMS, a new version of it), and ACTION='WRITE' opens it
;  252    ! only to write. Echo isn't saved: it is how a session is shown, not part
;  253    ! of what it computes.
;  254    subroutine save_state(name, column)
	.ENTRY	FCSTATE.SAVE_STATE,^M<R6,R7,R8,R9>
;  255      character(len=*), intent(in) :: name
;  256      integer, intent(in) :: column
;  257      integer :: k, ios
;  258
;  259      open (unit=save_file, file=name, status='REPLACE', action='WRITE', iostat=ios)
	MOVW	@FCSTATE.SAVE_STATE.NAME(AP),FCSTATE.SAVE_STATE.$D1
	MOVL	FCSTATE.SAVE_STATE.NAME(AP),R0
	MOVAB	@4(R0),FCSTATE.SAVE_STATE.$D1+4
	PUSHL	#2
	PUSHL	#1048
	PUSHL	#2
	PUSHL	#1074
	PUSHL	#5
	PUSHL	#1039
	PUSHAQ	FCSTATE.SAVE_STATE.$D1
	PUSHL	#1806
	PUSHL	#31
	PUSHAB	FCSTATE.SAVE_STATE.$IO1
	CALLS	#10,G^FTN$OPEN
	MOVL	R0,R8
	MOVL	R8,FCSTATE.SAVE_STATE.IOS
;  260      if (ios /= 0) then
	BEQL	FCSTATE.SAVE_STATE.$1
;  261        call fail(e_fileerr, column, name)
	PUSHL	FCSTATE.SAVE_STATE.NAME(AP)
	PUSHAL	@FCSTATE.SAVE_STATE.COLUMN(AP)
	PUSHAL	FCSTATE.SAVE_STATE.$K1
	CALLS	#3,G^FCMESSAGES.FAIL
;  262        return
	RET
FCSTATE.SAVE_STATE.$1:
;  263      end if
;  264
;  265      write (save_file, '(2A)') '! fcalc state, saved ', now()
	PUSHAQ	FCSTATE.SAVE_STATE.$D2
	PUSHL	#31
	PUSHAB	FCSTATE.SAVE_STATE.$IO2
	CALLS	#3,G^FTN$WRITE_SF
	PUSHAQ	FCSTATE.SAVE_STATE.$D3
	CALLS	#1,G^FTN$IO_ITEM
	PUSHAQ	FCSTATE.SAVE_STATE.$D4
	CALLS	#1,G^FCSTATE.NOW
	PUSHAQ	FCSTATE.SAVE_STATE.$D4
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;  266      do k = 1, size(setting_names) - 1
	MOVL	#1,FCSTATE.SAVE_STATE.K
	MULL3	FCSTATE.SAVE_STATE.K,#8,R9
FCSTATE.SAVE_STATE.$3:			; DO (line 266)'s body
;  267        write (save_file, '(A)') trim(setting_line(setting_names(k), .false.))
	PUSHAQ	FCSTATE.SAVE_STATE.$D5
	PUSHL	#31
	PUSHAB	FCSTATE.SAVE_STATE.$IO2
	CALLS	#3,G^FTN$WRITE_SF
	MOVAB	FCSTATE.SAVE_STATE.$K5-8[R9],FCSTATE.SAVE_STATE.$D6+4
	PUSHAL	FCSTATE.SAVE_STATE.$K6
	PUSHAQ	FCSTATE.SAVE_STATE.$D6
	PUSHAQ	FCSTATE.SAVE_STATE.$D7
	CALLS	#3,G^FCSTATE.SETTING_LINE
	MOVAB	FCSTATE.SAVE_STATE.$T3,R8
	MOVAB	(R8),R7
	MOVL	#40,R6
	BRB	FCSTATE.SAVE_STATE.$4
FCSTATE.SAVE_STATE.$5:
	CMPB	-1(R7)[R6],#32
	BNEQ	FCSTATE.SAVE_STATE.$6
	DECL	R6
FCSTATE.SAVE_STATE.$4:
	TSTL	R6			; from line 267
	BNEQ	FCSTATE.SAVE_STATE.$5
FCSTATE.SAVE_STATE.$6:
	CVTLW	R6,FCSTATE.SAVE_STATE.$D1
	MOVAB	(R8),FCSTATE.SAVE_STATE.$D1+4
	PUSHAQ	FCSTATE.SAVE_STATE.$D1
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;  268      end do
	ADDL2	#8,R9
	ACBL	#5,#1,FCSTATE.SAVE_STATE.K,FCSTATE.SAVE_STATE.$3
;  269
;  270      ! SAVE_VARIABLE and SAVE_FUNCTION are passed as arguments: FCSYMBOLS
;  271      ! calls them for each name in its trees.
;  272      call each_variable(save_variable)
	PUSHAB	G^FCSTATE.SAVE_VARIABLE
	CALLS	#1,G^FCSYMBOLS.EACH_VARIABLE
;  273      call each_function(save_function)
	PUSHAB	G^FCSTATE.SAVE_FUNCTION
	CALLS	#1,G^FCSYMBOLS.EACH_FUNCTION
;  274      close (save_file)
	PUSHL	#31
	PUSHAB	FCSTATE.SAVE_STATE.$IO3
	CALLS	#2,G^FTN$CLOSE
;  275    end subroutine save_state
	RET

; Storage map for FCSTATE.SAVE_FUNCTION, a subroutine
;   HEAD  CHARACTER*(*), INTENT(IN)  argument 1  @FCSTATE.SAVE_FUNCTION.HEAD(AP)
;   TEXT  CHARACTER*(*), INTENT(IN)  argument 2  @FCSTATE.SAVE_FUNCTION.TEXT(AP)
;   R7 is $U1: temporary
;   R6 is $U2: temporary
;   R8 is $U3: temporary
;
FCSTATE.SAVE_FUNCTION.HEAD = 4		; HEAD is argument 1
FCSTATE.SAVE_FUNCTION.TEXT = 8		; TEXT is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCSTATE.SAVE_FUNCTION.$D2:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_D
	.LONG	0			; set when the descriptor is used
FCSTATE.SAVE_FUNCTION.$T1:
	.BLKB	2			; temporary
	.BLKB	2
FCSTATE.SAVE_FUNCTION.$D3:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCSTATE.SAVE_FUNCTION.$IO1:
	.WORD	8			; an I/O statement's control block: its size
	.WORD	^X0018			; flags: run-time format F90
	.LONG	0			; (not used yet)
FCSTATE.SAVE_FUNCTION.$D1:
	.WORD	3			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCSTATE.SAVE_FUNCTION.$K1
FCSTATE.SAVE_FUNCTION.$K1:
	.ASCII	/(A)/
FCSTATE.SAVE_FUNCTION.$K2:
	.ASCII	/ = /

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  276
;  277    ! SAVE_FUNCTION writes a function's definition, f(x) = x^2;
;  278    subroutine save_function(head, text)
	.ENTRY	FCSTATE.SAVE_FUNCTION,^M<R2,R3,R4,R5,R6,R7,R8>
;  279      character(len=*), intent(in) :: head, text
;  280
;  281      write (save_file, '(A)') head // ' = ' // text // ';'
	PUSHAQ	FCSTATE.SAVE_FUNCTION.$D1
	PUSHL	#31
	PUSHAB	FCSTATE.SAVE_FUNCTION.$IO1
	CALLS	#3,G^FTN$WRITE_SF
	MOVZWL	@FCSTATE.SAVE_FUNCTION.HEAD(AP),R6
	MOVZWL	@FCSTATE.SAVE_FUNCTION.TEXT(AP),R8
	ADDL3	R6,R8,R7
	ADDL3	R7,#4,R0
	CVTLW	R0,FCSTATE.SAVE_FUNCTION.$T1
	PUSHAQ	FCSTATE.SAVE_FUNCTION.$D2
	PUSHAW	FCSTATE.SAVE_FUNCTION.$T1
	CALLS	#2,G^LIB$SGET1_DD
	MOVL	FCSTATE.SAVE_FUNCTION.HEAD(AP),R0
	MOVC3	R6,@4(R0),@FCSTATE.SAVE_FUNCTION.$D2+4
	MOVC3	#3,FCSTATE.SAVE_FUNCTION.$K2,@FCSTATE.SAVE_FUNCTION.$D2+4[R6]
	MOVL	FCSTATE.SAVE_FUNCTION.TEXT(AP),R0
	ADDL3	R6,#3,R1
	MOVC3	R8,@4(R0),@FCSTATE.SAVE_FUNCTION.$D2+4[R1]
	ADDL3	R7,#3,R0
	MOVB	#59,@FCSTATE.SAVE_FUNCTION.$D2+4[R0]
	ADDL3	R7,#4,R0
	CVTLW	R0,FCSTATE.SAVE_FUNCTION.$D3
	MOVAB	@FCSTATE.SAVE_FUNCTION.$D2+4,FCSTATE.SAVE_FUNCTION.$D3+4
	PUSHAQ	FCSTATE.SAVE_FUNCTION.$D3
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
	PUSHAQ	FCSTATE.SAVE_FUNCTION.$D2
	CALLS	#1,G^LIB$SFREE1_DD
;  282    end subroutine save_function
	RET

; Storage map for FCSTATE.SAVE_VARIABLE, a subroutine
;   NAME    CHARACTER*(*), INTENT(IN)   an argument  @FCSTATE.SAVE_VARIABLE.$A1
;   Q       TYPE(QUANTITY), INTENT(IN)  an argument  @FCSTATE.SAVE_VARIABLE.$A2
;   ITEMS   CHARACTER*100               $LOCAL+0     FCSTATE.SAVE_VARIABLE.ITEMS
;   ITEM    CHARACTER*60                $LOCAL+100   FCSTATE.SAVE_VARIABLE.ITEM
;   ROW     CHARACTER*12                $LOCAL+160   FCSTATE.SAVE_VARIABLE.ROW
;   FIRST   CHARACTER*12                $LOCAL+172   FCSTATE.SAVE_VARIABLE.FIRST
;   LAST    CHARACTER*12                $LOCAL+184   FCSTATE.SAVE_VARIABLE.LAST
;   I       INTEGER                     $LOCAL+196   FCSTATE.SAVE_VARIABLE.I
;   J       INTEGER                     $LOCAL+200   FCSTATE.SAVE_VARIABLE.J
;   K       INTEGER                     $LOCAL+204   FCSTATE.SAVE_VARIABLE.K
;   ROOM    INTEGER                     $LOCAL+208   FCSTATE.SAVE_VARIABLE.ROOM
;   FILLED  INTEGER                     $LOCAL+212   FCSTATE.SAVE_VARIABLE.FILLED
;   R6 is $T3: temporary
;   R7 is $T4: temporary
;   R8 is $R1: Q's address
;   R9 is $R2: NAME's address
;   FCSTATE.SAVE_VARIABLE.$N1 is FCSTATE.SAVE_VARIABLE.LITERAL_FITS
;

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
FCSTATE.SAVE_VARIABLE.ITEMS:
	.BLKL	25			; ITEMS
FCSTATE.SAVE_VARIABLE.ITEM:
	.BLKL	15			; ITEM
FCSTATE.SAVE_VARIABLE.ROW:
	.BLKL	3			; ROW
FCSTATE.SAVE_VARIABLE.FIRST:
	.BLKL	3			; FIRST
FCSTATE.SAVE_VARIABLE.LAST:
	.BLKL	3			; LAST
FCSTATE.SAVE_VARIABLE.I:
	.BLKL	1			; I
FCSTATE.SAVE_VARIABLE.J:
	.BLKL	1			; J
FCSTATE.SAVE_VARIABLE.K:
	.BLKL	1			; K
FCSTATE.SAVE_VARIABLE.ROOM:
	.BLKL	1			; ROOM
FCSTATE.SAVE_VARIABLE.FILLED:
	.BLKL	1			; FILLED
FCSTATE.SAVE_VARIABLE.$A1:
	.BLKL	1			; NAME's longword of the argument list, set at each entry point
FCSTATE.SAVE_VARIABLE.$A2:
	.BLKL	1			; Q's longword of the argument list, set at each entry point
FCSTATE.SAVE_VARIABLE.$T1:
	.BLKL	1			; temporary
FCSTATE.SAVE_VARIABLE.$T2:
	.BLKL	15			; characters, for one statement
FCSTATE.SAVE_VARIABLE.$D3:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_D
	.LONG	0			; set when the descriptor is used
FCSTATE.SAVE_VARIABLE.$T5:
	.BLKB	2			; temporary
	.BLKB	2
FCSTATE.SAVE_VARIABLE.$D4:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used
FCSTATE.SAVE_VARIABLE.$T6:
	.BLKL	3			; characters, for one statement
FCSTATE.SAVE_VARIABLE.$T7:
	.BLKL	3			; characters, for one statement
FCSTATE.SAVE_VARIABLE.$T8:
	.BLKL	1			; temporary
FCSTATE.SAVE_VARIABLE.$T9:
	.BLKL	1			; temporary
FCSTATE.SAVE_VARIABLE.$T10:
	.BLKL	1			; temporary
FCSTATE.SAVE_VARIABLE.$C1:
	.BLKL	1			; DO (line 307)'s count
FCSTATE.SAVE_VARIABLE.$T11:
	.BLKL	1			; temporary
FCSTATE.SAVE_VARIABLE.$T12:
	.BLKL	1			; temporary
FCSTATE.SAVE_VARIABLE.$T13:
	.BLKL	1			; temporary
FCSTATE.SAVE_VARIABLE.$T14:
	.BLKL	1			; temporary
FCSTATE.SAVE_VARIABLE.$U1:
	.BLKL	1			; temporary
FCSTATE.SAVE_VARIABLE.$U2:
	.BLKL	1			; temporary
FCSTATE.SAVE_VARIABLE.$U3:
	.BLKL	1			; temporary
FCSTATE.SAVE_VARIABLE.$U4:
	.BLKL	1			; temporary
FCSTATE.SAVE_VARIABLE.$U5:
	.BLKL	1			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCSTATE.SAVE_VARIABLE.$IO1:
	.WORD	8			; an I/O statement's control block: its size
	.WORD	^X0018			; flags: run-time format F90
	.LONG	0			; (not used yet)
FCSTATE.SAVE_VARIABLE.$D1:
	.WORD	3			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCSTATE.SAVE_VARIABLE.$K1
FCSTATE.SAVE_VARIABLE.$D2:
	.WORD	60			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCSTATE.SAVE_VARIABLE.$T2
FCSTATE.SAVE_VARIABLE.$D5:
	.WORD	12			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCSTATE.SAVE_VARIABLE.$T6
FCSTATE.SAVE_VARIABLE.$D6:
	.WORD	12			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCSTATE.SAVE_VARIABLE.$T7
FCSTATE.SAVE_VARIABLE.$K1:
	.ASCII	/(A)/
FCSTATE.SAVE_VARIABLE.$K2:
	.ASCII	/ = /
FCSTATE.SAVE_VARIABLE.$K4:
	.ASCII	/ = zeros(/
FCSTATE.SAVE_VARIABLE.$K5:
	.ASCII	/, /
FCSTATE.SAVE_VARIABLE.$K6:
	.ASCII	/);/
FCSTATE.SAVE_VARIABLE.$K7:
	.ASCII	/ /
FCSTATE.SAVE_VARIABLE.$K10:
	.ASCII	/) = [/
FCSTATE.SAVE_VARIABLE.$K11:
	.ASCII	/];/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  283
;  284    ! SAVE_VARIABLE writes NAME = value;. An array is a literal, [1, 2; 3, 4],
;  285    ! if it fits on a line; a larger one is made by zeros(rows, cols) and
;  286    ! given its elements a piece of a row at a time, m(2, 1:6) = [...], each
;  287    ! line at most SAVE_WIDTH characters.
;  288    subroutine save_variable(name, q)
	.ENTRY	FCSTATE.SAVE_VARIABLE,^M<R2,R3,R4,R5,R6,R7,R8,R9>
	MOVL	4(AP),FCSTATE.SAVE_VARIABLE.$A1 ; NAME is argument 1
	MOVL	8(AP),FCSTATE.SAVE_VARIABLE.$A2 ; Q is argument 2
;  289      character(len=*), intent(in) :: name
;  290      type(quantity), intent(in) :: q
;  291      character(len=save_width) :: items
;  292      character(len=60) :: item
;  293      character(len=12) :: row, first, last
;  294      integer :: i, j, k, room, filled
;  295
;  296      if (.not. is_array(q)) then
	PUSHAB	@FCSTATE.SAVE_VARIABLE.$A2
	CALLS	#1,G^FCARRAYS.IS_ARRAY
	MOVL	R0,FCSTATE.SAVE_VARIABLE.$T1
	BLBC	FCSTATE.SAVE_VARIABLE.$T1,FCSTATE.SAVE_VARIABLE.$2
	BRW	FCSTATE.SAVE_VARIABLE.$1
FCSTATE.SAVE_VARIABLE.$2:
;  297        write (save_file, '(A)') name // ' = ' // trim(complex_text(q%s%z)) // ';'
	PUSHAQ	FCSTATE.SAVE_VARIABLE.$D1
	PUSHL	#31
	PUSHAB	FCSTATE.SAVE_VARIABLE.$IO1
	CALLS	#3,G^FTN$WRITE_SF
	MOVL	FCSTATE.SAVE_VARIABLE.$A2,R0
	PUSHAO	16(R0)
	PUSHAQ	FCSTATE.SAVE_VARIABLE.$D2
	CALLS	#2,G^FCSTATE.COMPLEX_TEXT
	MOVAB	FCSTATE.SAVE_VARIABLE.$T2,FCSTATE.SAVE_VARIABLE.$T1
	MOVAB	@FCSTATE.SAVE_VARIABLE.$T1,R6
	MOVL	#60,R7
	BRB	FCSTATE.SAVE_VARIABLE.$3
FCSTATE.SAVE_VARIABLE.$4:
	CMPB	-1(R6)[R7],#32
	BNEQ	FCSTATE.SAVE_VARIABLE.$5
	DECL	R7
FCSTATE.SAVE_VARIABLE.$3:
	TSTL	R7			; from line 297
	BNEQ	FCSTATE.SAVE_VARIABLE.$4
FCSTATE.SAVE_VARIABLE.$5:
	MOVZWL	@FCSTATE.SAVE_VARIABLE.$A1,R0
	ADDL2	R7,R0
	ADDL2	#4,R0
	CVTLW	R0,FCSTATE.SAVE_VARIABLE.$T5
	PUSHAQ	FCSTATE.SAVE_VARIABLE.$D3
	PUSHAW	FCSTATE.SAVE_VARIABLE.$T5
	CALLS	#2,G^LIB$SGET1_DD
	MOVZWL	@FCSTATE.SAVE_VARIABLE.$A1,FCSTATE.SAVE_VARIABLE.$U1
	MOVL	FCSTATE.SAVE_VARIABLE.$A1,R0
	MOVC3	FCSTATE.SAVE_VARIABLE.$U1,@4(R0),@FCSTATE.SAVE_VARIABLE.$D3+4
	MOVL	FCSTATE.SAVE_VARIABLE.$U1,R0
	MOVC3	#3,FCSTATE.SAVE_VARIABLE.$K2,@FCSTATE.SAVE_VARIABLE.$D3+4[R0]
	ADDL3	FCSTATE.SAVE_VARIABLE.$U1,#3,R0
	MOVC3	R7,@FCSTATE.SAVE_VARIABLE.$T1,@FCSTATE.SAVE_VARIABLE.$D3+4[R0]
	ADDL3	FCSTATE.SAVE_VARIABLE.$U1,R7,R0
	ADDL2	#3,R0
	MOVB	#59,@FCSTATE.SAVE_VARIABLE.$D3+4[R0]
	ADDL3	FCSTATE.SAVE_VARIABLE.$U1,R7,R0
	ADDL2	#4,R0
	CVTLW	R0,FCSTATE.SAVE_VARIABLE.$D4
	MOVAB	@FCSTATE.SAVE_VARIABLE.$D3+4,FCSTATE.SAVE_VARIABLE.$D4+4
	PUSHAQ	FCSTATE.SAVE_VARIABLE.$D4
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
	PUSHAQ	FCSTATE.SAVE_VARIABLE.$D3
	CALLS	#1,G^LIB$SFREE1_DD
;  298        return
	RET
FCSTATE.SAVE_VARIABLE.$1:
;  299      end if
;  300
;  301      ! The whole literal, if it fits: ROOM is what's left for the elements
;  302      ! after NAME = [ and ];.
;  303      if (literal_fits()) return
	CALLS	#0,FCSTATE.SAVE_VARIABLE.$N1
	MOVL	R0,R7
	BLBC	R7,FCSTATE.SAVE_VARIABLE.$8
	RET
FCSTATE.SAVE_VARIABLE.$8:
;  304
;  305      write (save_file, '(A)') name // ' = zeros(' // trim(whole_text(q%rows)) // ', ' // &
;  306        trim(whole_text(q%cols)) // ');'
	PUSHAQ	FCSTATE.SAVE_VARIABLE.$D1
	PUSHL	#31
	PUSHAB	FCSTATE.SAVE_VARIABLE.$IO1
	CALLS	#3,G^FTN$WRITE_SF
	PUSHAL	@FCSTATE.SAVE_VARIABLE.$A2
	PUSHAQ	FCSTATE.SAVE_VARIABLE.$D5
	CALLS	#2,G^FCSTATE.WHOLE_TEXT
	MOVAB	FCSTATE.SAVE_VARIABLE.$T6,R7
	MOVAB	(R7),R6
	MOVL	#12,FCSTATE.SAVE_VARIABLE.$T1
	BRB	FCSTATE.SAVE_VARIABLE.$10
FCSTATE.SAVE_VARIABLE.$11:
	MOVL	FCSTATE.SAVE_VARIABLE.$T1,R0
	CMPB	-1(R6)[R0],#32
	BNEQ	FCSTATE.SAVE_VARIABLE.$12
	DECL	FCSTATE.SAVE_VARIABLE.$T1
FCSTATE.SAVE_VARIABLE.$10:
	TSTL	FCSTATE.SAVE_VARIABLE.$T1 ; from line 305
	BNEQ	FCSTATE.SAVE_VARIABLE.$11
