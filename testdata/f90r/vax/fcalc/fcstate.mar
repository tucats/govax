	.BLKB	2
FCSTATE.SAVE_VARIABLE.$N1.$D4:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used
FCSTATE.SAVE_VARIABLE.$N1.$U1:
	.BLKL	1			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCSTATE.SAVE_VARIABLE.$N1.$D1:
	.WORD	60			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCSTATE.SAVE_VARIABLE.$N1.$T1
FCSTATE.SAVE_VARIABLE.$N1.$IO1:
