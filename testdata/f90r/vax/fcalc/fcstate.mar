	CALLS	#1,G^LIB$SFREE1_DD
;  439      else if (n == 1) then
	BRW	FCSTATE.EXACT_TEXT.$42
FCSTATE.EXACT_TEXT.$43:
	CMPL	FCSTATE.EXACT_TEXT.N,#1
	BNEQ	FCSTATE.EXACT_TEXT.$48
;  440        text = d(1:1) // 'e' // exponent_text(ex)
	PUSHAL	FCSTATE.EXACT_TEXT.EX
	PUSHAQ	FCSTATE.EXACT_TEXT.$D17
	CALLS	#2,G^FCSTATE.EXPONENT_TEXT
	MOVB	FCSTATE.EXACT_TEXT.D,FCSTATE.EXACT_TEXT.$T9
	MOVB	#101,FCSTATE.EXACT_TEXT.$T9+1
	MOVC3	#13,FCSTATE.EXACT_TEXT.$T8,FCSTATE.EXACT_TEXT.$T9+2
	MOVL	FCSTATE.EXACT_TEXT.TEXT(AP),R0
	MOVC5	#15,FCSTATE.EXACT_TEXT.$T9,#^A/ /,#30,@4(R0)
;  441      else
	BRW	FCSTATE.EXACT_TEXT.$42
FCSTATE.EXACT_TEXT.$48:
;  442        text = d(1:1) // '.' // d(2:n) // 'e' // exponent_text(ex)
	SUBL3	#1,FCSTATE.EXACT_TEXT.N,FCSTATE.EXACT_TEXT.$T2
	BGEQ	FCSTATE.EXACT_TEXT.$50
	CLRL	FCSTATE.EXACT_TEXT.$T2
FCSTATE.EXACT_TEXT.$50:
	PUSHAL	FCSTATE.EXACT_TEXT.EX
	PUSHAQ	FCSTATE.EXACT_TEXT.$D17
	CALLS	#2,G^FCSTATE.EXPONENT_TEXT
	MOVB	FCSTATE.EXACT_TEXT.D,FCSTATE.EXACT_TEXT.$T10
	MOVB	#46,FCSTATE.EXACT_TEXT.$T10+1
	MOVC3	FCSTATE.EXACT_TEXT.$T2,FCSTATE.EXACT_TEXT.D+1,FCSTATE.EXACT_TEXT.$T10+2
	MOVL	FCSTATE.EXACT_TEXT.$T2,R0
	MOVB	#101,FCSTATE.EXACT_TEXT.$T10+2[R0]
	MOVL	FCSTATE.EXACT_TEXT.$T2,R0
	MOVC3	#13,FCSTATE.EXACT_TEXT.$T8,FCSTATE.EXACT_TEXT.$T10+3[R0]
	ADDL3	FCSTATE.EXACT_TEXT.$T2,#16,R0
	MOVL	FCSTATE.EXACT_TEXT.TEXT(AP),R1
	MOVC5	R0,FCSTATE.EXACT_TEXT.$T10,#^A/ /,#30,@4(R1)
;  443      end if
FCSTATE.EXACT_TEXT.$42:
;  444      if (x < 0) text = '-' // trim(text)
	TSTG	@FCSTATE.EXACT_TEXT.X(AP)
	BLSS	FCSTATE.EXACT_TEXT.$53
	RET
FCSTATE.EXACT_TEXT.$53:
	MOVL	FCSTATE.EXACT_TEXT.TEXT(AP),R0
	MOVAB	@4(R0),FCSTATE.EXACT_TEXT.$T2
	MOVAB	@FCSTATE.EXACT_TEXT.$T2,FCSTATE.EXACT_TEXT.$T1
	MOVL	#30,FCSTATE.EXACT_TEXT.$T11
	BRB	FCSTATE.EXACT_TEXT.$54
FCSTATE.EXACT_TEXT.$55:
	SUBL3	#1,FCSTATE.EXACT_TEXT.$T11,R0
	CMPB	@FCSTATE.EXACT_TEXT.$T1[R0],#32
	BNEQ	FCSTATE.EXACT_TEXT.$56
	DECL	FCSTATE.EXACT_TEXT.$T11
FCSTATE.EXACT_TEXT.$54:
	TSTL	FCSTATE.EXACT_TEXT.$T11	; from line 444
	BNEQ	FCSTATE.EXACT_TEXT.$55
FCSTATE.EXACT_TEXT.$56:
