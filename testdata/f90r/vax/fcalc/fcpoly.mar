;   Z       COMPLEX*16, INTENT(OUT) (:)  argument 2  @FCPOLY.DURAND_KERNER.Z(AP)
;   ERR     INTEGER, INTENT(INOUT)       argument 3  @FCPOLY.DURAND_KERNER.ERR(AP)
