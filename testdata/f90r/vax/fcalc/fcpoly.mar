	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  288
;  289    ! ------------------------------------------------------------------
;  290    ! From roots, and values.
;  291
;  292    ! POLYNOMIAL_OF is poly(r): the coefficients of (x - r1)(x - r2) ...,
;  293    ! a row, multiplied out one factor at a time. Multiplying c(1) x^k + ...
;  294    ! by (x - r) shifts each coefficient one place along and takes r times
;  295    ! its neighbor from it, which the loop does from the right, so each
;  296    ! neighbor is still the old one when it is used.
;  297    function polynomial_of(r) result(q)
	.ENTRY	FCPOLY.POLYNOMIAL_OF,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	CLRL	FCPOLY.POLYNOMIAL_OF.C+4
