FCPOLY.POLISHED.$T4:
	.BLKL	4			; temporary
FCPOLY.POLISHED.$T6:
	.BLKL	2			; temporary

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  245
;  246    ! POLISHED is Z after up to two of Newton's steps on the polynomial M,
;  247    ! each kept only if it makes |M(Z)| smaller. A step that fails (one too
;  248    ! large to take) leaves Z as it is: the root is already as good as the
;  249    ! iteration made it.
;  250    complex(rk) function polished(m, z)
	.ENTRY	FCPOLY.POLISHED,^M<R6,R7,R8,R9,R10,R11>
	MOVL	FCPOLY.POLISHED.M(AP),R0
	MOVL	4(R0),FCPOLY.POLISHED.$B1+4
	MOVL	FCPOLY.POLISHED.M(AP),R0
	CMPB	3(R0),#4
	BEQL	FCPOLY.POLISHED.$1
	MOVL	FCPOLY.POLISHED.M(AP),R0
	MOVL	20(R0),FCPOLY.POLISHED.$B1+20
	MOVL	FCPOLY.POLISHED.M(AP),R0
	MOVL	FCPOLY.POLISHED.M(AP),R1
	SUBL3	24(R1),28(R0),R0
	ADDL3	R0,#1,R8
	BRB	FCPOLY.POLISHED.$3
FCPOLY.POLISHED.$1:
	MOVL	#16,FCPOLY.POLISHED.$B1+20
	MOVL	FCPOLY.POLISHED.M(AP),R0
	MOVL	20(R0),R8
FCPOLY.POLISHED.$3:
	MOVL	#1,FCPOLY.POLISHED.$B1+24
	TSTL	R8
	BGEQ	FCPOLY.POLISHED.$4
	CLRL	R8
FCPOLY.POLISHED.$4:
	MOVL	R8,FCPOLY.POLISHED.$B1+28
	SUBL3	FCPOLY.POLISHED.$B1+20,FCPOLY.POLISHED.$B1+4,FCPOLY.POLISHED.$B1+16
	MULL3	#16,FCPOLY.POLISHED.$B1+28,FCPOLY.POLISHED.$B1+12
;  251      complex(rk), intent(in) :: m(:), z
;  252      complex(rk) :: p, dp, w, step
;  253      integer :: round, k, err
;  254
;  255      polished = z
	MOVO	@FCPOLY.POLISHED.Z(AP),@FCPOLY.POLISHED.POLISHED(AP)
;  256      err = 0
	CLRL	FCPOLY.POLISHED.ERR
;  257      do round = 1, 2
	MOVL	#1,FCPOLY.POLISHED.ROUND
	MOVL	FCPOLY.POLISHED.K,R6
	MOVL	FCPOLY.POLISHED.POLISHED(AP),R7
	MOVL	FCPOLY.POLISHED.ROUND,R9
FCPOLY.POLISHED.$6:			; DO (line 257)'s body
;  258        ! P and DP, M(Z) and its derivative, by Horner's rule together: the
;  259        ! derivative's sum gathers each partial sum of the value's.
;  260        p = m(1)
	ADDL3	FCPOLY.POLISHED.$B1+16,FCPOLY.POLISHED.$B1+20,R0
	MOVO	(R0),FCPOLY.POLISHED.P
;  261        dp = (0.0_rk, 0.0_rk)
	CLRO	FCPOLY.POLISHED.DP
;  262        do k = 2, size(m)
	MOVL	FCPOLY.POLISHED.$B1+28,R8
	BGEQ	FCPOLY.POLISHED.$7
	CLRL	R8
FCPOLY.POLISHED.$7:
	MOVL	#2,R6
	CMPL	#2,R8
	BLEQ	FCPOLY.POLISHED.$10
	BRW	FCPOLY.POLISHED.$9
FCPOLY.POLISHED.$10:
FCPOLY.POLISHED.$11:			; DO (line 262)'s body
;  263          dp = c_add(c_mul(dp, polished, err), p, err)
	PUSHAL	FCPOLY.POLISHED.ERR
	PUSHAO	(R7)
	PUSHAO	FCPOLY.POLISHED.DP
	PUSHAO	FCPOLY.POLISHED.$T4
	CALLS	#4,G^FCVALUES.C_MUL
	PUSHAL	FCPOLY.POLISHED.ERR
	PUSHAO	FCPOLY.POLISHED.P
	PUSHAO	FCPOLY.POLISHED.$T4
	PUSHAO	FCPOLY.POLISHED.$T3
	CALLS	#4,G^FCVALUES.C_ADD
	MOVO	FCPOLY.POLISHED.$T3,FCPOLY.POLISHED.DP
;  264          p = c_add(c_mul(p, polished, err), m(k), err)
	PUSHAL	FCPOLY.POLISHED.ERR
	PUSHAO	(R7)
	PUSHAO	FCPOLY.POLISHED.P
	PUSHAO	FCPOLY.POLISHED.$T3
	CALLS	#4,G^FCVALUES.C_MUL
	PUSHAL	FCPOLY.POLISHED.ERR
	MULL3	R6,FCPOLY.POLISHED.$B1+20,R0
	ADDL2	FCPOLY.POLISHED.$B1+16,R0
	PUSHAO	(R0)
	PUSHAO	FCPOLY.POLISHED.$T3
	PUSHAO	FCPOLY.POLISHED.$T4
	CALLS	#4,G^FCVALUES.C_ADD
	MOVO	FCPOLY.POLISHED.$T4,FCPOLY.POLISHED.P
;  265        end do
	ACBL	R8,#1,R6,FCPOLY.POLISHED.$11
FCPOLY.POLISHED.$9:
;  266        if (err /= 0 .or. dp == (0.0_rk, 0.0_rk) .or. p == (0.0_rk, 0.0_rk)) return
	TSTL	FCPOLY.POLISHED.ERR
	BNEQ	FCPOLY.POLISHED.$14
	TSTG	FCPOLY.POLISHED.DP
	BNEQ	FCPOLY.POLISHED.$16
	TSTG	FCPOLY.POLISHED.DP+8
	BEQL	FCPOLY.POLISHED.$14
FCPOLY.POLISHED.$16:
	TSTG	FCPOLY.POLISHED.P
	BNEQ	FCPOLY.POLISHED.$13
	TSTG	FCPOLY.POLISHED.P+8
	BNEQ	FCPOLY.POLISHED.$13
FCPOLY.POLISHED.$14:
	MOVL	R6,FCPOLY.POLISHED.K
	MOVL	R9,FCPOLY.POLISHED.ROUND
	RET
FCPOLY.POLISHED.$13:
;  267        step = c_div(p, dp, err)
	PUSHAL	FCPOLY.POLISHED.ERR
	PUSHAO	FCPOLY.POLISHED.DP
	PUSHAO	FCPOLY.POLISHED.P
	PUSHAO	FCPOLY.POLISHED.$T3
	CALLS	#4,G^FCVALUES.C_DIV
	MOVO	FCPOLY.POLISHED.$T3,FCPOLY.POLISHED.STEP
;  268        w = c_sub(polished, step, err)
	PUSHAL	FCPOLY.POLISHED.ERR
	PUSHAO	FCPOLY.POLISHED.STEP
	PUSHAO	(R7)
	PUSHAO	FCPOLY.POLISHED.$T3
	CALLS	#4,G^FCVALUES.C_SUB
	MOVO	FCPOLY.POLISHED.$T3,FCPOLY.POLISHED.W
;  269        if (err /= 0) return
	TSTL	FCPOLY.POLISHED.ERR
	BEQL	FCPOLY.POLISHED.$21
	MOVL	R6,FCPOLY.POLISHED.K
	MOVL	R9,FCPOLY.POLISHED.ROUND
	RET
FCPOLY.POLISHED.$21:
;  270        if (c_abs(horner(m, w, err)) >= c_abs(p) .or. err /= 0) return
	PUSHAL	FCPOLY.POLISHED.ERR
	PUSHAO	FCPOLY.POLISHED.W
	PUSHAQ	FCPOLY.POLISHED.$B1
	PUSHAO	FCPOLY.POLISHED.$T3
	CALLS	#4,G^FCPOLY.HORNER
	PUSHAO	FCPOLY.POLISHED.$T3
	CALLS	#1,G^FCVALUES.C_ABS
	MOVG	R0,R10
	PUSHAO	FCPOLY.POLISHED.P
	CALLS	#1,G^FCVALUES.C_ABS
	MOVG	R0,FCPOLY.POLISHED.$T6
	CMPG	R10,FCPOLY.POLISHED.$T6
	BGEQ	FCPOLY.POLISHED.$24
	TSTL	FCPOLY.POLISHED.ERR
	BEQL	FCPOLY.POLISHED.$23
FCPOLY.POLISHED.$24:
	MOVL	R6,FCPOLY.POLISHED.K
	MOVL	R9,FCPOLY.POLISHED.ROUND
	RET
FCPOLY.POLISHED.$23:
;  271        polished = w
	MOVO	FCPOLY.POLISHED.W,(R7)
;  272      end do
	ACBL	#2,#1,R9,FCPOLY.POLISHED.$6
	MOVL	R6,FCPOLY.POLISHED.K
	MOVL	R9,FCPOLY.POLISHED.ROUND
;  273    end function polished
	RET

