;   Z       COMPLEX*16 (?,1)            descriptor at $LOCAL+32  FCPOLY.ROOTS_COLUMN.Z
;   K       INTEGER                     $LOCAL+76                FCPOLY.ROOTS_COLUMN.K
;   N       INTEGER                     $LOCAL+80                FCPOLY.ROOTS_COLUMN.N
;   R11 is $T1: temporary
;   R6 is $I1: an array statement's loop index
;   R6 is $T2: temporary
;   R8 is $L1: DO (line 137)'s limit
;   R9 is $I2: an array statement's loop index
;   R7 is $L3: array (line 145), dimension 1's limit
;   R6 is $T6: temporary
;   R8 is $H1: a value computed before a loop
;   R7 is $R1: an index stepped with K
;   R10 is $R2: an index stepped with $I2
;   R6 is $R3: K, during a loop
;   R9 is $R4: ERR's address
;
FCPOLY.ROOTS_COLUMN.Q = 4		; Q's value goes through hidden argument 1
FCPOLY.ROOTS_COLUMN.A = 8		; A is argument 2
FCPOLY.ROOTS_COLUMN.DEGREE = 12		; DEGREE is argument 3
FCPOLY.ROOTS_COLUMN.ERR = 16		; ERR is argument 4

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCPOLY.ROOTS_COLUMN.M:
	.WORD	16			; length
	.BYTE	DSC$K_DTYPE_GC,DSC$K_CLASS_A
	.LONG	0			; M: not allocated
	.BYTE	0,0,^XE0,1		; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0			; multipliers
	.LONG	1,0			; bounds
FCPOLY.ROOTS_COLUMN.Z:
	.WORD	16			; length
	.BYTE	DSC$K_DTYPE_GC,DSC$K_CLASS_A
	.LONG	0			; Z: not allocated
	.BYTE	0,0,^XE0,2		; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0,1			; multipliers
	.LONG	1,0,1,1			; bounds
FCPOLY.ROOTS_COLUMN.K:
	.BLKL	1			; K
FCPOLY.ROOTS_COLUMN.N:
	.BLKL	1			; N
FCPOLY.ROOTS_COLUMN.$B1:
	.WORD	16			; length
	.BYTE	DSC$K_DTYPE_GC,DSC$K_CLASS_NCA
	.LONG	0			; A's bounds: set at each entry point
	.BYTE	0,0,0,1			; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0			; strides, in bytes
	.LONG	0,0			; bounds
FCPOLY.ROOTS_COLUMN.$T3:
	.BLKL	4			; temporary
FCPOLY.ROOTS_COLUMN.$T4:
	.BLKL	24			; characters, for one statement
FCPOLY.ROOTS_COLUMN.$T5:
	.BLKL	2			; temporary
FCPOLY.ROOTS_COLUMN.$D1:
	.WORD	16			; length
	.BYTE	DSC$K_DTYPE_GC,DSC$K_CLASS_NCA
	.LONG	0			; set when the descriptor is used
	.BYTE	0,0,0,1			; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0			; strides, in bytes
	.LONG	0,0			; bounds
FCPOLY.ROOTS_COLUMN.$D2:
	.WORD	16			; length
	.BYTE	DSC$K_DTYPE_GC,DSC$K_CLASS_NCA
	.LONG	0			; set when the descriptor is used
	.BYTE	0,0,0,1			; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0			; strides, in bytes
	.LONG	0,0			; bounds
FCPOLY.ROOTS_COLUMN.$D3:
