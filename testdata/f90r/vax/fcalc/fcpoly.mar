;   J       INTEGER                      $LOCAL+104  FCPOLY.DURAND_KERNER.J
;   N       INTEGER                      $LOCAL+108  FCPOLY.DURAND_KERNER.N
;   SWEEP   INTEGER                      $LOCAL+112  FCPOLY.DURAND_KERNER.SWEEP
;   STALE   INTEGER                      $LOCAL+116  FCPOLY.DURAND_KERNER.STALE
;   R6 is $T1: temporary
;   R9 is $L1: DO TERMS's limit
;   R7 is $T4: temporary
;   R8 is $L2: DO (line 189)'s limit
;   R11 is $L5: DO (line 202)'s limit
;   R8 is $L6: DO (line 241)'s limit
;   R10 is $H1: a value computed before a loop
;   R7 is $R1: an index stepped with J
;   R8 is $R2: an index stepped with I
;   R6 is $R3: an index stepped with I
;   R6 is $R4: an index stepped with I
;   R6 is $R5: J, during a loop
