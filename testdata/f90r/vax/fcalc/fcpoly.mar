	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCPOLY.ROOTS_COLUMN.$KF1:
	.LONG	^X00004010,^X00000000,^X00000000,^X00000000 ; (1D0, 0D0)

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  121
;  122    ! ROOTS_COLUMN: the DEGREE roots, as a column, of a polynomial whose
;  123    ! coefficients are A followed by zeros (taken off A already, so A(1) isn't
;  124    ! 0, nor is A's last): each such zero is a root at 0.
;  125    function roots_column(a, degree, err) result(q)
	.ENTRY	FCPOLY.ROOTS_COLUMN,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVL	FCPOLY.ROOTS_COLUMN.A(AP),R0
	MOVL	4(R0),FCPOLY.ROOTS_COLUMN.$B1+4
	MOVL	FCPOLY.ROOTS_COLUMN.A(AP),R0
	CMPB	3(R0),#4
	BEQL	FCPOLY.ROOTS_COLUMN.$1
	MOVL	FCPOLY.ROOTS_COLUMN.A(AP),R0
	MOVL	20(R0),FCPOLY.ROOTS_COLUMN.$B1+20
	MOVL	FCPOLY.ROOTS_COLUMN.A(AP),R0
	MOVL	FCPOLY.ROOTS_COLUMN.A(AP),R1
	SUBL3	24(R1),28(R0),R0
	ADDL3	R0,#1,R11
	BRB	FCPOLY.ROOTS_COLUMN.$3
FCPOLY.ROOTS_COLUMN.$1:
	MOVL	#16,FCPOLY.ROOTS_COLUMN.$B1+20
	MOVL	FCPOLY.ROOTS_COLUMN.A(AP),R0
	MOVL	20(R0),R11
FCPOLY.ROOTS_COLUMN.$3:
	MOVL	#1,FCPOLY.ROOTS_COLUMN.$B1+24
	TSTL	R11
	BGEQ	FCPOLY.ROOTS_COLUMN.$4
	CLRL	R11
FCPOLY.ROOTS_COLUMN.$4:
	MOVL	R11,FCPOLY.ROOTS_COLUMN.$B1+28
	SUBL3	FCPOLY.ROOTS_COLUMN.$B1+20,FCPOLY.ROOTS_COLUMN.$B1+4,FCPOLY.ROOTS_COLUMN.$B1+16
	MULL3	#16,FCPOLY.ROOTS_COLUMN.$B1+28,FCPOLY.ROOTS_COLUMN.$B1+12
	MOVL	FCPOLY.ROOTS_COLUMN.$B1+28,R11
	BGEQ	FCPOLY.ROOTS_COLUMN.$6
	CLRL	R11
FCPOLY.ROOTS_COLUMN.$6:
	MOVL	R11,R6
	MOVL	R6,FCPOLY.ROOTS_COLUMN.M+28
	MOVL	FCPOLY.ROOTS_COLUMN.M+28,FCPOLY.ROOTS_COLUMN.M+20
	BGEQ	FCPOLY.ROOTS_COLUMN.$8
	CLRL	FCPOLY.ROOTS_COLUMN.M+20
FCPOLY.ROOTS_COLUMN.$8:
	MULL3	#16,FCPOLY.ROOTS_COLUMN.M+20,FCPOLY.ROOTS_COLUMN.M+12
	SUBL2	FCPOLY.ROOTS_COLUMN.M+12,SP ; storage of a size known only now
	BICL2	#3,SP
	MOVL	SP,FCPOLY.ROOTS_COLUMN.M+4
	MOVL	FCPOLY.ROOTS_COLUMN.M+4,R0
	MOVAO	-16(R0),FCPOLY.ROOTS_COLUMN.M+16
	MOVL	@FCPOLY.ROOTS_COLUMN.DEGREE(AP),FCPOLY.ROOTS_COLUMN.Z+32
	MOVL	FCPOLY.ROOTS_COLUMN.Z+32,FCPOLY.ROOTS_COLUMN.Z+20
	BGEQ	FCPOLY.ROOTS_COLUMN.$10
	CLRL	FCPOLY.ROOTS_COLUMN.Z+20
FCPOLY.ROOTS_COLUMN.$10:
	MULL3	#16,FCPOLY.ROOTS_COLUMN.Z+20,FCPOLY.ROOTS_COLUMN.Z+12
	SUBL2	FCPOLY.ROOTS_COLUMN.Z+12,SP ; storage of a size known only now
	BICL2	#3,SP
	MOVL	SP,FCPOLY.ROOTS_COLUMN.Z+4
	MNEGL	FCPOLY.ROOTS_COLUMN.Z+20,R0
	DECL	R0
	MOVAO	@FCPOLY.ROOTS_COLUMN.Z+4[R0],FCPOLY.ROOTS_COLUMN.Z+16
;  126      complex(rk), intent(in) :: a(:)
;  127      integer, intent(in) :: degree
;  128      integer, intent(inout) :: err
;  129      type(quantity) :: q
;  130      complex(rk) :: m(size(a)), z(degree, 1)
;  131      integer :: k, n
;  132
;  133      ! M is A divided by its leading coefficient: monic, M(1) = 1. N, its
;  134      ! degree, is how many roots aren't 0.
;  135      n = size(a) - 1
	MOVL	FCPOLY.ROOTS_COLUMN.$B1+28,R6
	BGEQ	FCPOLY.ROOTS_COLUMN.$12
	CLRL	R6
FCPOLY.ROOTS_COLUMN.$12:
	MOVL	R6,R11
	SUBL3	#1,R11,FCPOLY.ROOTS_COLUMN.N
;  136      m(1) = (1.0_rk, 0.0_rk)
	MOVL	FCPOLY.ROOTS_COLUMN.M+16,R0
	MOVO	FCPOLY.ROOTS_COLUMN.$KF1,16(R0) ; (1D0, 0D0)
;  137      do k = 2, n + 1
	ADDL3	FCPOLY.ROOTS_COLUMN.N,#1,R8 ; DO (line 137)'s limit
	MOVL	#2,FCPOLY.ROOTS_COLUMN.K
	CMPL	#2,R8
	BGTR	FCPOLY.ROOTS_COLUMN.$14
	MULL3	FCPOLY.ROOTS_COLUMN.K,FCPOLY.ROOTS_COLUMN.$B1+20,R0
	ADDL3	FCPOLY.ROOTS_COLUMN.$B1+16,R0,R7
	MOVL	FCPOLY.ROOTS_COLUMN.K,R6
	MOVL	FCPOLY.ROOTS_COLUMN.ERR(AP),R9
FCPOLY.ROOTS_COLUMN.$16:		; DO (line 137)'s body
;  138        m(k) = c_div(a(k), a(1), err)
	PUSHAL	(R9)
	ADDL3	FCPOLY.ROOTS_COLUMN.$B1+16,FCPOLY.ROOTS_COLUMN.$B1+20,R0
	PUSHAO	(R0)
	PUSHAO	(R7)
	PUSHAO	FCPOLY.ROOTS_COLUMN.$T3
	CALLS	#4,G^FCVALUES.C_DIV
	MOVO	FCPOLY.ROOTS_COLUMN.$T3,@FCPOLY.ROOTS_COLUMN.M+16[R6]
;  139      end do
	ADDL2	FCPOLY.ROOTS_COLUMN.$B1+20,R7
	AOBLEQ	R8,R6,FCPOLY.ROOTS_COLUMN.$16
	MOVL	R6,FCPOLY.ROOTS_COLUMN.K
FCPOLY.ROOTS_COLUMN.$14:
;  140      if (err /= 0) then
	TSTL	@FCPOLY.ROOTS_COLUMN.ERR(AP)
	BEQL	FCPOLY.ROOTS_COLUMN.$18
;  141        q = failure(err)
	PUSHAL	@FCPOLY.ROOTS_COLUMN.ERR(AP)
	PUSHAB	FCPOLY.ROOTS_COLUMN.$T4
	CALLS	#2,G^FCARRAYS.FAILURE
	MOVC3	#96,FCPOLY.ROOTS_COLUMN.$T4,@FCPOLY.ROOTS_COLUMN.Q(AP)
;  142        return
	RET
FCPOLY.ROOTS_COLUMN.$18:
;  143      end if
;  144
;  145      z = (0.0_rk, 0.0_rk)
	MOVL	FCPOLY.ROOTS_COLUMN.Z+20,R11
	BGEQ	FCPOLY.ROOTS_COLUMN.$20
	CLRL	R11
FCPOLY.ROOTS_COLUMN.$20:
	MOVL	#1,R9
	MULL3	R9,FCPOLY.ROOTS_COLUMN.Z+20,R10
FCPOLY.ROOTS_COLUMN.$22:		; array (line 145), dimension 2's body
	MOVL	R11,R7			; array (line 145), dimension 1's limit
	MOVL	#1,R6
	CMPL	#1,R7
	BGTR	FCPOLY.ROOTS_COLUMN.$23
	MOVL	R10,R8			; from line 145
FCPOLY.ROOTS_COLUMN.$25:		; array (line 145), dimension 1's body
	ADDL3	R8,R6,R0
	CLRO	@FCPOLY.ROOTS_COLUMN.Z+16[R0]
	AOBLEQ	R7,R6,FCPOLY.ROOTS_COLUMN.$25
FCPOLY.ROOTS_COLUMN.$23:
	ADDL2	FCPOLY.ROOTS_COLUMN.Z+20,R10
	AOBLEQ	#1,R9,FCPOLY.ROOTS_COLUMN.$22
;  146      if (n == 1) then
	CMPL	FCPOLY.ROOTS_COLUMN.N,#1
	BNEQ	FCPOLY.ROOTS_COLUMN.$28
;  147        ! z + m(2) = 0: the root, exactly.
;  148        z(1, 1) = -m(2)
	MOVL	FCPOLY.ROOTS_COLUMN.M+16,R0
	MNEGG	32(R0),FCPOLY.ROOTS_COLUMN.$T5
	MOVL	FCPOLY.ROOTS_COLUMN.M+16,R0
	MULL3	FCPOLY.ROOTS_COLUMN.Z+20,#2,R1
	ADDL2	#3,R1
	MNEGG	40(R0),@FCPOLY.ROOTS_COLUMN.Z+16[R1]
	MULL3	FCPOLY.ROOTS_COLUMN.Z+20,#2,R0
	ADDL2	#2,R0
	MOVG	FCPOLY.ROOTS_COLUMN.$T5,@FCPOLY.ROOTS_COLUMN.Z+16[R0]
;  149      else if (n > 1) then
	BRW	FCPOLY.ROOTS_COLUMN.$30
FCPOLY.ROOTS_COLUMN.$28:
	CMPL	FCPOLY.ROOTS_COLUMN.N,#1
	BGTR	FCPOLY.ROOTS_COLUMN.$31
	BRW	FCPOLY.ROOTS_COLUMN.$30
FCPOLY.ROOTS_COLUMN.$31:
;  150        if (.not. durand_kerner(m, z(1:n, 1), err)) then
	MOVAO	@FCPOLY.ROOTS_COLUMN.M+4,FCPOLY.ROOTS_COLUMN.$D1+4
	MOVL	#16,FCPOLY.ROOTS_COLUMN.$D1+20
	MOVL	#1,FCPOLY.ROOTS_COLUMN.$D1+24
	MOVL	FCPOLY.ROOTS_COLUMN.M+28,FCPOLY.ROOTS_COLUMN.$D1+28
	SUBL3	#16,FCPOLY.ROOTS_COLUMN.$D1+4,FCPOLY.ROOTS_COLUMN.$D1+16
	MULL3	#16,FCPOLY.ROOTS_COLUMN.M+20,FCPOLY.ROOTS_COLUMN.$D1+12
	MOVL	FCPOLY.ROOTS_COLUMN.N,R6
	BGEQ	FCPOLY.ROOTS_COLUMN.$32
	CLRL	R6
FCPOLY.ROOTS_COLUMN.$32:
	ADDL3	FCPOLY.ROOTS_COLUMN.Z+20,#1,R0
	MOVAO	@FCPOLY.ROOTS_COLUMN.Z+16[R0],FCPOLY.ROOTS_COLUMN.$D2+4
	MOVL	#16,FCPOLY.ROOTS_COLUMN.$D2+20
	MOVL	#1,FCPOLY.ROOTS_COLUMN.$D2+24
	MOVL	R6,FCPOLY.ROOTS_COLUMN.$D2+28
	SUBL3	#16,FCPOLY.ROOTS_COLUMN.$D2+4,FCPOLY.ROOTS_COLUMN.$D2+16
	MULL3	#16,R6,FCPOLY.ROOTS_COLUMN.$D2+12
	PUSHAL	@FCPOLY.ROOTS_COLUMN.ERR(AP)
	PUSHAQ	FCPOLY.ROOTS_COLUMN.$D2
	PUSHAQ	FCPOLY.ROOTS_COLUMN.$D1
	CALLS	#3,G^FCPOLY.DURAND_KERNER
	MOVL	R0,R11
	BLBS	R11,FCPOLY.ROOTS_COLUMN.$34
;  151          if (err == 0) err = e_noroot
	TSTL	@FCPOLY.ROOTS_COLUMN.ERR(AP)
	BNEQ	FCPOLY.ROOTS_COLUMN.$36
	MOVL	#38,@FCPOLY.ROOTS_COLUMN.ERR(AP)
FCPOLY.ROOTS_COLUMN.$36:
;  152          q = failure(err)
	PUSHAL	@FCPOLY.ROOTS_COLUMN.ERR(AP)
	PUSHAB	FCPOLY.ROOTS_COLUMN.$T4
	CALLS	#2,G^FCARRAYS.FAILURE
	MOVC3	#96,FCPOLY.ROOTS_COLUMN.$T4,@FCPOLY.ROOTS_COLUMN.Q(AP)
;  153          return
	RET
FCPOLY.ROOTS_COLUMN.$34:
;  154        end if
;  155      end if
FCPOLY.ROOTS_COLUMN.$30:
;  156      ! Z(N+1:DEGREE) are the roots at zero, set above.
;  157      q = array_of(z)
	MOVAO	@FCPOLY.ROOTS_COLUMN.Z+4,FCPOLY.ROOTS_COLUMN.$D3+4
	MOVL	#16,FCPOLY.ROOTS_COLUMN.$D3+20
	MOVL	#1,FCPOLY.ROOTS_COLUMN.$D3+28
	MOVL	FCPOLY.ROOTS_COLUMN.Z+32,FCPOLY.ROOTS_COLUMN.$D3+32
	MULL3	#16,FCPOLY.ROOTS_COLUMN.Z+20,FCPOLY.ROOTS_COLUMN.$D3+24
	MOVL	#1,FCPOLY.ROOTS_COLUMN.$D3+36
	MOVL	#1,FCPOLY.ROOTS_COLUMN.$D3+40
	SUBL3	FCPOLY.ROOTS_COLUMN.$D3+24,FCPOLY.ROOTS_COLUMN.$D3+4,R0
	SUBL3	#16,R0,FCPOLY.ROOTS_COLUMN.$D3+16
	MULL3	#16,FCPOLY.ROOTS_COLUMN.Z+20,FCPOLY.ROOTS_COLUMN.$D3+12
	PUSHAQ	FCPOLY.ROOTS_COLUMN.$D3
	PUSHAB	FCPOLY.ROOTS_COLUMN.$T4
	CALLS	#2,G^FCARRAYS.ARRAY_OF
	MOVC3	#96,FCPOLY.ROOTS_COLUMN.$T4,@FCPOLY.ROOTS_COLUMN.Q(AP)
;  158    end function roots_column
	RET

; Storage map for FCPOLY.DURAND_KERNER, a LOGICAL function
