	.BLKL	1			; temporary
FCPOLY.DURAND_KERNER.$T3:
	.BLKL	4			; temporary
FCPOLY.DURAND_KERNER.$T5:
	.BLKL	2			; temporary
FCPOLY.DURAND_KERNER.$T6:
	.BLKL	2			; temporary
FCPOLY.DURAND_KERNER.$T7:
	.BLKL	2			; temporary
FCPOLY.DURAND_KERNER.$T8:
	.BLKL	2			; temporary
FCPOLY.DURAND_KERNER.$T9:
	.BLKL	4			; temporary
FCPOLY.DURAND_KERNER.$T10:
	.BLKL	4			; temporary
FCPOLY.DURAND_KERNER.$L4:
	.BLKL	1			; DO (line 199)'s limit

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCPOLY.DURAND_KERNER.$KF1:
	.LONG	^X00000000,^X00000000	; 0D0
FCPOLY.DURAND_KERNER.$KF2:
	.LONG	^X00004020,^X00000000	; 2D0
FCPOLY.DURAND_KERNER.$KF3:
	.LONG	^X21FB4039,^X2D185444	; 6.283185307179586D0
FCPOLY.DURAND_KERNER.$KF4:
	.LONG	^X99993FF9,^X999A9999	; 0.4D0
FCPOLY.DURAND_KERNER.$KF5:
	.LONG	^XFFFF7FFF,^XFFFFFFFF	; 8.988465674311579D307
FCPOLY.DURAND_KERNER.$KF6:
	.LONG	^X00004010,^X00000000,^X00000000,^X00000000 ; (1D0, 0D0)
FCPOLY.DURAND_KERNER.$KF7:
	.LONG	^X00003CF0,^X00000000	; 8.881784197001252D-16
FCPOLY.DURAND_KERNER.$KF8:
	.LONG	^X624D3F70,^XA9FCD2F1	; 0.001D0

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  159
;  160    ! DURAND_KERNER finds Z, the roots of the monic polynomial M of degree
;  161    ! SIZE(Z) (at least 2), none of them 0: false if the iteration doesn't
;  162    ! settle, or ERR if an operation fails.
;  163    logical function durand_kerner(m, z, err) result(ok)
	.ENTRY	FCPOLY.DURAND_KERNER,^M<R2,R3,R6,R7,R8,R9,R10,R11>
	MOVL	FCPOLY.DURAND_KERNER.M(AP),R0
	MOVL	4(R0),FCPOLY.DURAND_KERNER.$B1+4
	MOVL	FCPOLY.DURAND_KERNER.M(AP),R0
	CMPB	3(R0),#4
	BEQL	FCPOLY.DURAND_KERNER.$1
	MOVL	FCPOLY.DURAND_KERNER.M(AP),R0
	MOVL	20(R0),FCPOLY.DURAND_KERNER.$B1+20
	MOVL	FCPOLY.DURAND_KERNER.M(AP),R0
	MOVL	FCPOLY.DURAND_KERNER.M(AP),R1
	SUBL3	24(R1),28(R0),R0
	ADDL3	R0,#1,R6
	BRB	FCPOLY.DURAND_KERNER.$3
FCPOLY.DURAND_KERNER.$1:
	MOVL	#16,FCPOLY.DURAND_KERNER.$B1+20
	MOVL	FCPOLY.DURAND_KERNER.M(AP),R0
	MOVL	20(R0),R6
FCPOLY.DURAND_KERNER.$3:
	MOVL	#1,FCPOLY.DURAND_KERNER.$B1+24
	TSTL	R6
	BGEQ	FCPOLY.DURAND_KERNER.$4
	CLRL	R6
FCPOLY.DURAND_KERNER.$4:
	MOVL	R6,FCPOLY.DURAND_KERNER.$B1+28
	SUBL3	FCPOLY.DURAND_KERNER.$B1+20,FCPOLY.DURAND_KERNER.$B1+4,FCPOLY.DURAND_KERNER.$B1+16
	MULL3	#16,FCPOLY.DURAND_KERNER.$B1+28,FCPOLY.DURAND_KERNER.$B1+12
	MOVL	FCPOLY.DURAND_KERNER.Z(AP),R0
	MOVL	4(R0),FCPOLY.DURAND_KERNER.$B2+4
	MOVL	FCPOLY.DURAND_KERNER.Z(AP),R0
	CMPB	3(R0),#4
	BEQL	FCPOLY.DURAND_KERNER.$6
	MOVL	FCPOLY.DURAND_KERNER.Z(AP),R0
	MOVL	20(R0),FCPOLY.DURAND_KERNER.$B2+20
	MOVL	FCPOLY.DURAND_KERNER.Z(AP),R0
	MOVL	FCPOLY.DURAND_KERNER.Z(AP),R1
	SUBL3	24(R1),28(R0),R0
	ADDL3	R0,#1,R6
	BRB	FCPOLY.DURAND_KERNER.$8
FCPOLY.DURAND_KERNER.$6:
	MOVL	#16,FCPOLY.DURAND_KERNER.$B2+20
	MOVL	FCPOLY.DURAND_KERNER.Z(AP),R0
	MOVL	20(R0),R6
FCPOLY.DURAND_KERNER.$8:
	MOVL	#1,FCPOLY.DURAND_KERNER.$B2+24
	TSTL	R6
	BGEQ	FCPOLY.DURAND_KERNER.$9
	CLRL	R6
FCPOLY.DURAND_KERNER.$9:
	MOVL	R6,FCPOLY.DURAND_KERNER.$B2+28
	SUBL3	FCPOLY.DURAND_KERNER.$B2+20,FCPOLY.DURAND_KERNER.$B2+4,FCPOLY.DURAND_KERNER.$B2+16
	MULL3	#16,FCPOLY.DURAND_KERNER.$B2+28,FCPOLY.DURAND_KERNER.$B2+12
;  164      complex(rk), intent(in) :: m(:)
;  165      complex(rk), intent(out) :: z(:)
;  166      integer, intent(inout) :: err
;  167      complex(rk) :: num, den, delta, w
;  168      real(rk) :: radius, angle, moved, best
;  169      integer :: i, j, n, sweep, stale
;  170
;  171      ok = .false.
	CLRL	FCPOLY.DURAND_KERNER.OK
;  172      n = size(z)
	MOVL	FCPOLY.DURAND_KERNER.$B2+28,R6
	BGEQ	FCPOLY.DURAND_KERNER.$11
	CLRL	R6
FCPOLY.DURAND_KERNER.$11:
	MOVL	R6,FCPOLY.DURAND_KERNER.$T2
	MOVL	FCPOLY.DURAND_KERNER.$T2,FCPOLY.DURAND_KERNER.N
;  173
;  174      ! The circle the guesses start on: Fujiwara's bound, the largest of
;  175      ! |m(k+1)|^(1/k), with the last term halved, doubled. A power 1/k of
;  176      ! a magnitude is EXP(LOG(magnitude) / k), which can't overflow.
;  177      radius = 0
	CLRG	FCPOLY.DURAND_KERNER.RADIUS
;  178      terms: do j = 1, n
	MOVL	FCPOLY.DURAND_KERNER.N,R9 ; DO TERMS's limit
	MOVL	#1,FCPOLY.DURAND_KERNER.J
	CMPL	#1,R9
	BLEQ	FCPOLY.DURAND_KERNER.$14
	BRW	FCPOLY.DURAND_KERNER.$13
FCPOLY.DURAND_KERNER.$14:
	MOVL	FCPOLY.DURAND_KERNER.J,R6
	MOVQ	FCPOLY.DURAND_KERNER.RADIUS,R10
FCPOLY.DURAND_KERNER.$15:		; DO TERMS's body
;  179        w = m(j + 1)
	ADDL3	R6,#1,R0
	MULL2	FCPOLY.DURAND_KERNER.$B1+20,R0
	ADDL2	FCPOLY.DURAND_KERNER.$B1+16,R0
	MOVO	(R0),FCPOLY.DURAND_KERNER.W
;  180        if (j == n) w = w / 2
	CMPL	R6,FCPOLY.DURAND_KERNER.N
	BNEQ	FCPOLY.DURAND_KERNER.$16
	MOVQ	FCPOLY.DURAND_KERNER.$KF1,-(SP)
	MOVQ	FCPOLY.DURAND_KERNER.$KF2,-(SP)
	MOVQ	FCPOLY.DURAND_KERNER.W+8,-(SP)
	MOVQ	FCPOLY.DURAND_KERNER.W,-(SP)
	CALLS	#8,G^OTS$DIVCG_R3
	MOVO	R0,FCPOLY.DURAND_KERNER.$T3
	MOVG	FCPOLY.DURAND_KERNER.$T3,FCPOLY.DURAND_KERNER.W
	MOVG	FCPOLY.DURAND_KERNER.$T3+8,FCPOLY.DURAND_KERNER.W+8
FCPOLY.DURAND_KERNER.$16:
;  181        if (w == (0.0_rk, 0.0_rk)) cycle terms
	TSTG	FCPOLY.DURAND_KERNER.W
	BNEQ	FCPOLY.DURAND_KERNER.$19
	TSTG	FCPOLY.DURAND_KERNER.W+8
	BEQL	FCPOLY.DURAND_KERNER.$18
FCPOLY.DURAND_KERNER.$19:
;  182        radius = max(radius, exp(log(c_abs(w)) / j))
	MOVG	R10,R7
	PUSHAO	FCPOLY.DURAND_KERNER.W
	CALLS	#1,G^FCVALUES.C_ABS
	MOVG	R0,FCPOLY.DURAND_KERNER.$T7
	PUSHAG	FCPOLY.DURAND_KERNER.$T7
	CALLS	#1,G^MTH$GLOG
	MOVG	R0,FCPOLY.DURAND_KERNER.$T6
	CVTLG	R6,R0
	DIVG3	R0,FCPOLY.DURAND_KERNER.$T6,FCPOLY.DURAND_KERNER.$T8
	PUSHAG	FCPOLY.DURAND_KERNER.$T8
	CALLS	#1,G^MTH$GEXP
	MOVG	R0,FCPOLY.DURAND_KERNER.$T5
	CMPG	FCPOLY.DURAND_KERNER.$T5,R7
	BLEQ	FCPOLY.DURAND_KERNER.$22
	MOVG	FCPOLY.DURAND_KERNER.$T5,R7
FCPOLY.DURAND_KERNER.$22:
	MOVG	R7,R10
FCPOLY.DURAND_KERNER.$18:
;  183      end do terms
	ACBL	R9,#1,R6,FCPOLY.DURAND_KERNER.$15
	MOVL	R6,FCPOLY.DURAND_KERNER.J
	MOVQ	R10,FCPOLY.DURAND_KERNER.RADIUS
FCPOLY.DURAND_KERNER.$13:
;  184      radius = 2 * radius
	MULG2	S^#2.0,FCPOLY.DURAND_KERNER.RADIUS
;  185
;  186      ! The guesses: N points around the circle, the first at an angle of
;  187      ! 0.4 radians. (Complex arithmetic on parts no larger than RADIUS,
;  188      ! guarded, since a part of COS and SIN may be tiny.)
;  189      do i = 1, n
	MOVL	FCPOLY.DURAND_KERNER.N,R8 ; DO (line 189)'s limit
	MOVL	#1,FCPOLY.DURAND_KERNER.I
	CMPL	#1,R8
	BLEQ	FCPOLY.DURAND_KERNER.$26
	BRW	FCPOLY.DURAND_KERNER.$25
FCPOLY.DURAND_KERNER.$26:
	CVTLG	FCPOLY.DURAND_KERNER.N,R10 ; from line 190
	MULL3	FCPOLY.DURAND_KERNER.I,FCPOLY.DURAND_KERNER.$B2+20,R0
	ADDL3	FCPOLY.DURAND_KERNER.$B2+16,R0,R6
	MOVL	FCPOLY.DURAND_KERNER.I,R7
	MOVL	FCPOLY.DURAND_KERNER.ERR(AP),R9
FCPOLY.DURAND_KERNER.$27:		; DO (line 189)'s body
;  190        angle = 2 * pi * (i - 1) / n + 0.4_rk
	SUBL3	#1,R7,R0
	CVTLG	R0,R0
	MULG2	FCPOLY.DURAND_KERNER.$KF3,R0
	DIVG2	R10,R0
	ADDG3	R0,FCPOLY.DURAND_KERNER.$KF4,FCPOLY.DURAND_KERNER.ANGLE
;  191        z(i) = c_mul(cmplx(radius, 0.0_rk, rk), cmplx(cos(angle), sin(angle), rk), err)
	MOVG	FCPOLY.DURAND_KERNER.RADIUS,FCPOLY.DURAND_KERNER.$T9
	CLRG	FCPOLY.DURAND_KERNER.$T9+8
	PUSHAG	FCPOLY.DURAND_KERNER.ANGLE
	CALLS	#1,G^MTH$GCOS
	MOVG	R0,FCPOLY.DURAND_KERNER.$T8
	PUSHAG	FCPOLY.DURAND_KERNER.ANGLE
	CALLS	#1,G^MTH$GSIN
	MOVG	R0,FCPOLY.DURAND_KERNER.$T7
	MOVG	FCPOLY.DURAND_KERNER.$T8,FCPOLY.DURAND_KERNER.$T10
	MOVG	FCPOLY.DURAND_KERNER.$T7,FCPOLY.DURAND_KERNER.$T10+8
	PUSHAL	(R9)
	PUSHAO	FCPOLY.DURAND_KERNER.$T10
	PUSHAO	FCPOLY.DURAND_KERNER.$T9
	PUSHAO	FCPOLY.DURAND_KERNER.$T3
	CALLS	#4,G^FCVALUES.C_MUL
	MOVO	FCPOLY.DURAND_KERNER.$T3,(R6)
;  192      end do
	ADDL2	FCPOLY.DURAND_KERNER.$B2+20,R6
	ACBL	R8,#1,R7,FCPOLY.DURAND_KERNER.$27
	MOVL	R7,FCPOLY.DURAND_KERNER.I
FCPOLY.DURAND_KERNER.$25:
;  193
;  194      best = huge(1.0_rk)
	MOVG	FCPOLY.DURAND_KERNER.$KF5,FCPOLY.DURAND_KERNER.BEST ; 8.988465674311579D307
;  195      stale = 0
	CLRL	FCPOLY.DURAND_KERNER.STALE
;  196      do sweep = 1, sweep_limit
	MOVL	#1,FCPOLY.DURAND_KERNER.SWEEP
	MOVL	FCPOLY.DURAND_KERNER.I,R9
	MOVL	FCPOLY.DURAND_KERNER.ERR(AP),R10
FCPOLY.DURAND_KERNER.$29:		; DO (line 196)'s body
;  197        ! MOVED is the largest step a guess took, as a part of its size.
;  198        moved = 0
	CLRG	FCPOLY.DURAND_KERNER.MOVED
;  199        do i = 1, n
	MOVL	FCPOLY.DURAND_KERNER.N,FCPOLY.DURAND_KERNER.$L4 ; DO (line 199)'s limit
	MOVL	#1,R9
	CMPL	#1,FCPOLY.DURAND_KERNER.$L4
	BLEQ	FCPOLY.DURAND_KERNER.$31
	BRW	FCPOLY.DURAND_KERNER.$30
FCPOLY.DURAND_KERNER.$31:
	MULL3	R9,FCPOLY.DURAND_KERNER.$B2+20,R0
	ADDL3	FCPOLY.DURAND_KERNER.$B2+16,R0,R8
	MOVL	FCPOLY.DURAND_KERNER.J,R6
FCPOLY.DURAND_KERNER.$32:		; DO (line 199)'s body
;  200          num = horner(m, z(i), err)
	PUSHAL	(R10)
	PUSHAO	(R8)
	PUSHAQ	FCPOLY.DURAND_KERNER.$B1
	PUSHAO	FCPOLY.DURAND_KERNER.$T10
	CALLS	#4,G^FCPOLY.HORNER
	MOVO	FCPOLY.DURAND_KERNER.$T10,FCPOLY.DURAND_KERNER.NUM
;  201          den = (1.0_rk, 0.0_rk)
	MOVO	FCPOLY.DURAND_KERNER.$KF6,FCPOLY.DURAND_KERNER.DEN ; (1D0, 0D0)
;  202          do j = 1, n
	MOVL	FCPOLY.DURAND_KERNER.N,R11 ; DO (line 202)'s limit
	MOVL	#1,R6
	CMPL	#1,R11
	BGTR	FCPOLY.DURAND_KERNER.$33
	MULL3	R6,FCPOLY.DURAND_KERNER.$B2+20,R0
	ADDL3	FCPOLY.DURAND_KERNER.$B2+16,R0,R7
FCPOLY.DURAND_KERNER.$35:		; DO (line 202)'s body
;  203            if (j /= i) den = c_mul(den, c_sub(z(i), z(j), err), err)
	CMPL	R6,R9
	BEQL	FCPOLY.DURAND_KERNER.$36
	PUSHAL	(R10)
	PUSHAO	(R7)
	PUSHAO	(R8)
	PUSHAO	FCPOLY.DURAND_KERNER.$T9
	CALLS	#4,G^FCVALUES.C_SUB
	PUSHAL	(R10)
	PUSHAO	FCPOLY.DURAND_KERNER.$T9
	PUSHAO	FCPOLY.DURAND_KERNER.DEN
	PUSHAO	FCPOLY.DURAND_KERNER.$T10
	CALLS	#4,G^FCVALUES.C_MUL
	MOVO	FCPOLY.DURAND_KERNER.$T10,FCPOLY.DURAND_KERNER.DEN
FCPOLY.DURAND_KERNER.$36:
;  204          end do
	ADDL2	FCPOLY.DURAND_KERNER.$B2+20,R7
	AOBLEQ	R11,R6,FCPOLY.DURAND_KERNER.$35
FCPOLY.DURAND_KERNER.$33:
;  205          if (err /= 0) return
	TSTL	(R10)
	BEQL	FCPOLY.DURAND_KERNER.$39
	MOVL	R6,FCPOLY.DURAND_KERNER.J
	MOVL	R9,FCPOLY.DURAND_KERNER.I
	CLRL	R0			; the function's value
	RET
FCPOLY.DURAND_KERNER.$39:
;  206          ! Two guesses the same can't be told apart: leave this one.
;  207          if (den == (0.0_rk, 0.0_rk)) cycle
	TSTG	FCPOLY.DURAND_KERNER.DEN
	BNEQ	FCPOLY.DURAND_KERNER.$42
	TSTG	FCPOLY.DURAND_KERNER.DEN+8
	BNEQ	FCPOLY.DURAND_KERNER.$44
	BRW	FCPOLY.DURAND_KERNER.$41
FCPOLY.DURAND_KERNER.$44:
FCPOLY.DURAND_KERNER.$42:
;  208          delta = c_div(num, den, err)
	PUSHAL	(R10)
	PUSHAO	FCPOLY.DURAND_KERNER.DEN
	PUSHAO	FCPOLY.DURAND_KERNER.NUM
	PUSHAO	FCPOLY.DURAND_KERNER.$T9
	CALLS	#4,G^FCVALUES.C_DIV
	MOVO	FCPOLY.DURAND_KERNER.$T9,FCPOLY.DURAND_KERNER.DELTA
;  209          z(i) = c_sub(z(i), delta, err)
	PUSHAL	(R10)
	PUSHAO	FCPOLY.DURAND_KERNER.DELTA
	PUSHAO	(R8)
	PUSHAO	FCPOLY.DURAND_KERNER.$T9
	CALLS	#4,G^FCVALUES.C_SUB
	MOVO	FCPOLY.DURAND_KERNER.$T9,(R8)
;  210          if (err /= 0) return
	TSTL	(R10)
	BEQL	FCPOLY.DURAND_KERNER.$45
	MOVL	R6,FCPOLY.DURAND_KERNER.J
	MOVL	R9,FCPOLY.DURAND_KERNER.I
	CLRL	R0			; the function's value
	RET
FCPOLY.DURAND_KERNER.$45:
;  211          if (z(i) /= (0.0_rk, 0.0_rk)) then
	TSTG	(R8)
	BNEQ	FCPOLY.DURAND_KERNER.$48
	TSTG	8(R8)
	BEQL	FCPOLY.DURAND_KERNER.$47
FCPOLY.DURAND_KERNER.$48:
;  212            moved = max(moved, r_div(c_abs(delta), c_abs(z(i)), err))
	MOVG	FCPOLY.DURAND_KERNER.MOVED,FCPOLY.DURAND_KERNER.$T7
	PUSHAO	FCPOLY.DURAND_KERNER.DELTA
	CALLS	#1,G^FCVALUES.C_ABS
	MOVG	R0,FCPOLY.DURAND_KERNER.$T6
	PUSHAO	(R8)
	CALLS	#1,G^FCVALUES.C_ABS
	MOVG	R0,FCPOLY.DURAND_KERNER.$T5
	PUSHAL	(R10)
	PUSHAG	FCPOLY.DURAND_KERNER.$T5
	PUSHAG	FCPOLY.DURAND_KERNER.$T6
	CALLS	#3,G^FCVALUES.R_DIV
	MOVG	R0,FCPOLY.DURAND_KERNER.$T8
	CMPG	FCPOLY.DURAND_KERNER.$T8,FCPOLY.DURAND_KERNER.$T7
	BLEQ	FCPOLY.DURAND_KERNER.$51
	MOVG	FCPOLY.DURAND_KERNER.$T8,FCPOLY.DURAND_KERNER.$T7
FCPOLY.DURAND_KERNER.$51:
	MOVG	FCPOLY.DURAND_KERNER.$T7,FCPOLY.DURAND_KERNER.MOVED
;  213          else
	BRB	FCPOLY.DURAND_KERNER.$53
FCPOLY.DURAND_KERNER.$47:
;  214            moved = max(moved, c_abs(delta))
	MOVG	FCPOLY.DURAND_KERNER.MOVED,FCPOLY.DURAND_KERNER.$T5
	PUSHAO	FCPOLY.DURAND_KERNER.DELTA
	CALLS	#1,G^FCVALUES.C_ABS
	MOVG	R0,FCPOLY.DURAND_KERNER.$T6
	CMPG	FCPOLY.DURAND_KERNER.$T6,FCPOLY.DURAND_KERNER.$T5
	BLEQ	FCPOLY.DURAND_KERNER.$54
	MOVG	FCPOLY.DURAND_KERNER.$T6,FCPOLY.DURAND_KERNER.$T5
FCPOLY.DURAND_KERNER.$54:
	MOVG	FCPOLY.DURAND_KERNER.$T5,FCPOLY.DURAND_KERNER.MOVED
;  215          end if
FCPOLY.DURAND_KERNER.$53:
FCPOLY.DURAND_KERNER.$41:
;  216        end do
	ADDL2	FCPOLY.DURAND_KERNER.$B2+20,R8
	ACBL	FCPOLY.DURAND_KERNER.$L4,#1,R9,FCPOLY.DURAND_KERNER.$32
	MOVL	R6,FCPOLY.DURAND_KERNER.J
FCPOLY.DURAND_KERNER.$30:
;  217        if (err /= 0) return
	TSTL	(R10)
	BEQL	FCPOLY.DURAND_KERNER.$57
	MOVL	R9,FCPOLY.DURAND_KERNER.I
	CLRL	R0			; the function's value
	RET
FCPOLY.DURAND_KERNER.$57:
;  218
;  219        if (moved <= 4 * eps) then
	CMPG	FCPOLY.DURAND_KERNER.MOVED,FCPOLY.DURAND_KERNER.$KF7
	BGTR	FCPOLY.DURAND_KERNER.$59
	MOVL	R9,FCPOLY.DURAND_KERNER.I
;  220          ok = .true.
	MOVL	#-1,FCPOLY.DURAND_KERNER.OK
;  221          exit
	BRB	FCPOLY.DURAND_KERNER.$61
FCPOLY.DURAND_KERNER.$59:
;  222        end if
;  223
;  224        ! Near a multiple root the steps stop shrinking long before they
;  225        ! reach 4 EPS: rounding moves such a root back and forth. When the
;  226        ! best step hasn't improved for STALE_LIMIT sweeps, the roots are as
;  227        ! good as they will get, if the steps are small at all.
;  228        if (moved < best) then
	CMPG	FCPOLY.DURAND_KERNER.MOVED,FCPOLY.DURAND_KERNER.BEST
	BGEQ	FCPOLY.DURAND_KERNER.$62
;  229          best = moved
	MOVG	FCPOLY.DURAND_KERNER.MOVED,FCPOLY.DURAND_KERNER.BEST
;  230          stale = 0
	CLRL	FCPOLY.DURAND_KERNER.STALE
;  231        else
	BRB	FCPOLY.DURAND_KERNER.$64
FCPOLY.DURAND_KERNER.$62:
;  232          stale = stale + 1
;  233          if (stale >= stale_limit) then
	AOBLSS	#20,FCPOLY.DURAND_KERNER.STALE,FCPOLY.DURAND_KERNER.$65
	MOVL	R9,FCPOLY.DURAND_KERNER.I
;  234            ok = best <= 1.0e-3_rk
	CLRL	R0
	CMPG	FCPOLY.DURAND_KERNER.BEST,FCPOLY.DURAND_KERNER.$KF8
	BGTR	FCPOLY.DURAND_KERNER.$67
	MNEGL	#1,R0
FCPOLY.DURAND_KERNER.$67:
	MOVL	R0,FCPOLY.DURAND_KERNER.OK
;  235            exit
	BRB	FCPOLY.DURAND_KERNER.$61
FCPOLY.DURAND_KERNER.$65:
;  236          end if
;  237        end if
FCPOLY.DURAND_KERNER.$64:
;  238      end do
	ACBL	#500,#1,FCPOLY.DURAND_KERNER.SWEEP,FCPOLY.DURAND_KERNER.$29
	MOVL	R9,FCPOLY.DURAND_KERNER.I
FCPOLY.DURAND_KERNER.$61:
;  239      if (.not. ok) return
	BLBS	FCPOLY.DURAND_KERNER.OK,FCPOLY.DURAND_KERNER.$69
	MOVL	FCPOLY.DURAND_KERNER.OK,R0 ; the function's value
	RET
FCPOLY.DURAND_KERNER.$69:
