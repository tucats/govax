;  369
;  370    ! LIST_QUANTITY shows NAME = Q on one line, as LIST does: an array as the
;  371    ! literal that makes it, [1, 2; 3, 4], which may be longer than any line
;  372    ! variable could hold, so it is written a piece at a time (SAY_PART).
;  373    subroutine list_quantity(name, q)
	.ENTRY	FCARRAYS.LIST_QUANTITY,^M<R2,R3,R4,R5,R6,R7>
