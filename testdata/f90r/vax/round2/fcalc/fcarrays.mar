	ADDL3	FCARRAYS.SHOW_QUANTITY.$T3,#3,R0
	MOVC3	FCARRAYS.SHOW_QUANTITY.$T7,@FCARRAYS.SHOW_QUANTITY.$T5,@FCARRAYS.SHOW_QUANTITY.$D2+4[R0]
	CVTLW	FCARRAYS.SHOW_QUANTITY.$U1,FCARRAYS.SHOW_QUANTITY.$D3
	MOVAB	@FCARRAYS.SHOW_QUANTITY.$D2+4,FCARRAYS.SHOW_QUANTITY.$D3+4
	PUSHAQ	FCARRAYS.SHOW_QUANTITY.$D3
	CALLS	#1,G^FCMESSAGES.SAY
	PUSHAQ	FCARRAYS.SHOW_QUANTITY.$D2
	CALLS	#1,G^LIB$SFREE1_DD
;  311        else
	RET
FCARRAYS.SHOW_QUANTITY.$10:
;  312          call say(trim(format_value(q%s)))
	PUSHL	#0
	MOVL	FCARRAYS.SHOW_QUANTITY.Q(AP),R0
