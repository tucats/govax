	PUSHAB	FCARRAYS.ELEMENT_AT.$T1
	CALLS	#4,G^FCARRAYS.ELEMENT
	MOVC3	#32,FCARRAYS.ELEMENT_AT.$T1,@FCARRAYS.ELEMENT_AT.V(AP)
;  253    end function element_at
