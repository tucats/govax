;  301      character(len=*), intent(in) :: name
;  302      integer :: width(q%cols)
;  303      character(len=line_width) :: line
;  304      character(len=120) :: text
;  305      real(rk) :: big
;  306      integer :: i, j, first, last, used
;  307
;  308      if (.not. is_array(q)) then
	PUSHAB	@FCARRAYS.SHOW_QUANTITY.Q(AP)
	CALLS	#1,G^FCARRAYS.IS_ARRAY
	MOVL	R0,R6
	BLBC	R6,FCARRAYS.SHOW_QUANTITY.$4
	BRW	FCARRAYS.SHOW_QUANTITY.$3
FCARRAYS.SHOW_QUANTITY.$4:
;  309        if (len_trim(name) > 0) then
	MOVL	FCARRAYS.SHOW_QUANTITY.NAME(AP),R0
	MOVAB	@4(R0),R6
	MOVZWL	@FCARRAYS.SHOW_QUANTITY.NAME(AP),FCARRAYS.SHOW_QUANTITY.$T2
	BRB	FCARRAYS.SHOW_QUANTITY.$5
