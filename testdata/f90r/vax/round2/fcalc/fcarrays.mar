;   71
;   72    ! ------------------------------------------------------------------
;   73    ! Making and releasing quantities.
;   74
;   75    ! SCALAR_QUANTITY is the scalar V as a quantity. Its pointer is
;   76    ! nullified, so the quantity is defined in every part: a pointer that is
;   77    ! neither associated nor nullified is undefined, and copying an undefined
;   78    ! pointer is undefined too.
;   79    function scalar_quantity(v) result(q)
	.ENTRY	FCARRAYS.SCALAR_QUANTITY,^M<R2,R3,R4,R5,R6>
;   80      type(value), intent(in) :: v
;   81      type(quantity) :: q
;   82
;   83      q%rows = 1
	MOVL	#1,@FCARRAYS.SCALAR_QUANTITY.Q(AP)
;   84      q%cols = 1
	MOVL	FCARRAYS.SCALAR_QUANTITY.Q(AP),R0
	MOVL	#1,4(R0)
;   85      q%s = v
	MOVL	FCARRAYS.SCALAR_QUANTITY.Q(AP),R0
	MOVC3	#32,@FCARRAYS.SCALAR_QUANTITY.V(AP),16(R0)
;   86      nullify (q%e)
	MOVL	FCARRAYS.SCALAR_QUANTITY.Q(AP),R0
	MOVAL	48(R0),R6
	CLRL	4(R6)
;   87    end function scalar_quantity
	RET

