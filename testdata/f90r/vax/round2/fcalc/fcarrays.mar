	CMPG	FCARRAYS.LARGEST_MAGNITUDE.$T3,R8
	BLEQ	FCARRAYS.LARGEST_MAGNITUDE.$9
	MOVG	FCARRAYS.LARGEST_MAGNITUDE.$T3,R8
FCARRAYS.LARGEST_MAGNITUDE.$9:
	MOVG	R8,FCARRAYS.LARGEST_MAGNITUDE.$N4
;  283        end do
	AOBLEQ	R10,FCARRAYS.LARGEST_MAGNITUDE.I,FCARRAYS.LARGEST_MAGNITUDE.$8
FCARRAYS.LARGEST_MAGNITUDE.$6:
;  284      end do
	ACBL	R11,#1,FCARRAYS.LARGEST_MAGNITUDE.J,FCARRAYS.LARGEST_MAGNITUDE.$5
FCARRAYS.LARGEST_MAGNITUDE.$3:
;  285    end function largest_magnitude
	MOVG	FCARRAYS.LARGEST_MAGNITUDE.$N4,R0 ; the function's value
	RET

