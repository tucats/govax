; Storage map for FCARRAYS.COLUMNS_HEADING, a CHARACTER*40 function
;   TEXT   CHARACTER*40         hidden argument 1  @FCARRAYS.COLUMNS_HEADING.TEXT(AP)
;   FIRST  INTEGER, INTENT(IN)  argument 2         @FCARRAYS.COLUMNS_HEADING.FIRST(AP)
;   LAST   INTEGER, INTENT(IN)  argument 3         @FCARRAYS.COLUMNS_HEADING.LAST(AP)
;   A      CHARACTER*12         $LOCAL+0           FCARRAYS.COLUMNS_HEADING.A
;   B      CHARACTER*12         $LOCAL+12          FCARRAYS.COLUMNS_HEADING.B
;   R6 is $T2: temporary
;   R8 is $T3: temporary
;   R7 is $T4: temporary
;
FCARRAYS.COLUMNS_HEADING.TEXT = 4	; TEXT's value goes through hidden argument 1
FCARRAYS.COLUMNS_HEADING.FIRST = 8	; FIRST is argument 2
FCARRAYS.COLUMNS_HEADING.LAST = 12	; LAST is argument 3

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCARRAYS.COLUMNS_HEADING.A:
	.BLKL	3			; A
FCARRAYS.COLUMNS_HEADING.B:
	.BLKL	3			; B
FCARRAYS.COLUMNS_HEADING.$D3:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_L,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used
FCARRAYS.COLUMNS_HEADING.$T1:
	.BLKL	3			; characters, for one statement
FCARRAYS.COLUMNS_HEADING.$D6:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_D
	.LONG	0			; set when the descriptor is used
FCARRAYS.COLUMNS_HEADING.$T5:
	.BLKB	2			; temporary
	.BLKB	2
FCARRAYS.COLUMNS_HEADING.$T6:
	.BLKL	3			; characters, for one statement
FCARRAYS.COLUMNS_HEADING.$T7:
	.BLKL	1			; temporary
FCARRAYS.COLUMNS_HEADING.$T8:
	.BLKL	1			; temporary
FCARRAYS.COLUMNS_HEADING.$T9:
	.BLKL	1			; temporary
FCARRAYS.COLUMNS_HEADING.$U1:
	.BLKL	1			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCARRAYS.COLUMNS_HEADING.$IO1:
	.WORD	8			; an I/O statement's control block: its size
	.WORD	^X0018			; flags: run-time format F90
	.LONG	0			; (not used yet)
FCARRAYS.COLUMNS_HEADING.$D1:
	.WORD	12			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCARRAYS.COLUMNS_HEADING.A
FCARRAYS.COLUMNS_HEADING.$D2:
