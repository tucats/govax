	CMPB	-1(R6)[R0],#32
	BNEQ	FCARRAYS.SHOW_QUANTITY.$7
	DECL	FCARRAYS.SHOW_QUANTITY.$T2
FCARRAYS.SHOW_QUANTITY.$5:
	TSTL	FCARRAYS.SHOW_QUANTITY.$T2 ; from line 309
	BNEQ	FCARRAYS.SHOW_QUANTITY.$6
FCARRAYS.SHOW_QUANTITY.$7:
	TSTL	FCARRAYS.SHOW_QUANTITY.$T2
	BGTR	FCARRAYS.SHOW_QUANTITY.$11
	BRW	FCARRAYS.SHOW_QUANTITY.$10
FCARRAYS.SHOW_QUANTITY.$11:
;  310          call say(trim(name) // ' = ' // trim(format_value(q%s)))
	MOVL	FCARRAYS.SHOW_QUANTITY.NAME(AP),R0
	MOVAB	@4(R0),FCARRAYS.SHOW_QUANTITY.$T2
	MOVAB	@FCARRAYS.SHOW_QUANTITY.$T2,R6
	MOVZWL	@FCARRAYS.SHOW_QUANTITY.NAME(AP),FCARRAYS.SHOW_QUANTITY.$T3
	BRB	FCARRAYS.SHOW_QUANTITY.$12
FCARRAYS.SHOW_QUANTITY.$13:
	MOVL	FCARRAYS.SHOW_QUANTITY.$T3,R0
	CMPB	-1(R6)[R0],#32
	BNEQ	FCARRAYS.SHOW_QUANTITY.$14
	DECL	FCARRAYS.SHOW_QUANTITY.$T3
FCARRAYS.SHOW_QUANTITY.$12:
	TSTL	FCARRAYS.SHOW_QUANTITY.$T3 ; from line 310
	BNEQ	FCARRAYS.SHOW_QUANTITY.$13
FCARRAYS.SHOW_QUANTITY.$14:
	PUSHL	#0
	MOVL	FCARRAYS.SHOW_QUANTITY.Q(AP),R0
	PUSHAB	16(R0)
	PUSHAQ	FCARRAYS.SHOW_QUANTITY.$D1
	CALLS	#3,G^FCVALUES.FORMAT_VALUE
	MOVAB	FCARRAYS.SHOW_QUANTITY.$T4,FCARRAYS.SHOW_QUANTITY.$T5
