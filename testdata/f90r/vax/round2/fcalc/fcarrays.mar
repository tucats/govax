	BRB	FCARRAYS.SHOW_QUANTITY.$17
FCARRAYS.SHOW_QUANTITY.$18:
	SUBL3	#1,FCARRAYS.SHOW_QUANTITY.$T7,R0
	CMPB	@FCARRAYS.SHOW_QUANTITY.$T6[R0],#32
	BNEQ	FCARRAYS.SHOW_QUANTITY.$19
	DECL	FCARRAYS.SHOW_QUANTITY.$T7
FCARRAYS.SHOW_QUANTITY.$17:
	TSTL	FCARRAYS.SHOW_QUANTITY.$T7 ; from line 310
	BNEQ	FCARRAYS.SHOW_QUANTITY.$18
FCARRAYS.SHOW_QUANTITY.$19:
