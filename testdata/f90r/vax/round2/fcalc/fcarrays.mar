;  286
;  287    ! ------------------------------------------------------------------
;  288    ! Showing quantities.
;  289
;  290    ! SHOW_QUANTITY shows Q: a scalar as a value, after NAME = if NAME isn't
;  291    ! blank; an array after a line NAME = (if NAME isn't blank), a line for
;  292    ! each row, the columns lined up at the right. Each element is shown
;  293    ! beside the largest, so a part smaller than it by more than the digits
;  294    ! shown is shown as 0: the last bits a computation leaves (1E-17 beside
;  295    ! 1) differ between machines, and the digits can't show them anyway.
;  296    !
;  297    ! A row longer than a line is shown in groups of columns, each group
;  298    ! under a heading naming its columns.
;  299    subroutine show_quantity(q, name)
	.ENTRY	FCARRAYS.SHOW_QUANTITY,^M<R2,R3,R4,R5,R6,R7,R8>
	MOVL	FCARRAYS.SHOW_QUANTITY.Q(AP),R0
	MOVL	4(R0),FCARRAYS.SHOW_QUANTITY.WIDTH+28
	MOVL	FCARRAYS.SHOW_QUANTITY.WIDTH+28,FCARRAYS.SHOW_QUANTITY.WIDTH+20
	BGEQ	FCARRAYS.SHOW_QUANTITY.$1
	CLRL	FCARRAYS.SHOW_QUANTITY.WIDTH+20
FCARRAYS.SHOW_QUANTITY.$1:
