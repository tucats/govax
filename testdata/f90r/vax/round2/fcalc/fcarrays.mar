;    1  ! fcalc: quantities, the values the evaluator deals in: a scalar, or a
;    2  ! vector or matrix of complex numbers.
;    3  !
;    4  ! A QUANTITY is a VALUE (module FCVALUES) when it is a scalar, and an array
;    5  ! of ROWS by COLS complex elements when it is not; a vector is an array with
;    6  ! one row or one column. An array has at least two elements: an operation
;    7  ! whose result would have one gives a scalar instead, so [5] is 5 and a
;    8  ! row times a column is a number.
;    9  !
;   10  ! The elements live in storage of their own, reached through a POINTER
;   11  ! component, E. Fortran 90 has no allocatable components (they came in
;   12  ! Fortran 2003), so a derived type that holds an array whose size is known
;   13  ! only when the program runs holds a pointer to it, ALLOCATEd when it is
;   14  ! made. And Fortran 90 has no destructors either: nothing frees that
;   15  ! storage when a QUANTITY goes out of use, so fcalc keeps a rule of
;   16  ! ownership, the way a C program does:
;   17  !
;   18  ! - Every function that makes a quantity gives it storage of its own. The
;   19  !   caller owns it, and must either RELEASE it or pass it on to an owner.
;   20  ! - Assignment (A = B) copies the pointer, not the elements: afterwards A
;   21  !   and B share storage, and only one of them may be released. fcalc uses
;   22  !   it only to move a quantity from one owner to another (as SET_VARIABLE
;   23  !   takes the quantity it is given).
;   24  ! - DUPLICATE makes a copy with storage of its own, when two owners are
;   25  !   wanted (FIND_VARIABLE gives the caller a copy of the variable's value).
;   26  !
;   27  ! A defined ASSIGNMENT(=) that copied the elements would seem safer, but it
;   28  ! would leak: the result of a function, F(X) on A = F(X)'s right, is itself
;   29  ! a quantity with storage, which a copying assignment would copy and then
;   30  ! drop. Fortran 95 added nothing here; Fortran 2003's allocatable
;   31  ! components and FINAL procedures are the cure.
;   32  !
;   33  ! The module counts the arrays it has made and not yet released, so a leak
;   34  ! shows: SHOW MEMORY reports the count, and the test scripts check it is 0
;   35  ! once they have cleared their variables.
;   36  !
;   37  ! A quantity's error is its scalar's: an array operation that fails gives a
;   38  ! scalar quantity with the error set, as a scalar operation does.
;   39  module fcarrays
;   40    use fckinds
;   41    use fcmessages
;   42    use fcvalues
;   43    implicit none
;   44    private
;   45
;   46    public :: value, quantity
;   47    public :: scalar_quantity, real_quantity, failure, new_array, array_of
;   48    public :: release, duplicate, is_array, is_vector, element, element_at
;   49    public :: numel, same_shape, quantity_error, quantity_truth, elements_of
;   50    public :: arrays_in_use, largest_magnitude, show_quantity, list_quantity
;   51    public :: max_elements
;   52
;   53    type quantity
;   54      integer :: rows
;   55      integer :: cols
;   56      type(value) :: s
;   57      complex(rk), pointer :: e(:, :)
;   58    end type quantity
;   59
;   60    ! The most elements an array may have.
;   61    integer, parameter :: max_elements = 10000
;   62
;   63    ! The arrays made and not yet released.
;   64    integer, save :: in_use = 0
;   65
;   66    ! The longest line a matrix is shown in: a line's columns past it go in
;   67    ! a group of their own.
;   68    integer, parameter :: line_width = 132
;   69
;   70  contains

