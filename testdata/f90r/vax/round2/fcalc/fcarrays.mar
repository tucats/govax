;  269
;  270    ! LARGEST_MAGNITUDE is the largest of Q's elements' magnitudes.
;  271    real(rk) function largest_magnitude(q)
	.ENTRY	FCARRAYS.LARGEST_MAGNITUDE,^M<R6,R7,R8,R9,R10,R11>
;  272      type(quantity), intent(in) :: q
;  273      integer :: i, j
;  274
;  275      if (.not. is_array(q)) then
	PUSHAB	@FCARRAYS.LARGEST_MAGNITUDE.Q(AP)
	CALLS	#1,G^FCARRAYS.IS_ARRAY
	MOVL	R0,R6
	BLBS	R6,FCARRAYS.LARGEST_MAGNITUDE.$1
;  276        largest_magnitude = c_abs(q%s%z)
	MOVL	FCARRAYS.LARGEST_MAGNITUDE.Q(AP),R0
	PUSHAO	16(R0)
	CALLS	#1,G^FCVALUES.C_ABS
	MOVG	R0,FCARRAYS.LARGEST_MAGNITUDE.$N4
;  277        return
	MOVG	FCARRAYS.LARGEST_MAGNITUDE.$N4,R0 ; the function's value
	RET
FCARRAYS.LARGEST_MAGNITUDE.$1:
;  278      end if
;  279      largest_magnitude = 0
	CLRG	FCARRAYS.LARGEST_MAGNITUDE.$N4
;  280      do j = 1, q%cols
	MOVL	FCARRAYS.LARGEST_MAGNITUDE.Q(AP),R0 ; DO (line 280)'s limit
	MOVL	4(R0),R11
	MOVL	#1,FCARRAYS.LARGEST_MAGNITUDE.J
	CMPL	#1,R11
	BGTR	FCARRAYS.LARGEST_MAGNITUDE.$3
	MOVL	FCARRAYS.LARGEST_MAGNITUDE.Q(AP),R7
FCARRAYS.LARGEST_MAGNITUDE.$5:		; DO (line 280)'s body
;  281        do i = 1, q%rows
	MOVL	(R7),R10		; DO (line 281)'s limit
	MOVL	#1,FCARRAYS.LARGEST_MAGNITUDE.I
	CMPL	#1,R10
	BGTR	FCARRAYS.LARGEST_MAGNITUDE.$6
FCARRAYS.LARGEST_MAGNITUDE.$8:		; DO (line 281)'s body
;  282          largest_magnitude = max(largest_magnitude, c_abs(q%e(i, j)))
	MOVG	FCARRAYS.LARGEST_MAGNITUDE.$N4,R8
	MOVAL	48(R7),R6
	MULL3	FCARRAYS.LARGEST_MAGNITUDE.I,20(R6),R0
	ADDL2	16(R6),R0
	MULL3	FCARRAYS.LARGEST_MAGNITUDE.J,24(R6),R1
	ADDL2	R1,R0
	PUSHAO	(R0)
	CALLS	#1,G^FCVALUES.C_ABS
