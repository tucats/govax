	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  354
;  355    ! COLUMNS_HEADING is "columns 1 to 9:" (or "column 10:").
;  356    function columns_heading(first, last) result(text)
	.ENTRY	FCARRAYS.COLUMNS_HEADING,^M<R2,R3,R4,R5,R6,R7,R8>
;  357      integer, intent(in) :: first, last
;  358      character(len=40) :: text
;  359      character(len=12) :: a, b
;  360
;  361      write (a, '(I12)') first
	PUSHAQ	FCARRAYS.COLUMNS_HEADING.$D2
	PUSHAQ	FCARRAYS.COLUMNS_HEADING.$D1
	PUSHAB	FCARRAYS.COLUMNS_HEADING.$IO1
	CALLS	#3,G^FTN$WRITE_IF
	MOVAL	@FCARRAYS.COLUMNS_HEADING.FIRST(AP),FCARRAYS.COLUMNS_HEADING.$D3+4
	PUSHAQ	FCARRAYS.COLUMNS_HEADING.$D3
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;  362      write (b, '(I12)') last
	PUSHAQ	FCARRAYS.COLUMNS_HEADING.$D2
	PUSHAQ	FCARRAYS.COLUMNS_HEADING.$D4
	PUSHAB	FCARRAYS.COLUMNS_HEADING.$IO1
	CALLS	#3,G^FTN$WRITE_IF
