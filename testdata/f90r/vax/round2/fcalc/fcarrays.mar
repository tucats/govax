	PUSHAQ	FCARRAYS.SHOW_QUANTITY.$D1
	CALLS	#3,G^FCVALUES.FORMAT_VALUE
	MOVAB	FCARRAYS.SHOW_QUANTITY.$T4,FCARRAYS.SHOW_QUANTITY.$T7
