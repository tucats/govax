;  243
;  244    ! ELEMENT_AT is the Kth element in Fortran's array element order, down
;  245    ! each column in turn, as RESHAPE and a single index count them.
;  246    function element_at(q, k) result(v)
	.ENTRY	FCARRAYS.ELEMENT_AT,^M<R2,R3,R4,R5,R6,R7>
;  247      type(quantity), intent(in) :: q
;  248      integer, intent(in) :: k
;  249
;  250      type(value) :: v
;  251
;  252      v = element(q, mod(k - 1, q%rows) + 1, (k - 1) / q%rows + 1)
