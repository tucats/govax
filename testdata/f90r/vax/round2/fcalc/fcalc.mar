	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  286
;  287    ! RUN_FILE runs the lines of the file NAME, named at COLUMN, as if each
;  288    ! were typed: for LOAD, the variables and functions are cleared first, and
;  289    ! every line is quiet. A line ending in an error ends the file, and every
;  290    ! file that ran it (ABANDON), each saying the line it was at: in the
;  291    ! innermost, the error is reported with the line itself, which the
;  292    ! terminal hasn't shown. QUIT or EXIT ends the file alone. Under SET ECHO
;  293    ! each line is shown after the prompt, as a typed line is (but not while
;  294    ! LOAD runs).
;  295    recursive subroutine run_file(name, column, load)
FCALC.RUN_FILE:
	.WORD	^M<R2,R3,R4,R5,R6,R7,R8,R9,R10> ; internal procedure RUN_FILE of FCALC
	SUBL2	#576,SP			; this activation's own storage
;  296      character(len=*), intent(in) :: name
;  297      integer, intent(in) :: column
;  298      logical, intent(in) :: load
;  299      character(len=line_length + 1) :: text
;  300      integer :: count, used, status
;  301      logical :: was_loading, shown
;  302
;  303      if (depth == max_depth) then
	CMPL	FCALC.DEPTH,#8
	BNEQ	FCALC.RUN_FILE.$1
;  304        call fail(e_nesting, column)
	PUSHL	#0
	PUSHAL	@FCALC.RUN_FILE.COLUMN(AP)
	PUSHAL	FCALC.RUN_FILE.$K1
	CALLS	#3,G^FCMESSAGES.FAIL
;  305        return
	RET
FCALC.RUN_FILE.$1:
;  306      end if
;  307      if (.not. open_input(name, depth + 1, column)) return
	ADDL3	FCALC.DEPTH,#1,FCALC.RUN_FILE.$T2(FP)
	PUSHAL	@FCALC.RUN_FILE.COLUMN(AP)
	PUSHAL	FCALC.RUN_FILE.$T2(FP)
	PUSHL	FCALC.RUN_FILE.NAME(AP)
	CALLS	#3,G^FCSTATE.OPEN_INPUT
	MOVL	R0,R8
	BLBS	R8,FCALC.RUN_FILE.$3
	RET
FCALC.RUN_FILE.$3:
;  308      depth = depth + 1
	INCL	FCALC.DEPTH
;  309
;  310      was_loading = loading
	MOVL	FCALC.LOADING,FCALC.RUN_FILE.WAS_LOADING(FP)
;  311      if (load) then
	BLBC	@FCALC.RUN_FILE.LOAD(AP),FCALC.RUN_FILE.$5
;  312        call clear_variables()
	CALLS	#0,G^FCSYMBOLS.CLEAR_VARIABLES
;  313        call clear_functions()
	CALLS	#0,G^FCSYMBOLS.CLEAR_FUNCTIONS
;  314        call set_variable('ans', real_quantity(0.0_rk))
	PUSHAG	FCALC.RUN_FILE.$K3
	PUSHAB	FCALC.RUN_FILE.$T3(FP)
	CALLS	#2,G^FCARRAYS.REAL_QUANTITY
	PUSHAB	FCALC.RUN_FILE.$T3(FP)
	PUSHAQ	FCALC.RUN_FILE.$D1
