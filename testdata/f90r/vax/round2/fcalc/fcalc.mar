	.BLKB	2
FCALC.SHOW_COMMAND.$D6:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used
FCALC.SHOW_COMMAND.$T7:
	.BLKL	10			; characters, for one statement
FCALC.SHOW_COMMAND.$D8:
	.WORD	8			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used
FCALC.SHOW_COMMAND.$I1:
	.BLKL	1			; an array statement's loop index

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCALC.SHOW_COMMAND.$K1:
	.LONG	2
FCALC.SHOW_COMMAND.$K2:
	.LONG	17
FCALC.SHOW_COMMAND.$K3:
	.LONG	3
FCALC.SHOW_COMMAND.$K4:
	.LONG	5
FCALC.SHOW_COMMAND.$IO1:
	.WORD	8			; an I/O statement's control block: its size
	.WORD	^X0018			; flags: run-time format F90
	.LONG	0			; (not used yet)
FCALC.SHOW_COMMAND.$D1:
	.WORD	12			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCALC.SHOW_COMMAND.COUNT
FCALC.SHOW_COMMAND.$D2:
	.WORD	5			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCALC.SHOW_COMMAND.$K7
FCALC.SHOW_COMMAND.$D3:
