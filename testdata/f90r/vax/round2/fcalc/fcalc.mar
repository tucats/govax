;  134
;  135    ! RUN runs the line TEXT.
;  136    recursive subroutine run(text)
FCALC.RUN:
	.WORD	^M<R2,R3,R4,R5,R6>	; internal procedure RUN of FCALC
	SUBL2	#180,SP			; this activation's own storage
;  137      character(len=*), intent(in) :: text
;  138      type(token) :: first, second
;  139
;  140      ! The commands that name a file come first: a file's name isn't made
;  141      ! of fcalc's tokens (it may have [ ] and ; on VMS, / elsewhere).
;  142      if (file_command(text)) return
	PUSHL	FCALC.RUN.TEXT(AP)
	CALLS	#1,FCALC.FILE_COMMAND
	MOVL	R0,R6
	BLBC	R6,FCALC.RUN.$1
	RET
FCALC.RUN.$1:
;  143
;  144      call scan_line(text)
	PUSHL	FCALC.RUN.TEXT(AP)
	CALLS	#1,G^FCTREE.SCAN_LINE
;  145      if (failed()) return
	CALLS	#0,G^FCMESSAGES.FAILED
	MOVL	R0,R6
	BLBC	R6,FCALC.RUN.$3
	RET
FCALC.RUN.$3:
;  146
;  147      first = token_at(1)
	PUSHAL	FCALC.RUN.$K1
	PUSHAB	FCALC.RUN.$T2(FP)
	CALLS	#2,G^FCTREE.TOKEN_AT
	MOVC3	#56,FCALC.RUN.$T2(FP),FCALC.RUN.FIRST(FP)
;  148      second = token_at(2)
	PUSHAL	FCALC.RUN.$K2
	PUSHAB	FCALC.RUN.$T2(FP)
	CALLS	#2,G^FCTREE.TOKEN_AT
	MOVC3	#56,FCALC.RUN.$T2(FP),FCALC.RUN.SECOND(FP)
;  149
;  150      if (first%kind == t_name .and. .not. (second%kind == t_operator .and. &
;  151          (second%text == '=' .or. second%text == '('))) then
	CMPL	FCALC.RUN.FIRST(FP),#2
	BEQL	FCALC.RUN.$6
	BRW	FCALC.RUN.$5
FCALC.RUN.$6:
	CMPL	FCALC.RUN.SECOND(FP),#3
	BNEQ	FCALC.RUN.$7
	CMPC5	#31,FCALC.RUN.SECOND+8(FP),#^A/ /,#1,FCALC.RUN.$K3
	BNEQ	FCALC.RUN.$9
	BRW	FCALC.RUN.$5
FCALC.RUN.$9:
	CMPC5	#31,FCALC.RUN.SECOND+8(FP),#^A/ /,#1,FCALC.RUN.$K4
	BNEQ	FCALC.RUN.$10
	BRW	FCALC.RUN.$5
FCALC.RUN.$10:
FCALC.RUN.$7:
;  152        select case (first%text)
	CMPC5	#31,FCALC.RUN.FIRST+8(FP),#^A/ /,#4,FCALC.RUN.$K5
	BEQL	FCALC.RUN.$11
	CMPC5	#31,FCALC.RUN.FIRST+8(FP),#^A/ /,#4,FCALC.RUN.$K6
	BEQL	FCALC.RUN.$11
	CMPC5	#31,FCALC.RUN.FIRST+8(FP),#^A/ /,#4,FCALC.RUN.$K7
	BEQL	FCALC.RUN.$14
	CMPC5	#31,FCALC.RUN.FIRST+8(FP),#^A/ /,#5,FCALC.RUN.$K8
	BEQL	FCALC.RUN.$16
	CMPC5	#31,FCALC.RUN.FIRST+8(FP),#^A/ /,#3,FCALC.RUN.$K9
	BEQL	FCALC.RUN.$18
	CMPC5	#31,FCALC.RUN.FIRST+8(FP),#^A/ /,#4,FCALC.RUN.$K10
	BEQL	FCALC.RUN.$20
	CMPC5	#31,FCALC.RUN.FIRST+8(FP),#^A/ /,#5,FCALC.RUN.$K11
	BNEQ	FCALC.RUN.$24
	BRB	FCALC.RUN.$22
FCALC.RUN.$11:
;  153        case ('quit', 'exit')
;  154          done = .true.
	MOVL	#-1,FCALC.DONE
;  155          return
	RET
FCALC.RUN.$14:
;  156        case ('list')
;  157          call list_command()
	CALLS	#0,FCALC.LIST_COMMAND
;  158          return
	RET
FCALC.RUN.$16:
;  159        case ('clear')
;  160          call clear_command()
	CALLS	#0,FCALC.CLEAR_COMMAND
;  161          return
	RET
FCALC.RUN.$18:
;  162        case ('set')
;  163          call set_command()
	CALLS	#0,FCALC.SET_COMMAND
;  164          return
	RET
FCALC.RUN.$20:
;  165        case ('show')
;  166          call show_command()
	CALLS	#0,FCALC.SHOW_COMMAND
;  167          return
	RET
FCALC.RUN.$22:
;  168        case ('roots')
;  169          call roots_command()
	CALLS	#0,G^FCNUMERIC.ROOTS_COMMAND
;  170          return
	RET
FCALC.RUN.$24:
;  171        end select
;  172      end if
FCALC.RUN.$5:
;  173
;  174      ! SOLVE, INTEGRATE, DIFF, TABLE, and PLOT are reserved words, so they
;  175      ! may be followed by a parenthesis: DIFF (X + 1)^2 FOR X AT 1.
;  176      if (first%kind == t_name .and. .not. (second%kind == t_operator .and. &
;  177          second%text == '=')) then
	CMPL	FCALC.RUN.FIRST(FP),#2
	BEQL	FCALC.RUN.$26
	BRW	FCALC.RUN.$25
FCALC.RUN.$26:
	CMPL	FCALC.RUN.SECOND(FP),#3
	BNEQ	FCALC.RUN.$27
	CMPC5	#31,FCALC.RUN.SECOND+8(FP),#^A/ /,#1,FCALC.RUN.$K3
	BEQL	FCALC.RUN.$25
FCALC.RUN.$27:
;  178        select case (first%text)
	CMPC5	#31,FCALC.RUN.FIRST+8(FP),#^A/ /,#5,FCALC.RUN.$K12
	BEQL	FCALC.RUN.$30
	CMPC5	#31,FCALC.RUN.FIRST+8(FP),#^A/ /,#9,FCALC.RUN.$K13
	BEQL	FCALC.RUN.$32
	CMPC5	#31,FCALC.RUN.FIRST+8(FP),#^A/ /,#4,FCALC.RUN.$K14
	BEQL	FCALC.RUN.$34
	CMPC5	#31,FCALC.RUN.FIRST+8(FP),#^A/ /,#5,FCALC.RUN.$K15
	BEQL	FCALC.RUN.$36
	CMPC5	#31,FCALC.RUN.FIRST+8(FP),#^A/ /,#4,FCALC.RUN.$K16
	BNEQ	FCALC.RUN.$40
	BRB	FCALC.RUN.$38
FCALC.RUN.$30:
;  179        case ('solve')
;  180          call solve_command()
	CALLS	#0,G^FCNUMERIC.SOLVE_COMMAND
;  181          return
	RET
FCALC.RUN.$32:
;  182        case ('integrate')
;  183          call integrate_command()
	CALLS	#0,G^FCNUMERIC.INTEGRATE_COMMAND
;  184          return
	RET
FCALC.RUN.$34:
;  185        case ('diff')
;  186          call diff_command()
	CALLS	#0,G^FCNUMERIC.DIFF_COMMAND
;  187          return
	RET
FCALC.RUN.$36:
;  188        case ('table')
;  189          call table_command(text)
	PUSHL	FCALC.RUN.TEXT(AP)
	CALLS	#1,G^FCPLOT.TABLE_COMMAND
;  190          return
	RET
FCALC.RUN.$38:
;  191        case ('plot')
;  192          call plot_command(text)
	PUSHL	FCALC.RUN.TEXT(AP)
	CALLS	#1,G^FCPLOT.PLOT_COMMAND
;  193          return
	RET
FCALC.RUN.$40:
;  194        end select
;  195      end if
FCALC.RUN.$25:
;  196
;  197      if (first%kind == t_name .and. second%kind == t_operator .and. second%text == '=') then
	CMPL	FCALC.RUN.FIRST(FP),#2
	BNEQ	FCALC.RUN.$41
	CMPL	FCALC.RUN.SECOND(FP),#3
	BNEQ	FCALC.RUN.$41
	CMPC5	#31,FCALC.RUN.SECOND+8(FP),#^A/ /,#1,FCALC.RUN.$K3
	BNEQ	FCALC.RUN.$41
;  198        call assignment(first)
	PUSHAB	FCALC.RUN.FIRST(FP)
	CALLS	#1,FCALC.ASSIGNMENT
;  199      else if (is_definition() .and. .not. indexes_array(first%text)) then
	RET
FCALC.RUN.$41:
	CALLS	#0,FCALC.IS_DEFINITION
	MOVL	R0,R6
	MOVL	#17694751,FCALC.RUN.$D1(FP) ; the descriptor's length, 31, type, and class
	MOVAB	FCALC.RUN.FIRST+8(FP),FCALC.RUN.$D1+4(FP)
	PUSHAQ	FCALC.RUN.$D1(FP)
	CALLS	#1,FCALC.INDEXES_ARRAY
	MOVL	R0,FCALC.RUN.$T3(FP)
	BLBC	R6,FCALC.RUN.$46
	BLBS	FCALC.RUN.$T3(FP),FCALC.RUN.$46
;  200        call definition(text)
	PUSHL	FCALC.RUN.TEXT(AP)
	CALLS	#1,FCALC.DEFINITION
;  201      else
	RET
FCALC.RUN.$46:
;  202        call statement()
	CALLS	#0,FCALC.STATEMENT
;  203      end if
;  204    end subroutine run
	RET

; Storage map for FCALC.FILE_COMMAND, a RECURSIVE LOGICAL function
;   TEXT          CHARACTER*(*), INTENT(IN)  argument 1  @FCALC.FILE_COMMAND.TEXT(AP)
;   FILE_COMMAND  LOGICAL                    FP-48       FCALC.FILE_COMMAND.FILE_COMMAND(FP)
;   WORD          CHARACTER*8                FP-44       FCALC.FILE_COMMAND.WORD(FP)
;   AT            INTEGER                    R10         R10
;   NEXT          INTEGER                    FP-32       FCALC.FILE_COMMAND.NEXT(FP)
;   K             INTEGER                    R6          R6
;   R7 is $T1: temporary
;   R7 is $T2: temporary
;   R9 is $H1: a value computed before a loop
;   R7 is $U1: temporary
;   R6 is $R1: NEXT, during a loop
;   R8 is $R2: TEXT's address
;
FCALC.FILE_COMMAND.TEXT = 4		; TEXT is argument 1
FCALC.FILE_COMMAND.FILE_COMMAND = -48	; FILE_COMMAND, the function's value, in the frame
FCALC.FILE_COMMAND.WORD = -44		; WORD, in the frame
FCALC.FILE_COMMAND.NEXT = -32		; NEXT, in the frame
FCALC.FILE_COMMAND.$D2 = -24		; a descriptor, written whole at each use, in the frame
FCALC.FILE_COMMAND.$D3 = -16		; a descriptor, written whole at each use, in the frame
FCALC.FILE_COMMAND.$D4 = -8		; a descriptor, written whole at each use, in the frame

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCALC.FILE_COMMAND.$D1:
	.WORD	2			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCALC.FILE_COMMAND.$K1
FCALC.FILE_COMMAND.$K2:
	.LONG	0
FCALC.FILE_COMMAND.$K1:
	.ASCII	/ /<9>
FCALC.FILE_COMMAND.$K3:
	.ASCII	/@/
FCALC.FILE_COMMAND.$K4:
	.ASCII	/abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ/
FCALC.FILE_COMMAND.$K5:
	.ASCII	/run/
FCALC.FILE_COMMAND.$K6:
	.ASCII	/load/
FCALC.FILE_COMMAND.$K7:
	.ASCII	/save/
FCALC.FILE_COMMAND.$K8:
	.ASCII	/log/
FCALC.FILE_COMMAND.$K11:
	.ASCII	/0123456789_$/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  205
;  206    ! FILE_COMMAND runs TEXT and is true, if it is a command that names a
;  207    ! file: @file, RUN file, LOAD file, SAVE file, LOG file, or LOG OFF. As
;  208    ! with the other commands, a word followed by = or ( isn't one: RUN = 3
;  209    ! assigns a variable, and LOG(8, 2) is the logarithm.
;  210    recursive logical function file_command(text)
FCALC.FILE_COMMAND:
	.WORD	^M<R2,R3,R4,R5,R6,R7,R8,R9,R10> ; internal procedure FILE_COMMAND of FCALC
	SUBL2	#48,SP			; this activation's own storage
;  211      character(len=*), intent(in) :: text
;  212      character(len=8) :: word
;  213      integer :: at, next, k
;  214
;  215      file_command = .false.
;  216      at = verify(text, ' ' // achar(9))
	PUSHAL	FCALC.FILE_COMMAND.$K2
	PUSHAQ	FCALC.FILE_COMMAND.$D1
	PUSHL	FCALC.FILE_COMMAND.TEXT(AP)
	CALLS	#3,G^FTN$VERIFY
	MOVL	R0,R7
	MOVL	R7,R10
;  217      if (at == 0) return
	BNEQ	FCALC.FILE_COMMAND.$1
	CLRL	R0			; the function's value
	RET
FCALC.FILE_COMMAND.$1:
;  218
;  219      if (text(at:at) == '@') then
	MOVL	FCALC.FILE_COMMAND.TEXT(AP),R0
	SUBL3	#1,R10,R1
	CMPB	@4(R0)[R1],#64
	BNEQ	FCALC.FILE_COMMAND.$3
;  220        word = '@'
	MOVC5	#1,FCALC.FILE_COMMAND.$K3,#^A/ /,#8,FCALC.FILE_COMMAND.WORD(FP)
;  221        next = at + 1
	ADDL3	R10,#1,FCALC.FILE_COMMAND.NEXT(FP)
;  222      else
	BRW	FCALC.FILE_COMMAND.$5
FCALC.FILE_COMMAND.$3:
;  223        ! The word: the letters from AT, lowercased.
;  224        next = at
	MOVL	R10,FCALC.FILE_COMMAND.NEXT(FP)
;  225        do while (next <= len(text))
	MOVZWL	@FCALC.FILE_COMMAND.TEXT(AP),R9 ; from line 225
	MOVL	FCALC.FILE_COMMAND.NEXT(FP),R6
	MOVL	FCALC.FILE_COMMAND.TEXT(AP),R8
	BRB	FCALC.FILE_COMMAND.$6
FCALC.FILE_COMMAND.$7:			; DO (line 225)'s body
;  226          if (index('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ', text(next:next)) == 0) exit
	SUBL3	#1,R6,R0
	MATCHC	#1,@4(R8)[R0],#52,FCALC.FILE_COMMAND.$K4
	BNEQ	FCALC.FILE_COMMAND.$8
	SUBL3	R2,#52,R0
	BRB	FCALC.FILE_COMMAND.$9
FCALC.FILE_COMMAND.$8:
	CLRL	R0
FCALC.FILE_COMMAND.$9:
	MOVL	R0,R7
	BNEQ	FCALC.FILE_COMMAND.$11
	BRW	FCALC.FILE_COMMAND.$10
FCALC.FILE_COMMAND.$11:
;  227          next = next + 1
	INCL	R6
;  228        end do
FCALC.FILE_COMMAND.$6:			; DO (line 225)'s test
	CMPL	R6,R9			; from line 225
	BLEQ	FCALC.FILE_COMMAND.$7
	MOVL	R6,FCALC.FILE_COMMAND.NEXT(FP)
FCALC.FILE_COMMAND.$13:
;  229        if (next - at > len(word)) return
	SUBL3	R10,FCALC.FILE_COMMAND.NEXT(FP),R0
	CMPL	R0,#8
	BLEQ	FCALC.FILE_COMMAND.$14
	CLRL	R0			; the function's value
	RET
FCALC.FILE_COMMAND.$14:
;  230        word = lowercase(text(at:next - 1))
	MOVL	#34471936,FCALC.FILE_COMMAND.$D2(FP) ; the descriptor's length, 0, type, and class
	CLRL	FCALC.FILE_COMMAND.$D2+4(FP) ; no string yet
	SUBL3	R10,FCALC.FILE_COMMAND.NEXT(FP),R7
	BGEQ	FCALC.FILE_COMMAND.$16
	CLRL	R7
FCALC.FILE_COMMAND.$16:
	MOVL	#17694720,FCALC.FILE_COMMAND.$D3(FP) ; the descriptor's length, 0, type, and class
	CVTLW	R7,FCALC.FILE_COMMAND.$D3(FP)
	MOVL	FCALC.FILE_COMMAND.TEXT(AP),R0
	SUBL3	#1,R10,R1
	MOVAB	@4(R0)[R1],FCALC.FILE_COMMAND.$D3+4(FP)
	PUSHAQ	FCALC.FILE_COMMAND.$D3(FP)
	PUSHAQ	FCALC.FILE_COMMAND.$D2(FP)
	CALLS	#2,FCALC.LOWERCASE
	MOVZWL	FCALC.FILE_COMMAND.$D2(FP),R0
	MOVC5	R0,@FCALC.FILE_COMMAND.$D2+4(FP),#^A/ /,#8,FCALC.FILE_COMMAND.WORD(FP)
	PUSHAQ	FCALC.FILE_COMMAND.$D2(FP)
	CALLS	#1,G^LIB$SFREE1_DD
;  231        if (word /= 'run' .and. word /= 'load' .and. word /= 'save' .and. word /= 'log') return
	CMPC5	#8,FCALC.FILE_COMMAND.WORD(FP),#^A/ /,#3,FCALC.FILE_COMMAND.$K5
	BEQL	FCALC.FILE_COMMAND.$18
	CMPC5	#8,FCALC.FILE_COMMAND.WORD(FP),#^A/ /,#4,FCALC.FILE_COMMAND.$K6
	BEQL	FCALC.FILE_COMMAND.$18
	CMPC5	#8,FCALC.FILE_COMMAND.WORD(FP),#^A/ /,#4,FCALC.FILE_COMMAND.$K7
	BEQL	FCALC.FILE_COMMAND.$18
	CMPC5	#8,FCALC.FILE_COMMAND.WORD(FP),#^A/ /,#3,FCALC.FILE_COMMAND.$K8
	BEQL	FCALC.FILE_COMMAND.$18
	CLRL	R0			; the function's value
	RET
FCALC.FILE_COMMAND.$18:
;  232        ! The next character that isn't blank: = or ( makes the line no
;  233        ! command, and so does a word's going on (RUNNING = 1).
;  234        k = verify(text(next:), ' ' // achar(9))
	MOVZWL	@FCALC.FILE_COMMAND.TEXT(AP),R0
	SUBL2	FCALC.FILE_COMMAND.NEXT(FP),R0
	ADDL3	R0,#1,R7
	BGEQ	FCALC.FILE_COMMAND.$23
	CLRL	R7
FCALC.FILE_COMMAND.$23:
	MOVL	#17694720,FCALC.FILE_COMMAND.$D3(FP) ; the descriptor's length, 0, type, and class
	CVTLW	R7,FCALC.FILE_COMMAND.$D3(FP)
	MOVL	FCALC.FILE_COMMAND.TEXT(AP),R0
	SUBL3	#1,FCALC.FILE_COMMAND.NEXT(FP),R1
	MOVAB	@4(R0)[R1],FCALC.FILE_COMMAND.$D3+4(FP)
	PUSHAL	FCALC.FILE_COMMAND.$K2
	PUSHAQ	FCALC.FILE_COMMAND.$D1
	PUSHAQ	FCALC.FILE_COMMAND.$D3(FP)
	CALLS	#3,G^FTN$VERIFY
	MOVL	R0,R7
	MOVL	R7,R6
;  235        if (k > 0) then
	BLEQ	FCALC.FILE_COMMAND.$25
;  236          k = next + k - 1
	ADDL3	FCALC.FILE_COMMAND.NEXT(FP),R6,R0
	SUBL3	#1,R0,R6
;  237          if (text(k:k) == '=' .or. text(k:k) == '(') return
	MOVL	FCALC.FILE_COMMAND.TEXT(AP),R0
	SUBL3	#1,R6,R1
	MOVB	@4(R0)[R1],R7
	CMPB	R7,#61
	BEQL	FCALC.FILE_COMMAND.$28
	CMPB	R7,#40
	BNEQ	FCALC.FILE_COMMAND.$27
FCALC.FILE_COMMAND.$28:
	CLRL	R0			; the function's value
	RET
FCALC.FILE_COMMAND.$27:
;  238          if (k == next .and. index('0123456789_$', text(k:k)) > 0) return
	MOVL	FCALC.FILE_COMMAND.TEXT(AP),R0
	SUBL3	#1,R6,R1
	MATCHC	#1,@4(R0)[R1],#12,FCALC.FILE_COMMAND.$K11
	BNEQ	FCALC.FILE_COMMAND.$31
	SUBL3	R2,#12,R0
	BRB	FCALC.FILE_COMMAND.$32
FCALC.FILE_COMMAND.$31:
	CLRL	R0
FCALC.FILE_COMMAND.$32:
	MOVL	R0,R7
	CMPL	R6,FCALC.FILE_COMMAND.NEXT(FP)
	BNEQ	FCALC.FILE_COMMAND.$33
	TSTL	R7
	BLEQ	FCALC.FILE_COMMAND.$33
	CLRL	R0			; the function's value
	RET
FCALC.FILE_COMMAND.$33:
;  239        end if
FCALC.FILE_COMMAND.$25:
;  240      end if
FCALC.FILE_COMMAND.$5:
;  241
;  242      file_command = .true.
;  243      call file_argument(text, next, word)
	MOVL	#17694728,FCALC.FILE_COMMAND.$D4(FP) ; the descriptor's length, 8, type, and class
	MOVAB	FCALC.FILE_COMMAND.WORD(FP),FCALC.FILE_COMMAND.$D4+4(FP)
	PUSHAQ	FCALC.FILE_COMMAND.$D4(FP)
	PUSHAL	FCALC.FILE_COMMAND.NEXT(FP)
	PUSHL	FCALC.FILE_COMMAND.TEXT(AP)
	CALLS	#3,FCALC.FILE_ARGUMENT
;  244    end function file_command
	MOVL	#-1,R0			; the function's value
	RET
FCALC.FILE_COMMAND.$10:			; leaving the loop
	MOVL	R6,FCALC.FILE_COMMAND.NEXT(FP)
	BRW	FCALC.FILE_COMMAND.$13

; Storage map for FCALC.FILE_ARGUMENT, a RECURSIVE subroutine
;   TEXT   CHARACTER*(*), INTENT(IN)  argument 1  @FCALC.FILE_ARGUMENT.TEXT(AP)
;   NEXT   INTEGER, INTENT(IN)        argument 2  @FCALC.FILE_ARGUMENT.NEXT(AP)
;   WORD   CHARACTER*(*), INTENT(IN)  argument 3  @FCALC.FILE_ARGUMENT.WORD(AP)
;   FIRST  INTEGER                    FP-40       FCALC.FILE_ARGUMENT.FIRST(FP)
;   LAST   INTEGER                    R9          R9
;   K      INTEGER                    R10         R10
;   R6 is $T1: temporary
;   R8 is $T3: temporary
;   R7 is $T4: temporary
;
FCALC.FILE_ARGUMENT.TEXT = 4		; TEXT is argument 1
FCALC.FILE_ARGUMENT.NEXT = 8		; NEXT is argument 2
FCALC.FILE_ARGUMENT.WORD = 12		; WORD is argument 3
FCALC.FILE_ARGUMENT.FIRST = -40		; FIRST, in the frame
FCALC.FILE_ARGUMENT.$T2 = -28		; temporary, in the frame
FCALC.FILE_ARGUMENT.$D1 = -24		; a descriptor, written whole at each use, in the frame
FCALC.FILE_ARGUMENT.$D3 = -16		; a descriptor, written whole at each use, in the frame
FCALC.FILE_ARGUMENT.$D4 = -8		; a descriptor, written whole at each use, in the frame

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCALC.FILE_ARGUMENT.$D2:
	.WORD	2			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCALC.FILE_ARGUMENT.$K1
FCALC.FILE_ARGUMENT.$K2:
	.LONG	0
FCALC.FILE_ARGUMENT.$K3:
	.LONG	45
FCALC.FILE_ARGUMENT.$K4:
	.LONG	5
FCALC.FILE_ARGUMENT.$K9:
	.LONG	-1
FCALC.FILE_ARGUMENT.$K1:
	.ASCII	/ /<9>
FCALC.FILE_ARGUMENT.$K5:
	.ASCII	/@/
FCALC.FILE_ARGUMENT.$K6:
	.ASCII	/run/
FCALC.FILE_ARGUMENT.$K7:
	.ASCII	/load/
FCALC.FILE_ARGUMENT.$K8:
	.ASCII	/save/
FCALC.FILE_ARGUMENT.$K10:
	.ASCII	/off/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  245
;  246    ! FILE_ARGUMENT runs the command WORD, its file named in TEXT from NEXT:
;  247    ! one word, with nothing after it.
;  248    recursive subroutine file_argument(text, next, word)
FCALC.FILE_ARGUMENT:
	.WORD	^M<R2,R3,R6,R7,R8,R9,R10> ; internal procedure FILE_ARGUMENT of FCALC
	SUBL2	#40,SP			; this activation's own storage
;  249      character(len=*), intent(in) :: text, word
;  250      integer, intent(in) :: next
;  251      integer :: first, last, k
;  252
