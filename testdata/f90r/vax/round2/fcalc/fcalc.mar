;  826
;  827    ! TOKEN_COLUMN is the column of the Kth token.
;  828    integer function token_column(k)
FCALC.TOKEN_COLUMN:
	.WORD	^M<R2,R3,R4,R5>		; internal procedure TOKEN_COLUMN of FCALC
;  829      integer, intent(in) :: k
;  830      type(token) :: t
