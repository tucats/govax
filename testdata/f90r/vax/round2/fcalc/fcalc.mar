FCALC.WHOLE_EXPRESSION.$K2:
	.LONG	5

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  471
;  472    ! WHOLE_EXPRESSION parses and evaluates the rest of the line as an
;  473    ! expression: false after an error, when V is released.
;  474    logical function whole_expression(v)
FCALC.WHOLE_EXPRESSION:
	.WORD	^M<R2,R3,R4,R5,R6>	; internal procedure WHOLE_EXPRESSION of FCALC
;  475      type(quantity), intent(out) :: v
;  476      type(node), pointer :: tree
;  477
;  478      whole_expression = .false.
;  479      v = real_quantity(0.0_rk)
	PUSHAG	FCALC.WHOLE_EXPRESSION.$K1
	PUSHAB	FCALC.WHOLE_EXPRESSION.$T1
	CALLS	#2,G^FCARRAYS.REAL_QUANTITY
	MOVC3	#96,FCALC.WHOLE_EXPRESSION.$T1,@FCALC.WHOLE_EXPRESSION.V(AP)
;  480      tree => parse_expression()
	CALLS	#0,G^FCTREE.PARSE_EXPRESSION
	MOVL	R0,FCALC.WHOLE_EXPRESSION.$T2
	MOVL	FCALC.WHOLE_EXPRESSION.$T2,FCALC.WHOLE_EXPRESSION.TREE
;  481      if (failed()) return
	CALLS	#0,G^FCMESSAGES.FAILED
	MOVL	R0,FCALC.WHOLE_EXPRESSION.$T2
	BLBC	FCALC.WHOLE_EXPRESSION.$T2,FCALC.WHOLE_EXPRESSION.$1
	CLRL	R0			; the function's value
	RET
FCALC.WHOLE_EXPRESSION.$1:
;  482      if (.not. at_end()) then
	CALLS	#0,G^FCTREE.AT_END
	MOVL	R0,FCALC.WHOLE_EXPRESSION.$T2
	BLBS	FCALC.WHOLE_EXPRESSION.$T2,FCALC.WHOLE_EXPRESSION.$3
;  483        call fail(e_extra, current_column())
	CALLS	#0,G^FCTREE.CURRENT_COLUMN
	MOVL	R0,FCALC.WHOLE_EXPRESSION.$T2
	PUSHL	#0
	PUSHAL	FCALC.WHOLE_EXPRESSION.$T2
	PUSHAL	FCALC.WHOLE_EXPRESSION.$K2
	CALLS	#3,G^FCMESSAGES.FAIL
;  484        call free_tree(tree)
	PUSHAL	FCALC.WHOLE_EXPRESSION.TREE
	CALLS	#1,G^FCTREE.FREE_TREE
;  485        return
	CLRL	R0			; the function's value
	RET
FCALC.WHOLE_EXPRESSION.$3:
;  486      end if
;  487
;  488      v = evaluate(tree)
	PUSHL	#0
	PUSHAL	FCALC.WHOLE_EXPRESSION.TREE
	PUSHAB	FCALC.WHOLE_EXPRESSION.$T1
	CALLS	#3,G^FCEVAL.EVALUATE
	MOVC3	#96,FCALC.WHOLE_EXPRESSION.$T1,@FCALC.WHOLE_EXPRESSION.V(AP)
;  489      call free_tree(tree)
	PUSHAL	FCALC.WHOLE_EXPRESSION.TREE
	CALLS	#1,G^FCTREE.FREE_TREE
;  490      whole_expression = .not. failed()
	CALLS	#0,G^FCMESSAGES.FAILED
	MOVL	R0,FCALC.WHOLE_EXPRESSION.$T2
	MCOML	FCALC.WHOLE_EXPRESSION.$T2,R6
;  491      if (.not. whole_expression) call release(v)
	BLBS	R6,FCALC.WHOLE_EXPRESSION.$5
	PUSHAB	@FCALC.WHOLE_EXPRESSION.V(AP)
	CALLS	#1,G^FCARRAYS.RELEASE
FCALC.WHOLE_EXPRESSION.$5:
;  492    end function whole_expression
	MOVL	R6,R0			; the function's value
	RET

; Storage map for FCALC.IS_DEFINITION, a LOGICAL function
;   IS_DEFINITION  LOGICAL      $LOCAL+0   FCALC.IS_DEFINITION.$N1
;   T              TYPE(TOKEN)  $LOCAL+8   FCALC.IS_DEFINITION.T
;   K              INTEGER      $LOCAL+64  FCALC.IS_DEFINITION.K
;   FCALC.IS_DEFINITION.$N1 is FCALC.IS_DEFINITION.IS_DEFINITION
;

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
	.ALIGN	QUAD			; the boundary of this routine's aligned records
FCALC.IS_DEFINITION.$N1:
	.BLKL	1			; IS_DEFINITION, the function's value
	.BLKB	4
FCALC.IS_DEFINITION.T:
	.BLKL	14			; T
FCALC.IS_DEFINITION.K:
	.BLKL	1			; K
FCALC.IS_DEFINITION.$T1:
	.BLKL	1			; temporary
FCALC.IS_DEFINITION.$T2:
	.BLKL	14			; characters, for one statement

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCALC.IS_DEFINITION.$K1:
	.LONG	1
FCALC.IS_DEFINITION.$K2:
	.LONG	2
FCALC.IS_DEFINITION.$K3:
	.ASCII	/(/
FCALC.IS_DEFINITION.$K4:
	.ASCII	/)/
FCALC.IS_DEFINITION.$K5:
	.ASCII	/,/
FCALC.IS_DEFINITION.$K6:
	.ASCII	/=/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  493
;  494    ! IS_DEFINITION: the line starts f(x, y) =, a function's definition. A
;  495    ! call, f(2) or f(x + 1), has something other than names between its
;  496    ! parentheses, or no = after them.
;  497    logical function is_definition()
FCALC.IS_DEFINITION:
	.WORD	^M<R2,R3,R4,R5>		; internal procedure IS_DEFINITION of FCALC
;  498      type(token) :: t
;  499      integer :: k
;  500
;  501      is_definition = .false.
;  502      if (kind_at(1) /= t_name) return
	PUSHAL	FCALC.IS_DEFINITION.$K1
	CALLS	#1,G^FCTREE.KIND_AT
	MOVL	R0,FCALC.IS_DEFINITION.$T1
	CMPL	FCALC.IS_DEFINITION.$T1,#2
	BEQL	FCALC.IS_DEFINITION.$1
	CLRL	R0			; the function's value
	RET
FCALC.IS_DEFINITION.$1:
;  503      t = token_at(2)
	PUSHAL	FCALC.IS_DEFINITION.$K2
	PUSHAB	FCALC.IS_DEFINITION.$T2
	CALLS	#2,G^FCTREE.TOKEN_AT
	MOVC3	#56,FCALC.IS_DEFINITION.$T2,FCALC.IS_DEFINITION.T
;  504      if (t%kind /= t_operator .or. t%text /= '(') return
	CMPL	FCALC.IS_DEFINITION.T,#3
	BNEQ	FCALC.IS_DEFINITION.$4
	CMPC5	#31,FCALC.IS_DEFINITION.T+8,#^A/ /,#1,FCALC.IS_DEFINITION.$K3
	BEQL	FCALC.IS_DEFINITION.$3
FCALC.IS_DEFINITION.$4:
	CLRL	R0			; the function's value
	RET
FCALC.IS_DEFINITION.$3:
;  505
;  506      k = 3
	MOVL	#3,FCALC.IS_DEFINITION.K
;  507      t = token_at(k)
	PUSHAL	FCALC.IS_DEFINITION.K
	PUSHAB	FCALC.IS_DEFINITION.$T2
	CALLS	#2,G^FCTREE.TOKEN_AT
	MOVC3	#56,FCALC.IS_DEFINITION.$T2,FCALC.IS_DEFINITION.T
;  508      if (.not. (t%kind == t_operator .and. t%text == ')')) then
	CMPL	FCALC.IS_DEFINITION.T,#3
	BNEQ	FCALC.IS_DEFINITION.$11
	CMPC5	#31,FCALC.IS_DEFINITION.T+8,#^A/ /,#1,FCALC.IS_DEFINITION.$K4
	BNEQ	FCALC.IS_DEFINITION.$11
	BRW	FCALC.IS_DEFINITION.$7
;  509        do
FCALC.IS_DEFINITION.$12:
;  510          if (kind_at(k) /= t_name) return
	CLRL	R0			; the function's value
	RET
FCALC.IS_DEFINITION.$13:
;  511          t = token_at(k + 1)
	ADDL3	FCALC.IS_DEFINITION.K,#1,FCALC.IS_DEFINITION.$T1
	PUSHAL	FCALC.IS_DEFINITION.$T1
	PUSHAB	FCALC.IS_DEFINITION.$T2
	CALLS	#2,G^FCTREE.TOKEN_AT
	MOVC3	#56,FCALC.IS_DEFINITION.$T2,FCALC.IS_DEFINITION.T
;  512          if (t%kind /= t_operator) return
	CMPL	FCALC.IS_DEFINITION.T,#3
	BEQL	FCALC.IS_DEFINITION.$14
	CLRL	R0			; the function's value
	RET
FCALC.IS_DEFINITION.$14:
;  513          k = k + 2
	ADDL2	#2,FCALC.IS_DEFINITION.K
;  514          if (t%text == ')') exit
	CMPC5	#31,FCALC.IS_DEFINITION.T+8,#^A/ /,#1,FCALC.IS_DEFINITION.$K4
	BEQL	FCALC.IS_DEFINITION.$16
;  515          if (t%text /= ',') return
	CMPC5	#31,FCALC.IS_DEFINITION.T+8,#^A/ /,#1,FCALC.IS_DEFINITION.$K5
	BEQL	FCALC.IS_DEFINITION.$18
	CLRL	R0			; the function's value
	RET
FCALC.IS_DEFINITION.$18:
;  516        end do
FCALC.IS_DEFINITION.$11:		; DO (line 509)'s body
	PUSHAL	FCALC.IS_DEFINITION.K	; from line 510
	CALLS	#1,G^FCTREE.KIND_AT
	MOVL	R0,FCALC.IS_DEFINITION.$T1
	CMPL	FCALC.IS_DEFINITION.$T1,#2
	BEQL	FCALC.IS_DEFINITION.$13
	BRW	FCALC.IS_DEFINITION.$12
FCALC.IS_DEFINITION.$16:
;  517        k = k - 1
	DECL	FCALC.IS_DEFINITION.K
;  518      end if
FCALC.IS_DEFINITION.$7:
;  519
;  520      ! K is the ) token's place.
;  521      t = token_at(k + 1)
	ADDL3	FCALC.IS_DEFINITION.K,#1,FCALC.IS_DEFINITION.$T1
	PUSHAL	FCALC.IS_DEFINITION.$T1
	PUSHAB	FCALC.IS_DEFINITION.$T2
	CALLS	#2,G^FCTREE.TOKEN_AT
	MOVC3	#56,FCALC.IS_DEFINITION.$T2,FCALC.IS_DEFINITION.T
;  522      is_definition = t%kind == t_operator .and. t%text == '='
	CMPC5	#31,FCALC.IS_DEFINITION.T+8,#^A/ /,#1,FCALC.IS_DEFINITION.$K6
	BNEQ	FCALC.IS_DEFINITION.$21
	MNEGL	#1,R0
	BRB	FCALC.IS_DEFINITION.$22
FCALC.IS_DEFINITION.$21:
	CLRL	R0
FCALC.IS_DEFINITION.$22:
	MOVL	R0,FCALC.IS_DEFINITION.$T1
;  523    end function is_definition
	CLRL	R0			; the function's value
	CMPL	FCALC.IS_DEFINITION.T,#3
	BNEQ	FCALC.IS_DEFINITION.$23
	MNEGL	#1,R0
FCALC.IS_DEFINITION.$23:
	MCOML	FCALC.IS_DEFINITION.$T1,R1
	BICL2	R1,R0
