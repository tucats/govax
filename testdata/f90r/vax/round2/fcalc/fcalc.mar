;  603
;  604      is_reserved = name == 'or' .or. name == 'and' .or. name == 'not' .or. name == 'mod' .or. &
;  605        name == 'solve' .or. name == 'integrate' .or. name == 'diff' .or. &
;  606        name == 'table' .or. name == 'plot'
	MOVZWL	@FCALC.IS_RESERVED.NAME(AP),R6
	MOVL	FCALC.IS_RESERVED.NAME(AP),R0
	CMPC5	R6,@4(R0),#^A/ /,#2,FCALC.IS_RESERVED.$K1
	BNEQ	FCALC.IS_RESERVED.$1
	MNEGL	#1,R0
	BRB	FCALC.IS_RESERVED.$2
FCALC.IS_RESERVED.$1:
	CLRL	R0
FCALC.IS_RESERVED.$2:
	MOVL	R0,FCALC.IS_RESERVED.$T1
	MOVL	FCALC.IS_RESERVED.NAME(AP),R0
	CMPC5	R6,@4(R0),#^A/ /,#3,FCALC.IS_RESERVED.$K2
	BNEQ	FCALC.IS_RESERVED.$3
	MNEGL	#1,R0
	BRB	FCALC.IS_RESERVED.$4
FCALC.IS_RESERVED.$3:
	CLRL	R0
FCALC.IS_RESERVED.$4:
	MOVL	R0,FCALC.IS_RESERVED.$T2
	MOVL	FCALC.IS_RESERVED.NAME(AP),R0
	CMPC5	R6,@4(R0),#^A/ /,#3,FCALC.IS_RESERVED.$K3
	BNEQ	FCALC.IS_RESERVED.$5
	MNEGL	#1,R0
	BRB	FCALC.IS_RESERVED.$6
FCALC.IS_RESERVED.$5:
	CLRL	R0
FCALC.IS_RESERVED.$6:
	MOVL	R0,FCALC.IS_RESERVED.$T3
	MOVL	FCALC.IS_RESERVED.NAME(AP),R0
	CMPC5	R6,@4(R0),#^A/ /,#3,FCALC.IS_RESERVED.$K4
	BNEQ	FCALC.IS_RESERVED.$7
	MNEGL	#1,R0
	BRB	FCALC.IS_RESERVED.$8
FCALC.IS_RESERVED.$7:
	CLRL	R0
FCALC.IS_RESERVED.$8:
	MOVL	R0,FCALC.IS_RESERVED.$T4
	MOVL	FCALC.IS_RESERVED.NAME(AP),R0
	CMPC5	R6,@4(R0),#^A/ /,#5,FCALC.IS_RESERVED.$K5
	BNEQ	FCALC.IS_RESERVED.$9
	MNEGL	#1,R0
	BRB	FCALC.IS_RESERVED.$10
FCALC.IS_RESERVED.$9:
	CLRL	R0
FCALC.IS_RESERVED.$10:
	MOVL	R0,FCALC.IS_RESERVED.$T5
	MOVL	FCALC.IS_RESERVED.NAME(AP),R0
	CMPC5	R6,@4(R0),#^A/ /,#9,FCALC.IS_RESERVED.$K6
	BNEQ	FCALC.IS_RESERVED.$11
	MNEGL	#1,R0
	BRB	FCALC.IS_RESERVED.$12
FCALC.IS_RESERVED.$11:
	CLRL	R0
FCALC.IS_RESERVED.$12:
	MOVL	R0,FCALC.IS_RESERVED.$T6
	MOVL	FCALC.IS_RESERVED.NAME(AP),R0
	CMPC5	R6,@4(R0),#^A/ /,#4,FCALC.IS_RESERVED.$K7
	BNEQ	FCALC.IS_RESERVED.$13
	MNEGL	#1,R0
	BRB	FCALC.IS_RESERVED.$14
FCALC.IS_RESERVED.$13:
	CLRL	R0
FCALC.IS_RESERVED.$14:
	MOVL	R0,FCALC.IS_RESERVED.$T7
	MOVL	FCALC.IS_RESERVED.NAME(AP),R0
	CMPC5	R6,@4(R0),#^A/ /,#5,FCALC.IS_RESERVED.$K8
	BNEQ	FCALC.IS_RESERVED.$15
	MNEGL	#1,R0
	BRB	FCALC.IS_RESERVED.$16
FCALC.IS_RESERVED.$15:
	CLRL	R0
FCALC.IS_RESERVED.$16:
	MOVL	R0,FCALC.IS_RESERVED.$T8
	MOVL	FCALC.IS_RESERVED.NAME(AP),R0
	CMPC5	R6,@4(R0),#^A/ /,#4,FCALC.IS_RESERVED.$K9
	BNEQ	FCALC.IS_RESERVED.$17
	MNEGL	#1,R0
	BRB	FCALC.IS_RESERVED.$18
FCALC.IS_RESERVED.$17:
	CLRL	R0
FCALC.IS_RESERVED.$18:
	MOVL	R0,FCALC.IS_RESERVED.$T9
;  607    end function is_reserved
	BISL3	FCALC.IS_RESERVED.$T1,FCALC.IS_RESERVED.$T2,R0 ; the function's value
	BISL2	FCALC.IS_RESERVED.$T3,R0
	BISL2	FCALC.IS_RESERVED.$T4,R0
	BISL2	FCALC.IS_RESERVED.$T5,R0
	BISL2	FCALC.IS_RESERVED.$T6,R0
	BISL2	FCALC.IS_RESERVED.$T7,R0
	BISL2	FCALC.IS_RESERVED.$T8,R0
	BISL2	FCALC.IS_RESERVED.$T9,R0
	RET

; Storage map for FCALC.LIST_COMMAND, a subroutine
;   WHAT   TYPE(TOKEN)   $LOCAL+0   FCALC.LIST_COMMAND.WHAT
;   WHICH  CHARACTER*31  $LOCAL+56  FCALC.LIST_COMMAND.WHICH
;

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
	.ALIGN	QUAD			; the boundary of this routine's aligned records
FCALC.LIST_COMMAND.WHAT:
	.BLKL	14			; WHAT
FCALC.LIST_COMMAND.WHICH:
	.BLKB	31			; WHICH
	.BLKB	1
FCALC.LIST_COMMAND.$T1:
	.BLKL	14			; characters, for one statement
FCALC.LIST_COMMAND.$T2:
	.BLKL	1			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCALC.LIST_COMMAND.$K2:
	.LONG	2
FCALC.LIST_COMMAND.$K5:
	.LONG	19
FCALC.LIST_COMMAND.$K6:
	.LONG	1
FCALC.LIST_COMMAND.$K7:
	.LONG	5
FCALC.LIST_COMMAND.$K1:
	.ASCII	/all/
FCALC.LIST_COMMAND.$K3:
	.ASCII	/variables/
FCALC.LIST_COMMAND.$K4:
	.ASCII	/functions/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  608
;  609    ! LIST [VARIABLES | FUNCTIONS | ALL]: with no word, ALL, the variables
;  610    ! and then the functions.
;  611    subroutine list_command()
FCALC.LIST_COMMAND:
	.WORD	^M<R2,R3,R4,R5>		; internal procedure LIST_COMMAND of FCALC
;  612      type(token) :: what
;  613      character(len=name_length) :: which
;  614
;  615      which = 'all'
	MOVC5	#3,FCALC.LIST_COMMAND.$K1,#^A/ /,#31,FCALC.LIST_COMMAND.WHICH
;  616      what = token_at(2)
	PUSHAL	FCALC.LIST_COMMAND.$K2
	PUSHAB	FCALC.LIST_COMMAND.$T1
	CALLS	#2,G^FCTREE.TOKEN_AT
	MOVC3	#56,FCALC.LIST_COMMAND.$T1,FCALC.LIST_COMMAND.WHAT
;  617      if (what%kind == t_name) then
	CMPL	FCALC.LIST_COMMAND.WHAT,#2
	BNEQ	FCALC.LIST_COMMAND.$1
;  618        which = what%text
	MOVC3	#31,FCALC.LIST_COMMAND.WHAT+8,FCALC.LIST_COMMAND.WHICH
;  619        if (which /= 'variables' .and. which /= 'functions' .and. which /= 'all') then
	CMPC5	#31,FCALC.LIST_COMMAND.WHICH,#^A/ /,#9,FCALC.LIST_COMMAND.$K3
	BEQL	FCALC.LIST_COMMAND.$3
	CMPC5	#31,FCALC.LIST_COMMAND.WHICH,#^A/ /,#9,FCALC.LIST_COMMAND.$K4
	BEQL	FCALC.LIST_COMMAND.$3
	CMPC5	#31,FCALC.LIST_COMMAND.WHICH,#^A/ /,#3,FCALC.LIST_COMMAND.$K1
	BEQL	FCALC.LIST_COMMAND.$3
;  620          call fail(e_badcmd, what%column)
	PUSHL	#0
	PUSHAL	FCALC.LIST_COMMAND.WHAT+4
	PUSHAL	FCALC.LIST_COMMAND.$K5
	CALLS	#3,G^FCMESSAGES.FAIL
;  621          return
	RET
FCALC.LIST_COMMAND.$3:
;  622        end if
;  623        call advance(1)
	PUSHAL	FCALC.LIST_COMMAND.$K6
	CALLS	#1,G^FCTREE.ADVANCE
;  624      end if
FCALC.LIST_COMMAND.$1:
;  625      call advance(1)
	PUSHAL	FCALC.LIST_COMMAND.$K6
	CALLS	#1,G^FCTREE.ADVANCE
;  626      if (.not. at_end()) then
	CALLS	#0,G^FCTREE.AT_END
	MOVL	R0,FCALC.LIST_COMMAND.$T2
	BLBS	FCALC.LIST_COMMAND.$T2,FCALC.LIST_COMMAND.$7
;  627        call fail(e_extra, current_column())
	CALLS	#0,G^FCTREE.CURRENT_COLUMN
	MOVL	R0,FCALC.LIST_COMMAND.$T2
	PUSHL	#0
	PUSHAL	FCALC.LIST_COMMAND.$T2
	PUSHAL	FCALC.LIST_COMMAND.$K7
	CALLS	#3,G^FCMESSAGES.FAIL
;  628        return
	RET
FCALC.LIST_COMMAND.$7:
;  629      end if
;  630      if (which /= 'functions') call list_variables()
	CMPC5	#31,FCALC.LIST_COMMAND.WHICH,#^A/ /,#9,FCALC.LIST_COMMAND.$K4
	BEQL	FCALC.LIST_COMMAND.$9
	CALLS	#0,G^FCSYMBOLS.LIST_VARIABLES
FCALC.LIST_COMMAND.$9:
;  631      if (which /= 'variables') call list_functions()
	CMPC5	#31,FCALC.LIST_COMMAND.WHICH,#^A/ /,#9,FCALC.LIST_COMMAND.$K3
	BEQL	FCALC.LIST_COMMAND.$11
	CALLS	#0,G^FCSYMBOLS.LIST_FUNCTIONS
FCALC.LIST_COMMAND.$11:
;  632    end subroutine list_command
	RET

; Storage map for FCALC.CLEAR_COMMAND, a subroutine
;   WHAT  TYPE(TOKEN)  $LOCAL+0   FCALC.CLEAR_COMMAND.WHAT
;   K     INTEGER      $LOCAL+56  FCALC.CLEAR_COMMAND.K
;   GONE  LOGICAL      $LOCAL+60  FCALC.CLEAR_COMMAND.GONE
;   R8 is $T2: temporary
;   R6 is $C1: DO (line 652)'s count
;   R6 is $C2: DO (line 660)'s count
;   R7 is $R1: GONE, during a loop
;

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
	.ALIGN	QUAD			; the boundary of this routine's aligned records
FCALC.CLEAR_COMMAND.WHAT:
	.BLKL	14			; WHAT
FCALC.CLEAR_COMMAND.K:
	.BLKL	1			; K
FCALC.CLEAR_COMMAND.GONE:
	.BLKL	1			; GONE
FCALC.CLEAR_COMMAND.$T1:
	.BLKL	14			; characters, for one statement
FCALC.CLEAR_COMMAND.$T3:
	.BLKL	24			; characters, for one statement

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCALC.CLEAR_COMMAND.$K1:
	.LONG	2
FCALC.CLEAR_COMMAND.$K3:
	.LONG	3
FCALC.CLEAR_COMMAND.$D1:
	.WORD	3			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCALC.CLEAR_COMMAND.$K4
FCALC.CLEAR_COMMAND.$K5:
	.LONG	^X00000000,^X00000000	; 0D0
FCALC.CLEAR_COMMAND.$K6:
	.LONG	20
FCALC.CLEAR_COMMAND.$D2:
	.WORD	31			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCALC.CLEAR_COMMAND.WHAT+8
FCALC.CLEAR_COMMAND.$K7:
	.LONG	18
FCALC.CLEAR_COMMAND.$K2:
	.ASCII	/all/
FCALC.CLEAR_COMMAND.$K4:
	.ASCII	/ans/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  633
;  634    ! CLEAR name... | CLEAR ALL
;  635    subroutine clear_command()
FCALC.CLEAR_COMMAND:
	.WORD	^M<R2,R3,R4,R5,R6,R7,R8> ; internal procedure CLEAR_COMMAND of FCALC
;  636      type(token) :: what
;  637      integer :: k
;  638      logical :: gone
;  639
;  640      what = token_at(2)
	PUSHAL	FCALC.CLEAR_COMMAND.$K1
	PUSHAB	FCALC.CLEAR_COMMAND.$T1
	CALLS	#2,G^FCTREE.TOKEN_AT
	MOVC3	#56,FCALC.CLEAR_COMMAND.$T1,FCALC.CLEAR_COMMAND.WHAT
;  641      if (what%kind == t_name .and. what%text == 'all' .and. kind_at(3) == t_end) then
	PUSHAL	FCALC.CLEAR_COMMAND.$K3
	CALLS	#1,G^FCTREE.KIND_AT
	MOVL	R0,R8
	CMPL	FCALC.CLEAR_COMMAND.WHAT,#2
	BNEQ	FCALC.CLEAR_COMMAND.$1
	CMPC5	#31,FCALC.CLEAR_COMMAND.WHAT+8,#^A/ /,#3,FCALC.CLEAR_COMMAND.$K2
	BNEQ	FCALC.CLEAR_COMMAND.$1
	TSTL	R8
	BNEQ	FCALC.CLEAR_COMMAND.$1
;  642        call clear_variables()
	CALLS	#0,G^FCSYMBOLS.CLEAR_VARIABLES
;  643        call clear_functions()
	CALLS	#0,G^FCSYMBOLS.CLEAR_FUNCTIONS
;  644        call set_variable('ans', real_quantity(0.0_rk))
	PUSHAG	FCALC.CLEAR_COMMAND.$K5
	PUSHAB	FCALC.CLEAR_COMMAND.$T3
	CALLS	#2,G^FCARRAYS.REAL_QUANTITY
	PUSHAB	FCALC.CLEAR_COMMAND.$T3
	PUSHAQ	FCALC.CLEAR_COMMAND.$D1
	CALLS	#2,G^FCSYMBOLS.SET_VARIABLE
;  645        return
	RET
FCALC.CLEAR_COMMAND.$1:
;  646      end if
;  647
;  648      if (what%kind /= t_name) then
	CMPL	FCALC.CLEAR_COMMAND.WHAT,#2
	BEQL	FCALC.CLEAR_COMMAND.$5
;  649        call fail(e_namereq, what%column)
	PUSHL	#0
	PUSHAL	FCALC.CLEAR_COMMAND.WHAT+4
	PUSHAL	FCALC.CLEAR_COMMAND.$K6
	CALLS	#3,G^FCMESSAGES.FAIL
;  650        return
	RET
FCALC.CLEAR_COMMAND.$5:
;  651      end if
;  652      do k = 2, token_count() - 1
	CALLS	#0,G^FCTREE.TOKEN_COUNT
	MOVL	R0,R8
	SUBL3	#2,R8,R6		; DO (line 652)'s count
	MOVL	#2,FCALC.CLEAR_COMMAND.K
	TSTL	R6
	BLEQ	FCALC.CLEAR_COMMAND.$7
FCALC.CLEAR_COMMAND.$9:			; DO (line 652)'s body
;  653        what = token_at(k)
	PUSHAL	FCALC.CLEAR_COMMAND.K
	PUSHAB	FCALC.CLEAR_COMMAND.$T1
	CALLS	#2,G^FCTREE.TOKEN_AT
	MOVC3	#56,FCALC.CLEAR_COMMAND.$T1,FCALC.CLEAR_COMMAND.WHAT
;  654        if (what%kind /= t_name) then
	CMPL	FCALC.CLEAR_COMMAND.WHAT,#2
	BEQL	FCALC.CLEAR_COMMAND.$10
;  655          call fail(e_namereq, what%column)
	PUSHL	#0
	PUSHAL	FCALC.CLEAR_COMMAND.WHAT+4
	PUSHAL	FCALC.CLEAR_COMMAND.$K6
	CALLS	#3,G^FCMESSAGES.FAIL
;  656          return
	RET
FCALC.CLEAR_COMMAND.$10:
;  657        end if
;  658      end do
	INCL	FCALC.CLEAR_COMMAND.K
	SOBGTR	R6,FCALC.CLEAR_COMMAND.$9 ; one pass fewer
FCALC.CLEAR_COMMAND.$7:
;  659      ! A name may be both a variable and a function: CLEAR forgets both.
;  660      do k = 2, token_count() - 1
	CALLS	#0,G^FCTREE.TOKEN_COUNT
	MOVL	R0,R8
	SUBL3	#2,R8,R6		; DO (line 660)'s count
	MOVL	#2,FCALC.CLEAR_COMMAND.K
	TSTL	R6
	BGTR	FCALC.CLEAR_COMMAND.$14
	RET
FCALC.CLEAR_COMMAND.$14:
	MOVL	FCALC.CLEAR_COMMAND.GONE,R7
FCALC.CLEAR_COMMAND.$15:		; DO (line 660)'s body
;  661        what = token_at(k)
	PUSHAL	FCALC.CLEAR_COMMAND.K
	PUSHAB	FCALC.CLEAR_COMMAND.$T1
	CALLS	#2,G^FCTREE.TOKEN_AT
	MOVC3	#56,FCALC.CLEAR_COMMAND.$T1,FCALC.CLEAR_COMMAND.WHAT
;  662        gone = remove_variable(what%text)
	PUSHAQ	FCALC.CLEAR_COMMAND.$D2
	CALLS	#1,G^FCSYMBOLS.REMOVE_VARIABLE
	MOVL	R0,R7
;  663        if (remove_function(what%text)) gone = .true.
	PUSHAQ	FCALC.CLEAR_COMMAND.$D2
	CALLS	#1,G^FCSYMBOLS.REMOVE_FUNCTION
	MOVL	R0,R8
	BLBC	R8,FCALC.CLEAR_COMMAND.$16
	MOVL	#-1,R7
FCALC.CLEAR_COMMAND.$16:
;  664        if (.not. gone) then
	BLBS	R7,FCALC.CLEAR_COMMAND.$18
;  665          call fail(w_notdef, what%column, what%text)
	PUSHAQ	FCALC.CLEAR_COMMAND.$D2
	PUSHAL	FCALC.CLEAR_COMMAND.WHAT+4
	PUSHAL	FCALC.CLEAR_COMMAND.$K7
	CALLS	#3,G^FCMESSAGES.FAIL
;  666          call report()
	PUSHL	#0
	CALLS	#1,G^FCMESSAGES.REPORT
;  667        end if
FCALC.CLEAR_COMMAND.$18:
;  668      end do
	INCL	FCALC.CLEAR_COMMAND.K
	SOBGTR	R6,FCALC.CLEAR_COMMAND.$15 ; one pass fewer
	MOVL	R7,FCALC.CLEAR_COMMAND.GONE
;  669    end subroutine clear_command
	RET

; Storage map for FCALC.SHOW_COMMAND, a subroutine
;   WHAT   TYPE(TOKEN)   $LOCAL+0   FCALC.SHOW_COMMAND.WHAT
;   COUNT  CHARACTER*12  $LOCAL+56  FCALC.SHOW_COMMAND.COUNT
;   K      INTEGER       $LOCAL+68  FCALC.SHOW_COMMAND.K
;   R6 is $T4: temporary
;   R7 is $R1: an index stepped with K
