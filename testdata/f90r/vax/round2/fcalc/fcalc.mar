; Storage map for FCALC.WHOLE_NUMBER, a CHARACTER*12 function
;   TEXT  CHARACTER*12         hidden argument 1  @FCALC.WHOLE_NUMBER.TEXT(AP)
;   N     INTEGER, INTENT(IN)  argument 2         @FCALC.WHOLE_NUMBER.N(AP)
;
FCALC.WHOLE_NUMBER.TEXT = 4		; TEXT's value goes through hidden argument 1
FCALC.WHOLE_NUMBER.N = 8		; N is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCALC.WHOLE_NUMBER.$D1:
	.WORD	12			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used
FCALC.WHOLE_NUMBER.$D3:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_L,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used
FCALC.WHOLE_NUMBER.$T1:
	.BLKL	3			; characters, for one statement

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCALC.WHOLE_NUMBER.$IO1:
	.WORD	8			; an I/O statement's control block: its size
	.WORD	^X0018			; flags: run-time format F90
	.LONG	0			; (not used yet)
FCALC.WHOLE_NUMBER.$D2:
	.WORD	5			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCALC.WHOLE_NUMBER.$K1
FCALC.WHOLE_NUMBER.$D4:
	.WORD	12			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCALC.WHOLE_NUMBER.$T1
FCALC.WHOLE_NUMBER.$K1:
	.ASCII	/(I12)/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  362
;  363    ! WHOLE_NUMBER is N in as few characters as it takes.
;  364    function whole_number(n) result(text)
FCALC.WHOLE_NUMBER:
	.WORD	^M<R2,R3,R4,R5>		; internal procedure WHOLE_NUMBER of FCALC
;  365      integer, intent(in) :: n
;  366      character(len=12) :: text
;  367
;  368      write (text, '(I12)') n
	MOVL	FCALC.WHOLE_NUMBER.TEXT(AP),R0
	MOVAB	@4(R0),FCALC.WHOLE_NUMBER.$D1+4
	PUSHAQ	FCALC.WHOLE_NUMBER.$D2
	PUSHAQ	FCALC.WHOLE_NUMBER.$D1
	PUSHAB	FCALC.WHOLE_NUMBER.$IO1
	CALLS	#3,G^FTN$WRITE_IF
	MOVAL	@FCALC.WHOLE_NUMBER.N(AP),FCALC.WHOLE_NUMBER.$D3+4
	PUSHAQ	FCALC.WHOLE_NUMBER.$D3
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;  369      text = adjustl(text)
	MOVL	FCALC.WHOLE_NUMBER.TEXT(AP),R0
	MOVAB	@4(R0),FCALC.WHOLE_NUMBER.$D1+4
	PUSHAQ	FCALC.WHOLE_NUMBER.$D1
	PUSHAQ	FCALC.WHOLE_NUMBER.$D4
	CALLS	#2,G^FTN$ADJUSTL
	MOVL	FCALC.WHOLE_NUMBER.TEXT(AP),R0
	MOVC3	#12,FCALC.WHOLE_NUMBER.$T1,@4(R0)
;  370    end function whole_number
	RET

; Storage map for FCALC.LOWERCASE, a CHARACTER*(*) function
;   $VALUE  CHARACTER*(LEN(TEXT))      hidden argument 1       @FCALC.LOWERCASE.$VALUE(AP)
;   TEXT    CHARACTER*(*), INTENT(IN)  argument 2              @FCALC.LOWERCASE.TEXT(AP)
;   SMALL   CHARACTER*(LEN(TEXT))      descriptor at $LOCAL+8  FCALC.LOWERCASE.SMALL
;   K       INTEGER                    $LOCAL+0                FCALC.LOWERCASE.K
;   AT      INTEGER                    $LOCAL+4                FCALC.LOWERCASE.AT
;   R8 is $T1: temporary
;   R10 is $L1: DO (line 380)'s limit
;   R11 is $R1: an address in an array
;   R6 is $R2: K, during a loop
;   R7 is $R3: AT, during a loop
;   R9 is $R4: TEXT's address
;
FCALC.LOWERCASE.$VALUE = 4		; $VALUE's value goes through hidden argument 1
FCALC.LOWERCASE.TEXT = 8		; TEXT is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCALC.LOWERCASE.K:
	.BLKL	1			; K
FCALC.LOWERCASE.AT:
	.BLKL	1			; AT
FCALC.LOWERCASE.SMALL:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.LONG	0			; SMALL: not allocated

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCALC.LOWERCASE.$K1:
	.ASCII	/ABCDEFGHIJKLMNOPQRSTUVWXYZ/
FCALC.LOWERCASE.$K2:
	.ASCII	/abcdefghijklmnopqrstuvwxyz/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  371
;  372    ! LOWERCASE is TEXT with its capital letters made small ones, by their
;  373    ! places in two strings (which works in any character set).
;  374    function lowercase(text) result(small)
FCALC.LOWERCASE:
	.WORD	^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11> ; internal procedure LOWERCASE of FCALC
	MOVZWL	@FCALC.LOWERCASE.TEXT(AP),R8
	BGEQ	FCALC.LOWERCASE.$1
	CLRL	R8
FCALC.LOWERCASE.$1:
	CVTLW	R8,FCALC.LOWERCASE.SMALL
	PUSHL	FCALC.LOWERCASE.$VALUE(AP)
	PUSHAQ	FCALC.LOWERCASE.SMALL
	CALLS	#2,G^LIB$SGET1_DD
	MOVL	FCALC.LOWERCASE.$VALUE(AP),R0
	MOVL	4(R0),FCALC.LOWERCASE.SMALL+4
;  375      character(len=*), intent(in) :: text
;  376      character(len=len(text)) :: small
;  377      integer :: k, at
;  378
;  379      small = text
	MOVZWL	@FCALC.LOWERCASE.TEXT(AP),R0
	MOVL	FCALC.LOWERCASE.TEXT(AP),R1
	MOVZWL	FCALC.LOWERCASE.SMALL,R2
	MOVC5	R0,@4(R1),#^A/ /,R2,@FCALC.LOWERCASE.SMALL+4
;  380      do k = 1, len(text)
	MOVZWL	@FCALC.LOWERCASE.TEXT(AP),R10 ; DO (line 380)'s limit
	MOVL	#1,FCALC.LOWERCASE.K
	CMPL	#1,R10
	BGTR	FCALC.LOWERCASE.$3
	MOVL	FCALC.LOWERCASE.TEXT(AP),R0
	MOVL	4(R0),R11
	MOVL	FCALC.LOWERCASE.K,R6
	MOVL	FCALC.LOWERCASE.AT,R7
	MOVL	FCALC.LOWERCASE.TEXT(AP),R9
FCALC.LOWERCASE.$5:			; DO (line 380)'s body
;  381        at = index('ABCDEFGHIJKLMNOPQRSTUVWXYZ', text(k:k))
	MATCHC	#1,-1(R11)[R6],#26,FCALC.LOWERCASE.$K1
	BNEQ	FCALC.LOWERCASE.$6
	SUBL3	R2,#26,R0
	BRB	FCALC.LOWERCASE.$7
FCALC.LOWERCASE.$6:
	CLRL	R0
FCALC.LOWERCASE.$7:
	MOVL	R0,R8
	MOVL	R8,R7
;  382        if (at > 0) small(k:k) = 'abcdefghijklmnopqrstuvwxyz'(at:at)
	BLEQ	FCALC.LOWERCASE.$8
	SUBL3	#1,R6,R0
	MOVB	FCALC.LOWERCASE.$K2-1[R7],@FCALC.LOWERCASE.SMALL+4[R0]
FCALC.LOWERCASE.$8:
;  383      end do
	AOBLEQ	R10,R6,FCALC.LOWERCASE.$5
	MOVL	R6,FCALC.LOWERCASE.K
	MOVL	R7,FCALC.LOWERCASE.AT
FCALC.LOWERCASE.$3:
;  384    end function lowercase
	RET

; Storage map for FCALC.INDEXES_ARRAY, a LOGICAL function
;   NAME           CHARACTER*(*), INTENT(IN)  argument 1  @FCALC.INDEXES_ARRAY.NAME(AP)
;   INDEXES_ARRAY  LOGICAL                    R6          R6
;
FCALC.INDEXES_ARRAY.NAME = 4		; NAME is argument 1

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
	.BLKB	4
FCALC.INDEXES_ARRAY.$T1:
	.BLKL	1			; temporary

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  385
;  386    ! INDEXES_ARRAY: NAME(...) = would assign elements of NAME, a variable
;  387    ! holding an array, rather than define a function: NAME isn't also a
;  388    ! function. So v(k) = 0 assigns an element of the array v, while f(x) =
;  389    ! x^2 defines f.
;  390    logical function indexes_array(name)
FCALC.INDEXES_ARRAY:
	.WORD	^M<R6>			; internal procedure INDEXES_ARRAY of FCALC
;  391      character(len=*), intent(in) :: name
;  392
;  393      indexes_array = holds_array(name)
	PUSHL	FCALC.INDEXES_ARRAY.NAME(AP)
	CALLS	#1,G^FCSYMBOLS.HOLDS_ARRAY
	MOVL	R0,R6
;  394      if (indexes_array) indexes_array = .not. associated(find_function(name))
	BLBC	R6,FCALC.INDEXES_ARRAY.$1
	PUSHL	FCALC.INDEXES_ARRAY.NAME(AP)
	CALLS	#1,G^FCSYMBOLS.FIND_FUNCTION
	MOVL	R0,FCALC.INDEXES_ARRAY.$T1
	CLRL	R0
	TSTL	FCALC.INDEXES_ARRAY.$T1
	BEQL	FCALC.INDEXES_ARRAY.$3
	MNEGL	#1,R0
FCALC.INDEXES_ARRAY.$3:
	MCOML	R0,R6
FCALC.INDEXES_ARRAY.$1:
;  395    end function indexes_array
	MOVL	R6,R0			; the function's value
	RET

; Storage map for FCALC.STATEMENT, a subroutine
;   TREE  TYPE(NODE), POINTER  $LOCAL+0   FCALC.STATEMENT.TREE
;   V     TYPE(QUANTITY)       $LOCAL+16  FCALC.STATEMENT.V
;   R6 is $T1: temporary
;

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
	.ALIGN	4			; the boundary of this routine's aligned records
FCALC.STATEMENT.TREE:
	.BLKL	1			; TREE
	.BLKB	12
FCALC.STATEMENT.V:
	.BLKL	24			; V
FCALC.STATEMENT.$T2:
	.BLKL	1			; temporary
FCALC.STATEMENT.$T3:
	.BLKL	24			; characters, for one statement

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCALC.STATEMENT.$D1:
	.WORD	1			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCALC.STATEMENT.$K1
FCALC.STATEMENT.$K2:
	.LONG	1
FCALC.STATEMENT.$K3:
	.LONG	5
FCALC.STATEMENT.$D2:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCALC.STATEMENT.$K4
FCALC.STATEMENT.$D3:
	.WORD	3			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCALC.STATEMENT.$K5
FCALC.STATEMENT.$K1:
	.ASCII	/=/
FCALC.STATEMENT.$K4:
FCALC.STATEMENT.$K5:
	.ASCII	/ans/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  396
;  397    ! STATEMENT is an expression, whose value is shown and kept as ANS, or an
;  398    ! assignment to elements, V(...) = EXPR: which, the parse of the line's
;  399    ! start says, a call of V followed by =.
;  400    subroutine statement()
FCALC.STATEMENT:
	.WORD	^M<R2,R3,R4,R5,R6>	; internal procedure STATEMENT of FCALC
;  401      type(node), pointer :: tree
;  402      type(quantity) :: v
;  403
;  404      tree => parse_expression()
	CALLS	#0,G^FCTREE.PARSE_EXPRESSION
	MOVL	R0,R6
	MOVL	R6,FCALC.STATEMENT.TREE
;  405      if (failed()) return
	CALLS	#0,G^FCMESSAGES.FAILED
	MOVL	R0,R6
	BLBC	R6,FCALC.STATEMENT.$1
	RET
FCALC.STATEMENT.$1:
;  406      if (is_operator('=') .and. kind_at(1) == t_name .and. tree%kind == n_call) then
	PUSHAQ	FCALC.STATEMENT.$D1
	CALLS	#1,G^FCTREE.IS_OPERATOR
	MOVL	R0,R6
	PUSHAL	FCALC.STATEMENT.$K2
	CALLS	#1,G^FCTREE.KIND_AT
	MOVL	R0,FCALC.STATEMENT.$T2
	BLBC	R6,FCALC.STATEMENT.$3
	CMPL	FCALC.STATEMENT.$T2,#2
	BNEQ	FCALC.STATEMENT.$3
	CMPL	@FCALC.STATEMENT.TREE,#3
	BNEQ	FCALC.STATEMENT.$3
;  407        call element_assignment(tree)
	PUSHAL	FCALC.STATEMENT.TREE
	CALLS	#1,FCALC.ELEMENT_ASSIGNMENT
;  408        return
	RET
FCALC.STATEMENT.$3:
;  409      end if
;  410      if (.not. at_end()) then
	CALLS	#0,G^FCTREE.AT_END
	MOVL	R0,FCALC.STATEMENT.$T2
	BLBS	FCALC.STATEMENT.$T2,FCALC.STATEMENT.$7
;  411        call fail(e_extra, current_column())
	CALLS	#0,G^FCTREE.CURRENT_COLUMN
	MOVL	R0,FCALC.STATEMENT.$T2
	PUSHL	#0
	PUSHAL	FCALC.STATEMENT.$T2
	PUSHAL	FCALC.STATEMENT.$K3
	CALLS	#3,G^FCMESSAGES.FAIL
;  412        call free_tree(tree)
	PUSHAL	FCALC.STATEMENT.TREE
	CALLS	#1,G^FCTREE.FREE_TREE
;  413        return
	RET
FCALC.STATEMENT.$7:
;  414      end if
;  415
;  416      v = evaluate(tree)
	PUSHL	#0
	PUSHAL	FCALC.STATEMENT.TREE
	PUSHAB	FCALC.STATEMENT.$T3
	CALLS	#3,G^FCEVAL.EVALUATE
	MOVC3	#96,FCALC.STATEMENT.$T3,FCALC.STATEMENT.V
;  417      call free_tree(tree)
	PUSHAL	FCALC.STATEMENT.TREE
	CALLS	#1,G^FCTREE.FREE_TREE
;  418      if (failed()) then
	CALLS	#0,G^FCMESSAGES.FAILED
	MOVL	R0,FCALC.STATEMENT.$T2
	BLBC	FCALC.STATEMENT.$T2,FCALC.STATEMENT.$9
;  419        call release(v)
	PUSHAB	FCALC.STATEMENT.V
	CALLS	#1,G^FCARRAYS.RELEASE
;  420        return
	RET
FCALC.STATEMENT.$9:
;  421      end if
;  422      if (.not. quiet) call show_quantity(v, '')
	BLBS	FCALC.QUIET,FCALC.STATEMENT.$11
	PUSHAQ	FCALC.STATEMENT.$D2
	PUSHAB	FCALC.STATEMENT.V
	CALLS	#2,G^FCARRAYS.SHOW_QUANTITY
FCALC.STATEMENT.$11:
;  423      call set_variable('ans', v)
	PUSHAB	FCALC.STATEMENT.V
	PUSHAQ	FCALC.STATEMENT.$D3
	CALLS	#2,G^FCSYMBOLS.SET_VARIABLE
;  424    end subroutine statement
	RET

; Storage map for FCALC.ASSIGNMENT, a subroutine
;   NAME  TYPE(TOKEN), INTENT(IN)  argument 1  @FCALC.ASSIGNMENT.NAME(AP)
;   V     TYPE(QUANTITY)           $LOCAL+0    FCALC.ASSIGNMENT.V
;   R6 is $T1: temporary
;
FCALC.ASSIGNMENT.NAME = 4		; NAME is argument 1

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
	.ALIGN	4			; the boundary of this routine's aligned records
FCALC.ASSIGNMENT.V:
	.BLKL	24			; V
FCALC.ASSIGNMENT.$D1:
	.WORD	31			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCALC.ASSIGNMENT.$K1:
	.LONG	2

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  425
;  426    ! ASSIGNMENT is NAME = EXPR. The variable takes the value: it is shown
;  427    ! first, then given to SET_VARIABLE, which owns it from then on.
;  428    subroutine assignment(name)
FCALC.ASSIGNMENT:
	.WORD	^M<R6>			; internal procedure ASSIGNMENT of FCALC
;  429      type(token), intent(in) :: name
;  430      type(quantity) :: v
;  431
;  432      if (.not. usable_name(name)) return
	PUSHAB	@FCALC.ASSIGNMENT.NAME(AP)
	CALLS	#1,FCALC.USABLE_NAME
	MOVL	R0,R6
	BLBS	R6,FCALC.ASSIGNMENT.$1
	RET
FCALC.ASSIGNMENT.$1:
;  433
;  434      call advance(2)
	PUSHAL	FCALC.ASSIGNMENT.$K1
	CALLS	#1,G^FCTREE.ADVANCE
;  435      if (.not. whole_expression(v)) return
	PUSHAB	FCALC.ASSIGNMENT.V
	CALLS	#1,FCALC.WHOLE_EXPRESSION
	MOVL	R0,R6
	BLBS	R6,FCALC.ASSIGNMENT.$3
	RET
FCALC.ASSIGNMENT.$3:
;  436      if (.not. quiet) call show_quantity(v, name%text)
	BLBS	FCALC.QUIET,FCALC.ASSIGNMENT.$5
	MOVL	FCALC.ASSIGNMENT.NAME(AP),R0
	MOVAB	8(R0),FCALC.ASSIGNMENT.$D1+4
	PUSHAQ	FCALC.ASSIGNMENT.$D1
	PUSHAB	FCALC.ASSIGNMENT.V
	CALLS	#2,G^FCARRAYS.SHOW_QUANTITY
FCALC.ASSIGNMENT.$5:
;  437      call set_variable(name%text, v)
	MOVL	FCALC.ASSIGNMENT.NAME(AP),R0
	MOVAB	8(R0),FCALC.ASSIGNMENT.$D1+4
	PUSHAB	FCALC.ASSIGNMENT.V
	PUSHAQ	FCALC.ASSIGNMENT.$D1
	CALLS	#2,G^FCSYMBOLS.SET_VARIABLE
;  438    end subroutine assignment
	RET

; Storage map for FCALC.ELEMENT_ASSIGNMENT, a subroutine
;   TARGET  TYPE(NODE), POINTER  argument 1  @FCALC.ELEMENT_ASSIGNMENT.TARGET(AP)
;   NAME    TYPE(TOKEN)          $LOCAL+0    FCALC.ELEMENT_ASSIGNMENT.NAME
;   X       TYPE(QUANTITY)       $LOCAL+64   FCALC.ELEMENT_ASSIGNMENT.X
;   Y       TYPE(QUANTITY)       $LOCAL+160  FCALC.ELEMENT_ASSIGNMENT.Y
;   R6 is $T2: temporary
;
FCALC.ELEMENT_ASSIGNMENT.TARGET = 4	; TARGET is argument 1

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
	.ALIGN	4			; the boundary of this routine's aligned records
FCALC.ELEMENT_ASSIGNMENT.NAME:
	.BLKL	14			; NAME
	.BLKB	8
FCALC.ELEMENT_ASSIGNMENT.X:
	.BLKL	24			; X
FCALC.ELEMENT_ASSIGNMENT.Y:
	.BLKL	24			; Y
FCALC.ELEMENT_ASSIGNMENT.$T1:
	.BLKL	14			; characters, for one statement
FCALC.ELEMENT_ASSIGNMENT.$T3:
	.BLKL	24			; characters, for one statement

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCALC.ELEMENT_ASSIGNMENT.$K1:
	.LONG	1
FCALC.ELEMENT_ASSIGNMENT.$D1:
	.WORD	31			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCALC.ELEMENT_ASSIGNMENT.NAME+8
FCALC.ELEMENT_ASSIGNMENT.$K2:
	.LONG	6
FCALC.ELEMENT_ASSIGNMENT.$K3:
	.LONG	^X00000000,^X00000000	; 0D0

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  439
;  440    ! ELEMENT_ASSIGNMENT is V(...) = EXPR, TARGET the tree of V(...): the
;  441    ! elements of the variable V that the indexes name are given EXPR's
;  442    ! value. The variable's value is copied, changed, and set again.
;  443    subroutine element_assignment(target)
FCALC.ELEMENT_ASSIGNMENT:
	.WORD	^M<R2,R3,R4,R5,R6>	; internal procedure ELEMENT_ASSIGNMENT of FCALC
;  444      type(node), pointer :: target
;  445      type(token) :: name
;  446      type(quantity) :: x, y
;  447
;  448      name = token_at(1)
	PUSHAL	FCALC.ELEMENT_ASSIGNMENT.$K1
	PUSHAB	FCALC.ELEMENT_ASSIGNMENT.$T1
	CALLS	#2,G^FCTREE.TOKEN_AT
	MOVC3	#56,FCALC.ELEMENT_ASSIGNMENT.$T1,FCALC.ELEMENT_ASSIGNMENT.NAME
;  449      if (.not. usable_name(name)) then
	PUSHAB	FCALC.ELEMENT_ASSIGNMENT.NAME
	CALLS	#1,FCALC.USABLE_NAME
	MOVL	R0,R6
	BLBS	R6,FCALC.ELEMENT_ASSIGNMENT.$1
;  450        call free_tree(target)
	PUSHAL	@FCALC.ELEMENT_ASSIGNMENT.TARGET(AP)
	CALLS	#1,G^FCTREE.FREE_TREE
;  451        return
	RET
FCALC.ELEMENT_ASSIGNMENT.$1:
;  452      end if
;  453      if (.not. find_variable(name%text, x)) then
	PUSHAB	FCALC.ELEMENT_ASSIGNMENT.X
	PUSHAQ	FCALC.ELEMENT_ASSIGNMENT.$D1
	CALLS	#2,G^FCSYMBOLS.FIND_VARIABLE
	MOVL	R0,R6
	BLBS	R6,FCALC.ELEMENT_ASSIGNMENT.$3
;  454        call fail(e_undefined, name%column, name%text)
	PUSHAQ	FCALC.ELEMENT_ASSIGNMENT.$D1
	PUSHAL	FCALC.ELEMENT_ASSIGNMENT.NAME+4
	PUSHAL	FCALC.ELEMENT_ASSIGNMENT.$K2
	CALLS	#3,G^FCMESSAGES.FAIL
;  455        call free_tree(target)
	PUSHAL	@FCALC.ELEMENT_ASSIGNMENT.TARGET(AP)
	CALLS	#1,G^FCTREE.FREE_TREE
;  456        return
	RET
FCALC.ELEMENT_ASSIGNMENT.$3:
;  457      end if
;  458
;  459      call advance(1)
	PUSHAL	FCALC.ELEMENT_ASSIGNMENT.$K1
	CALLS	#1,G^FCTREE.ADVANCE
;  460      if (whole_expression(y)) then
	PUSHAB	FCALC.ELEMENT_ASSIGNMENT.Y
	CALLS	#1,FCALC.WHOLE_EXPRESSION
	MOVL	R0,R6
	BLBC	R6,FCALC.ELEMENT_ASSIGNMENT.$5
;  461        if (assign_into(x, target, y)) then
	PUSHAB	FCALC.ELEMENT_ASSIGNMENT.Y
	PUSHAL	@FCALC.ELEMENT_ASSIGNMENT.TARGET(AP)
	PUSHAB	FCALC.ELEMENT_ASSIGNMENT.X
	CALLS	#3,G^FCEVAL.ASSIGN_INTO
	MOVL	R0,R6
	BLBC	R6,FCALC.ELEMENT_ASSIGNMENT.$7
;  462          if (.not. quiet) call show_quantity(x, name%text)
	BLBS	FCALC.QUIET,FCALC.ELEMENT_ASSIGNMENT.$9
	PUSHAQ	FCALC.ELEMENT_ASSIGNMENT.$D1
	PUSHAB	FCALC.ELEMENT_ASSIGNMENT.X
	CALLS	#2,G^FCARRAYS.SHOW_QUANTITY
FCALC.ELEMENT_ASSIGNMENT.$9:
;  463          call set_variable(name%text, x)
	PUSHAB	FCALC.ELEMENT_ASSIGNMENT.X
	PUSHAQ	FCALC.ELEMENT_ASSIGNMENT.$D1
	CALLS	#2,G^FCSYMBOLS.SET_VARIABLE
;  464          x = real_quantity(0.0_rk)
	PUSHAG	FCALC.ELEMENT_ASSIGNMENT.$K3
	PUSHAB	FCALC.ELEMENT_ASSIGNMENT.$T3
	CALLS	#2,G^FCARRAYS.REAL_QUANTITY
	MOVC3	#96,FCALC.ELEMENT_ASSIGNMENT.$T3,FCALC.ELEMENT_ASSIGNMENT.X
;  465        end if
FCALC.ELEMENT_ASSIGNMENT.$7:
;  466      end if
FCALC.ELEMENT_ASSIGNMENT.$5:
;  467      call release(y)
	PUSHAB	FCALC.ELEMENT_ASSIGNMENT.Y
	CALLS	#1,G^FCARRAYS.RELEASE
;  468      call release(x)
	PUSHAB	FCALC.ELEMENT_ASSIGNMENT.X
	CALLS	#1,G^FCARRAYS.RELEASE
;  469      call free_tree(target)
	PUSHAL	@FCALC.ELEMENT_ASSIGNMENT.TARGET(AP)
	CALLS	#1,G^FCTREE.FREE_TREE
;  470    end subroutine element_assignment
	RET

; Storage map for FCALC.WHOLE_EXPRESSION, a LOGICAL function
;   V                 TYPE(QUANTITY), INTENT(OUT)  argument 1  @FCALC.WHOLE_EXPRESSION.V(AP)
;   WHOLE_EXPRESSION  LOGICAL                      R6          R6
;   TREE              TYPE(NODE), POINTER          $LOCAL+16   FCALC.WHOLE_EXPRESSION.TREE
;
FCALC.WHOLE_EXPRESSION.V = 4		; V is argument 1

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
	.ALIGN	4			; the boundary of this routine's aligned records
	.BLKB	16
FCALC.WHOLE_EXPRESSION.TREE:
	.BLKL	1			; TREE
FCALC.WHOLE_EXPRESSION.$T1:
	.BLKL	24			; characters, for one statement
