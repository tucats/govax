;   R6 is $T1: temporary
;   R7 is $T2: temporary
;
FCALC.EXECUTE.LINE_TEXT = 4		; LINE_TEXT is argument 1
FCALC.EXECUTE.$D2 = -8			; a descriptor, written whole at each use, in the frame

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCALC.EXECUTE.$D1:
