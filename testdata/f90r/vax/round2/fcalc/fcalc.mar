	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;    1  ! fcalc, a scientific calculator: the main program.
;    2  !
;    3  ! fcalc reads lines at the prompt until QUIT, EXIT, or the end of the
;    4  ! input. A line that starts with a command word is a command; NAME = EXPR
;    5  ! assigns a variable; F(X, Y) = EXPR defines a function; V(I, J) = EXPR
;    6  ! assigns elements of an array; anything else is an expression, whose value
;    7  ! is shown and kept as ANS. A line starting with ! is a comment.
;    8  !
;    9  ! Run as a foreign command with text after its name ($ FCALC 2^10 + 1), it
;   10  ! runs that one line and ends.
;   11  !
;   12  ! The modules each do one part of the work, and this program joins them:
;   13  ! a line is read (READ_LINE), cut into tokens (FCLEXER, through SCAN_LINE),
;   14  ! classified by its first tokens (EXECUTE), parsed into a tree (FCTREE),
;   15  ! and evaluated (FCEVAL); an error anywhere is recorded (FCMESSAGES) and
;   16  ! reported once the line is done. @ (or RUN) and LOAD run a file's lines
;   17  ! the same way, a line at a time (RUN_FILE); FCSTATE reads the files, and
;   18  ! saves the state and keeps the log.
;   19  !
;   20  ! The procedures after CONTAINS are internal procedures of the program:
;   21  ! they see the program's variables (LINE, ECHO, DONE, ...) by host
;   22  ! association, as if declared in each of them, which is how they share
;   23  ! the state of the session without passing it around.
;   24  program fcalc
	.ENTRY	FCALC,^M<R6,R7>
;   25    use fckinds
;   26    use fcmessages
;   27    use fcvalues
;   28    use fcarrays
;   29    use fclexer
;   30    use fctree
;   31    use fceval
;   32    use fcsymbols
;   33    use fcfuncs
;   34    use fcnumeric
;   35    use fcplot
;   36    use fcstate
;   37    use fcplatform, only: foreign_text
;   38    implicit none
;   39
;   40    character(len=line_length + 1) :: line
;   41    integer :: length, status
;   42    logical :: echo, done, echoed, quiet
;   43
;   44    ! DEPTH is how many files of commands are running, one inside another;
;   45    ! LOADING is true while LOAD runs one, whose lines are all quiet;
;   46    ! ABANDON is true after an error in a file, while every file running
;   47    ! ends, each saying where it was.
;   48    integer :: depth
;   49    logical :: loading, abandon
;   50
;   51    echo = .false.
	CLRL	FCALC.ECHO
;   52    done = .false.
	CLRL	FCALC.DONE
;   53    depth = 0
	CLRL	FCALC.DEPTH
;   54    loading = .false.
	CLRL	FCALC.LOADING
;   55    abandon = .false.
	CLRL	FCALC.ABANDON
;   56    call start_symbols()
	CALLS	#0,G^FCSYMBOLS.START_SYMBOLS
;   57    call set_variable('ans', real_quantity(0.0_rk))
	PUSHAG	FCALC.$K2
	PUSHAB	FCALC.$T1
	CALLS	#2,G^FCARRAYS.REAL_QUANTITY
	PUSHAB	FCALC.$T1
	PUSHAQ	FCALC.$D1
	CALLS	#2,G^FCSYMBOLS.SET_VARIABLE
;   58
;   59    ! The foreign command's text, if there is any: that line alone, shown
;   60    ! (if it fails) with the pointer under it at the line's start, and then
;   61    ! fcalc is done. (Not STOP, which on VMS says FORTRAN STOP.)
;   62    call foreign_text(line, length)
	PUSHAL	FCALC.LENGTH
	PUSHAQ	FCALC.$D2
	CALLS	#2,G^FCPLATFORM.FOREIGN_TEXT
;   63    if (length > 0) then
	TSTL	FCALC.LENGTH
	BGTR	FCALC.$2
	BRW	FCALC.$1
FCALC.$2:
;   64      indent = 0
	CLRL	FCALC.INDENT
;   65      if (length > line_length) then
	CMPL	FCALC.LENGTH,#199
	BLEQ	FCALC.$3
;   66        call fail(e_linelong, 0)
	PUSHL	#0
	PUSHAL	FCALC.$K4
	PUSHAL	FCALC.$K3
	CALLS	#3,G^FCMESSAGES.FAIL
;   67        call report()
	PUSHL	#0
	CALLS	#1,G^FCMESSAGES.REPORT
;   68      else
	BRB	FCALC.$5
FCALC.$3:
;   69        call execute(line(:length))
	MOVL	FCALC.LENGTH,R6
	BGEQ	FCALC.$6
	CLRL	R6
FCALC.$6:
	CVTLW	R6,FCALC.$D3
	MOVAB	FCALC.LINE,FCALC.$D3+4
	PUSHAQ	FCALC.$D3
	CALLS	#1,FCALC.EXECUTE
;   70        call report(line(:length))
	MOVL	FCALC.LENGTH,R6
	BGEQ	FCALC.$8
	CLRL	R6
FCALC.$8:
	CVTLW	R6,FCALC.$D3
	MOVAB	FCALC.LINE,FCALC.$D3+4
	PUSHAQ	FCALC.$D3
	CALLS	#1,G^FCMESSAGES.REPORT
;   71      end if
FCALC.$5:
;   72      done = .true.
	MOVL	#-1,FCALC.DONE
;   73    end if
FCALC.$1:
;   74
;   75    do while (.not. done)
	MOVL	FCALC.ECHOED,R7
	BRW	FCALC.$10
FCALC.$11:				; DO (line 75)'s body
;   76      call say_more('fcalc> ')
	PUSHAQ	FCALC.$D4
	CALLS	#1,G^FCMESSAGES.SAY_MORE
;   77      call read_line(line, length, status)
	PUSHL	#0
	PUSHAL	FCALC.STATUS
	PUSHAL	FCALC.LENGTH
	PUSHAQ	FCALC.$D2
	CALLS	#4,G^FCSTATE.READ_LINE
;   78      if (status < 0) then
	TSTL	FCALC.STATUS
	BGEQ	FCALC.$12
	MOVL	R7,FCALC.ECHOED
;   79        ! The end of the input: end the prompt's line.
;   80        call say('')
	PUSHAQ	FCALC.$D5
	CALLS	#1,G^FCMESSAGES.SAY
;   81        exit
	BRW	FCALC.$14
FCALC.$12:
;   82      end if
;   83
;   84      ! A line too long isn't echoed: VMS's FORTRAN gives none of it. A line
;   85      ! the terminal shows itself (it echoes what is typed) goes to the log.
;   86      echoed = echo .and. status == 0
	CLRL	R0
	TSTL	FCALC.STATUS
	BNEQ	FCALC.$15
	MNEGL	#1,R0
FCALC.$15:
	MCOML	R0,R0
	BICL3	R0,FCALC.ECHO,R7
;   87      if (echoed) then
	BLBC	R7,FCALC.$16
;   88        call say(line(:length))
	MOVL	FCALC.LENGTH,R6
	BGEQ	FCALC.$18
	CLRL	R6
FCALC.$18:
	CVTLW	R6,FCALC.$D3
	MOVAB	FCALC.LINE,FCALC.$D3+4
	PUSHAQ	FCALC.$D3
	CALLS	#1,G^FCMESSAGES.SAY
;   89      else if (status == 0) then
	BRB	FCALC.$20
FCALC.$16:
	TSTL	FCALC.STATUS
	BNEQ	FCALC.$21
;   90        call log_line(line(:length))
	MOVL	FCALC.LENGTH,R6
	BGEQ	FCALC.$23
	CLRL	R6
FCALC.$23:
	CVTLW	R6,FCALC.$D3
	MOVAB	FCALC.LINE,FCALC.$D3+4
	PUSHAQ	FCALC.$D3
	CALLS	#1,G^FCMESSAGES.LOG_LINE
;   91      else
	BRB	FCALC.$20
FCALC.$21:
;   92        call log_line('')
	PUSHAQ	FCALC.$D5
	CALLS	#1,G^FCMESSAGES.LOG_LINE
;   93      end if
FCALC.$20:
;   94
;   95      if (status > 0) then
	TSTL	FCALC.STATUS
	BLEQ	FCALC.$25
;   96        call fail(e_linelong, 0)
	PUSHL	#0
	PUSHAL	FCALC.$K4
	PUSHAL	FCALC.$K3
	CALLS	#3,G^FCMESSAGES.FAIL
;   97      else
	BRB	FCALC.$27
FCALC.$25:
;   98        call execute(line(:length))
	MOVL	FCALC.LENGTH,R6
	BGEQ	FCALC.$28
	CLRL	R6
FCALC.$28:
	CVTLW	R6,FCALC.$D3
	MOVAB	FCALC.LINE,FCALC.$D3+4
	PUSHAQ	FCALC.$D3
	CALLS	#1,FCALC.EXECUTE
;   99      end if
FCALC.$27:
;  100
;  101      ! SET ECHO echoes the line that set it.
;  102      if (echo .and. .not. echoed .and. status == 0) call say(line(:length))
	BLBC	FCALC.ECHO,FCALC.$30
	BLBS	R7,FCALC.$30
	TSTL	FCALC.STATUS
	BNEQ	FCALC.$30
	MOVL	FCALC.LENGTH,R6
	BGEQ	FCALC.$34
	CLRL	R6
FCALC.$34:
	CVTLW	R6,FCALC.$D3
	MOVAB	FCALC.LINE,FCALC.$D3+4
	PUSHAQ	FCALC.$D3
	CALLS	#1,G^FCMESSAGES.SAY
FCALC.$30:
;  103
;  104      call report()
	PUSHL	#0
	CALLS	#1,G^FCMESSAGES.REPORT
;  105      abandon = .false.
	CLRL	FCALC.ABANDON
;  106    end do
FCALC.$10:				; DO (line 75)'s test
	BLBS	FCALC.DONE,FCALC.$36	; from line 75
	BRW	FCALC.$11
FCALC.$36:
	MOVL	R7,FCALC.ECHOED
FCALC.$14:
;  107
;  108  contains
	MOVL	#1,R0			; SS$_NORMAL
	RET

; Storage map for FCALC.EXECUTE, a RECURSIVE subroutine
