	.BYTE	DSC$K_DTYPE_L,DSC$K_CLASS_S
	.ADDRESS FCALC.SHOW_COMMAND.$T2
FCALC.SHOW_COMMAND.$D4:
	.WORD	12			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCALC.SHOW_COMMAND.$T3
FCALC.SHOW_COMMAND.$D7:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_L,DSC$K_CLASS_S
	.ADDRESS FCALC.SHOW_COMMAND.$T5
FCALC.SHOW_COMMAND.$D9:
	.WORD	40			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCALC.SHOW_COMMAND.$T7
FCALC.SHOW_COMMAND.$D10:
	.WORD	31			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCALC.SHOW_COMMAND.WHAT+8
FCALC.SHOW_COMMAND.$K5:
	.ASCII	/memory/
FCALC.SHOW_COMMAND.$K6:
	.ASCII	/settings/
FCALC.SHOW_COMMAND.$K7:
	.ASCII	/(I12)/
FCALC.SHOW_COMMAND.$K8:
	.ASCII	/arrays in use: /
FCALC.SHOW_COMMAND.$K9:
	.ASCII	/tree nodes in use: /
FCALC.SHOW_COMMAND.$K10:
	.ASCII	/digits  format  angle   base    seed    echo    /
FCALC.SHOW_COMMAND.$K11:
	.ASCII	/seed/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  670
;  671    ! SHOW MEMORY: how many arrays and tree nodes are in use, so a leak shows.
;  672    ! SHOW SETTINGS: every setting, each as the SET command that makes it, so
;  673    ! the lines may be typed back, or kept in a file and run with @, to set
;  674    ! them again. SHOW DIGITS, FORMAT, ANGLE, BASE, SEED, or ECHO shows one.
;  675    subroutine show_command()
FCALC.SHOW_COMMAND:
