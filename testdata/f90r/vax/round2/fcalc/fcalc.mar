; Storage map for FCALC.RUN_FILE, a RECURSIVE subroutine
;   NAME         CHARACTER*(*), INTENT(IN)  argument 1  @FCALC.RUN_FILE.NAME(AP)
;   COLUMN       INTEGER, INTENT(IN)        argument 2  @FCALC.RUN_FILE.COLUMN(AP)
;   LOAD         LOGICAL, INTENT(IN)        argument 3  @FCALC.RUN_FILE.LOAD(AP)
;   TEXT         CHARACTER*200              FP-576      FCALC.RUN_FILE.TEXT(FP)
;   COUNT        INTEGER                    FP-376      FCALC.RUN_FILE.COUNT(FP)
;   USED         INTEGER                    FP-372      FCALC.RUN_FILE.USED(FP)
;   STATUS       INTEGER                    FP-368      FCALC.RUN_FILE.STATUS(FP)
;   WAS_LOADING  LOGICAL                    FP-364      FCALC.RUN_FILE.WAS_LOADING(FP)
;   SHOWN        LOGICAL                    R7          R7
;   R8 is $T1: temporary
;   R6 is $T6: temporary
;   R9 is $U1: temporary
;   R10 is $U2: temporary
;
FCALC.RUN_FILE.NAME = 4			; NAME is argument 1
FCALC.RUN_FILE.COLUMN = 8		; COLUMN is argument 2
FCALC.RUN_FILE.LOAD = 12		; LOAD is argument 3
FCALC.RUN_FILE.TEXT = -576		; TEXT, in the frame
FCALC.RUN_FILE.COUNT = -376		; COUNT, in the frame
FCALC.RUN_FILE.USED = -372		; USED, in the frame
FCALC.RUN_FILE.STATUS = -368		; STATUS, in the frame
FCALC.RUN_FILE.WAS_LOADING = -364	; WAS_LOADING, in the frame
FCALC.RUN_FILE.$T2 = -356		; temporary, in the frame
FCALC.RUN_FILE.$T3 = -352		; characters, for one statement, in the frame
FCALC.RUN_FILE.$D2 = -256		; a descriptor, written whole at each use, in the frame
FCALC.RUN_FILE.$T4 = -248		; characters, for one statement, in the frame
FCALC.RUN_FILE.$D3 = -40		; a descriptor, written whole at each use, in the frame
FCALC.RUN_FILE.$T5 = -32		; characters, for one statement, in the frame
FCALC.RUN_FILE.$D4 = -20		; a descriptor, written whole at each use, in the frame
FCALC.RUN_FILE.$D5 = -12		; a descriptor, written whole at each use, in the frame
FCALC.RUN_FILE.$T7 = -4			; temporary, in the frame

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCALC.RUN_FILE.$K1:
