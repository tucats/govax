	AOBLEQ	#4,R7,FCALC.SET_COMMAND.$30
	MOVAB	FCALC.SET_COMMAND.$W2,FCALC.SET_COMMAND.$D2+4
	MOVL	#11,FCALC.SET_COMMAND.$D2+20
	MOVL	#1,FCALC.SET_COMMAND.$D2+24
	MOVL	#4,FCALC.SET_COMMAND.$D2+28
	SUBL3	#11,FCALC.SET_COMMAND.$D2+4,FCALC.SET_COMMAND.$D2+16
	MOVL	#44,FCALC.SET_COMMAND.$D2+12
	PUSHAQ	FCALC.SET_COMMAND.$D2
	PUSHAB	FCALC.SET_COMMAND.HOW
	CALLS	#2,FCALC.WORD_INDEX
	MOVL	R0,FCALC.SET_COMMAND.K
;  742        if (k > 0) number_format = k
	BLEQ	FCALC.SET_COMMAND.$32
	MOVL	FCALC.SET_COMMAND.K,FCALC.NUMBER_FORMAT
FCALC.SET_COMMAND.$32:
;  743
;  744      case ('base')
	RET
FCALC.SET_COMMAND.$10:
;  745        if (.not. word_argument(how)) return
	PUSHAB	FCALC.SET_COMMAND.HOW
	CALLS	#1,FCALC.WORD_ARGUMENT
	MOVL	R0,FCALC.SET_COMMAND.$T2
	BLBS	FCALC.SET_COMMAND.$T2,FCALC.SET_COMMAND.$34
	RET
FCALC.SET_COMMAND.$34:
;  746        select case (how%text)
	CMPC5	#31,FCALC.SET_COMMAND.HOW+8,#^A/ /,#7,FCALC.SET_COMMAND.$K14
	BEQL	FCALC.SET_COMMAND.$36
	CMPC5	#31,FCALC.SET_COMMAND.HOW+8,#^A/ /,#3,FCALC.SET_COMMAND.$K15
	BEQL	FCALC.SET_COMMAND.$38
	CMPC5	#31,FCALC.SET_COMMAND.HOW+8,#^A/ /,#11,FCALC.SET_COMMAND.$K16
	BEQL	FCALC.SET_COMMAND.$38
	CMPC5	#31,FCALC.SET_COMMAND.HOW+8,#^A/ /,#5,FCALC.SET_COMMAND.$K17
	BEQL	FCALC.SET_COMMAND.$41
	CMPC5	#31,FCALC.SET_COMMAND.HOW+8,#^A/ /,#6,FCALC.SET_COMMAND.$K18
	BNEQ	FCALC.SET_COMMAND.$45
	BRB	FCALC.SET_COMMAND.$43
FCALC.SET_COMMAND.$36:
;  747        case ('decimal')
;  748          number_base = 10
	MOVL	#10,FCALC.NUMBER_BASE
;  749        case ('hex', 'hexadecimal')
	RET
FCALC.SET_COMMAND.$38:
;  750          number_base = 16
	MOVL	#16,FCALC.NUMBER_BASE
;  751        case ('octal')
	RET
FCALC.SET_COMMAND.$41:
;  752          number_base = 8
	MOVL	#8,FCALC.NUMBER_BASE
;  753        case ('binary')
	RET
FCALC.SET_COMMAND.$43:
;  754          number_base = 2
	MOVL	#2,FCALC.NUMBER_BASE
;  755        case default
	RET
FCALC.SET_COMMAND.$45:
;  756          call fail(e_badset, how%column)
	PUSHL	#0
	PUSHAL	FCALC.SET_COMMAND.HOW+4
	PUSHAL	FCALC.SET_COMMAND.$K2
	CALLS	#3,G^FCMESSAGES.FAIL
;  757        end select
;  758
;  759      case ('digits')
	RET
FCALC.SET_COMMAND.$12:
;  760        ! A whole number of significant digits (or, under FIXED, of places
;  761        ! after the point), 1 to MAX_DIGITS.
;  762        if (whole_argument(1, max_digits, n)) digits = n
	PUSHAL	FCALC.SET_COMMAND.N
	PUSHAL	FCALC.SET_COMMAND.$K20
	PUSHAL	FCALC.SET_COMMAND.$K19
	CALLS	#3,FCALC.WHOLE_ARGUMENT
	MOVL	R0,FCALC.SET_COMMAND.$T2
	BLBC	FCALC.SET_COMMAND.$T2,FCALC.SET_COMMAND.$47
	MOVL	FCALC.SET_COMMAND.N,FCALC.DIGITS
FCALC.SET_COMMAND.$47:
;  763
;  764      case ('seed')
	RET
FCALC.SET_COMMAND.$14:
;  765        if (whole_argument(0, 999999999, n)) call seed_random(n)
	PUSHAL	FCALC.SET_COMMAND.N
	PUSHAL	FCALC.SET_COMMAND.$K22
	PUSHAL	FCALC.SET_COMMAND.$K21
	CALLS	#3,FCALC.WHOLE_ARGUMENT
	MOVL	R0,FCALC.SET_COMMAND.$T2
	BLBC	FCALC.SET_COMMAND.$T2,FCALC.SET_COMMAND.$49
	PUSHAL	FCALC.SET_COMMAND.N
	CALLS	#1,G^FCFUNCS.SEED_RANDOM
FCALC.SET_COMMAND.$49:
;  766
;  767      case default
	RET
FCALC.SET_COMMAND.$16:
;  768        call fail(e_badset, what%column)
	PUSHL	#0
	PUSHAL	FCALC.SET_COMMAND.WHAT+4
	PUSHAL	FCALC.SET_COMMAND.$K2
	CALLS	#3,G^FCMESSAGES.FAIL
;  769      end select
;  770    end subroutine set_command
	RET

; Storage map for FCALC.WORD_ARGUMENT, a LOGICAL function
;   HOW            TYPE(TOKEN), INTENT(OUT)  argument 1  @FCALC.WORD_ARGUMENT.HOW(AP)
;   WORD_ARGUMENT  LOGICAL                   R6          R6
;
FCALC.WORD_ARGUMENT.HOW = 4		; HOW is argument 1

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
	.BLKB	4
FCALC.WORD_ARGUMENT.$T1:
	.BLKL	14			; characters, for one statement
FCALC.WORD_ARGUMENT.$T2:
	.BLKL	1			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCALC.WORD_ARGUMENT.$K1:
	.LONG	3
FCALC.WORD_ARGUMENT.$K2:
	.LONG	17
FCALC.WORD_ARGUMENT.$K3:
	.LONG	4
FCALC.WORD_ARGUMENT.$K4:
	.LONG	5

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  771
;  772    ! WORD_ARGUMENT: SET's third token is a word, HOW, and the line's last.
;  773    logical function word_argument(how)
FCALC.WORD_ARGUMENT:
	.WORD	^M<R2,R3,R4,R5,R6>	; internal procedure WORD_ARGUMENT of FCALC
;  774      type(token), intent(out) :: how
;  775
;  776      word_argument = .false.
	CLRL	R6
;  777      how = token_at(3)
	PUSHAL	FCALC.WORD_ARGUMENT.$K1
	PUSHAB	FCALC.WORD_ARGUMENT.$T1
	CALLS	#2,G^FCTREE.TOKEN_AT
	MOVC3	#56,FCALC.WORD_ARGUMENT.$T1,@FCALC.WORD_ARGUMENT.HOW(AP)
;  778      if (how%kind /= t_name) then
	CMPL	@FCALC.WORD_ARGUMENT.HOW(AP),#2
	BEQL	FCALC.WORD_ARGUMENT.$1
;  779        call fail(e_badset, how%column)
	PUSHL	#0
	MOVL	FCALC.WORD_ARGUMENT.HOW(AP),R0
	PUSHAL	4(R0)
	PUSHAL	FCALC.WORD_ARGUMENT.$K2
	CALLS	#3,G^FCMESSAGES.FAIL
;  780      else if (kind_at(4) /= t_end) then
	BRB	FCALC.WORD_ARGUMENT.$3
FCALC.WORD_ARGUMENT.$1:
	PUSHAL	FCALC.WORD_ARGUMENT.$K3
	CALLS	#1,G^FCTREE.KIND_AT
	MOVL	R0,FCALC.WORD_ARGUMENT.$T2
	BEQL	FCALC.WORD_ARGUMENT.$4
;  781        call fail(e_extra, token_column(4))
	PUSHAL	FCALC.WORD_ARGUMENT.$K3
	CALLS	#1,FCALC.TOKEN_COLUMN
	MOVL	R0,FCALC.WORD_ARGUMENT.$T2
	PUSHL	#0
	PUSHAL	FCALC.WORD_ARGUMENT.$T2
	PUSHAL	FCALC.WORD_ARGUMENT.$K4
	CALLS	#3,G^FCMESSAGES.FAIL
;  782      else
	BRB	FCALC.WORD_ARGUMENT.$3
FCALC.WORD_ARGUMENT.$4:
;  783        word_argument = .true.
	MOVL	#-1,R6
;  784      end if
FCALC.WORD_ARGUMENT.$3:
;  785    end function word_argument
	MOVL	R6,R0			; the function's value
	RET

; Storage map for FCALC.WORD_INDEX, an INTEGER function
;   HOW         TYPE(TOKEN), INTENT(IN)        argument 1  @FCALC.WORD_INDEX.HOW(AP)
;   NAMES       CHARACTER*(*), INTENT(IN) (:)  argument 2  @FCALC.WORD_INDEX.NAMES(AP)
;   WORD_INDEX  INTEGER                        R9          R9
;   K           INTEGER                        $LOCAL+4    FCALC.WORD_INDEX.K
;   R6 is $T1: temporary
;   R10 is $L1: DO (line 795)'s limit
;   R11 is $H1: a value computed before a loop
;   R6 is $R1: an index stepped with K
;   R7 is $R2: K, during a loop
;   R8 is $R3: HOW's address
;
FCALC.WORD_INDEX.HOW = 4		; HOW is argument 1
FCALC.WORD_INDEX.NAMES = 8		; NAMES is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
	.BLKB	4
FCALC.WORD_INDEX.K:
	.BLKL	1			; K
FCALC.WORD_INDEX.$B1:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_NCA
	.LONG	0			; NAMES's bounds: set at each entry point
	.BYTE	0,0,0,1			; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0			; strides, in bytes
	.LONG	0,0			; bounds
FCALC.WORD_INDEX.$T2:
	.BLKL	1			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCALC.WORD_INDEX.$K1:
	.LONG	17

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  786
;  787    ! WORD_INDEX is HOW's place among NAMES, or 0 after an error if it is
;  788    ! none of them.
;  789    integer function word_index(how, names)
FCALC.WORD_INDEX:
	.WORD	^M<R2,R3,R6,R7,R8,R9,R10,R11> ; internal procedure WORD_INDEX of FCALC
	MOVW	@FCALC.WORD_INDEX.NAMES(AP),FCALC.WORD_INDEX.$B1
	MOVL	FCALC.WORD_INDEX.NAMES(AP),R0
	MOVL	4(R0),FCALC.WORD_INDEX.$B1+4
	MOVL	FCALC.WORD_INDEX.NAMES(AP),R0
	CMPB	3(R0),#4
	BEQL	FCALC.WORD_INDEX.$1
	MOVL	FCALC.WORD_INDEX.NAMES(AP),R0
	MOVL	20(R0),FCALC.WORD_INDEX.$B1+20
	MOVL	FCALC.WORD_INDEX.NAMES(AP),R0
	MOVL	FCALC.WORD_INDEX.NAMES(AP),R1
	SUBL3	24(R1),28(R0),R0
	ADDL3	R0,#1,R6
	BRB	FCALC.WORD_INDEX.$3
FCALC.WORD_INDEX.$1:
	MOVZWL	@FCALC.WORD_INDEX.NAMES(AP),FCALC.WORD_INDEX.$B1+20
	MOVL	FCALC.WORD_INDEX.NAMES(AP),R0
	MOVL	20(R0),R6
FCALC.WORD_INDEX.$3:
	MOVL	#1,FCALC.WORD_INDEX.$B1+24
	TSTL	R6
	BGEQ	FCALC.WORD_INDEX.$4
	CLRL	R6
FCALC.WORD_INDEX.$4:
	MOVL	R6,FCALC.WORD_INDEX.$B1+28
	SUBL3	FCALC.WORD_INDEX.$B1+20,FCALC.WORD_INDEX.$B1+4,FCALC.WORD_INDEX.$B1+16
	MOVZWL	@FCALC.WORD_INDEX.NAMES(AP),R0
	MULL3	R0,FCALC.WORD_INDEX.$B1+28,FCALC.WORD_INDEX.$B1+12
;  790      type(token), intent(in) :: how
;  791      character(len=*), intent(in) :: names(:)
;  792      integer :: k
;  793
;  794      word_index = 0
	CLRL	R9
;  795      do k = 1, size(names)
	MOVL	FCALC.WORD_INDEX.$B1+28,R6
	BGEQ	FCALC.WORD_INDEX.$6
	CLRL	R6
FCALC.WORD_INDEX.$6:
	MOVL	R6,FCALC.WORD_INDEX.$T2
	MOVL	FCALC.WORD_INDEX.$T2,R10 ; DO (line 795)'s limit
	MOVL	#1,FCALC.WORD_INDEX.K
	CMPL	#1,R10
	BGTR	FCALC.WORD_INDEX.$8
	MOVZWL	@FCALC.WORD_INDEX.NAMES(AP),R11 ; from line 796
	MULL3	FCALC.WORD_INDEX.K,FCALC.WORD_INDEX.$B1+20,R0
	ADDL3	FCALC.WORD_INDEX.$B1+16,R0,R6
	MOVL	FCALC.WORD_INDEX.K,R7
	MOVL	FCALC.WORD_INDEX.HOW(AP),R8
FCALC.WORD_INDEX.$10:			; DO (line 795)'s body
;  796        if (names(k) == how%text) word_index = k
	CMPC5	R11,(R6),#^A/ /,#31,8(R8)
	BNEQ	FCALC.WORD_INDEX.$11
	MOVL	R7,R9
FCALC.WORD_INDEX.$11:
;  797      end do
	ADDL2	FCALC.WORD_INDEX.$B1+20,R6
	AOBLEQ	R10,R7,FCALC.WORD_INDEX.$10
	MOVL	R7,FCALC.WORD_INDEX.K
FCALC.WORD_INDEX.$8:
;  798      if (word_index == 0) call fail(e_badset, how%column)
	TSTL	R9
	BNEQ	FCALC.WORD_INDEX.$14
	PUSHL	#0
	MOVL	FCALC.WORD_INDEX.HOW(AP),R0
	PUSHAL	4(R0)
	PUSHAL	FCALC.WORD_INDEX.$K1
	CALLS	#3,G^FCMESSAGES.FAIL
FCALC.WORD_INDEX.$14:
;  799    end function word_index
	MOVL	R9,R0			; the function's value
	RET

; Storage map for FCALC.WHOLE_ARGUMENT, a LOGICAL function
;   LOW             INTEGER, INTENT(IN)   argument 1  @FCALC.WHOLE_ARGUMENT.LOW(AP)
;   HIGH            INTEGER, INTENT(IN)   argument 2  @FCALC.WHOLE_ARGUMENT.HIGH(AP)
;   N               INTEGER, INTENT(OUT)  argument 3  @FCALC.WHOLE_ARGUMENT.N(AP)
;   WHOLE_ARGUMENT  LOGICAL               R6          R6
;   HOW             TYPE(TOKEN)           $LOCAL+8    FCALC.WHOLE_ARGUMENT.HOW
;
FCALC.WHOLE_ARGUMENT.LOW = 4		; LOW is argument 1
FCALC.WHOLE_ARGUMENT.HIGH = 8		; HIGH is argument 2
FCALC.WHOLE_ARGUMENT.N = 12		; N is argument 3

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
	.ALIGN	QUAD			; the boundary of this routine's aligned records
	.BLKB	8
FCALC.WHOLE_ARGUMENT.HOW:
	.BLKL	14			; HOW
FCALC.WHOLE_ARGUMENT.$T1:
	.BLKL	14			; characters, for one statement
FCALC.WHOLE_ARGUMENT.$T2:
	.BLKL	1			; temporary
FCALC.WHOLE_ARGUMENT.$T3:
	.BLKL	2			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCALC.WHOLE_ARGUMENT.$K1:
	.LONG	3
FCALC.WHOLE_ARGUMENT.$K3:
	.LONG	4
FCALC.WHOLE_ARGUMENT.$K4:
	.LONG	11
FCALC.WHOLE_ARGUMENT.$K5:
	.LONG	17
FCALC.WHOLE_ARGUMENT.$K6:
	.LONG	5
FCALC.WHOLE_ARGUMENT.$K2:
	.ASCII	/-/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  800
;  801    ! WHOLE_ARGUMENT: SET's third token is a whole number from LOW to HIGH,
;  802    ! N, and the line's last. (A minus sign is a token of its own, so a
;  803    ! negative number is out of range at the sign.)
;  804    logical function whole_argument(low, high, n)
FCALC.WHOLE_ARGUMENT:
	.WORD	^M<R2,R3,R4,R5,R6>	; internal procedure WHOLE_ARGUMENT of FCALC
;  805      integer, intent(in) :: low, high
;  806      integer, intent(out) :: n
;  807      type(token) :: how
;  808
;  809      whole_argument = .false.
	CLRL	R6
;  810      n = 0
	CLRL	@FCALC.WHOLE_ARGUMENT.N(AP)
;  811      how = token_at(3)
	PUSHAL	FCALC.WHOLE_ARGUMENT.$K1
	PUSHAB	FCALC.WHOLE_ARGUMENT.$T1
	CALLS	#2,G^FCTREE.TOKEN_AT
	MOVC3	#56,FCALC.WHOLE_ARGUMENT.$T1,FCALC.WHOLE_ARGUMENT.HOW
;  812      if (how%kind == t_operator .and. how%text == '-' .and. kind_at(4) == t_number) then
	PUSHAL	FCALC.WHOLE_ARGUMENT.$K3
	CALLS	#1,G^FCTREE.KIND_AT
	MOVL	R0,FCALC.WHOLE_ARGUMENT.$T2
	CMPL	FCALC.WHOLE_ARGUMENT.HOW,#3
	BNEQ	FCALC.WHOLE_ARGUMENT.$1
	CMPC5	#31,FCALC.WHOLE_ARGUMENT.HOW+8,#^A/ /,#1,FCALC.WHOLE_ARGUMENT.$K2
	BNEQ	FCALC.WHOLE_ARGUMENT.$1
	CMPL	FCALC.WHOLE_ARGUMENT.$T2,#1
	BNEQ	FCALC.WHOLE_ARGUMENT.$1
;  813        call fail(e_domain, how%column)
	PUSHL	#0
	PUSHAL	FCALC.WHOLE_ARGUMENT.HOW+4
	PUSHAL	FCALC.WHOLE_ARGUMENT.$K4
	CALLS	#3,G^FCMESSAGES.FAIL
;  814      else if (how%kind /= t_number .or. how%imaginary) then
	BRW	FCALC.WHOLE_ARGUMENT.$5
FCALC.WHOLE_ARGUMENT.$1:
	CMPL	FCALC.WHOLE_ARGUMENT.HOW,#1
	BNEQ	FCALC.WHOLE_ARGUMENT.$7
	BLBC	FCALC.WHOLE_ARGUMENT.HOW+48,FCALC.WHOLE_ARGUMENT.$6
FCALC.WHOLE_ARGUMENT.$7:
;  815        call fail(e_badset, how%column)
	PUSHL	#0
	PUSHAL	FCALC.WHOLE_ARGUMENT.HOW+4
	PUSHAL	FCALC.WHOLE_ARGUMENT.$K5
	CALLS	#3,G^FCMESSAGES.FAIL
;  816      else if (kind_at(4) /= t_end) then
	BRW	FCALC.WHOLE_ARGUMENT.$5
FCALC.WHOLE_ARGUMENT.$6:
	PUSHAL	FCALC.WHOLE_ARGUMENT.$K3
	CALLS	#1,G^FCTREE.KIND_AT
	MOVL	R0,FCALC.WHOLE_ARGUMENT.$T2
	BEQL	FCALC.WHOLE_ARGUMENT.$10
;  817        call fail(e_extra, token_column(4))
	PUSHAL	FCALC.WHOLE_ARGUMENT.$K3
	CALLS	#1,FCALC.TOKEN_COLUMN
	MOVL	R0,FCALC.WHOLE_ARGUMENT.$T2
	PUSHL	#0
	PUSHAL	FCALC.WHOLE_ARGUMENT.$T2
	PUSHAL	FCALC.WHOLE_ARGUMENT.$K6
	CALLS	#3,G^FCMESSAGES.FAIL
;  818      else if (aint(how%number) /= how%number .or. how%number < low .or. &
;  819          how%number > high) then
	BRB	FCALC.WHOLE_ARGUMENT.$5
FCALC.WHOLE_ARGUMENT.$10:
	PUSHAG	FCALC.WHOLE_ARGUMENT.HOW+40
	CALLS	#1,G^MTH$GINT
	MOVG	R0,FCALC.WHOLE_ARGUMENT.$T3
	CMPG	FCALC.WHOLE_ARGUMENT.$T3,FCALC.WHOLE_ARGUMENT.HOW+40
	BNEQ	FCALC.WHOLE_ARGUMENT.$13
	CVTLG	@FCALC.WHOLE_ARGUMENT.LOW(AP),R0
	CMPG	FCALC.WHOLE_ARGUMENT.HOW+40,R0
	BLSS	FCALC.WHOLE_ARGUMENT.$13
	CVTLG	@FCALC.WHOLE_ARGUMENT.HIGH(AP),R0
	CMPG	FCALC.WHOLE_ARGUMENT.HOW+40,R0
	BLEQ	FCALC.WHOLE_ARGUMENT.$12
FCALC.WHOLE_ARGUMENT.$13:
;  820        call fail(e_domain, how%column)
	PUSHL	#0
	PUSHAL	FCALC.WHOLE_ARGUMENT.HOW+4
	PUSHAL	FCALC.WHOLE_ARGUMENT.$K4
	CALLS	#3,G^FCMESSAGES.FAIL
;  821      else
	BRB	FCALC.WHOLE_ARGUMENT.$5
FCALC.WHOLE_ARGUMENT.$12:
;  822        n = nint(how%number)
	CVTRGL	FCALC.WHOLE_ARGUMENT.HOW+40,@FCALC.WHOLE_ARGUMENT.N(AP)
;  823        whole_argument = .true.
	MOVL	#-1,R6
;  824      end if
FCALC.WHOLE_ARGUMENT.$5:
;  825    end function whole_argument
	MOVL	R6,R0			; the function's value
	RET

