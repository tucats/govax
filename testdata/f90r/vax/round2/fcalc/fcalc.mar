	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  109
;  110    ! EXECUTE runs one line. A line ending in ; is quiet: an expression's
;  111    ! value, an assignment, or a definition is made but not shown, as in
;  112    ! MATLAB and Octave (a ; in brackets separates a matrix's rows, but none
;  113    ! ends a line).
;  114    !
;  115    ! EXECUTE, RUN, and RUN_FILE are RECURSIVE: a line may be @file, whose
;  116    ! lines EXECUTE runs while the first call is still active. Without
;  117    ! RECURSIVE, a compiler may keep a procedure's local variables in one
;  118    ! fixed place (the VAX's FORTRAN does), which a second, inner call would
;  119    ! overwrite.
;  120    recursive subroutine execute(line_text)
FCALC.EXECUTE:
	.WORD	^M<R2,R6,R7,R8,R9>	; internal procedure EXECUTE of FCALC
	SUBL2	#16,SP			; this activation's own storage
;  121      character(len=*), intent(in) :: line_text
;  122      integer :: k, last
;  123
;  124      if (len_trim(line_text) == 0) return
	MOVL	FCALC.EXECUTE.LINE_TEXT(AP),R0
	MOVAB	@4(R0),R6
	MOVZWL	@FCALC.EXECUTE.LINE_TEXT(AP),R7
	BRB	FCALC.EXECUTE.$1
FCALC.EXECUTE.$2:
	CMPB	-1(R6)[R7],#32
	BNEQ	FCALC.EXECUTE.$3
	DECL	R7
FCALC.EXECUTE.$1:
	TSTL	R7			; from line 124
	BNEQ	FCALC.EXECUTE.$2
FCALC.EXECUTE.$3:
	TSTL	R7
	BNEQ	FCALC.EXECUTE.$6
	RET
FCALC.EXECUTE.$6:
;  125      k = verify(line_text, ' ' // achar(9))
	PUSHAL	FCALC.EXECUTE.$K2
	PUSHAQ	FCALC.EXECUTE.$D1
	PUSHL	FCALC.EXECUTE.LINE_TEXT(AP)
	CALLS	#3,G^FTN$VERIFY
	MOVL	R0,R7
	MOVL	R7,R9
;  126      if (line_text(k:k) == '!') return
	MOVL	FCALC.EXECUTE.LINE_TEXT(AP),R0
	SUBL3	#1,R9,R1
	CMPB	@4(R0)[R1],#33
	BNEQ	FCALC.EXECUTE.$8
	RET
FCALC.EXECUTE.$8:
;  127
;  128      last = len_trim(line_text)
	MOVL	FCALC.EXECUTE.LINE_TEXT(AP),R0
	MOVAB	@4(R0),R7
	MOVZWL	@FCALC.EXECUTE.LINE_TEXT(AP),R6
	BRB	FCALC.EXECUTE.$10
FCALC.EXECUTE.$11:
	CMPB	-1(R7)[R6],#32
	BNEQ	FCALC.EXECUTE.$12
	DECL	R6
FCALC.EXECUTE.$10:
	TSTL	R6			; from line 128
	BNEQ	FCALC.EXECUTE.$11
FCALC.EXECUTE.$12:
	MOVL	R6,R8
;  129      quiet = line_text(last:last) == ';'
	MOVL	FCALC.EXECUTE.LINE_TEXT(AP),R0
	SUBL3	#1,R8,R1
	CLRL	R2
	CMPB	@4(R0)[R1],#59
	BNEQ	FCALC.EXECUTE.$15
	MNEGL	#1,R2
FCALC.EXECUTE.$15:
	MOVL	R2,FCALC.QUIET
;  130      if (quiet) last = last - 1
	BLBC	FCALC.QUIET,FCALC.EXECUTE.$16
	DECL	R8
FCALC.EXECUTE.$16:
;  131      if (loading) quiet = .true.
	BLBC	FCALC.LOADING,FCALC.EXECUTE.$18
	MOVL	#-1,FCALC.QUIET
FCALC.EXECUTE.$18:
;  132      call run(line_text(:last))
	MOVL	R8,R6
	BGEQ	FCALC.EXECUTE.$20
	CLRL	R6
FCALC.EXECUTE.$20:
	MOVL	#17694720,FCALC.EXECUTE.$D2(FP) ; the descriptor's length, 0, type, and class
	CVTLW	R6,FCALC.EXECUTE.$D2(FP)
	MOVL	FCALC.EXECUTE.LINE_TEXT(AP),R0
	MOVAB	@4(R0),FCALC.EXECUTE.$D2+4(FP)
	PUSHAQ	FCALC.EXECUTE.$D2(FP)
	CALLS	#1,FCALC.RUN
;  133    end subroutine execute
	RET

