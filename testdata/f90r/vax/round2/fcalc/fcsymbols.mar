	MOVL	FCSYMBOLS.REMOVE_FUNCTION.$N32,R0 ; the function's value
	RET

; Storage map for FCSYMBOLS.UNLINK, a RECURSIVE subroutine
;   T          TYPE(FUNCTION_ENTRY), POINTER  argument 1  @FCSYMBOLS.UNLINK.T(AP)
;   NAME       CHARACTER*(*), INTENT(IN)      argument 2  @FCSYMBOLS.UNLINK.NAME(AP)
;   FOUND      LOGICAL, INTENT(INOUT)         argument 3  @FCSYMBOLS.UNLINK.FOUND(AP)
;   GONE       TYPE(FUNCTION_ENTRY), POINTER  FP-12       FCSYMBOLS.UNLINK.GONE(FP)
