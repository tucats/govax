; Storage map for FCSYMBOLS.HEADING, a CHARACTER*297 function
;   TEXT  CHARACTER*297                  hidden argument 1  @FCSYMBOLS.HEADING.TEXT(AP)
;   T     TYPE(FUNCTION_ENTRY), POINTER  argument 2         @FCSYMBOLS.HEADING.T(AP)
;   K     INTEGER                        $LOCAL+0           FCSYMBOLS.HEADING.K
;   R7 is $T1: temporary
;   R8 is $T2: temporary
;   R6 is $T3: temporary
;   R10 is $R1: an index stepped with K
;   R9 is $R2: TEXT's address
;   R11 is $R3: T's address
;
FCSYMBOLS.HEADING.TEXT = 4		; TEXT's value goes through hidden argument 1
FCSYMBOLS.HEADING.T = 8			; T is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCSYMBOLS.HEADING.K:
	.BLKL	1			; K
FCSYMBOLS.HEADING.$D1:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_D
	.LONG	0			; set when the descriptor is used
FCSYMBOLS.HEADING.$T4:
	.BLKB	2			; temporary
	.BLKB	2
FCSYMBOLS.HEADING.$L1:
	.BLKL	1			; DO (line 461)'s limit
FCSYMBOLS.HEADING.$U1:
	.BLKL	1			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCSYMBOLS.HEADING.$K2:
	.ASCII	/, /

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  453
;  454    ! HEADING is a function's name and parameters, as f(x, y).
;  455    function heading(t) result(text)
	.ENTRY	FCSYMBOLS.HEADING,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
;  456      type(function_entry), pointer :: t
;  457      character(len=name_length * (max_params + 1) + 2 * max_params + 2) :: text
;  458      integer :: k
;  459
;  460      text = trim(t%name) // '('
	MOVL	@FCSYMBOLS.HEADING.T(AP),R0
	MOVAB	(R0),R7
	MOVAB	(R7),R8
	MOVL	#31,R6
	BRB	FCSYMBOLS.HEADING.$1
FCSYMBOLS.HEADING.$2:
	CMPB	-1(R8)[R6],#32
	BNEQ	FCSYMBOLS.HEADING.$3
	DECL	R6
FCSYMBOLS.HEADING.$1:
	TSTL	R6			; from line 460
	BNEQ	FCSYMBOLS.HEADING.$2
FCSYMBOLS.HEADING.$3:
	ADDL3	R6,#1,R0
	CVTLW	R0,FCSYMBOLS.HEADING.$T4
	PUSHAQ	FCSYMBOLS.HEADING.$D1
	PUSHAW	FCSYMBOLS.HEADING.$T4
	CALLS	#2,G^LIB$SGET1_DD
	MOVC3	R6,(R7),@FCSYMBOLS.HEADING.$D1+4
	MOVB	#40,@FCSYMBOLS.HEADING.$D1+4[R6]
	ADDL3	R6,#1,R0
	MOVL	FCSYMBOLS.HEADING.TEXT(AP),R1
	MOVC5	R0,@FCSYMBOLS.HEADING.$D1+4,#^A/ /,#297,@4(R1)
	PUSHAQ	FCSYMBOLS.HEADING.$D1
	CALLS	#1,G^LIB$SFREE1_DD
;  461      do k = 1, t%count
	MOVL	@FCSYMBOLS.HEADING.T(AP),R0 ; DO (line 461)'s limit
	MOVL	32(R0),FCSYMBOLS.HEADING.$L1
	MOVL	#1,FCSYMBOLS.HEADING.K
	CMPL	#1,FCSYMBOLS.HEADING.$L1
	BLEQ	FCSYMBOLS.HEADING.$7
	BRW	FCSYMBOLS.HEADING.$6
FCSYMBOLS.HEADING.$7:
	MULL3	FCSYMBOLS.HEADING.K,#31,R10
	MOVL	FCSYMBOLS.HEADING.TEXT(AP),R9
	MOVL	FCSYMBOLS.HEADING.T(AP),R11
FCSYMBOLS.HEADING.$8:			; DO (line 461)'s body
;  462        ! (TRIM would take off the blank after a comma, so the comma and
;  463        ! the next name are added together.)
;  464        if (k == 1) then
	CMPL	FCSYMBOLS.HEADING.K,#1
	BNEQ	FCSYMBOLS.HEADING.$9
;  465          text = trim(text) // t%params(k)
	MOVAB	@4(R9),R6
	MOVAB	(R6),R8
	MOVL	#297,R7
	BRB	FCSYMBOLS.HEADING.$11
FCSYMBOLS.HEADING.$12:
	CMPB	-1(R8)[R7],#32
	BNEQ	FCSYMBOLS.HEADING.$13
	DECL	R7
FCSYMBOLS.HEADING.$11:
	TSTL	R7			; from line 465
	BNEQ	FCSYMBOLS.HEADING.$12
FCSYMBOLS.HEADING.$13:
	ADDL3	R7,#31,FCSYMBOLS.HEADING.$U1
	CVTLW	FCSYMBOLS.HEADING.$U1,FCSYMBOLS.HEADING.$T4
	PUSHAQ	FCSYMBOLS.HEADING.$D1
	PUSHAW	FCSYMBOLS.HEADING.$T4
	CALLS	#2,G^LIB$SGET1_DD
	MOVC3	R7,(R6),@FCSYMBOLS.HEADING.$D1+4
	ADDL3	R10,#5,R0
	MOVC3	#31,@(R11)[R0],@FCSYMBOLS.HEADING.$D1+4[R7]
	MOVC5	FCSYMBOLS.HEADING.$U1,@FCSYMBOLS.HEADING.$D1+4,#^A/ /,#297,@4(R9)
	PUSHAQ	FCSYMBOLS.HEADING.$D1
	CALLS	#1,G^LIB$SFREE1_DD
;  466        else
	BRW	FCSYMBOLS.HEADING.$16
FCSYMBOLS.HEADING.$9:
;  467          text = trim(text) // ', ' // t%params(k)
	MOVAB	@4(R9),R7
	MOVAB	(R7),R8
	MOVL	#297,R6
	BRB	FCSYMBOLS.HEADING.$17
FCSYMBOLS.HEADING.$18:
	CMPB	-1(R8)[R6],#32
	BNEQ	FCSYMBOLS.HEADING.$19
	DECL	R6
FCSYMBOLS.HEADING.$17:
	TSTL	R6			; from line 467
	BNEQ	FCSYMBOLS.HEADING.$18
FCSYMBOLS.HEADING.$19:
	ADDL3	R6,#33,FCSYMBOLS.HEADING.$U1
	CVTLW	FCSYMBOLS.HEADING.$U1,FCSYMBOLS.HEADING.$T4
	PUSHAQ	FCSYMBOLS.HEADING.$D1
	PUSHAW	FCSYMBOLS.HEADING.$T4
	CALLS	#2,G^LIB$SGET1_DD
	MOVC3	R6,(R7),@FCSYMBOLS.HEADING.$D1+4
	MOVC3	#2,FCSYMBOLS.HEADING.$K2,@FCSYMBOLS.HEADING.$D1+4[R6]
	ADDL3	R10,#5,R0
	ADDL3	R6,#2,R1
	MOVC3	#31,@(R11)[R0],@FCSYMBOLS.HEADING.$D1+4[R1]
	MOVC5	FCSYMBOLS.HEADING.$U1,@FCSYMBOLS.HEADING.$D1+4,#^A/ /,#297,@4(R9)
	PUSHAQ	FCSYMBOLS.HEADING.$D1
	CALLS	#1,G^LIB$SFREE1_DD
;  468        end if
FCSYMBOLS.HEADING.$16:
;  469      end do
	ADDL2	#31,R10
	ACBL	FCSYMBOLS.HEADING.$L1,#1,FCSYMBOLS.HEADING.K,FCSYMBOLS.HEADING.$8
FCSYMBOLS.HEADING.$6:
;  470      text = trim(text) // ')'
	MOVL	FCSYMBOLS.HEADING.TEXT(AP),R0
	MOVAB	@4(R0),R6
	MOVAB	(R6),R8
	MOVL	#297,R7
	BRB	FCSYMBOLS.HEADING.$23
FCSYMBOLS.HEADING.$24:
	CMPB	-1(R8)[R7],#32
	BNEQ	FCSYMBOLS.HEADING.$25
	DECL	R7
FCSYMBOLS.HEADING.$23:
	TSTL	R7			; from line 470
	BNEQ	FCSYMBOLS.HEADING.$24
FCSYMBOLS.HEADING.$25:
	ADDL3	R7,#1,R0
	CVTLW	R0,FCSYMBOLS.HEADING.$T4
	PUSHAQ	FCSYMBOLS.HEADING.$D1
	PUSHAW	FCSYMBOLS.HEADING.$T4
	CALLS	#2,G^LIB$SGET1_DD
	MOVC3	R7,(R6),@FCSYMBOLS.HEADING.$D1+4
	MOVB	#41,@FCSYMBOLS.HEADING.$D1+4[R7]
	ADDL3	R7,#1,R0
	MOVL	FCSYMBOLS.HEADING.TEXT(AP),R1
	MOVC5	R0,@FCSYMBOLS.HEADING.$D1+4,#^A/ /,#297,@4(R1)
	PUSHAQ	FCSYMBOLS.HEADING.$D1
	CALLS	#1,G^LIB$SFREE1_DD
;  471    end function heading
	RET

; Storage map for FCSYMBOLS.EACH_FUNCTION, a subroutine
;   ACTION  (invalid)  an argument  @FCSYMBOLS.EACH_FUNCTION.$A1
;

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCSYMBOLS.EACH_FUNCTION.$A1:
	.BLKL	1			; ACTION's longword of the argument list, set at each entry point

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  472
;  473    ! EACH_FUNCTION calls ACTION(HEAD, TEXT) for each function, in name
;  474    ! order: HEAD is f(x, y), and TEXT the expression as it was typed.
;  475    subroutine each_function(action)
	.ENTRY	FCSYMBOLS.EACH_FUNCTION,^M<>
