	MOVC5	#1,FCSYMBOLS.DEFINE_FUNCTION..$N21,#^A/ /,#31,@(R8)[R0]
	ADDL2	#31,R7
	AOBLEQ	#8,R6,FCSYMBOLS.DEFINE_FUNCTION..$N20
;  367        t%params(1:count) = params(1:count)
