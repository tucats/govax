;  484    contains
	RET

; Storage map for FCSYMBOLS.EACH_FUNCTION.VISIT, a RECURSIVE subroutine
;   T     TYPE(FUNCTION_ENTRY), POINTER  argument 1  @FCSYMBOLS.EACH_FUNCTION.VISIT.T(AP)
;   R10 is $T2: temporary
;   R8 is $T3: temporary
;   R6 is $T4: temporary
;   R11 is $T5: temporary
;   R9 is $T6: temporary
;   R7 is $T7: temporary
;   FCSYMBOLS.EACH_FUNCTION.VI.$N33 is FCSYMBOLS.EACH_FUNCTION.VISIT.$1
;   FCSYMBOLS.EACH_FUNCTION.VI.$N34 is FCSYMBOLS.EACH_FUNCTION.VISIT.$2
;   FCSYMBOLS.EACH_FUNCTION.VI.$N35 is FCSYMBOLS.EACH_FUNCTION.VISIT.$D1
;   FCSYMBOLS.EACH_FUNCTION.VI.$N36 is FCSYMBOLS.EACH_FUNCTION.VISIT.$T1
;   FCSYMBOLS.EACH_FUNCTION.VI.$N37 is FCSYMBOLS.EACH_FUNCTION.VISIT.$3
;   FCSYMBOLS.EACH_FUNCTION.VI.$N38 is FCSYMBOLS.EACH_FUNCTION.VISIT.$4
;   FCSYMBOLS.EACH_FUNCTION.VI.$N39 is FCSYMBOLS.EACH_FUNCTION.VISIT.$5
;   FCSYMBOLS.EACH_FUNCTION.VI.$N40 is FCSYMBOLS.EACH_FUNCTION.VISIT.$6
;   FCSYMBOLS.EACH_FUNCTION.VI.$N41 is FCSYMBOLS.EACH_FUNCTION.VISIT.$7
;   FCSYMBOLS.EACH_FUNCTION.VI.$N42 is FCSYMBOLS.EACH_FUNCTION.VISIT.$D2
;   FCSYMBOLS.EACH_FUNCTION.VI.$N43 is FCSYMBOLS.EACH_FUNCTION.VISIT.$8
;   FCSYMBOLS.EACH_FUNCTION.VI.$N44 is FCSYMBOLS.EACH_FUNCTION.VISIT.$9
;   FCSYMBOLS.EACH_FUNCTION.VI.$N45 is FCSYMBOLS.EACH_FUNCTION.VISIT.$10
;   FCSYMBOLS.EACH_FUNCTION.VI.$N46 is FCSYMBOLS.EACH_FUNCTION.VISIT.$11
;   FCSYMBOLS.EACH_FUNCTION.VI.$N47 is FCSYMBOLS.EACH_FUNCTION.VISIT.$12
;   FCSYMBOLS.EACH_FUNCTION.VI.$N48 is FCSYMBOLS.EACH_FUNCTION.VISIT.$D3
;
FCSYMBOLS.EACH_FUNCTION.VISIT.T = 4	; T is argument 1
FCSYMBOLS.EACH_FUNCTION.VI.$N36 = -324	; characters, for one statement, in the frame
FCSYMBOLS.EACH_FUNCTION.VI.$N35 = -24	; a descriptor, written whole at each use, in the frame
FCSYMBOLS.EACH_FUNCTION.VI.$N42 = -16	; a descriptor, written whole at each use, in the frame
FCSYMBOLS.EACH_FUNCTION.VI.$N48 = -8	; a descriptor, written whole at each use, in the frame

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  485
;  486      recursive subroutine visit(t)
FCSYMBOLS.EACH_FUNCTION.VISIT:
	.WORD	^M<R6,R7,R8,R9,R10,R11>	; internal procedure VISIT of FCSYMBOLS.EACH_FUNCTION
	SUBL2	#324,SP			; this activation's own storage
;  487        type(function_entry), pointer :: t
;  488
;  489        if (.not. associated(t)) return
	TSTL	@FCSYMBOLS.EACH_FUNCTION.VISIT.T(AP)
	BNEQ	FCSYMBOLS.EACH_FUNCTION.VI.$N33
	RET
FCSYMBOLS.EACH_FUNCTION.VI.$N33:
;  490        call visit(t%left)
