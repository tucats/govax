	RET

; Storage map for FCSYMBOLS.REMOVE_FUNCTION, a LOGICAL function
;   NAME             CHARACTER*(*), INTENT(IN)  argument 1  @FCSYMBOLS.REMOVE_FUNCTION.NAME(AP)
;   REMOVE_FUNCTION  LOGICAL                    $LOCAL+0    FCSYMBOLS.REMOVE_FUNCTION.$N32
;   FCSYMBOLS.REMOVE_FUNCTION.$N32 is FCSYMBOLS.REMOVE_FUNCTION.REMOVE_FUNCTION
;
FCSYMBOLS.REMOVE_FUNCTION.NAME = 4	; NAME is argument 1

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCSYMBOLS.REMOVE_FUNCTION.$N32:
