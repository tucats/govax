	RET

; Storage map for FCSYMBOLS.FELL, a RECURSIVE subroutine
;   T     TYPE(FUNCTION_ENTRY), POINTER  argument 1  @FCSYMBOLS.FELL.T(AP)
;
FCSYMBOLS.FELL.T = 4			; T is argument 1

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  438
;  439    recursive subroutine fell(t)
	.ENTRY	FCSYMBOLS.FELL,^M<>
