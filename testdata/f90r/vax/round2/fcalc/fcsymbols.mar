	MOVL	@FCSYMBOLS.DEFINE_FUNCTION.$A2,FCSYMBOLS.DEFINE_FUNCTION..$N24
	MOVL	FCSYMBOLS.DEFINE_FUNCTION..$N23,FCSYMBOLS.DEFINE_FUNCTION..$N25
