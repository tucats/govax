FCSYMBOLS.UNLINK.T = 4			; T is argument 1
FCSYMBOLS.UNLINK.NAME = 8		; NAME is argument 2
FCSYMBOLS.UNLINK.FOUND = 12		; FOUND is argument 3
FCSYMBOLS.UNLINK.GONE = -12		; GONE, in the frame
FCSYMBOLS.UNLINK.SUCCESSOR = -8		; SUCCESSOR, in the frame
FCSYMBOLS.UNLINK.$T1 = -4		; temporary, in the frame

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  381
;  382    ! UNLINK takes NAME out of the tree T leads to. Unlike REMOVE (above, for
;  383    ! variables), which copies a successor's contents into the place of the
;  384    ! entry removed, it moves the successor entry itself, so the trees the
;  385    ! entries point to never need copying.
;  386    recursive subroutine unlink(t, name, found)
	.ENTRY	FCSYMBOLS.UNLINK,^M<R2,R3>
	SUBL2	#12,SP			; this activation's own storage
	CLRL	FCSYMBOLS.UNLINK.GONE(FP)
;  387      type(function_entry), pointer :: t
;  388      character(len=*), intent(in) :: name
;  389      logical, intent(inout) :: found
;  390      type(function_entry), pointer :: gone, successor
;  391
;  392      if (.not. associated(t)) return
	TSTL	@FCSYMBOLS.UNLINK.T(AP)
	BNEQ	FCSYMBOLS.UNLINK.$1
	RET
FCSYMBOLS.UNLINK.$1:
;  393
;  394      if (llt(name, t%name)) then
	MOVZWL	@FCSYMBOLS.UNLINK.NAME(AP),R0
	MOVL	FCSYMBOLS.UNLINK.NAME(AP),R1
	MOVL	@FCSYMBOLS.UNLINK.T(AP),R2
	CMPC5	R0,@4(R1),#^A/ /,#31,(R2)
	BGEQU	FCSYMBOLS.UNLINK.$3
;  395        call unlink(t%left, name, found)
	PUSHAL	@FCSYMBOLS.UNLINK.FOUND(AP)
	PUSHL	FCSYMBOLS.UNLINK.NAME(AP)
	MOVL	@FCSYMBOLS.UNLINK.T(AP),R0
	PUSHAL	488(R0)
	CALLS	#3,FCSYMBOLS.UNLINK
;  396        return
	RET
FCSYMBOLS.UNLINK.$3:
;  397      else if (lgt(name, t%name)) then
	MOVZWL	@FCSYMBOLS.UNLINK.NAME(AP),R0
	MOVL	FCSYMBOLS.UNLINK.NAME(AP),R1
	MOVL	@FCSYMBOLS.UNLINK.T(AP),R2
	CMPC5	R0,@4(R1),#^A/ /,#31,(R2)
	BLEQU	FCSYMBOLS.UNLINK.$5
;  398        call unlink(t%right, name, found)
	PUSHAL	@FCSYMBOLS.UNLINK.FOUND(AP)
	PUSHL	FCSYMBOLS.UNLINK.NAME(AP)
	MOVL	@FCSYMBOLS.UNLINK.T(AP),R0
	PUSHAL	492(R0)
	CALLS	#3,FCSYMBOLS.UNLINK
;  399        return
	RET
FCSYMBOLS.UNLINK.$5:
;  400      end if
;  401
;  402      found = .true.
	MOVL	#-1,@FCSYMBOLS.UNLINK.FOUND(AP)
;  403      gone => t
	MOVL	@FCSYMBOLS.UNLINK.T(AP),FCSYMBOLS.UNLINK.GONE(FP)
;  404      if (.not. associated(t%left)) then
	MOVL	@FCSYMBOLS.UNLINK.T(AP),R0
	TSTL	488(R0)
	BNEQ	FCSYMBOLS.UNLINK.$7
;  405        t => t%right
	MOVL	@FCSYMBOLS.UNLINK.T(AP),R0
	MOVL	492(R0),@FCSYMBOLS.UNLINK.T(AP)
;  406      else if (.not. associated(t%right)) then
	BRB	FCSYMBOLS.UNLINK.$9
FCSYMBOLS.UNLINK.$7:
	MOVL	@FCSYMBOLS.UNLINK.T(AP),R0
	TSTL	492(R0)
	BNEQ	FCSYMBOLS.UNLINK.$10
;  407        t => t%left
	MOVL	@FCSYMBOLS.UNLINK.T(AP),R0
	MOVL	488(R0),@FCSYMBOLS.UNLINK.T(AP)
;  408      else
	BRB	FCSYMBOLS.UNLINK.$9
FCSYMBOLS.UNLINK.$10:
;  409        ! The successor, the leftmost entry of the right subtree, comes out
;  410        ! of its place and takes the place of the entry removed.
;  411        successor => detach_least(t%right)
	MOVL	@FCSYMBOLS.UNLINK.T(AP),R0
	PUSHAL	492(R0)
	CALLS	#1,G^FCSYMBOLS.DETACH_LEAST
	MOVL	R0,FCSYMBOLS.UNLINK.$T1(FP)
	MOVL	FCSYMBOLS.UNLINK.$T1(FP),FCSYMBOLS.UNLINK.SUCCESSOR(FP)
;  412        successor%left => t%left
	MOVL	@FCSYMBOLS.UNLINK.T(AP),R0
	MOVL	FCSYMBOLS.UNLINK.SUCCESSOR(FP),R1
	MOVL	488(R0),488(R1)
;  413        successor%right => t%right
	MOVL	@FCSYMBOLS.UNLINK.T(AP),R0
	MOVL	FCSYMBOLS.UNLINK.SUCCESSOR(FP),R1
	MOVL	492(R0),492(R1)
;  414        t => successor
	MOVL	FCSYMBOLS.UNLINK.SUCCESSOR(FP),@FCSYMBOLS.UNLINK.T(AP)
;  415      end if
FCSYMBOLS.UNLINK.$9:
;  416      call free_tree(gone%body)
	MOVL	FCSYMBOLS.UNLINK.GONE(FP),R0
	PUSHAL	284(R0)
	CALLS	#1,G^FCTREE.FREE_TREE
;  417      deallocate (gone)
	PUSHL	#496
	PUSHL	#2
	PUSHAL	FCSYMBOLS.UNLINK.GONE(FP)
	CALLS	#3,G^FTN$DEALLOC_SCALAR
;  418    end subroutine unlink
	RET

; Storage map for FCSYMBOLS.DETACH_LEAST, a RECURSIVE TYPE(FUNCTION_ENTRY) function
;   T      TYPE(FUNCTION_ENTRY), POINTER  argument 1  @FCSYMBOLS.DETACH_LEAST.T(AP)
;   LEAST  TYPE(FUNCTION_ENTRY), POINTER  FP-12       FCSYMBOLS.DETACH_LEAST.LEAST(FP)
;
FCSYMBOLS.DETACH_LEAST.T = 4		; T is argument 1
FCSYMBOLS.DETACH_LEAST.LEAST = -12	; LEAST, the function's value, in the frame
FCSYMBOLS.DETACH_LEAST.$T1 = -4		; temporary, in the frame

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  419
;  420    ! DETACH_LEAST takes the leftmost entry out of the tree T leads to, and
;  421    ! returns it.
;  422    recursive function detach_least(t) result(least)
	.ENTRY	FCSYMBOLS.DETACH_LEAST,^M<>
	SUBL2	#12,SP			; this activation's own storage
;  423      type(function_entry), pointer :: t
;  424      type(function_entry), pointer :: least
;  425
;  426      if (associated(t%left)) then
	MOVL	@FCSYMBOLS.DETACH_LEAST.T(AP),R0
	TSTL	488(R0)
	BEQL	FCSYMBOLS.DETACH_LEAST.$1
;  427        least => detach_least(t%left)
	MOVL	@FCSYMBOLS.DETACH_LEAST.T(AP),R0
	PUSHAL	488(R0)
	CALLS	#1,FCSYMBOLS.DETACH_LEAST
	MOVL	R0,FCSYMBOLS.DETACH_LEAST.$T1(FP)
	MOVL	FCSYMBOLS.DETACH_LEAST.$T1(FP),FCSYMBOLS.DETACH_LEAST.LEAST(FP)
;  428      else
	BRB	FCSYMBOLS.DETACH_LEAST.$3
FCSYMBOLS.DETACH_LEAST.$1:
;  429        least => t
	MOVL	@FCSYMBOLS.DETACH_LEAST.T(AP),FCSYMBOLS.DETACH_LEAST.LEAST(FP)
;  430        t => t%right
	MOVL	@FCSYMBOLS.DETACH_LEAST.T(AP),R0
	MOVL	492(R0),@FCSYMBOLS.DETACH_LEAST.T(AP)
;  431      end if
FCSYMBOLS.DETACH_LEAST.$3:
;  432    end function detach_least
	MOVL	FCSYMBOLS.DETACH_LEAST.LEAST(FP),R0 ; the function's value
	RET

; Storage map for FCSYMBOLS.CLEAR_FUNCTIONS, a subroutine
;   (no variables)
;

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  433
;  434    ! CLEAR_FUNCTIONS forgets every function.
;  435    subroutine clear_functions()
	.ENTRY	FCSYMBOLS.CLEAR_FUNCTIONS,^M<>
