;  150        if (name == p%name) return
	MOVZWL	(R6),R0
	CMPC5	R0,@4(R6),#^A/ /,#31,@FCSYMBOLS.LOOKUP.P
	BNEQ	FCSYMBOLS.LOOKUP.$3
	MOVL	FCSYMBOLS.LOOKUP.P,R0	; the function's value
	RET
FCSYMBOLS.LOOKUP.$3:
;  151        if (llt(name, p%name)) then
	MOVZWL	(R6),R0
	CMPC5	R0,@4(R6),#^A/ /,#31,@FCSYMBOLS.LOOKUP.P
	BGEQU	FCSYMBOLS.LOOKUP.$5
;  152          p => p%left
	MOVL	FCSYMBOLS.LOOKUP.P,R0
	MOVL	128(R0),FCSYMBOLS.LOOKUP.P
;  153        else
	BRB	FCSYMBOLS.LOOKUP.$7
FCSYMBOLS.LOOKUP.$5:
;  154          p => p%right
	MOVL	FCSYMBOLS.LOOKUP.P,R0
	MOVL	132(R0),FCSYMBOLS.LOOKUP.P
;  155        end if
FCSYMBOLS.LOOKUP.$7:
;  156      end do
FCSYMBOLS.LOOKUP.$1:			; DO (line 149)'s test
	TSTL	FCSYMBOLS.LOOKUP.P	; from line 149
	BNEQ	FCSYMBOLS.LOOKUP.$2
;  157    end function lookup
	MOVL	FCSYMBOLS.LOOKUP.P,R0	; the function's value
	RET

; Storage map for FCSYMBOLS.SET_VARIABLE, a subroutine
;   NAME  CHARACTER*(*), INTENT(IN)   argument 1  @FCSYMBOLS.SET_VARIABLE.NAME(AP)
;   Q     TYPE(QUANTITY), INTENT(IN)  argument 2  @FCSYMBOLS.SET_VARIABLE.Q(AP)
;
FCSYMBOLS.SET_VARIABLE.NAME = 4		; NAME is argument 1
FCSYMBOLS.SET_VARIABLE.Q = 8		; Q is argument 2

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  158
;  159    ! SET_VARIABLE gives NAME the value Q, which the table takes: the caller
;  160    ! mustn't release it.
;  161    subroutine set_variable(name, q)
	.ENTRY	FCSYMBOLS.SET_VARIABLE,^M<>
;  162      character(len=*), intent(in) :: name
;  163      type(quantity), intent(in) :: q
;  164
;  165      call insert(root, name, q)
	PUSHAB	@FCSYMBOLS.SET_VARIABLE.Q(AP)
	PUSHL	FCSYMBOLS.SET_VARIABLE.NAME(AP)
	PUSHAL	FCSYMBOLS.ROOT
	CALLS	#3,G^FCSYMBOLS.INSERT
;  166    end subroutine set_variable
	RET

; Storage map for FCSYMBOLS.INSERT, a RECURSIVE subroutine
;   T     TYPE(VARIABLE), POINTER     argument 1  @FCSYMBOLS.INSERT.T(AP)
;   NAME  CHARACTER*(*), INTENT(IN)   argument 2  @FCSYMBOLS.INSERT.NAME(AP)
;   Q     TYPE(QUANTITY), INTENT(IN)  argument 3  @FCSYMBOLS.INSERT.Q(AP)
;
FCSYMBOLS.INSERT.T = 4			; T is argument 1
FCSYMBOLS.INSERT.NAME = 8		; NAME is argument 2
FCSYMBOLS.INSERT.Q = 12			; Q is argument 3

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  167
;  168    ! INSERT puts NAME in the tree that T leads to, or changes its value,
;  169    ! releasing the old one.
;  170    recursive subroutine insert(t, name, q)
	.ENTRY	FCSYMBOLS.INSERT,^M<R2,R3,R4,R5>
;  171      type(variable), pointer :: t
;  172      character(len=*), intent(in) :: name
;  173      type(quantity), intent(in) :: q
;  174
;  175      if (.not. associated(t)) then
	TSTL	@FCSYMBOLS.INSERT.T(AP)
	BNEQ	FCSYMBOLS.INSERT.$1
;  176        allocate (t)
	PUSHL	#144
	PUSHL	#6
	PUSHAL	@FCSYMBOLS.INSERT.T(AP)
	CALLS	#3,G^FTN$ALLOC_SCALAR
;  177        t%name = name
	MOVZWL	@FCSYMBOLS.INSERT.NAME(AP),R0
	MOVL	FCSYMBOLS.INSERT.NAME(AP),R1
	MOVL	@FCSYMBOLS.INSERT.T(AP),R2
	MOVC5	R0,@4(R1),#^A/ /,#31,(R2)
;  178        t%q = q
	MOVL	@FCSYMBOLS.INSERT.T(AP),R0
	MOVC3	#96,@FCSYMBOLS.INSERT.Q(AP),32(R0)
;  179        nullify (t%left, t%right)
	MOVL	@FCSYMBOLS.INSERT.T(AP),R0
	CLRL	128(R0)
	MOVL	@FCSYMBOLS.INSERT.T(AP),R0
	CLRL	132(R0)
;  180      else if (name == t%name) then
	RET
FCSYMBOLS.INSERT.$1:
	MOVZWL	@FCSYMBOLS.INSERT.NAME(AP),R0
	MOVL	FCSYMBOLS.INSERT.NAME(AP),R1
	MOVL	@FCSYMBOLS.INSERT.T(AP),R2
	CMPC5	R0,@4(R1),#^A/ /,#31,(R2)
	BNEQ	FCSYMBOLS.INSERT.$4
;  181        call release(t%q)
	MOVL	@FCSYMBOLS.INSERT.T(AP),R0
	PUSHAB	32(R0)
	CALLS	#1,G^FCARRAYS.RELEASE
;  182        t%q = q
	MOVL	@FCSYMBOLS.INSERT.T(AP),R0
	MOVC3	#96,@FCSYMBOLS.INSERT.Q(AP),32(R0)
;  183      else if (llt(name, t%name)) then
	RET
FCSYMBOLS.INSERT.$4:
	MOVZWL	@FCSYMBOLS.INSERT.NAME(AP),R0
	MOVL	FCSYMBOLS.INSERT.NAME(AP),R1
	MOVL	@FCSYMBOLS.INSERT.T(AP),R2
	CMPC5	R0,@4(R1),#^A/ /,#31,(R2)
	BGEQU	FCSYMBOLS.INSERT.$6
;  184        call insert(t%left, name, q)
	PUSHAB	@FCSYMBOLS.INSERT.Q(AP)
	PUSHL	FCSYMBOLS.INSERT.NAME(AP)
	MOVL	@FCSYMBOLS.INSERT.T(AP),R0
	PUSHAL	128(R0)
	CALLS	#3,FCSYMBOLS.INSERT
;  185      else
	RET
FCSYMBOLS.INSERT.$6:
;  186        call insert(t%right, name, q)
	PUSHAB	@FCSYMBOLS.INSERT.Q(AP)
	PUSHL	FCSYMBOLS.INSERT.NAME(AP)
	MOVL	@FCSYMBOLS.INSERT.T(AP),R0
	PUSHAL	132(R0)
	CALLS	#3,FCSYMBOLS.INSERT
;  187      end if
;  188    end subroutine insert
	RET

; Storage map for FCSYMBOLS.REMOVE_VARIABLE, a LOGICAL function
;   NAME             CHARACTER*(*), INTENT(IN)  argument 1  @FCSYMBOLS.REMOVE_VARIABLE.NAME(AP)
;   REMOVE_VARIABLE  LOGICAL                    $LOCAL+0    FCSYMBOLS.REMOVE_VARIABLE.$N2
;   FCSYMBOLS.REMOVE_VARIABLE.$N2 is FCSYMBOLS.REMOVE_VARIABLE.REMOVE_VARIABLE
;
FCSYMBOLS.REMOVE_VARIABLE.NAME = 4	; NAME is argument 1

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCSYMBOLS.REMOVE_VARIABLE.$N2:
	.BLKL	1			; REMOVE_VARIABLE, the function's value

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCSYMBOLS.REMOVE_VARIABLE.$K1:
	.LONG	-1

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  189
;  190    ! REMOVE_VARIABLE takes NAME out of the table; the result is false if it
;  191    ! wasn't there.
;  192    logical function remove_variable(name)
	.ENTRY	FCSYMBOLS.REMOVE_VARIABLE,^M<>
;  193      character(len=*), intent(in) :: name
;  194
;  195      remove_variable = .false.
	CLRL	FCSYMBOLS.REMOVE_VARIABLE.$N2
;  196      call remove(root, name, remove_variable, .true.)
	PUSHAL	FCSYMBOLS.REMOVE_VARIABLE.$K1
	PUSHAL	FCSYMBOLS.REMOVE_VARIABLE.$N2
	PUSHL	FCSYMBOLS.REMOVE_VARIABLE.NAME(AP)
	PUSHAL	FCSYMBOLS.ROOT
	CALLS	#4,G^FCSYMBOLS.REMOVE
;  197    end function remove_variable
	MOVL	FCSYMBOLS.REMOVE_VARIABLE.$N2,R0 ; the function's value
	RET

; Storage map for FCSYMBOLS.REMOVE, a RECURSIVE subroutine
;   T          TYPE(VARIABLE), POINTER    argument 1  @FCSYMBOLS.REMOVE.T(AP)
;   NAME       CHARACTER*(*), INTENT(IN)  argument 2  @FCSYMBOLS.REMOVE.NAME(AP)
;   FOUND      LOGICAL, INTENT(INOUT)     argument 3  @FCSYMBOLS.REMOVE.FOUND(AP)
;   DROP       LOGICAL, INTENT(IN)        argument 4  @FCSYMBOLS.REMOVE.DROP(AP)
;   GONE       TYPE(VARIABLE), POINTER    FP-48       FCSYMBOLS.REMOVE.GONE(FP)
;   SUCCESSOR  TYPE(VARIABLE), POINTER    FP-44       FCSYMBOLS.REMOVE.SUCCESSOR(FP)
;   KEY        CHARACTER*31               FP-40       FCSYMBOLS.REMOVE.KEY(FP)
;
FCSYMBOLS.REMOVE.T = 4			; T is argument 1
FCSYMBOLS.REMOVE.NAME = 8		; NAME is argument 2
FCSYMBOLS.REMOVE.FOUND = 12		; FOUND is argument 3
FCSYMBOLS.REMOVE.DROP = 16		; DROP is argument 4
FCSYMBOLS.REMOVE.GONE = -48		; GONE, in the frame
FCSYMBOLS.REMOVE.SUCCESSOR = -44	; SUCCESSOR, in the frame
FCSYMBOLS.REMOVE.KEY = -40		; KEY, in the frame
FCSYMBOLS.REMOVE.$D1 = -8		; a descriptor, written whole at each use, in the frame

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCSYMBOLS.REMOVE.$K1:
	.LONG	0

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  198
;  199    ! REMOVE takes NAME out of the tree that T leads to, releasing its value
;  200    ! if DROP is true. An entry with two children takes the place of its
;  201    ! successor, the leftmost entry of its right subtree, which is then
;  202    ! removed instead: its value has moved, so it is removed without DROP.
;  203    recursive subroutine remove(t, name, found, drop)
	.ENTRY	FCSYMBOLS.REMOVE,^M<R2,R3,R4,R5>
	SUBL2	#48,SP			; this activation's own storage
	CLRL	FCSYMBOLS.REMOVE.GONE(FP)
;  204      type(variable), pointer :: t
;  205      character(len=*), intent(in) :: name
;  206      logical, intent(inout) :: found
;  207      logical, intent(in) :: drop
;  208      type(variable), pointer :: gone, successor
;  209      character(len=name_length) :: key
;  210
;  211      if (.not. associated(t)) return
	TSTL	@FCSYMBOLS.REMOVE.T(AP)
	BNEQ	FCSYMBOLS.REMOVE.$1
	RET
FCSYMBOLS.REMOVE.$1:
;  212
;  213      if (llt(name, t%name)) then
	MOVZWL	@FCSYMBOLS.REMOVE.NAME(AP),R0
	MOVL	FCSYMBOLS.REMOVE.NAME(AP),R1
	MOVL	@FCSYMBOLS.REMOVE.T(AP),R2
	CMPC5	R0,@4(R1),#^A/ /,#31,(R2)
	BGEQU	FCSYMBOLS.REMOVE.$3
;  214        call remove(t%left, name, found, drop)
	PUSHAL	@FCSYMBOLS.REMOVE.DROP(AP)
	PUSHAL	@FCSYMBOLS.REMOVE.FOUND(AP)
	PUSHL	FCSYMBOLS.REMOVE.NAME(AP)
	MOVL	@FCSYMBOLS.REMOVE.T(AP),R0
	PUSHAL	128(R0)
	CALLS	#4,FCSYMBOLS.REMOVE
;  215      else if (lgt(name, t%name)) then
	RET
FCSYMBOLS.REMOVE.$3:
	MOVZWL	@FCSYMBOLS.REMOVE.NAME(AP),R0
	MOVL	FCSYMBOLS.REMOVE.NAME(AP),R1
	MOVL	@FCSYMBOLS.REMOVE.T(AP),R2
	CMPC5	R0,@4(R1),#^A/ /,#31,(R2)
	BLEQU	FCSYMBOLS.REMOVE.$6
;  216        call remove(t%right, name, found, drop)
	PUSHAL	@FCSYMBOLS.REMOVE.DROP(AP)
	PUSHAL	@FCSYMBOLS.REMOVE.FOUND(AP)
	PUSHL	FCSYMBOLS.REMOVE.NAME(AP)
	MOVL	@FCSYMBOLS.REMOVE.T(AP),R0
	PUSHAL	132(R0)
	CALLS	#4,FCSYMBOLS.REMOVE
;  217      else
	RET
FCSYMBOLS.REMOVE.$6:
;  218        found = .true.
	MOVL	#-1,@FCSYMBOLS.REMOVE.FOUND(AP)
;  219        if (.not. associated(t%left) .or. .not. associated(t%right)) then
	MOVL	@FCSYMBOLS.REMOVE.T(AP),R0
	TSTL	128(R0)
	BEQL	FCSYMBOLS.REMOVE.$9
	MOVL	@FCSYMBOLS.REMOVE.T(AP),R0
	TSTL	132(R0)
	BNEQ	FCSYMBOLS.REMOVE.$8
FCSYMBOLS.REMOVE.$9:
;  220          gone => t
	MOVL	@FCSYMBOLS.REMOVE.T(AP),FCSYMBOLS.REMOVE.GONE(FP)
;  221          if (associated(t%left)) then
	MOVL	@FCSYMBOLS.REMOVE.T(AP),R0
	TSTL	128(R0)
	BEQL	FCSYMBOLS.REMOVE.$12
;  222            t => t%left
	MOVL	@FCSYMBOLS.REMOVE.T(AP),R0
	MOVL	128(R0),@FCSYMBOLS.REMOVE.T(AP)
;  223          else
	BRB	FCSYMBOLS.REMOVE.$14
FCSYMBOLS.REMOVE.$12:
;  224            t => t%right
	MOVL	@FCSYMBOLS.REMOVE.T(AP),R0
	MOVL	132(R0),@FCSYMBOLS.REMOVE.T(AP)
;  225          end if
FCSYMBOLS.REMOVE.$14:
;  226          if (drop) call release(gone%q)
	BLBC	@FCSYMBOLS.REMOVE.DROP(AP),FCSYMBOLS.REMOVE.$15
	MOVL	FCSYMBOLS.REMOVE.GONE(FP),R0
	PUSHAB	32(R0)
	CALLS	#1,G^FCARRAYS.RELEASE
FCSYMBOLS.REMOVE.$15:
;  227          deallocate (gone)
	PUSHL	#144
	PUSHL	#2
	PUSHAL	FCSYMBOLS.REMOVE.GONE(FP)
	CALLS	#3,G^FTN$DEALLOC_SCALAR
;  228        else
	RET
FCSYMBOLS.REMOVE.$8:
;  229          successor => t%right
	MOVL	@FCSYMBOLS.REMOVE.T(AP),R0
	MOVL	132(R0),FCSYMBOLS.REMOVE.SUCCESSOR(FP)
;  230          do while (associated(successor%left))
	BRB	FCSYMBOLS.REMOVE.$18
FCSYMBOLS.REMOVE.$19:			; DO (line 230)'s body
;  231            successor => successor%left
	MOVL	FCSYMBOLS.REMOVE.SUCCESSOR(FP),R0
	MOVL	128(R0),FCSYMBOLS.REMOVE.SUCCESSOR(FP)
;  232          end do
FCSYMBOLS.REMOVE.$18:			; DO (line 230)'s test
	MOVL	FCSYMBOLS.REMOVE.SUCCESSOR(FP),R0 ; from line 230
	TSTL	128(R0)
	BNEQ	FCSYMBOLS.REMOVE.$19
;  233          ! The successor's name is copied first: the entry it is in goes.
;  234          key = successor%name
	MOVC3	#31,@FCSYMBOLS.REMOVE.SUCCESSOR(FP),FCSYMBOLS.REMOVE.KEY(FP)
;  235          if (drop) call release(t%q)
	BLBC	@FCSYMBOLS.REMOVE.DROP(AP),FCSYMBOLS.REMOVE.$21
	MOVL	@FCSYMBOLS.REMOVE.T(AP),R0
	PUSHAB	32(R0)
	CALLS	#1,G^FCARRAYS.RELEASE
FCSYMBOLS.REMOVE.$21:
;  236          t%name = key
	MOVL	@FCSYMBOLS.REMOVE.T(AP),R0
	MOVC3	#31,FCSYMBOLS.REMOVE.KEY(FP),(R0)
;  237          t%q = successor%q
	MOVL	FCSYMBOLS.REMOVE.SUCCESSOR(FP),R0
	MOVL	@FCSYMBOLS.REMOVE.T(AP),R1
	MOVC3	#96,32(R0),32(R1)
;  238          call remove(t%right, key, found, .false.)
	MOVL	#17694751,FCSYMBOLS.REMOVE.$D1(FP) ; the descriptor's length, 31, type, and class
	MOVAB	FCSYMBOLS.REMOVE.KEY(FP),FCSYMBOLS.REMOVE.$D1+4(FP)
	PUSHAL	FCSYMBOLS.REMOVE.$K1
	PUSHAL	@FCSYMBOLS.REMOVE.FOUND(AP)
	PUSHAQ	FCSYMBOLS.REMOVE.$D1(FP)
	MOVL	@FCSYMBOLS.REMOVE.T(AP),R0
	PUSHAL	132(R0)
	CALLS	#4,FCSYMBOLS.REMOVE
;  239        end if
;  240      end if
;  241    end subroutine remove
	RET

; Storage map for FCSYMBOLS.CLEAR_VARIABLES, a subroutine
;   (no variables)
;

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  242
;  243    ! CLEAR_VARIABLES empties the table.
;  244    subroutine clear_variables()
	.ENTRY	FCSYMBOLS.CLEAR_VARIABLES,^M<>
;  245      call chop(root)
	PUSHAL	FCSYMBOLS.ROOT
	CALLS	#1,G^FCSYMBOLS.CHOP
;  246    end subroutine clear_variables
	RET

; Storage map for FCSYMBOLS.CHOP, a RECURSIVE subroutine
;   T     TYPE(VARIABLE), POINTER  argument 1  @FCSYMBOLS.CHOP.T(AP)
;
FCSYMBOLS.CHOP.T = 4			; T is argument 1

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  247
;  248    recursive subroutine chop(t)
	.ENTRY	FCSYMBOLS.CHOP,^M<>
;  249      type(variable), pointer :: t
;  250
;  251      if (.not. associated(t)) return
	TSTL	@FCSYMBOLS.CHOP.T(AP)
	BNEQ	FCSYMBOLS.CHOP.$1
	RET
FCSYMBOLS.CHOP.$1:
;  252      call chop(t%left)
	MOVL	@FCSYMBOLS.CHOP.T(AP),R0
	PUSHAL	128(R0)
	CALLS	#1,FCSYMBOLS.CHOP
;  253      call chop(t%right)
	MOVL	@FCSYMBOLS.CHOP.T(AP),R0
	PUSHAL	132(R0)
	CALLS	#1,FCSYMBOLS.CHOP
;  254      call release(t%q)
	MOVL	@FCSYMBOLS.CHOP.T(AP),R0
	PUSHAB	32(R0)
	CALLS	#1,G^FCARRAYS.RELEASE
;  255      deallocate (t)
	PUSHL	#144
	PUSHL	#2
	PUSHAL	@FCSYMBOLS.CHOP.T(AP)
	CALLS	#3,G^FTN$DEALLOC_SCALAR
;  256    end subroutine chop
	RET

; Storage map for FCSYMBOLS.LIST_VARIABLES, a subroutine
;   (no variables)
;

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  257
;  258    ! LIST_VARIABLES shows each variable as NAME = VALUE, in name order.
;  259    subroutine list_variables()
	.ENTRY	FCSYMBOLS.LIST_VARIABLES,^M<>
;  260      call walk(root)
	PUSHAL	FCSYMBOLS.ROOT
	CALLS	#1,G^FCSYMBOLS.WALK
;  261    end subroutine list_variables
	RET

; Storage map for FCSYMBOLS.WALK, a RECURSIVE subroutine
;   T     TYPE(VARIABLE), POINTER  argument 1  @FCSYMBOLS.WALK.T(AP)
;
FCSYMBOLS.WALK.T = 4			; T is argument 1
FCSYMBOLS.WALK.$D1 = -8			; a descriptor, written whole at each use, in the frame

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  262
;  263    recursive subroutine walk(t)
	.ENTRY	FCSYMBOLS.WALK,^M<>
	SUBL2	#8,SP			; this activation's own storage
;  264      type(variable), pointer :: t
;  265
;  266      if (.not. associated(t)) return
	TSTL	@FCSYMBOLS.WALK.T(AP)
	BNEQ	FCSYMBOLS.WALK.$1
	RET
FCSYMBOLS.WALK.$1:
;  267      call walk(t%left)
	MOVL	@FCSYMBOLS.WALK.T(AP),R0
	PUSHAL	128(R0)
	CALLS	#1,FCSYMBOLS.WALK
;  268      call list_quantity(t%name, t%q)
	MOVL	#17694751,FCSYMBOLS.WALK.$D1(FP) ; the descriptor's length, 31, type, and class
	MOVL	@FCSYMBOLS.WALK.T(AP),R0
	MOVAB	(R0),FCSYMBOLS.WALK.$D1+4(FP)
	MOVL	@FCSYMBOLS.WALK.T(AP),R0
	PUSHAB	32(R0)
	PUSHAQ	FCSYMBOLS.WALK.$D1(FP)
	CALLS	#2,G^FCARRAYS.LIST_QUANTITY
;  269      call walk(t%right)
	MOVL	@FCSYMBOLS.WALK.T(AP),R0
	PUSHAL	132(R0)
	CALLS	#1,FCSYMBOLS.WALK
;  270    end subroutine walk
	RET

; Storage map for FCSYMBOLS.EACH_VARIABLE, a subroutine
;   ACTION  (invalid)  an argument  @FCSYMBOLS.EACH_VARIABLE.$A1
;

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCSYMBOLS.EACH_VARIABLE.$A1:
	.BLKL	1			; ACTION's longword of the argument list, set at each entry point

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  271
;  272    ! EACH_VARIABLE calls ACTION(NAME, Q) for each variable, in name order:
;  273    ! SAVE (module FCSTATE) writes each one to its file this way.
;  274    !
;  275    ! ACTION is a dummy procedure: the caller passes a procedure's name, and
;  276    ! each call of ACTION here calls that procedure. The INTERFACE block says
;  277    ! what arguments it takes, so each call is checked as a module
;  278    ! procedure's is. An interface body is a scope of its own that sees
;  279    ! nothing of the module around it (no host association), so it USEs the
;  280    ! module that defines QUANTITY itself. (Fortran 90 lets a module
;  281    ! procedure or an external one be passed, never an internal one.)
;  282    subroutine each_variable(action)
	.ENTRY	FCSYMBOLS.EACH_VARIABLE,^M<>
	MOVL	4(AP),FCSYMBOLS.EACH_VARIABLE.$A1 ; ACTION is argument 1
;  283      interface
;  284        subroutine action(name, q)
;  285          use fcarrays, only: quantity
;  286          character(len=*), intent(in) :: name
;  287          type(quantity), intent(in) :: q
;  288        end subroutine action
;  289      end interface
;  290
;  291      call visit(root)
	PUSHAL	FCSYMBOLS.ROOT
	CALLS	#1,FCSYMBOLS.EACH_VARIABLE.VISIT
;  292
;  293    contains
	RET

; Storage map for FCSYMBOLS.EACH_VARIABLE.VISIT, a RECURSIVE subroutine
;   T     TYPE(VARIABLE), POINTER  argument 1  @FCSYMBOLS.EACH_VARIABLE.VISIT.T(AP)
;   R8 is $T1: temporary
;   R7 is $T2: temporary
;   R6 is $T3: temporary
;   FCSYMBOLS.EACH_VARIABLE.VIS.$N3 is FCSYMBOLS.EACH_VARIABLE.VISIT.$1
;   FCSYMBOLS.EACH_VARIABLE.VIS.$N4 is FCSYMBOLS.EACH_VARIABLE.VISIT.$2
;   FCSYMBOLS.EACH_VARIABLE.VIS.$N5 is FCSYMBOLS.EACH_VARIABLE.VISIT.$3
;   FCSYMBOLS.EACH_VARIABLE.VIS.$N6 is FCSYMBOLS.EACH_VARIABLE.VISIT.$4
;   FCSYMBOLS.EACH_VARIABLE.VIS.$N7 is FCSYMBOLS.EACH_VARIABLE.VISIT.$5
;   FCSYMBOLS.EACH_VARIABLE.VIS.$N8 is FCSYMBOLS.EACH_VARIABLE.VISIT.$6
;   FCSYMBOLS.EACH_VARIABLE.VIS.$N9 is FCSYMBOLS.EACH_VARIABLE.VISIT.$7
;   FCSYMBOLS.EACH_VARIABLE.VI.$N10 is FCSYMBOLS.EACH_VARIABLE.VISIT.$D1
;
FCSYMBOLS.EACH_VARIABLE.VISIT.T = 4	; T is argument 1
FCSYMBOLS.EACH_VARIABLE.VI.$N10 = -8	; a descriptor, written whole at each use, in the frame

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  294
;  295      recursive subroutine visit(t)
FCSYMBOLS.EACH_VARIABLE.VISIT:
	.WORD	^M<R6,R7,R8>		; internal procedure VISIT of FCSYMBOLS.EACH_VARIABLE
	SUBL2	#8,SP			; this activation's own storage
;  296        type(variable), pointer :: t
;  297
;  298        if (.not. associated(t)) return
	TSTL	@FCSYMBOLS.EACH_VARIABLE.VISIT.T(AP)
	BNEQ	FCSYMBOLS.EACH_VARIABLE.VIS.$N3
	RET
FCSYMBOLS.EACH_VARIABLE.VIS.$N3:
;  299        call visit(t%left)
	MOVL	@FCSYMBOLS.EACH_VARIABLE.VISIT.T(AP),R0
	PUSHAL	128(R0)
	CALLS	#1,FCSYMBOLS.EACH_VARIABLE.VISIT
;  300        call action(trim(t%name), t%q)
	MOVL	@FCSYMBOLS.EACH_VARIABLE.VISIT.T(AP),R0
	MOVAB	(R0),R8
	MOVAB	(R8),R7
	MOVL	#31,R6
	BRB	FCSYMBOLS.EACH_VARIABLE.VIS.$N5
FCSYMBOLS.EACH_VARIABLE.VIS.$N6:
	CMPB	-1(R7)[R6],#32
	BNEQ	FCSYMBOLS.EACH_VARIABLE.VIS.$N7
	DECL	R6
FCSYMBOLS.EACH_VARIABLE.VIS.$N5:
	TSTL	R6			; from line 300
	BNEQ	FCSYMBOLS.EACH_VARIABLE.VIS.$N6
FCSYMBOLS.EACH_VARIABLE.VIS.$N7:
	MOVL	#17694720,FCSYMBOLS.EACH_VARIABLE.VI.$N10(FP) ; the descriptor's length, 0, type, and class
	CVTLW	R6,FCSYMBOLS.EACH_VARIABLE.VI.$N10(FP)
	MOVAB	(R8),FCSYMBOLS.EACH_VARIABLE.VI.$N10+4(FP)
	MOVL	@FCSYMBOLS.EACH_VARIABLE.VISIT.T(AP),R0
	PUSHAB	32(R0)
	PUSHAQ	FCSYMBOLS.EACH_VARIABLE.VI.$N10(FP)
	CALLS	#2,@FCSYMBOLS.EACH_VARIABLE.$A1
;  301        call visit(t%right)
	MOVL	@FCSYMBOLS.EACH_VARIABLE.VISIT.T(AP),R0
	PUSHAL	132(R0)
	CALLS	#1,FCSYMBOLS.EACH_VARIABLE.VISIT
;  302      end subroutine visit
	RET

; Storage map for FCSYMBOLS.FIND_FUNCTION, a TYPE(FUNCTION_ENTRY) function
;   NAME  CHARACTER*(*), INTENT(IN)      argument 1  @FCSYMBOLS.FIND_FUNCTION.NAME(AP)
;   F     TYPE(FUNCTION_ENTRY), POINTER  $LOCAL+0    FCSYMBOLS.FIND_FUNCTION.F
;   R6 is $R1: NAME's address
;
FCSYMBOLS.FIND_FUNCTION.NAME = 4	; NAME is argument 1

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCSYMBOLS.FIND_FUNCTION.F:
	.BLKL	1			; F, the function's value
	.BLKB	4

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  303    end subroutine each_variable
;  304
;  305    ! ------------------------------------------------------------------
;  306    ! Functions.
;  307
;  308    ! FIND_FUNCTION is the entry for the function NAME, or a null pointer if
;  309    ! there is none. A function whose result is a POINTER returns the
;  310    ! address of the entry itself, not a copy, so the caller sees the tree
;  311    ! the entry holds; the caller must use => to keep it:
;  312    !     f => find_function(name)
;  313    function find_function(name) result(f)
	.ENTRY	FCSYMBOLS.FIND_FUNCTION,^M<R2,R3,R6>
;  314      character(len=*), intent(in) :: name
;  315      type(function_entry), pointer :: f
;  316
;  317      f => functions
	MOVL	FCSYMBOLS.FUNCTIONS,FCSYMBOLS.FIND_FUNCTION.F
;  318      do while (associated(f))
	MOVL	FCSYMBOLS.FIND_FUNCTION.NAME(AP),R6
	BRB	FCSYMBOLS.FIND_FUNCTION.$1
FCSYMBOLS.FIND_FUNCTION.$2:		; DO (line 318)'s body
;  319        if (name == f%name) return
	MOVZWL	(R6),R0
	CMPC5	R0,@4(R6),#^A/ /,#31,@FCSYMBOLS.FIND_FUNCTION.F
	BNEQ	FCSYMBOLS.FIND_FUNCTION.$3
	MOVL	FCSYMBOLS.FIND_FUNCTION.F,R0 ; the function's value
	RET
FCSYMBOLS.FIND_FUNCTION.$3:
;  320        if (llt(name, f%name)) then
	MOVZWL	(R6),R0
	CMPC5	R0,@4(R6),#^A/ /,#31,@FCSYMBOLS.FIND_FUNCTION.F
	BGEQU	FCSYMBOLS.FIND_FUNCTION.$5
;  321          f => f%left
	MOVL	FCSYMBOLS.FIND_FUNCTION.F,R0
	MOVL	488(R0),FCSYMBOLS.FIND_FUNCTION.F
;  322        else
	BRB	FCSYMBOLS.FIND_FUNCTION.$7
FCSYMBOLS.FIND_FUNCTION.$5:
;  323          f => f%right
	MOVL	FCSYMBOLS.FIND_FUNCTION.F,R0
	MOVL	492(R0),FCSYMBOLS.FIND_FUNCTION.F
;  324        end if
FCSYMBOLS.FIND_FUNCTION.$7:
;  325      end do
FCSYMBOLS.FIND_FUNCTION.$1:		; DO (line 318)'s test
	TSTL	FCSYMBOLS.FIND_FUNCTION.F ; from line 318
	BNEQ	FCSYMBOLS.FIND_FUNCTION.$2
;  326    end function find_function
	MOVL	FCSYMBOLS.FIND_FUNCTION.F,R0 ; the function's value
	RET

; Storage map for FCSYMBOLS.DEFINE_FUNCTION, a subroutine
;   NAME    CHARACTER*(*), INTENT(IN)      an argument  @FCSYMBOLS.DEFINE_FUNCTION.$A1
;   COUNT   INTEGER, INTENT(IN)            an argument  @FCSYMBOLS.DEFINE_FUNCTION.$A2
;   PARAMS  CHARACTER*(*), INTENT(IN) (:)  an argument  @FCSYMBOLS.DEFINE_FUNCTION.$A3
;   BODY    TYPE(NODE), POINTER            an argument  @FCSYMBOLS.DEFINE_FUNCTION.$A4
;   TEXT    CHARACTER*(*), INTENT(IN)      an argument  @FCSYMBOLS.DEFINE_FUNCTION.$A5
;   R6 is $T1: temporary
;

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCSYMBOLS.DEFINE_FUNCTION.$B1:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_NCA
	.LONG	0			; PARAMS's bounds: set at each entry point
	.BYTE	0,0,0,1			; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0			; strides, in bytes
	.LONG	0,0			; bounds
FCSYMBOLS.DEFINE_FUNCTION.$A1:
	.BLKL	1			; NAME's longword of the argument list, set at each entry point
FCSYMBOLS.DEFINE_FUNCTION.$A2:
	.BLKL	1			; COUNT's longword of the argument list, set at each entry point
FCSYMBOLS.DEFINE_FUNCTION.$A3:
	.BLKL	1			; PARAMS's longword of the argument list, set at each entry point
FCSYMBOLS.DEFINE_FUNCTION.$A4:
	.BLKL	1			; BODY's longword of the argument list, set at each entry point
FCSYMBOLS.DEFINE_FUNCTION.$A5:
	.BLKL	1			; TEXT's longword of the argument list, set at each entry point

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  327
;  328    ! DEFINE_FUNCTION adds the function NAME, or replaces its definition. The
;  329    ! tree BODY becomes the entry's: the caller mustn't free it.
;  330    subroutine define_function(name, count, params, body, text)
	.ENTRY	FCSYMBOLS.DEFINE_FUNCTION,^M<R6>
	MOVL	4(AP),FCSYMBOLS.DEFINE_FUNCTION.$A1 ; NAME is argument 1
	MOVL	8(AP),FCSYMBOLS.DEFINE_FUNCTION.$A2 ; COUNT is argument 2
	MOVL	12(AP),FCSYMBOLS.DEFINE_FUNCTION.$A3 ; PARAMS is argument 3
	MOVL	16(AP),FCSYMBOLS.DEFINE_FUNCTION.$A4 ; BODY is argument 4
	MOVL	20(AP),FCSYMBOLS.DEFINE_FUNCTION.$A5 ; TEXT is argument 5
	MOVW	@FCSYMBOLS.DEFINE_FUNCTION.$A3,FCSYMBOLS.DEFINE_FUNCTION.$B1
	MOVL	FCSYMBOLS.DEFINE_FUNCTION.$A3,R0
	MOVL	4(R0),FCSYMBOLS.DEFINE_FUNCTION.$B1+4
	MOVL	FCSYMBOLS.DEFINE_FUNCTION.$A3,R0
	CMPB	3(R0),#4
	BEQL	FCSYMBOLS.DEFINE_FUNCTION.$1
	MOVL	FCSYMBOLS.DEFINE_FUNCTION.$A3,R0
	MOVL	20(R0),FCSYMBOLS.DEFINE_FUNCTION.$B1+20
	MOVL	FCSYMBOLS.DEFINE_FUNCTION.$A3,R0
	MOVL	FCSYMBOLS.DEFINE_FUNCTION.$A3,R1
	SUBL3	24(R1),28(R0),R0
	ADDL3	R0,#1,R6
	BRB	FCSYMBOLS.DEFINE_FUNCTION.$3
FCSYMBOLS.DEFINE_FUNCTION.$1:
	MOVZWL	@FCSYMBOLS.DEFINE_FUNCTION.$A3,FCSYMBOLS.DEFINE_FUNCTION.$B1+20
	MOVL	FCSYMBOLS.DEFINE_FUNCTION.$A3,R0
	MOVL	20(R0),R6
FCSYMBOLS.DEFINE_FUNCTION.$3:
	MOVL	#1,FCSYMBOLS.DEFINE_FUNCTION.$B1+24
	TSTL	R6
	BGEQ	FCSYMBOLS.DEFINE_FUNCTION.$4
	CLRL	R6
FCSYMBOLS.DEFINE_FUNCTION.$4:
	MOVL	R6,FCSYMBOLS.DEFINE_FUNCTION.$B1+28
	SUBL3	FCSYMBOLS.DEFINE_FUNCTION.$B1+20,FCSYMBOLS.DEFINE_FUNCTION.$B1+4,FCSYMBOLS.DEFINE_FUNCTION.$B1+16
	MOVZWL	@FCSYMBOLS.DEFINE_FUNCTION.$A3,R0
	MULL3	R0,FCSYMBOLS.DEFINE_FUNCTION.$B1+28,FCSYMBOLS.DEFINE_FUNCTION.$B1+12
;  331      character(len=*), intent(in) :: name
;  332      integer, intent(in) :: count
;  333      character(len=*), intent(in) :: params(:)
;  334      type(node), pointer :: body
;  335      character(len=*), intent(in) :: text
;  336
;  337      call place(functions)
	PUSHAL	FCSYMBOLS.FUNCTIONS
	CALLS	#1,FCSYMBOLS.DEFINE_FUNCTION.PLACE
;  338
;  339    contains
	RET

; Storage map for FCSYMBOLS.DEFINE_FUNCTION.PLACE, a RECURSIVE subroutine
;   T     TYPE(FUNCTION_ENTRY), POINTER  argument 1  @FCSYMBOLS.DEFINE_FUNCTION..$N12(AP)
;   FCSYMBOLS.DEFINE_FUNCTION..$N11 is FCSYMBOLS.DEFINE_FUNCTION.PLACE.$1
;   FCSYMBOLS.DEFINE_FUNCTION..$N12 is FCSYMBOLS.DEFINE_FUNCTION.PLACE.T
;   FCSYMBOLS.DEFINE_FUNCTION..$N13 is FCSYMBOLS.DEFINE_FUNCTION.PLACE.$2
;   FCSYMBOLS.DEFINE_FUNCTION..$N14 is FCSYMBOLS.DEFINE_FUNCTION.PLACE.$3
;   FCSYMBOLS.DEFINE_FUNCTION..$N15 is FCSYMBOLS.DEFINE_FUNCTION.PLACE.$4
;   FCSYMBOLS.DEFINE_FUNCTION..$N16 is FCSYMBOLS.DEFINE_FUNCTION.PLACE.$5
;   FCSYMBOLS.DEFINE_FUNCTION..$N17 is FCSYMBOLS.DEFINE_FUNCTION.PLACE.$6
;   FCSYMBOLS.DEFINE_FUNCTION..$N18 is FCSYMBOLS.DEFINE_FUNCTION.PLACE.$7
;
FCSYMBOLS.DEFINE_FUNCTION..$N12 = 4	; T is argument 1

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  340
;  341      ! PLACE finds where NAME belongs in the tree T leads to. It is an
;  342      ! internal procedure, so it sees DEFINE_FUNCTION's arguments by host
;  343      ! association and needn't be passed them.
;  344      recursive subroutine place(t)
FCSYMBOLS.DEFINE_FUNCTION.PLACE:
	.WORD	^M<R2,R3,R4,R5>		; internal procedure PLACE of FCSYMBOLS.DEFINE_FUNCTION
;  345        type(function_entry), pointer :: t
;  346
;  347        if (.not. associated(t)) then
	TSTL	@FCSYMBOLS.DEFINE_FUNCTION..$N12(AP)
	BNEQ	FCSYMBOLS.DEFINE_FUNCTION..$N11
;  348          allocate (t)
	PUSHL	#496
	PUSHL	#6
	PUSHAL	@FCSYMBOLS.DEFINE_FUNCTION..$N12(AP)
	CALLS	#3,G^FTN$ALLOC_SCALAR
;  349          nullify (t%left, t%right)
	MOVL	@FCSYMBOLS.DEFINE_FUNCTION..$N12(AP),R0
	CLRL	488(R0)
	MOVL	@FCSYMBOLS.DEFINE_FUNCTION..$N12(AP),R0
	CLRL	492(R0)
;  350          t%name = name
	MOVZWL	@FCSYMBOLS.DEFINE_FUNCTION.$A1,R0
	MOVL	FCSYMBOLS.DEFINE_FUNCTION.$A1,R1
	MOVL	@FCSYMBOLS.DEFINE_FUNCTION..$N12(AP),R2
	MOVC5	R0,@4(R1),#^A/ /,#31,(R2)
;  351          call fill(t)
	PUSHAL	@FCSYMBOLS.DEFINE_FUNCTION..$N12(AP)
	CALLS	#1,FCSYMBOLS.DEFINE_FUNCTION.FILL
;  352        else if (name == t%name) then
	RET
FCSYMBOLS.DEFINE_FUNCTION..$N11:
	MOVZWL	@FCSYMBOLS.DEFINE_FUNCTION.$A1,R0
	MOVL	FCSYMBOLS.DEFINE_FUNCTION.$A1,R1
	MOVL	@FCSYMBOLS.DEFINE_FUNCTION..$N12(AP),R2
	CMPC5	R0,@4(R1),#^A/ /,#31,(R2)
	BNEQ	FCSYMBOLS.DEFINE_FUNCTION..$N15
;  353          call free_tree(t%body)
	MOVL	@FCSYMBOLS.DEFINE_FUNCTION..$N12(AP),R0
	PUSHAL	284(R0)
	CALLS	#1,G^FCTREE.FREE_TREE
;  354          call fill(t)
	PUSHAL	@FCSYMBOLS.DEFINE_FUNCTION..$N12(AP)
	CALLS	#1,FCSYMBOLS.DEFINE_FUNCTION.FILL
;  355        else if (llt(name, t%name)) then
	RET
FCSYMBOLS.DEFINE_FUNCTION..$N15:
	MOVZWL	@FCSYMBOLS.DEFINE_FUNCTION.$A1,R0
	MOVL	FCSYMBOLS.DEFINE_FUNCTION.$A1,R1
	MOVL	@FCSYMBOLS.DEFINE_FUNCTION..$N12(AP),R2
	CMPC5	R0,@4(R1),#^A/ /,#31,(R2)
	BGEQU	FCSYMBOLS.DEFINE_FUNCTION..$N17
;  356          call place(t%left)
	MOVL	@FCSYMBOLS.DEFINE_FUNCTION..$N12(AP),R0
	PUSHAL	488(R0)
	CALLS	#1,FCSYMBOLS.DEFINE_FUNCTION.PLACE
;  357        else
	RET
FCSYMBOLS.DEFINE_FUNCTION..$N17:
;  358          call place(t%right)
	MOVL	@FCSYMBOLS.DEFINE_FUNCTION..$N12(AP),R0
	PUSHAL	492(R0)
	CALLS	#1,FCSYMBOLS.DEFINE_FUNCTION.PLACE
;  359        end if
;  360      end subroutine place
	RET

; Storage map for FCSYMBOLS.DEFINE_FUNCTION.FILL, a subroutine
;   T     TYPE(FUNCTION_ENTRY), POINTER  argument 1  @FCSYMBOLS.DEFINE_FUNCTION..$N19(AP)
;   R6 is $I1: an array statement's loop index
;   R9 is $L2: array (line 367), dimension 1's limit
;   R10 is $H1: a value computed before a loop
