;    1  ! fcalc: the names a user defines, and the constants fcalc defines.
;    2  !
;    3  ! Variables are kept in a binary search tree by name, each entry a node
;    4  ! with POINTER children, so LIST shows them in name order by walking the
;    5  ! tree. Entries are added and removed through pointer dummy arguments: a
;    6  ! routine given the pointer that leads to an entry (the root, or a parent's
;    7  ! LEFT or RIGHT) can make it lead somewhere else.
;    8  !
;    9  ! A binary search tree keeps every name in an entry's LEFT subtree before
;   10  ! the entry's name, and every name in its RIGHT subtree after it. Finding a
;   11  ! name compares it with the root's and goes left or right, so a table of n
;   12  ! names takes about log2(n) comparisons when the tree is balanced (more if
;   13  ! names arrive in order, which a calculator's few names can afford). Names
;   14  ! are compared by LLT and LGT, which compare by ASCII on every machine,
;   15  ! where < on strings uses the machine's own character order.
;   16  !
;   17  ! A variable's value is a QUANTITY (module FCARRAYS), whose storage the
;   18  ! table owns: SET_VARIABLE takes the quantity it is given, and
;   19  ! FIND_VARIABLE gives the caller a copy of its own.
;   20  !
;   21  ! A dummy argument declared POINTER (as T in INSERT) is the caller's
;   22  ! pointer itself, not a copy: when INSERT does ALLOCATE (T), the parent's
;   23  ! LEFT or RIGHT, or ROOT, now points to the new entry. Such a dummy needs an
;   24  ! explicit interface at the call, as module procedures have.
;   25  module fcsymbols
;   26    use fckinds
;   27    use fcmessages
;   28    use fcvalues
;   29    use fcarrays
;   30    ! ONLY names just what this module needs from FCTREE: a tree's NODE type,
;   31    ! and FREE_TREE to give one back when a function is redefined or cleared.
;   32    use fctree, only: node, free_tree
;   33    implicit none
;   34    private
;   35
;   36    ! VALUE is public here too: a public procedure's argument may not be of a
;   37    ! type private in this module.
;   38    public :: value, quantity
;   39    public :: start_symbols, constant_value, is_constant, find_variable, holds_array
;   40    public :: set_variable, remove_variable, clear_variables, list_variables
;   41    public :: node, function_entry, max_params
;   42    public :: find_function, define_function, remove_function, clear_functions
;   43    public :: list_functions, heading, each_variable, each_function
;   44
;   45    type variable
;   46      character(len=name_length) :: name
;   47      type(quantity) :: q
;   48      type(variable), pointer :: left
;   49      type(variable), pointer :: right
;   50    end type variable
;   51
;   52    type(variable), pointer, save :: root
;   53
;   54    ! The most parameters a function may have.
;   55    integer, parameter :: max_params = 8
;   56
;   57    ! A user's function, f(x, y) = expr: its name, its parameters' names, the
;   58    ! expression as a parsed tree (which the evaluator walks at each call),
;   59    ! and the expression's text as it was typed (which LIST shows). The
;   60    ! functions are a binary search tree of their own, beside the
;   61    ! variables': a name may be both a variable and a function, since a
;   62    ! function's name is always followed by a parenthesis.
;   63    type function_entry
;   64      character(len=name_length) :: name
;   65      integer :: count
;   66      character(len=name_length) :: params(max_params)
;   67      type(node), pointer :: body
;   68      character(len=line_length) :: text
;   69      type(function_entry), pointer :: left
;   70      type(function_entry), pointer :: right
;   71    end type function_entry
;   72
;   73    type(function_entry), pointer, save :: functions
;   74
;   75    ! fcalc's constants. HUGE is fcalc's largest value, LIMIT, not the
;   76    ! machine's: a VAX's and an IEEE machine's differ.
;   77    character(len=4), parameter :: constant_names(5) = (/ 'pi  ', 'e   ', 'i   ', 'eps ', 'huge' /)
;   78
;   79  contains

