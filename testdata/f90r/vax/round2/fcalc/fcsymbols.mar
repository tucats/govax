	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  371    end subroutine define_function
;  372
;  373    ! REMOVE_FUNCTION takes NAME out of the functions; the result is false if
;  374    ! it wasn't there.
;  375    logical function remove_function(name)
	.ENTRY	FCSYMBOLS.REMOVE_FUNCTION,^M<>
;  376      character(len=*), intent(in) :: name
;  377
;  378      remove_function = .false.
	CLRL	FCSYMBOLS.REMOVE_FUNCTION.$N32
