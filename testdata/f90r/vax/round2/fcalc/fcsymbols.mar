FCSYMBOLS.SHOW.$T1 = -332		; characters, for one statement, in the frame
FCSYMBOLS.SHOW.$D1 = -32		; a descriptor, written whole at each use, in the frame
FCSYMBOLS.SHOW.$D2 = -24		; a descriptor, written whole at each use, in the frame
FCSYMBOLS.SHOW.$T8 = -16		; temporary, in the frame
FCSYMBOLS.SHOW.$D3 = -12		; a descriptor, written whole at each use, in the frame
FCSYMBOLS.SHOW.$U1 = -4			; temporary, in the frame

