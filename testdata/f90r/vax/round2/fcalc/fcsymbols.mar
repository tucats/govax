	RET
FCSYMBOLS.FELL.$1:
;  443      call fell(t%left)
	MOVL	@FCSYMBOLS.FELL.T(AP),R0
	PUSHAL	488(R0)
	CALLS	#1,FCSYMBOLS.FELL
;  444      call fell(t%right)
	MOVL	@FCSYMBOLS.FELL.T(AP),R0
	PUSHAL	492(R0)
	CALLS	#1,FCSYMBOLS.FELL
;  445      call free_tree(t%body)
	MOVL	@FCSYMBOLS.FELL.T(AP),R0
	PUSHAL	284(R0)
	CALLS	#1,G^FCTREE.FREE_TREE
;  446      deallocate (t)
	PUSHL	#496
	PUSHL	#2
	PUSHAL	@FCSYMBOLS.FELL.T(AP)
	CALLS	#3,G^FTN$DEALLOC_SCALAR
;  447    end subroutine fell
	RET

; Storage map for FCSYMBOLS.LIST_FUNCTIONS, a subroutine
