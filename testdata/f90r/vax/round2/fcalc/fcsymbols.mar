	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  361
;  362      subroutine fill(t)
FCSYMBOLS.DEFINE_FUNCTION.FILL:
	.WORD	^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11> ; internal procedure FILL of FCSYMBOLS.DEFINE_FUNCTION
;  363        type(function_entry), pointer :: t
;  364
;  365        t%count = count
	MOVL	@FCSYMBOLS.DEFINE_FUNCTION..$N19(AP),R0
	MOVL	@FCSYMBOLS.DEFINE_FUNCTION.$A2,32(R0)
