==== FCALC.ONESHOT
$ @ONESHOT
$! oneshot.com: fcalc as a foreign command (VMS and govax only: Fortran 90
$! has no way to read a command line, so gfortran's fcalc never sees one).
$! The text after FCALC is one line, run, and then fcalc ends; with none, it
$! reads lines, here from the procedure's own data lines. DCL compresses
$! blanks and makes letters capitals, which fcalc doesn't mind; a ! would
$! start DCL's comment.
$ fcalc = "$" + f$parse("FCALC.EXE")
$ fcalc 2^10 + 1
1025
$ fcalc sqrt(-4) * (1 + i)
-2 + 2i
$ fcalc 1/0
1/0
 ^
%FCALC-E-DIVZERO, division by zero
$ fcalc @setup
g = 9.80665
fall(t) = g*t^2/2
19.6133
$ fcalc save [nosuch]state
SAVE [NOSUCH]STATE
     ^
%FCALC-E-FILEERR, file [NOSUCH]STATE.fcalc could not be used
$ fcalc
set echo
fcalc> set echo
1 + 2
fcalc> 1 + 2
3
@setup
fcalc> @setup
fcalc> ! setup.fcalc: a file of fcalc's commands, for the state script's @ and RUN.
fcalc> ! Each line runs as if it were typed: a value is shown unless the line ends
fcalc> ! in ;, and ! starts a comment.
fcalc> g = 9.80665
g = 9.80665
fcalc> fall(t) = g*t^2/2
fall(t) = g*t^2/2
fcalc> fall(2)
19.6133
fcalc> dropped = fall(10);
fcalc> 
$ exit
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ WRITE SYS$OUTPUT "==== FCALCN"
==== FCALCN
$ SET DEFAULT DUA1:[FCALCN]
$ MACRO/NOLIST FCPLATFORM,FCKINDS,FCMESSAGES,FCVALUES,FCARRAYS,FCLEXER,FCTREE,FCSYMBOLS,FCFUNCS,FCPOLY,FCMATRIX,FCEVAL,FCNUMERIC,FCPLOT,FCSTATE,FCALC
$ LINK/NOMAP/EXECUTABLE=FCALC FCALC,FCPLATFORM,FCKINDS,FCMESSAGES,FCVALUES,FCARRAYS,FCLEXER,FCTREE,FCSYMBOLS,FCFUNCS,FCPOLY,FCMATRIX,FCEVAL,FCNUMERIC,FCPLOT,FCSTATE,DUA1:[FTNRTL]F90R/OPTIONS
! F90R.OPT - links a compiled Fortran 90 program against FTNRTL, which F90R.COM has built
! and defined. govax's LINK finds FTNRTL by itself; VMS's has to be told.
FTNRTL/SHAREABLE
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ WRITE SYS$OUTPUT "==== FCALCN.BASICS"
