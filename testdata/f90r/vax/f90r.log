fcalc> 3 \ a
  0.333333333333  0.666666666667
               1   1.33333333333
fcalc> ! Trace, rank, norms, and the Kronecker product.
fcalc> trace(a)
5
fcalc> trace(c)
5
fcalc> rank(a)
2
fcalc> rank([1, 2; 2, 4])
1
fcalc> rank([1, 2, 3; 4, 5, 6; 7, 8, 9])
2
