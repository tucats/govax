fcalc> ! poly(r) is the polynomial whose roots are r, and polyval(p, x) its value.
fcalc> poly([1, 2, 3])
  1  -6  11  -6
fcalc> poly(roots(p))
  1  0  -7  6
fcalc> poly(2)
  1  -2
fcalc> polyval(p, 2)
0
