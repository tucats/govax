$ ! F90R.COM - does a Fortran 90 program govax's compiler made run on VMS, with FTNRTL
$ ! built here from its sources? (docs/planning/PHASE-111 - Fortran 90 milestone.md, subtask
$ ! 11). Written by testdata/f90r/gen.go. There's no Fortran 90 compiler here, and none is
$ ! needed: each program's .MAR files came from govax's compiler, and VMS's MACRO and LINK
$ ! do the rest.
$ !
$ ! Run it with the exchange volume mounted, its [000000] the default directory:
$ !
$ !     @F90R/OUTPUT=F90R.LOG
$ !
$ SET NOON
$ ROOT = F$PARSE(F$ENVIRONMENT("DEFAULT"),,,"DEVICE")
$ !
$ ! FTNRTL, from its sources.
$ !
$ SET DEFAULT DUA1:[FTNRTL]
$ WRITE SYS$OUTPUT "==== FTNRTL"
==== FTNRTL
$ MACRO/NOLIST FTN_VECTOR
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_CONTROL
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_UNITS
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_STATEMENT
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_FORMAT
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_EDIT
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_FLOAT
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_LISTOUT
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_LISTIN
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_NAMELIST
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_INTERNAL
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_OPEN
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_INQUIRE
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_POSITION
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_UNFORMATTED
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_DIRECT
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_RECORD
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_KEYED
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_INTRINSICS
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_SYSTEM
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ MACRO/NOLIST FTN_ALLOC
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ IF F$TRNLNM("FTNRTL") .NES. "" THEN DEASSIGN FTNRTL
$ LINK/SHAREABLE=FTNRTL/MAP=FTNRTL/FULL FTNRTL/OPTIONS
! FTNRTL.OPT - the options that link FTNRTL.EXE, govax's FORTRAN run-time
! library (docs/PHASE-74 - FORTRAN plan.md, Decision 13). go generate
! ./internal/ftnrtl builds the image from these, as
!
!	$ MACRO FTN_VECTOR
!	$ MACRO FTN_CONTROL
!	$ MACRO FTN_UNITS
!	$ MACRO FTN_STATEMENT
!	$ MACRO FTN_FORMAT
!	$ MACRO FTN_EDIT
!	$ MACRO FTN_FLOAT
!	$ MACRO FTN_LISTOUT
!	$ MACRO FTN_LISTIN
!	$ MACRO FTN_NAMELIST
!	$ MACRO FTN_INTERNAL
!	$ MACRO FTN_OPEN
!	$ MACRO FTN_INQUIRE
!	$ MACRO FTN_POSITION
!	$ MACRO FTN_UNFORMATTED
!	$ MACRO FTN_DIRECT
!	$ MACRO FTN_RECORD
!	$ MACRO FTN_KEYED
!	$ MACRO FTN_INTRINSICS
!	$ MACRO FTN_SYSTEM
!	$ MACRO FTN_ALLOC
!	$ LINK/SHAREABLE=FTNRTL/NOSYSLIB FTNRTL/OPTIONS
!
! would, with internal/asm and internal/link, which take LIBRTL's and MTHRTL's
! symbols from govax's own tables. VMS's LINK finds them in IMAGELIB, so on VMS
! it is the same LINK without /NOSYSLIB (testdata/ftn86). The transfer vector is a
! cluster of its own, first, so that it starts the image; the modules
! follow. GSMATCH=LEQUAL lets a program linked against this FTNRTL run on
! any later one: add 1 to the minor number whenever the vector gains an
! entry, and change the major number only if an entry's meaning changes.
CLUSTER=FTNRTL_VECTOR,,,FTN_VECTOR.OBJ
FTN_CONTROL.OBJ
FTN_UNITS.OBJ
FTN_STATEMENT.OBJ
FTN_FORMAT.OBJ
FTN_EDIT.OBJ
FTN_FLOAT.OBJ
FTN_LISTOUT.OBJ
FTN_LISTIN.OBJ
FTN_NAMELIST.OBJ
FTN_INTERNAL.OBJ
FTN_OPEN.OBJ
FTN_INQUIRE.OBJ
FTN_POSITION.OBJ
FTN_UNFORMATTED.OBJ
FTN_DIRECT.OBJ
FTN_RECORD.OBJ
FTN_KEYED.OBJ
FTN_INTRINSICS.OBJ
FTN_SYSTEM.OBJ
FTN_ALLOC.OBJ
GSMATCH=LEQUAL,1,33
IDENTIFICATION="V1.0"
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ DEFINE FTNRTL DUA1:[FTNRTL]FTNRTL.EXE
$ !
$ ! fcalc, the milestone program, in each of its variants: every script run in its
$ ! name's order, as TestFcalcMilestone runs them, since STATE's files are read later;
$ ! then the files the scripts wrote, and ONESHOT.COM, fcalc as a foreign command.
$ !
$ WRITE SYS$OUTPUT "==== FCALC"
==== FCALC
$ SET DEFAULT DUA1:[FCALC]
$ MACRO/NOLIST FCPLATFORM,FCKINDS,FCMESSAGES,FCVALUES,FCARRAYS,FCLEXER,FCTREE,FCSYMBOLS,FCFUNCS,FCPOLY,FCMATRIX,FCEVAL,FCNUMERIC,FCPLOT,FCSTATE,FCALC
$ LINK/NOMAP/EXECUTABLE=FCALC FCALC,FCPLATFORM,FCKINDS,FCMESSAGES,FCVALUES,FCARRAYS,FCLEXER,FCTREE,FCSYMBOLS,FCFUNCS,FCPOLY,FCMATRIX,FCEVAL,FCNUMERIC,FCPLOT,FCSTATE,DUA1:[FTNRTL]F90R/OPTIONS
! F90R.OPT - links a compiled Fortran 90 program against FTNRTL, which F90R.COM has built
! and defined. govax's LINK finds FTNRTL by itself; VMS's has to be told.
FTNRTL/SHAREABLE
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ WRITE SYS$OUTPUT "==== FCALC.BASICS"
==== FCALC.BASICS
$ DEFINE/USER_MODE SYS$INPUT BASICS.IN
$ RUN FCALC
