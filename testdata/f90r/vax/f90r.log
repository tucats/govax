             ^
%FCALC-E-NOTVECTOR, operand must be a vector
fcalc> table x for x to 1
                     ^
%FCALC-E-KEYWORD, FROM expected
fcalc> solve 1 for x
             ^
%FCALC-E-NOROOT, no root was found
fcalc> solve x^2 + 1 for x from 0 to 1
                           ^
%FCALC-E-SAMESIGN, no change of sign between the bounds
fcalc> integrate x^-0.9 for x from 0 to 1
9.99999497967
                 ^
%FCALC-W-INACCURATE, error may be as large as 1e-6
fcalc> table x for x from 0 to 1 step -0.5
                                      ^
%FCALC-E-BADSTEP, step does not lead from FROM to TO
fcalc> table x for x from 0 to 1 step 1e-6
                                      ^
%FCALC-E-TOOMANY, too many rows
fcalc> plot x for x from 1 to 0
                              ^
%FCALC-E-BADLIMITS, lower limit must be below upper limit
fcalc> plot sqrt(x - 5) for x from 0 to 1
            ^
%FCALC-E-NOPOINTS, no point can be plotted
fcalc> save
           ^
%FCALC-E-FILEREQ, file name expected
fcalc> @nosuch
        ^
%FCALC-E-NOFILE, file nosuch.fcalc was not found
fcalc> @deep1
fcalc> ! deep1.fcalc runs deep2.fcalc, and each the next: deep8.fcalc, eight files
fcalc> ! deep, runs a ninth, one too many.
fcalc> @deep2
fcalc> @deep3
fcalc> @deep4
fcalc> @deep5
fcalc> @deep6
fcalc> @deep7
fcalc> @deep8
fcalc> @deep9
        ^
%FCALC-E-NESTING, files are nested too deeply
-FCALC-I-INFILE, in line 1 of deep8.fcalc
-FCALC-I-INFILE, in line 1 of deep7.fcalc
-FCALC-I-INFILE, in line 1 of deep6.fcalc
-FCALC-I-INFILE, in line 1 of deep5.fcalc
-FCALC-I-INFILE, in line 1 of deep4.fcalc
-FCALC-I-INFILE, in line 1 of deep3.fcalc
-FCALC-I-INFILE, in line 1 of deep2.fcalc
-FCALC-I-INFILE, in line 3 of deep1.fcalc
fcalc> @self
fcalc> ! self.fcalc runs itself, which fcalc refuses.
fcalc> @self
        ^
