==== FCALCN.STATE
fcalc> set echo
fcalc> ! @ (or RUN) runs a file's lines as if they were typed.
fcalc> @setup
fcalc> ! setup.fcalc: a file of fcalc's commands, for the state script's @ and RUN.
fcalc> ! Each line runs as if it were typed: a value is shown unless the line ends
fcalc> ! in ;, and ! starts a comment.
fcalc> g = 9.80665
g = 9.80665
fcalc> fall(t) = g*t^2/2
fall(t) = g*t^2/2
fcalc> fall(2)
19.6133
fcalc> dropped = fall(10);
fcalc> fall(3)
44.129925
fcalc> dropped
490.3325
fcalc> run setup.fcalc
fcalc> ! setup.fcalc: a file of fcalc's commands, for the state script's @ and RUN.
fcalc> ! Each line runs as if it were typed: a value is shown unless the line ends
fcalc> ! in ;, and ! starts a comment.
fcalc> g = 9.80665
g = 9.80665
fcalc> fall(t) = g*t^2/2
fall(t) = g*t^2/2
fcalc> fall(2)
19.6133
fcalc> dropped = fall(10);
fcalc> ! RUN, LOAD, SAVE, and LOG are commands only when a file follows: with = or (
fcalc> ! after them, a variable or a function.
fcalc> run = 3
run = 3
fcalc> log(8, 2)
3
fcalc> log10(1000)
3
