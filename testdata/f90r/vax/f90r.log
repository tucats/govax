h(x) = scale * x
fcalc> h(2)
6
fcalc> x
100
fcalc> scale = 10
scale = 10
fcalc> h(2)
20
fcalc> ! A function may call others, defined before or after it.
fcalc> twice(n) = 2 * later(n)
twice(n) = 2 * later(n)
fcalc> later(n) = n + 1
later(n) = n + 1
fcalc> twice(5)
12
fcalc> ! Recursion: IF evaluates only the arm it chooses, so a function can stop.
fcalc> fact(n) = if(n < 2, 1, n * fact(n - 1))
fact(n) = if(n < 2, 1, n * fact(n - 1))
fcalc> fact(5)
120
fcalc> fact(20)
2.43290200818e+18
fcalc> fact(0)
1
fcalc> fib(n) = if(n < 2, n, fib(n - 1) + fib(n - 2))
fib(n) = if(n < 2, n, fib(n - 1) + fib(n - 2))
fcalc> fib(10)
55
fcalc> fib(15)
610
fcalc> gcdr(a, b) = if(b == 0, abs(a), gcdr(b, a mod b))
gcdr(a, b) = if(b == 0, abs(a), gcdr(b, a mod b))
