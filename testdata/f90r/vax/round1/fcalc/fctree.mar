	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCTREE.NEW_NODE.$K2:
	.LONG	^X00000000,^X00000000	; 0D0
FCTREE.NEW_NODE.$K1:
	.ASCII	/ /

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  188
;  189    function new_node(kind, column) result(p)
	.ENTRY	FCTREE.NEW_NODE,^M<R2,R3,R4,R5>
	CLRL	FCTREE.NEW_NODE.P
;  190      integer, intent(in) :: kind, column
;  191      type(node), pointer :: p
;  192
;  193      allocate (p)
	PUSHL	#96
	PUSHL	#6
	PUSHAL	FCTREE.NEW_NODE.P
