FCTREE.SCAN_LINE.LINE = 4		; LINE is argument 1

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCTREE.SCAN_LINE.$D1:
	.WORD	56			; length
	.BYTE	DSC$K_DTYPE_Z,DSC$K_CLASS_NCA
	.LONG	0			; set when the descriptor is used
	.BYTE	0,0,0,1			; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0			; strides, in bytes
	.LONG	0,0			; bounds

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  117
;  118    ! ------------------------------------------------------------------
;  119    ! The tokens.
;  120
;  121    ! SCAN_LINE tokenizes a line for the parser, which starts at its first
;  122    ! token.
;  123    subroutine scan_line(line)
	.ENTRY	FCTREE.SCAN_LINE,^M<>
;  124      character(len=*), intent(in) :: line
;  125
;  126      call tokenize(line, tokens, count)
	MOVAB	FCTREE.TOKENS,FCTREE.SCAN_LINE.$D1+4
	MOVL	#56,FCTREE.SCAN_LINE.$D1+20
	MOVL	#1,FCTREE.SCAN_LINE.$D1+24
	MOVL	#200,FCTREE.SCAN_LINE.$D1+28
	SUBL3	#56,FCTREE.SCAN_LINE.$D1+4,FCTREE.SCAN_LINE.$D1+16
	MOVL	#11200,FCTREE.SCAN_LINE.$D1+12
	PUSHAL	FCTREE.COUNT
	PUSHAQ	FCTREE.SCAN_LINE.$D1
	PUSHL	FCTREE.SCAN_LINE.LINE(AP)
	CALLS	#3,G^FCLEXER.TOKENIZE
;  127      pos = 1
	MOVL	#1,FCTREE.POS
;  128      depth = 0
	CLRL	FCTREE.DEPTH
;  129    end subroutine scan_line
	RET

; Storage map for FCTREE.TOKEN_AT, a TYPE(TOKEN) function
;   T     TYPE(TOKEN)          hidden argument 1  @FCTREE.TOKEN_AT.T(AP)
