;  194      nodes = nodes + 1
	INCL	FCTREE.NODES
;  195      p%kind = kind
	MOVL	@FCTREE.NEW_NODE.KIND(AP),@FCTREE.NEW_NODE.P
;  196      p%op = 0
	MOVL	FCTREE.NEW_NODE.P,R0
