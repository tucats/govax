	CALLS	#1,G^FCTREE.IS_OPERATOR
	MOVL	R0,R6
	BLBS	R6,FCTREE.PARSE_MATRIX.$16
;  651        call fail(e_rbracket, tokens(pos)%column)
	PUSHL	#0
	MULL3	FCTREE.POS,#14,R0
	PUSHAL	FCTREE.TOKENS-52[R0]
	PUSHAL	FCTREE.PARSE_MATRIX.$K7
	CALLS	#3,G^FCMESSAGES.FAIL
;  652        call free_tree(p)
	PUSHAL	FCTREE.PARSE_MATRIX.P(FP)
	CALLS	#1,G^FCTREE.FREE_TREE
;  653        return
	MOVL	FCTREE.PARSE_MATRIX.P(FP),R0 ; the function's value
	RET
FCTREE.PARSE_MATRIX.$16:
;  654      end if
;  655      call advance(1)
	PUSHAL	FCTREE.PARSE_MATRIX.$K2
	CALLS	#1,G^FCTREE.ADVANCE
;  656    end function parse_matrix
	MOVL	FCTREE.PARSE_MATRIX.P(FP),R0 ; the function's value
	RET
;  657  end module fctree

	.END
