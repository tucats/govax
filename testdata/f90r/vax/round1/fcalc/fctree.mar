;    1  ! fcalc: expressions as trees, and the parser that builds them.
;    2  !
;    3  ! A NODE is a number, a name, a function's call, or an operation. Its
;    4  ! operands, or a call's arguments, are a list: KID points to the first, and
;    5  ! each one's NEXT to the one after it. The parser is recursive descent, a
;    6  ! function for each level of the grammar, loosest first:
;    7  !
;    8  !     or-expr     and-expr { or and-expr }
;    9  !     and-expr    not-expr { and not-expr }
;   10  !     not-expr    not not-expr | comparison
;   11  !     comparison  sum [ (== | <> | < | <= | > | >=) sum ]
;   12  !     sum         term { (+ | -) term }
;   13  !     term        unary { (* | / | mod | .* | ./ | \) unary }
;   14  !     unary       (- | +) unary | power
;   15  !     power       postfix [ (^ | .^) unary ]
;   16  !     postfix     primary { ! | ' | .' }
;   17  !     primary     number | name | name ( [ argument { , argument } ] )
;   18  !                 | ( or-expr ) | [ row { ; row } ]
;   19  !     row         or-expr { , or-expr }
;   20  !     argument    or-expr | [ or-expr ] : [ or-expr ] [ : or-expr ]
;   21  !
;   22  ! so ^ binds tighter than a sign (-2^2 is -4) but takes one after it (2^-1),
;   23  ! and is right-associative (2^3^2 is 2^9). Each function returns a tree, or
;   24  ! a null pointer after calling FAIL, having freed what it had built.
;   25  !
;   26  ! A bracket makes a matrix, its rows parted by semicolons and the elements
;   27  ! of a row by commas: [1, 2; 3, 4]. An argument may be a range, lo:hi or
;   28  ! lo:hi:stride with any part left out, which only an index may have:
;   29  ! m(2, :) is the second row of m, v(1:5:2) every other element of v's first
;   30  ! five.
;   31  !
;   32  ! Recursive descent, briefly: each rule of the grammar above becomes a
;   33  ! function that parses that rule, calling the functions of the rules it is
;   34  ! made of. The order of the rules gives the precedence: PARSE_SUM calls
;   35  ! PARSE_TERM for its operands, so in 1 + 2 * 3 the 2 * 3 is a term, parsed
;   36  ! first and placed lower in the tree. A loop (the { } of a rule) makes an
;   37  ! operator left-associative: 2 - 3 - 4 is (2 - 3) - 4, each new operation
;   38  ! taking the tree so far as its left operand. A rule that calls itself for
;   39  ! its right operand, as POWER does through UNARY, makes it right-
;   40  ! associative. A parenthesis starts again at the loosest rule, OR-EXPR.
;   41  !
;   42  ! Pointers in Fortran 90. A variable declared POINTER doesn't hold a value
;   43  ! itself: it is associated with (points to) a target, or is null.
;   44  ! ALLOCATE (p) makes a new target and points P at it; DEALLOCATE (p) gives
;   45  ! it back; NULLIFY (p) makes P null; ASSOCIATED(p) asks whether P points
;   46  ! anywhere; p => q makes P point where Q does (pointer assignment), while
;   47  ! p = q copies Q's value into P's target. A derived type may have
;   48  ! components that are pointers to its own type, which is how linked lists
;   49  ! and trees are built: a NODE here points to its first operand (KID) and to
;   50  ! the next node in its list (NEXT). Fortran 90 has no garbage collector:
;   51  ! each node ALLOCATEd must be DEALLOCATEd when it is no longer needed, by
;   52  ! FREE_TREE, or the memory is lost (a leak) until the program ends.
;   53  module fctree
;   54    use fckinds
;   55    use fcmessages
;   56    use fcvalues
;   57    use fclexer
;   58    implicit none
;   59    private
;   60
;   61    ! VALUE and TOKEN are public here too: a public type's component, or a
;   62    ! public function's value, may not be of a type private in this module,
;   63    ! as the default PRIVATE would make them.
;   64    public :: value, token
;   65    public :: node, scan_line, parse_expression, free_tree, copy_tree
;   66    public :: token_at, token_count, kind_at, current_column, position, advance, at_end, is_operator
;   67    public :: n_number, n_name, n_call, n_operation, n_matrix, n_row, n_range
;   68    public :: op_add, op_sub, op_mul, op_div, op_mod, op_power, op_neg, op_plus, &
;   69      op_not, op_and, op_or, op_compare, op_factorial, op_emul, op_ediv, &
;   70      op_epower, op_solve, op_transpose, op_ctranspose
;   71    public :: range_lo, range_hi, range_stride, nodes_in_use
;   72
;   73    ! The kinds of node. A matrix's operands are its rows, and a row's its
;   74    ! elements. A range's operands are the parts it was given, in order, and
;   75    ! its OP says which those are: RANGE_LO, RANGE_HI, and RANGE_STRIDE added
;   76    ! together, so 1:5 is 3 and :: 2 is 4.
;   77    integer, parameter :: n_number = 1, n_name = 2, n_call = 3, n_operation = 4, &
;   78      n_matrix = 5, n_row = 6, n_range = 7
;   79    integer, parameter :: range_lo = 1, range_hi = 2, range_stride = 4
;   80
;   81    ! The operations. A comparison is OP_COMPARE plus its relation, 1 to 6
;   82    ! (V_COMPARE's).
;   83    integer, parameter :: op_add = 1, op_sub = 2, op_mul = 3, op_div = 4, &
;   84      op_mod = 5, op_power = 6, op_neg = 7, op_plus = 8, op_not = 9, &
;   85      op_and = 10, op_or = 11, op_factorial = 12, op_emul = 13, op_ediv = 14, &
;   86      op_epower = 15, op_solve = 16, op_transpose = 17, op_ctranspose = 18, &
;   87      op_compare = 20
;   88
;   89    ! A node: what it is (KIND), its operation (OP, for an operation), the
;   90    ! column it came from, a name's or call's NAME, a number's value, and its
;   91    ! operands or arguments (KID, then each one's NEXT). In Fortran 90 a
;   92    ! component can't be given an initial value (that came in Fortran 95), so
;   93    ! NEW_NODE sets every component, the pointers to null, as it makes one.
;   94    type node
;   95      integer :: kind
;   96      integer :: op
;   97      integer :: column
;   98      character(len=name_length) :: name
;   99      type(value) :: number
;  100      type(node), pointer :: kid
;  101      type(node), pointer :: next
;  102    end type node
;  103
;  104    ! How deeply expressions may nest.
;  105    integer, parameter :: depth_limit = 100
;  106
;  107    ! The line's tokens, and the parser's place in them.
;  108    type(token), save :: tokens(line_length + 1)
;  109    integer, save :: count = 0, pos = 1, depth = 0
;  110
;  111    ! The nodes made and not yet freed, for SHOW MEMORY.
;  112    integer, save :: nodes = 0
;  113
;  114    character(len=2), parameter :: relations(6) = (/ '==', '<>', '< ', '<=', '> ', '>=' /)
;  115
;  116  contains

