	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  241
;  242    ! COPY_TREE is a copy of the tree P (but not the trees after it). Q = P
;  243    ! copies every component, the pointers too, so the copy's KID and NEXT are
;  244    ! nullified at once and the operands copied one by one: a copy must share
;  245    ! no node with the original, or freeing one would free part of the other.
;  246    ! A function whose result is a POINTER is used with =>, as q => copy_tree(p).
;  247    recursive function copy_tree(p) result(q)
	.ENTRY	FCTREE.COPY_TREE,^M<R2,R3,R4,R5,R6>
	SUBL2	#20,SP			; this activation's own storage
	CLRL	FCTREE.COPY_TREE.FROM(FP)
	CLRL	FCTREE.COPY_TREE.LAST(FP)
	CLRL	FCTREE.COPY_TREE.Q(FP)
;  248      type(node), pointer :: p
;  249      type(node), pointer :: q
;  250      type(node), pointer :: from, last, made
;  251
;  252      nullify (q)
;  253      if (.not. associated(p)) return
	TSTL	@FCTREE.COPY_TREE.P(AP)
	BNEQ	FCTREE.COPY_TREE.$1
	CLRL	R0			; the function's value
	RET
FCTREE.COPY_TREE.$1:
;  254
;  255      allocate (q)
	PUSHL	#96
	PUSHL	#6
	PUSHAL	FCTREE.COPY_TREE.Q(FP)
	CALLS	#3,G^FTN$ALLOC_SCALAR
;  256      nodes = nodes + 1
	INCL	FCTREE.NODES
;  257      q = p
	MOVL	@FCTREE.COPY_TREE.P(AP),R0
	MOVC3	#96,(R0),@FCTREE.COPY_TREE.Q(FP)
;  258      nullify (q%kid, q%next)
	MOVL	FCTREE.COPY_TREE.Q(FP),R0
	CLRL	80(R0)
	MOVL	FCTREE.COPY_TREE.Q(FP),R0
	CLRL	84(R0)
;  259
;  260      nullify (last)
;  261      from => p%kid
	MOVL	@FCTREE.COPY_TREE.P(AP),R0
	MOVL	80(R0),FCTREE.COPY_TREE.FROM(FP)
;  262      do while (associated(from))
	BRB	FCTREE.COPY_TREE.$3
FCTREE.COPY_TREE.$4:			; DO (line 262)'s body
;  263        made => copy_tree(from)
	PUSHAL	FCTREE.COPY_TREE.FROM(FP)
	CALLS	#1,FCTREE.COPY_TREE
	MOVL	R0,R6
	MOVL	R6,FCTREE.COPY_TREE.MADE(FP)
;  264        if (associated(last)) then
	TSTL	FCTREE.COPY_TREE.LAST(FP)
	BEQL	FCTREE.COPY_TREE.$5
;  265          last%next => made
	MOVL	FCTREE.COPY_TREE.LAST(FP),R0
	MOVL	FCTREE.COPY_TREE.MADE(FP),84(R0)
;  266        else
	BRB	FCTREE.COPY_TREE.$7
FCTREE.COPY_TREE.$5:
;  267          q%kid => made
	MOVL	FCTREE.COPY_TREE.Q(FP),R0
	MOVL	FCTREE.COPY_TREE.MADE(FP),80(R0)
;  268        end if
FCTREE.COPY_TREE.$7:
;  269        last => made
	MOVL	FCTREE.COPY_TREE.MADE(FP),FCTREE.COPY_TREE.LAST(FP)
;  270        from => from%next
	MOVL	FCTREE.COPY_TREE.FROM(FP),R0
	MOVL	84(R0),FCTREE.COPY_TREE.FROM(FP)
;  271      end do
FCTREE.COPY_TREE.$3:			; DO (line 262)'s test
	TSTL	FCTREE.COPY_TREE.FROM(FP) ; from line 262
	BNEQ	FCTREE.COPY_TREE.$4
;  272    end function copy_tree
	MOVL	FCTREE.COPY_TREE.Q(FP),R0 ; the function's value
	RET

