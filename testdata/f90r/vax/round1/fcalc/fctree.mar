;  198      p%name = ' '
	MOVL	FCTREE.NEW_NODE.P,R0
	MOVC5	#1,FCTREE.NEW_NODE.$K1,#^A/ /,#31,12(R0)
;  199      p%number = real_value(0.0_rk)
	PUSHAG	FCTREE.NEW_NODE.$K2
	PUSHAB	FCTREE.NEW_NODE.$T1
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVL	FCTREE.NEW_NODE.P,R0
	MOVC3	#32,FCTREE.NEW_NODE.$T1,48(R0)
;  200      nullify (p%kid, p%next)
