	MULL3	FCTREE.POS,#14,R0
	MOVL	FCTREE.TOKENS-52[R0],FCTREE.PARSE_ARGUMENT.COLUMN(FP)
;  561      if (.not. is_operator(':')) then
	PUSHAQ	FCTREE.PARSE_ARGUMENT.$D1
