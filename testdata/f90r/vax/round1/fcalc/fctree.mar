	RET

; Storage map for FCTREE.OPERATION, a TYPE(NODE) function
;   OP      INTEGER, INTENT(IN)            argument 1   @FCTREE.OPERATION.OP(AP)
;   COLUMN  INTEGER, INTENT(IN)            argument 2   @FCTREE.OPERATION.COLUMN(AP)
;   LEFT    TYPE(NODE), POINTER            argument 3   @FCTREE.OPERATION.LEFT(AP)
;   RIGHT   TYPE(NODE), POINTER, OPTIONAL  an argument  @FCTREE.OPERATION.$A4
;   P       TYPE(NODE), POINTER            $LOCAL+0     FCTREE.OPERATION.P
;   R6 is $T1: temporary
;
FCTREE.OPERATION.OP = 4			; OP is argument 1
FCTREE.OPERATION.COLUMN = 8		; COLUMN is argument 2
FCTREE.OPERATION.LEFT = 12		; LEFT is argument 3

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
	.ALIGN	4			; the boundary of this routine's aligned records
FCTREE.OPERATION.P:
	.BLKL	1			; P, the function's value
	.BLKB	4
FCTREE.OPERATION.$A4:
	.BLKL	1			; RIGHT's longword of the argument list, set at each entry point

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCTREE.OPERATION.$K1:
	.LONG	4

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  202
;  203    ! OPERATION makes a node of an operation on LEFT (and RIGHT, if it is
;  204    ! given). If the parse has failed, it frees them instead and returns a
;  205    ! null pointer.
;  206    function operation(op, column, left, right) result(p)
	.ENTRY	FCTREE.OPERATION,^M<R6>
	CLRL	FCTREE.OPERATION.$A4	; RIGHT is argument 4, if the caller passed it
	CMPB	(AP),#4
	BLSSU	FCTREE.OPERATION.$7
	MOVL	16(AP),FCTREE.OPERATION.$A4
FCTREE.OPERATION.$7:
;  207      integer, intent(in) :: op, column
;  208      type(node), pointer :: left
;  209      type(node), pointer, optional :: right
;  210      type(node), pointer :: p
;  211
;  212      if (failed()) then
	CALLS	#0,G^FCMESSAGES.FAILED
	MOVL	R0,R6
	BLBC	R6,FCTREE.OPERATION.$1
;  213        call free_tree(left)
	PUSHAL	@FCTREE.OPERATION.LEFT(AP)
	CALLS	#1,G^FCTREE.FREE_TREE
;  214        if (present(right)) call free_tree(right)
	TSTL	FCTREE.OPERATION.$A4
	BEQL	FCTREE.OPERATION.$3
	PUSHAL	@FCTREE.OPERATION.$A4
	CALLS	#1,G^FCTREE.FREE_TREE
FCTREE.OPERATION.$3:
;  215        nullify (p)
;  216        return
	CLRL	R0			; the function's value
	RET
FCTREE.OPERATION.$1:
;  217      end if
;  218
;  219      p => new_node(n_operation, column)
	PUSHAL	@FCTREE.OPERATION.COLUMN(AP)
	PUSHAL	FCTREE.OPERATION.$K1
	CALLS	#2,G^FCTREE.NEW_NODE
	MOVL	R0,R6
	MOVL	R6,FCTREE.OPERATION.P
;  220      p%op = op
	MOVL	FCTREE.OPERATION.P,R0
	MOVL	@FCTREE.OPERATION.OP(AP),4(R0)
;  221      p%kid => left
	MOVL	FCTREE.OPERATION.P,R0
	MOVL	@FCTREE.OPERATION.LEFT(AP),80(R0)
;  222      if (present(right)) left%next => right
	TSTL	FCTREE.OPERATION.$A4
	BEQL	FCTREE.OPERATION.$5
	MOVL	@FCTREE.OPERATION.LEFT(AP),R0
	MOVL	@FCTREE.OPERATION.$A4,84(R0)
FCTREE.OPERATION.$5:
;  223    end function operation
	MOVL	FCTREE.OPERATION.P,R0	; the function's value
	RET

; Storage map for FCTREE.FREE_TREE, a RECURSIVE subroutine
;   P          TYPE(NODE), POINTER  argument 1  @FCTREE.FREE_TREE.P(AP)
;   FOLLOWING  TYPE(NODE), POINTER  FP-4        FCTREE.FREE_TREE.FOLLOWING(FP)
;   R6 is $R1: P's address
;
FCTREE.FREE_TREE.P = 4			; P is argument 1
FCTREE.FREE_TREE.FOLLOWING = -4		; FOLLOWING, in the frame

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  224
;  225    ! FREE_TREE frees a tree and the trees after it in its list: each node's
;  226    ! operands first (recursively), then the node. NEXT is saved before the
;  227    ! node is deallocated, since the node's components are gone after. P is
;  228    ! null when it returns.
;  229    recursive subroutine free_tree(p)
	.ENTRY	FCTREE.FREE_TREE,^M<R6>
	SUBL2	#4,SP			; this activation's own storage
;  230      type(node), pointer :: p
;  231      type(node), pointer :: following
;  232
;  233      do while (associated(p))
	MOVL	FCTREE.FREE_TREE.P(AP),R6
	BRB	FCTREE.FREE_TREE.$1
FCTREE.FREE_TREE.$2:			; DO (line 233)'s body
;  234        call free_tree(p%kid)
	MOVL	(R6),R0
	PUSHAL	80(R0)
	CALLS	#1,FCTREE.FREE_TREE
;  235        following => p%next
	MOVL	(R6),R0
	MOVL	84(R0),FCTREE.FREE_TREE.FOLLOWING(FP)
;  236        deallocate (p)
	PUSHL	#96
	PUSHL	#2
	PUSHAL	(R6)
	CALLS	#3,G^FTN$DEALLOC_SCALAR
;  237        nodes = nodes - 1
	DECL	FCTREE.NODES
;  238        p => following
	MOVL	FCTREE.FREE_TREE.FOLLOWING(FP),(R6)
;  239      end do
FCTREE.FREE_TREE.$1:			; DO (line 233)'s test
	TSTL	(R6)			; from line 233
	BNEQ	FCTREE.FREE_TREE.$2
;  240    end subroutine free_tree
	RET

; Storage map for FCTREE.COPY_TREE, a RECURSIVE TYPE(NODE) function
;   P     TYPE(NODE), POINTER  argument 1  @FCTREE.COPY_TREE.P(AP)
;   Q     TYPE(NODE), POINTER  FP-20       FCTREE.COPY_TREE.Q(FP)
