FCNUMERIC.BRENT.$75:
;  537          b = r_add(b, sign(tol, xm), err)
	MOVG	FCNUMERIC.BRENT.TOL,FCNUMERIC.BRENT.$T3
	TSTG	FCNUMERIC.BRENT.XM
	BLSS	FCNUMERIC.BRENT.$78
	TSTG	FCNUMERIC.BRENT.$T3
	BGEQ	FCNUMERIC.BRENT.$82
	BRB	FCNUMERIC.BRENT.$80
FCNUMERIC.BRENT.$78:
	TSTG	FCNUMERIC.BRENT.$T3
