FCNUMERIC.SOLVE_COMMAND.$K9:
	.LONG	12
FCNUMERIC.SOLVE_COMMAND.$K10:
	.LONG	-1
FCNUMERIC.SOLVE_COMMAND.$K3:
	.ASCII	/=/
FCNUMERIC.SOLVE_COMMAND.$K4:
	.ASCII	/for/
FCNUMERIC.SOLVE_COMMAND.$K5:
	.ASCII	/FOR/
FCNUMERIC.SOLVE_COMMAND.$K6:
	.ASCII	/from/
FCNUMERIC.SOLVE_COMMAND.$K8:
