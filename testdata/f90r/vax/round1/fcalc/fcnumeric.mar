;  544
;  545      ! REAL_VALUE_AT: the expression's value at X is real, FX; NOTREAL if
;  546      ! not (recorded at the expression's start).
;  547      logical function real_value_at(x, fx) result(ok)
FCNUMERIC.BRENT.REAL_VALUE_AT:
	.WORD	^M<R2,R3,R4,R5>		; internal procedure REAL_VALUE_AT of FCNUMERIC.BRENT
;  548        real(rk), intent(in) :: x
