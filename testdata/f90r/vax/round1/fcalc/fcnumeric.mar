;   NAME         CHARACTER*31         $LOCAL+20   FCNUMERIC.SOLVE_COMMAND.NAME
;   A            TYPE(VALUE)          $LOCAL+64   FCNUMERIC.SOLVE_COMMAND.A
;   B            TYPE(VALUE)          $LOCAL+96   FCNUMERIC.SOLVE_COMMAND.B
;   ROOT         TYPE(VALUE)          $LOCAL+128  FCNUMERIC.SOLVE_COMMAND.ROOT
;   START        INTEGER              $LOCAL+160  FCNUMERIC.SOLVE_COMMAND.START
;   FROM_COLUMN  INTEGER              $LOCAL+164  FCNUMERIC.SOLVE_COMMAND.$N5
;   COLUMN       INTEGER              $LOCAL+168  FCNUMERIC.SOLVE_COMMAND.COLUMN
;   BRACKET      LOGICAL              $LOCAL+172  FCNUMERIC.SOLVE_COMMAND.BRACKET
;   FOUND        LOGICAL              $LOCAL+176  FCNUMERIC.SOLVE_COMMAND.FOUND
;   R6 is $T2: temporary
;   FCNUMERIC.SOLVE_COMMAND.$N5 is FCNUMERIC.SOLVE_COMMAND.FROM_COLUMN
;

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
	.ALIGN	4			; the boundary of this routine's aligned records
FCNUMERIC.SOLVE_COMMAND.LEFT:
