	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  408
;  409    ! BRENT: ROOT is a root of the expression between A and B, where it must
;  410    ! be real and change sign, found by Brent's method (R. P. Brent,
;  411    ! "Algorithms for Minimization without Derivatives", 1973), in the form
;  412    ! many libraries give it.
;  413    !
;  414    ! The method keeps a bracket, B and C, the root between them, B the end
;  415    ! whose value is smaller, and A the last B. Each step tries to guess the
;  416    ! root from the last points, by inverse quadratic interpolation through
;  417    ! (A, fA), (B, fB), (C, fC) (x as a quadratic in f, evaluated at f = 0),
;  418    ! or the secant through two; and takes the guess only if it lands well
;  419    ! inside the bracket and shrinks it quickly enough, bisecting the bracket
;  420    ! otherwise. So it is as fast as the secant method near a simple root, yet
;  421    ! never slower than bisection, which always converges: a bracket of width
;  422    ! w is narrowed below t in at most about log2(w/t) bisections, and the
;  423    ! steps between them are faster still.
;  424    !
;  425    ! Every operation is guarded: near a root the values are tiny, and their
;  426    ! products could underflow.
;  427    logical function brent(left, right, name, a0, b0, start, from_column, root) result(found)
	.ENTRY	FCNUMERIC.BRENT,^M<R2,R3,R4,R5,R6,R7,R8,R9>
	MOVL	4(AP),FCNUMERIC.BRENT.$A1 ; LEFT is argument 1
	MOVL	8(AP),FCNUMERIC.BRENT.$A2 ; RIGHT is argument 2
	MOVL	12(AP),FCNUMERIC.BRENT.$A3 ; NAME is argument 3
	MOVL	24(AP),FCNUMERIC.BRENT.$A6 ; START is argument 6
;  428      type(node), pointer :: left, right
;  429      character(len=*), intent(in) :: name
;  430      real(rk), intent(in) :: a0, b0
;  431      integer, intent(in) :: start, from_column
;  432      type(value), intent(out) :: root
;  433      real(rk) :: a, b, c, d, e, fa, fb, fc, p, q, r, s, tol, xm, width
;  434      integer :: k, err
;  435
;  436      found = .false.
;  437      root = real_value(0.0_rk)
	PUSHAG	FCNUMERIC.BRENT.$K1
	PUSHAB	FCNUMERIC.BRENT.$T1
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCNUMERIC.BRENT.$T1,@FCNUMERIC.BRENT.ROOT(AP)
;  438      err = 0
	CLRL	FCNUMERIC.BRENT.ERR
;  439      a = a0
	MOVG	@FCNUMERIC.BRENT.A0(AP),FCNUMERIC.BRENT.A
;  440      b = b0
	MOVG	@FCNUMERIC.BRENT.B0(AP),FCNUMERIC.BRENT.B
;  441      if (.not. real_value_at(a, fa)) return
	PUSHAG	FCNUMERIC.BRENT.FA
	PUSHAG	FCNUMERIC.BRENT.A
	CALLS	#2,FCNUMERIC.BRENT.REAL_VALUE_AT
	MOVL	R0,R7
	BLBS	R7,FCNUMERIC.BRENT.$1
	CLRL	R0			; the function's value
	RET
FCNUMERIC.BRENT.$1:
;  442      if (.not. real_value_at(b, fb)) return
	PUSHAG	FCNUMERIC.BRENT.FB
	PUSHAG	FCNUMERIC.BRENT.B
	CALLS	#2,FCNUMERIC.BRENT.REAL_VALUE_AT
	MOVL	R0,R7
	BLBS	R7,FCNUMERIC.BRENT.$3
	CLRL	R0			; the function's value
	RET
FCNUMERIC.BRENT.$3:
;  443      if (fa == 0) then
	TSTG	FCNUMERIC.BRENT.FA
	BNEQ	FCNUMERIC.BRENT.$5
;  444        root = real_value(a)
	PUSHAG	FCNUMERIC.BRENT.A
	PUSHAB	FCNUMERIC.BRENT.$T1
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCNUMERIC.BRENT.$T1,@FCNUMERIC.BRENT.ROOT(AP)
;  445        found = .true.
;  446        return
	MOVL	#-1,R0			; the function's value
	RET
FCNUMERIC.BRENT.$5:
;  447      end if
;  448      if (fb == 0) then
	TSTG	FCNUMERIC.BRENT.FB
	BNEQ	FCNUMERIC.BRENT.$7
;  449        root = real_value(b)
	PUSHAG	FCNUMERIC.BRENT.B
	PUSHAB	FCNUMERIC.BRENT.$T1
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCNUMERIC.BRENT.$T1,@FCNUMERIC.BRENT.ROOT(AP)
;  450        found = .true.
;  451        return
	MOVL	#-1,R0			; the function's value
	RET
FCNUMERIC.BRENT.$7:
;  452      end if
;  453      if ((fa > 0) .eqv. (fb > 0)) then
	CLRL	R0
	TSTG	FCNUMERIC.BRENT.FA
	BLEQ	FCNUMERIC.BRENT.$10
	MNEGL	#1,R0
FCNUMERIC.BRENT.$10:
	CLRL	R1
	TSTG	FCNUMERIC.BRENT.FB
	BLEQ	FCNUMERIC.BRENT.$11
	MNEGL	#1,R1
FCNUMERIC.BRENT.$11:
	XORL2	R1,R0
	BLBS	R0,FCNUMERIC.BRENT.$9
;  454        call fail(e_samesign, from_column)
	PUSHL	#0
	PUSHAL	@FCNUMERIC.BRENT.FROM_COLUMN(AP)
	PUSHAL	FCNUMERIC.BRENT.$K2
	CALLS	#3,G^FCMESSAGES.FAIL
;  455        return
	CLRL	R0			; the function's value
	RET
FCNUMERIC.BRENT.$9:
;  456      end if
;  457
;  458      ! WIDTH, a rounding error's size beside the bracket's ends: a root
;  459      ! closer to 0 than that is 0, as far as the bracket can tell.
;  460      width = scaled(eps, max(abs(a), abs(b)))
	MOVG	FCNUMERIC.BRENT.A,FCNUMERIC.BRENT.$T4
	BGEQ	FCNUMERIC.BRENT.$13
	MNEGG	FCNUMERIC.BRENT.$T4,FCNUMERIC.BRENT.$T4
FCNUMERIC.BRENT.$13:
	MOVG	FCNUMERIC.BRENT.$T4,FCNUMERIC.BRENT.$T3
	MOVG	FCNUMERIC.BRENT.B,FCNUMERIC.BRENT.$T5
	BGEQ	FCNUMERIC.BRENT.$15
	MNEGG	FCNUMERIC.BRENT.$T5,FCNUMERIC.BRENT.$T5
FCNUMERIC.BRENT.$15:
	CMPG	FCNUMERIC.BRENT.$T5,FCNUMERIC.BRENT.$T3
	BLEQ	FCNUMERIC.BRENT.$17
	MOVG	FCNUMERIC.BRENT.$T5,FCNUMERIC.BRENT.$T3
FCNUMERIC.BRENT.$17:
	PUSHAG	FCNUMERIC.BRENT.$T3
	PUSHAG	FCNUMERIC.BRENT.$K3
	CALLS	#2,G^FCNUMERIC.SCALED
	MOVG	R0,FCNUMERIC.BRENT.WIDTH
;  461
;  462      c = b
	MOVG	FCNUMERIC.BRENT.B,FCNUMERIC.BRENT.C
;  463      fc = fb
	MOVG	FCNUMERIC.BRENT.FB,FCNUMERIC.BRENT.FC
;  464      d = r_add(b, -a, err)
	MNEGG	FCNUMERIC.BRENT.A,FCNUMERIC.BRENT.$T5
	PUSHAL	FCNUMERIC.BRENT.ERR
	PUSHAG	FCNUMERIC.BRENT.$T5
	PUSHAG	FCNUMERIC.BRENT.B
	CALLS	#3,G^FCVALUES.R_ADD
	MOVG	R0,FCNUMERIC.BRENT.D
;  465      e = d
	MOVG	FCNUMERIC.BRENT.D,FCNUMERIC.BRENT.E
;  466      do k = 1, step_limit
	MOVL	#1,FCNUMERIC.BRENT.K
	MOVL	FCNUMERIC.BRENT.K,R6
	MOVQ	FCNUMERIC.BRENT.R,R8
FCNUMERIC.BRENT.$19:			; DO (line 466)'s body
;  467        ! C is the end of the bracket opposite B.
;  468        if ((fb > 0) .eqv. (fc > 0)) then
	CLRL	R0
	TSTG	FCNUMERIC.BRENT.FB
	BLEQ	FCNUMERIC.BRENT.$21
	MNEGL	#1,R0
FCNUMERIC.BRENT.$21:
	CLRL	R1
	TSTG	FCNUMERIC.BRENT.FC
	BLEQ	FCNUMERIC.BRENT.$22
	MNEGL	#1,R1
FCNUMERIC.BRENT.$22:
	XORL2	R1,R0
	BLBS	R0,FCNUMERIC.BRENT.$20
;  469          c = a
	MOVG	FCNUMERIC.BRENT.A,FCNUMERIC.BRENT.C
;  470          fc = fa
	MOVG	FCNUMERIC.BRENT.FA,FCNUMERIC.BRENT.FC
;  471          d = r_add(b, -a, err)
	MNEGG	FCNUMERIC.BRENT.A,FCNUMERIC.BRENT.$T5
	PUSHAL	FCNUMERIC.BRENT.ERR
	PUSHAG	FCNUMERIC.BRENT.$T5
	PUSHAG	FCNUMERIC.BRENT.B
	CALLS	#3,G^FCVALUES.R_ADD
	MOVG	R0,FCNUMERIC.BRENT.D
;  472          e = d
	MOVG	FCNUMERIC.BRENT.D,FCNUMERIC.BRENT.E
;  473        end if
FCNUMERIC.BRENT.$20:
;  474        ! B is the end whose value is smaller.
;  475        if (abs(fc) < abs(fb)) then
	MOVG	FCNUMERIC.BRENT.FC,FCNUMERIC.BRENT.$T5
	BGEQ	FCNUMERIC.BRENT.$24
	MNEGG	FCNUMERIC.BRENT.$T5,FCNUMERIC.BRENT.$T5
FCNUMERIC.BRENT.$24:
	MOVG	FCNUMERIC.BRENT.FB,FCNUMERIC.BRENT.$T4
	BGEQ	FCNUMERIC.BRENT.$26
	MNEGG	FCNUMERIC.BRENT.$T4,FCNUMERIC.BRENT.$T4
FCNUMERIC.BRENT.$26:
	CMPG	FCNUMERIC.BRENT.$T5,FCNUMERIC.BRENT.$T4
	BGEQ	FCNUMERIC.BRENT.$28
;  476          a = b
	MOVG	FCNUMERIC.BRENT.B,FCNUMERIC.BRENT.A
;  477          b = c
	MOVG	FCNUMERIC.BRENT.C,FCNUMERIC.BRENT.B
;  478          c = a
	MOVG	FCNUMERIC.BRENT.A,FCNUMERIC.BRENT.C
;  479          fa = fb
	MOVG	FCNUMERIC.BRENT.FB,FCNUMERIC.BRENT.FA
;  480          fb = fc
	MOVG	FCNUMERIC.BRENT.FC,FCNUMERIC.BRENT.FB
;  481          fc = fa
	MOVG	FCNUMERIC.BRENT.FA,FCNUMERIC.BRENT.FC
;  482        end if
FCNUMERIC.BRENT.$28:
;  483
;  484        ! Done when the bracket's half width, XM, is within TOL, two rounding
;  485        ! errors beside B (and half of WIDTH, for a root at 0).
;  486        tol = r_add(scaled(2 * eps, abs(b)), scaled(0.5_rk, width), err)
	MOVG	FCNUMERIC.BRENT.B,FCNUMERIC.BRENT.$T5
	BGEQ	FCNUMERIC.BRENT.$30
	MNEGG	FCNUMERIC.BRENT.$T5,FCNUMERIC.BRENT.$T5
FCNUMERIC.BRENT.$30:
	PUSHAG	FCNUMERIC.BRENT.$T5
	PUSHAG	FCNUMERIC.BRENT.$K4
	CALLS	#2,G^FCNUMERIC.SCALED
	MOVG	R0,FCNUMERIC.BRENT.$T4
	PUSHAG	FCNUMERIC.BRENT.WIDTH
	PUSHAG	FCNUMERIC.BRENT.$K5
	CALLS	#2,G^FCNUMERIC.SCALED
	MOVG	R0,FCNUMERIC.BRENT.$T3
	PUSHAL	FCNUMERIC.BRENT.ERR
	PUSHAG	FCNUMERIC.BRENT.$T3
	PUSHAG	FCNUMERIC.BRENT.$T4
	CALLS	#3,G^FCVALUES.R_ADD
	MOVG	R0,FCNUMERIC.BRENT.TOL
;  487        xm = scaled(0.5_rk, r_add(c, -b, err))
	MNEGG	FCNUMERIC.BRENT.B,FCNUMERIC.BRENT.$T5
	PUSHAL	FCNUMERIC.BRENT.ERR
	PUSHAG	FCNUMERIC.BRENT.$T5
	PUSHAG	FCNUMERIC.BRENT.C
	CALLS	#3,G^FCVALUES.R_ADD
	MOVG	R0,FCNUMERIC.BRENT.$T3
	PUSHAG	FCNUMERIC.BRENT.$T3
	PUSHAG	FCNUMERIC.BRENT.$K5
	CALLS	#2,G^FCNUMERIC.SCALED
	MOVG	R0,FCNUMERIC.BRENT.XM
;  488        if (abs(xm) <= tol .or. fb == 0) then
	MOVG	FCNUMERIC.BRENT.XM,FCNUMERIC.BRENT.$T5
	BGEQ	FCNUMERIC.BRENT.$32
	MNEGG	FCNUMERIC.BRENT.$T5,FCNUMERIC.BRENT.$T5
FCNUMERIC.BRENT.$32:
	CMPG	FCNUMERIC.BRENT.$T5,FCNUMERIC.BRENT.TOL
	BLEQ	FCNUMERIC.BRENT.$35
	TSTG	FCNUMERIC.BRENT.FB
	BEQL	FCNUMERIC.BRENT.$37
	BRW	FCNUMERIC.BRENT.$34
FCNUMERIC.BRENT.$37:
FCNUMERIC.BRENT.$35:
	MOVL	R6,FCNUMERIC.BRENT.K
	MOVQ	R8,FCNUMERIC.BRENT.R
;  489          if (abs(b) <= width) b = 0
	MOVG	FCNUMERIC.BRENT.B,FCNUMERIC.BRENT.$T5
	BGEQ	FCNUMERIC.BRENT.$38
	MNEGG	FCNUMERIC.BRENT.$T5,FCNUMERIC.BRENT.$T5
FCNUMERIC.BRENT.$38:
	CMPG	FCNUMERIC.BRENT.$T5,FCNUMERIC.BRENT.WIDTH
	BGTR	FCNUMERIC.BRENT.$40
	CLRG	FCNUMERIC.BRENT.B
FCNUMERIC.BRENT.$40:
;  490          root = real_value(b)
	PUSHAG	FCNUMERIC.BRENT.B
	PUSHAB	FCNUMERIC.BRENT.$T1
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCNUMERIC.BRENT.$T1,@FCNUMERIC.BRENT.ROOT(AP)
;  491          found = err == 0
	CLRL	R0
	TSTL	FCNUMERIC.BRENT.ERR
	BNEQ	FCNUMERIC.BRENT.$42
	MNEGL	#1,R0
FCNUMERIC.BRENT.$42:
	MOVL	R0,R6
;  492          if (.not. found) call fail(e_noroot, start)
	BLBS	R6,FCNUMERIC.BRENT.$43
