	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  263
;  264    ! WARN_INACCURATE gives the warning INACCURATE with the estimate ERROR, to
;  265    ! two significant digits, at COLUMN.
;  266    subroutine warn_inaccurate(error, column)
	.ENTRY	FCNUMERIC.WARN_INACCURATE,^M<R6,R7,R8>
;  267      real(rk), intent(in) :: error
;  268      integer, intent(in) :: column
;  269      integer :: kept
;  270
;  271      kept = digits
	MOVL	FCNUMERIC.DIGITS,FCNUMERIC.WARN_INACCURATE.KEPT
;  272      digits = 2
	MOVL	#2,FCNUMERIC.DIGITS
;  273      call fail(w_inaccurate, column, trim(format_value(real_value(error))))
	PUSHAG	@FCNUMERIC.WARN_INACCURATE.ERROR(AP)
	PUSHAB	FCNUMERIC.WARN_INACCURATE.$T2
	CALLS	#2,G^FCVALUES.REAL_VALUE
	PUSHL	#0
	PUSHAB	FCNUMERIC.WARN_INACCURATE.$T2
	PUSHAQ	FCNUMERIC.WARN_INACCURATE.$D1
	CALLS	#3,G^FCVALUES.FORMAT_VALUE
	MOVAB	FCNUMERIC.WARN_INACCURATE.$T1,R8
	MOVAB	(R8),R7
	MOVL	#120,R6
	BRB	FCNUMERIC.WARN_INACCURATE.$1
FCNUMERIC.WARN_INACCURATE.$2:
	CMPB	-1(R7)[R6],#32
	BNEQ	FCNUMERIC.WARN_INACCURATE.$3
	DECL	R6
FCNUMERIC.WARN_INACCURATE.$1:
	TSTL	R6			; from line 273
	BNEQ	FCNUMERIC.WARN_INACCURATE.$2
FCNUMERIC.WARN_INACCURATE.$3:
	CVTLW	R6,FCNUMERIC.WARN_INACCURATE.$D2
	MOVAB	(R8),FCNUMERIC.WARN_INACCURATE.$D2+4
	PUSHAQ	FCNUMERIC.WARN_INACCURATE.$D2
	PUSHAL	@FCNUMERIC.WARN_INACCURATE.$N4(AP)
	PUSHAL	FCNUMERIC.WARN_INACCURATE.$K1
	CALLS	#3,G^FCMESSAGES.FAIL
;  274      digits = kept
	MOVL	FCNUMERIC.WARN_INACCURATE.KEPT,FCNUMERIC.DIGITS
;  275    end subroutine warn_inaccurate
	RET

; Storage map for FCNUMERIC.SCALED, a REAL*8 function
;   X       REAL*8, INTENT(IN)  argument 1  @FCNUMERIC.SCALED.X(AP)
;   Y       REAL*8, INTENT(IN)  argument 2  @FCNUMERIC.SCALED.Y(AP)
;   SCALED  REAL*8              $LOCAL+0    FCNUMERIC.SCALED.SCALED
;   ERR     INTEGER             $LOCAL+8    FCNUMERIC.SCALED.ERR
;
FCNUMERIC.SCALED.X = 4			; X is argument 1
FCNUMERIC.SCALED.Y = 8			; Y is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
FCNUMERIC.SCALED.SCALED:
	.BLKL	2			; SCALED, the function's value
FCNUMERIC.SCALED.ERR:
	.BLKL	1			; ERR

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  276
;  277    ! SCALED is X times Y, or 0 if that is smaller than SMALL: R_MUL, with
;  278    ! an overflow (which tolerances and steps never reach) ignored.
;  279    real(rk) function scaled(x, y)
	.ENTRY	FCNUMERIC.SCALED,^M<>
;  280      real(rk), intent(in) :: x, y
;  281      integer :: err
;  282
;  283      err = 0
	CLRL	FCNUMERIC.SCALED.ERR
;  284      scaled = r_mul(x, y, err)
	PUSHAL	FCNUMERIC.SCALED.ERR
	PUSHAG	@FCNUMERIC.SCALED.Y(AP)
	PUSHAG	@FCNUMERIC.SCALED.X(AP)
	CALLS	#3,G^FCVALUES.R_MUL
	MOVG	R0,FCNUMERIC.SCALED.SCALED
;  285    end function scaled
	MOVG	FCNUMERIC.SCALED.SCALED,R0 ; the function's value
	RET

; Storage map for FCNUMERIC.SOLVE_COMMAND, a subroutine
