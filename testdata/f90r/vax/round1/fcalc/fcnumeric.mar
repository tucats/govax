;  698      ! KRONROD sets PART(K), ERROR(K), and MAGNITUDE(K) from the rules on the
;  699      ! piece from LO(K) to HI(K); false if evaluating the expression failed.
;  700      ! The piece's center is C and its half width H: the rules' points are C
;  701      ! and C plus and minus H times each of NODES(1:7).
;  702      logical function kronrod(k) result(ok)
FCNUMERIC.INTEGRAL.KRONROD:
	.WORD	^M<R2,R3,R4,R5,R6>	; internal procedure KRONROD of FCNUMERIC.INTEGRAL
;  703        integer, intent(in) :: k
;  704        type(value) :: f, f1, f2, sum15, sum7
;  705        real(rk) :: c, h, size15
;  706        integer :: i, err
;  707
;  708        ok = .false.
;  709        err = 0
	CLRL	FCNUMERIC.INTEGRAL.KRONROD.ERR
;  710        c = scaled(0.5_rk, lo(k)) + scaled(0.5_rk, hi(k))
	MOVL	@FCNUMERIC.INTEGRAL.KRONROD.K(AP),R0
	PUSHAG	@FCNUMERIC.INTEGRAL.LO+16[R0]
	PUSHAG	FCNUMERIC.INTEGRAL.KRONROD.$K1
	CALLS	#2,G^FCNUMERIC.SCALED
	MOVG	R0,FCNUMERIC.INTEGRAL.KRONROD.$T1
	MOVL	@FCNUMERIC.INTEGRAL.KRONROD.K(AP),R0
	PUSHAG	@FCNUMERIC.INTEGRAL.HI+16[R0]
	PUSHAG	FCNUMERIC.INTEGRAL.KRONROD.$K1
	CALLS	#2,G^FCNUMERIC.SCALED
	MOVG	R0,FCNUMERIC.INTEGRAL.KRONROD.$T2
	ADDG3	FCNUMERIC.INTEGRAL.KRONROD.$T1,FCNUMERIC.INTEGRAL.KRONROD.$T2,FCNUMERIC.INTEGRAL.KRONROD.C
;  711        h = scaled(0.5_rk, hi(k)) - scaled(0.5_rk, lo(k))
	MOVL	@FCNUMERIC.INTEGRAL.KRONROD.K(AP),R0
	PUSHAG	@FCNUMERIC.INTEGRAL.HI+16[R0]
	PUSHAG	FCNUMERIC.INTEGRAL.KRONROD.$K1
	CALLS	#2,G^FCNUMERIC.SCALED
	MOVG	R0,FCNUMERIC.INTEGRAL.KRONROD.$T2
	MOVL	@FCNUMERIC.INTEGRAL.KRONROD.K(AP),R0
	PUSHAG	@FCNUMERIC.INTEGRAL.LO+16[R0]
	PUSHAG	FCNUMERIC.INTEGRAL.KRONROD.$K1
	CALLS	#2,G^FCNUMERIC.SCALED
	MOVG	R0,FCNUMERIC.INTEGRAL.KRONROD.$T1
	SUBG3	FCNUMERIC.INTEGRAL.KRONROD.$T1,FCNUMERIC.INTEGRAL.KRONROD.$T2,FCNUMERIC.INTEGRAL.KRONROD.H
;  712
;  713        f = value_at(tree, none, name, real_value(c), start)
	PUSHAG	FCNUMERIC.INTEGRAL.KRONROD.C
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T4
	CALLS	#2,G^FCVALUES.REAL_VALUE
	PUSHAL	@FCNUMERIC.INTEGRAL.$A5
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T4
	PUSHL	FCNUMERIC.INTEGRAL.$A2
	PUSHAL	FCNUMERIC.INTEGRAL.NONE
	PUSHAL	@FCNUMERIC.INTEGRAL.$A1
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T3
	CALLS	#6,G^FCNUMERIC.VALUE_AT
	MOVC3	#32,FCNUMERIC.INTEGRAL.KRONROD.$T3,FCNUMERIC.INTEGRAL.KRONROD.F
;  714        if (f%err /= 0) return
	TSTL	FCNUMERIC.INTEGRAL.KRONROD.F+16
	BEQL	FCNUMERIC.INTEGRAL.KRONROD.$1
	CLRL	R0			; the function's value
	RET
FCNUMERIC.INTEGRAL.KRONROD.$1:
;  715        sum15 = f * real_value(kronrod_weights(8))
	PUSHAG	FCNUMERIC.INTEGRAL.KRONROD.$K2
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T3
	CALLS	#2,G^FCVALUES.REAL_VALUE
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T3
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.F
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T4
	CALLS	#3,G^FCVALUES.V_MUL
	MOVC3	#32,FCNUMERIC.INTEGRAL.KRONROD.$T4,FCNUMERIC.INTEGRAL.KRONROD.$N22
;  716        sum7 = f * real_value(gauss_weights(4))
	PUSHAG	FCNUMERIC.INTEGRAL.KRONROD.$K3
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T4
	CALLS	#2,G^FCVALUES.REAL_VALUE
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T4
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.F
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T3
	CALLS	#3,G^FCVALUES.V_MUL
	MOVC3	#32,FCNUMERIC.INTEGRAL.KRONROD.$T3,FCNUMERIC.INTEGRAL.KRONROD.SUM7
;  717        size15 = c_abs(f%z) * kronrod_weights(8)
	PUSHAO	FCNUMERIC.INTEGRAL.KRONROD.F
	CALLS	#1,G^FCVALUES.C_ABS
	MOVG	R0,FCNUMERIC.INTEGRAL.KRONROD.$T1
	MULG3	FCNUMERIC.INTEGRAL.KRONROD.$T1,FCNUMERIC.INTEGRAL.KRONROD.$K2,FCNUMERIC.INTEGRAL.KRONROD.$N23
;  718        do i = 1, 7
	MOVL	#1,FCNUMERIC.INTEGRAL.KRONROD.I
	MOVL	FCNUMERIC.INTEGRAL.KRONROD.I,R6
FCNUMERIC.INTEGRAL.KRONROD.$3:		; DO (line 718)'s body
;  719          f1 = value_at(tree, none, name, real_value(r_add(c, -scaled(h, nodes(i)), err)), start)
	PUSHAG	FCNUMERIC.INTEGRAL.KRONROD.$K4-8[R6]
	PUSHAG	FCNUMERIC.INTEGRAL.KRONROD.H
	CALLS	#2,G^FCNUMERIC.SCALED
	MOVG	R0,FCNUMERIC.INTEGRAL.KRONROD.$T2
	MNEGG	FCNUMERIC.INTEGRAL.KRONROD.$T2,FCNUMERIC.INTEGRAL.KRONROD.$T5
	PUSHAL	FCNUMERIC.INTEGRAL.KRONROD.ERR
	PUSHAG	FCNUMERIC.INTEGRAL.KRONROD.$T5
	PUSHAG	FCNUMERIC.INTEGRAL.KRONROD.C
	CALLS	#3,G^FCVALUES.R_ADD
	MOVG	R0,FCNUMERIC.INTEGRAL.KRONROD.$T1
	PUSHAG	FCNUMERIC.INTEGRAL.KRONROD.$T1
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T3
	CALLS	#2,G^FCVALUES.REAL_VALUE
	PUSHAL	@FCNUMERIC.INTEGRAL.$A5
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T3
	PUSHL	FCNUMERIC.INTEGRAL.$A2
	PUSHAL	FCNUMERIC.INTEGRAL.NONE
	PUSHAL	@FCNUMERIC.INTEGRAL.$A1
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T4
	CALLS	#6,G^FCNUMERIC.VALUE_AT
	MOVC3	#32,FCNUMERIC.INTEGRAL.KRONROD.$T4,FCNUMERIC.INTEGRAL.KRONROD.F1
;  720          if (f1%err /= 0) return
	TSTL	FCNUMERIC.INTEGRAL.KRONROD.F1+16
	BEQL	FCNUMERIC.INTEGRAL.KRONROD.$4
	MOVL	R6,FCNUMERIC.INTEGRAL.KRONROD.I
	CLRL	R0			; the function's value
	RET
FCNUMERIC.INTEGRAL.KRONROD.$4:
;  721          f2 = value_at(tree, none, name, real_value(r_add(c, scaled(h, nodes(i)), err)), start)
	PUSHAG	FCNUMERIC.INTEGRAL.KRONROD.$K4-8[R6]
	PUSHAG	FCNUMERIC.INTEGRAL.KRONROD.H
	CALLS	#2,G^FCNUMERIC.SCALED
	MOVG	R0,FCNUMERIC.INTEGRAL.KRONROD.$T2
	PUSHAL	FCNUMERIC.INTEGRAL.KRONROD.ERR
	PUSHAG	FCNUMERIC.INTEGRAL.KRONROD.$T2
	PUSHAG	FCNUMERIC.INTEGRAL.KRONROD.C
	CALLS	#3,G^FCVALUES.R_ADD
	MOVG	R0,FCNUMERIC.INTEGRAL.KRONROD.$T5
	PUSHAG	FCNUMERIC.INTEGRAL.KRONROD.$T5
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T4
	CALLS	#2,G^FCVALUES.REAL_VALUE
	PUSHAL	@FCNUMERIC.INTEGRAL.$A5
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T4
	PUSHL	FCNUMERIC.INTEGRAL.$A2
	PUSHAL	FCNUMERIC.INTEGRAL.NONE
	PUSHAL	@FCNUMERIC.INTEGRAL.$A1
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T3
	CALLS	#6,G^FCNUMERIC.VALUE_AT
	MOVC3	#32,FCNUMERIC.INTEGRAL.KRONROD.$T3,FCNUMERIC.INTEGRAL.KRONROD.F2
;  722          if (f2%err /= 0) return
	TSTL	FCNUMERIC.INTEGRAL.KRONROD.F2+16
	BEQL	FCNUMERIC.INTEGRAL.KRONROD.$6
	MOVL	R6,FCNUMERIC.INTEGRAL.KRONROD.I
	CLRL	R0			; the function's value
	RET
FCNUMERIC.INTEGRAL.KRONROD.$6:
;  723          sum15 = sum15 + (f1 + f2) * real_value(kronrod_weights(i))
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.F2
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.F1
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T6
	CALLS	#3,G^FCVALUES.V_ADD
	PUSHAG	FCNUMERIC.INTEGRAL.KRONROD.$K5-8[R6]
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T7
	CALLS	#2,G^FCVALUES.REAL_VALUE
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T7
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T6
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T3
	CALLS	#3,G^FCVALUES.V_MUL
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T3
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$N22
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T4
	CALLS	#3,G^FCVALUES.V_ADD
	MOVC3	#32,FCNUMERIC.INTEGRAL.KRONROD.$T4,FCNUMERIC.INTEGRAL.KRONROD.$N22
;  724          size15 = size15 + (c_abs(f1%z) + c_abs(f2%z)) * kronrod_weights(i)
	PUSHAO	FCNUMERIC.INTEGRAL.KRONROD.F1
	CALLS	#1,G^FCVALUES.C_ABS
	MOVG	R0,FCNUMERIC.INTEGRAL.KRONROD.$T2
	PUSHAO	FCNUMERIC.INTEGRAL.KRONROD.F2
	CALLS	#1,G^FCVALUES.C_ABS
	MOVG	R0,FCNUMERIC.INTEGRAL.KRONROD.$T5
	ADDG3	FCNUMERIC.INTEGRAL.KRONROD.$T2,FCNUMERIC.INTEGRAL.KRONROD.$T5,R0
	MULG2	FCNUMERIC.INTEGRAL.KRONROD.$K5-8[R6],R0
	ADDG2	R0,FCNUMERIC.INTEGRAL.KRONROD.$N23
;  725          ! The Gauss points are the Kronrod rule's even ones.
;  726          if (mod(i, 2) == 0) sum7 = sum7 + (f1 + f2) * real_value(gauss_weights(i / 2))
	DIVL3	#2,R6,R0
	MULL2	#2,R0
	SUBL3	R0,R6,R0
	BNEQ	FCNUMERIC.INTEGRAL.KRONROD.$8
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.F2
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.F1
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T3
	CALLS	#3,G^FCVALUES.V_ADD
	DIVL3	#2,R6,R0
	PUSHAG	FCNUMERIC.INTEGRAL.KRONROD.$K6-8[R0]
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T4
	CALLS	#2,G^FCVALUES.REAL_VALUE
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T4
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T3
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T6
	CALLS	#3,G^FCVALUES.V_MUL
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T6
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.SUM7
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T7
	CALLS	#3,G^FCVALUES.V_ADD
	MOVC3	#32,FCNUMERIC.INTEGRAL.KRONROD.$T7,FCNUMERIC.INTEGRAL.KRONROD.SUM7
FCNUMERIC.INTEGRAL.KRONROD.$8:
;  727        end do
	ACBL	#7,#1,R6,FCNUMERIC.INTEGRAL.KRONROD.$3
	MOVL	R6,FCNUMERIC.INTEGRAL.KRONROD.I
;  728
;  729        part(k) = sum15 * real_value(h)
	PUSHAG	FCNUMERIC.INTEGRAL.KRONROD.H
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T3
	CALLS	#2,G^FCVALUES.REAL_VALUE
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T3
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$N22
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T4
	CALLS	#3,G^FCVALUES.V_MUL
	MULL3	@FCNUMERIC.INTEGRAL.KRONROD.K(AP),#32,R0
	MOVC3	#32,FCNUMERIC.INTEGRAL.KRONROD.$T4,@FCNUMERIC.INTEGRAL.PART+16[R0]
;  730        f = (sum15 - sum7) * real_value(h)
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.SUM7
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$N22
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T4
	CALLS	#3,G^FCVALUES.V_SUB
	PUSHAG	FCNUMERIC.INTEGRAL.KRONROD.H
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T6
	CALLS	#2,G^FCVALUES.REAL_VALUE
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T6
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T4
	PUSHAB	FCNUMERIC.INTEGRAL.KRONROD.$T3
	CALLS	#3,G^FCVALUES.V_MUL
	MOVC3	#32,FCNUMERIC.INTEGRAL.KRONROD.$T3,FCNUMERIC.INTEGRAL.KRONROD.F
;  731        if (part(k)%err /= 0 .or. f%err /= 0) then
	MULL3	@FCNUMERIC.INTEGRAL.KRONROD.K(AP),#8,R0
	ADDL2	#4,R0
	TSTL	@FCNUMERIC.INTEGRAL.PART+16[R0]
	BNEQ	FCNUMERIC.INTEGRAL.KRONROD.$12
	TSTL	FCNUMERIC.INTEGRAL.KRONROD.F+16
	BEQL	FCNUMERIC.INTEGRAL.KRONROD.$11
FCNUMERIC.INTEGRAL.KRONROD.$12:
;  732          call fail(e_overflow, start)
	PUSHL	#0
	PUSHAL	@FCNUMERIC.INTEGRAL.$A5
	PUSHAL	FCNUMERIC.INTEGRAL.KRONROD.$K7
	CALLS	#3,G^FCMESSAGES.FAIL
;  733          return
	CLRL	R0			; the function's value
	RET
FCNUMERIC.INTEGRAL.KRONROD.$11:
;  734        end if
;  735        magnitude(k) = r_mul(size15, abs(h), err)
	MOVG	FCNUMERIC.INTEGRAL.KRONROD.H,FCNUMERIC.INTEGRAL.KRONROD.$T5
	BGEQ	FCNUMERIC.INTEGRAL.KRONROD.$15
	MNEGG	FCNUMERIC.INTEGRAL.KRONROD.$T5,FCNUMERIC.INTEGRAL.KRONROD.$T5
FCNUMERIC.INTEGRAL.KRONROD.$15:
	PUSHAL	FCNUMERIC.INTEGRAL.KRONROD.ERR
	PUSHAG	FCNUMERIC.INTEGRAL.KRONROD.$T5
	PUSHAG	FCNUMERIC.INTEGRAL.KRONROD.$N23
	CALLS	#3,G^FCVALUES.R_MUL
	MOVL	@FCNUMERIC.INTEGRAL.KRONROD.K(AP),R2
	MOVG	R0,@FCNUMERIC.INTEGRAL.MAGNITUDE+16[R2]
;  736        error(k) = max(c_abs(f%z), scaled(50 * eps, magnitude(k)))
	PUSHAO	FCNUMERIC.INTEGRAL.KRONROD.F
	CALLS	#1,G^FCVALUES.C_ABS
	MOVG	R0,FCNUMERIC.INTEGRAL.KRONROD.$T2
	MOVG	FCNUMERIC.INTEGRAL.KRONROD.$T2,FCNUMERIC.INTEGRAL.KRONROD.$T5
	MOVL	@FCNUMERIC.INTEGRAL.KRONROD.K(AP),R0
	PUSHAG	@FCNUMERIC.INTEGRAL.MAGNITUDE+16[R0]
	PUSHAG	FCNUMERIC.INTEGRAL.KRONROD.$K8
	CALLS	#2,G^FCNUMERIC.SCALED
	MOVG	R0,FCNUMERIC.INTEGRAL.KRONROD.$T1
	CMPG	FCNUMERIC.INTEGRAL.KRONROD.$T1,FCNUMERIC.INTEGRAL.KRONROD.$T5
	BLEQ	FCNUMERIC.INTEGRAL.KRONROD.$17
	MOVG	FCNUMERIC.INTEGRAL.KRONROD.$T1,FCNUMERIC.INTEGRAL.KRONROD.$T5
FCNUMERIC.INTEGRAL.KRONROD.$17:
	MOVL	@FCNUMERIC.INTEGRAL.KRONROD.K(AP),R0
	MOVG	FCNUMERIC.INTEGRAL.KRONROD.$T5,@FCNUMERIC.INTEGRAL.ERROR+16[R0]
;  737        ok = err == 0
	CLRL	R0
	TSTL	FCNUMERIC.INTEGRAL.KRONROD.ERR
	BNEQ	FCNUMERIC.INTEGRAL.KRONROD.$19
	MNEGL	#1,R0
FCNUMERIC.INTEGRAL.KRONROD.$19:
	MOVL	R0,R6
;  738        if (.not. ok) call fail(e_overflow, start)
	BLBS	R6,FCNUMERIC.INTEGRAL.KRONROD.$20
	PUSHL	#0
	PUSHAL	@FCNUMERIC.INTEGRAL.$A5
	PUSHAL	FCNUMERIC.INTEGRAL.KRONROD.$K7
	CALLS	#3,G^FCMESSAGES.FAIL
FCNUMERIC.INTEGRAL.KRONROD.$20:
;  739      end function kronrod
	MOVL	R6,R0			; the function's value
	RET

; Storage map for FCNUMERIC.DIFF_COMMAND, a subroutine
;   TREE    TYPE(NODE), POINTER  $LOCAL+0    FCNUMERIC.DIFF_COMMAND.TREE
;   NAME    CHARACTER*31         $LOCAL+4    FCNUMERIC.DIFF_COMMAND.NAME
