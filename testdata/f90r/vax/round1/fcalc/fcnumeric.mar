	CALLS	#3,G^FCNUMERIC.READ_BOUND
	MOVL	R0,R6
	BLBC	R6,FCNUMERIC.INTEGRATE_COMMAND.$1
;  587        if (.not. read_word('to', 'TO')) exit read
	PUSHAQ	FCNUMERIC.INTEGRATE_COMMAND.$D7
	PUSHAQ	FCNUMERIC.INTEGRATE_COMMAND.$D6
	CALLS	#2,G^FCNUMERIC.READ_WORD
	MOVL	R0,R6
	BLBC	R6,FCNUMERIC.INTEGRATE_COMMAND.$1
