	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  249
;  250    ! WITHOUT_NOISE is V with each part no larger than LEVEL set to 0.
;  251    function without_noise(v, level) result(w)
	.ENTRY	FCNUMERIC.WITHOUT_NOISE,^M<R2,R3,R4,R5,R6,R7>
;  252      type(value), intent(in) :: v
;  253      real(rk), intent(in) :: level
;  254      type(value) :: w
;  255      real(rk) :: x, y
;  256
;  257      x = real(v%z, rk)
	MOVG	@FCNUMERIC.WITHOUT_NOISE.V(AP),FCNUMERIC.WITHOUT_NOISE.X
;  258      y = aimag(v%z)
	MOVL	FCNUMERIC.WITHOUT_NOISE.V(AP),R0
	MOVG	8(R0),FCNUMERIC.WITHOUT_NOISE.Y
;  259      if (abs(x) <= level) x = 0
	MOVG	FCNUMERIC.WITHOUT_NOISE.X,R6
	BGEQ	FCNUMERIC.WITHOUT_NOISE.$1
	MNEGG	R6,R6
FCNUMERIC.WITHOUT_NOISE.$1:
	CMPG	R6,@FCNUMERIC.WITHOUT_NOISE.LEVEL(AP)
	BGTR	FCNUMERIC.WITHOUT_NOISE.$3
	CLRG	FCNUMERIC.WITHOUT_NOISE.X
FCNUMERIC.WITHOUT_NOISE.$3:
;  260      if (abs(y) <= level) y = 0
	MOVG	FCNUMERIC.WITHOUT_NOISE.Y,R6
	BGEQ	FCNUMERIC.WITHOUT_NOISE.$5
	MNEGG	R6,R6
FCNUMERIC.WITHOUT_NOISE.$5:
	CMPG	R6,@FCNUMERIC.WITHOUT_NOISE.LEVEL(AP)
	BGTR	FCNUMERIC.WITHOUT_NOISE.$7
	CLRG	FCNUMERIC.WITHOUT_NOISE.Y
FCNUMERIC.WITHOUT_NOISE.$7:
;  261      w = complex_value(x, y)
	PUSHAG	FCNUMERIC.WITHOUT_NOISE.Y
	PUSHAG	FCNUMERIC.WITHOUT_NOISE.X
	PUSHAB	FCNUMERIC.WITHOUT_NOISE.$T2
	CALLS	#3,G^FCVALUES.COMPLEX_VALUE
	MOVC3	#32,FCNUMERIC.WITHOUT_NOISE.$T2,@FCNUMERIC.WITHOUT_NOISE.W(AP)
;  262    end function without_noise
	RET

