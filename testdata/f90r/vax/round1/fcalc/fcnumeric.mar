FCNUMERIC.BRENT.$84:
;  540      end do
	ACBL	#200,#1,R6,FCNUMERIC.BRENT.$19
	MOVL	R6,FCNUMERIC.BRENT.K
	MOVQ	R8,FCNUMERIC.BRENT.R
FCNUMERIC.BRENT.$87:
