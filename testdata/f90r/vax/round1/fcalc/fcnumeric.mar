;   DONE    LOGICAL              $LOCAL+120  FCNUMERIC.DIFF_COMMAND.DONE
;   R6 is $T1: temporary
;

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
