	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  286
;  287    ! ------------------------------------------------------------------
;  288    ! SOLVE.
;  289
;  290    subroutine solve_command()
	.ENTRY	FCNUMERIC.SOLVE_COMMAND,^M<R2,R3,R4,R5,R6>
;  291      type(node), pointer :: left, right
;  292      character(len=name_length) :: name
;  293      type(value) :: a, b, root
;  294      integer :: start, from_column, column
;  295      logical :: bracket, found
;  296
;  297      nullify (left, right)
	CLRL	FCNUMERIC.SOLVE_COMMAND.LEFT
	CLRL	FCNUMERIC.SOLVE_COMMAND.RIGHT
;  298      bracket = .false.
	CLRL	FCNUMERIC.SOLVE_COMMAND.BRACKET
;  299      found = .false.
	CLRL	FCNUMERIC.SOLVE_COMMAND.FOUND
;  300      a = real_value(0.0_rk)
	PUSHAG	FCNUMERIC.SOLVE_COMMAND.$K1
	PUSHAB	FCNUMERIC.SOLVE_COMMAND.$T1
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCNUMERIC.SOLVE_COMMAND.$T1,FCNUMERIC.SOLVE_COMMAND.A
;  301      b = a
	MOVC3	#32,FCNUMERIC.SOLVE_COMMAND.A,FCNUMERIC.SOLVE_COMMAND.B
;  302      call advance(1)
	PUSHAL	FCNUMERIC.SOLVE_COMMAND.$K2
	CALLS	#1,G^FCTREE.ADVANCE
;  303      start = current_column()
	CALLS	#0,G^FCTREE.CURRENT_COLUMN
	MOVL	R0,FCNUMERIC.SOLVE_COMMAND.START
;  304
;  305      ! The command, read: a block left by EXIT at the first error.
;  306      read: do
;  307        left => parse_expression()
	CALLS	#0,G^FCTREE.PARSE_EXPRESSION
	MOVL	R0,R6
	MOVL	R6,FCNUMERIC.SOLVE_COMMAND.LEFT
;  308        if (failed()) exit read
	CALLS	#0,G^FCMESSAGES.FAILED
	MOVL	R0,R6
	BLBC	R6,FCNUMERIC.SOLVE_COMMAND.$2
	BRW	FCNUMERIC.SOLVE_COMMAND.$1
FCNUMERIC.SOLVE_COMMAND.$2:
;  309        if (is_operator('=')) then
	PUSHAQ	FCNUMERIC.SOLVE_COMMAND.$D1
	CALLS	#1,G^FCTREE.IS_OPERATOR
	MOVL	R0,R6
	BLBC	R6,FCNUMERIC.SOLVE_COMMAND.$3
;  310          call advance(1)
	PUSHAL	FCNUMERIC.SOLVE_COMMAND.$K2
	CALLS	#1,G^FCTREE.ADVANCE
;  311          right => parse_expression()
	CALLS	#0,G^FCTREE.PARSE_EXPRESSION
	MOVL	R0,R6
	MOVL	R6,FCNUMERIC.SOLVE_COMMAND.RIGHT
;  312          if (failed()) exit read
	CALLS	#0,G^FCMESSAGES.FAILED
	MOVL	R0,R6
	BLBC	R6,FCNUMERIC.SOLVE_COMMAND.$5
	BRW	FCNUMERIC.SOLVE_COMMAND.$1
FCNUMERIC.SOLVE_COMMAND.$5:
;  313        end if
FCNUMERIC.SOLVE_COMMAND.$3:
;  314        if (.not. read_word('for', 'FOR')) exit read
	PUSHAQ	FCNUMERIC.SOLVE_COMMAND.$D3
	PUSHAQ	FCNUMERIC.SOLVE_COMMAND.$D2
	CALLS	#2,G^FCNUMERIC.READ_WORD
	MOVL	R0,R6
	BLBS	R6,FCNUMERIC.SOLVE_COMMAND.$6
	BRW	FCNUMERIC.SOLVE_COMMAND.$1
FCNUMERIC.SOLVE_COMMAND.$6:
;  315        if (.not. read_name(name)) exit read
	PUSHAQ	FCNUMERIC.SOLVE_COMMAND.$D4
	CALLS	#1,G^FCNUMERIC.READ_NAME
	MOVL	R0,R6
	BLBS	R6,FCNUMERIC.SOLVE_COMMAND.$7
	BRW	FCNUMERIC.SOLVE_COMMAND.$1
FCNUMERIC.SOLVE_COMMAND.$7:
;  316        from_column = current_column()
	CALLS	#0,G^FCTREE.CURRENT_COLUMN
	MOVL	R0,FCNUMERIC.SOLVE_COMMAND.$N5
;  317        if (at_word('from')) then
	PUSHAQ	FCNUMERIC.SOLVE_COMMAND.$D5
	CALLS	#1,G^FCNUMERIC.AT_WORD
	MOVL	R0,R6
	BLBS	R6,FCNUMERIC.SOLVE_COMMAND.$9
	BRW	FCNUMERIC.SOLVE_COMMAND.$8
FCNUMERIC.SOLVE_COMMAND.$9:
;  318          call advance(1)
	PUSHAL	FCNUMERIC.SOLVE_COMMAND.$K2
	CALLS	#1,G^FCTREE.ADVANCE
;  319          if (.not. read_bound(a, .false., column)) exit read
	PUSHAL	FCNUMERIC.SOLVE_COMMAND.COLUMN
	PUSHAL	FCNUMERIC.SOLVE_COMMAND.$K7
	PUSHAB	FCNUMERIC.SOLVE_COMMAND.A
	CALLS	#3,G^FCNUMERIC.READ_BOUND
	MOVL	R0,R6
	BLBS	R6,FCNUMERIC.SOLVE_COMMAND.$10
	BRW	FCNUMERIC.SOLVE_COMMAND.$1
FCNUMERIC.SOLVE_COMMAND.$10:
;  320          if (at_word('to')) then
	PUSHAQ	FCNUMERIC.SOLVE_COMMAND.$D6
	CALLS	#1,G^FCNUMERIC.AT_WORD
	MOVL	R0,R6
	BLBC	R6,FCNUMERIC.SOLVE_COMMAND.$11
;  321            call advance(1)
	PUSHAL	FCNUMERIC.SOLVE_COMMAND.$K2
	CALLS	#1,G^FCTREE.ADVANCE
;  322            bracket = .true.
	MOVL	#-1,FCNUMERIC.SOLVE_COMMAND.BRACKET
;  323            if (.not. is_real(a)) then
	PUSHAB	FCNUMERIC.SOLVE_COMMAND.A
	CALLS	#1,G^FCVALUES.IS_REAL
	MOVL	R0,R6
	BLBS	R6,FCNUMERIC.SOLVE_COMMAND.$13
;  324              call fail(e_notreal, column)
	PUSHL	#0
	PUSHAL	FCNUMERIC.SOLVE_COMMAND.COLUMN
	PUSHAL	FCNUMERIC.SOLVE_COMMAND.$K9
	CALLS	#3,G^FCMESSAGES.FAIL
;  325              exit read
	BRW	FCNUMERIC.SOLVE_COMMAND.$1
FCNUMERIC.SOLVE_COMMAND.$13:
;  326            end if
;  327            if (.not. read_bound(b, .true., column)) exit read
	PUSHAL	FCNUMERIC.SOLVE_COMMAND.COLUMN
	PUSHAL	FCNUMERIC.SOLVE_COMMAND.$K10
	PUSHAB	FCNUMERIC.SOLVE_COMMAND.B
	CALLS	#3,G^FCNUMERIC.READ_BOUND
	MOVL	R0,R6
	BLBS	R6,FCNUMERIC.SOLVE_COMMAND.$15
	BRW	FCNUMERIC.SOLVE_COMMAND.$1
FCNUMERIC.SOLVE_COMMAND.$15:
;  328          end if
FCNUMERIC.SOLVE_COMMAND.$11:
;  329        end if
FCNUMERIC.SOLVE_COMMAND.$8:
;  330        if (.not. at_end_of_line()) exit read
	CALLS	#0,G^FCNUMERIC.AT_END_OF_LINE
	MOVL	R0,R6
	BLBS	R6,FCNUMERIC.SOLVE_COMMAND.$16
	BRW	FCNUMERIC.SOLVE_COMMAND.$1
FCNUMERIC.SOLVE_COMMAND.$16:
;  331
;  332        if (bracket) then
	BLBC	FCNUMERIC.SOLVE_COMMAND.BRACKET,FCNUMERIC.SOLVE_COMMAND.$17
;  333          found = brent(left, right, name, real(a%z, rk), real(b%z, rk), start, from_column, root)
	MOVG	FCNUMERIC.SOLVE_COMMAND.A,FCNUMERIC.SOLVE_COMMAND.$T3
	MOVG	FCNUMERIC.SOLVE_COMMAND.B,FCNUMERIC.SOLVE_COMMAND.$T4
	PUSHAB	FCNUMERIC.SOLVE_COMMAND.ROOT
	PUSHAL	FCNUMERIC.SOLVE_COMMAND.$N5
	PUSHAL	FCNUMERIC.SOLVE_COMMAND.START
	PUSHAG	FCNUMERIC.SOLVE_COMMAND.$T4
	PUSHAG	FCNUMERIC.SOLVE_COMMAND.$T3
	PUSHAQ	FCNUMERIC.SOLVE_COMMAND.$D4
	PUSHAL	FCNUMERIC.SOLVE_COMMAND.RIGHT
	PUSHAL	FCNUMERIC.SOLVE_COMMAND.LEFT
	CALLS	#8,G^FCNUMERIC.BRENT
	MOVL	R0,FCNUMERIC.SOLVE_COMMAND.FOUND
;  334        else
	BRB	FCNUMERIC.SOLVE_COMMAND.$19
FCNUMERIC.SOLVE_COMMAND.$17:
;  335          found = secant(left, right, name, a, start, root)
	PUSHAB	FCNUMERIC.SOLVE_COMMAND.ROOT
	PUSHAL	FCNUMERIC.SOLVE_COMMAND.START
	PUSHAB	FCNUMERIC.SOLVE_COMMAND.A
	PUSHAQ	FCNUMERIC.SOLVE_COMMAND.$D4
	PUSHAL	FCNUMERIC.SOLVE_COMMAND.RIGHT
	PUSHAL	FCNUMERIC.SOLVE_COMMAND.LEFT
	CALLS	#6,G^FCNUMERIC.SECANT
	MOVL	R0,FCNUMERIC.SOLVE_COMMAND.FOUND
;  336        end if
FCNUMERIC.SOLVE_COMMAND.$19:
;  337        exit read
FCNUMERIC.SOLVE_COMMAND.$1:
;  338      end do read
;  339
;  340      call free_tree(left)
	PUSHAL	FCNUMERIC.SOLVE_COMMAND.LEFT
	CALLS	#1,G^FCTREE.FREE_TREE
;  341      call free_tree(right)
	PUSHAL	FCNUMERIC.SOLVE_COMMAND.RIGHT
	CALLS	#1,G^FCTREE.FREE_TREE
;  342      if (found) call show_answer(root, name)
	BLBC	FCNUMERIC.SOLVE_COMMAND.FOUND,FCNUMERIC.SOLVE_COMMAND.$20
	PUSHAQ	FCNUMERIC.SOLVE_COMMAND.$D4
	PUSHAB	FCNUMERIC.SOLVE_COMMAND.ROOT
	CALLS	#2,G^FCNUMERIC.SHOW_ANSWER
FCNUMERIC.SOLVE_COMMAND.$20:
;  343    end subroutine solve_command
	RET

; Storage map for FCNUMERIC.SECANT, a LOGICAL function
;   LEFT   TYPE(NODE), POINTER        argument 1  @FCNUMERIC.SECANT.LEFT(AP)
;   RIGHT  TYPE(NODE), POINTER        argument 2  @FCNUMERIC.SECANT.RIGHT(AP)
;   NAME   CHARACTER*(*), INTENT(IN)  argument 3  @FCNUMERIC.SECANT.NAME(AP)
;   A      TYPE(VALUE), INTENT(IN)    argument 4  @FCNUMERIC.SECANT.A(AP)
;   START  INTEGER, INTENT(IN)        argument 5  @FCNUMERIC.SECANT.START(AP)
;   ROOT   TYPE(VALUE), INTENT(OUT)   argument 6  @FCNUMERIC.SECANT.ROOT(AP)
;   FOUND  LOGICAL                    $LOCAL+0    FCNUMERIC.SECANT.FOUND
;   X0     TYPE(VALUE)                $LOCAL+16   FCNUMERIC.SECANT.X0
;   X1     TYPE(VALUE)                $LOCAL+48   FCNUMERIC.SECANT.X1
;   F0     TYPE(VALUE)                $LOCAL+80   FCNUMERIC.SECANT.F0
;   F1     TYPE(VALUE)                $LOCAL+112  FCNUMERIC.SECANT.F1
;   STEP   TYPE(VALUE)                $LOCAL+144  FCNUMERIC.SECANT.STEP
;   K      INTEGER                    $LOCAL+176  FCNUMERIC.SECANT.K
;   R7 is $T5: temporary
;   R6 is $R1: K, during a loop
;   R9 is $R2: LEFT's address
;   R10 is $R3: RIGHT's address
;   R11 is $R4: START's address
;
FCNUMERIC.SECANT.LEFT = 4		; LEFT is argument 1
FCNUMERIC.SECANT.RIGHT = 8		; RIGHT is argument 2
FCNUMERIC.SECANT.NAME = 12		; NAME is argument 3
FCNUMERIC.SECANT.A = 16			; A is argument 4
FCNUMERIC.SECANT.START = 20		; START is argument 5
FCNUMERIC.SECANT.ROOT = 24		; ROOT is argument 6

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
	.ALIGN	4			; the boundary of this routine's aligned records
FCNUMERIC.SECANT.FOUND:
	.BLKL	1			; FOUND, the function's value
	.BLKB	12
FCNUMERIC.SECANT.X0:
	.BLKL	8			; X0
FCNUMERIC.SECANT.X1:
	.BLKL	8			; X1
FCNUMERIC.SECANT.F0:
	.BLKL	8			; F0
FCNUMERIC.SECANT.F1:
	.BLKL	8			; F1
FCNUMERIC.SECANT.STEP:
	.BLKL	8			; STEP
FCNUMERIC.SECANT.K:
	.BLKL	1			; K
FCNUMERIC.SECANT.$T1:
	.BLKL	8			; characters, for one statement
FCNUMERIC.SECANT.$T2:
	.BLKL	8			; characters, for one statement
FCNUMERIC.SECANT.$T3:
	.BLKL	2			; temporary
FCNUMERIC.SECANT.$T4:
	.BLKL	2			; temporary
FCNUMERIC.SECANT.$T6:
	.BLKL	8			; characters, for one statement
FCNUMERIC.SECANT.$T7:
	.BLKL	8			; characters, for one statement

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCNUMERIC.SECANT.$K1:
	.LONG	^X624D3F70,^XA9FCD2F1	; 0.001D0
FCNUMERIC.SECANT.$K2:
	.LONG	^X00003CF0,^X00000000	; 8.881784197001252D-16
FCNUMERIC.SECANT.$K3:
	.LONG	38
FCNUMERIC.SECANT.$KF1:
	.LONG	^X00004010,^X00000000	; 1D0

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  344
;  345    ! SECANT: ROOT is a root of the expression found by the secant method
;  346    ! from A, false if none was. Each step draws the line through the last
;  347    ! two points, (x0, f0) and (x1, f1), and takes where it crosses zero as
;  348    ! the next point:
;  349    !
;  350    !     x2 = x1 - f1 (x1 - x0) / (f1 - f0)
;  351    !
;  352    ! Near a simple root each step about squares the error (strictly, raises
;  353    ! it to the power 1.618, the golden ratio), so a dozen steps reach the
;  354    ! machine's precision. In complex arithmetic the same step finds complex
;  355    ! roots, from a complex start; from a real start, a real expression stays
;  356    ! on the real line.
;  357    logical function secant(left, right, name, a, start, root) result(found)
	.ENTRY	FCNUMERIC.SECANT,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
;  358      type(node), pointer :: left, right
;  359      character(len=*), intent(in) :: name
;  360      type(value), intent(in) :: a
;  361      integer, intent(in) :: start
;  362      type(value), intent(out) :: root
;  363      type(value) :: x0, x1, f0, f1, step
;  364      integer :: k
;  365
;  366      found = .false.
;  367      root = a
	MOVC3	#32,@FCNUMERIC.SECANT.A(AP),@FCNUMERIC.SECANT.ROOT(AP)
;  368
;  369      ! The second point is a little way from the first.
;  370      x0 = a
	MOVC3	#32,@FCNUMERIC.SECANT.A(AP),FCNUMERIC.SECANT.X0
;  371      x1 = a + real_value(scaled(1.0e-3_rk, max(c_abs(a%z), 1.0_rk)))
	PUSHAO	@FCNUMERIC.SECANT.A(AP)
	CALLS	#1,G^FCVALUES.C_ABS
	MOVG	R0,R7
	MOVG	R7,FCNUMERIC.SECANT.$T4
	CMPG	FCNUMERIC.SECANT.$KF1,FCNUMERIC.SECANT.$T4
	BLEQ	FCNUMERIC.SECANT.$1
	MOVG	FCNUMERIC.SECANT.$KF1,FCNUMERIC.SECANT.$T4 ; 1D0
FCNUMERIC.SECANT.$1:
	PUSHAG	FCNUMERIC.SECANT.$T4
	PUSHAG	FCNUMERIC.SECANT.$K1
	CALLS	#2,G^FCNUMERIC.SCALED
	MOVG	R0,FCNUMERIC.SECANT.$T3
	PUSHAG	FCNUMERIC.SECANT.$T3
	PUSHAB	FCNUMERIC.SECANT.$T2
	CALLS	#2,G^FCVALUES.REAL_VALUE
	PUSHAB	FCNUMERIC.SECANT.$T2
	PUSHAB	@FCNUMERIC.SECANT.A(AP)
	PUSHAB	FCNUMERIC.SECANT.$T1
	CALLS	#3,G^FCVALUES.V_ADD
	MOVC3	#32,FCNUMERIC.SECANT.$T1,FCNUMERIC.SECANT.X1
;  372      f0 = value_at(left, right, name, x0, start)
	PUSHAL	@FCNUMERIC.SECANT.START(AP)
	PUSHAB	FCNUMERIC.SECANT.X0
	PUSHL	FCNUMERIC.SECANT.NAME(AP)
	PUSHAL	@FCNUMERIC.SECANT.RIGHT(AP)
	PUSHAL	@FCNUMERIC.SECANT.LEFT(AP)
	PUSHAB	FCNUMERIC.SECANT.$T2
	CALLS	#6,G^FCNUMERIC.VALUE_AT
	MOVC3	#32,FCNUMERIC.SECANT.$T2,FCNUMERIC.SECANT.F0
;  373      if (f0%err /= 0) return
	TSTL	FCNUMERIC.SECANT.F0+16
	BEQL	FCNUMERIC.SECANT.$3
	CLRL	R0			; the function's value
	RET
FCNUMERIC.SECANT.$3:
;  374      if (f0%z == (0.0_rk, 0.0_rk)) then
	TSTG	FCNUMERIC.SECANT.F0
	BNEQ	FCNUMERIC.SECANT.$5
	TSTG	FCNUMERIC.SECANT.F0+8
	BNEQ	FCNUMERIC.SECANT.$5
;  375        found = .true.
;  376        return
	MOVL	#-1,R0			; the function's value
	RET
FCNUMERIC.SECANT.$5:
;  377      end if
;  378      f1 = value_at(left, right, name, x1, start)
	PUSHAL	@FCNUMERIC.SECANT.START(AP)
