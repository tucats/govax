	TSTL	16(R0)
	BEQL	FCNUMERIC.DERIVATIVE.DIFFE.$N38
;  846          call fail(d%err, start)
	PUSHL	#0
	PUSHAL	@FCNUMERIC.DERIVATIVE.$A4
	MOVL	FCNUMERIC.DERIVATIVE.DIFFE.$N37(AP),R0
