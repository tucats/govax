	.ADDRESS FCNUMERIC.DIFF_COMMAND.NAME
FCNUMERIC.DIFF_COMMAND.$D4:
	.WORD	2			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCNUMERIC.DIFF_COMMAND.$K4
FCNUMERIC.DIFF_COMMAND.$D5:
