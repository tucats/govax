	PUSHAB	FCNUMERIC.DERIVATIVE.DIFFE.$N27
	PUSHAB	FCNUMERIC.DERIVATIVE.DIFFE.$N25
	CALLS	#3,G^FCVALUES.V_DIV
	MOVC3	#32,FCNUMERIC.DERIVATIVE.DIFFE.$N25,@FCNUMERIC.DERIVATIVE.DIFFE.$N37(AP)
;  845        if (d%err /= 0) then
