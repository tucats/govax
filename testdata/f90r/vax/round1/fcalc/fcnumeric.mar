	.BLKL	1			; BRACKET
FCNUMERIC.SOLVE_COMMAND.FOUND:
	.BLKL	1			; FOUND
FCNUMERIC.SOLVE_COMMAND.$T1:
	.BLKL	8			; characters, for one statement
FCNUMERIC.SOLVE_COMMAND.$T3:
	.BLKL	2			; temporary
FCNUMERIC.SOLVE_COMMAND.$T4:
	.BLKL	2			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
FCNUMERIC.SOLVE_COMMAND.$K1:
	.LONG	^X00000000,^X00000000	; 0D0
FCNUMERIC.SOLVE_COMMAND.$K2:
	.LONG	1
FCNUMERIC.SOLVE_COMMAND.$D1:
	.WORD	1			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCNUMERIC.SOLVE_COMMAND.$K3
FCNUMERIC.SOLVE_COMMAND.$D2:
	.WORD	3			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCNUMERIC.SOLVE_COMMAND.$K4
FCNUMERIC.SOLVE_COMMAND.$D3:
	.WORD	3			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCNUMERIC.SOLVE_COMMAND.$K5
FCNUMERIC.SOLVE_COMMAND.$D4:
	.WORD	31			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS FCNUMERIC.SOLVE_COMMAND.NAME
FCNUMERIC.SOLVE_COMMAND.$D5:
