; Storage map for FCNUMERIC.VALUE_AT, a TYPE(VALUE) function
;   V       TYPE(VALUE)                hidden argument 1  @FCNUMERIC.VALUE_AT.V(AP)
;   P       TYPE(NODE), POINTER        argument 2         @FCNUMERIC.VALUE_AT.P(AP)
;   Q       TYPE(NODE), POINTER        argument 3         @FCNUMERIC.VALUE_AT.Q(AP)
;   NAME    CHARACTER*(*), INTENT(IN)  argument 4         @FCNUMERIC.VALUE_AT.NAME(AP)
;   X       TYPE(VALUE), INTENT(IN)    argument 5         @FCNUMERIC.VALUE_AT.X(AP)
;   COLUMN  INTEGER, INTENT(IN)        an argument        @FCNUMERIC.VALUE_AT.$A6
;   A       TYPE(QUANTITY)             $LOCAL+0           FCNUMERIC.VALUE_AT.A
;   B       TYPE(QUANTITY)             $LOCAL+96          FCNUMERIC.VALUE_AT.B
;   R6 is $T2: temporary
;
FCNUMERIC.VALUE_AT.V = 4		; V's value goes through hidden argument 1
FCNUMERIC.VALUE_AT.P = 8		; P is argument 2
FCNUMERIC.VALUE_AT.Q = 12		; Q is argument 3
FCNUMERIC.VALUE_AT.NAME = 16		; NAME is argument 4
FCNUMERIC.VALUE_AT.X = 20		; X is argument 5

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,4
	.ALIGN	4			; the boundary of this routine's aligned records
FCNUMERIC.VALUE_AT.A:
	.BLKL	24			; A
FCNUMERIC.VALUE_AT.B:
	.BLKL	24			; B
FCNUMERIC.VALUE_AT.$A6:
	.BLKL	1			; COLUMN's longword of the argument list, set at each entry point
FCNUMERIC.VALUE_AT.$T1:
	.BLKL	24			; characters, for one statement
FCNUMERIC.VALUE_AT.$T3:
	.BLKL	8			; characters, for one statement

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  188
;  189    ! ------------------------------------------------------------------
;  190    ! Evaluating the expression.
;  191
;  192    ! VALUE_AT is the scalar value of the tree P with NAME standing for X,
;  193    ! and of P less Q if Q is associated (SOLVE's two sides); its error is
;  194    ! set if evaluating either failed (when FAIL has recorded where), or if
;  195    ! the value is an array (NOTSCALAR, recorded here at COLUMN, the
;  196    ! expression's start).
;  197    function value_at(p, q, name, x, column) result(v)
	.ENTRY	FCNUMERIC.VALUE_AT,^M<R2,R3,R4,R5,R6>
	MOVL	24(AP),FCNUMERIC.VALUE_AT.$A6 ; COLUMN is argument 6
;  198      type(node), pointer :: p, q
;  199      character(len=*), intent(in) :: name
;  200      type(value), intent(in) :: x
;  201      integer, intent(in) :: column
;  202      type(value) :: v
;  203      type(quantity) :: a, b
;  204
;  205      a = evaluate_with(p, name, x)
	PUSHAB	@FCNUMERIC.VALUE_AT.X(AP)
	PUSHL	FCNUMERIC.VALUE_AT.NAME(AP)
	PUSHAL	@FCNUMERIC.VALUE_AT.P(AP)
	PUSHAB	FCNUMERIC.VALUE_AT.$T1
	CALLS	#4,G^FCEVAL.EVALUATE_WITH
	MOVC3	#96,FCNUMERIC.VALUE_AT.$T1,FCNUMERIC.VALUE_AT.A
;  206      if (.not. scalar_of(a, v)) return
	PUSHAB	@FCNUMERIC.VALUE_AT.V(AP)
	PUSHAB	FCNUMERIC.VALUE_AT.A
	CALLS	#2,FCNUMERIC.VALUE_AT.SCALAR_OF
	MOVL	R0,R6
	BLBS	R6,FCNUMERIC.VALUE_AT.$1
	RET
FCNUMERIC.VALUE_AT.$1:
;  207      if (associated(q)) then
	TSTL	@FCNUMERIC.VALUE_AT.Q(AP)
	BNEQ	FCNUMERIC.VALUE_AT.$4
	RET
FCNUMERIC.VALUE_AT.$4:
;  208        b = evaluate_with(q, name, x)
	PUSHAB	@FCNUMERIC.VALUE_AT.X(AP)
	PUSHL	FCNUMERIC.VALUE_AT.NAME(AP)
	PUSHAL	@FCNUMERIC.VALUE_AT.Q(AP)
	PUSHAB	FCNUMERIC.VALUE_AT.$T1
	CALLS	#4,G^FCEVAL.EVALUATE_WITH
	MOVC3	#96,FCNUMERIC.VALUE_AT.$T1,FCNUMERIC.VALUE_AT.B
;  209        if (.not. scalar_of(b, v)) return
	PUSHAB	@FCNUMERIC.VALUE_AT.V(AP)
	PUSHAB	FCNUMERIC.VALUE_AT.B
	CALLS	#2,FCNUMERIC.VALUE_AT.SCALAR_OF
	MOVL	R0,R6
	BLBS	R6,FCNUMERIC.VALUE_AT.$5
	RET
FCNUMERIC.VALUE_AT.$5:
;  210        v = a%s - b%s
	PUSHAB	FCNUMERIC.VALUE_AT.B+16
	PUSHAB	FCNUMERIC.VALUE_AT.A+16
	PUSHAB	FCNUMERIC.VALUE_AT.$T3
	CALLS	#3,G^FCVALUES.V_SUB
	MOVC3	#32,FCNUMERIC.VALUE_AT.$T3,@FCNUMERIC.VALUE_AT.V(AP)
;  211        if (v%err /= 0) call fail(v%err, column)
	MOVL	FCNUMERIC.VALUE_AT.V(AP),R0
	TSTL	16(R0)
	BEQL	FCNUMERIC.VALUE_AT.$7
	PUSHL	#0
	PUSHAL	@FCNUMERIC.VALUE_AT.$A6
	MOVL	FCNUMERIC.VALUE_AT.V(AP),R0
	PUSHAL	16(R0)
	CALLS	#3,G^FCMESSAGES.FAIL
FCNUMERIC.VALUE_AT.$7:
;  212      end if
;  213
;  214    contains
	RET

; Storage map for FCNUMERIC.VALUE_AT.SCALAR_OF, a LOGICAL function
;   Y          TYPE(QUANTITY), INTENT(INOUT)  argument 1  @FCNUMERIC.VALUE_AT.SCALAR_OF.Y(AP)
;   V          TYPE(VALUE), INTENT(OUT)       argument 2  @FCNUMERIC.VALUE_AT.SCALAR_OF.V(AP)
;   SCALAR_OF  LOGICAL                        R6          R6
;   FCNUMERIC.VALUE_AT.SCALAR_O.$N1 is FCNUMERIC.VALUE_AT.SCALAR_OF.$T1
;   FCNUMERIC.VALUE_AT.SCALAR_O.$N2 is FCNUMERIC.VALUE_AT.SCALAR_OF.$T2
