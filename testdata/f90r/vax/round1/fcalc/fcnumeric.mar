;  830
;  831      ! DIFFERENCE: D is the central difference with the step H; false if
;  832      ! evaluating the expression failed.
;  833      logical function difference(h, d) result(ok)
FCNUMERIC.DERIVATIVE.DIFFERENCE:
	.WORD	^M<R2,R3,R4,R5>		; internal procedure DIFFERENCE of FCNUMERIC.DERIVATIVE
;  834        real(rk), intent(in) :: h
;  835        type(value), intent(out) :: d
;  836        type(value) :: up, down, step
;  837
;  838        ok = .false.
;  839        step = real_value(h)
	PUSHAG	@FCNUMERIC.DERIVATIVE.DIFFE.$N24(AP)
	PUSHAB	FCNUMERIC.DERIVATIVE.DIFFE.$N25
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCNUMERIC.DERIVATIVE.DIFFE.$N25,FCNUMERIC.DERIVATIVE.DIFFE.$N26
;  840        up = value_at(tree, none, name, x + step, start)
	PUSHAB	FCNUMERIC.DERIVATIVE.DIFFE.$N26
	PUSHAB	@FCNUMERIC.DERIVATIVE.$A3
	PUSHAB	FCNUMERIC.DERIVATIVE.DIFFE.$N27
