	MOVG	FCNUMERIC.BRENT.REAL_VALUE_AT.V,@FCNUMERIC.BRENT.REAL_VALUE_.$N6(AP)
;  561        ok = .true.
;  562      end function real_value_at
	MOVL	#-1,R0			; the function's value
	RET

