FCNUMERIC.VALUE_AT.SCALAR_O.$N3:
	.LONG	31

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  215
;  216      ! SCALAR_OF: the quantity Y is a scalar without an error, V; if not,
;  217      ! V is a value with the error, and Y is released. (An internal
;  218      ! procedure of an internal procedure isn't allowed: SCALAR_OF is one of
;  219      ! VALUE_AT, a module procedure, and sees COLUMN by host association.)
;  220      logical function scalar_of(y, v)
FCNUMERIC.VALUE_AT.SCALAR_OF:
	.WORD	^M<R2,R3,R4,R5,R6>	; internal procedure SCALAR_OF of FCNUMERIC.VALUE_AT
;  221        type(quantity), intent(inout) :: y
;  222        type(value), intent(out) :: v
;  223
;  224        scalar_of = .false.
	CLRL	R6
;  225        if (quantity_error(y) /= 0) then
	PUSHAB	@FCNUMERIC.VALUE_AT.SCALAR_OF.Y(AP)
	CALLS	#1,G^FCARRAYS.QUANTITY_ERROR
	MOVL	R0,FCNUMERIC.VALUE_AT.SCALAR_O.$N1
	BEQL	FCNUMERIC.VALUE_AT.SCALAR_OF.$1
;  226          v = error_value(quantity_error(y))
	PUSHAB	@FCNUMERIC.VALUE_AT.SCALAR_OF.Y(AP)
	CALLS	#1,G^FCARRAYS.QUANTITY_ERROR
	MOVL	R0,FCNUMERIC.VALUE_AT.SCALAR_O.$N1
	PUSHAL	FCNUMERIC.VALUE_AT.SCALAR_O.$N1
	PUSHAB	FCNUMERIC.VALUE_AT.SCALAR_O.$N2
	CALLS	#2,G^FCVALUES.ERROR_VALUE
	MOVC3	#32,FCNUMERIC.VALUE_AT.SCALAR_O.$N2,@FCNUMERIC.VALUE_AT.SCALAR_OF.V(AP)
;  227        else if (is_array(y)) then
	BRB	FCNUMERIC.VALUE_AT.SCALAR_OF.$3
FCNUMERIC.VALUE_AT.SCALAR_OF.$1:
	PUSHAB	@FCNUMERIC.VALUE_AT.SCALAR_OF.Y(AP)
	CALLS	#1,G^FCARRAYS.IS_ARRAY
	MOVL	R0,FCNUMERIC.VALUE_AT.SCALAR_O.$N1
	BLBC	FCNUMERIC.VALUE_AT.SCALAR_O.$N1,FCNUMERIC.VALUE_AT.SCALAR_OF.$4
;  228          call fail(e_notscalar, column)
	PUSHL	#0
	PUSHAL	@FCNUMERIC.VALUE_AT.$A6
	PUSHAL	FCNUMERIC.VALUE_AT.SCALAR_O.$N3
	CALLS	#3,G^FCMESSAGES.FAIL
;  229          call release(y)
	PUSHAB	@FCNUMERIC.VALUE_AT.SCALAR_OF.Y(AP)
	CALLS	#1,G^FCARRAYS.RELEASE
;  230          v = error_value(e_notscalar)
	PUSHAL	FCNUMERIC.VALUE_AT.SCALAR_O.$N3
	PUSHAB	FCNUMERIC.VALUE_AT.SCALAR_O.$N2
	CALLS	#2,G^FCVALUES.ERROR_VALUE
	MOVC3	#32,FCNUMERIC.VALUE_AT.SCALAR_O.$N2,@FCNUMERIC.VALUE_AT.SCALAR_OF.V(AP)
;  231        else
	BRB	FCNUMERIC.VALUE_AT.SCALAR_OF.$3
FCNUMERIC.VALUE_AT.SCALAR_OF.$4:
;  232          v = y%s
	MOVL	FCNUMERIC.VALUE_AT.SCALAR_OF.Y(AP),R0
	MOVC3	#32,16(R0),@FCNUMERIC.VALUE_AT.SCALAR_OF.V(AP)
;  233          scalar_of = .true.
	MOVL	#-1,R6
;  234        end if
FCNUMERIC.VALUE_AT.SCALAR_OF.$3:
;  235      end function scalar_of
	MOVL	R6,R0			; the function's value
	RET

