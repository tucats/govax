	BLBC	FCNUMERIC.INTEGRATE_COMMAN.$N17,FCNUMERIC.INTEGRATE_COMMAND.$10
	PUSHAQ	FCNUMERIC.INTEGRATE_COMMAND.$D8
	PUSHAB	FCNUMERIC.INTEGRATE_COMMAN.$N20
	CALLS	#2,G^FCNUMERIC.SHOW_ANSWER
FCNUMERIC.INTEGRATE_COMMAND.$10:
;  596    end subroutine integrate_command
	RET

