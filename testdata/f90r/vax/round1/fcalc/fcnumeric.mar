	PUSHAG	FCNUMERIC.BRENT.$T9
	PUSHAG	FCNUMERIC.BRENT.$K8
	CALLS	#2,G^FCNUMERIC.SCALED
	MOVG	R0,FCNUMERIC.BRENT.$T13
	PUSHAG	FCNUMERIC.BRENT.Q
	PUSHAG	FCNUMERIC.BRENT.TOL
	CALLS	#2,G^FCNUMERIC.SCALED
	MOVG	R0,FCNUMERIC.BRENT.$T8
	MOVG	FCNUMERIC.BRENT.$T8,FCNUMERIC.BRENT.$T7
	BGEQ	FCNUMERIC.BRENT.$61
	MNEGG	FCNUMERIC.BRENT.$T7,FCNUMERIC.BRENT.$T7
FCNUMERIC.BRENT.$61:
	MNEGG	FCNUMERIC.BRENT.$T7,FCNUMERIC.BRENT.$T6
	PUSHAL	FCNUMERIC.BRENT.ERR
	PUSHAG	FCNUMERIC.BRENT.$T6
	PUSHAG	FCNUMERIC.BRENT.$T13
	CALLS	#3,G^FCVALUES.R_ADD
	MOVG	R0,FCNUMERIC.BRENT.$T12
	MOVG	FCNUMERIC.BRENT.$T12,FCNUMERIC.BRENT.$T11
	PUSHAL	FCNUMERIC.BRENT.ERR
	PUSHAG	FCNUMERIC.BRENT.Q
	PUSHAG	FCNUMERIC.BRENT.E
	CALLS	#3,G^FCVALUES.R_MUL
	MOVG	R0,FCNUMERIC.BRENT.$T5
	MOVG	FCNUMERIC.BRENT.$T5,FCNUMERIC.BRENT.$T3
	BGEQ	FCNUMERIC.BRENT.$63
	MNEGG	FCNUMERIC.BRENT.$T3,FCNUMERIC.BRENT.$T3
FCNUMERIC.BRENT.$63:
	CMPG	FCNUMERIC.BRENT.$T3,FCNUMERIC.BRENT.$T11
	BGEQ	FCNUMERIC.BRENT.$65
	MOVG	FCNUMERIC.BRENT.$T3,FCNUMERIC.BRENT.$T11
FCNUMERIC.BRENT.$65:
	CMPG	FCNUMERIC.BRENT.$T10,FCNUMERIC.BRENT.$T11
	BGEQ	FCNUMERIC.BRENT.$67
;  518            e = d
	MOVG	FCNUMERIC.BRENT.D,FCNUMERIC.BRENT.E
;  519            d = r_div(p, q, err)
	PUSHAL	FCNUMERIC.BRENT.ERR
	PUSHAG	FCNUMERIC.BRENT.Q
	PUSHAG	FCNUMERIC.BRENT.P
	CALLS	#3,G^FCVALUES.R_DIV
	MOVG	R0,FCNUMERIC.BRENT.D
;  520          else
	BRB	FCNUMERIC.BRENT.$70
FCNUMERIC.BRENT.$67:
;  521            d = xm
	MOVG	FCNUMERIC.BRENT.XM,FCNUMERIC.BRENT.D
;  522            e = d
	MOVG	FCNUMERIC.BRENT.D,FCNUMERIC.BRENT.E
;  523          end if
;  524        else
	BRB	FCNUMERIC.BRENT.$70
FCNUMERIC.BRENT.$51:
;  525          ! Bisect.
;  526          d = xm
	MOVG	FCNUMERIC.BRENT.XM,FCNUMERIC.BRENT.D
;  527          e = d
	MOVG	FCNUMERIC.BRENT.D,FCNUMERIC.BRENT.E
;  528        end if
FCNUMERIC.BRENT.$70:
;  529        if (err /= 0) exit
	TSTL	FCNUMERIC.BRENT.ERR
	BEQL	FCNUMERIC.BRENT.$72
	BRW	FCNUMERIC.BRENT.$71
FCNUMERIC.BRENT.$72:
;  530
;  531        a = b
	MOVG	FCNUMERIC.BRENT.B,FCNUMERIC.BRENT.A
;  532        fa = fb
	MOVG	FCNUMERIC.BRENT.FB,FCNUMERIC.BRENT.FA
;  533        ! A step at least TOL long, so B moves.
;  534        if (abs(d) > tol) then
	MOVG	FCNUMERIC.BRENT.D,FCNUMERIC.BRENT.$T3
	BGEQ	FCNUMERIC.BRENT.$73
	MNEGG	FCNUMERIC.BRENT.$T3,FCNUMERIC.BRENT.$T3
FCNUMERIC.BRENT.$73:
	CMPG	FCNUMERIC.BRENT.$T3,FCNUMERIC.BRENT.TOL
