	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  740    end function integral
;  741
;  742    ! ------------------------------------------------------------------
;  743    ! DIFF.
;  744
;  745    subroutine diff_command()
	.ENTRY	FCNUMERIC.DIFF_COMMAND,^M<R6>
;  746      type(node), pointer :: tree
;  747      character(len=name_length) :: name
;  748      type(value) :: a, result
;  749      integer :: start, column
;  750      logical :: done
;  751
;  752      nullify (tree)
	CLRL	FCNUMERIC.DIFF_COMMAND.TREE
;  753      done = .false.
	CLRL	FCNUMERIC.DIFF_COMMAND.DONE
;  754      call advance(1)
	PUSHAL	FCNUMERIC.DIFF_COMMAND.$K1
	CALLS	#1,G^FCTREE.ADVANCE
;  755      start = current_column()
	CALLS	#0,G^FCTREE.CURRENT_COLUMN
	MOVL	R0,FCNUMERIC.DIFF_COMMAND.START
;  756
;  757      read: do
;  758        tree => parse_expression()
	CALLS	#0,G^FCTREE.PARSE_EXPRESSION
