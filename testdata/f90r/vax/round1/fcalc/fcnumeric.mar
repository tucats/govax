;    1  ! fcalc: the numerical commands, SOLVE, INTEGRATE, DIFF, and ROOTS.
;    2  !
;    3  !     SOLVE expr [= expr] FOR x [FROM a [TO b]]
;    4  !     INTEGRATE expr FOR x FROM a TO b
;    5  !     DIFF expr FOR x AT a
;    6  !     ROOTS c1, c2, ..., cn
;    7  !
;    8  ! Each of the first three treats an expression as a function of the
;    9  ! variable named after FOR and evaluates it at the points its method
;   10  ! chooses, through FCEVAL's EVALUATE_WITH: the name stands for the point,
;   11  ! hiding any variable of that name, which the command doesn't change. Its
;   12  ! answer is shown and kept as ANS, as an expression's value is.
;   13  !
;   14  ! - SOLVE finds a root of the expression (of the difference of the two
;   15  !   sides, if there is an =). From one starting point A (0 if none is
;   16  !   given) it uses the secant method, which may find a complex root from a
;   17  !   complex start; from a bracket, A to B, where the expression is real and
;   18  !   changes sign, Brent's method, which cannot fail to converge.
;   19  ! - INTEGRATE is the definite integral from A to B, by adaptive
;   20  !   Gauss-Kronrod quadrature.
;   21  ! - DIFF is the derivative at A, by Ridders' method: central differences
;   22  !   with smaller and smaller steps, extrapolated to a step of zero.
;   23  ! - ROOTS is every root of the polynomial with the coefficients given, the
;   24  !   highest power's first (module FCPOLY), as the function roots() is.
;   25  !
;   26  ! Each method's numbers are computed by FCVALUES' guarded operations, as
;   27  ! everything in fcalc is, so nothing traps, whatever the expression's
;   28  ! values; an error in evaluating the expression is reported at the node of
;   29  ! the expression it arose in, as for any expression.
;   30  !
;   31  ! Two answers depend on the machine's last bits more than others, and each
;   32  ! command deals with that itself, so that a VAX and an IEEE machine show
;   33  ! the same digits:
;   34  !
;   35  ! - A root, integral, or derivative that is 0 is computed as a tiny number
;   36  !   made of rounding errors. Each method knows how large its own error may
;   37  !   be, and a part of its answer smaller than that is set to 0.
;   38  ! - Each method's error estimate is a rounding error's size when the answer
;   39  !   is good. INTEGRATE and DIFF show it only when it is large, in a
;   40  !   warning, %FCALC-W-INACCURATE, to two significant digits.
;   41  !
;   42  ! The procedures that read the commands are written in one pattern: a DO
;   43  ! construct with no loop control and a name, as a block that can be left.
;   44  ! Each step that fails does EXIT out of it, and what was built is freed
;   45  ! after the block, once, whichever step failed (as a C program might use
;   46  ! GO TO to a cleanup label).
;   47  module fcnumeric
;   48    use fckinds
;   49    use fcmessages
;   50    use fcvalues
;   51    use fcarrays
;   52    use fclexer
;   53    use fctree
;   54    use fcsymbols
;   55    use fceval
;   56    use fcmatrix
;   57    implicit none
;   58    private
;   59
;   60    public :: solve_command, integrate_command, diff_command, roots_command
;   61
;   62    ! The readers of the commands' parts, which module FCPLOT's commands use
;   63    ! too. VALUE is public here too: READ_BOUND's argument is one, and a
;   64    ! public procedure's argument may not be of a type private in this module.
;   65    public :: value
;   66    public :: at_word, read_word, read_name, read_bound, at_end_of_line
;   67
;   68    ! How many steps the secant method and Brent's method may take.
;   69    integer, parameter :: step_limit = 200
;   70
;   71    ! How many pieces INTEGRATE may cut its interval into, at 15 values of
;   72    ! the expression for each piece and 30 for each cut. (A singularity at
;   73    ! an end, as 1/SQRT(X)'s at 0, takes about 100.)
;   74    integer, parameter :: max_pieces = 200
;   75
;   76    ! The Gauss-Kronrod rule of 7 and 15 points on [-1, 1] (QUADPACK's QK15):
;   77    ! the Kronrod rule's nodes, plus and minus each of NODES(1:7), and 0; its
;   78    ! weights for them, the last 0's; and the Gauss rule's weights for its
;   79    ! nodes, NODES(2), NODES(4), NODES(6), and 0, the last 0's.
;   80    real(rk), parameter :: nodes(7) = (/ 0.991455371120812639206854697526329_rk, &
;   81      0.949107912342758524526189684047851_rk, 0.864864423359769072789712788640926_rk, &
;   82      0.741531185599394439863864773280788_rk, 0.586087235467691130294144845693013_rk, &
;   83      0.405845151377397166906606412076961_rk, 0.207784955007898467600689403773245_rk /)
;   84    real(rk), parameter :: kronrod_weights(8) = (/ 0.022935322010529224963732008058970_rk, &
;   85      0.063092092629978553290700663189204_rk, 0.104790010322250183839876322541518_rk, &
;   86      0.140653259715525918745189590510238_rk, 0.169004726639267902826583426598550_rk, &
;   87      0.190350578064785409913256402421014_rk, 0.204432940075298892414161999234649_rk, &
;   88      0.209482141084727828012999174891714_rk /)
;   89    real(rk), parameter :: gauss_weights(4) = (/ 0.129484966168869693270611432679082_rk, &
;   90      0.279705391489276667901467771423780_rk, 0.381830050505118944950369775488975_rk, &
;   91      0.417959183673469387755102040816327_rk /)
;   92
;   93    ! Ridders' method: each step is the last divided by RIDDERS_STEP, at most
;   94    ! TABLE_SIZE steps, stopping when the error grows SAFE times past its
;   95    ! smallest.
;   96    real(rk), parameter :: ridders_step = 1.4_rk, safe = 2.0_rk
;   97    integer, parameter :: table_size = 10
;   98
;   99  contains

