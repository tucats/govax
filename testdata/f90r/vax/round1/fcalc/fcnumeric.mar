	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  597
;  598    ! INTEGRAL: RESULT is the integral of the expression from A to B, by
;  599    ! adaptive Gauss-Kronrod quadrature, as QUADPACK's QAG routine does it
;  600    ! (R. Piessens and others, "QUADPACK", 1983).
;  601    !
;  602    ! A Gauss rule of n points integrates a polynomial of degree 2n - 1
;  603    ! exactly, the best n points can do, so for a smooth function it is very
;  604    ! accurate. Kronrod's extension adds n + 1 points to the Gauss rule's n,
;  605    ! for a rule of 2n + 1 points exact to degree 3n + 1; the two rules share
;  606    ! the Gauss points, so both come from the same 2n + 1 values, and their
;  607    ! difference is an estimate (a pessimistic one) of the Gauss rule's error,
;  608    ! and so a bound on the Kronrod rule's. Here n is 7: 15 values a piece.
;  609    !
;  610    ! The interval starts as one piece. While the pieces' errors add up to
;  611    ! more than the tolerance, the piece with the largest error is cut in two,
;  612    ! so the work goes where the function is hard: near a kink, a jump, or a
;  613    ! singularity at an end, where the pieces shrink, and nowhere else. The
;  614    ! tolerance is relative, 10 to the -(DIGITS+1) of the integral of |f|
;  615    ! (which the same values estimate): one relative to the integral itself
;  616    ! would never be met by an integral of 0. No piece's error counts as less
;  617    ! than a rounding error's size, 50 EPS times its integral of |f|, which is
;  618    ! all the arithmetic can promise.
;  619    !
;  620    ! The rule never evaluates the function at a piece's ends, so it can
;  621    ! integrate a function infinite at an end, 1/SQRT(X) from 0, as long as
;  622    ! the integral is finite. If the pieces run out (MAX_PIECES) first, the
;  623    ! answer is the best there is, and the warning INACCURATE gives the error.
;  624    !
;  625    ! The pieces are kept in allocatable arrays, made the size of the most
;  626    ! there may be: LO and HI, each piece's ends; PART, its integral; ERROR,
;  627    ! its error; and MAGNITUDE, its integral of |f|. SUM, MAXLOC, and array
;  628    ! sections do the bookkeeping.
;  629    logical function integral(tree, name, a, b, start, result) result(done)
	.ENTRY	FCNUMERIC.INTEGRAL,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVL	4(AP),FCNUMERIC.INTEGRAL.$A1 ; TREE is argument 1
	MOVL	8(AP),FCNUMERIC.INTEGRAL.$A2 ; NAME is argument 2
	MOVL	20(AP),FCNUMERIC.INTEGRAL.$A5 ; START is argument 5
	CLRL	FCNUMERIC.INTEGRAL.LO+4
	CLRL	FCNUMERIC.INTEGRAL.HI+4
	CLRL	FCNUMERIC.INTEGRAL.ERROR+4
	CLRL	FCNUMERIC.INTEGRAL.MAGNITUDE+4
	CLRL	FCNUMERIC.INTEGRAL.PART+4
;  630      type(node), pointer :: tree
;  631      character(len=*), intent(in) :: name
;  632      type(value), intent(in) :: a, b
;  633      integer, intent(in) :: start
;  634      type(value), intent(out) :: result
;  635      type(node), pointer :: none
;  636      real(rk), allocatable :: lo(:), hi(:), error(:), magnitude(:)
;  637      type(value), allocatable :: part(:)
;  638      real(rk) :: tol, middle
;  639      integer :: n, k, worst(1)
;  640
;  641      ! NONE points to no tree: VALUE_AT's second side, for an expression
;  642      ! that has only one. (Fortran 95's NULL() would do; in Fortran 90 a
;  643      ! pointer is made to point nowhere by NULLIFY, and a pointer argument
;  644      ! must be a pointer variable, not a function's value.)
;  645      nullify (none)
	CLRL	FCNUMERIC.INTEGRAL.NONE
;  646      done = .false.
	CLRL	FCNUMERIC.INTEGRAL.DONE
;  647      result = real_value(0.0_rk)
	PUSHAG	FCNUMERIC.INTEGRAL.$K1
	PUSHAB	FCNUMERIC.INTEGRAL.$T1
	CALLS	#2,G^FCVALUES.REAL_VALUE
	MOVC3	#32,FCNUMERIC.INTEGRAL.$T1,@FCNUMERIC.INTEGRAL.RESULT(AP)
;  648      if (a%z == b%z) then
	CMPG	@FCNUMERIC.INTEGRAL.A(AP),@FCNUMERIC.INTEGRAL.B(AP)
	BEQL	FCNUMERIC.INTEGRAL.$2
	BRW	FCNUMERIC.INTEGRAL.$1
FCNUMERIC.INTEGRAL.$2:
	MOVL	FCNUMERIC.INTEGRAL.A(AP),R0
	MOVL	FCNUMERIC.INTEGRAL.B(AP),R1
	CMPG	8(R0),8(R1)
	BNEQ	FCNUMERIC.INTEGRAL.$1
;  649        done = .true.
;  650        return
	TSTL	FCNUMERIC.INTEGRAL.LO+4
	BEQL	FCNUMERIC.INTEGRAL.$4
	PUSHL	#0
	PUSHAQ	FCNUMERIC.INTEGRAL.LO
	CALLS	#2,G^FTN$DEALLOCATE
FCNUMERIC.INTEGRAL.$4:
	TSTL	FCNUMERIC.INTEGRAL.HI+4
	BEQL	FCNUMERIC.INTEGRAL.$6
	PUSHL	#0
	PUSHAQ	FCNUMERIC.INTEGRAL.HI
	CALLS	#2,G^FTN$DEALLOCATE
FCNUMERIC.INTEGRAL.$6:
	TSTL	FCNUMERIC.INTEGRAL.ERROR+4
	BEQL	FCNUMERIC.INTEGRAL.$8
	PUSHL	#0
	PUSHAQ	FCNUMERIC.INTEGRAL.ERROR
	CALLS	#2,G^FTN$DEALLOCATE
FCNUMERIC.INTEGRAL.$8:
	TSTL	FCNUMERIC.INTEGRAL.MAGNITUDE+4
	BEQL	FCNUMERIC.INTEGRAL.$10
	PUSHL	#0
	PUSHAQ	FCNUMERIC.INTEGRAL.MAGNITUDE
	CALLS	#2,G^FTN$DEALLOCATE
