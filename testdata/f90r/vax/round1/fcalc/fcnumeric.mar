	PUSHAL	@FCNUMERIC.BRENT.$A6
	PUSHAL	FCNUMERIC.BRENT.$K6
	CALLS	#3,G^FCMESSAGES.FAIL
FCNUMERIC.BRENT.$43:
;  493          return
	MOVL	R6,R0			; the function's value
	RET
FCNUMERIC.BRENT.$34:
;  494        end if
;  495
;  496        if (abs(e) >= tol .and. abs(fa) > abs(fb)) then
	MOVG	FCNUMERIC.BRENT.E,FCNUMERIC.BRENT.$T5
	BGEQ	FCNUMERIC.BRENT.$45
	MNEGG	FCNUMERIC.BRENT.$T5,FCNUMERIC.BRENT.$T5
FCNUMERIC.BRENT.$45:
	MOVG	FCNUMERIC.BRENT.FA,FCNUMERIC.BRENT.$T3
	BGEQ	FCNUMERIC.BRENT.$47
	MNEGG	FCNUMERIC.BRENT.$T3,FCNUMERIC.BRENT.$T3
FCNUMERIC.BRENT.$47:
	MOVG	FCNUMERIC.BRENT.FB,FCNUMERIC.BRENT.$T4
	BGEQ	FCNUMERIC.BRENT.$49
	MNEGG	FCNUMERIC.BRENT.$T4,FCNUMERIC.BRENT.$T4
FCNUMERIC.BRENT.$49:
	CMPG	FCNUMERIC.BRENT.$T5,FCNUMERIC.BRENT.TOL
	BGEQ	FCNUMERIC.BRENT.$52
	BRW	FCNUMERIC.BRENT.$51
FCNUMERIC.BRENT.$52:
	CMPG	FCNUMERIC.BRENT.$T3,FCNUMERIC.BRENT.$T4
	BGTR	FCNUMERIC.BRENT.$53
	BRW	FCNUMERIC.BRENT.$51
FCNUMERIC.BRENT.$53:
;  497          ! Interpolate: P / Q is the step from B.
;  498          s = r_div(fb, fa, err)
	PUSHAL	FCNUMERIC.BRENT.ERR
	PUSHAG	FCNUMERIC.BRENT.FA
	PUSHAG	FCNUMERIC.BRENT.FB
	CALLS	#3,G^FCVALUES.R_DIV
	MOVG	R0,FCNUMERIC.BRENT.S
;  499          if (a == c) then
	CMPG	FCNUMERIC.BRENT.A,FCNUMERIC.BRENT.C
	BNEQ	FCNUMERIC.BRENT.$54
;  500            ! Two points: the secant.
;  501            p = r_mul(scaled(2.0_rk, xm), s, err)
	PUSHAG	FCNUMERIC.BRENT.XM
	PUSHAG	FCNUMERIC.BRENT.$K7
	CALLS	#2,G^FCNUMERIC.SCALED
	MOVG	R0,FCNUMERIC.BRENT.$T4
	PUSHAL	FCNUMERIC.BRENT.ERR
	PUSHAG	FCNUMERIC.BRENT.S
	PUSHAG	FCNUMERIC.BRENT.$T4
	CALLS	#3,G^FCVALUES.R_MUL
	MOVG	R0,FCNUMERIC.BRENT.P
;  502            q = 1 - s
	SUBG3	FCNUMERIC.BRENT.S,FCNUMERIC.BRENT.$KF1,FCNUMERIC.BRENT.Q
;  503          else
	BRW	FCNUMERIC.BRENT.$56
FCNUMERIC.BRENT.$54:
;  504            ! Three: inverse quadratic interpolation.
;  505            q = r_div(fa, fc, err)
	PUSHAL	FCNUMERIC.BRENT.ERR
	PUSHAG	FCNUMERIC.BRENT.FC
	PUSHAG	FCNUMERIC.BRENT.FA
	CALLS	#3,G^FCVALUES.R_DIV
	MOVG	R0,FCNUMERIC.BRENT.Q
