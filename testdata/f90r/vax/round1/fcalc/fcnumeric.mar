FCNUMERIC.ROOTS_COMMAND.$97:
;  923        end if
;  924        call show_quantity(q, '')
	PUSHAQ	FCNUMERIC.ROOTS_COMMAND.$D5
	PUSHAB	FCNUMERIC.ROOTS_COMMAND.Q
	CALLS	#2,G^FCARRAYS.SHOW_QUANTITY
;  925        call set_variable('ans', q)
	PUSHAB	FCNUMERIC.ROOTS_COMMAND.Q
	PUSHAQ	FCNUMERIC.ROOTS_COMMAND.$D6
	CALLS	#2,G^FCSYMBOLS.SET_VARIABLE
;  926        exit read
FCNUMERIC.ROOTS_COMMAND.$5:
;  927      end do read
;  928
;  929      if (associated(c)) deallocate (c)
	TSTL	FCNUMERIC.ROOTS_COMMAND.C+4
	BEQL	FCNUMERIC.ROOTS_COMMAND.$99
	PUSHL	#2
	PUSHAQ	FCNUMERIC.ROOTS_COMMAND.C
	CALLS	#2,G^FTN$DEALLOCATE
FCNUMERIC.ROOTS_COMMAND.$99:
;  930    end subroutine roots_command
	RET
FCNUMERIC.ROOTS_COMMAND.$36:		; leaving the loop
	MOVL	R9,FCNUMERIC.ROOTS_COMMAND.N
	BRW	FCNUMERIC.ROOTS_COMMAND.$39
;  931  end module fcnumeric

	.END
