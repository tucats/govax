	CALLS	#3,G^FCNUMERIC.READ_BOUND
	MOVL	R0,R6
	BLBC	R6,FCNUMERIC.INTEGRATE_COMMAND.$1
;  589        if (.not. at_end_of_line()) exit read
	CALLS	#0,G^FCNUMERIC.AT_END_OF_LINE
	MOVL	R0,R6
	BLBC	R6,FCNUMERIC.INTEGRATE_COMMAND.$1
;  590        done = integral(tree, name, a, b, start, result)
	PUSHAB	FCNUMERIC.INTEGRATE_COMMAN.$N20
	PUSHAL	FCNUMERIC.INTEGRATE_COMMAN.$N18
	PUSHAB	FCNUMERIC.INTEGRATE_COMMAND.B
	PUSHAB	FCNUMERIC.INTEGRATE_COMMAND.A
	PUSHAQ	FCNUMERIC.INTEGRATE_COMMAND.$D3
	PUSHAL	FCNUMERIC.INTEGRATE_COMMAN.$N16
	CALLS	#6,G^FCNUMERIC.INTEGRAL
	MOVL	R0,FCNUMERIC.INTEGRATE_COMMAN.$N17
