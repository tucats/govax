	PUSHAG	FCNUMERIC.DERIVATIVE.DIFFE.$N34
	PUSHAB	FCNUMERIC.DERIVATIVE.DIFFE.$N35
	CALLS	#2,G^FCVALUES.REAL_VALUE
	PUSHAB	FCNUMERIC.DERIVATIVE.DIFFE.$N26
