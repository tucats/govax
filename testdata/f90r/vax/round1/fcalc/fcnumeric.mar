	PUSHAL	@FCNUMERIC.BRENT.$A6
	PUSHAL	FCNUMERIC.BRENT.REAL_VALUE.$N14
	CALLS	#3,G^FCMESSAGES.FAIL
;  558          return
	CLRL	R0			; the function's value
	RET
FCNUMERIC.BRENT.REAL_VALUE.$N12:
;  559        end if
