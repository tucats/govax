	PUSHAG	FCNUMERIC.BRENT.FC
	PUSHAG	FCNUMERIC.BRENT.FB
	CALLS	#3,G^FCVALUES.R_DIV
	MOVG	R0,R8
;  507            p = r_mul(s, r_add(r_mul(r_mul(scaled(2.0_rk, xm), q, err), r_add(q, -r, err), err), &
;  508              -r_mul(r_add(b, -a, err), r - 1, err), err), err)
	PUSHAG	FCNUMERIC.BRENT.XM
	PUSHAG	FCNUMERIC.BRENT.$K7
	CALLS	#2,G^FCNUMERIC.SCALED
	MOVG	R0,FCNUMERIC.BRENT.$T6
	PUSHAL	FCNUMERIC.BRENT.ERR
	PUSHAG	FCNUMERIC.BRENT.Q
	PUSHAG	FCNUMERIC.BRENT.$T6
	CALLS	#3,G^FCVALUES.R_MUL
	MOVG	R0,FCNUMERIC.BRENT.$T5
	MNEGG	R8,FCNUMERIC.BRENT.$T8
	PUSHAL	FCNUMERIC.BRENT.ERR
	PUSHAG	FCNUMERIC.BRENT.$T8
	PUSHAG	FCNUMERIC.BRENT.Q
	CALLS	#3,G^FCVALUES.R_ADD
	MOVG	R0,FCNUMERIC.BRENT.$T7
	PUSHAL	FCNUMERIC.BRENT.ERR
	PUSHAG	FCNUMERIC.BRENT.$T7
	PUSHAG	FCNUMERIC.BRENT.$T5
	CALLS	#3,G^FCVALUES.R_MUL
	MOVG	R0,FCNUMERIC.BRENT.$T3
	MNEGG	FCNUMERIC.BRENT.A,FCNUMERIC.BRENT.$T11
	PUSHAL	FCNUMERIC.BRENT.ERR
	PUSHAG	FCNUMERIC.BRENT.$T11
	PUSHAG	FCNUMERIC.BRENT.B
	CALLS	#3,G^FCVALUES.R_ADD
	MOVG	R0,FCNUMERIC.BRENT.$T10
	SUBG3	FCNUMERIC.BRENT.$KF1,R8,FCNUMERIC.BRENT.$T12
	PUSHAL	FCNUMERIC.BRENT.ERR
	PUSHAG	FCNUMERIC.BRENT.$T12
	PUSHAG	FCNUMERIC.BRENT.$T10
	CALLS	#3,G^FCVALUES.R_MUL
	MOVG	R0,FCNUMERIC.BRENT.$T9
	MNEGG	FCNUMERIC.BRENT.$T9,FCNUMERIC.BRENT.$T13
	PUSHAL	FCNUMERIC.BRENT.ERR
	PUSHAG	FCNUMERIC.BRENT.$T13
	PUSHAG	FCNUMERIC.BRENT.$T3
	CALLS	#3,G^FCVALUES.R_ADD
	MOVG	R0,FCNUMERIC.BRENT.$T4
	PUSHAL	FCNUMERIC.BRENT.ERR
	PUSHAG	FCNUMERIC.BRENT.$T4
	PUSHAG	FCNUMERIC.BRENT.S
	CALLS	#3,G^FCVALUES.R_MUL
	MOVG	R0,FCNUMERIC.BRENT.P
;  509            q = r_mul(r_mul(q - 1, r - 1, err), s - 1, err)
	SUBG3	FCNUMERIC.BRENT.$KF1,FCNUMERIC.BRENT.Q,FCNUMERIC.BRENT.$T12
	SUBG3	FCNUMERIC.BRENT.$KF1,R8,FCNUMERIC.BRENT.$T11
	PUSHAL	FCNUMERIC.BRENT.ERR
	PUSHAG	FCNUMERIC.BRENT.$T11
	PUSHAG	FCNUMERIC.BRENT.$T12
	CALLS	#3,G^FCVALUES.R_MUL
	MOVG	R0,FCNUMERIC.BRENT.$T13
	SUBG3	FCNUMERIC.BRENT.$KF1,FCNUMERIC.BRENT.S,FCNUMERIC.BRENT.$T10
	PUSHAL	FCNUMERIC.BRENT.ERR
	PUSHAG	FCNUMERIC.BRENT.$T10
	PUSHAG	FCNUMERIC.BRENT.$T13
	CALLS	#3,G^FCVALUES.R_MUL
	MOVG	R0,FCNUMERIC.BRENT.Q
;  510          end if
FCNUMERIC.BRENT.$56:
;  511          if (p > 0) q = -q
	TSTG	FCNUMERIC.BRENT.P
	BLEQ	FCNUMERIC.BRENT.$57
	MNEGG	FCNUMERIC.BRENT.Q,FCNUMERIC.BRENT.Q
FCNUMERIC.BRENT.$57:
;  512          p = abs(p)
	MOVG	FCNUMERIC.BRENT.P,FCNUMERIC.BRENT.$T10
	BGEQ	FCNUMERIC.BRENT.$59
	MNEGG	FCNUMERIC.BRENT.$T10,FCNUMERIC.BRENT.$T10
FCNUMERIC.BRENT.$59:
	MOVG	FCNUMERIC.BRENT.$T10,FCNUMERIC.BRENT.P
;  513          ! Take the step only if it lands within three quarters of the way
;  514          ! across the bracket, and is less than half the step before last
;  515          ! (else bisection would do better).
;  516          if (scaled(2.0_rk, p) < min(r_add(scaled(3.0_rk, r_mul(xm, q, err)), &
