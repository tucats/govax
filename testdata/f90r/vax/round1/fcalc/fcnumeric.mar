;  861    end function derivative
;  862
;  863    ! ------------------------------------------------------------------
;  864    ! ROOTS.
;  865
;  866    ! ROOTS c1, c2, ..., cn: the roots of the polynomial with these
;  867    ! coefficients, highest power first. Each may be a vector, its elements
;  868    ! joined to the list, so ROOTS p takes a vector p of coefficients. The
;  869    ! roots are the function roots()'s (module FCPOLY), a column.
;  870    subroutine roots_command()
	.ENTRY	FCNUMERIC.ROOTS_COMMAND,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
;  871      type(node), pointer :: tree
;  872      type(quantity) :: list(1), q
;  873      complex(rk), pointer :: c(:), more(:)
;  874      type(value) :: v
;  875      integer :: first, column, n, k
;  876
;  877      nullify (c)
	CLRL	FCNUMERIC.ROOTS_COMMAND.C+4
;  878      n = 0
	CLRL	FCNUMERIC.ROOTS_COMMAND.N
;  879      call advance(1)
	PUSHAL	FCNUMERIC.ROOTS_COMMAND.$K1
	CALLS	#1,G^FCTREE.ADVANCE
;  880      first = current_column()
	CALLS	#0,G^FCTREE.CURRENT_COLUMN
	MOVL	R0,FCNUMERIC.ROOTS_COMMAND.FIRST
;  881
;  882      read: do
	MOVL	FCNUMERIC.ROOTS_COMMAND.N,R9
	BRW	FCNUMERIC.ROOTS_COMMAND.$1
FCNUMERIC.ROOTS_COMMAND.$2:
;  883        column = current_column()
;  884        tree => parse_expression()
;  885        if (failed()) exit read
;  886        q = evaluate(tree)
	PUSHL	#0
	PUSHAL	FCNUMERIC.ROOTS_COMMAND.TREE
	PUSHAB	FCNUMERIC.ROOTS_COMMAND.$T2
	CALLS	#3,G^FCEVAL.EVALUATE
	MOVC3	#96,FCNUMERIC.ROOTS_COMMAND.$T2,FCNUMERIC.ROOTS_COMMAND.Q
;  887        call free_tree(tree)
	PUSHAL	FCNUMERIC.ROOTS_COMMAND.TREE
	CALLS	#1,G^FCTREE.FREE_TREE
;  888        if (failed()) then
	CALLS	#0,G^FCMESSAGES.FAILED
	MOVL	R0,R8
	BLBC	R8,FCNUMERIC.ROOTS_COMMAND.$3
	MOVL	R9,FCNUMERIC.ROOTS_COMMAND.N
;  889          call release(q)
	PUSHAB	FCNUMERIC.ROOTS_COMMAND.Q
	CALLS	#1,G^FCARRAYS.RELEASE
;  890          exit read
	BRW	FCNUMERIC.ROOTS_COMMAND.$5
FCNUMERIC.ROOTS_COMMAND.$3:
;  891        end if
;  892
;  893        if (is_array(q) .and. .not. is_vector(q)) then
	PUSHAB	FCNUMERIC.ROOTS_COMMAND.Q
	CALLS	#1,G^FCARRAYS.IS_ARRAY
	MOVL	R0,R8
	PUSHAB	FCNUMERIC.ROOTS_COMMAND.Q
	CALLS	#1,G^FCARRAYS.IS_VECTOR
	MOVL	R0,R6
	BLBC	R8,FCNUMERIC.ROOTS_COMMAND.$6
	BLBS	R6,FCNUMERIC.ROOTS_COMMAND.$6
	MOVL	R9,FCNUMERIC.ROOTS_COMMAND.N
;  894          call fail(e_notvector, column)
	PUSHL	#0
