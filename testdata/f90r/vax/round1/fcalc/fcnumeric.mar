	CALLS	#6,G^FCNUMERIC.VALUE_AT
	MOVC3	#32,FCNUMERIC.DERIVATIVE.DIFFE.$N25,FCNUMERIC.DERIVATIVE.DIFFE.$N28
;  841        if (up%err /= 0) return
	TSTL	FCNUMERIC.DERIVATIVE.DIFFE.$N28+16
	BEQL	FCNUMERIC.DERIVATIVE.DIFFE.$N29
	CLRL	R0			; the function's value
	RET
FCNUMERIC.DERIVATIVE.DIFFE.$N29:
;  842        down = value_at(tree, none, name, x - step, start)
	PUSHAB	FCNUMERIC.DERIVATIVE.DIFFE.$N26
	PUSHAB	@FCNUMERIC.DERIVATIVE.$A3
	PUSHAB	FCNUMERIC.DERIVATIVE.DIFFE.$N25
	CALLS	#3,G^FCVALUES.V_SUB
	PUSHAL	@FCNUMERIC.DERIVATIVE.$A4
	PUSHAB	FCNUMERIC.DERIVATIVE.DIFFE.$N25
	PUSHL	FCNUMERIC.DERIVATIVE.$A2
	PUSHAL	FCNUMERIC.DERIVATIVE.NONE
	PUSHAL	@FCNUMERIC.DERIVATIVE.$A1
	PUSHAB	FCNUMERIC.DERIVATIVE.DIFFE.$N27
	CALLS	#6,G^FCNUMERIC.VALUE_AT
	MOVC3	#32,FCNUMERIC.DERIVATIVE.DIFFE.$N27,FCNUMERIC.DERIVATIVE.DIFFE.$N31
;  843        if (down%err /= 0) return
	TSTL	FCNUMERIC.DERIVATIVE.DIFFE.$N31+16
	BEQL	FCNUMERIC.DERIVATIVE.DIFFE.$N32
	CLRL	R0			; the function's value
	RET
FCNUMERIC.DERIVATIVE.DIFFE.$N32:
;  844        d = (up - down) / (real_value(2.0_rk) * step)
	PUSHAB	FCNUMERIC.DERIVATIVE.DIFFE.$N31
	PUSHAB	FCNUMERIC.DERIVATIVE.DIFFE.$N28
	PUSHAB	FCNUMERIC.DERIVATIVE.DIFFE.$N27
