                                                                         24-NOV-2026 14:22:39  DUA1:[ERR113]MAC113B.MAR;1        (1)

                                     0000     1 	.TITLE	MAC113B	a semicolon in angle brackets, .ERROR and .WARN
                                     0000     2 ;
                                     0000     3 ; Phase 113's probe round (A.6.6): is a ";" inside <...> in a macro call part of the
                                     0000     4 ; argument, or a comment? And what do .WARN, .ERROR, and .PRINT show, at the terminal
                                     0000     5 ; and in the listing?
                                     0000     6 ;
                                     0000     7 	.MACRO	SHOW	A, B
                                     0000     8 	.ASCII	/A/
                                     0000     9 	.ASCII	/B/
                                     0000    10 	.ENDM	SHOW
                                     0000    11 
                                 00000000    12 	.PSECT	DATA, NOEXE,WRT,LONG
                                     0000    13 	SHOW	<X;Y>, Z
                                     0004    14 	SHOW	<P ; Q>
                                     0009    15 	SHOW	<;>, W
%MACRO-W-GENWRN, Generated WARNING: 1  a warning's text
                                     000B       
%MACRO-E-GENERR, Generated ERROR: 2  an error's text
                                     000B       
                           00000003  000B    18 	.PRINT	3		; a printed line

%MACRO-W-GENWRN, Generated WARNING:  a warning with no expression
                                     000B       
                                     000B    20 	.END
