	.PSECT	CODE,NOWRT,EXE

; HANDLER records the condition (and an access violation's reason mask
; and address), then unwinds to the caller of the routine that set it up,
; which gets the condition in R0. It ignores SS$_UNWIND.
	.ENTRY	HANDLER,^M<>
	MOVL	4(AP),R0		; the signal array
	CMPL	4(R0),#SS$_UNWIND
	BEQL	9$
	MOVL	4(R0),SIGCOND
	CLRQ	SIGARG1
	CMPL	SIGCOND,#SS$_ACCVIO
	BNEQ	1$
	MOVQ	8(R0),SIGARG1
1$:	MOVL	8(AP),R1		; the mechanism array
	MOVL	SIGCOND,12(R1)		; CHF$L_MCH_SAVR0
	$UNWIND_S
9$:	RET

; EMIT writes the line in LINE (LINLEN long): to the log while a case
; runs (INCALL), else to SYS$OUTPUT.
	.ENTRY	EMIT,^M<R2,R3,R4,R5>
	MOVZWL	LINLEN,R2
	TSTL	INCALL
	BEQL	2$
	ADDL3	LOGEND,R2,R3
	ADDL2	#2,R3
	CMPL	R3,#LOGSIZE
	BGTRU	1$
	MOVAB	LOGBUF,R4
	ADDL2	LOGEND,R4
	MOVW	R2,(R4)+
	MOVL	R3,LOGEND
	MOVC3	R2,LINE,(R4)
	RET
1$:	INCL	LOGLOST
	RET
2$:	MOVW	R2,OUTDSC
	PUSHAQ	OUTDSC
	CALLS	#1,G^LIB$PUT_OUTPUT
	RET

; FLUSH writes the log's lines to SYS$OUTPUT and empties it.
	.ENTRY	FLUSH,^M<R2,R3>
	MOVAB	LOGBUF,R2
	ADDL3	R2,LOGEND,R3
1$:	CMPL	R2,R3
	BGEQU	2$
	MOVZWL	(R2)+,R0
	MOVW	R0,LOGDSC
	MOVL	R2,LOGDSC+4
	ADDL2	R0,R2
	PUSHAQ	LOGDSC
	CALLS	#1,G^LIB$PUT_OUTPUT
	BRB	1$
2$:	CLRL	LOGEND
	TSTL	LOGLOST
	BEQL	3$
	$FAO_S	CTRSTR=LOSTCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=LOGLOST
	CLRL	LOGLOST
	CALLS	#0,EMIT
3$:	RET

; RAWMARK marker: writes the marker straight to SYS$OUTPUT.
	.ENTRY	RAWMARK,^M<>
	PUSHL	4(AP)
	CALLS	#1,G^LIB$PUT_OUTPUT
	RET

; RESETCB puts the routines' answers back as they start, success, and
; the action routine's record.
	.ENTRY	RESETCB,^M<>
	MNEGL	#1,UBITS
	MNEGL	#1,DBITS
	MNEGL	#1,PBITS
	MNEGL	#1,ACTBITS
	CLRL	ACTN
	MOVL	#^X55555555,ACTARGC
	MOVL	#^X55555555,ACTARG
	MOVL	#^X55555555,ACTDSC
	RET

; CBSTAT cell: the status a routine returns, from the cell's low bit (1
; is success, 0 FAILST), and the cell rotated a bit to the right.
	.ENTRY	CBSTAT,^M<>
	MOVL	4(AP),R1
	MOVL	#1,R0
	BLBS	(R1),1$
	MOVL	#FAILST,R0
1$:	ROTL	#-1,(R1),(R1)
	RET

; ACTION string, user-arg: LIB$SHOW_VM's and LIB$SHOW_VM_ZONE's action
; routine. Logs the line ("  | text"), records the call, and returns
; ACTBITS's next bit.
	.ENTRY	ACTION,^M<R2>
	INCL	ACTN
	MOVZBL	(AP),ACTARGC
	CLRL	ACTARG
	CMPB	(AP),#2
	BLSS	1$
	MOVL	8(AP),ACTARG
1$:	MOVL	4(AP),R2
	MOVZWL	2(R2),ACTDSC
	$FAO_S	CTRSTR=ACTCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=R2
	CALLS	#0,EMIT
	PUSHAB	ACTBITS
	CALLS	#1,CBSTAT
	RET

; FINDALL: each zone LIB$FIND_VM_ZONE finds, from context 0, shown at
; detail level 0 through ACTION; then the status that ended the scan and
; how many it found ("  = end").
	.ENTRY	FINDALL,^M<R2,R3>
	CLRL	FACTX
	CLRL	R3
1$:	PUSHAL	FAZONE
	PUSHAL	FACTX
	CALLS	#2,G^LIB$FIND_VM_ZONE
	BLBC	R0,2$
	INCL	R3
	CMPL	R3,#60
	BGTR	2$
	PUSHL	#0
	PUSHAB	ACTION
	PUSHAL	ZERO
	PUSHAL	FAZONE
	CALLS	#4,G^LIB$SHOW_VM_ZONE
	BRB	1$
2$:	MOVL	R0,R2
	$FAO_S	CTRSTR=FINDCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=R2,P2=R3
	CALLS	#0,EMIT
	MOVL	R2,R0
	RET

; UPRINT name, ap: a user zone routine's line ("  > name argc"), then a
; line for each argument, by what it is: 0; GVN (with its value) or GVB,
; the case's cells; an address in the user zone's control block (UZCUR)
; or on the stack, with the longword there (the real zone, RZCUR, or a
; value); or elsewhere.
	.ENTRY	UPRINT,^M<R2,R3,R4,R5>
	MOVL	8(AP),R4
	MOVZBL	(R4),R5
	$FAO_S	CTRSTR=CBHCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP),P2=R5
	CALLS	#0,EMIT
	CLRL	R3
1$:	CMPL	R3,R5
	BLSS	2$
	RET
2$:	MOVL	4(R4)[R3],R2
	ADDL3	#1,R3,T1
	TSTL	R2
	BNEQ	3$
	$FAO_S	CTRSTR=CB0CTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=T1
	BRW	90$
3$:	MOVAL	GVN,R0
	CMPL	R2,R0
	BNEQ	4$
	$FAO_S	CTRSTR=UNCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=T1,P2=GVN
	BRW	90$
4$:	MOVAL	GVB,R0
	CMPL	R2,R0
	BNEQ	5$
	$FAO_S	CTRSTR=UBCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=T1
	BRW	90$
5$:	SUBL3	UZCUR,R2,T2
	CMPL	T2,#256
	BGEQU	7$
	MOVL	(R2),T3
	CMPL	T3,RZCUR
	BNEQ	6$
	$FAO_S	CTRSTR=UZRCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=T1,P2=T2
	BRW	90$
6$:	$FAO_S	CTRSTR=UZVCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=T1,P2=T2,P3=T3
	BRW	90$
7$:	SUBL3	SP,R2,T2
	CMPL	T2,#^X10000
	BGEQU	9$
	MOVL	(R2),T3
	CMPL	T3,RZCUR
	BNEQ	8$
	$FAO_S	CTRSTR=USRCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=T1
	BRW	90$
8$:	$FAO_S	CTRSTR=USVCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=T1,P2=T3
	BRW	90$
9$:	$FAO_S	CTRSTR=UECTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=T1
90$:	CALLS	#0,EMIT
	INCL	R3
	BRW	1$

; USTATUS: logs the status in R0 ("  >   status") and keeps it.
	.ENTRY	USTATUS,^M<R2>
	MOVL	R0,R2
	$FAO_S	CTRSTR=USTCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=R2
	CALLS	#0,EMIT
	MOVL	R2,R0
	RET

; The user zone routines: each logs its call and arguments, then, if
; its bit says so (UBITS, or DBITS for delete), does the operation on
; the zone its user argument names, as Example 5-1's routines do;
; otherwise it returns FAILST.
	.ENTRY	UALLOC,^M<>
	PUSHL	AP
	PUSHAB	NM_UALLOC
	CALLS	#2,UPRINT
	PUSHAB	UBITS
	CALLS	#1,CBSTAT
	BLBC	R0,9$
	PUSHL	12(AP)
	PUSHL	8(AP)
	PUSHL	4(AP)
	CALLS	#3,G^LIB$GET_VM
	CALLS	#0,USTATUS
9$:	RET

	.ENTRY	UFREE,^M<>
	PUSHL	AP
	PUSHAB	NM_UFREE
	CALLS	#2,UPRINT
	PUSHAB	UBITS
	CALLS	#1,CBSTAT
	BLBC	R0,9$
	PUSHL	12(AP)
	PUSHL	8(AP)
	PUSHL	4(AP)
	CALLS	#3,G^LIB$FREE_VM
	CALLS	#0,USTATUS
9$:	RET

	.ENTRY	URESET,^M<>
	PUSHL	AP
	PUSHAB	NM_URESET
	CALLS	#2,UPRINT
	PUSHAB	UBITS
	CALLS	#1,CBSTAT
	BLBC	R0,9$
	PUSHL	4(AP)
	CALLS	#1,G^LIB$RESET_VM_ZONE
	CALLS	#0,USTATUS
9$:	RET

	.ENTRY	UDELETE,^M<>
	PUSHL	AP
	PUSHAB	NM_UDELETE
	CALLS	#2,UPRINT
	PUSHAB	DBITS
	CALLS	#1,CBSTAT
	BLBC	R0,9$
	PUSHL	4(AP)
	CALLS	#1,G^LIB$DELETE_VM_ZONE
	CALLS	#0,USTATUS
9$:	RET

; GPAGE and FPAGE, a zone's get-page and free-page routines: each logs
; its call ("  > get-page argc n=count") and, if PBITS says so, passes
; it to LIB$GET_VM_PAGE or LIB$FREE_VM_PAGE, logging the status;
; otherwise it returns FAILST.
	.ENTRY	GPAGE,^M<R2>
	MOVAB	NM_GPAGE,R2
	BSBW	PAGELOG
	PUSHAB	PBITS
	CALLS	#1,CBSTAT
	BLBC	R0,9$
	PUSHL	8(AP)
	PUSHL	4(AP)
	CALLS	#2,G^LIB$GET_VM_PAGE
	CALLS	#0,USTATUS
9$:	RET

	.ENTRY	FPAGE,^M<R2>
	MOVAB	NM_FPAGE,R2
	BSBW	PAGELOG
	PUSHAB	PBITS
	CALLS	#1,CBSTAT
	BLBC	R0,9$
	PUSHL	8(AP)
	PUSHL	4(AP)
	CALLS	#2,G^LIB$FREE_VM_PAGE
	CALLS	#0,USTATUS
9$:	RET

; PAGELOG: the page routine's line, R2 its name, AP its arguments.
PAGELOG:	MOVZBL	(AP),T1
	CLRL	T2
	TSTL	4(AP)
	BEQL	1$
	MOVL	@4(AP),T2
1$:	$FAO_S	CTRSTR=GPCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=R2,P2=T1,P3=T2
	CALLS	#0,EMIT
	RSB

; STATREAD: LIB$STAT_VM's six figures (codes 1 to 3, 5 to 7) into SV;
; R0 the last call's status. STATSNAP keeps them in SN, and STATDIFF
; puts what changed since in SD.
	.ENTRY	STATREAD,^M<R2>
	CLRL	R2
1$:	MOVL	STATCODES[R2],STATK
	PUSHAL	SV[R2]
	PUSHAL	STATK
	CALLS	#2,G^LIB$STAT_VM
	AOBLSS	#6,R2,1$
	RET

	.ENTRY	STATSNAP,^M<R2,R3,R4,R5>
	CALLS	#0,STATREAD
	MOVC3	#24,SV,SN
	RET

	.ENTRY	STATDIFF,^M<R2>
	CALLS	#0,STATREAD
	CLRL	R2
1$:	SUBL3	SN[R2],SV[R2],SD[R2]
	AOBLSS	#6,R2,1$
	RET

; SHOWR0 name, r0: the case's line.
	.ENTRY	SHOWR0,^M<>
	TSTL	SIGCOND
	BNEQ	1$
	$FAO_S	CTRSTR=R0CTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP),P2=8(AP)
	BRB	2$
1$:	$FAO_S	CTRSTR=SIGCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP),P2=8(AP),-
		P3=SIGCOND,P4=SIGARG1,P5=SIGARG2
2$:	CALLS	#0,EMIT
	RET

; SHOWMEM name, address, count, control: count longwords in hex, after
; the name as control (MEMCTL or VMEMCTL) shows it. SHOWAT is the same
; under HANDLER, for an address that may not be readable.
	.ENTRY	SHOWAT,^M<R2,R3,R4>
	MOVAB	HANDLER,(FP)
	BRB	SHOWLW
	.ENTRY	SHOWMEM,^M<R2,R3,R4>
SHOWLW:	MOVL	8(AP),R2
	MOVL	12(AP),R3
	$FAO_S	CTRSTR=@16(AP),OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP)
	MOVZWL	LINLEN,R4
1$:	TSTL	R3
	BEQL	2$
	MOVAB	LINE[R4],PARTDSC+4
	$FAO_S	CTRSTR=LWCTL,OUTBUF=PARTDSC,P1=(R2)+
	ADDL2	#9,R4
	DECL	R3
	BRB	1$
2$:	MOVW	R4,LINLEN
	CALLS	#0,EMIT
	RET

; SHOWREL name, value, base: the value less the base, or "untouched".
	.ENTRY	SHOWREL,^M<>
	CMPL	8(AP),#^X55555555
	BEQL	1$
	SUBL3	12(AP),8(AP),T1
	$FAO_S	CTRSTR=RELCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP),P2=T1
	BRB	2$
1$:	$FAO_S	CTRSTR=UNTCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP)
2$:	CALLS	#0,EMIT
	RET

; SHOWPGO name, value: the value's offset in its page, or "untouched".
	.ENTRY	SHOWPGO,^M<>
	CMPL	8(AP),#^X55555555
	BEQL	1$
	BICL3	#^XFFFFFE00,8(AP),T1
	$FAO_S	CTRSTR=RELCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP),P2=T1
	BRB	2$
1$:	$FAO_S	CTRSTR=UNTCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP)
2$:	CALLS	#0,EMIT
	RET

; SHOWSET name, value: "set", or "untouched" for ^X55555555.
	.ENTRY	SHOWSET,^M<>
	CMPL	8(AP),#^X55555555
	BEQL	1$
	$FAO_S	CTRSTR=SETCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP)
	BRB	2$
1$:	$FAO_S	CTRSTR=UNTCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP)
2$:	CALLS	#0,EMIT
	RET

; SHOWFILL name, address, count, fill: a character for each of count
; longwords at the address, F where it holds the fill, "." where it
; doesn't; "untouched" for an address of ^X55555555. Under HANDLER, so
; a page that can't be read ends only this line.
	.ENTRY	SHOWFILL,^M<R2,R3,R4>
	MOVAB	HANDLER,(FP)
	MOVL	8(AP),R2
	CMPL	R2,#^X55555555
	BNEQ	1$
	$FAO_S	CTRSTR=UNTCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP)
	BRB	4$
1$:	MOVL	12(AP),R3
	MOVAB	FILLMAP,R4
2$:	MOVB	#^A"F",(R4)
	CMPL	(R2)+,16(AP)
	BEQL	3$
	MOVB	#^A".",(R4)
3$:	INCL	R4
	SOBGTR	R3,2$
	$FAO_S	CTRSTR=FILLCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP),P2=12(AP),P3=#FILLMAP
4$:	CALLS	#0,EMIT
	RET

; SHOWACT: the action routine's record.
	.ENTRY	SHOWACT,^M<>
	$FAO_S	CTRSTR=ACTSCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=ACTN,P2=ACTARGC,P3=ACTARG,P4=ACTDSC
	CALLS	#0,EMIT
	RET

; 1: STAT at start
	.ENTRY	C1,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	CALLS	#0,STATREAD
	PUSHL	R0
	MOVL	(SP)+,R0
	RET

; 2: FIND at start
	.ENTRY	C2,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	CALLS	#0,FINDALL
	PUSHL	R0
	MOVL	(SP)+,R0
	RET

; 3: FIND the first two
	.ENTRY	C3,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	PUSHAB	Z_DEFAULT
	PUSHAB	C3_C
	CALLS	#2,G^LIB$FIND_VM_ZONE
	PUSHL	R0
	PUSHAL	Z_STRING
	PUSHAL	C3_C
	CALLS	#2,G^LIB$FIND_VM_ZONE
	MOVL	R0,C3_S
	MOVL	(SP)+,R0
	RET

; 4: SVZ zone 0 level 1
	.ENTRY	C4,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	PUSHL	#^X12345678
	PUSHAB	ACTION
	PUSHAB	C4_L
	PUSHAB	ZERO
	CALLS	#4,G^LIB$SHOW_VM_ZONE
	PUSHL	R0
	MOVL	(SP)+,R0
	RET

; 5: SVZ default by ID level 1
	.ENTRY	C5,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	PUSHL	#^X12345678
	PUSHAB	ACTION
	PUSHAB	C5_L
	PUSHAB	Z_DEFAULT
	CALLS	#4,G^LIB$SHOW_VM_ZONE
	PUSHL	R0
	MOVL	(SP)+,R0
	RET

; 6: SVZ string zone level 1
	.ENTRY	C6,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	PUSHL	#^X12345678
	PUSHAB	ACTION
	PUSHAB	C6_L
	PUSHAB	Z_STRING
	CALLS	#4,G^LIB$SHOW_VM_ZONE
	PUSHL	R0
	MOVL	(SP)+,R0
	RET

; 7: GP 1
	.ENTRY	C7,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	CALLS	#0,STATSNAP
	MOVL	#^X55555555,P_1
	PUSHAB	P_1
	PUSHAB	C7_N
	CALLS	#2,G^LIB$GET_VM_PAGE
	PUSHL	R0
	CALLS	#0,STATDIFF
	MOVL	(SP)+,R0
	RET

; 8: GP 1 second
	.ENTRY	C8,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	MOVL	#^X55555555,P_2
	PUSHAB	P_2
	PUSHAB	C8_N
	CALLS	#2,G^LIB$GET_VM_PAGE
	PUSHL	R0
	MOVL	(SP)+,R0
	RET

; 9: GP 1 third
	.ENTRY	C9,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	MOVL	#^X55555555,P_3
	PUSHAB	P_3
	PUSHAB	C9_N
	CALLS	#2,G^LIB$GET_VM_PAGE
	PUSHL	R0
	MOVL	(SP)+,R0
	RET

; 10: GP 4
	.ENTRY	C10,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	MOVL	#^X55555555,P_4
	PUSHAB	P_4
	PUSHAB	C10_N
	CALLS	#2,G^LIB$GET_VM_PAGE
	PUSHL	R0
	MOVL	(SP)+,R0
	RET

; 11: FP the second
	.ENTRY	C11,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	CALLS	#0,STATSNAP
	PUSHAB	P_2
	PUSHAB	C11_N
	CALLS	#2,G^LIB$FREE_VM_PAGE
	PUSHL	R0
	CALLS	#0,STATDIFF
	MOVL	(SP)+,R0
	RET

; 12: GP 1 after a free
	.ENTRY	C12,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	MOVL	#^X55555555,P_5
	PUSHAB	P_5
	PUSHAB	C12_N
	CALLS	#2,G^LIB$GET_VM_PAGE
	PUSHL	R0
	MOVL	(SP)+,R0
	RET

; 13: FP upper half of 4
	.ENTRY	C13,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	ADDL3	#1024,P_4,C13_A
	PUSHAB	C13_A
	PUSHAB	C13_N
	CALLS	#2,G^LIB$FREE_VM_PAGE
	PUSHL	R0
	MOVL	(SP)+,R0
	RET

; 14: FP lower half of 4
	.ENTRY	C14,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	PUSHAB	P_4
	PUSHAB	C14_N
	CALLS	#2,G^LIB$FREE_VM_PAGE
	PUSHL	R0
	MOVL	(SP)+,R0
	RET

; 15: GP 3 after the halves
	.ENTRY	C15,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	MOVL	#^X55555555,P_6
	PUSHAB	P_6
	PUSHAB	C15_N
	CALLS	#2,G^LIB$GET_VM_PAGE
	PUSHL	R0
	MOVL	(SP)+,R0
	RET

; 16: FP 3 across groups
	.ENTRY	C16,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	CALLS	#0,STATSNAP
	PUSHAB	P_1
	PUSHAB	C16_N
	CALLS	#2,G^LIB$FREE_VM_PAGE
	PUSHL	R0
	CALLS	#0,STATDIFF
	MOVL	(SP)+,R0
	RET

; 17: FP freed already
	.ENTRY	C17,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	CALLS	#0,STATSNAP
	PUSHAB	P_1
	PUSHAB	C17_N
	CALLS	#2,G^LIB$FREE_VM_PAGE
	PUSHL	R0
	CALLS	#0,STATDIFF
	MOVL	(SP)+,R0
	RET

; 18: FP unaligned
	.ENTRY	C18,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	ADDL3	#4,P_6,C18_A
	PUSHAB	C18_A
	PUSHAB	C18_N
	CALLS	#2,G^LIB$FREE_VM_PAGE
	PUSHL	R0
	MOVL	(SP)+,R0
	RET

; 19: FP inside a page
	.ENTRY	C19,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
