	CALLS	#2,L^DUMPF
	RET
	.ENTRY	S7,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
	PUSHL	#0
	PUSHAB	T25
	CALLS	#2,L^DUMPF
	RET
	.ENTRY	S8,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
