	.TITLE	FOR81D - round 2 of Phase 81's probe, RMS
; Written by testdata/for81/gen.go.
	$SSDEF
	$FABDEF
	$RABDEF
	$NAMDEF
	$XABDEF
	$XABFHCDEF
	.PSECT	D,NOEXE,WRT,LONG
VAL:	.LONG	0,0
UVAL:	.LONG	0
ASVL:	.LONG	-1
UOMODE:	.LONG	0
LN:	.LONG	0
LD:	.WORD	0
	.BYTE	14,1
	.ADDRESS BF
BD:	.WORD	400
	.BYTE	14,1
	.ADDRESS BF
BF:	.BLKB	400
RKEY:	.LONG	0
IQL:	.LONG	0,0
IQT:	.BLKB	64
IQD:	.WORD	64
	.BYTE	14,1
	.ADDRESS IQT
SHORTD:	.WORD	4
	.BYTE	14,1
	.ADDRESS IQT
BIGD:	.WORD	0
	.BYTE	14,1
	.ADDRESS BIGB
RDD:	.WORD	0
	.BYTE	14,1
	.ADDRESS RDB
FMTA:	.ASCIZ	~(A)~
	.ALIGN	LONG
BIGB:	.BLKB	33000
RDB:	.BLKB	33000
BLK:	.BLKB	512
HX:	.ASCII	/0123456789ABCDEF/
HL:	.BLKB	100
HLD:	.WORD	0
	.BYTE	14,1
	.ADDRESS HL
MSHOW:	.ASCID	~=!AS r=!XL~
MCOND:	.ASCID	~=c !XL n=!UL a=!XL !XL~
MUNW:	.ASCID	~=u~
MFAB:	.ASCID	~ fab fac=!XB shr=!XB org=!XB rfm=!XB rat=!XB mrs=!UW mrn=!UL alq=!UL deq=!UW fop=!XL bks=!UB bls=!UW fsz=!UB~
MRAB:	.ASCID	~ rab rop=!XL rac=!UB mbc=!UB mbf=!SB rsz=!UW usz=!UW ksz=!UB~
MNORAB:	.ASCID	~ no rab: !XL~
MASV:	.ASCID	~ asv=!XL~
MIQL:	.ASCID	~ q!UL r=!XL v=!XL~
MIQT:	.ASCID	~ q!UL r=!XL |!AD|~
MST:	.ASCID	~ stat !AS: r=!XL~
MST2:	.ASCID	~ stat !AS: org=!XB rfm=!XB rat=!XB mrs=!UW mrn=!UL alq=!UL deq=!UW bks=!UB fop=!XL lrl=!UW hbk=!UL ebk=!UL ffb=!UW~
MRC:	.ASCID	~ rec !UL: r=!XL n=!UW~
MVB:	.ASCID	~ vbn !UL~
MGET:	.ASCID	~ got n=!UW rfa=!UL,!UW stv=!XL bkt=!UL~
MPUT:	.ASCID	~ rfa=!UL,!UW stv=!XL bkt=!UL~
MFST:	.ASCID	~ fab now org=!XB rfm=!XB rat=!XB mrs=!UW mrn=!UL alq=!UL deq=!UW bks=!UB fop=!XL stv=!XL~
MNAM:	.ASCID	~ nam |!AD| fnb=!XL~
MUOA:	.ASCID	~ uo n=!UL unit=!SL fab?=!UL rab?=!UL~
MUOF:	.ASCID	~ uo fna=|!AD| dna=|!AD| nam=!UL~
MUOX:	.ASCID	~ uo xab cod=!UB bln=!UB~
MUOS:	.ASCID	~=uo-rms r=!XL stv=!XL~
	.ALIGN	LONG
FB2:	$FAB	FAC=<GET>,SHR=<GET,PUT,UPD,DEL>,XAB=FH2
	.ALIGN	LONG
RB2:	$RAB	FAB=FB2
	.ALIGN	LONG
FH2:	$XABFHC
	.ALIGN	LONG
FB3:	$FAB	FAC=<BIO,GET>,SHR=<GET>
	.ALIGN	LONG
RB3:	$RAB	FAB=FB3,ROP=<BIO>
	.ALIGN	LONG
FB:	$FAB	FAC=<GET,PUT,UPD,DEL>,NAM=NB
	.ALIGN	LONG
RB:	$RAB	FAB=FB,KBF=RKEY,KSZ=4
	.ALIGN	LONG
NB:	$NAM	RSA=NBR,RSS=128,ESA=NBE,ESS=128
NBR:	.BLKB	128
NBE:	.BLKB	128
	.ALIGN	LONG
FB4:	$FAB	FAC=<GET,PUT,UPD,DEL>,SHR=<GET,PUT,UPD,DEL>,FNM=<L1.DAT>
	.ALIGN	LONG
RB4:	$RAB	FAB=FB4,KBF=RKEY,KSZ=4,RAC=KEY
	.ALIGN	LONG
FBT:	.BLKB	FAB$C_BLN
RBT:	.BLKB	RAB$C_BLN
	.ALIGN	LONG
T0:	.ASCID	~##### deleted cells, left deleted~
T1:	.ASCID	~#0 delete the middle, FIX~
T2:	.ASCID	~D1.DAT~
T3:	.ASCID	~$CREATE~
T4:	.ASCID	~$CONNECT~
T5:	.ASCID	~$PUT~
T6:	.ASCID	~$GET~
T7:	.ASCID	~$DELETE~
T8:	.ASCID	~$CLOSE~
T9:	.ASCID	~#1 delete the last, FIX~
T10:	.ASCID	~D2.DAT~
T11:	.ASCID	~#2 delete them all, VAR, and read~
T12:	.ASCID	~D3.DAT~
T13:	.ASCID	~$REWIND~
T14:	.ASCID	~#3 put into a deleted cell, a shorter VAR, an update to shorter and longer~
T15:	.ASCID	~D4.DAT~
T16:	.ASCID	~$UPDATE~
T17:	.ASCID	~##### how a relative file grows~
T18:	.ASCID	~#4 a block at a time~
T19:	.ASCID	~E1.DAT~
T20:	.ASCID	~#5 ALQ 2~
T21:	.ASCID	~E2.DAT~
T22:	.ASCID	~#6 ALQ 1~
T23:	.ASCID	~E3.DAT~
T24:	.ASCID	~#7 ALQ 20~
T25:	.ASCID	~E4.DAT~
T26:	.ASCID	~#8 DEQ 50~
T27:	.ASCID	~E5.DAT~
T28:	.ASCID	~#9 BKS 4~
T29:	.ASCID	~E6.DAT~
T30:	.ASCID	~#10 BKS 32~
T31:	.ASCID	~E7.DAT~
T32:	.ASCID	~#11 BKS 63~
T33:	.ASCID	~E8.DAT~
T34:	.ASCID	~#12 BKS 64~
T35:	.ASCID	~E9.DAT~
T36:	.ASCID	~#13 MRS 16000 BKS 0~
T37:	.ASCID	~E10.DAT~
T38:	.ASCID	~#14 MRS 32255~
T39:	.ASCID	~E11.DAT~
T40:	.ASCID	~#15 MRS 32256~
T41:	.ASCID	~E12.DAT~
T42:	.ASCID	~#16 MRS 16000 BKS 1~
T43:	.ASCID	~E13.DAT~
T44:	.ASCID	~#17 MRS 510: the bucket size chosen~
T45:	.ASCID	~B510.DAT~
T46:	.ASCID	~#18 MRS 511: the bucket size chosen~
T47:	.ASCID	~B511.DAT~
T48:	.ASCID	~#19 MRS 512: the bucket size chosen~
T49:	.ASCID	~B512.DAT~
T50:	.ASCID	~#20 MRS 1022: the bucket size chosen~
T51:	.ASCID	~B1022.DAT~
T52:	.ASCID	~#21 MRS 1023: the bucket size chosen~
T53:	.ASCID	~B1023.DAT~
T54:	.ASCID	~#22 MRS 1024: the bucket size chosen~
T55:	.ASCID	~B1024.DAT~
T56:	.ASCID	~#23 VAR MRS 510, 509: the bucket size chosen~
T57:	.ASCID	~B1.DAT~
T58:	.ASCID	~B2.DAT~
T59:	.ASCID	~##### two streams on a relative file~
T60:	.ASCID	~#24 a locked record~
T61:	.ASCID	~L1.DAT~
T62:	.ASCID	~$OPEN~
T63:	.ASCID	~$RELEASE~
T64:	.ASCID	~$FREE~
T65:	.ASCID	~##### the attributes $OPEN gives back, fresh each time~
T66:	.ASCID	~#25 $OPEN D1.DAT~
T67:	.ASCID	~#26 $OPEN E5.DAT~
T68:	.ASCID	~#27 $OPEN E7.DAT~
	.PSECT	C,EXE,NOWRT,LONG
; OUT(control, values...) writes a line.
	.ENTRY	OUT,^M<R2,R3,R4,R5>
	$FAOL_S	CTRSTR=@4(AP),OUTLEN=LD,OUTBUF=BD,PRMLST=8(AP)
	PUSHAB	LD
	CALLS	#1,G^LIB$PUT_OUTPUT
	RET
; SHOW(what, r0)
	.ENTRY	SHOW,^M<>
	PUSHL	8(AP)
	PUSHL	4(AP)
	PUSHAB	MSHOW
	CALLS	#3,OUT
	RET
; HND prints a condition, continues below severe, and unwinds from a severe one.
HND:	.WORD	^M<R2>
	MOVL	4(AP),R2
	CMPL	4(R2),#SS$_UNWIND
	BEQL	50$
	PUSHL	12(R2)
	PUSHL	8(R2)
	PUSHL	(R2)
	PUSHL	4(R2)
	PUSHAB	MCOND
	CALLS	#5,OUT
	BICL3	#^XFFFFFFF8,4(R2),R0
	CMPL	R0,#4
	BEQL	40$
	MOVL	#SS$_CONTINUE,R0
	RET
40$:	PUSHAB	MUNW
	CALLS	#1,G^LIB$PUT_OUTPUT
	$UNWIND_S
50$:	MOVL	#SS$_CONTINUE,R0
	RET
; HEXS(address, count) writes bytes in hex, 32 to a line, with an offset.
	.ENTRY	HEXS,^M<R2,R3,R4,R5,R6,R7>
	MOVL	4(AP),R2
	MOVL	8(AP),R3
	CLRL	R7
10$:	TSTL	R3
	BGTR	11$
	BRW	90$
11$:	MOVAB	HL,R4
	MOVB	#^A/ /,(R4)+
	MOVB	#^A/ /,(R4)+
	ASHL	#-8,R7,R0
	EXTZV	#4,#4,R0,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#0,#4,R0,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#4,#4,R7,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#0,#4,R7,R1
	MOVB	HX[R1],(R4)+
	MOVB	#^A/:/,(R4)+
	MOVB	#^A/ /,(R4)+
	MOVL	#32,R5
20$:	TSTL	R3
	BLEQ	30$
	MOVZBL	(R2)+,R6
	EXTZV	#4,#4,R6,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#0,#4,R6,R1
	MOVB	HX[R1],(R4)+
	DECL	R3
	INCL	R7
	SOBGTR	R5,20$
30$:	MOVAB	HL,R0
	SUBL3	R0,R4,R0
	MOVW	R0,HLD
	PUSHAB	HLD
	CALLS	#1,G^LIB$PUT_OUTPUT
	BRW	10$
90$:	RET
; DUMPF(name, flags): a file's attributes by $OPEN and XABFHC; flag 1, its records
; in hex (the first 32 bytes of each, the first 40 records); flag 2, its blocks in
; hex, by block I/O (all-zero lines left out, the first 16 blocks).
	.ENTRY	DUMPF,^M<R2,R3,R4,R5,R6,R7>
	MOVL	4(AP),R2
	CLRL	FB2+FAB$L_MRN
	CLRW	FB2+FAB$W_DEQ
	MOVB	(R2),FB2+FAB$B_FNS
	MOVL	4(R2),FB2+FAB$L_FNA
	$OPEN	FAB=FB2
	BLBS	R0,10$
	PUSHL	R0
	PUSHL	R2
	PUSHAB	MST
	CALLS	#3,OUT
	RET
10$:	MOVZWL	FH2+XAB$W_FFB,-(SP)
	PUSHL	FH2+XAB$L_EBK
	PUSHL	FH2+XAB$L_HBK
	MOVZWL	FH2+XAB$W_LRL,-(SP)
	PUSHL	FB2+FAB$L_FOP
	MOVZBL	FB2+FAB$B_BKS,-(SP)
	MOVZWL	FB2+FAB$W_DEQ,-(SP)
	PUSHL	FB2+FAB$L_ALQ
	PUSHL	FB2+FAB$L_MRN
	MOVZWL	FB2+FAB$W_MRS,-(SP)
	MOVZBL	FB2+FAB$B_RAT,-(SP)
	MOVZBL	FB2+FAB$B_RFM,-(SP)
	MOVZBL	FB2+FAB$B_ORG,-(SP)
	PUSHL	R2
	PUSHAB	MST2
	CALLS	#15,OUT
	BLBS	8(AP),20$
	BRW	50$
20$:	$CONNECT RAB=RB2
	MOVL	#1,R6
30$:	MOVL	#33000,R0
	MOVW	R0,RB2+RAB$W_USZ
	MOVAB	RDB,RB2+RAB$L_UBF
	$GET	RAB=RB2
	MOVL	R0,R7
	MOVZWL	RB2+RAB$W_RSZ,-(SP)
	PUSHL	R7
	PUSHL	R6
	PUSHAB	MRC
	CALLS	#4,OUT
	BLBC	R7,40$
	MOVZWL	RB2+RAB$W_RSZ,R3
	CMPL	R3,#32
	BLEQ	35$
	MOVL	#32,R3
35$:	PUSHL	R3
	PUSHAB	RDB
	CALLS	#2,HEXS
	AOBLEQ	#40,R6,30$
40$:
50$:	$CLOSE	FAB=FB2
	BBC	#1,8(AP),59$
	BRW	60$
59$:	RET
60$:	MOVB	(R2),FB3+FAB$B_FNS
	MOVL	4(R2),FB3+FAB$L_FNA
	$OPEN	FAB=FB3
	BLBS	R0,62$
	PUSHL	R0
	PUSHL	R2
	PUSHAB	MST
	CALLS	#3,OUT
	RET
62$:	$CONNECT RAB=RB3
	MOVL	#1,R6
70$:	MOVL	R6,RB3+RAB$L_BKT
	MOVW	#512,RB3+RAB$W_USZ
	MOVAB	BLK,RB3+RAB$L_UBF
	$READ	RAB=RB3
	BLBC	R0,80$
	PUSHL	R6
	PUSHAB	MVB
	CALLS	#2,OUT
	CLRL	R3
72$:	MOVAB	BLK[R3],R4
	MOVL	#8,R5
74$:	TSTL	(R4)+
	BNEQ	76$
	SOBGTR	R5,74$
	BRB	78$
76$:	PUSHL	#32
	PUSHAB	BLK[R3]
	PUSHL	R3
	CALLS	#3,HEXO
78$:	ACBL	#511,#32,R3,72$
	AOBLEQ	#16,R6,70$
80$:	$CLOSE	FAB=FB3
	RET
; HEXO(offset, address, count): one line of block dump, with the block's offset.
	.ENTRY	HEXO,^M<R2,R3,R4,R5,R6,R7>
	MOVL	8(AP),R2
	MOVL	12(AP),R3
	MOVL	4(AP),R7
	MOVAB	HL,R4
	MOVB	#^A/ /,(R4)+
	MOVB	#^A/ /,(R4)+
	EXTZV	#8,#4,R7,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#4,#4,R7,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#0,#4,R7,R1
	MOVB	HX[R1],(R4)+
	MOVB	#^A/:/,(R4)+
	MOVB	#^A/ /,(R4)+
20$:	MOVZBL	(R2)+,R6
	EXTZV	#4,#4,R6,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#0,#4,R6,R1
	MOVB	HX[R1],(R4)+
	SOBGTR	R3,20$
	MOVAB	HL,R0
	SUBL3	R0,R4,R0
	MOVW	R0,HLD
	PUSHAB	HLD
	CALLS	#1,G^LIB$PUT_OUTPUT
	RET
; RDFILL fills the read buffer with 55s.
	.ENTRY	RDFILL,^M<R2,R3,R4,R5>
	MOVC5	#0,RDB,#^X55,#64,RDB
	RET
	.ENTRY	RRESET,^M<R2,R3,R4,R5>
	MOVC3	#FAB$C_BLN,FBT,FB
	MOVC3	#RAB$C_BLN,RBT,RB
	RET
	.ENTRY	CLEAN,^M<>
	RET
; SHOWF is what the FAB holds after a $CREATE or $OPEN.
	.ENTRY	SHOWF,^M<>
	PUSHL	FB+FAB$L_STV
	PUSHL	FB+FAB$L_FOP
	MOVZBL	FB+FAB$B_BKS,-(SP)
	MOVZWL	FB+FAB$W_DEQ,-(SP)
	PUSHL	FB+FAB$L_ALQ
	PUSHL	FB+FAB$L_MRN
	MOVZWL	FB+FAB$W_MRS,-(SP)
	MOVZBL	FB+FAB$B_RAT,-(SP)
	MOVZBL	FB+FAB$B_RFM,-(SP)
	MOVZBL	FB+FAB$B_ORG,-(SP)
	PUSHAB	MFST
	CALLS	#11,OUT
	RET
	.ENTRY	SHOWN,^M<>
	PUSHL	NB+NAM$L_FNB
	PUSHAB	NBR
	MOVZBL	NB+NAM$B_RSL,-(SP)
	PUSHAB	MNAM
	CALLS	#4,OUT
	RET
; SHOWR is what the RAB holds after a $PUT or the like, SHOWG after a $GET, with
; the record in hex.
	.ENTRY	SHOWR,^M<>
	PUSHL	RB+RAB$L_BKT
	PUSHL	RB+RAB$L_STV
	MOVZWL	RB+RAB$W_RFA4,-(SP)
	PUSHL	RB+RAB$L_RFA0
	PUSHAB	MPUT
	CALLS	#5,OUT
	RET
	.ENTRY	SHOWG,^M<R2>
	PUSHL	RB+RAB$L_BKT
	PUSHL	RB+RAB$L_STV
	MOVZWL	RB+RAB$W_RFA4,-(SP)
	PUSHL	RB+RAB$L_RFA0
	MOVZWL	RB+RAB$W_RSZ,-(SP)
	PUSHAB	MGET
	CALLS	#6,OUT
	MOVZWL	RB+RAB$W_RSZ,R2
	CMPL	R2,#32
	BLEQ	10$
	MOVL	#32,R2
10$:	PUSHL	R2
	PUSHAB	RDB
	CALLS	#2,HEXS
	RET
	.ENTRY	S0,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
	PUSHL	#1
	PUSHAB	T2
	CALLS	#2,L^DUMPF
	RET
	.ENTRY	S1,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
	PUSHL	#1
	PUSHAB	T10
	CALLS	#2,L^DUMPF
	RET
	.ENTRY	S2,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
	PUSHL	#1
	PUSHAB	T12
	CALLS	#2,L^DUMPF
	RET
	.ENTRY	S3,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
