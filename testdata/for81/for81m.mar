	.TITLE	FOR81M - Phase 113's probe round 2: the associated variable after FIND
; Written by testdata/for81/gen.go.
	$SSDEF
	$FABDEF
	$RABDEF
	$NAMDEF
	$XABDEF
	$XABFHCDEF
	.PSECT	D,NOEXE,WRT,LONG
VAL:	.LONG	0,0
UVAL:	.LONG	0
ASVL:	.LONG	-1
UOMODE:	.LONG	0
LN:	.LONG	0
LD:	.WORD	0
	.BYTE	14,1
	.ADDRESS BF
BD:	.WORD	400
	.BYTE	14,1
	.ADDRESS BF
BF:	.BLKB	400
RKEY:	.LONG	0
IQL:	.LONG	0,0
IQT:	.BLKB	64
IQD:	.WORD	64
	.BYTE	14,1
	.ADDRESS IQT
SHORTD:	.WORD	4
	.BYTE	14,1
	.ADDRESS IQT
BIGD:	.WORD	0
	.BYTE	14,1
	.ADDRESS BIGB
RDD:	.WORD	0
	.BYTE	14,1
	.ADDRESS RDB
FMTA:	.ASCIZ	~(A)~
	.ALIGN	LONG
BIGB:	.BLKB	33000
RDB:	.BLKB	33000
BLK:	.BLKB	512
HX:	.ASCII	/0123456789ABCDEF/
HL:	.BLKB	100
HLD:	.WORD	0
	.BYTE	14,1
	.ADDRESS HL
MSHOW:	.ASCID	~=!AS r=!XL~
MCOND:	.ASCID	~=c !XL n=!UL a=!XL !XL~
MUNW:	.ASCID	~=u~
MFAB:	.ASCID	~ fab fac=!XB shr=!XB org=!XB rfm=!XB rat=!XB mrs=!UW mrn=!UL alq=!UL deq=!UW fop=!XL bks=!UB bls=!UW fsz=!UB~
MRAB:	.ASCID	~ rab rop=!XL rac=!UB mbc=!UB mbf=!SB rsz=!UW usz=!UW ksz=!UB~
MNORAB:	.ASCID	~ no rab: !XL~
MASV:	.ASCID	~ asv=!XL~
MIQL:	.ASCID	~ q!UL r=!XL v=!XL~
MIQT:	.ASCID	~ q!UL r=!XL |!AD|~
MST:	.ASCID	~ stat !AS: r=!XL~
MST2:	.ASCID	~ stat !AS: org=!XB rfm=!XB rat=!XB mrs=!UW mrn=!UL alq=!UL deq=!UW bks=!UB fop=!XL lrl=!UW hbk=!UL ebk=!UL ffb=!UW~
MRC:	.ASCID	~ rec !UL: r=!XL n=!UW~
MVB:	.ASCID	~ vbn !UL~
MGET:	.ASCID	~ got n=!UW rfa=!UL,!UW stv=!XL bkt=!UL~
MPUT:	.ASCID	~ rfa=!UL,!UW stv=!XL bkt=!UL~
MFST:	.ASCID	~ fab now org=!XB rfm=!XB rat=!XB mrs=!UW mrn=!UL alq=!UL deq=!UW bks=!UB fop=!XL stv=!XL~
MNAM:	.ASCID	~ nam |!AD| fnb=!XL~
MUOA:	.ASCID	~ uo n=!UL unit=!SL fab?=!UL rab?=!UL~
MUOF:	.ASCID	~ uo fna=|!AD| dna=|!AD| nam=!UL~
MUOX:	.ASCID	~ uo xab cod=!UB bln=!UB~
MUOS:	.ASCID	~=uo-rms r=!XL stv=!XL~
	.ALIGN	LONG
FB2:	$FAB	FAC=<GET>,SHR=<GET,PUT,UPD,DEL>,XAB=FH2
	.ALIGN	LONG
RB2:	$RAB	FAB=FB2
	.ALIGN	LONG
FH2:	$XABFHC
	.ALIGN	LONG
FB3:	$FAB	FAC=<BIO,GET>,SHR=<GET>
	.ALIGN	LONG
RB3:	$RAB	FAB=FB3,ROP=<BIO>
	.ALIGN	LONG
FB:	$FAB	FAC=<GET,PUT,UPD,DEL>,NAM=NB
	.ALIGN	LONG
RB:	$RAB	FAB=FB,KBF=RKEY,KSZ=4
	.ALIGN	LONG
NB:	$NAM	RSA=NBR,RSS=128,ESA=NBE,ESS=128
NBR:	.BLKB	128
NBE:	.BLKB	128
	.ALIGN	LONG
UNWN:	.LONG	0
MRUN:	.ASCID	~##### the handler looped: the program ends here~
	.ALIGN	LONG
FB4:	$FAB	FAC=<GET,PUT,UPD,DEL>,SHR=<GET,PUT,UPD,DEL>,FNM=<L1.DAT>
	.ALIGN	LONG
RB4:	$RAB	FAB=FB4,KBF=RKEY,KSZ=4,RAC=KEY
	.ALIGN	LONG
FBT:	.BLKB	FAB$C_BLN
RBT:	.BLKB	RAB$C_BLN
	.ALIGN	LONG
T0:	.ASCID	~##### setup~
T1:	.ASCID	~#0 make the relative files, eight records each, record n's text RECn~
T2:	.ASCID	~FD1.DAT~
T3:	.ASCID	~OPEN~
T4:	.ASCID	~REC1~
T5:	.ASCID	~IO_END~
T6:	.ASCID	~REC2~
T7:	.ASCID	~REC3~
T8:	.ASCID	~REC4~
T9:	.ASCID	~REC5~
T10:	.ASCID	~REC6~
T11:	.ASCID	~REC7~
T12:	.ASCID	~REC8~
T13:	.ASCID	~CLOSE~
T14:	.ASCID	~FD2.DAT~
T15:	.ASCID	~FD3.DAT~
T16:	.ASCID	~FD4.DAT~
T17:	.ASCID	~FD5.DAT~
T18:	.ASCID	~FD6.DAT~
T19:	.ASCID	~FD7.DAT~
T20:	.ASCID	~FD8.DAT~
T21:	.ASCID	~##### A: the associated variable (asv) and NEXTREC (nr) after FIND, then DELETE by number~
T22:	.ASCID	~#1 FIND 3, then DELETE 2~
T23:	.ASCID	~FIND~
T24:	.ASCID	~DELETE_D~
T25:	.ASCID	~#2 FIND 3, then DELETE 3~
T26:	.ASCID	~#3 FIND 3, then DELETE 4~
T27:	.ASCID	~#4 READ 2, FIND 5, then DELETE 5~
T28:	.ASCID	~#5 FIND 3, then READ 3~
T29:	.ASCID	~#6 WRITE 3, then DELETE 3~
T30:	.ASCID	~NEW~
T31:	.ASCID	~#7 READ 3, FIND 5, then DELETE 3~
T32:	.ASCID	~#8 READ 3, READ 4, then DELETE 3~
	.PSECT	C,EXE,NOWRT,LONG
; OUT(control, values...) writes a line.
	.ENTRY	OUT,^M<R2,R3,R4,R5>
	$FAOL_S	CTRSTR=@4(AP),OUTLEN=LD,OUTBUF=BD,PRMLST=8(AP)
	PUSHAB	LD
	CALLS	#1,G^LIB$PUT_OUTPUT
	RET
; SHOW(what, r0)
	.ENTRY	SHOW,^M<>
	PUSHL	8(AP)
	PUSHL	4(AP)
	PUSHAB	MSHOW
	CALLS	#3,OUT
	RET
; HND prints a condition, continues below severe, and unwinds from a severe one.
HND:	.WORD	^M<R2>
	MOVL	4(AP),R2
	CMPL	4(R2),#SS$_UNWIND
	BEQL	50$
	PUSHL	12(R2)
	PUSHL	8(R2)
	PUSHL	(R2)
	PUSHL	4(R2)
	PUSHAB	MCOND
	CALLS	#5,OUT
	BICL3	#^XFFFFFFF8,4(R2),R0
	CMPL	R0,#4
	BEQL	40$
	MOVL	#SS$_CONTINUE,R0
	RET
40$:	PUSHAB	MUNW
	CALLS	#1,G^LIB$PUT_OUTPUT
	INCL	UNWN
	CMPL	UNWN,#200
	BLSS	41$
	PUSHAB	MRUN
	CALLS	#1,G^LIB$PUT_OUTPUT
	$EXIT_S	#1
41$:	$UNWIND_S
50$:	MOVL	#SS$_CONTINUE,R0
	RET
; HEXS(address, count) writes bytes in hex, 32 to a line, with an offset.
	.ENTRY	HEXS,^M<R2,R3,R4,R5,R6,R7>
	MOVL	4(AP),R2
	MOVL	8(AP),R3
	CLRL	R7
10$:	TSTL	R3
	BGTR	11$
	BRW	90$
11$:	MOVAB	HL,R4
	MOVB	#^A/ /,(R4)+
	MOVB	#^A/ /,(R4)+
	ASHL	#-8,R7,R0
	EXTZV	#4,#4,R0,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#0,#4,R0,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#4,#4,R7,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#0,#4,R7,R1
	MOVB	HX[R1],(R4)+
	MOVB	#^A/:/,(R4)+
	MOVB	#^A/ /,(R4)+
	MOVL	#32,R5
20$:	TSTL	R3
	BLEQ	30$
	MOVZBL	(R2)+,R6
	EXTZV	#4,#4,R6,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#0,#4,R6,R1
	MOVB	HX[R1],(R4)+
	DECL	R3
	INCL	R7
	SOBGTR	R5,20$
30$:	MOVAB	HL,R0
	SUBL3	R0,R4,R0
	MOVW	R0,HLD
	PUSHAB	HLD
	CALLS	#1,G^LIB$PUT_OUTPUT
	BRW	10$
90$:	RET
; DUMPF(name, flags): a file's attributes by $OPEN and XABFHC; flag 1, its records
; in hex (the first 32 bytes of each, the first 40 records); flag 2, its blocks in
; hex, by block I/O (all-zero lines left out, the first 16 blocks).
	.ENTRY	DUMPF,^M<R2,R3,R4,R5,R6,R7>
	MOVL	4(AP),R2
	CLRL	FB2+FAB$L_MRN
	CLRW	FB2+FAB$W_DEQ
	MOVB	(R2),FB2+FAB$B_FNS
	MOVL	4(R2),FB2+FAB$L_FNA
	$OPEN	FAB=FB2
	BLBS	R0,10$
	PUSHL	R0
	PUSHL	R2
	PUSHAB	MST
	CALLS	#3,OUT
	RET
10$:	MOVZWL	FH2+XAB$W_FFB,-(SP)
	PUSHL	FH2+XAB$L_EBK
	PUSHL	FH2+XAB$L_HBK
	MOVZWL	FH2+XAB$W_LRL,-(SP)
	PUSHL	FB2+FAB$L_FOP
	MOVZBL	FB2+FAB$B_BKS,-(SP)
	MOVZWL	FB2+FAB$W_DEQ,-(SP)
	PUSHL	FB2+FAB$L_ALQ
	PUSHL	FB2+FAB$L_MRN
	MOVZWL	FB2+FAB$W_MRS,-(SP)
	MOVZBL	FB2+FAB$B_RAT,-(SP)
	MOVZBL	FB2+FAB$B_RFM,-(SP)
	MOVZBL	FB2+FAB$B_ORG,-(SP)
	PUSHL	R2
	PUSHAB	MST2
	CALLS	#15,OUT
	BLBS	8(AP),20$
	BRW	50$
20$:	$CONNECT RAB=RB2
	MOVL	#1,R6
30$:	MOVL	#33000,R0
	MOVW	R0,RB2+RAB$W_USZ
	MOVAB	RDB,RB2+RAB$L_UBF
	$GET	RAB=RB2
	MOVL	R0,R7
	MOVZWL	RB2+RAB$W_RSZ,-(SP)
	PUSHL	R7
	PUSHL	R6
	PUSHAB	MRC
	CALLS	#4,OUT
	BLBC	R7,40$
	MOVZWL	RB2+RAB$W_RSZ,R3
	CMPL	R3,#32
	BLEQ	35$
	MOVL	#32,R3
35$:	PUSHL	R3
	PUSHAB	RDB
	CALLS	#2,HEXS
	AOBLEQ	#40,R6,30$
40$:
50$:	$CLOSE	FAB=FB2
	BBC	#1,8(AP),59$
	BRW	60$
59$:	RET
60$:	MOVB	(R2),FB3+FAB$B_FNS
	MOVL	4(R2),FB3+FAB$L_FNA
	$OPEN	FAB=FB3
	BLBS	R0,62$
	PUSHL	R0
	PUSHL	R2
	PUSHAB	MST
	CALLS	#3,OUT
	RET
62$:	$CONNECT RAB=RB3
	MOVL	#1,R6
70$:	MOVL	R6,RB3+RAB$L_BKT
	MOVW	#512,RB3+RAB$W_USZ
	MOVAB	BLK,RB3+RAB$L_UBF
	$READ	RAB=RB3
	BLBC	R0,80$
	PUSHL	R6
	PUSHAB	MVB
	CALLS	#2,OUT
	CLRL	R3
72$:	MOVAB	BLK[R3],R4
	MOVL	#8,R5
74$:	TSTL	(R4)+
	BNEQ	76$
	SOBGTR	R5,74$
	BRB	78$
76$:	PUSHL	#32
	PUSHAB	BLK[R3]
	PUSHL	R3
	CALLS	#3,HEXO
78$:	ACBL	#511,#32,R3,72$
	AOBLEQ	#16,R6,70$
80$:	$CLOSE	FAB=FB3
	RET
; HEXO(offset, address, count): one line of block dump, with the block's offset.
	.ENTRY	HEXO,^M<R2,R3,R4,R5,R6,R7>
	MOVL	8(AP),R2
	MOVL	12(AP),R3
	MOVL	4(AP),R7
	MOVAB	HL,R4
	MOVB	#^A/ /,(R4)+
	MOVB	#^A/ /,(R4)+
	EXTZV	#8,#4,R7,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#4,#4,R7,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#0,#4,R7,R1
	MOVB	HX[R1],(R4)+
	MOVB	#^A/:/,(R4)+
	MOVB	#^A/ /,(R4)+
20$:	MOVZBL	(R2)+,R6
	EXTZV	#4,#4,R6,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#0,#4,R6,R1
	MOVB	HX[R1],(R4)+
	SOBGTR	R3,20$
	MOVAB	HL,R0
	SUBL3	R0,R4,R0
	MOVW	R0,HLD
	PUSHAB	HLD
	CALLS	#1,G^LIB$PUT_OUTPUT
	RET
; RDFILL fills the read buffer with 55s.
	.ENTRY	RDFILL,^M<R2,R3,R4,R5>
	MOVC5	#0,RDB,#^X55,#64,RDB
	RET
; SHOWFR shows the FAB and RAB of UVAL's unit, through FOR$RAB.
	.ENTRY	SHOWFR,^M<R2,R3>
	PUSHAB	UVAL
	CALLS	#1,G^FOR$RAB
	MOVL	R0,R3
	BNEQ	10$
	PUSHL	R0
	PUSHAB	MNORAB
	CALLS	#2,OUT
	RET
10$:	MOVL	RAB$L_FAB(R3),R2
	MOVZBL	FAB$B_FSZ(R2),-(SP)
	MOVZWL	FAB$W_BLS(R2),-(SP)
	MOVZBL	FAB$B_BKS(R2),-(SP)
	PUSHL	FAB$L_FOP(R2)
	MOVZWL	FAB$W_DEQ(R2),-(SP)
	PUSHL	FAB$L_ALQ(R2)
	PUSHL	FAB$L_MRN(R2)
	MOVZWL	FAB$W_MRS(R2),-(SP)
	MOVZBL	FAB$B_RAT(R2),-(SP)
	MOVZBL	FAB$B_RFM(R2),-(SP)
	MOVZBL	FAB$B_ORG(R2),-(SP)
	MOVZBL	FAB$B_SHR(R2),-(SP)
	MOVZBL	FAB$B_FAC(R2),-(SP)
	PUSHAB	MFAB
	CALLS	#14,OUT
	CALLS	#0,SHOWR3
	RET
	.ENTRY	SHOWR3,^M<>
	MOVZBL	RAB$B_KSZ(R3),-(SP)
	MOVZWL	RAB$W_USZ(R3),-(SP)
	MOVZWL	RAB$W_RSZ(R3),-(SP)
	CVTBL	RAB$B_MBF(R3),-(SP)
	MOVZBL	RAB$B_MBC(R3),-(SP)
	MOVZBL	RAB$B_RAC(R3),-(SP)
	PUSHL	RAB$L_ROP(R3)
	PUSHAB	MRAB
	CALLS	#8,OUT
	RET
	.ENTRY	SHOWASV,^M<>
	PUSHL	ASVL
	PUSHAB	MASV
	CALLS	#2,OUT
	MNEGL	#1,ASVL
	RET
; INQ1(code, unit keyword or 0, file descriptor or 0): one question. 29 to 33, 41,
; and 42 are numbers and logicals; the others text.
	.ENTRY	INQ1,^M<R2,R3,R4,R5,R6,R7>
	MOVL	4(AP),R7
	MOVL	#^X12345678,IQL
	MOVC5	#0,IQT,#^A/*/,#64,IQT
	CASEL	R7,#29,#19
1$:	.WORD	20$-1$,20$-1$,20$-1$,20$-1$,20$-1$
	.WORD	30$-1$,30$-1$,30$-1$,30$-1$,30$-1$,30$-1$,30$-1$
	.WORD	20$-1$,20$-1$
	.WORD	30$-1$,30$-1$,30$-1$,30$-1$,30$-1$,30$-1$
20$:	PUSHAB	IQL
	BISL3	#^X500,R7,-(SP)
	BRB	40$
30$:	PUSHAB	IQD
	BISL3	#^X400,R7,-(SP)
40$:	PUSHL	#^X00010203
	MOVL	#3,R6
	TSTL	12(AP)
	BEQL	50$
	PUSHL	12(AP)
	PUSHL	#^X070E
	ADDL2	#2,R6
50$:	TSTL	8(AP)
	BEQL	60$
	PUSHL	8(AP)
	INCL	R6
60$:	CALLS	R6,G^FOR$INQUIRE
	MOVL	R0,R6
	CMPB	IQT,#^A/*/
	BNEQ	70$
	PUSHL	IQL
	PUSHL	R6
	PUSHL	R7
	PUSHAB	MIQL
	CALLS	#4,OUT
	RET
70$:	PUSHAB	IQT
	PUSHL	#64
	PUSHL	R6
	PUSHL	R7
	PUSHAB	MIQT
	CALLS	#5,OUT
	RET
; INQA(unit keyword or 0, file descriptor or 0): every question.
	.ENTRY	INQA,^M<R2>
	MOVL	#29,R2
10$:	PUSHL	8(AP)
	PUSHL	4(AP)
	PUSHL	R2
	CALLS	#3,INQ1
	AOBLEQ	#48,R2,10$
	RET
; UOLOG is a USEROPEN routine: it shows what it's given, then by UOMODE opens the
; file. 0 $CREATE and $CONNECT, 1 $OPEN and $CONNECT, 2 fails with RMS$_FNF, 3
; $CREATE alone, 4 $CREATE with RFM changed.
	.ENTRY	UOLOG,^M<R2,R3,R4,R5,R6>
	MOVL	4(AP),R2
	MOVL	8(AP),R3
	MOVL	12(AP),R4
	CLRL	-(SP)
	CMPB	RAB$B_BID(R3),#RAB$C_BID
	BNEQ	10$
	MOVL	#1,(SP)
10$:	CLRL	-(SP)
	CMPB	FAB$B_BID(R2),#FAB$C_BID
	BNEQ	20$
	MOVL	#1,(SP)
20$:	PUSHL	(R4)
	MOVZBL	(AP),-(SP)
	PUSHAB	MUOA
	CALLS	#5,OUT
	MOVZBL	FAB$B_FSZ(R2),-(SP)
	MOVZWL	FAB$W_BLS(R2),-(SP)
	MOVZBL	FAB$B_BKS(R2),-(SP)
	PUSHL	FAB$L_FOP(R2)
	MOVZWL	FAB$W_DEQ(R2),-(SP)
	PUSHL	FAB$L_ALQ(R2)
	PUSHL	FAB$L_MRN(R2)
	MOVZWL	FAB$W_MRS(R2),-(SP)
	MOVZBL	FAB$B_RAT(R2),-(SP)
	MOVZBL	FAB$B_RFM(R2),-(SP)
	MOVZBL	FAB$B_ORG(R2),-(SP)
	MOVZBL	FAB$B_SHR(R2),-(SP)
	MOVZBL	FAB$B_FAC(R2),-(SP)
	PUSHAB	MFAB
	CALLS	#14,OUT
	CALLS	#0,SHOWR3
	MOVL	FAB$L_NAM(R2),R0
	BEQL	25$
	MOVL	#1,R0
25$:	PUSHL	R0
	PUSHL	FAB$L_DNA(R2)
	MOVZBL	FAB$B_DNS(R2),-(SP)
	PUSHL	FAB$L_FNA(R2)
	MOVZBL	FAB$B_FNS(R2),-(SP)
	PUSHAB	MUOF
	CALLS	#6,OUT
	MOVL	FAB$L_XAB(R2),R5
30$:	BEQL	40$
	MOVZBL	XAB$B_BLN(R5),-(SP)
	MOVZBL	XAB$B_COD(R5),-(SP)
	PUSHAB	MUOX
	CALLS	#3,OUT
	MOVL	XAB$L_NXT(R5),R5
	BRB	30$
40$:	MOVL	UOMODE,R6
	CMPL	R6,#2
	BNEQ	42$
	MOVL	#^X18292,R0
	RET
42$:	CMPL	R6,#4
	BNEQ	44$
	MOVB	#FAB$C_STM,FAB$B_RFM(R2)
44$:	CMPL	R6,#1
	BEQL	50$
	$CREATE	FAB=(R2)
	BRB	60$
50$:	$OPEN	FAB=(R2)
60$:	MOVL	R0,R5
	PUSHL	FAB$L_STV(R2)
	PUSHL	R5
	PUSHAB	MUOS
	CALLS	#3,OUT
	BLBC	R5,90$
	CMPL	R6,#3
	BEQL	90$
	$CONNECT RAB=(R3)
	MOVL	R0,R5
	PUSHL	RAB$L_STV(R3)
	PUSHL	R5
	PUSHAB	MUOS
	CALLS	#3,OUT
90$:	MOVL	R5,R0
	RET
; CLEAN closes units 10 to 19 after each case, saying nothing.
CLH:	.WORD	^M<>
	MOVL	4(AP),R0
	CMPL	4(R0),#SS$_UNWIND
	BEQL	50$
	$UNWIND_S
50$:	MOVL	#SS$_CONTINUE,R0
	RET
	.ENTRY	CLEAN,^M<R2>
	CLRL	UNWN
	MOVAB	CLH,(FP)
	MOVL	#10,R2
10$:	ASHL	#16,R2,R0
	BISL2	#^X0101,R0
	PUSHL	#^X00010203
	PUSHL	R0
	CALLS	#2,G^FOR$CLOSE
	AOBLEQ	#19,R2,10$
	RET
	.PSECT	D,NOEXE,WRT,LONG
E1:	.LONG	0,0,0,0,0
MERRS:	.ASCID	~ errsns n=!SL sts=!XL stv=!XL u=!SL c=!XL~
MPC:	.ASCID	~ pc b=!SL i=!SL e=!SL~
MUPC:	.ASCID	~ user pc b=!SL i=!SL e=!SL~
PCR0:	.LONG	0
PCR1:	.LONG	0
PCR2:	.LONG	0
FMTQA:	.ASCIZ	~(Q,A)~
	.ALIGN	LONG
SGD:	.WORD	0
	.BYTE	14,1
	.ADDRESS SG3
SG3:	.WORD	3
	.ASCII	/ABCD/
SG1:	.WORD	1
	.ASCII	/AB/
SG2:	.WORD	2
	.ASCII	/CD/
SG0:	.WORD	0
	.ASCII	/EF/
SG4:	.WORD	4
	.ASCII	/GH/
SG7:	.WORD	7
	.ASCII	/IJ/
SGB:	.BYTE	1
	.ALIGN	LONG
; KW.IDX's key: one, a signed word at bytes 1 and 2 (testdata/for88's README).
KWB:	.WORD	0,3
	.LONG	7,1,2
KR1:	.WORD	5
	.ASCII	/FIVE  /
KR2:	.WORD	70
	.ASCII	/SEVNTY/
KR3:	.WORD	-3
	.ASCII	/MINUS3/
	.ALIGN	LONG
KL5:	.LONG	5
KL70:	.LONG	70
KLM3:	.LONG	-3
KL70005:	.LONG	70005
KL65541:	.LONG	65541
KW5:	.WORD	5
KB5:	.BYTE	5
	.ALIGN	LONG
KDL5:	.WORD	4
	.BYTE	8,1
	.ADDRESS KL5
KDW5:	.WORD	2
	.BYTE	7,1
	.ADDRESS KW5
KDL70:	.WORD	4
	.BYTE	8,1
	.ADDRESS KL70
KDLM3:	.WORD	4
	.BYTE	8,1
	.ADDRESS KLM3
KDL70005:	.WORD	4
	.BYTE	8,1
	.ADDRESS KL70005
KDL65541:	.WORD	4
	.BYTE	8,1
	.ADDRESS KL65541
KDB5:	.WORD	1
	.BYTE	6,1
	.ADDRESS KB5
; KEYGET's file, by name.
	.ALIGN	LONG
KFB:	$FAB	FAC=<GET>,SHR=<GET,PUT,UPD,DEL>
	.ALIGN	LONG
KRB:	$RAB	FAB=KFB,RAC=KEY,KBF=RKEY,KSZ=4,UBF=RDB,USZ=8
MKG:	.ASCID	~ rms $GET !AS key !SL: sts=!XL stv=!XL rsz=!UW~
MKO:	.ASCID	~ rms $OPEN !AS: sts=!XL~
; SHORT.DAT: FIX records of 24 bytes, one block written by $WRITE.
	.ALIGN	LONG
SFB:	$FAB	FNM=<SHORT.DAT>,FAC=<BIO>,RFM=FIX,MRS=24,ORG=SEQ
	.ALIGN	LONG
SRB:	$RAB	FAB=SFB,RBF=BIGB,RSZ=512,BKT=1
	.PSECT	C,EXE,NOWRT,LONG
; ERRS shows FOR$ERRSNS's five values.
	.ENTRY	ERRS,^M<R2>
	MOVAL	E1,R2
	MOVL	#^X12345678,(R2)
	MOVL	#^X12345678,4(R2)
	MOVL	#^X12345678,8(R2)
	MOVL	#^X12345678,12(R2)
	MOVL	#^X12345678,16(R2)
	PUSHAL	16(R2)
	PUSHAL	12(R2)
	PUSHAL	8(R2)
	PUSHAL	4(R2)
	PUSHAL	(R2)
	CALLS	#5,G^FOR$ERRSNS
	PUSHL	16(R2)
	PUSHL	12(R2)
	PUSHL	8(R2)
	PUSHL	4(R2)
	PUSHL	(R2)
	PUSHAB	MERRS
	CALLS	#6,OUT
	RET
; HNDPC shows a condition's PC, and for a FOR$ condition (facility 24) of six
; longwords or more its fifth argument, the user PC, each less PCR0, PCR1, and
; PCR2; then it does what HND does.
HNDPC:	.WORD	^M<R2,R3>
	MOVL	4(AP),R2
	CMPL	4(R2),#SS$_UNWIND
	BEQL	10$
	MOVL	(R2),R3
	MOVL	-4(R2)[R3],R3
	SUBL3	PCR2,R3,-(SP)
	SUBL3	PCR1,R3,-(SP)
	SUBL3	PCR0,R3,-(SP)
	PUSHAB	MPC
	CALLS	#4,OUT
	EXTZV	#16,#12,4(R2),R3
	CMPL	R3,#24
	BNEQ	10$
	CMPL	(R2),#6
	BLSS	10$
	MOVL	20(R2),R3
	SUBL3	PCR2,R3,-(SP)
	SUBL3	PCR1,R3,-(SP)
	SUBL3	PCR0,R3,-(SP)
	PUSHAB	MUPC
	CALLS	#4,OUT
10$:	JMP	HND+2
; KEYGET(key, name) is RMS's keyed $GET of record key from the named file.
	.ENTRY	KEYGET,^M<R2>
	MOVL	8(AP),R2
	MOVB	(R2),KFB+FAB$B_FNS
	MOVL	4(R2),KFB+FAB$L_FNA
	MOVL	4(AP),RKEY
	$OPEN	FAB=KFB
	BLBS	R0,10$
	PUSHL	R0
	PUSHL	R2
	PUSHAB	MKO
	CALLS	#3,OUT
	RET
10$:	$CONNECT RAB=KRB
	CLRW	KRB+RAB$W_RSZ
	$GET	RAB=KRB
	MOVZWL	KRB+RAB$W_RSZ,-(SP)
	PUSHL	KRB+RAB$L_STV
	PUSHL	R0
	PUSHL	4(AP)
	PUSHL	R2
	PUSHAB	MKG
	CALLS	#6,OUT
	$CLOSE	FAB=KFB
	RET
; MKSHORT makes SHORT.DAT.
	.ENTRY	MKSHORT,^M<>
	$CREATE	FAB=SFB
	BLBC	R0,90$
	$CONNECT RAB=SRB
	BLBC	R0,90$
	$WRITE	RAB=SRB
	BLBC	R0,90$
	$CLOSE	FAB=SFB
90$:	RET
	.PSECT	D,NOEXE,WRT,LONG
; B's field: CVD describes 0 or 1 columns at CVB+4.
CVV:	.LONG	0
CVB:	.BLKB	12
CVD:	.WORD	0
	.BYTE	14,1
	.ADDRESS CVB+4
; D's records and keys.
UR1:	.WORD	5
	.ASCII	/FIVE  /
UR2:	.WORD	65535
	.ASCII	/MAXUNS/
UR3:	.WORD	32768
	.ASCII	/32768 /
SR1:	.WORD	32767
	.ASCII	/MAXPOS/
SR2:	.WORD	-32768
	.ASCII	/MINNEG/
SR3:	.WORD	-1
	.ASCII	/MINUS1/
	.ALIGN	LONG
KL65535:	.LONG	65535
KL32768:	.LONG	32768
KL65536:	.LONG	65536
KLM1:	.LONG	-1
KL32767:	.LONG	32767
KLM32768:	.LONG	-32768
KLM32769:	.LONG	-32769
KWM1:	.WORD	-1
	.ALIGN	LONG
KDL65535:	.WORD	4
	.BYTE	8,1
	.ADDRESS KL65535
KDL32768:	.WORD	4
	.BYTE	8,1
	.ADDRESS KL32768
KDL65536:	.WORD	4
	.BYTE	8,1
	.ADDRESS KL65536
KDLM1:	.WORD	4
	.BYTE	8,1
	.ADDRESS KLM1
KDL32767:	.WORD	4
	.BYTE	8,1
	.ADDRESS KL32767
KDLM32768:	.WORD	4
	.BYTE	8,1
	.ADDRESS KLM32768
KDLM32769:	.WORD	4
	.BYTE	8,1
	.ADDRESS KLM32769
KDWM1:	.WORD	2
	.BYTE	7,1
	.ADDRESS KWM1
; UW.IDX: FIX 8, one key, an unsigned word at byte 0.
	.ALIGN	LONG
UFB:	$FAB	FNM=<UW.IDX>,ORG=IDX,RFM=FIX,MRS=8,FAC=<PUT>,XAB=UXK
	.ALIGN	LONG
UXK:	$XABKEY	REF=0,DTP=BN2,POS=0,SIZ=2
	.PSECT	C,EXE,NOWRT,LONG
; MKUW makes UW.IDX, returning RMS's status.
	.ENTRY	MKUW,^M<>
	$CREATE	FAB=UFB
	BLBC	R0,90$
	$CLOSE	FAB=UFB
90$:	RET
	.ENTRY	S0,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
