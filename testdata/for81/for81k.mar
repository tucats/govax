	.TITLE	FOR81K - Round 3b of Phase 81's probe, round 3's follow-up
; Written by testdata/for81/gen.go.
	$SSDEF
	$FABDEF
	$RABDEF
	$NAMDEF
	$XABDEF
	$XABFHCDEF
	.PSECT	D,NOEXE,WRT,LONG
