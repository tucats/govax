T57:	.ASCID	~CVT_L_TO v=8 n=1 d=-1~
T58:	.ASCID	~CVT_L_TO v=8 n=1 d=1~
T59:	.ASCID	~CVT_L_TO v=-1 n=0 d=-1~
T60:	.ASCID	~CVT_L_TO v=-1 n=0 d=1~
T61:	.ASCID	~CVT_L_TO v=-1 n=1 d=-1~
T62:	.ASCID	~CVT_L_TO v=-1 n=1 d=1~
T63:	.ASCID	~#11 OTS$CVT_L_TZ of a longword, lengths 0 and 1, with no digits and with 1~
T64:	.ASCID	~CVT_L_TZ v=0 n=0 d=-1~
T65:	.ASCID	~CVT_L_TZ v=0 n=0 d=1~
T66:	.ASCID	~CVT_L_TZ v=0 n=1 d=-1~
T67:	.ASCID	~CVT_L_TZ v=0 n=1 d=1~
T68:	.ASCID	~CVT_L_TZ v=255 n=0 d=-1~
T69:	.ASCID	~CVT_L_TZ v=255 n=0 d=1~
