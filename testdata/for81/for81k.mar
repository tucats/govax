	.ADDRESS KL65535
KDL32768:	.WORD	4
	.BYTE	8,1
	.ADDRESS KL32768
KDL65536:	.WORD	4
	.BYTE	8,1
	.ADDRESS KL65536
KDLM1:	.WORD	4
