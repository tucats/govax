T44:	.ASCID	~#7 DELETE 2, DELETE 5, DELETE 3~
T45:	.ASCID	~#8 READ 4, then DELETE 4~
T46:	.ASCID	~#9 WRITE 3, then DELETE 1, then READ 2~
T47:	.ASCID	~NEW~
