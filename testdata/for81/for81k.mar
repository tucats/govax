T26:	.ASCID	~THREE~
T27:	.ASCID	~FOUR~
T28:	.ASCID	~BS2.DAT~
T29:	.ASCID	~BS3.DAT~
T30:	.ASCID	~BS4.DAT~
T31:	.ASCID	~FU1.DAT~
T32:	.ASCID	~FU2.DAT~
T33:	.ASCID	~#2 make ONE.DAT, one record, and SEG.DAT, unformatted, one record of 8 bytes~
T34:	.ASCID	~ONE.DAT~
T35:	.ASCID	~ABCD~
T36:	.ASCID	~SEG.DAT~
T37:	.ASCID	~##### A: the associated variable (asv, -1 before each statement) and NEXTREC (nr) after DELETE by number~
T38:	.ASCID	~#3 DELETE 5 first~
T39:	.ASCID	~DELETE_D~
T40:	.ASCID	~#4 READ 2, then DELETE 6~
T41:	.ASCID	~#5 READ 6, then DELETE 2~
T42:	.ASCID	~#6 FIND 3, then DELETE 7~
