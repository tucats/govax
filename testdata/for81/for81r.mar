	.TITLE	FOR81R - Phase 81's probe of RMS's relative and fixed-length files
; Written by testdata/for81/gen.go.
	$SSDEF
	$FABDEF
	$RABDEF
	$NAMDEF
	$XABDEF
	$XABFHCDEF
	.PSECT	D,NOEXE,WRT,LONG
VAL:	.LONG	0,0
UVAL:	.LONG	0
ASVL:	.LONG	-1
UOMODE:	.LONG	0
LN:	.LONG	0
LD:	.WORD	0
	.BYTE	14,1
	.ADDRESS BF
BD:	.WORD	400
	.BYTE	14,1
	.ADDRESS BF
BF:	.BLKB	400
RKEY:	.LONG	0
IQL:	.LONG	0,0
IQT:	.BLKB	64
IQD:	.WORD	64
	.BYTE	14,1
	.ADDRESS IQT
SHORTD:	.WORD	4
	.BYTE	14,1
	.ADDRESS IQT
BIGD:	.WORD	0
	.BYTE	14,1
	.ADDRESS BIGB
RDD:	.WORD	0
	.BYTE	14,1
	.ADDRESS RDB
FMTA:	.ASCIZ	~(A)~
	.ALIGN	LONG
BIGB:	.BLKB	33000
RDB:	.BLKB	33000
BLK:	.BLKB	512
HX:	.ASCII	/0123456789ABCDEF/
HL:	.BLKB	100
HLD:	.WORD	0
	.BYTE	14,1
	.ADDRESS HL
MSHOW:	.ASCID	~=!AS r=!XL~
MCOND:	.ASCID	~=c !XL n=!UL a=!XL !XL~
MUNW:	.ASCID	~=u~
MFAB:	.ASCID	~ fab fac=!XB shr=!XB org=!XB rfm=!XB rat=!XB mrs=!UW mrn=!UL alq=!UL deq=!UW fop=!XL bks=!UB bls=!UW fsz=!UB~
MRAB:	.ASCID	~ rab rop=!XL rac=!UB mbc=!UB mbf=!SB rsz=!UW usz=!UW ksz=!UB~
MNORAB:	.ASCID	~ no rab: !XL~
MASV:	.ASCID	~ asv=!XL~
MIQL:	.ASCID	~ q!UL r=!XL v=!XL~
MIQT:	.ASCID	~ q!UL r=!XL |!AD|~
MST:	.ASCID	~ stat !AS: r=!XL~
MST2:	.ASCID	~ stat !AS: org=!XB rfm=!XB rat=!XB mrs=!UW mrn=!UL alq=!UL deq=!UW bks=!UB fop=!XL lrl=!UW hbk=!UL ebk=!UL ffb=!UW~
MRC:	.ASCID	~ rec !UL: r=!XL n=!UW~
MVB:	.ASCID	~ vbn !UL~
MGET:	.ASCID	~ got n=!UW rfa=!UL,!UW stv=!XL bkt=!UL~
MPUT:	.ASCID	~ rfa=!UL,!UW stv=!XL bkt=!UL~
MFST:	.ASCID	~ fab now org=!XB rfm=!XB rat=!XB mrs=!UW mrn=!UL alq=!UL deq=!UW bks=!UB fop=!XL stv=!XL~
MNAM:	.ASCID	~ nam |!AD| fnb=!XL~
MUOA:	.ASCID	~ uo n=!UL unit=!SL fab?=!UL rab?=!UL~
MUOF:	.ASCID	~ uo fna=|!AD| dna=|!AD| nam=!UL~
MUOX:	.ASCID	~ uo xab cod=!UB bln=!UB~
MUOS:	.ASCID	~=uo-rms r=!XL stv=!XL~
	.ALIGN	LONG
FB2:	$FAB	FAC=<GET>,SHR=<GET,PUT,UPD,DEL>,XAB=FH2
	.ALIGN	LONG
RB2:	$RAB	FAB=FB2
	.ALIGN	LONG
FH2:	$XABFHC
	.ALIGN	LONG
FB3:	$FAB	FAC=<BIO,GET>,SHR=<GET,PUT,UPD,DEL>
	.ALIGN	LONG
RB3:	$RAB	FAB=FB3,ROP=<BIO>
	.ALIGN	LONG
FB:	$FAB	FAC=<GET,PUT,UPD,DEL>,NAM=NB
	.ALIGN	LONG
RB:	$RAB	FAB=FB,KBF=RKEY,KSZ=4
	.ALIGN	LONG
NB:	$NAM	RSA=NBR,RSS=128,ESA=NBE,ESS=128
NBR:	.BLKB	128
NBE:	.BLKB	128
	.ALIGN	LONG
FBT:	.BLKB	FAB$C_BLN
RBT:	.BLKB	RAB$C_BLN
	.ALIGN	LONG
T0:	.ASCID	~##### $PARSE with no NAM, as FORRTL's first call is~
T1:	.ASCID	~#0 $PARSE, FAB$L_NAM 0~
T2:	.ASCID	~NONAM.DAT~
T3:	.ASCID	~$PARSE~
T4:	.ASCID	~#1 $PARSE, FAB$L_NAM 0, a bad name~
T5:	.ASCID	~A[B~
T6:	.ASCID	~##### relative files: the file's layout~
T7:	.ASCID	~#2 REL FIX 10, empty~
T8:	.ASCID	~R1.DAT~
T9:	.ASCID	~$CREATE~
T10:	.ASCID	~$CONNECT~
T11:	.ASCID	~$CLOSE~
T12:	.ASCID	~#3 REL FIX 10, records 1 2 5~
T13:	.ASCID	~R2.DAT~
T14:	.ASCID	~$PUT~
T15:	.ASCID	~#4 REL FIX 11 (odd)~
T16:	.ASCID	~R3.DAT~
T17:	.ASCID	~#5 REL FIX 1~
T18:	.ASCID	~R4.DAT~
T19:	.ASCID	~#6 REL FIX 512~
T20:	.ASCID	~R5.DAT~
T21:	.ASCID	~#7 REL FIX 10, RAT FTN~
T22:	.ASCID	~R6.DAT~
T23:	.ASCID	~#8 REL FIX 10, RAT CR~
T24:	.ASCID	~R7.DAT~
T25:	.ASCID	~#9 REL FIX 10, BKS 1~
T26:	.ASCID	~R8.DAT~
T27:	.ASCID	~#10 REL FIX 10, BKS 4~
T28:	.ASCID	~R9.DAT~
T29:	.ASCID	~#11 REL FIX 10, MRN 3~
T30:	.ASCID	~R10.DAT~
T31:	.ASCID	~$GET~
T32:	.ASCID	~#12 REL FIX 10, past the first bucket~
T33:	.ASCID	~R11.DAT~
T34:	.ASCID	~#13 REL FIX 100, a bucket's fill~
T35:	.ASCID	~R12.DAT~
T36:	.ASCID	~#14 REL VAR 40~
T37:	.ASCID	~R13.DAT~
T38:	.ASCID	~#15 REL VAR 0 MRS~
T39:	.ASCID	~R14.DAT~
T40:	.ASCID	~#16 REL VFC 40~
T41:	.ASCID	~R15.DAT~
T42:	.ASCID	~#17 REL FIX size errors~
T43:	.ASCID	~R16.DAT~
T44:	.ASCID	~#18 REL FIX 0~
T45:	.ASCID	~R17.DAT~
T46:	.ASCID	~#19 REL STM~
T47:	.ASCID	~R18.DAT~
T48:	.ASCID	~#20 REL, FIX 40000~
T49:	.ASCID	~R19.DAT~
T50:	.ASCID	~##### relative files: every operation~
T51:	.ASCID	~#21 build, and all the statuses~
T52:	.ASCID	~R20.DAT~
T53:	.ASCID	~$REWIND~
T54:	.ASCID	~$FIND~
T55:	.ASCID	~$UPDATE~
T56:	.ASCID	~$DELETE~
T57:	.ASCID	~$FREE~
T58:	.ASCID	~#22 reopen: attributes, and statuses by RFA~
T59:	.ASCID	~$OPEN~
T60:	.ASCID	~#23 $TRUNCATE on a relative file~
T61:	.ASCID	~$TRUNCATE~
T62:	.ASCID	~#24 a locked record: two streams~
T63:	.ASCID	~##### sequential FIX: keyed $PUT, $GET, and padding~
T64:	.ASCID	~#25 FIX 16, sequential~
T65:	.ASCID	~S21.DAT~
T66:	.ASCID	~#26 FIX 5, sequential~
T67:	.ASCID	~S22.DAT~
T68:	.ASCID	~#27 FIX 7, 100 sequential, across blocks~
T69:	.ASCID	~S23.DAT~
T70:	.ASCID	~#28 FIX 513, sequential, across blocks~
T71:	.ASCID	~S24.DAT~
T72:	.ASCID	~#29 FIX 16, keyed: UIF off, on, gaps, past the end~
T73:	.ASCID	~S25.DAT~
T74:	.ASCID	~#30 FIX 5, keyed~
T75:	.ASCID	~S26.DAT~
T76:	.ASCID	~#31 FIX 16, keyed then sequential~
T77:	.ASCID	~S27.DAT~
T78:	.ASCID	~#32 FIX 16, $TRUNCATE~
T79:	.ASCID	~S28.DAT~
T80:	.ASCID	~#33 FIX 16, $DELETE~
T81:	.ASCID	~S29.DAT~
T82:	.ASCID	~#34 VAR: keyed $PUT and $GET refused~
T83:	.ASCID	~V30.DAT~
T84:	.ASCID	~#35 VAR: odd records, blocks~
T85:	.ASCID	~V31.DAT~
T86:	.ASCID	~#36 VAR: no span~
T87:	.ASCID	~V32.DAT~
T88:	.ASCID	~#37 FIX: no span~
T89:	.ASCID	~S33.DAT~
T90:	.ASCID	~#38 a short last record: FIX 16, FFB in the middle, read to the end~
T91:	.ASCID	~S34.DAT~
T92:	.ASCID	~#39 MRS over the file's on $OPEN, and bad attributes on $CREATE~
T93:	.ASCID	~S35.DAT~
T94:	.ASCID	~##### FOP: what each bit leaves behind~
T95:	.ASCID	~#40 nothing~
T96:	.ASCID	~P36.DAT~
T97:	.ASCID	~#41 TMP~
T98:	.ASCID	~P37.DAT~
T99:	.ASCID	~#42 TMD~
T100:	.ASCID	~P38.DAT~
T101:	.ASCID	~#43 DLT at $CREATE~
T102:	.ASCID	~P39.DAT~
T103:	.ASCID	~#44 DLT at $CLOSE~
T104:	.ASCID	~P40.DAT~
T105:	.ASCID	~#45 SPL at $CREATE~
T106:	.ASCID	~P41.DAT~
T107:	.ASCID	~#46 SPL at $CLOSE~
T108:	.ASCID	~P42.DAT~
T109:	.ASCID	~#47 SPL and DLT at $CLOSE~
T110:	.ASCID	~P43.DAT~
T111:	.ASCID	~#48 SCF at $CLOSE~
T112:	.ASCID	~P44.DAT~
T113:	.ASCID	~#49 SCF and DLT at $CLOSE~
T114:	.ASCID	~P45.DAT~
T115:	.ASCID	~#50 CIF~
T116:	.ASCID	~P46.DAT~
T117:	.ASCID	~#51 MXV~
T118:	.ASCID	~P47.DAT~
T119:	.ASCID	~#52 CTG~
T120:	.ASCID	~P48.DAT~
T121:	.ASCID	~#53 DFW~
T122:	.ASCID	~P49.DAT~
T123:	.ASCID	~#54 NEF~
T124:	.ASCID	~P50.DAT~
T125:	.ASCID	~#55 OFP~
T126:	.ASCID	~P51.DAT~
T127:	.ASCID	~#56 TMP and $OPEN by NAM's FID~
T128:	.ASCID	~TMPF.DAT~
T129:	.ASCID	~#57 CIF: found, and the FAB's attributes it then has~
T130:	.ASCID	~CIF1.DAT~
T131:	.ASCID	~#58 DEQ: where it's kept, and ALQ returned~
T132:	.ASCID	~DEQ1.DAT~
T133:	.ASCID	~#59 a FIX file's RAT and record size errors at $PUT~
T134:	.ASCID	~ERR1.DAT~
	.PSECT	C,EXE,NOWRT,LONG
; OUT(control, values...) writes a line.
	.ENTRY	OUT,^M<R2,R3,R4,R5>
	$FAOL_S	CTRSTR=@4(AP),OUTLEN=LD,OUTBUF=BD,PRMLST=8(AP)
	PUSHAB	LD
	CALLS	#1,G^LIB$PUT_OUTPUT
	RET
; SHOW(what, r0)
	.ENTRY	SHOW,^M<>
	PUSHL	8(AP)
	PUSHL	4(AP)
	PUSHAB	MSHOW
	CALLS	#3,OUT
	RET
; HND prints a condition, continues below severe, and unwinds from a severe one.
HND:	.WORD	^M<R2>
	MOVL	4(AP),R2
	CMPL	4(R2),#SS$_UNWIND
	BEQL	50$
	PUSHL	12(R2)
	PUSHL	8(R2)
	PUSHL	(R2)
	PUSHL	4(R2)
	PUSHAB	MCOND
	CALLS	#5,OUT
	BICL3	#^XFFFFFFF8,4(R2),R0
	CMPL	R0,#4
	BEQL	40$
	MOVL	#SS$_CONTINUE,R0
	RET
40$:	PUSHAB	MUNW
	CALLS	#1,G^LIB$PUT_OUTPUT
	$UNWIND_S
50$:	MOVL	#SS$_CONTINUE,R0
	RET
; HEXS(address, count) writes bytes in hex, 32 to a line, with an offset.
	.ENTRY	HEXS,^M<R2,R3,R4,R5,R6,R7>
	MOVL	4(AP),R2
	MOVL	8(AP),R3
	CLRL	R7
10$:	TSTL	R3
	BGTR	11$
	BRW	90$
11$:	MOVAB	HL,R4
	MOVB	#^A/ /,(R4)+
	MOVB	#^A/ /,(R4)+
	ASHL	#-8,R7,R0
	EXTZV	#4,#4,R0,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#0,#4,R0,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#4,#4,R7,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#0,#4,R7,R1
	MOVB	HX[R1],(R4)+
	MOVB	#^A/:/,(R4)+
	MOVB	#^A/ /,(R4)+
	MOVL	#32,R5
20$:	TSTL	R3
	BLEQ	30$
	MOVZBL	(R2)+,R6
	EXTZV	#4,#4,R6,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#0,#4,R6,R1
	MOVB	HX[R1],(R4)+
	DECL	R3
	INCL	R7
	SOBGTR	R5,20$
30$:	MOVAB	HL,R0
	SUBL3	R0,R4,R0
	MOVW	R0,HLD
	PUSHAB	HLD
	CALLS	#1,G^LIB$PUT_OUTPUT
	BRW	10$
90$:	RET
; DUMPF(name, flags): a file's attributes by $OPEN and XABFHC; flag 1, its records
; in hex (the first 32 bytes of each, the first 40 records); flag 2, its blocks in
; hex, by block I/O (all-zero lines left out, the first 16 blocks).
	.ENTRY	DUMPF,^M<R2,R3,R4,R5,R6,R7>
	MOVL	4(AP),R2
	MOVB	(R2),FB2+FAB$B_FNS
	MOVL	4(R2),FB2+FAB$L_FNA
	$OPEN	FAB=FB2
	BLBS	R0,10$
	PUSHL	R0
	PUSHL	R2
	PUSHAB	MST
	CALLS	#3,OUT
	RET
10$:	MOVZWL	FH2+XAB$W_FFB,-(SP)
	PUSHL	FH2+XAB$L_EBK
	PUSHL	FH2+XAB$L_HBK
	MOVZWL	FH2+XAB$W_LRL,-(SP)
	PUSHL	FB2+FAB$L_FOP
	MOVZBL	FB2+FAB$B_BKS,-(SP)
	MOVZWL	FB2+FAB$W_DEQ,-(SP)
	PUSHL	FB2+FAB$L_ALQ
	PUSHL	FB2+FAB$L_MRN
	MOVZWL	FB2+FAB$W_MRS,-(SP)
	MOVZBL	FB2+FAB$B_RAT,-(SP)
	MOVZBL	FB2+FAB$B_RFM,-(SP)
	MOVZBL	FB2+FAB$B_ORG,-(SP)
	PUSHL	R2
	PUSHAB	MST2
	CALLS	#15,OUT
	BLBS	8(AP),20$
	BRW	50$
20$:	$CONNECT RAB=RB2
	MOVL	#1,R6
30$:	MOVL	#33000,R0
	MOVW	R0,RB2+RAB$W_USZ
	MOVAB	RDB,RB2+RAB$L_UBF
	$GET	RAB=RB2
	MOVL	R0,R7
	MOVZWL	RB2+RAB$W_RSZ,-(SP)
	PUSHL	R7
	PUSHL	R6
	PUSHAB	MRC
	CALLS	#4,OUT
	BLBC	R7,40$
	MOVZWL	RB2+RAB$W_RSZ,R3
	CMPL	R3,#32
	BLEQ	35$
	MOVL	#32,R3
35$:	PUSHL	R3
	PUSHAB	RDB
	CALLS	#2,HEXS
	AOBLEQ	#40,R6,30$
40$:
50$:	$CLOSE	FAB=FB2
	BBC	#1,8(AP),59$
	BRW	60$
59$:	RET
60$:	MOVB	(R2),FB3+FAB$B_FNS
	MOVL	4(R2),FB3+FAB$L_FNA
	$OPEN	FAB=FB3
	BLBS	R0,62$
	PUSHL	R0
	PUSHL	R2
	PUSHAB	MST
	CALLS	#3,OUT
	RET
62$:	$CONNECT RAB=RB3
	MOVL	#1,R6
70$:	MOVL	R6,RB3+RAB$L_BKT
	MOVW	#512,RB3+RAB$W_USZ
	MOVAB	BLK,RB3+RAB$L_UBF
	$READ	RAB=RB3
	BLBC	R0,80$
	PUSHL	R6
	PUSHAB	MVB
	CALLS	#2,OUT
	CLRL	R3
72$:	MOVAB	BLK[R3],R4
	MOVL	#8,R5
74$:	TSTL	(R4)+
	BNEQ	76$
	SOBGTR	R5,74$
	BRB	78$
76$:	PUSHL	#32
	PUSHAB	BLK[R3]
	PUSHL	R3
	CALLS	#3,HEXO
78$:	ACBL	#511,#32,R3,72$
	AOBLEQ	#16,R6,70$
80$:	$CLOSE	FAB=FB3
	RET
; HEXO(offset, address, count): one line of block dump, with the block's offset.
	.ENTRY	HEXO,^M<R2,R3,R4,R5,R6,R7>
	MOVL	8(AP),R2
	MOVL	12(AP),R3
	MOVL	4(AP),R7
	MOVAB	HL,R4
	MOVB	#^A/ /,(R4)+
	MOVB	#^A/ /,(R4)+
	EXTZV	#8,#4,R7,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#4,#4,R7,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#0,#4,R7,R1
	MOVB	HX[R1],(R4)+
	MOVB	#^A/:/,(R4)+
	MOVB	#^A/ /,(R4)+
20$:	MOVZBL	(R2)+,R6
	EXTZV	#4,#4,R6,R1
	MOVB	HX[R1],(R4)+
	EXTZV	#0,#4,R6,R1
	MOVB	HX[R1],(R4)+
	SOBGTR	R3,20$
	MOVAB	HL,R0
	SUBL3	R0,R4,R0
	MOVW	R0,HLD
	PUSHAB	HLD
	CALLS	#1,G^LIB$PUT_OUTPUT
	RET
; RDFILL fills the read buffer with 55s.
	.ENTRY	RDFILL,^M<R2,R3,R4,R5>
	MOVC5	#0,RDB,#^X55,#64,RDB
	RET
	.ENTRY	RRESET,^M<R2,R3,R4,R5>
	MOVC3	#FAB$C_BLN,FBT,FB
	MOVC3	#RAB$C_BLN,RBT,RB
	RET
	.ENTRY	CLEAN,^M<>
	RET
; SHOWF is what the FAB holds after a $CREATE or $OPEN.
	.ENTRY	SHOWF,^M<>
	PUSHL	FB+FAB$L_STV
	PUSHL	FB+FAB$L_FOP
	MOVZBL	FB+FAB$B_BKS,-(SP)
	MOVZWL	FB+FAB$W_DEQ,-(SP)
	PUSHL	FB+FAB$L_ALQ
	PUSHL	FB+FAB$L_MRN
	MOVZWL	FB+FAB$W_MRS,-(SP)
	MOVZBL	FB+FAB$B_RAT,-(SP)
	MOVZBL	FB+FAB$B_RFM,-(SP)
	MOVZBL	FB+FAB$B_ORG,-(SP)
	PUSHAB	MFST
	CALLS	#11,OUT
	RET
	.ENTRY	SHOWN,^M<>
	PUSHL	NB+NAM$L_FNB
	PUSHAB	NBR
	MOVZBL	NB+NAM$B_RSL,-(SP)
	PUSHAB	MNAM
	CALLS	#4,OUT
	RET
; SHOWR is what the RAB holds after a $PUT or the like, SHOWG after a $GET, with
; the record in hex.
	.ENTRY	SHOWR,^M<>
	PUSHL	RB+RAB$L_BKT
	PUSHL	RB+RAB$L_STV
	MOVZWL	RB+RAB$W_RFA4,-(SP)
	PUSHL	RB+RAB$L_RFA0
	PUSHAB	MPUT
	CALLS	#5,OUT
	RET
	.ENTRY	SHOWG,^M<R2>
	PUSHL	RB+RAB$L_BKT
	PUSHL	RB+RAB$L_STV
	MOVZWL	RB+RAB$W_RFA4,-(SP)
	PUSHL	RB+RAB$L_RFA0
	MOVZWL	RB+RAB$W_RSZ,-(SP)
	PUSHAB	MGET
	CALLS	#6,OUT
	MOVZWL	RB+RAB$W_RSZ,R2
	CMPL	R2,#32
	BLEQ	10$
	MOVL	#32,R2
10$:	PUSHL	R2
	PUSHAB	RDB
	CALLS	#2,HEXS
	RET
	.ENTRY	S0,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
	PUSHL	#3
	PUSHAB	T8
	CALLS	#2,L^DUMPF
	RET
	.ENTRY	S1,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
	PUSHL	#3
	PUSHAB	T13
	CALLS	#2,L^DUMPF
	RET
	.ENTRY	S2,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
	PUSHL	#3
	PUSHAB	T16
	CALLS	#2,L^DUMPF
	RET
	.ENTRY	S3,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
	PUSHL	#3
	PUSHAB	T18
	CALLS	#2,L^DUMPF
	RET
	.ENTRY	S4,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
	PUSHL	#3
	PUSHAB	T20
	CALLS	#2,L^DUMPF
	RET
	.ENTRY	S5,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
	PUSHL	#3
	PUSHAB	T22
	CALLS	#2,L^DUMPF
	RET
	.ENTRY	S6,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
	PUSHL	#3
	PUSHAB	T24
	CALLS	#2,L^DUMPF
	RET
	.ENTRY	S7,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
	PUSHL	#3
	PUSHAB	T26
	CALLS	#2,L^DUMPF
	RET
	.ENTRY	S8,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
	PUSHL	#3
	PUSHAB	T28
