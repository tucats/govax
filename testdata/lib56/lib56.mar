	.ENTRY	START,^M<>

	CLRL	SIGCOND			; 1: ADD delta delta
	CALLS	#0,C1
	PUSHL	R0
	PUSHAB	C1_NAME
	CALLS	#2,SHOWR0
	PUSHAQ	BADTCTL
	PUSHAQ	TIMCTL
	PUSHAB	C1_R
	PUSHAB	C1_W1
	CALLS	#4,SHOWTIM
	PUSHAQ	MEMCTL
	PUSHL	#2
	PUSHAB	C1_R
	PUSHAB	C1_W2
	CALLS	#4,SHOWMEM

	CLRL	SIGCOND			; 2: ADD abs delta
	CALLS	#0,C2
	PUSHL	R0
	PUSHAB	C2_NAME
	CALLS	#2,SHOWR0
	PUSHAQ	BADTCTL
	PUSHAQ	TIMCTL
	PUSHAB	C2_R
	PUSHAB	C2_W1
	CALLS	#4,SHOWTIM
	PUSHAQ	MEMCTL
	PUSHL	#2
	PUSHAB	C2_R
	PUSHAB	C2_W2
	CALLS	#4,SHOWMEM

	CLRL	SIGCOND			; 3: ADD delta abs
	CALLS	#0,C3
	PUSHL	R0
	PUSHAB	C3_NAME
	CALLS	#2,SHOWR0
	PUSHAQ	BADTCTL
	PUSHAQ	TIMCTL
	PUSHAB	C3_R
	PUSHAB	C3_W1
	CALLS	#4,SHOWTIM
	PUSHAQ	MEMCTL
	PUSHL	#2
	PUSHAB	C3_R
	PUSHAB	C3_W2
	CALLS	#4,SHOWMEM

	CLRL	SIGCOND			; 4: ADD abs abs
	CALLS	#0,C4
	PUSHL	R0
	PUSHAB	C4_NAME
	CALLS	#2,SHOWR0
	PUSHAQ	BADTCTL
	PUSHAQ	TIMCTL
	PUSHAB	C4_R
	PUSHAB	C4_W1
	CALLS	#4,SHOWTIM
	PUSHAQ	MEMCTL
	PUSHL	#2
	PUSHAB	C4_R
	PUSHAB	C4_W2
	CALLS	#4,SHOWMEM

	CLRL	SIGCOND			; 5: ADD 9999 days 1 day
	CALLS	#0,C5
	PUSHL	R0
	PUSHAB	C5_NAME
	CALLS	#2,SHOWR0
	PUSHAQ	BADTCTL
	PUSHAQ	TIMCTL
	PUSHAB	C5_R
	PUSHAB	C5_W1
	CALLS	#4,SHOWTIM
	PUSHAQ	MEMCTL
	PUSHL	#2
	PUSHAB	C5_R
	PUSHAB	C5_W2
	CALLS	#4,SHOWMEM

	CLRL	SIGCOND			; 6: ADD 10000 days 1 tick
	CALLS	#0,C6
	PUSHL	R0
	PUSHAB	C6_NAME
	CALLS	#2,SHOWR0
	PUSHAQ	BADTCTL
	PUSHAQ	TIMCTL
	PUSHAB	C6_R
	PUSHAB	C6_W1
	CALLS	#4,SHOWTIM
	PUSHAQ	MEMCTL
	PUSHL	#2
	PUSHAB	C6_R
	PUSHAB	C6_W2
	CALLS	#4,SHOWMEM

	CLRL	SIGCOND			; 7: ADD year 9999 2 days
	CALLS	#0,C7
	PUSHL	R0
	PUSHAB	C7_NAME
	CALLS	#2,SHOWR0
	PUSHAQ	BADTCTL
	PUSHAQ	TIMCTL
	PUSHAB	C7_R
	PUSHAB	C7_W1
	CALLS	#4,SHOWTIM
	PUSHAQ	MEMCTL
	PUSHL	#2
	PUSHAB	C7_R
	PUSHAB	C7_W2
	CALLS	#4,SHOWMEM

	CLRL	SIGCOND			; 8: ADD zero delta
	CALLS	#0,C8
	PUSHL	R0
	PUSHAB	C8_NAME
	CALLS	#2,SHOWR0
	PUSHAQ	BADTCTL
	PUSHAQ	TIMCTL
	PUSHAB	C8_R
	PUSHAB	C8_W1
	CALLS	#4,SHOWTIM
	PUSHAQ	MEMCTL
	PUSHL	#2
	PUSHAB	C8_R
	PUSHAB	C8_W2
