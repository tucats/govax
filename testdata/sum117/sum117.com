$ !
$ WRITE SYS$OUTPUT "######## MACRO"
$ WRITE SYS$OUTPUT "#### CASE M01: the default update file, SUMA.UPD"
$ MACRO/LIST=SUM$OUT:M01.LIS/OBJECT=SUM$OUT:M01.OBJ SUMA/UPDATE
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M02: a named update file"
$ MACRO/LIST=SUM$OUT:M02.LIS/OBJECT=SUM$OUT:M02.OBJ SUMA/UPDATE=M02
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M03: two update files merged"
$ MACRO/LIST=SUM$OUT:M03.LIS/OBJECT=SUM$OUT:M03.OBJ SUMA/UPDATE=(M03A,M03B)
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M04: /UPDATE on the first of a list"
$ MACRO SUMA/UPDATE=M04/LIST=SUM$OUT:M04A.LIS/OBJECT=SUM$OUT:M04A.OBJ,SUMB/LIST=SUM$OUT:M04B.LIS/OBJECT=SUM$OUT:M04B.OBJ
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M05: /UPDATE on the first of a concatenation"
$ MACRO/LIST=SUM$OUT:M05.LIS/OBJECT=SUM$OUT:M05.OBJ SUMP/UPDATE=M05+SUMA
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M06: an update that makes an error"
$ MACRO/LIST=SUM$OUT:M06.LIS/OBJECT=SUM$OUT:M06.OBJ SUMA/UPDATE=M06
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M07: a missing update file"
$ MACRO/LIST=SUM$OUT:M07.LIS/OBJECT=SUM$OUT:M07.OBJ SUMB/UPDATE
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M08: /NOUPDATE after /UPDATE"
$ MACRO/LIST=SUM$OUT:M08.LIS/OBJECT=SUM$OUT:M08.OBJ SUMA/UPDATE=M02/NOUPDATE
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M09: /UPDATE with no listing"
$ MACRO/NOLIST/OBJECT=SUM$OUT:M09.OBJ SUMA/UPDATE=M02
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M10: audit trails in the listing"
$ MACRO/LIST=SUM$OUT:M10.LIS/OBJECT=SUM$OUT:M10.OBJ SUMA/UPDATE=M10
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M11: /UPDATE after the verb"
$ MACRO/UPDATE=M02/LIST=SUM$OUT:M11.LIS/OBJECT=SUM$OUT:M11.OBJ SUMA
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M12: the audit trail suppressed and enabled"
$ MACRO/LIST=SUM$OUT:M12.LIS/OBJECT=SUM$OUT:M12.OBJ SUMA/UPDATE=M12
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M13: an update file of SUMSLP syntax errors"
$ MACRO/LIST=SUM$OUT:M13.LIS/OBJECT=SUM$OUT:M13.OBJ SUMA/UPDATE=Y08
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M14: /UPDATE with /DEBUG"
$ MACRO/DEBUG/LIST=SUM$OUT:M14.LIS/OBJECT=SUM$OUT:M14.OBJ SUMA/UPDATE=M02
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M15: no /UPDATE: the plain listing beside M02's"
$ MACRO/LIST=SUM$OUT:M15.LIS/OBJECT=SUM$OUT:M15.OBJ SUMA
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE M16: /UPDATE with a missing and a present file"
$ MACRO/LIST=SUM$OUT:M16.LIS/OBJECT=SUM$OUT:M16.OBJ SUMA/UPDATE=(NOSUCH,M02)
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ !
$ WRITE SYS$OUTPUT "######## THE OUTPUTS"
$ DIRECTORY/SIZE/DATE SUM$OUT:
$ SET DEFAULT SUM$TOP:[SUM117]
$ WRITE SYS$OUTPUT "SUM117 FINISHED"
$ SET NOVERIFY
$ EXIT
