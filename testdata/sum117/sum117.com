$ ! SUM117.COM - Phase 117's probe of SUMSLP (EDIT/SUM) and MACRO/UPDATE.
$ ! Written by testdata/sum117/gen.go. Run it as SYSTEM, with the
$ ! exchange volume mounted, from its [SUM117] directory:
$ !
$ !     $ SET DEFAULT DUA1:[SUM117]
$ !     $ @SUM117/OUTPUT=SUM117.LOG
$ !
$ ! It makes its outputs in [SUM117.OUT] and [SUM117.SCR], and writes each
$ ! step's status to the log. It changes nothing outside [SUM117...].
$ !
$ SET NOON
$ SET VERIFY
$ WRITE SYS$OUTPUT "######## ENVIRONMENT"
$ WRITE SYS$OUTPUT F$GETSYI("VERSION"), " ", F$GETSYI("HW_NAME"), " ", F$GETSYI("NODENAME")
$ WRITE SYS$OUTPUT F$TIME()
$ TOP = F$PARSE("[000000]",,,"DEVICE")
$ DEFINE SUM$TOP 'TOP'
$ DEFINE SUM$OUT SUM$TOP:[SUM117.OUT]
$ DEFINE SUM$SCR SUM$TOP:[SUM117.SCR]
$ SHOW LOGICAL SUM$TOP
$ IF F$SEARCH("SUM$TOP:[SUM117]OUT.DIR") .EQS. "" THEN CREATE/DIRECTORY SUM$TOP:[SUM117.OUT]
$ IF F$SEARCH("SUM$TOP:[SUM117]SCR.DIR") .EQS. "" THEN CREATE/DIRECTORY SUM$TOP:[SUM117.SCR]
$ DELETE SUM$TOP:[SUM117.OUT]*.*;*/NOLOG
$ DELETE SUM$TOP:[SUM117.SCR]*.*;*/NOLOG
$ SET DEFAULT SUM$TOP:[SUM117.IN]
$ SHOW DEFAULT
$ DIRECTORY/SIZE S10.SRC
$ TYPE S10.SRC
$ !
$ WRITE SYS$OUTPUT "######## HELP"
$ WRITE SYS$OUTPUT "#### CASE H01: HELP EDIT /SUM, every subtopic"
$ HELP/NOPROMPT EDIT /SUM...
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE H02: HELP SUMSLP, every subtopic"
$ HELP/NOPROMPT SUMSLP...
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE H03: HELP EDIT, the topic's own text and subtopic list"
$ HELP/NOPROMPT EDIT
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE H04: HELP MACRO /UPDATE"
$ HELP/NOPROMPT MACRO /UPDATE...
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE H05: HELP/MESSAGE of the SUM facility"
$ HELP/MESSAGE/FACILITY=SUM
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE H06: HELP/MESSAGE of the SUMSLP facility"
$ HELP/MESSAGE/FACILITY=SUMSLP
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ !
$ WRITE SYS$OUTPUT "######## COMMAND"
$ WRITE SYS$OUTPUT "#### CASE C01: an update file named without its type (.UPD the default)"
$ EDIT/SUM/OUTPUT=SUM$OUT:C01.OUT/LISTING=SUM$OUT:C01.LIS S10.SRC/UPDATE=C01
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE C02: a bare /UPDATE: the input's name, type .UPD"
$ EDIT/SUM/OUTPUT=SUM$OUT:C02.OUT/LISTING=SUM$OUT:C02.LIS S10.SRC/UPDATE
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE C03: no /UPDATE: the input copied, and its numbered listing"
$ EDIT/SUM/OUTPUT=SUM$OUT:C03.OUT/LISTING=SUM$OUT:C03.LIS S10.SRC
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE C04: three update files, defaults from the one before (C04C is .ENH)"
$ EDIT/SUM/OUTPUT=SUM$OUT:C04.OUT/LISTING=SUM$OUT:C04.LIS S10.SRC/UPDATE=(C04A,C04B.ENH,C04C)
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE C05: /UPDATE after the verb (the manual: a file qualifier only)"
$ EDIT/SUM/UPDATE=C01/OUTPUT=SUM$OUT:C05.OUT/LISTING=SUM$OUT:C05.LIS S10.SRC
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE C06: /LISTING after the file (the manual: a command qualifier only)"
$ EDIT/SUM/OUTPUT=SUM$OUT:C06.OUT S10.SRC/LISTING=SUM$OUT:C06.LIS/UPDATE=C01
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE C07: /OUTPUT after the file"
$ EDIT/SUM/LISTING=SUM$OUT:C07.LIS S10.SRC/OUTPUT=SUM$OUT:C07.OUT/UPDATE=C01
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE C08: no /OUTPUT: the output's name (S10.SRC;2, the manual says)"
$ COPY S10.SRC SUM$SCR:
$ COPY C01.UPD SUM$SCR:
$ COPY S10.UPD SUM$SCR:
$ SET DEFAULT SUM$SCR:
$ EDIT/SUM S10.SRC/UPDATE=C01
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ DIRECTORY/SIZE/DATE SUM$SCR:
$ SET DEFAULT SUM$TOP:[SUM117.IN]
$ IF F$SEARCH("SUM$SCR:S10.SRC;2") .NES. "" THEN COPY SUM$SCR:S10.SRC;2 SUM$OUT:C08.K1
$ DELETE SUM$SCR:*.*;*/NOLOG
$ WRITE SYS$OUTPUT "#### CASE C09: a bare /LISTING: the listing's name (S10.LIS)"
$ COPY S10.SRC SUM$SCR:
$ COPY C01.UPD SUM$SCR:
$ COPY S10.UPD SUM$SCR:
$ SET DEFAULT SUM$SCR:
$ EDIT/SUM/LISTING S10.SRC/UPDATE=C01
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ DIRECTORY/SIZE/DATE SUM$SCR:
$ SET DEFAULT SUM$TOP:[SUM117.IN]
$ IF F$SEARCH("SUM$SCR:S10.LIS;1") .NES. "" THEN COPY SUM$SCR:S10.LIS;1 SUM$OUT:C09.K1
$ IF F$SEARCH("SUM$SCR:S10.SRC;2") .NES. "" THEN COPY SUM$SCR:S10.SRC;2 SUM$OUT:C09.K2
$ DELETE SUM$SCR:*.*;*/NOLOG
$ WRITE SYS$OUTPUT "#### CASE C10: a bare /OUTPUT"
$ COPY S10.SRC SUM$SCR:
$ COPY C01.UPD SUM$SCR:
$ COPY S10.UPD SUM$SCR:
$ SET DEFAULT SUM$SCR:
$ EDIT/SUM/OUTPUT S10.SRC/UPDATE=C01
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ DIRECTORY/SIZE/DATE SUM$SCR:
$ SET DEFAULT SUM$TOP:[SUM117.IN]
$ IF F$SEARCH("SUM$SCR:S10.SRC;2") .NES. "" THEN COPY SUM$SCR:S10.SRC;2 SUM$OUT:C10.K1
$ DELETE SUM$SCR:*.*;*/NOLOG
$ WRITE SYS$OUTPUT "#### CASE C11: /NOOUTPUT with a listing"
$ COPY S10.SRC SUM$SCR:
$ COPY C01.UPD SUM$SCR:
$ COPY S10.UPD SUM$SCR:
$ SET DEFAULT SUM$SCR:
$ EDIT/SUM/NOOUTPUT/LISTING S10.SRC/UPDATE=C01
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ DIRECTORY/SIZE/DATE SUM$SCR:
$ SET DEFAULT SUM$TOP:[SUM117.IN]
$ IF F$SEARCH("SUM$SCR:S10.LIS;1") .NES. "" THEN COPY SUM$SCR:S10.LIS;1 SUM$OUT:C11.K1
$ IF F$SEARCH("SUM$SCR:S10.SRC;2") .NES. "" THEN COPY SUM$SCR:S10.SRC;2 SUM$OUT:C11.K2
$ DELETE SUM$SCR:*.*;*/NOLOG
$ WRITE SYS$OUTPUT "#### CASE C12: /OUTPUT naming only a type"
$ COPY S10.SRC SUM$SCR:
$ COPY C01.UPD SUM$SCR:
$ COPY S10.UPD SUM$SCR:
$ SET DEFAULT SUM$SCR:
$ EDIT/SUM/OUTPUT=.NEW/LISTING=.LST S10.SRC/UPDATE=C01
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ DIRECTORY/SIZE/DATE SUM$SCR:
$ SET DEFAULT SUM$TOP:[SUM117.IN]
$ IF F$SEARCH("SUM$SCR:S10.NEW;1") .NES. "" THEN COPY SUM$SCR:S10.NEW;1 SUM$OUT:C12.K1
$ IF F$SEARCH("SUM$SCR:S10.LST;1") .NES. "" THEN COPY SUM$SCR:S10.LST;1 SUM$OUT:C12.K2
$ DELETE SUM$SCR:*.*;*/NOLOG
$ WRITE SYS$OUTPUT "#### CASE C13: the input named with a version, ;1, and no /OUTPUT"
$ COPY S10.SRC SUM$SCR:
$ COPY C01.UPD SUM$SCR:
$ COPY S10.UPD SUM$SCR:
$ SET DEFAULT SUM$SCR:
$ EDIT/SUM S10.SRC;1/UPDATE=C01
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ DIRECTORY/SIZE/DATE SUM$SCR:
$ SET DEFAULT SUM$TOP:[SUM117.IN]
$ IF F$SEARCH("SUM$SCR:S10.SRC;2") .NES. "" THEN COPY SUM$SCR:S10.SRC;2 SUM$OUT:C13.K1
$ DELETE SUM$SCR:*.*;*/NOLOG
$ WRITE SYS$OUTPUT "#### CASE C14: a bare /UPDATE and no /OUTPUT, in the input's directory"
$ COPY S10.SRC SUM$SCR:
$ COPY C01.UPD SUM$SCR:
$ COPY S10.UPD SUM$SCR:
$ SET DEFAULT SUM$SCR:
$ EDIT/SUM S10.SRC/UPDATE
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ DIRECTORY/SIZE/DATE SUM$SCR:
$ SET DEFAULT SUM$TOP:[SUM117.IN]
$ IF F$SEARCH("SUM$SCR:S10.SRC;2") .NES. "" THEN COPY SUM$SCR:S10.SRC;2 SUM$OUT:C14.K1
$ DELETE SUM$SCR:*.*;*/NOLOG
$ WRITE SYS$OUTPUT "#### CASE C15: the input in another directory: the update file's default directory"
$ SET DEFAULT SUM$SCR:
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ EDIT/SUM/OUTPUT=SUM$OUT:C15.OUT/LISTING=SUM$OUT:C15.LIS [-.IN]S10.SRC/UPDATE=C01
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ SET DEFAULT SUM$TOP:[SUM117.IN]
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE C16: an update file in another directory, then one with no directory"
$ EDIT/SUM/OUTPUT=SUM$OUT:C16.OUT/LISTING=SUM$OUT:C16.LIS S10.SRC/UPDATE=([-.IN2]C16A,C16B)
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE C17: the input file missing"
$ EDIT/SUM/OUTPUT=SUM$OUT:C17.OUT/LISTING=SUM$OUT:C17.LIS NOSUCH.SRC/UPDATE=C01
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE C18: the update file missing"
$ EDIT/SUM/OUTPUT=SUM$OUT:C18.OUT/LISTING=SUM$OUT:C18.LIS S10.SRC/UPDATE=NOSUCH
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE C19: one of two update files missing"
$ EDIT/SUM/OUTPUT=SUM$OUT:C19.OUT/LISTING=SUM$OUT:C19.LIS S10.SRC/UPDATE=(NOSUCH,C01)
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE C20: a wildcard in the input"
$ EDIT/SUM/OUTPUT=SUM$OUT:C20.OUT/LISTING=SUM$OUT:C20.LIS S1*.SRC/UPDATE=C01
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE C21: a wildcard in an update file"
$ EDIT/SUM/OUTPUT=SUM$OUT:C21.OUT/LISTING=SUM$OUT:C21.LIS S10.SRC/UPDATE=C0*
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE C22: the same update file twice"
$ EDIT/SUM/OUTPUT=SUM$OUT:C22.OUT/LISTING=SUM$OUT:C22.LIS S10.SRC/UPDATE=(C01,C01)
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE C23: EDIT/SLP, the older name"
$ EDIT/SLP/OUTPUT=SUM$OUT:C23.OUT/LISTING=SUM$OUT:C23.LIS S10.SRC/UPDATE=C01
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE C24: /NOLISTING after /LISTING, and /NOHEADER"
$ EDIT/SUM/OUTPUT=SUM$OUT:C24.OUT/LISTING=SUM$OUT:C24.LIS/NOLISTING/NOHEADER S10.SRC/UPDATE=C01
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE C25: a qualifier SUMSLP doesn't have"
$ EDIT/SUM/READ_ONLY/OUTPUT=SUM$OUT:C25.OUT S10.SRC/UPDATE=C01
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE C26: EDIT/SUM with EDIT/TECO's qualifier"
$ EDIT/SUM/TECO/OUTPUT=SUM$OUT:C26.OUT S10.SRC/UPDATE=C01
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE C27: two input files"
$ EDIT/SUM/OUTPUT=SUM$OUT:C27.OUT S10.SRC,S03.SRC/UPDATE=C01
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE C28: the input a directory file"
$ EDIT/SUM/OUTPUT=SUM$OUT:C28.OUT [SUM117]IN.DIR/UPDATE=C01
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE C29: the update file SYS$INPUT, its lines in the procedure"
$ EDIT/SUM/OUTPUT=SUM$OUT:C29.OUT/LISTING=SUM$OUT:C29.LIS S10.SRC/UPDATE=SYS$INPUT
-3
C29 inserted after line 3
-4,4
C29 replaced line 4
/
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE C30: SYS$INPUT with no terminator: the next $ line ends it"
$ EDIT/SUM/OUTPUT=SUM$OUT:C30.OUT/LISTING=SUM$OUT:C30.LIS S10.SRC/UPDATE=SYS$INPUT
-3
C30 inserted after line 3
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE C31: the output the same file as the input, named with no version"
$ COPY S10.SRC SUM$SCR:
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ COPY C31.UPD SUM$SCR:
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ EDIT/SUM/OUTPUT=SUM$SCR:S10.SRC SUM$SCR:S10.SRC/UPDATE=SUM$SCR:C31
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ DIRECTORY/SIZE SUM$SCR:
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ COPY SUM$SCR:S10.SRC;2 SUM$OUT:C31.OUT
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ DELETE SUM$SCR:*.*;*/NOLOG
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ !
$ WRITE SYS$OUTPUT "######## BASICS"
$ WRITE SYS$OUTPUT "#### CASE B01: replace one record"
$ EDIT/SUM/OUTPUT=SUM$OUT:B01.OUT/LISTING=SUM$OUT:B01.LIS S10.SRC/UPDATE=B01
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B02: replace five with two"
$ EDIT/SUM/OUTPUT=SUM$OUT:B02.OUT/LISTING=SUM$OUT:B02.LIS S10.SRC/UPDATE=B02
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B03: replace one with three"
$ EDIT/SUM/OUTPUT=SUM$OUT:B03.OUT/LISTING=SUM$OUT:B03.LIS S10.SRC/UPDATE=B03
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B04: replace all"
$ EDIT/SUM/OUTPUT=SUM$OUT:B04.OUT/LISTING=SUM$OUT:B04.LIS S10.SRC/UPDATE=B04
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B05: insert after the first"
$ EDIT/SUM/OUTPUT=SUM$OUT:B05.OUT/LISTING=SUM$OUT:B05.LIS S10.SRC/UPDATE=B05
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B06: insert after the fifth"
$ EDIT/SUM/OUTPUT=SUM$OUT:B06.OUT/LISTING=SUM$OUT:B06.LIS S10.SRC/UPDATE=B06
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B07: insert after the last"
$ EDIT/SUM/OUTPUT=SUM$OUT:B07.OUT/LISTING=SUM$OUT:B07.LIS S10.SRC/UPDATE=B07
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B08: a bare minus (DIFFERENCES/SLP's insert at the start)"
$ EDIT/SUM/OUTPUT=SUM$OUT:B08.OUT/LISTING=SUM$OUT:B08.LIS S10.SRC/UPDATE=B08
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B09: insert after line 0"
$ EDIT/SUM/OUTPUT=SUM$OUT:B09.OUT/LISTING=SUM$OUT:B09.LIS S10.SRC/UPDATE=B09
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B10: delete one"
$ EDIT/SUM/OUTPUT=SUM$OUT:B10.OUT/LISTING=SUM$OUT:B10.LIS S10.SRC/UPDATE=B10
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B11: delete four"
$ EDIT/SUM/OUTPUT=SUM$OUT:B11.OUT/LISTING=SUM$OUT:B11.LIS S10.SRC/UPDATE=B11
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B12: delete the last"
$ EDIT/SUM/OUTPUT=SUM$OUT:B12.OUT/LISTING=SUM$OUT:B12.LIS S10.SRC/UPDATE=B12
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B13: delete all"
$ EDIT/SUM/OUTPUT=SUM$OUT:B13.OUT/LISTING=SUM$OUT:B13.LIS S10.SRC/UPDATE=B13
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B14: delete the first"
$ EDIT/SUM/OUTPUT=SUM$OUT:B14.OUT/LISTING=SUM$OUT:B14.LIS S10.SRC/UPDATE=B14
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B15: an insert, a replace, a delete"
$ EDIT/SUM/OUTPUT=SUM$OUT:B15.OUT/LISTING=SUM$OUT:B15.LIS S10.SRC/UPDATE=B15
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B16: only the terminator"
$ EDIT/SUM/OUTPUT=SUM$OUT:B16.OUT/LISTING=SUM$OUT:B16.LIS S10.SRC/UPDATE=B16
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B17: no terminator"
$ EDIT/SUM/OUTPUT=SUM$OUT:B17.OUT/LISTING=SUM$OUT:B17.LIS S10.SRC/UPDATE=B17
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B18: records after the terminator"
$ EDIT/SUM/OUTPUT=SUM$OUT:B18.OUT/LISTING=SUM$OUT:B18.LIS S10.SRC/UPDATE=B18
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B19: an empty update file"
$ EDIT/SUM/OUTPUT=SUM$OUT:B19.OUT/LISTING=SUM$OUT:B19.LIS S10.SRC/UPDATE=B19
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B20: an inserted record starting with a minus"
$ EDIT/SUM/OUTPUT=SUM$OUT:B20.OUT/LISTING=SUM$OUT:B20.LIS S10.SRC/UPDATE=B20
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B21: a minus made a character by <"
$ EDIT/SUM/OUTPUT=SUM$OUT:B21.OUT/LISTING=SUM$OUT:B21.LIS S10.SRC/UPDATE=B21
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B22: a slash made a character by <"
$ EDIT/SUM/OUTPUT=SUM$OUT:B22.OUT/LISTING=SUM$OUT:B22.LIS S10.SRC/UPDATE=B22
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B23: < made a character by <"
$ EDIT/SUM/OUTPUT=SUM$OUT:B23.OUT/LISTING=SUM$OUT:B23.LIS S10.SRC/UPDATE=B23
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B24: < before a character that is no operator"
$ EDIT/SUM/OUTPUT=SUM$OUT:B24.OUT/LISTING=SUM$OUT:B24.LIS S10.SRC/UPDATE=B24
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B25: a record starting with a backslash"
$ EDIT/SUM/OUTPUT=SUM$OUT:B25.OUT/LISTING=SUM$OUT:B25.LIS S10.SRC/UPDATE=B25
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B26: a record starting with a percent sign"
$ EDIT/SUM/OUTPUT=SUM$OUT:B26.OUT/LISTING=SUM$OUT:B26.LIS S10.SRC/UPDATE=B26
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B27: a backslash alone, then text, then a percent alone"
$ EDIT/SUM/OUTPUT=SUM$OUT:B27.OUT/LISTING=SUM$OUT:B27.LIS S10.SRC/UPDATE=B27
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B28: < making a backslash and a percent characters"
$ EDIT/SUM/OUTPUT=SUM$OUT:B28.OUT/LISTING=SUM$OUT:B28.LIS S10.SRC/UPDATE=B28
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B29: records with a leading blank, a tab, and nothing"
$ EDIT/SUM/OUTPUT=SUM$OUT:B29.OUT/LISTING=SUM$OUT:B29.LIS S10.SRC/UPDATE=B29
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B30: a record of 300 characters"
$ EDIT/SUM/OUTPUT=SUM$OUT:B30.OUT/LISTING=SUM$OUT:B30.LIS S10.SRC/UPDATE=B30
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B31: the period locator: delete line 2 (the manual's example)"
$ EDIT/SUM/OUTPUT=SUM$OUT:B31.OUT/LISTING=SUM$OUT:B31.LIS S10.SRC/UPDATE=B31
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B32: the period after a move: insert at the current line"
$ EDIT/SUM/OUTPUT=SUM$OUT:B32.OUT/LISTING=SUM$OUT:B32.LIS S10.SRC/UPDATE=B32
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE B33: a period alone"
$ EDIT/SUM/OUTPUT=SUM$OUT:B33.OUT/LISTING=SUM$OUT:B33.LIS S10.SRC/UPDATE=B33
$ S = $STATUS
