$ ! SUM117B.COM - Phase 117's probe of SUMSLP, round 2: what round 1 left
$ ! open. Written by testdata/sum117/gen.go. Run it as SYSTEM, with the
$ ! exchange volume mounted, from its [SUM117] directory:
$ !
$ !     $ SET DEFAULT DUA1:[SUM117]
$ !     $ @SUM117B/OUTPUT=SUM117B.LOG
$ !
$ SET NOON
$ SET VERIFY
$ WRITE SYS$OUTPUT "######## ENVIRONMENT"
$ WRITE SYS$OUTPUT F$GETSYI("VERSION"), " ", F$GETSYI("HW_NAME"), " ", F$GETSYI("NODENAME")
$ WRITE SYS$OUTPUT F$TIME()
$ TOP = F$PARSE("[000000]",,,"DEVICE")
$ DEFINE SUM$TOP 'TOP'
$ DEFINE SUM$OUT SUM$TOP:[SUM117.OUT]
$ DEFINE SUM$SCR SUM$TOP:[SUM117.SCR]
$ DELETE SUM$TOP:[SUM117.SCR]*.*;*/NOLOG
$ SET DEFAULT SUM$TOP:[SUM117.IN]
$ SHOW DEFAULT
$ !
$ WRITE SYS$OUTPUT "######## CLASH2"
$ WRITE SYS$OUTPUT "#### CASE KACB: G14's files in the order G14A,G14C,G14B"
$ EDIT/SUM/OUTPUT=SUM$OUT:KACB.OUT/LISTING=SUM$OUT:KACB.LIS S10.SRC/UPDATE=(G14A,G14C,G14B)
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE KBAC: G14's files in the order G14B,G14A,G14C"
$ EDIT/SUM/OUTPUT=SUM$OUT:KBAC.OUT/LISTING=SUM$OUT:KBAC.LIS S10.SRC/UPDATE=(G14B,G14A,G14C)
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE KBCA: G14's files in the order G14B,G14C,G14A"
$ EDIT/SUM/OUTPUT=SUM$OUT:KBCA.OUT/LISTING=SUM$OUT:KBCA.LIS S10.SRC/UPDATE=(G14B,G14C,G14A)
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE KCAB: G14's files in the order G14C,G14A,G14B"
$ EDIT/SUM/OUTPUT=SUM$OUT:KCAB.OUT/LISTING=SUM$OUT:KCAB.LIS S10.SRC/UPDATE=(G14C,G14A,G14B)
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE K01: a replace of 5 and a delete of 4 to 6"
$ EDIT/SUM/OUTPUT=SUM$OUT:K01.OUT/LISTING=SUM$OUT:K01.LIS S10.SRC/UPDATE=(G14A,G14B)
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE K01R: a delete of 4 to 6 and a replace of 5"
$ EDIT/SUM/OUTPUT=SUM$OUT:K01R.OUT/LISTING=SUM$OUT:K01R.LIS S10.SRC/UPDATE=(G14B,G14A)
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE K02: a replace of 5 and an insert after 5 (G04 again)"
$ EDIT/SUM/OUTPUT=SUM$OUT:K02.OUT/LISTING=SUM$OUT:K02.LIS S10.SRC/UPDATE=(G14A,G14C)
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE K03: a replace of 4 to 6 and an insert after 5"
$ EDIT/SUM/OUTPUT=SUM$OUT:K03.OUT/LISTING=SUM$OUT:K03.LIS S10.SRC/UPDATE=(K03A,K03B)
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE K03R: the same, the other order"
$ EDIT/SUM/OUTPUT=SUM$OUT:K03R.OUT/LISTING=SUM$OUT:K03R.LIS S10.SRC/UPDATE=(K03B,K03A)
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE K04: a delete of 4 to 6, a replace of 5, an insert after 6"
$ EDIT/SUM/OUTPUT=SUM$OUT:K04.OUT/LISTING=SUM$OUT:K04.LIS S10.SRC/UPDATE=(G14B,K04B,K04C)
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE K05: a delete of 3 to 7 and inserts after 5 and 4"
$ EDIT/SUM/OUTPUT=SUM$OUT:K05.OUT/LISTING=SUM$OUT:K05.LIS S10.SRC/UPDATE=(K05A,K05B,K05C)
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE K06: G14's three edits in one file"
$ EDIT/SUM/OUTPUT=SUM$OUT:K06.OUT/LISTING=SUM$OUT:K06.LIS S10.SRC/UPDATE=K06
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE K07: a delete and an insert inside it, in one file"
$ EDIT/SUM/OUTPUT=SUM$OUT:K07.OUT/LISTING=SUM$OUT:K07.LIS S10.SRC/UPDATE=K07
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE K08: a delete and a replace inside it, in one file"
$ EDIT/SUM/OUTPUT=SUM$OUT:K08.OUT/LISTING=SUM$OUT:K08.LIS S10.SRC/UPDATE=K08
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE K09: a delete of 4 to 6, a delete of 5, an insert after 5"
$ EDIT/SUM/OUTPUT=SUM$OUT:K09.OUT/LISTING=SUM$OUT:K09.LIS S10.SRC/UPDATE=(K09A,K09B,K09C)
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE K09R: the same, the other order"
$ EDIT/SUM/OUTPUT=SUM$OUT:K09R.OUT/LISTING=SUM$OUT:K09R.LIS S10.SRC/UPDATE=(K09C,K09B,K09A)
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE K10: a delete of 4 to 6, a replace of its last line, an insert after 5"
$ EDIT/SUM/OUTPUT=SUM$OUT:K10.OUT/LISTING=SUM$OUT:K10.LIS S10.SRC/UPDATE=(G14B,K10B,G14C)
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ !
$ WRITE SYS$OUTPUT "######## NUMBERS"
$ WRITE SYS$OUTPUT "#### CASE N01: 32768"
$ EDIT/SUM/OUTPUT=SUM$OUT:N01.OUT/LISTING=SUM$OUT:N01.LIS S10.SRC/UPDATE=N01
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE N02: 40000"
$ EDIT/SUM/OUTPUT=SUM$OUT:N02.OUT/LISTING=SUM$OUT:N02.LIS S10.SRC/UPDATE=N02
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE N03: 65535"
$ EDIT/SUM/OUTPUT=SUM$OUT:N03.OUT/LISTING=SUM$OUT:N03.LIS S10.SRC/UPDATE=N03
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE N04: 65536"
$ EDIT/SUM/OUTPUT=SUM$OUT:N04.OUT/LISTING=SUM$OUT:N04.LIS S10.SRC/UPDATE=N04
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE N05: 65537"
$ EDIT/SUM/OUTPUT=SUM$OUT:N05.OUT/LISTING=SUM$OUT:N05.LIS S10.SRC/UPDATE=N05
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE N06: 65541 (5 more than 65536)"
$ EDIT/SUM/OUTPUT=SUM$OUT:N06.OUT/LISTING=SUM$OUT:N06.LIS S10.SRC/UPDATE=N06
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE N07: 100000"
$ EDIT/SUM/OUTPUT=SUM$OUT:N07.OUT/LISTING=SUM$OUT:N07.LIS S10.SRC/UPDATE=N07
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE N08: 131077 (5 more than twice 65536)"
$ EDIT/SUM/OUTPUT=SUM$OUT:N08.OUT/LISTING=SUM$OUT:N08.LIS S10.SRC/UPDATE=N08
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE N09: 99999 after an insert after 3"
$ EDIT/SUM/OUTPUT=SUM$OUT:N09.OUT/LISTING=SUM$OUT:N09.LIS S10.SRC/UPDATE=N09
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE N10: a range of 99999 to 99999"
$ EDIT/SUM/OUTPUT=SUM$OUT:N10.OUT/LISTING=SUM$OUT:N10.LIS S10.SRC/UPDATE=N10
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE N11: a range of 5 to 65541"
$ EDIT/SUM/OUTPUT=SUM$OUT:N11.OUT/LISTING=SUM$OUT:N11.LIS S10.SRC/UPDATE=N11
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE N12: a range of 5 to 32768"
$ EDIT/SUM/OUTPUT=SUM$OUT:N12.OUT/LISTING=SUM$OUT:N12.LIS S10.SRC/UPDATE=N12
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE N13: six digits that are 5"
$ EDIT/SUM/OUTPUT=SUM$OUT:N13.OUT/LISTING=SUM$OUT:N13.LIS S10.SRC/UPDATE=N13
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE N14: 99999 as the second of two inserts"
$ EDIT/SUM/OUTPUT=SUM$OUT:N14.OUT/LISTING=SUM$OUT:N14.LIS S10.SRC/UPDATE=N14
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ !
$ WRITE SYS$OUTPUT "######## PASTEND"
$ WRITE SYS$OUTPUT "#### CASE E01: a replace of line 11 alone"
$ EDIT/SUM/OUTPUT=SUM$OUT:E01.OUT/LISTING=SUM$OUT:E01.LIS S10.SRC/UPDATE=E01
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE E02: a replace of 10 to 11"
$ EDIT/SUM/OUTPUT=SUM$OUT:E02.OUT/LISTING=SUM$OUT:E02.LIS S10.SRC/UPDATE=E02
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE E03: a replace of 10 to 12"
$ EDIT/SUM/OUTPUT=SUM$OUT:E03.OUT/LISTING=SUM$OUT:E03.LIS S10.SRC/UPDATE=E03
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE E04: a delete of 11 to 12, no text"
$ EDIT/SUM/OUTPUT=SUM$OUT:E04.OUT/LISTING=SUM$OUT:E04.LIS S10.SRC/UPDATE=E04
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE E05: a replace of 2 to 5 on three lines"
$ EDIT/SUM/OUTPUT=SUM$OUT:E05.OUT/LISTING=SUM$OUT:E05.LIS S03.SRC/UPDATE=E05
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE E06: a replace of 2 to 9 on three lines"
$ EDIT/SUM/OUTPUT=SUM$OUT:E06.OUT/LISTING=SUM$OUT:E06.LIS S03.SRC/UPDATE=E06
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE E07: a replace of 4 to 4 on three lines"
$ EDIT/SUM/OUTPUT=SUM$OUT:E07.OUT/LISTING=SUM$OUT:E07.LIS S03.SRC/UPDATE=E07
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE E08: an insert after 4 on three lines"
$ EDIT/SUM/OUTPUT=SUM$OUT:E08.OUT/LISTING=SUM$OUT:E08.LIS S03.SRC/UPDATE=E08
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE E09: a replace past the end, then an insert after it"
$ EDIT/SUM/OUTPUT=SUM$OUT:E09.OUT/LISTING=SUM$OUT:E09.LIS S03.SRC/UPDATE=E09
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE E10: a replace past the end, then a replace of the reread"
$ EDIT/SUM/OUTPUT=SUM$OUT:E10.OUT/LISTING=SUM$OUT:E10.LIS S03.SRC/UPDATE=E10
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE E11: an insert after 10, then after 11"
$ EDIT/SUM/OUTPUT=SUM$OUT:E11.OUT/LISTING=SUM$OUT:E11.LIS S10.SRC/UPDATE=E11
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE E12: the last line deleted, then an insert after 11"
$ EDIT/SUM/OUTPUT=SUM$OUT:E12.OUT/LISTING=SUM$OUT:E12.LIS S10.SRC/UPDATE=E12
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE E13: a replace of 1 to 4 on three lines"
$ EDIT/SUM/OUTPUT=SUM$OUT:E13.OUT/LISTING=SUM$OUT:E13.LIS S03.SRC/UPDATE=E13
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE E14: an empty input, a replace of 1 to 1"
$ EDIT/SUM/OUTPUT=SUM$OUT:E14.OUT/LISTING=SUM$OUT:E14.LIS EMPTY.SRC/UPDATE=E14
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE E15: an empty input, an insert after 1"
$ EDIT/SUM/OUTPUT=SUM$OUT:E15.OUT/LISTING=SUM$OUT:E15.LIS EMPTY.SRC/UPDATE=E15
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ !
$ WRITE SYS$OUTPUT "######## LENGTHS"
$ WRITE SYS$OUTPUT "#### CASE W132: an update record of 132 bytes"
$ EDIT/SUM/OUTPUT=SUM$OUT:W132.OUT/LISTING=SUM$OUT:W132.LIS S10.SRC/UPDATE=W132
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE W133: an update record of 133 bytes"
$ EDIT/SUM/OUTPUT=SUM$OUT:W133.OUT/LISTING=SUM$OUT:W133.LIS S10.SRC/UPDATE=W133
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE W255: an update record of 255 bytes"
$ EDIT/SUM/OUTPUT=SUM$OUT:W255.OUT/LISTING=SUM$OUT:W255.LIS S10.SRC/UPDATE=W255
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE W256: an update record of 256 bytes"
$ EDIT/SUM/OUTPUT=SUM$OUT:W256.OUT/LISTING=SUM$OUT:W256.LIS S10.SRC/UPDATE=W256
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE W257: an update record of 257 bytes"
$ EDIT/SUM/OUTPUT=SUM$OUT:W257.OUT/LISTING=SUM$OUT:W257.LIS S10.SRC/UPDATE=W257
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE W511: an update record of 511 bytes"
$ EDIT/SUM/OUTPUT=SUM$OUT:W511.OUT/LISTING=SUM$OUT:W511.LIS S10.SRC/UPDATE=W511
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE W512: an update record of 512 bytes"
$ EDIT/SUM/OUTPUT=SUM$OUT:W512.OUT/LISTING=SUM$OUT:W512.LIS S10.SRC/UPDATE=W512
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE W513: an update record of 513 bytes"
$ EDIT/SUM/OUTPUT=SUM$OUT:W513.OUT/LISTING=SUM$OUT:W513.LIS S10.SRC/UPDATE=W513
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE X00255: a source record of 255 bytes"
$ EDIT/SUM/OUTPUT=SUM$OUT:X00255.OUT/LISTING=SUM$OUT:X00255.LIS X00255.SRC/UPDATE=B05
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE X00256: a source record of 256 bytes"
$ EDIT/SUM/OUTPUT=SUM$OUT:X00256.OUT/LISTING=SUM$OUT:X00256.LIS X00256.SRC/UPDATE=B05
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE X00257: a source record of 257 bytes"
$ EDIT/SUM/OUTPUT=SUM$OUT:X00257.OUT/LISTING=SUM$OUT:X00257.LIS X00257.SRC/UPDATE=B05
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE X00512: a source record of 512 bytes"
$ EDIT/SUM/OUTPUT=SUM$OUT:X00512.OUT/LISTING=SUM$OUT:X00512.LIS X00512.SRC/UPDATE=B05
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE X00513: a source record of 513 bytes"
$ EDIT/SUM/OUTPUT=SUM$OUT:X00513.OUT/LISTING=SUM$OUT:X00513.LIS X00513.SRC/UPDATE=B05
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE X01024: a source record of 1024 bytes"
$ EDIT/SUM/OUTPUT=SUM$OUT:X01024.OUT/LISTING=SUM$OUT:X01024.LIS X01024.SRC/UPDATE=B05
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE X02048: a source record of 2048 bytes"
$ EDIT/SUM/OUTPUT=SUM$OUT:X02048.OUT/LISTING=SUM$OUT:X02048.LIS X02048.SRC/UPDATE=B05
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE X04096: a source record of 4096 bytes"
$ EDIT/SUM/OUTPUT=SUM$OUT:X04096.OUT/LISTING=SUM$OUT:X04096.LIS X04096.SRC/UPDATE=B05
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE X08192: a source record of 8192 bytes"
$ EDIT/SUM/OUTPUT=SUM$OUT:X08192.OUT/LISTING=SUM$OUT:X08192.LIS X08192.SRC/UPDATE=B05
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE X16384: a source record of 16384 bytes"
$ EDIT/SUM/OUTPUT=SUM$OUT:X16384.OUT/LISTING=SUM$OUT:X16384.LIS X16384.SRC/UPDATE=B05
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE X32767: a source record of 32767 bytes"
$ EDIT/SUM/OUTPUT=SUM$OUT:X32767.OUT/LISTING=SUM$OUT:X32767.LIS X32767.SRC/UPDATE=B05
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ !
$ WRITE SYS$OUTPUT "######## PAGES"
$ WRITE SYS$OUTPUT "#### CASE P01: messages at the end of page 1"
$ EDIT/SUM/OUTPUT=SUM$OUT:P01.OUT/LISTING=SUM$OUT:P01.LIS P120.SRC/UPDATE=(P01A,P01B)
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE P02: 70 records inserted across a page"
$ EDIT/SUM/OUTPUT=SUM$OUT:P02.OUT/LISTING=SUM$OUT:P02.LIS P120.SRC/UPDATE=P02
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE P03: a deletion across a page break"
$ EDIT/SUM/OUTPUT=SUM$OUT:P03.OUT/LISTING=SUM$OUT:P03.LIS P120.SRC/UPDATE=P03
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE P04: a long name in the heading"
$ EDIT/SUM/OUTPUT=SUM$OUT:P04.OUT/LISTING=SUM$OUT:P04.LIS -
[SUM117.IN.A_LONG_DIRECTORY_NAME_OF_THIRTY_NINE_CH]LONG_FILE_NAME_OF_THIRTY_NINE_CHARACTER.LONG_TYPE_OF_THIRTY_NINE_CHARACTERS_XYZ-
/UPDATE=[SUM117.IN]C01
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ !
$ WRITE SYS$OUTPUT "######## SLPVERB"
$ WRITE SYS$OUTPUT "#### CASE V01: HELP EDIT /SLP"
$ HELP/NOPROMPT EDIT /SLP
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE V02: EDIT/SLP with no other qualifier, its input empty"
$ COPY S10.SRC SUM$SCR:
$ SET DEFAULT SUM$SCR:
$ EDIT/SLP S10.SRC
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ DIRECTORY/SIZE SUM$SCR:
$ SET DEFAULT SUM$TOP:[SUM117.IN]
$ DELETE SUM$SCR:*.*;*/NOLOG
$ WRITE SYS$OUTPUT "#### CASE V03: EDIT/SLP/OUTPUT"
$ COPY S10.SRC SUM$SCR:
$ SET DEFAULT SUM$SCR:
$ EDIT/SLP/OUTPUT=SUM$OUT:V03.OUT S10.SRC
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ DIRECTORY/SIZE SUM$SCR:
$ SET DEFAULT SUM$TOP:[SUM117.IN]
$ DELETE SUM$SCR:*.*;*/NOLOG
$ WRITE SYS$OUTPUT "#### CASE V04: EDIT/SLP/SUM"
$ EDIT/SLP/SUM/OUTPUT=SUM$OUT:V04.OUT S10.SRC/UPDATE=C01
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE V05: EDIT/SU, an abbreviation"
$ EDIT/SU/OUTPUT=SUM$OUT:V05.OUT S10.SRC/UPDATE=C01
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ WRITE SYS$OUTPUT "#### CASE V06: EDIT/S, an abbreviation"
$ EDIT/S/OUTPUT=SUM$OUT:V06.OUT S10.SRC/UPDATE=C01
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ !
$ WRITE SYS$OUTPUT "######## DATES"
$ WRITE SYS$OUTPUT "#### CASE D01: the listing's dates for an input revised after its creation"
$ COPY S10.SRC SUM$SCR:D01.SRC
$ WAIT 00:00:03
$ OPEN/APPEND D01F SUM$SCR:D01.SRC
$ WRITE D01F "appended"
$ CLOSE D01F
$ DIRECTORY/FULL SUM$SCR:D01.SRC
$ EDIT/SUM/OUTPUT=SUM$OUT:D01.OUT/LISTING=SUM$OUT:D01.LIS SUM$SCR:D01.SRC/UPDATE=C01
$ S = $STATUS
$ WRITE SYS$OUTPUT "STATUS ", S, " ", F$MESSAGE(S)
$ DELETE SUM$SCR:*.*;*/NOLOG
$ !
$ WRITE SYS$OUTPUT "######## THE OUTPUTS"
$ DIRECTORY/SIZE/DATE SUM$OUT:
$ SET DEFAULT SUM$TOP:[SUM117]
$ WRITE SYS$OUTPUT "SUM117B FINISHED"
$ SET NOVERIFY
$ EXIT
