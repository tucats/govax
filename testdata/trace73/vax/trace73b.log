$ ! TRACE73B.COM - round 2 of Phase 73's probe of the trace trap
$ ! (testdata/trace73/README.md): what part G of round 1 left open. Run
$ ! it with the exchange volume's [000000] as the default directory:
$ !
$ !     @TRACE73B/OUTPUT=TRACE73B.LOG
$ !
$ SET NOON
$ SET VERIFY
$ WRITE SYS$OUTPUT F$GETSYI("VERSION"), " ", F$GETSYI("HW_NAME")
V7.1     VAX 8600
$ MACRO TRACE73B
$ LINK/MAP=TRACE73B/FULL TRACE73B
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ LIST = "S,G,L,M"
$ IF P1 .NES. "" THEN LIST = P1
$ I = 0
$ LOOP:
$   P = F$ELEMENT(I, ",", LIST)
$   IF P .EQS. "," THEN GOTO DONE
$   DEFINE TRACE73B_PART S
$   RUN TRACE73B
S LIB$SIGNAL from untraced code
  the part returned
  exit status 00000001
  traces: tracer 0, outer 0; records 1
  AST calls 0, AST PSL 00000000; BEQL fell through 0
  T 00000870 CODE+0570 PSL=03C00000 handler=03C00000
$   SHOW SYMBOL $STATUS
  $STATUS == "%X00000001"
$   I = I + 1
$   GOTO LOOP
$ LOOP:
$   P = F$ELEMENT(I, ",", LIST)
$   IF P .EQS. "," THEN GOTO DONE
$   DEFINE TRACE73B_PART G
%DCL-I-SUPERSEDE, previous value of TRACE73B_PART has been superseded
$   RUN TRACE73B
