! STEP
!stepped to TRACE73\TRACER\%LINE 233
!   233:         CMPL    4(R1),#SS$_UNWIND
! STEP
!stepped to TRACE73\TRACER\%LINE 234
!   234:         BNEQ    1$
! EXAMINE PSL
!TRACE73\TRACER\%PSL:    
!        CMP TP FPD IS CURMOD PRVMOD IPL DV FU IV T N Z V C
!         0   0  0   0  USER   USER    0  0  0  0 0 1 0 0 1
! GO
!break at routine TRACE73\TRACER
!   232:         MOVL    4(AP),R1                ; the signal array
