$ ! PG64X.COM - round 2 of Phase 64's probe (testdata/pg64/README.md):
$ ! where VMS's modified page writer stops. Run it, from SYSTEM, with the
$ ! exchange volume's [000000] as the default directory:
$ !
$ !     @PG64X/OUTPUT=PG64X.LOG
$ !
$ ! PG64X.LOG gets this procedure's log; PG64X.OUT the program's part X
$ ! (part W's sweeps, timed, in chunks); PG64M.LOG the monitor's samples
$ ! of SHOW MEMORY/PHYSICAL_PAGES, one a second; PG64X_BUILD.LOG MACRO's
$ ! and LINK's messages.
$ SET NOON
$ SET VERIFY
$ WRITE SYS$OUTPUT F$GETSYI("VERSION"), " ", F$GETSYI("HW_NAME")
$ RUN SYS$SYSTEM:SYSGEN
USE ACTIVE
SHOW MPW_HILIMIT
SHOW MPW_LOLIMIT
SHOW MPW_WAITLIMIT
SHOW MPW_LOWAITLIMIT
SHOW MPW_THRESH
SHOW MPW_WRTCLUSTER
SHOW MPW_IOLIMIT
SHOW MPW_PRIO
SHOW FREELIM
SHOW FREEGOAL
SHOW GROWLIM
SHOW BORROWLIM
EXIT
$ SHOW MEMORY/PHYSICAL_PAGES
$ SHOW MEMORY/FILES
$ DEFINE/USER_MODE SYS$OUTPUT PG64X_BUILD.LOG
$ DEFINE/USER_MODE SYS$ERROR PG64X_BUILD.LOG
$ MACRO/NOLIST PG64
$ DEFINE/USER_MODE SYS$OUTPUT PG64X_BUILD.LOG
$ DEFINE/USER_MODE SYS$ERROR PG64X_BUILD.LOG
$ LINK/NOMAP PG64
$ !
$ ! The monitor runs until PG64_DONE is defined in the job table, at most
$ ! five minutes; five seconds of samples come before the program.
$ !
$ IF F$TRNLNM("PG64_DONE","LNM$JOB") .NES. "" THEN DEASSIGN/JOB PG64_DONE
$ SPAWN/NOWAIT/OUTPUT=PG64M.LOG @PG64M
$ WAIT 00:00:05
$ DEFINE PG64_PART X
$ DEFINE/USER_MODE SYS$OUTPUT PG64X.OUT
$ RUN PG64
$ SHOW SYMBOL $STATUS
$ WAIT 00:00:10
$ DEFINE/JOB PG64_DONE YES
$ WAIT 00:00:05
$ DEASSIGN/JOB PG64_DONE
$ DEASSIGN PG64_PART
$ SHOW MEMORY/PHYSICAL_PAGES
$ SHOW MEMORY/FILES
$ TYPE PG64X.OUT
$ TYPE PG64M.LOG
$ SET NOVERIFY
$ EXIT
