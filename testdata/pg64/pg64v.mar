	.TITLE	PG64V	Phase 64 page file probe: LIB$GET_VM
	.IDENT	/V1.0/
;
; Phase 64's probe (README.md), the case that needs LIBRTL, in a program
; of its own so that LIBRTL's pages aren't in PG64's counts: LIB$GET_VM's
; charges to the page file quota, and its status when the quota can't
; cover a request. Lines as PG64's: statuses in hexadecimal, the pages
; charged as differences.
;
	$SSDEF
	$JPIDEF

	.PSECT	DATA,NOEXE,WRT,PAGE

OFAB:	$FAB	FNM=<SYS$OUTPUT>,RAT=CR,RFM=VAR,FAC=PUT
ORAB:	$RAB	FAB=OFAB,RBF=OBUF
OBUF:	.BLKB	200
OUTD:	.LONG	200
	.ADDRESS OBUF
OUTLEN:	.WORD	0,0
PRM:	.BLKL	8

	.ALIGN	LONG
JPILST:	.WORD	4,JPI$_PAGFILCNT
	.ADDRESS CNT
	.LONG	0
	.LONG	0
CNT:	.LONG	0
JIOSB:	.QUAD	0

BYTES:	.LONG	0
ADDR:	.LONG	0
C0:	.LONG	0
C1:	.LONG	0

T_V1:	.ASCID	/V1 get_vm !UL pages: !XL charged=!SL/
T_V2:	.ASCID	/V2 get_vm pagfilcnt+10 pages: !XL charged=!SL pagfilcnt then !SL/

	.PSECT	CODE,EXE,NOWRT,PAGE
	.ENTRY	START,^M<R2,R3,R4,R5,R6,R7>
	$CREATE	FAB=OFAB
	$CONNECT RAB=ORAB
; 100 pages, then 400 (the heap grows in chunks of its own).
	PUSHL	#100
	CALLS	#1,GETR
	PUSHL	#400
	CALLS	#1,GETR
; More than the quota allows.
	BSBW	COUNT
	MOVL	CNT,C0
	ADDL3	#10,CNT,R6
	MULL3	#512,R6,BYTES
	PUSHAL	ADDR
	PUSHAL	BYTES
	CALLS	#2,G^LIB$GET_VM
	MOVL	R0,PRM
	BSBW	COUNT
	SUBL3	CNT,C0,R6
	SUBL3	C0,R6,PRM+4
	MOVL	CNT,PRM+8
	MOVAQ	T_V2,R2
	BSBW	SAY
	MOVL	#SS$_NORMAL,R0
	RET

; GETR pages: LIB$GET_VM of that many pages' bytes, and the charge.
	.ENTRY	GETR,^M<R2,R3,R4,R5>
	BSBW	COUNT
	MOVL	CNT,C0
	MULL3	#512,4(AP),BYTES
	PUSHAL	ADDR
	PUSHAL	BYTES
	CALLS	#2,G^LIB$GET_VM
	MOVL	4(AP),PRM
	MOVL	R0,PRM+4
	BSBW	COUNT
	SUBL3	CNT,C0,PRM+8
	MOVAQ	T_V1,R2
	BSBW	SAY
	RET

; COUNT: CNT = JPI$_PAGFILCNT.
COUNT:	$GETJPIW_S ITMLST=JPILST, IOSB=JIOSB
	RSB

; SAY: write the line the control string at R2 makes of PRM.
SAY:	MOVL	#200,OUTD
	$FAOL_S	CTRSTR=(R2), OUTLEN=OUTLEN, OUTBUF=OUTD, PRMLST=PRM
	MOVW	OUTLEN,ORAB+RAB$W_RSZ
	$PUT	RAB=ORAB
	RSB

	.END	START
