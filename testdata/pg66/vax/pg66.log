$ DEFINE/USER_MODE SYS$OUTPUT PG66L2.LOG
$ DEFINE/USER_MODE SYS$ERROR PG66L2.LOG
$ LINK/NOTRACEBACK/MAP=PG66C/FULL/EXECUTABLE=PG66C PG66,PG66C/OPTIONS
$ DIRECTORY/SIZE=ALL PG66*.EXE

Directory DUA1:[000000]

PG66.EXE;1               113/113    
PG66C.EXE;1              113/113    

Total of 2 files, 226/226 blocks.
$ !
$ ! Part A: the activation, from each image, PG66.EXE twice in a row.
$ !
$ CALL RUNA PG66 R1
$ RUNA: SUBROUTINE
$ DEFINE PG66_PART A
$ DEFINE PG66_IMAGE PG66.EXE
$ f0 = F$GETJPI("","PAGEFLTS")
$ c0 = F$GETJPI("","PAGFILCNT")
$ g0 = F$GETJPI("","PPGCNT")
$ DEFINE PG66_FLTS 37875
$ DEFINE PG66_CNT 39799
$ DEFINE PG66_PPG 313
$ DEFINE/USER_MODE SYS$OUTPUT PG66R1.OUT
$ RUN PG66
$ s = $STATUS
$ f1 = F$GETJPI("","PAGEFLTS")
$ c1 = F$GETJPI("","PAGFILCNT")
$ g1 = F$GETJPI("","PPGCNT")
$ WRITE SYS$OUTPUT P2, " ", P1, " around RUN: status=", s, " flts=", f1 - f0, -
	" charged=", c0 - c1, " ppg=", g1 - g0
R1 PG66 around RUN: status=%X00000001 flts=156 charged=0 ppg=-15
$ ENDSUBROUTINE
$ CALL RUNA PG66 R2
$ RUNA: SUBROUTINE
