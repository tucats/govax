$ WAITEND:
$ IF F$SEARCH("PG66D.END") .NES. "" THEN GOTO ENDED
$ WAIT 00:00:01
$ n = n + 1
$ IF n .LT. 60 THEN GOTO WAITEND
$ WAITEND:
$ IF F$SEARCH("PG66D.END") .NES. "" THEN GOTO ENDED
$ WAIT 00:00:01
$ n = n + 1
$ IF n .LT. 60 THEN GOTO WAITEND
$ WAITEND:
$ IF F$SEARCH("PG66D.END") .NES. "" THEN GOTO ENDED
$ WAIT 00:00:01
$ n = n + 1
$ IF n .LT. 60 THEN GOTO WAITEND
$ WAITEND:
$ IF F$SEARCH("PG66D.END") .NES. "" THEN GOTO ENDED
$ WAIT 00:00:01
$ n = n + 1
$ IF n .LT. 60 THEN GOTO WAITEND
$ WAITEND:
$ IF F$SEARCH("PG66D.END") .NES. "" THEN GOTO ENDED
$ WAIT 00:00:01
$ n = n + 1
$ IF n .LT. 60 THEN GOTO WAITEND
$ WAITEND:
$ IF F$SEARCH("PG66D.END") .NES. "" THEN GOTO ENDED
$ WAIT 00:00:01
