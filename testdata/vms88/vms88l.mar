	.TITLE	VMS88L	What the phase doc left open on RMS (Phase 88, subtask 15)
;
; Each answer printed by name. On indexed files, A to D are the place a keyed $FIND
; leaves, what $PUT in sequence remembers, $TRUNCATE, and a value's last SIDR pointer;
; E is two streams' locks on each organization, by what each stream may do; F a
; stream asking again for a record it holds.
;
	$FABDEF
	$RABDEF
	$RMSDEF

	.PSECT	DATA,WRT,NOEXE,LONG
	.ALIGN	LONG
KEY0:	$XABKEY	REF=0,DTP=STG,POS=<0>,SIZ=<4>,NXT=KEY1
	.ALIGN	LONG
KEY1:	$XABKEY	REF=1,DTP=STG,POS=<4>,SIZ=<4>
FAB:	$FAB	FNM=<L.IDX>,ORG=IDX,RFM=FIX,MRS=8,FAC=<GET,PUT,UPD,DEL,TRN>,-
		SHR=<GET,PUT,UPD,DEL>,XAB=KEY0
RAB:	$RAB	FAB=FAB,UBF=BUF,USZ=8,RBF=REC,RSZ=8,KBF=REC,KSZ=4
BUF:	.BLKB	8
REC:	.BLKB	8
RELNUM:	.LONG	0

; Part E's files and streams.
FABS:	$FAB	FNM=<E.SEQ>,ORG=SEQ,RFM=FIX,MRS=8,MRN=0,FAC=PUT
FABR:	$FAB	FNM=<E.REL>,ORG=REL,RFM=FIX,MRS=8,MRN=0,FAC=PUT
FABI:	$FAB	FNM=<E.IDX>,ORG=IDX,RFM=FIX,MRS=8,FAC=PUT,XAB=KEY0
RABE:	$RAB	RBF=REC,RSZ=8
FABA:	$FAB	SHR=<GET,PUT,UPD,DEL>
RABA:	$RAB	FAB=FABA,UBF=BUF,USZ=8
FABB:	$FAB	SHR=<GET,PUT,UPD,DEL>
RABB:	$RAB	FAB=FABB,UBF=BUF,USZ=8
FTWO:	.ASCID	\  !AS then !AS\
LREAD:	.ASCID	/read/
LBOTH:	.ASCID	/read and update/
LAO:	.ASCID	/  A's OPEN/
LAG:	.ASCID	/  A's GET/
LBO:	.ASCID	/  B's OPEN/
LBG:	.ASCID	/  B's GET/

; SHOW prints a label and the status in R0.
	.MACRO	SHOW,TEXT,?L,?M
	BRB	M
L:	.ASCID	/'TEXT'/
M:	PUSHL	R0
	PUSHAQ	L
	CALLS	#2,PH_SHOW
	.ENDM	SHOW

; SECTION starts a part.
	.MACRO	SECTION,TEXT,?L,?M
	BRB	M
L:	.ASCID	/-- 'TEXT'/
M:	PUSHAQ	L
	CALLS	#1,G^LIB$PUT_OUTPUT
	.ENDM	SECTION

; PUTKEY puts a record of two 4-byte keys, by key.
	.MACRO	PUTKEY,K1,K2
	MOVB	#RAB$C_KEY,RAB+RAB$B_RAC
	MOVL	#^A/'K1'/,REC
	MOVL	#^A/'K2'/,REC+4
	MOVAB	REC,RAB+RAB$L_RBF	; a $GET left it the user's buffer
	MOVW	#8,RAB+RAB$W_RSZ
	$PUT	RAB=RAB
	.ENDM	PUTKEY

; PUTSEQ puts one in sequence, and shows the status.
	.MACRO	PUTSEQ,K1,K2,TEXT
	MOVL	#^A/'K1'/,REC
	MOVL	#^A/'K2'/,REC+4
	MOVAB	REC,RAB+RAB$L_RBF	; a $GET left it the user's buffer
	MOVW	#8,RAB+RAB$W_RSZ
	$PUT	RAB=RAB
	SHOW	<TEXT>
	.ENDM	PUTSEQ

; KEYED sets a keyed access to a key's 4 bytes.
	.MACRO	KEYED,KRF,K1
	MOVB	#KRF,RAB+RAB$B_KRF
	MOVB	#RAB$C_KEY,RAB+RAB$B_RAC
	MOVL	#^A/'K1'/,REC
	.ENDM	KEYED

	.PSECT	CODE,NOWRT,EXE
	.ENTRY	START,^M<>
	SECTION	<A a keyed FIND, then a sequential GET>
	BSBW	FRESH
	PUTKEY	AAAA,1111
	PUTKEY	BBBB,2222
	PUTKEY	CCCC,3333
	PUTKEY	DDDD,4444
	KEYED	0,AAAA
	$GET	RAB=RAB
	BSBW	GOT
	KEYED	0,CCCC
	$FIND	RAB=RAB
	SHOW	<FIND CCCC>
	MOVB	#RAB$C_SEQ,RAB+RAB$B_RAC
	$GET	RAB=RAB
	BSBW	GOT
	$GET	RAB=RAB
	BSBW	GOT
	BSBW	DONE

	SECTION	<B what a PUT in sequence remembers>
	BSBW	FRESH
	MOVB	#RAB$C_SEQ,RAB+RAB$B_RAC
	PUTSEQ	MMMM,1111,<PUT MMMM>
	PUTSEQ	CCCC,2222,<PUT CCCC, below it>
	$REWIND	RAB=RAB
	MOVB	#RAB$C_SEQ,RAB+RAB$B_RAC
	PUTSEQ	DDDD,3333,<after REWIND PUT DDDD, below it>
	PUTSEQ	PPPP,4444,<PUT PPPP>
	KEYED	0,DDDD
	$GET	RAB=RAB
	BSBW	GOT
	MOVB	#RAB$C_SEQ,RAB+RAB$B_RAC
	PUTSEQ	EEEE,5555,<after GET DDDD PUT EEEE, below PPPP>
	PUTSEQ	RRRR,6666,<PUT RRRR>
	BSBW	DONE

	SECTION	<C TRUNCATE with access to>
	BSBW	FRESH
	PUTKEY	AAAA,1111
	KEYED	0,AAAA
	$GET	RAB=RAB
	$TRUNCATE RAB=RAB
	SHOW	<TRUNCATE>
	BSBW	DONE

	SECTION	<D the last pointers of a value>
	BSBW	FRESH
	PUTKEY	AAAA,SAME
	PUTKEY	BBBB,SAME
	PUTKEY	CCCC,SAME
	PUTKEY	DDDD,ELSE
	KEYED	0,AAAA
	$FIND	RAB=RAB
	$DELETE	RAB=RAB
	SHOW	<DELETE the first>
	KEYED	0,BBBB
	$FIND	RAB=RAB
	$DELETE	RAB=RAB
	SHOW	<DELETE the second>
	KEYED	1,SAME
	$GET	RAB=RAB
	BSBW	GOT
	KEYED	0,CCCC
	$FIND	RAB=RAB
	$DELETE	RAB=RAB
	SHOW	<DELETE the last>
	KEYED	1,SAME
	$GET	RAB=RAB
	SHOW	<GET SAME>
	BSBW	DONE

	SECTION	<F a record this stream holds>
	BSBW	FRESH
	PUTKEY	AAAA,1111
	KEYED	0,AAAA
	$GET	RAB=RAB
	BSBW	GOT
	$GET	RAB=RAB
	BSBW	GOT
	MOVL	#RAB$M_NLK,RAB+RAB$L_ROP
	$GET	RAB=RAB
	BSBW	GOT
	MOVL	#RAB$M_RRL,RAB+RAB$L_ROP
	$GET	RAB=RAB
	BSBW	GOT
	CLRL	RAB+RAB$L_ROP
	$FREE	RAB=RAB
	SHOW	<FREE>
	$FREE	RAB=RAB
	SHOW	<FREE again>
	$GET	RAB=RAB
	BSBW	GOT
	MOVB	#RAB$C_SEQ,RAB+RAB$B_RAC
	$GET	RAB=RAB
	SHOW	<GET at the end, holding one>
	BSBW	DONE

	SECTION	<E two streams on a sequential file>
	MOVAB	FABS,R2
	BSBW	PAIRS
	SECTION	<E two streams on a relative file>
	MOVAB	FABR,R2
	BSBW	PAIRS
	SECTION	<E two streams on an indexed file>
	MOVAB	FABI,R2
	BSBW	PAIRS
	MOVL	#1,R0
	RET

; PAIRS makes the file of the FAB at R2 with two records, and tries each way two
; streams can read its first record, one held by the first.
PAIRS:	$CREATE	FAB=(R2)
	BLBS	R0,10$
	SHOW	<CREATE>
	RSB
10$:	MOVL	R2,RABE+RAB$L_FAB
	$CONNECT RAB=RABE
	MOVB	#RAB$C_KEY,RABE+RAB$B_RAC
	CMPB	FAB$B_ORG(R2),#FAB$C_SEQ
	BNEQ	20$
	MOVB	#RAB$C_SEQ,RABE+RAB$B_RAC
20$:	CMPB	FAB$B_ORG(R2),#FAB$C_REL
	BNEQ	30$
	MOVL	#1,RELNUM
	MOVAB	RELNUM,RABE+RAB$L_KBF
	MOVB	#4,RABE+RAB$B_KSZ
30$:	MOVL	#^A/AAAA/,REC
	MOVL	#^A/1111/,REC+4
	$PUT	RAB=RABE
	MOVL	#2,RELNUM
	MOVL	#^A/BBBB/,REC
	MOVL	#^A/2222/,REC+4
	$PUT	RAB=RABE
	$CLOSE	FAB=(R2)
	MOVL	FAB$L_FNA(R2),FABA+FAB$L_FNA
	MOVB	FAB$B_FNS(R2),FABA+FAB$B_FNS
	MOVL	FAB$L_FNA(R2),FABB+FAB$L_FNA
	MOVB	FAB$B_FNS(R2),FABB+FAB$B_FNS
	MOVL	#FAB$M_GET,R0
	MOVL	#FAB$M_GET,R1
	BSBW	PAIR
	MOVL	#FAB$M_GET,R0
	MOVL	#FAB$M_GET!FAB$M_UPD,R1
	BSBW	PAIR
	MOVL	#FAB$M_GET!FAB$M_UPD,R0
	MOVL	#FAB$M_GET,R1
	BSBW	PAIR
	MOVL	#FAB$M_GET!FAB$M_UPD,R0
	MOVL	#FAB$M_GET!FAB$M_UPD,R1
	BSBW	PAIR
	RSB

; PAIR is one try: stream A's FAC in R0, stream B's in R1.
PAIR:	MOVB	R0,FABA+FAB$B_FAC
	MOVB	R1,FABB+FAB$B_FAC
	CMPL	R1,#FAB$M_GET
	BEQL	10$
	MOVAQ	LBOTH,-(SP)
	BRB	20$
10$:	MOVAQ	LREAD,-(SP)
20$:	CMPL	R0,#FAB$M_GET
	BEQL	30$
	MOVAQ	LBOTH,-(SP)
	BRB	40$
30$:	MOVAQ	LREAD,-(SP)
40$:	PUSHAQ	FTWO
	CALLS	#3,PH_PRINT
	$OPEN	FAB=FABA
	PUSHL	R0
	PUSHAQ	LAO
	CALLS	#2,PH_SHOW
	$CONNECT RAB=RABA
	$GET	RAB=RABA
	PUSHL	R0
	PUSHAQ	LAG
	CALLS	#2,PH_SHOW
	$OPEN	FAB=FABB
	PUSHL	R0
	PUSHAQ	LBO
	CALLS	#2,PH_SHOW
	$CONNECT RAB=RABB
	$GET	RAB=RABB
	PUSHL	R0
	PUSHAQ	LBG
	CALLS	#2,PH_SHOW
	$CLOSE	FAB=FABB
	$CLOSE	FAB=FABA
	RSB

; FRESH makes the file again, and connects.
FRESH:	$CREATE	FAB=FAB
	BLBS	R0,10$
	SHOW	<CREATE>
10$:	$CONNECT RAB=RAB
	BLBS	R0,20$
	SHOW	<CONNECT>
20$:	CLRB	RAB+RAB$B_KRF
	CLRL	RAB+RAB$L_ROP
	RSB

; DONE closes it, for the next part's new version.
DONE:	$CLOSE	FAB=FAB
	RSB

; GOT is PH_GOT.
GOT:	PUSHAB	RAB
	PUSHL	R0
	CALLS	#2,PH_GOT
	RSB
	.END	START
