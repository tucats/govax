	.TITLE	VMS88W	Walks every key of an indexed file (Phase 88, subtask 15)
;
; The file named on the command line, a foreign command's text: its keys by
; XABSUM, each read in sequence from its start, and for each how many records, the
; last status, a sum that doesn't depend on the records' order, and one that does.
; The same file gives the same line on any RMS that reads it as VMS's does.
;
	$FABDEF
	$RABDEF
	$RMSDEF
	$XABSUMDEF

	.PSECT	DATA,WRT,NOEXE,LONG
FAB:	$FAB	FNA=NAME,FAC=GET,SHR=GET,XAB=SUM
RAB:	$RAB	FAB=FAB,UBF=BUF,USZ=32767
	.ALIGN	LONG
SUM:	$XABSUM
NAMED:	.LONG	128
	.ADDRESS NAME
NAME:	.BLKB	128
LENGTH:	.WORD	0
BUF:	.BLKB	32767
FKEY:	.ASCID	/  key !UB records !UL sum !XL order !XL/
FNOT:	.ASCID	/  not indexed/
LOPEN:	.ASCID	/  OPEN/
LLAST:	.ASCID	/  last/

	.PSECT	CODE,NOWRT,EXE
	.ENTRY	START,^M<R2,R3,R4,R5,R6,R7,R8>
	PUSHAW	LENGTH
	CLRL	-(SP)
	PUSHAQ	NAMED
	CALLS	#3,G^LIB$GET_FOREIGN
	MOVB	LENGTH,FAB+FAB$B_FNS
	$OPEN	FAB=FAB
	BLBS	R0,10$
	PUSHL	R0
	PUSHAQ	LOPEN
	CALLS	#2,PH_SHOW
	BRW	90$
10$:	CMPB	FAB+FAB$B_ORG,#FAB$C_IDX
	BEQL	20$
	PUSHAQ	FNOT
	CALLS	#1,G^LIB$PUT_OUTPUT
	BRW	80$
20$:	$CONNECT RAB=RAB
	CLRL	R8			; the key
30$:	MOVB	R8,RAB+RAB$B_KRF
	$REWIND	RAB=RAB
	MOVB	#RAB$C_SEQ,RAB+RAB$B_RAC
	CLRL	R5			; records
	CLRL	R6			; the sum
	CLRL	R7			; the sum in order
40$:	$GET	RAB=RAB
	BLBC	R0,60$
	INCL	R5
	MOVAB	BUF,R2
	MOVZWL	RAB+RAB$W_RSZ,R3
	CLRL	R4
	CLRL	R1
	BRB	52$
50$:	MOVZBL	(R2)+,R0
	INCL	R1
	MULL2	R1,R0
	ADDL2	R0,R4
52$:	SOBGEQ	R3,50$
	ADDL2	R4,R6
	ROTL	#5,R7,R7
	XORL2	R4,R7
	BRB	40$
60$:	CMPL	R0,#RMS$_EOF
	BEQL	70$
	PUSHL	R0
	PUSHAQ	LLAST
	CALLS	#2,PH_SHOW
70$:	PUSHL	R7
	PUSHL	R6
	PUSHL	R5
	MOVZBL	R8,-(SP)
	PUSHAQ	FKEY
	CALLS	#5,PH_PRINT
	INCL	R8
	CMPB	R8,SUM+XAB$B_NOK
	BGEQU	80$
	BRW	30$
80$:	$CLOSE	FAB=FAB
90$:	MOVL	#1,R0
	RET

	.END	START
