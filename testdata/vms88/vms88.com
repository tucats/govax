$ ! VMS88.COM - Phase 88's VMS round: what do VMS's RMS and ANALYZE make of files govax
$ ! made, and do govax's programs run the same on VMS? Written by hand. Run it with the
$ ! exchange volume's [000000] the default directory:
$ !
$ !     @VMS88/OUTPUT=VMS88.LOG
$ !
$ SET NOON
$ WRITE SYS$OUTPUT F$GETSYI("VERSION"), " ", F$GETSYI("HW_NAME")
$ ROOT = F$PARSE(F$ENVIRONMENT("DEFAULT"),,,"DEVICE")
$ WRITE SYS$OUTPUT "==== TOOLS"
$ MACRO/NOLIST PHUTIL
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST VMS88W
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST VMS88M
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST VMS88L
$ SHOW SYMBOL $STATUS
$ LINK/NOMAP VMS88W,PHUTIL
$ LINK/NOMAP VMS88M,PHUTIL
$ LINK/NOMAP VMS88L,PHUTIL
$ SHOW SYMBOL $STATUS
$ WALK :== $'ROOT'[000000]VMS88W.EXE
$ CHANGE :== $'ROOT'[000000]VMS88M.EXE
$ CREATE/DIRECTORY [RESULTS]
$ CREATE/DIRECTORY [M88]
$ CREATE/DIRECTORY [L88]
$ !
$ ! Each file govax made: VMS's account of it, every key walked, and then a copy changed
$ ! by VMS's RMS, whose records must be the same and whose structure must still pass.
$ !
$ CALL FILES G88 G 1
$ CALL FILES F88 F 2
$ CALL FILES R88 R 3
$ !
$ ! What the phase doc left open.
$ !
$ SET DEFAULT 'ROOT'[L88]
$ WRITE SYS$OUTPUT "==== OPEN"
$ RUN 'ROOT'[000000]VMS88L
$ SHOW SYMBOL $STATUS
$ !
$ ! testdata/rms88's programs under VMS's RMS, FTNRTL built here from its sources.
$ !
$ SET DEFAULT 'ROOT'[FTN]
$ WRITE SYS$OUTPUT "==== FTNRTL"
$ LIST = "VECTOR,CONTROL,UNITS,STATEMENT,FORMAT,EDIT,FLOAT,LISTOUT,LISTIN,NAMELIST," + -
         "INTERNAL,OPEN,INQUIRE,POSITION,UNFORMATTED,DIRECT,RECORD,KEYED,INTRINSICS,SYSTEM"
$ I = 0
$ RTL:
$   M = F$ELEMENT(I, ",", LIST)
$   IF M .EQS. "," THEN GOTO RTLDONE
$   MACRO/NOLIST FTN_'M'
$   I = I + 1
$   GOTO RTL
$ RTLDONE:
$ IF F$TRNLNM("FTNRTL") .NES. "" THEN DEASSIGN FTNRTL
$ LINK/SHAREABLE=FTNRTL/NOMAP FTNRTL/OPTIONS
$ SHOW SYMBOL $STATUS
$ DEFINE FTNRTL 'ROOT'[FTN]FTNRTL.EXE
$ SET DEFAULT 'ROOT'[P88]
$ MACRO/NOLIST PHUTIL
$ MACRO/NOLIST PHONES
$ MACRO/NOLIST PHONESL
$ MACRO/NOLIST PHONESC
$ MACRO/NOLIST PHONESF
$ MACRO/NOLIST LOAD
$ LINK/NOMAP PHONES,PHUTIL
$ LINK/NOMAP PHONESL,PHUTIL
$ LINK/NOMAP PHONESC,PHUTIL
$ LINK/NOMAP PHONESF,'ROOT'[FTN]FTN86/OPTIONS
$ LINK/NOMAP LOAD,'ROOT'[FTN]FTN86/OPTIONS
$ WRITE SYS$OUTPUT "==== PHONES"
$ RUN PHONES
$ WRITE SYS$OUTPUT "==== PHONESL"
$ RUN PHONESL
$ WRITE SYS$OUTPUT "==== PHONESF"
$ RUN PHONESF
$ WRITE SYS$OUTPUT "==== PHONESD"
$ @PHONES
$ WRITE SYS$OUTPUT "==== LOAD"
$ RUN LOAD
$ WRITE SYS$OUTPUT "==== CHECKS"
$ ANALYZE/RMS_FILE/CHECK/OUTPUT=[-.RESULTS]P_PHONES.CHK PHONES.IDX
$ SHOW SYMBOL $STATUS
$ ANALYZE/RMS_FILE/CHECK/OUTPUT=[-.RESULTS]P_PHONES2.CHK PHONES2.IDX
$ SHOW SYMBOL $STATUS
$ ANALYZE/RMS_FILE/CHECK/OUTPUT=[-.RESULTS]P_LOAD.CHK LOAD.IDX
$ SHOW SYMBOL $STATUS
$ ANALYZE/RMS_FILE/CHECK/OUTPUT=[-.RESULTS]P_LOADV.CHK LOADV.IDX
$ SHOW SYMBOL $STATUS
$ !
$ ! Names with no type and no name.
$ !
$ SET DEFAULT 'ROOT'[ODD]
$ WRITE SYS$OUTPUT "==== ODD"
$ DIRECTORY/SIZE=ALL
$ DIRECTORY NOTYPE.
$ DIRECTORY .TYPEONLY
$ DIRECTORY .;1
$ WRITE SYS$OUTPUT F$SEARCH("NOTYPE.")
$ COPY ODD.FDL COPYNOTYPE.
$ COPY ODD.FDL .;1
$ COPY ODD.FDL .NEWTYPE
$ DIRECTORY/SIZE=ALL
$ !
$ ! The results, in one file to carry back; and what VMS's RMS made of the changes.
$ !
$ SET DEFAULT 'ROOT'[000000]
$ WRITE SYS$OUTPUT "==== SAVE"
$ BACKUP [RESULTS]*.*;* RESULTS.BCK/SAVE_SET
$ SHOW SYMBOL $STATUS
$ BACKUP [M88]*.IDX;*,[L88]*.*;*,[P88]*.IDX;* CHANGED.BCK/SAVE_SET
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== END"
$ !
$ ! Last, and only for what VMS says: govax has no such command.
$ !
$ ANALYZE/DISK_STRUCTURE/LIST=DISK.LIS 'ROOT'
$ SHOW SYMBOL $STATUS
$ EXIT 1
$ !
$ ! FILES directory prefix stream: each indexed file of a directory.
$ !
$ FILES: SUBROUTINE
$   SET NOON
$   WRITE SYS$OUTPUT "==== ''P1'"
$ NEXT:
$   F = F$SEARCH("''ROOT'[''P1']*.IDX", P3)
$   IF F .EQS. "" THEN GOTO FILESDONE
$   N = P2 + "_" + F$PARSE(F,,,"NAME")
$   R = ROOT + "[RESULTS]" + N
$   M = ROOT + "[M88]" + N + ".IDX"
$   WRITE SYS$OUTPUT "== ", N
$   ANALYZE/RMS_FILE/OUTPUT='R'.ANL 'F'
$   SHOW SYMBOL $STATUS
$   ANALYZE/RMS_FILE/CHECK/OUTPUT='R'.CHK 'F'
$   SHOW SYMBOL $STATUS
$   ANALYZE/RMS_FILE/FDL/OUTPUT='R'.FDL 'F'
$   WALK 'F'
$   COPY 'F' 'M'
$   CHANGE 'M'
$   WALK 'M'
$   ANALYZE/RMS_FILE/CHECK/OUTPUT='R'.CK2 'M'
$   SHOW SYMBOL $STATUS
$   GOTO NEXT
$ FILESDONE:
$ ENDSUBROUTINE
