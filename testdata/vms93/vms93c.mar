	.TITLE	VMS93C	Phase 93's VMS round: who may do what to each file
	.IDENT	/V1.0/
;
; Written by hand (testdata/vms93/README.md). For each file under
; VMS93$DISK:[V93...], and each of the accounts PROT93A, PROT93B, PROT93C,
; and SYSTEM, $CHECK_ACCESS is asked for each of READ, WRITE, EXECUTE,
; DELETE, and CONTROL, and a line shows the answers: the access's letter
; when it is granted, "-" when it is refused (SS$_NOPRIV), and "?" for any
; other status, which then follows the file's name. CHP$_ACCESS and
; ACL$C_FILE are defined here, $CHPDEF's and $ACLDEF's values.
;
	$SSDEF
	$FABDEF
	$NAMDEF
CHP$_ACCESS = ^X1
ACL$C_FILE = ^X1
;
	.PSECT	DATA,WRT,NOEXE,LONG
FAB:	$FAB	FNM=<VMS93$DISK:[V93...]*.*;*>,NAM=NAM
NAM:	$NAM	ESA=ESA,ESS=255,RSA=RSA,RSS=255
ESA:	.BLKB	255
RSA:	.BLKB	255
	.ALIGN	LONG
OBJTYP:	.LONG	ACL$C_FILE
NAMDSC:	.LONG	0
	.ADDRESS RSA
U1:	.ASCID	/PROT93A/
U2:	.ASCID	/PROT93B/
U3:	.ASCID	/PROT93C/
U4:	.ASCID	/SYSTEM/
	.ALIGN	LONG
UTAB:	.ADDRESS U1,U2,U3,U4
	.LONG	0
ACC:	.LONG	0
ITEMS:	.WORD	4,CHP$_ACCESS
	.ADDRESS ACC
	.LONG	0
	.LONG	0
LETTER:	.ASCII	/RWEDC/
LINE:	.BLKB	5
	.ALIGN	LONG
STATUS:	.LONG	0
OUT:	.BLKB	255
	.ALIGN	LONG
OUTDSC:	.LONG	255
	.ADDRESS OUT
OUTLEN:	.WORD	0
CTL:	.ASCID	/!10AS !AD !AS!AS/
CTLBAD:	.ASCID	/!10AS !AD !AS status !XL/
NONE:	.ASCID	//
SAYPAR:	.ASCID	/$PARSE !XL/
;
	.PSECT	CODE,EXE,NOWRT,LONG
	.ENTRY	VMS93C,^M<R2,R3,R4,R5,R6>
	$PARSE	FAB=FAB
	BLBS	R0,NEXT
	MOVL	R0,STATUS
	$FAO_S	CTRSTR=SAYPAR,OUTLEN=OUTLEN,OUTBUF=OUTDSC,P1=STATUS
	BSBW	SAY
	RET
NEXT:	$SEARCH	FAB=FAB
	BLBS	R0,2$
	BRW	DONE
2$:	MOVZBL	NAM+NAM$B_RSL,NAMDSC
	MOVAL	UTAB,R6
USER:	MOVL	(R6)+,R5
	BNEQ	1$
	BRW	NEXT
1$:	CLRL	STATUS
	CLRL	R4
	MOVL	#1,R3
BIT:	MOVL	R3,ACC
	$CHECK_ACCESS_S	OBJTYP=OBJTYP,OBJNAM=NAMDSC,USRNAM=(R5),ITMLST=ITEMS
	CMPL	R0,#SS$_NORMAL
	BEQL	GRANT
	CMPL	R0,#SS$_NOPRIV
	BEQL	DENY
	MOVL	R0,STATUS
	MOVB	#^A/?/,LINE[R4]
	BRB	STEP
GRANT:	MOVB	LETTER[R4],LINE[R4]
	BRB	STEP
DENY:	MOVB	#^A/-/,LINE[R4]
STEP:	ASHL	#1,R3,R3
	AOBLSS	#5,R4,BIT
	TSTL	STATUS
	BNEQ	BAD
	$FAO_S	CTRSTR=CTL,OUTLEN=OUTLEN,OUTBUF=OUTDSC,-
		P1=R5,P2=#5,P3=#LINE,P4=#NAMDSC,P5=#NONE
	BRB	SHOW
BAD:	$FAO_S	CTRSTR=CTLBAD,OUTLEN=OUTLEN,OUTBUF=OUTDSC,-
		P1=R5,P2=#5,P3=#LINE,P4=#NAMDSC,P5=STATUS
SHOW:	BSBW	SAY
	BRW	USER
DONE:	MOVL	#SS$_NORMAL,R0
	RET
;
; SAY writes OUT, OUTLEN bytes long.
SAY:	MOVZWL	OUTLEN,OUTDSC
	PUSHAQ	OUTDSC
	CALLS	#1,G^LIB$PUT_OUTPUT
	MOVZWL	#255,OUTDSC
	RSB
	.END	VMS93C
