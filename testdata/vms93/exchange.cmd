! EXCHANGE.CMD - builds Phase 93's VMS round's exchange volume with govax: a tree of
! files whose owners, protections, and ACLs govax gave them, a directory whose default
! protection and DEFAULT ACEs govax's new files inherited, the programs VMS runs, and
! VMS93C built by govax's MACRO and LINK as VMS93CG.EXE. Written by hand. From the
! repository root:
!
!     govax console < testdata/vms93/exchange.cmd
!
INITIALIZE/CONTAINER "testdata/disks/vms93-exchange.dsk" /DEVICE=RD54 /CLUSTER=3 VMS93
MOUNT/WRITE DUA5 "testdata/disks/vms93-exchange.dsk"
SET DEFAULT DUA5:[000000]
COPY/QUIET "testdata/vms93/vms93.com"/HOST VMS93.COM
COPY/QUIET "testdata/vms93/vms93c.mar"/HOST VMS93C.MAR
COPY/QUIET "testdata/vms93/vms93u.mar"/HOST VMS93U.MAR
MACRO/NOLIST VMS93C
LINK/NOMAP VMS93C
RENAME VMS93C.EXE VMS93CG.EXE
DELETE VMS93C.OBJ;*
!
! [V93]: each file's owner and protection, and its ACL, set by SET SECURITY.
CREATE/DIRECTORY/PROTECTION=(S:RWE,O:RWE,G:RWE,W:RWE) DUA5:[V93]
COPY/QUIET "testdata/vms93/t.txt"/HOST DUA5:[V93]O1.DAT
SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RE,W) DUA5:[V93]O1.DAT
COPY/QUIET "testdata/vms93/t.txt"/HOST DUA5:[V93]O2.DAT
SET SECURITY/OWNER=[200,2]/PROTECTION=(S:RWED,O:RWED,G,W) DUA5:[V93]O2.DAT
COPY/QUIET "testdata/vms93/t.txt"/HOST DUA5:[V93]O3.DAT
SET SECURITY/OWNER=[300,1]/PROTECTION=(S,O:RWED,G,W:R) DUA5:[V93]O3.DAT
COPY/QUIET "testdata/vms93/t.txt"/HOST DUA5:[V93]O4.DAT
SET SECURITY/OWNER=[0,0]/PROTECTION=(S:RWED,O,G,W) DUA5:[V93]O4.DAT
COPY/QUIET "testdata/vms93/t.txt"/HOST DUA5:[V93]O5.DAT
SET SECURITY/OWNER=[1,4]/PROTECTION=(S:RWED,O:RWED,G,W) DUA5:[V93]O5.DAT
COPY/QUIET "testdata/vms93/t.txt"/HOST DUA5:[V93]P1.DAT
SET SECURITY/OWNER=[200,1]/PROTECTION=(S:R,O:W,G:E,W:D) DUA5:[V93]P1.DAT
COPY/QUIET "testdata/vms93/t.txt"/HOST DUA5:[V93]P2.DAT
SET SECURITY/OWNER=[200,1]/PROTECTION=(S,O,G,W) DUA5:[V93]P2.DAT
COPY/QUIET "testdata/vms93/t.txt"/HOST DUA5:[V93]P3.DAT
SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) DUA5:[V93]P3.DAT
COPY/QUIET "testdata/vms93/t.txt"/HOST DUA5:[V93]A1.DAT
SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G,W) DUA5:[V93]A1.DAT
SET SECURITY/ACL=(IDENTIFIER=[300,1],ACCESS=READ+WRITE) DUA5:[V93]A1.DAT
COPY/QUIET "testdata/vms93/t.txt"/HOST DUA5:[V93]A2.DAT
SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RE,W) DUA5:[V93]A2.DAT
SET SECURITY/ACL=(IDENTIFIER=[200,2],ACCESS=NONE) DUA5:[V93]A2.DAT
COPY/QUIET "testdata/vms93/t.txt"/HOST DUA5:[V93]A3.DAT
SET SECURITY/OWNER=[200,1]/PROTECTION=(S,O:RWED,G,W) DUA5:[V93]A3.DAT
SET SECURITY/ACL=(IDENTIFIER=[300,1],ACCESS=CONTROL) DUA5:[V93]A3.DAT
COPY/QUIET "testdata/vms93/t.txt"/HOST DUA5:[V93]A4.DAT
SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G,W) DUA5:[V93]A4.DAT
SET SECURITY/ACL=(IDENTIFIER=[200,*],ACCESS=READ) DUA5:[V93]A4.DAT
COPY/QUIET "testdata/vms93/t.txt"/HOST DUA5:[V93]A5.DAT
SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G,W) DUA5:[V93]A5.DAT
SET SECURITY/ACL=(IDENTIFIER=%X80010001,ACCESS=READ+EXECUTE) DUA5:[V93]A5.DAT
COPY/QUIET "testdata/vms93/t.txt"/HOST DUA5:[V93]A6.DAT
SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G,W) DUA5:[V93]A6.DAT
SET SECURITY/ACL=((IDENTIFIER=[300,1],ACCESS=NONE),(IDENTIFIER=[*,1],ACCESS=READ)) DUA5:[V93]A6.DAT
COPY/QUIET "testdata/vms93/t.txt"/HOST DUA5:[V93]A7.DAT
SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G,W) DUA5:[V93]A7.DAT
SET SECURITY/ACL=(IDENTIFIER=[200,2],OPTIONS=PROTECTED+NOPROPAGATE,ACCESS=READ+DELETE) DUA5:[V93]A7.DAT
COPY/QUIET "testdata/vms93/t.txt"/HOST DUA5:[V93]A8.DAT
SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G,W) DUA5:[V93]A8.DAT
SET SECURITY/ACL=(IDENTIFIER=INTERACTIVE,ACCESS=READ) DUA5:[V93]A8.DAT
COPY/QUIET "testdata/vms93/t.txt"/HOST DUA5:[V93]A9.DAT
SET SECURITY/OWNER=[0,0]/PROTECTION=(S,O,G,W) DUA5:[V93]A9.DAT
SET SECURITY/ACL=((IDENTIFIER=[1,4],ACCESS=READ),(IDENTIFIER=[300,1],ACCESS=READ+WRITE+CONTROL)) DUA5:[V93]A9.DAT
COPY/QUIET "testdata/vms93/t.txt"/HOST DUA5:[V93]UFO.DAT
SET SECURITY/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) DUA5:[V93]UFO.DAT
!
! [V93.DEF]: a default protection ACE, a DEFAULT identifier ACE, and a creator ACE, which
! the files and the directory govax makes in it inherit.
CREATE/DIRECTORY/OWNER_UIC=[200,1]/PROTECTION=(S:RWE,O:RWE,G:RWE,W:RE) DUA5:[V93.DEF]
SET SECURITY/ACL=((DEFAULT_PROTECTION,S:RWED,O:RWED,G:R,W:),(IDENTIFIER=[300,1],OPTIONS=DEFAULT,ACCESS=READ),(CREATOR,ACCESS=READ+WRITE)) DUA5:[V93]DEF.DIR
COPY/QUIET "testdata/vms93/t.txt"/HOST DUA5:[V93.DEF]N1.DAT
CREATE/DIRECTORY DUA5:[V93.DEF.SUB]
COPY/QUIET "testdata/vms93/t.txt"/HOST DUA5:[V93.DEF.SUB]N2.DAT
!
! [V93.D0]: a directory only its owner and SYSTEM may look in, with a file the world may read.
CREATE/DIRECTORY/OWNER_UIC=[300,1]/PROTECTION=(S:RWE,O:RWE,G,W) DUA5:[V93.D0]
COPY/QUIET "testdata/vms93/t.txt"/HOST DUA5:[V93.D0]W1.DAT
SET SECURITY/OWNER=[300,1]/PROTECTION=(S:RWED,O:RWED,G:R,W:R) DUA5:[V93.D0]W1.DAT
SET DEFAULT DUA5:[000000]
DISMOUNT DUA5
