$ ! VMS93.COM - Phase 93's VMS round: do VMS's DIRECTORY/SECURITY, SHOW SECURITY, and
$ ! $CHECK_ACCESS agree with govax's on files govax gave owners, protections, and ACLs?
$ ! Written by hand (testdata/vms93/README.md). Run it as SYSTEM, with the exchange
$ ! volume's [000000] the default directory:
$ !
$ !     @VMS93/OUTPUT=VMS93.LOG
$ !
$ ! It makes round 1's three accounts and PROT93_TEAM again, and removes them at its end.
$ !
$ SET NOON
$ ROOT = F$PARSE(F$ENVIRONMENT("DEFAULT"),,,"DEVICE")
$ DEFINE VMS93$DISK 'ROOT'
$ WRITE SYS$OUTPUT "==== ENVIRONMENT"
$ WRITE SYS$OUTPUT F$GETSYI("VERSION"), " ", F$GETSYI("HW_NAME")
$ WRITE SYS$OUTPUT F$GETJPI("","USERNAME"), " ", F$GETJPI("","UIC")
$ WRITE SYS$OUTPUT "==== ACCOUNTS"
$ HOME = F$ENVIRONMENT("DEFAULT")
$ SET DEFAULT SYS$SYSTEM
$ RUN SYS$SYSTEM:AUTHORIZE
ADD PROT93A/UIC=[200,1]/PASSWORD=PROT93PW/NOPWDEXPIRED/FLAGS=NODISUSER/PRIVILEGES=(TMPMBX,NETMBX)/DEFPRIVILEGES=(TMPMBX,NETMBX)/ACCOUNT=PROT93
ADD PROT93B/UIC=[200,2]/PASSWORD=PROT93PW/NOPWDEXPIRED/FLAGS=NODISUSER/PRIVILEGES=(TMPMBX,NETMBX,READALL,GRPPRV,SYSPRV,BYPASS)/DEFPRIVILEGES=(TMPMBX,NETMBX)/ACCOUNT=PROT93
ADD PROT93C/UIC=[300,1]/PASSWORD=PROT93PW/NOPWDEXPIRED/FLAGS=NODISUSER/PRIVILEGES=(TMPMBX,NETMBX)/DEFPRIVILEGES=(TMPMBX,NETMBX)/ACCOUNT=PROT93
ADD/IDENTIFIER PROT93_TEAM/VALUE=IDENTIFIER=65537
GRANT/IDENTIFIER PROT93_TEAM PROT93C
EXIT
$ SET DEFAULT 'HOME'
$ WRITE SYS$OUTPUT F$IDENTIFIER("PROT93_TEAM","NAME_TO_NUMBER")
$ WRITE SYS$OUTPUT "==== DIRECTORY"
$ DIRECTORY/SECURITY VMS93$DISK:[V93...]*.*;*
$ WRITE SYS$OUTPUT "==== SHOW"
$ LOOP:
$ F = F$SEARCH("VMS93$DISK:[V93...]*.*;*")
$ IF F .EQS. "" THEN GOTO SHOWN
$ SHOW SECURITY 'F'
$ WRITE SYS$OUTPUT F$PARSE(F,,,"NAME"), F$PARSE(F,,,"TYPE"), " ", F$FILE_ATTRIBUTES(F,"UIC"), " ", F$FILE_ATTRIBUTES(F,"PRO")
$ GOTO LOOP
$ SHOWN:
$ WRITE SYS$OUTPUT "==== BUILD"
$ MACRO/NOLIST VMS93C
$ SHOW SYMBOL $STATUS
$ LINK/NOMAP VMS93C
$ SHOW SYMBOL $STATUS
$ MACRO/NOLIST VMS93U
$ SHOW SYMBOL $STATUS
$ LINK/NOMAP VMS93U
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== CHECK"
$ RUN VMS93C
$ WRITE SYS$OUTPUT "==== CHECKG"
$ RUN VMS93CG
$ WRITE SYS$OUTPUT "==== UFO"
$ RUN VMS93U
$ WRITE SYS$OUTPUT "==== ACCOUNTS REMOVED"
$ SET DEFAULT SYS$SYSTEM
$ RUN SYS$SYSTEM:AUTHORIZE
REMOVE PROT93A
REMOVE PROT93B
REMOVE PROT93C
REMOVE/IDENTIFIER PROT93_TEAM
EXIT
$ SET DEFAULT 'HOME'
$ WRITE SYS$OUTPUT "==== DISK"
$ ANALYZE/DISK_STRUCTURE/LIST=VMS93$DISK:[000000]DISK.LIS VMS93$DISK:
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== END"
$ EXIT
