	.TITLE	VMS93U	Phase 93's VMS round: which user file opens RMS refuses
	.IDENT	/V1.0/
;
; Written by hand (testdata/vms93/README.md). Round 3's case 458 found
; VMS 7.1's $OPEN with FOP=UFO, FAC=PUT, and SHR=GET refused with RMS$_SHR,
; where govax opened it. Here each FAC from a table is tried with each SHR,
; on VMS93$DISK:[V93]UFO.DAT, a line each: the two masks and the status;
; a channel opened is deassigned at once.
;
	$FABDEF
	$SSDEF
;
	.PSECT	DATA,WRT,NOEXE,LONG
FAB:	$FAB	FNM=<VMS93$DISK:[V93]UFO.DAT>,FOP=UFO
FACS:	.BYTE	FAB$M_GET
	.BYTE	FAB$M_PUT
	.BYTE	FAB$M_GET!FAB$M_PUT
	.BYTE	FAB$M_GET!FAB$M_UPD
	.BYTE	FAB$M_GET!FAB$M_DEL
	.BYTE	FAB$M_BIO!FAB$M_PUT
	.BYTE	0
SHRS:	.BYTE	FAB$M_NIL
	.BYTE	FAB$M_SHRGET
	.BYTE	FAB$M_SHRPUT
	.BYTE	FAB$M_SHRGET!FAB$M_SHRPUT
	.BYTE	FAB$M_SHRGET!FAB$M_UPI
	.BYTE	FAB$M_SHRGET!FAB$M_SHRPUT!FAB$M_UPI
	.BYTE	FAB$M_UPI
	.BYTE	^XFF
	.ALIGN	LONG
CHAN:	.LONG	0
FAC:	.LONG	0
SHR:	.LONG	0
STS:	.LONG	0
OUT:	.BLKB	80
	.ALIGN	LONG
OUTDSC:	.LONG	80
	.ADDRESS OUT
OUTLEN:	.WORD	0
CTL:	.ASCID	/fac=!XB shr=!XB sts=!XL/
;
	.PSECT	CODE,EXE,NOWRT,LONG
	.ENTRY	VMS93U,^M<R2,R3>
	MOVAB	FACS,R2
F:	MOVZBL	(R2)+,FAC
	BNEQ	2$
	BRW	DONE
2$:	MOVAB	SHRS,R3
S:	MOVZBL	(R3)+,SHR
	CMPL	SHR,#^XFF
	BNEQ	3$
	BRW	F
3$:	MOVB	FAC,FAB+FAB$B_FAC
	MOVB	SHR,FAB+FAB$B_SHR
	$OPEN	FAB=FAB
	MOVL	FAB+FAB$L_STS,STS
	BLBC	R0,1$
	MOVL	FAB+FAB$L_STV,CHAN
	$DASSGN_S CHAN=CHAN
1$:	$FAO_S	CTRSTR=CTL,OUTLEN=OUTLEN,OUTBUF=OUTDSC,P1=FAC,P2=SHR,P3=STS
	MOVZWL	OUTLEN,OUTDSC
	PUSHAQ	OUTDSC
	CALLS	#1,G^LIB$PUT_OUTPUT
	MOVZWL	#80,OUTDSC
	BRW	S
DONE:	MOVL	#SS$_NORMAL,R0
	RET
	.END	VMS93U
