	.ADDRESS	C17
	.PSECT	C,EXE,NOWRT,LONG
; START runs the case its command line names under a timer of three
; minutes, or with no number every case in turn, untimed.
	.ENTRY	START,^M<R2>
	MOVC5	#0,BIG,#^A/B/,#3000,BIG
	$BINTIM_S TIMBUF=TDS,TIMADR=TDELTA
	PUSHAW	ARGL
	CLRL	-(SP)
	PUSHAQ	ARGD
	CALLS	#3,G^LIB$GET_FOREIGN
	TSTW	ARGL
	BEQL	ALL
	MOVW	ARGL,ARGN
	PUSHL	#1
	PUSHL	#4
	PUSHAL	CASEN
	PUSHAQ	ARGN
	CALLS	#4,G^OTS$CVT_TI_L
	MOVL	CASEN,R2
	BLEQ	10$
	CMPL	R2,#17
	BGTR	10$
	$SETIMR_S EFN=#24,DAYTIM=TDELTA,ASTADR=TIMEOUT
	MOVL	CASES-4[R2],R0
	CALLS	#0,(R0)
	MOVL	#1,R0
	RET
10$:	PUSHAB	MNOCASE
	CALLS	#1,OUT
	MOVL	#SS$_BADPARAM,R0
	RET
ALL:
	CALLS	#0,C1
	CALLS	#0,C2
	CALLS	#0,C3
	CALLS	#0,C4
	CALLS	#0,C5
	CALLS	#0,C6
	CALLS	#0,C7
	CALLS	#0,C8
	CALLS	#0,C9
	CALLS	#0,C10
	CALLS	#0,C11
	CALLS	#0,C12
	CALLS	#0,C13
	CALLS	#0,C14
	CALLS	#0,C15
	CALLS	#0,C16
	CALLS	#0,C17
	MOVL	#1,R0
	RET
; TIMEOUT, the timer's AST: a case that ran past its three minutes.
	.ENTRY	TIMEOUT,^M<>
	PUSHAB	MTIME
	CALLS	#1,OUT
	$EXIT_S	CODE=#SS$_TIMEOUT
	.END	START
