	.PSECT	C,EXE,NOWRT,LONG
; OUT(control, values...) writes a line.
	.ENTRY	OUT,^M<R2,R3,R4,R5>
	$FAOL_S	CTRSTR=@4(AP),OUTLEN=LD,OUTBUF=BD,PRMLST=8(AP)
	PUSHAB	LD
	CALLS	#1,G^LIB$PUT_OUTPUT
	RET
; VALUE(name, value)
	.ENTRY	VALUE,^M<>
	PUSHL	8(AP)
	PUSHL	4(AP)
	PUSHAB	MVAL
	CALLS	#3,OUT
	RET
; STAT(name, status) shows a status and its message.
	.ENTRY	STAT,^M<R2>
	MOVL	8(AP),R2
	CLRW	MTL
	PUSHL	#0
	PUSHL	#15
	PUSHAQ	MTD
	PUSHAW	MTL
	PUSHL	R2
	CALLS	#5,G^SYS$GETMSG
	PUSHAB	MT
	MOVZWL	MTL,-(SP)
	PUSHL	R2
	PUSHL	4(AP)
	PUSHAB	MSTAT
	CALLS	#5,OUT
	MOVL	R2,R0
	RET
; HND shows a condition, continues below severe, and unwinds from a
; severe one.
HND:	.WORD	^M<R2>
	MOVL	4(AP),R2
	CMPL	4(R2),#SS$_UNWIND
	BEQL	50$
	PUSHL	12(R2)
	PUSHL	8(R2)
	PUSHL	(R2)
	PUSHL	4(R2)
	PUSHAB	MCOND
	CALLS	#5,OUT
	BICL3	#^XFFFFFFF8,4(R2),R0
	CMPL	R0,#4
	BEQL	40$
	MOVL	#SS$_CONTINUE,R0
	RET
40$:	PUSHAB	MUNW
	CALLS	#1,OUT
	$UNWIND_S
50$:	MOVL	#SS$_CONTINUE,R0
	RET
; SHOWRFA(rfa) shows an RFA.
	.ENTRY	SHOWRFA,^M<R2>
	MOVL	4(AP),R2
	MOVZWL	4(R2),-(SP)
	PUSHL	(R2)
	PUSHAB	MRFA
	CALLS	#3,OUT
	RET
; RECS shows IDX's records from the current one; RECSI(index) another's.
	.ENTRY	RECS,^M<>
	PUSHAL	IDX
	CALLS	#1,RECSI
	RET
	.ENTRY	RECSI,^M<R2,R3>
	CLRL	R3
10$:	CLRW	OUTBD
	CLRL	OUTBD+4
	PUSHAQ	OUTBD
	PUSHAQ	INBD
	PUSHL	4(AP)
	CALLS	#3,G^LBR$GET_RECORD
	MOVL	R0,R2
	BLBC	R2,20$
	INCL	R3
	PUSHAQ	OUTBD
	MOVZWL	OUTBD,-(SP)
	PUSHL	R3
	PUSHAB	MREC
	CALLS	#4,OUT
	CMPL	R3,#200
	BLSS	10$
20$:	PUSHL	R2
	PUSHAB	MRECS
	CALLS	#2,OUT
	RET
; HEADER shows LBR$GET_HEADER's 128 longwords; HEADER2 gets IDX2's first.
	.ENTRY	HEADER2,^M<>
	PUSHAL	HDR
	PUSHAL	IDX2
	CALLS	#2,G^LBR$GET_HEADER
	PUSHL	R0
	PUSHAQ	HNAME
	CALLS	#2,STAT
	CALLS	#0,HEADER
	RET
HNAME:	.ASCID	~GET_HEADER~
	.ENTRY	HEADER,^M<R2,R3,R4>
	MOVAL	HDR,R2
	CLRL	R3
10$:	PUSHL	28(R2)
	PUSHL	24(R2)
	PUSHL	20(R2)
	PUSHL	16(R2)
	PUSHL	12(R2)
	PUSHL	8(R2)
	PUSHL	4(R2)
	PUSHL	(R2)
	PUSHL	R3
	PUSHAB	MHDR
	CALLS	#10,OUT
	ADDL2	#32,R2
	ADDL2	#8,R3
	CMPL	R3,#128
	BLSS	10$
	RET
; KEYR(key, rfa), GET_INDEX's routine: shows the key, and fails once
; COUNT reaches a nonzero LIMIT.
	.ENTRY	KEYR,^M<R2>
	INCL	COUNT
	MOVL	8(AP),R2
	MOVZWL	4(R2),-(SP)
	PUSHL	(R2)
	PUSHL	4(AP)
	PUSHAB	MKEY
	CALLS	#4,OUT
	BRB	LIMITED
; LIMITED returns 0 once COUNT reaches a nonzero LIMIT, else 1.
LIMITED: MOVL	#1,R0
	TSTL	LIMIT
	BEQL	10$
	CMPL	COUNT,LIMIT
	BLSS	10$
	CLRL	R0
10$:	RET
; HELPR(line, flags, data, level), GET_HELP's routine. The level is
; shown at the address the fourth argument holds when it looks like an
; address (la=1), else as it is (la=0); d=1 if the data argument is
; DATAV's address, 2 if it's the address of a 0, else 0.
	.ENTRY	HELPR,^M<R2,R3,R4>
	INCL	COUNT
	MOVL	16(AP),R2
	CLRL	R3
	CMPL	R2,#^X1000
	BLSSU	10$
	MOVL	(R2),R2
	MOVL	#1,R3
10$:	CLRL	R4
	CMPL	12(AP),#DATAV
	BNEQ	20$
	MOVL	#1,R4
	BRB	30$
20$:	TSTL	12(AP)
	BEQL	30$
	TSTL	@12(AP)
	BNEQ	30$
	MOVL	#2,R4
30$:	PUSHL	4(AP)
	PUSHL	R4
	PUSHL	R3
	PUSHL	R2
	PUSHL	@8(AP)
	PUSHAB	MHLP
	CALLS	#6,OUT
	BRW	LIMITED
; ORTN(line), OUTPUT_HELP's output routine.
	.ENTRY	ORTN,^M<>
	INCL	COUNT
	PUSHL	4(AP)
	PUSHAB	MOUT
	CALLS	#2,OUT
	BRW	LIMITED
; IRTN(string, prompt, length), OUTPUT_HELP's input routine: the next of
; SCRIPT's counted strings, or RMS$_EOF at the 255 that ends them.
	.ENTRY	IRTN,^M<R2,R3>
	MOVAQ	NONE,R3
	CMPB	(AP),#2
	BLSS	5$
	TSTL	8(AP)
	BEQL	5$
	MOVL	8(AP),R3
5$:	MOVL	SCRIPT,R2
	BEQL	20$
	CMPB	(R2),#255
	BEQL	20$
	MOVZBW	(R2),RLEN
	PUSHL	4(AP)
	PUSHAB	1(R2)
	PUSHAW	RLEN
	CALLS	#3,G^LIB$SCOPY_R_DX
	CMPB	(AP),#3
	BLSS	10$
	TSTL	12(AP)
	BEQL	10$
	MOVW	RLEN,@12(AP)
10$:	MOVL	SCRIPT,R2
	PUSHAB	1(R2)
	MOVZBL	(R2),-(SP)
	PUSHL	R3
	PUSHAB	MIN
	CALLS	#4,OUT
	MOVZBL	@SCRIPT,R0
	ADDL2	#1,R0
	ADDL2	R0,SCRIPT
	MOVL	#1,R0
	RET
20$:	PUSHL	R3
	PUSHAB	MINE
	CALLS	#2,OUT
	MOVL	#RMS$_EOF,R0
	RET
	.ENTRY	C1,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
	PUSHAB	S1
	PUSHL	#1
	PUSHAB	MCASE
	CALLS	#3,OUT
	PUSHL	#LBR$C_CREATE
	PUSHAQ	S2
	CALLS	#2,VALUE
	PUSHL	#LBR$C_READ
	PUSHAQ	S3
	CALLS	#2,VALUE
	PUSHL	#LBR$C_UPDATE
	PUSHAQ	S4
	CALLS	#2,VALUE
	PUSHL	#LBR$C_TYP_UNK
	PUSHAQ	S5
	CALLS	#2,VALUE
	PUSHL	#LBR$C_TYP_OBJ
	PUSHAQ	S6
	CALLS	#2,VALUE
	PUSHL	#LBR$C_TYP_MLB
	PUSHAQ	S7
	CALLS	#2,VALUE
	PUSHL	#LBR$C_TYP_HLP
	PUSHAQ	S8
	CALLS	#2,VALUE
	PUSHL	#LBR$C_TYP_TXT
	PUSHAQ	S9
	CALLS	#2,VALUE
	PUSHL	#LBR$C_TYP_SHSTB
	PUSHAQ	S10
	CALLS	#2,VALUE
	PUSHL	#HLP$M_PROMPT
	PUSHAQ	S11
	CALLS	#2,VALUE
	PUSHL	#HLP$M_PROCESS
	PUSHAQ	S12
	CALLS	#2,VALUE
	PUSHL	#HLP$M_GROUP
	PUSHAQ	S13
	CALLS	#2,VALUE
	PUSHL	#HLP$M_SYSTEM
	PUSHAQ	S14
	CALLS	#2,VALUE
	PUSHL	#HLP$M_LIBLIST
	PUSHAQ	S15
	CALLS	#2,VALUE
	PUSHL	#HLP$M_HELP
	PUSHAQ	S16
	CALLS	#2,VALUE
	PUSHL	#HLP$M_NOHLPTXT
	PUSHAQ	S17
	CALLS	#2,VALUE
	PUSHL	#HLP$M_KEYNAMLIN
	PUSHAQ	S18
	CALLS	#2,VALUE
	PUSHL	#HLP$M_OTHERINFO
	PUSHAQ	S19
	CALLS	#2,VALUE
	MOVL	#LBR$_NORMAL,R0
	PUSHL	R0
	PUSHAQ	S20
	CALLS	#2,STAT
	MOVL	#LBR$_KEYNOTFND,R0
	PUSHL	R0
	PUSHAQ	S21
	CALLS	#2,STAT
	MOVL	#LBR$_ILLCTL,R0
	PUSHL	R0
	PUSHAQ	S22
	CALLS	#2,STAT
	MOVL	#LBR$_LIBNOTOPN,R0
	PUSHL	R0
	PUSHAQ	S23
	CALLS	#2,STAT
	MOVL	#LBR$_NOTHLPLIB,R0
	PUSHL	R0
	PUSHAQ	S24
	CALLS	#2,STAT
	MOVL	#LBR$_TYPMISMCH,R0
	PUSHL	R0
	PUSHAQ	S25
	CALLS	#2,STAT
	MOVL	#LBR$_ILLINROU,R0
	PUSHL	R0
	PUSHAQ	S26
	CALLS	#2,STAT
	MOVL	#LBR$_ILLOUTROU,R0
	PUSHL	R0
	PUSHAQ	S27
	CALLS	#2,STAT
	MOVL	#LBR$_NOHLPLIBS,R0
	PUSHL	R0
	PUSHAQ	S28
	CALLS	#2,STAT
	MOVL	#LBR$_TOOMNYARG,R0
	PUSHL	R0
	PUSHAQ	S29
	CALLS	#2,STAT
	MOVL	#LBR$_USRINPERR,R0
