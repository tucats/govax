	CALLS	#0,C12
	CALLS	#0,C13
	CALLS	#0,C14
	CALLS	#0,C15
	CALLS	#0,C16
	CALLS	#0,C17
	CALLS	#0,C18
	CALLS	#0,C19
	CALLS	#0,C20
	CALLS	#0,C21
	CALLS	#0,C22
	CALLS	#0,C23
	CALLS	#0,C24
	CALLS	#0,C25
	CALLS	#0,C26
	CALLS	#0,C27
	CALLS	#0,C28
	CALLS	#0,C29
	CALLS	#0,C30
	CALLS	#0,C31
	CALLS	#0,C32
	CALLS	#0,C33
	CALLS	#0,C34
	CALLS	#0,C35
	CALLS	#0,C36
	MOVL	#1,R0
	RET
; TIMEOUT, the timer's AST: a case that ran past its two minutes.
	.ENTRY	TIMEOUT,^M<>
	PUSHAB	MTIME
	CALLS	#1,OUT
	$EXIT_S	CODE=#SS$_TIMEOUT
	.END	START
