S215:	.ASCID	~Record of binary key 5.~
S216:	.ASCID	~Record of binary key 1.~
S217:	.ASCID	~Record of binary key 3.~
S218:	.ASCID	~W14, VMS V2 format~
S219:	.ASCID	~H90DIR:W14~
S220:	.ASCID	~V2's record.~
S221:	.ASCID	~V2~
S222:	.ASCID	~W15, options all 0 but the type~
S223:	.ASCID	~H90DIR:W15~
S224:	.ASCID	~Z's record.~
S225:	.ASCID	~create errors~
S226:	.ASCID	~H90DIR:WE1~
S227:	.ASCID	~H90DIR:WE2~
S228:	.ASCID	~H90DIR:WE3~
S229:	.ASCID	~H90DIR:WE4~
S230:	.ASCID	~H90DIR:NOSUCH~
S231:	.ASCID	~RET_RMSSTV~
S232:	.ASCID	~W1 created again, and W2 opened twice to update~
S233:	.ASCID	~W16, records with no PUT_END or key~
S234:	.ASCID	~H90DIR:W16~
S235:	.ASCID	~Keyless's record.~
S236:	.ASCID	~Unended's first record.~
S237:	.ASCID	~Unended's second record.~
S238:	.ASCID	~H90T updated: T3 added, T1 replaced~
S239:	.ASCID	~Only line of T3, by the routines.~
S240:	.ASCID	~T3~
S241:	.ASCID	~T1's new line.~
S242:	.ASCID	~A history record by LBR90W.~
S243:	.ASCID	~T2~
S244:	.ASCID	~H90S, a shareable image library LIBRARY made~
S245:	.ASCID	~H90DIR:H90S~
S246:	.ASCID	~H90OS~
S247:	.ASCID	~the NAM block, a related name, and the resultant name~
S248:	.ASCID	~H90DIR:~
S249:	.ASCID	~17 control indexes~
	.PSECT	C,EXE,NOWRT,LONG
; OUT(control, values...) writes a line.
	.ENTRY	OUT,^M<R2,R3,R4,R5>
	$FAOL_S	CTRSTR=@4(AP),OUTLEN=LD,OUTBUF=BD,PRMLST=8(AP)
	PUSHAB	LD
	CALLS	#1,G^LIB$PUT_OUTPUT
	RET
; VALUE(name, value)
	.ENTRY	VALUE,^M<>
	PUSHL	8(AP)
	PUSHL	4(AP)
	PUSHAB	MVAL
	CALLS	#3,OUT
	RET
; STAT(name, status) shows a status and its message.
	.ENTRY	STAT,^M<R2>
	MOVL	8(AP),R2
	CLRW	MTL
	PUSHL	#0
	PUSHL	#15
	PUSHAQ	MTD
	PUSHAW	MTL
	PUSHL	R2
	CALLS	#5,G^SYS$GETMSG
	PUSHAB	MT
	MOVZWL	MTL,-(SP)
	PUSHL	R2
	PUSHL	4(AP)
	PUSHAB	MSTAT
	CALLS	#5,OUT
	MOVL	R2,R0
	RET
; HND shows a condition, continues below severe, and unwinds from a
; severe one.
HND:	.WORD	^M<R2>
	MOVL	4(AP),R2
	CMPL	4(R2),#SS$_UNWIND
	BEQL	50$
	PUSHL	12(R2)
	PUSHL	8(R2)
	PUSHL	(R2)
	PUSHL	4(R2)
	PUSHAB	MCOND
	CALLS	#5,OUT
	BICL3	#^XFFFFFFF8,4(R2),R0
	CMPL	R0,#4
	BEQL	40$
	MOVL	#SS$_CONTINUE,R0
	RET
40$:	PUSHAB	MUNW
	CALLS	#1,OUT
	$UNWIND_S
50$:	MOVL	#SS$_CONTINUE,R0
	RET
; SHOWRFA(rfa) shows an RFA.
	.ENTRY	SHOWRFA,^M<R2>
	MOVL	4(AP),R2
	MOVZWL	4(R2),-(SP)
	PUSHL	(R2)
	PUSHAB	MRFA
	CALLS	#3,OUT
	RET
; RECSI(index) shows the index's records from the current one.
	.ENTRY	RECSI,^M<R2,R3>
	CLRL	R3
10$:	CLRW	OUTBD
	CLRL	OUTBD+4
	PUSHAQ	OUTBD
	PUSHAQ	INBD
	PUSHL	4(AP)
	CALLS	#3,G^LBR$GET_RECORD
	MOVL	R0,R2
	BLBC	R2,20$
	INCL	R3
	PUSHAQ	OUTBD
	MOVZWL	OUTBD,-(SP)
	PUSHL	R3
	PUSHAB	MREC
	CALLS	#4,OUT
	CMPL	R3,#200
	BLSS	10$
20$:	PUSHL	R2
	PUSHAB	MRECS
	CALLS	#2,OUT
	RET
; RECN(index) counts the index's records from the current one, and their
; bytes.
	.ENTRY	RECN,^M<R2,R3,R4>
	CLRL	R3
	CLRL	R4
10$:	CLRW	OUTBD
	CLRL	OUTBD+4
	PUSHAQ	OUTBD
	PUSHAQ	BIGIND
	PUSHL	4(AP)
	CALLS	#3,G^LBR$GET_RECORD
	MOVL	R0,R2
	BLBC	R2,20$
	INCL	R3
	MOVZWL	OUTBD,R0
	ADDL2	R0,R4
	CMPL	R3,#5000
	BLSS	10$
20$:	PUSHL	R2
	PUSHL	R4
	PUSHL	R3
	PUSHAB	MRECN
	CALLS	#4,OUT
	RET
; HEADERI(index) shows LBR$GET_HEADER's 128 longwords.
	.ENTRY	HEADERI,^M<R2,R3>
	PUSHAL	HDR
	PUSHL	4(AP)
	CALLS	#2,G^LBR$GET_HEADER
	PUSHL	R0
	PUSHAQ	NHDR
	CALLS	#2,STAT
	MOVAL	HDR,R2
	CLRL	R3
10$:	PUSHL	28(R2)
	PUSHL	24(R2)
	PUSHL	20(R2)
	PUSHL	16(R2)
	PUSHL	12(R2)
	PUSHL	8(R2)
	PUSHL	4(R2)
	PUSHL	(R2)
	PUSHL	R3
	PUSHAB	MHDR
	CALLS	#10,OUT
	ADDL2	#32,R2
	ADDL2	#8,R3
	CMPL	R3,#128
	BLSS	10$
	RET
; DUMPB(address, length) shows bytes, 16 to a line, with their offsets.
	.ENTRY	DUMPB,^M<R2,R3,R4,R5>
	MOVL	4(AP),R2
	MOVL	8(AP),R3
	CLRL	R5
10$:	TSTL	R3
	BLEQ	40$
	MOVL	#16,R4
	CMPL	R3,R4
	BGEQ	20$
	MOVL	R3,R4
20$:	MOVL	R4,R1
30$:	DECL	R1
	MOVZBL	(R2)[R1],-(SP)
	TSTL	R1
	BGTR	30$
	PUSHL	R4
	PUSHL	R5
	PUSHAB	MDUMP
	ADDL3	#3,R4,R0
	CALLS	R0,OUT
	ADDL2	R4,R2
	ADDL2	R4,R5
	SUBL2	R4,R3
	BRB	10$
40$:	RET
; MODHDR(index, rfa) shows a module's header, read by LBR$SET_MODULE
; into a buffer filled with EE first.
	.ENTRY	MODHDR,^M<R2,R3,R4,R5>
	MOVC5	#0,MHB,#^XEE,#512,MHB
	CLRL	MHLEN
	PUSHAL	MHLEN
	PUSHAQ	MHBD
	PUSHL	8(AP)
	PUSHL	4(AP)
	CALLS	#4,G^LBR$SET_MODULE
	PUSHL	R0
	PUSHAQ	NSET
	CALLS	#2,STAT
	PUSHL	MHLEN
	PUSHAB	MMOD
	CALLS	#2,OUT
	MOVL	MHLEN,R0
	CMPL	R0,#512
	BLEQU	10$
	MOVL	#64,R0
10$:	PUSHL	R0
	PUSHAB	MHB
	CALLS	#2,DUMPB
	RET
; KEYR(key, rfa), GET_INDEX's and SEARCH's routine: shows the key, and
; fails once COUNT reaches a nonzero LIMIT.
	.ENTRY	KEYR,^M<R2>
	INCL	COUNT
	MOVL	8(AP),R2
	MOVZWL	4(R2),-(SP)
	PUSHL	(R2)
	PUSHL	4(AP)
	PUSHAB	MKEY
	CALLS	#4,OUT
	BRB	LIMITED
; LIMITED returns 0 once COUNT reaches a nonzero LIMIT, else 1.
LIMITED: MOVL	#1,R0
	TSTL	LIMIT
	BEQL	10$
	CMPL	COUNT,LIMIT
	BLSS	10$
	CLRL	R0
10$:	RET
; KEYB(key, rfa), the routine for binary keys: the key argument shown as
; the longword it addresses when it looks like an address (a=1), else as
; it is (a=0).
	.ENTRY	KEYB,^M<R2,R3>
	INCL	COUNT
	MOVL	4(AP),R2
	CLRL	R3
	CMPL	R2,#^X1000
	BLSSU	10$
	MOVL	(R2),R2
	MOVL	#1,R3
10$:	MOVL	8(AP),R0
	MOVZWL	4(R0),-(SP)
	PUSHL	(R0)
	PUSHL	R3
	PUSHL	R2
	PUSHAB	MBKEY
	CALLS	#5,OUT
	BRW	LIMITED
; KEYINS(key, rfa): inserts and deletes a key from inside GET_INDEX or
; SEARCH, then stops it.
	.ENTRY	KEYINS,^M<>
	INCL	COUNT
	PUSHL	8(AP)
	PUSHAQ	INTRAV
	PUSHAL	IDX
	CALLS	#3,G^LBR$INSERT_KEY
	PUSHL	R0
	PUSHAQ	NINS
	CALLS	#2,STAT
	PUSHL	4(AP)
	PUSHAL	IDX
	CALLS	#2,G^LBR$DELETE_KEY
	PUSHL	R0
	PUSHAQ	NDEL
	CALLS	#2,STAT
	CLRL	R0
	RET
; HELPR(line, flags, data, level), GET_HELP's routine, as LBR90's.
	.ENTRY	HELPR,^M<R2,R3>
	INCL	COUNT
	MOVL	16(AP),R2
	CLRL	R3
	CMPL	R2,#^X1000
	BLSSU	10$
	MOVL	(R2),R2
	MOVL	#1,R3
10$:	PUSHL	4(AP)
	PUSHL	#0
	PUSHL	R3
	PUSHL	R2
	PUSHL	@8(AP)
	PUSHAB	MHLP
	CALLS	#6,OUT
	BRW	LIMITED
; HISTR(record), GET_HISTORY's routine: the record as text and in hex.
	.ENTRY	HISTR,^M<R2>
	INCL	COUNT
	MOVL	4(AP),R2
	PUSHL	4(R2)
	MOVZWL	(R2),-(SP)
	MOVZWL	(R2),-(SP)
	PUSHAB	MHIST
	CALLS	#4,OUT
	MOVZWL	(R2),-(SP)
	PUSHL	4(R2)
	CALLS	#2,DUMPB
	BRW	LIMITED
; MANY(index, n) writes n modules of a record each, keyed Knnn in the
; order 37*i mod 127, and shows how many of each call failed.
	.ENTRY	MANY,^M<R2,R3,R4,R5,R6,R7,R8,R9>
	CLRL	R6
	CLRL	R7
	CLRL	R8
	CLRL	R9
10$:	INCL	R6
	CMPL	R6,8(AP)
	BLEQ	15$
	BRW	50$
15$:	MULL3	#37,R6,R2
	CLRL	R3
	EDIV	#127,R2,R4,R5
	$FAO_S	CTRSTR=MKN,OUTLEN=KEYD,OUTBUF=KEYBD,P1=R5
	$FAO_S	CTRSTR=MRN,OUTLEN=RECD,OUTBUF=RECBD,P1=R5
	PUSHAL	RFAX
	PUSHAQ	RECD
	PUSHL	4(AP)
	CALLS	#3,G^LBR$PUT_RECORD
	MOVL	R0,LASTP
	BLBS	R0,20$
	INCL	R7
20$:	PUSHL	4(AP)
	CALLS	#1,G^LBR$PUT_END
	MOVL	R0,LASTE
	BLBS	R0,30$
	INCL	R8
30$:	PUSHAL	RFAX
	PUSHAQ	KEYD
	PUSHL	4(AP)
	CALLS	#3,G^LBR$INSERT_KEY
	MOVL	R0,LASTI
	BLBS	R0,40$
	INCL	R9
40$:	BRW	10$
50$:	PUSHL	LASTI
	PUSHL	R9
	PUSHL	LASTE
	PUSHL	R8
	PUSHL	LASTP
	PUSHL	R7
	PUSHL	8(AP)
	PUSHAB	MMANY
	CALLS	#8,OUT
	RET
; PUTN(index, n, rfa) writes n records of 80 bytes, Lnnnn and dots.
	.ENTRY	PUTN,^M<R2,R3,R4,R5,R6>
	CLRL	R6
	CLRL	R3
10$:	INCL	R6
	CMPL	R6,8(AP)
	BGTR	30$
	$FAO_S	CTRSTR=MLN,OUTLEN=RECD,OUTBUF=RECBD,P1=R6
	PUSHL	12(AP)
	PUSHAQ	RECD
	PUSHL	4(AP)
	CALLS	#3,G^LBR$PUT_RECORD
	MOVL	R0,LASTP
	BLBS	R0,10$
	INCL	R3
	BRB	10$
30$:	PUSHL	LASTP
	PUSHL	R3
	PUSHL	8(AP)
	PUSHAB	MPUTN
	CALLS	#4,OUT
	RET
; PUTOBJ(index, rfa) writes H90O.OBJ's records as a module's.
	.ENTRY	PUTOBJ,^M<R2,R3>
	CLRL	R3
	$OPEN	FAB=OFAB
	BLBC	R0,80$
	$CONNECT RAB=ORAB
	BLBC	R0,80$
10$:	$GET	RAB=ORAB
	BLBC	R0,30$
	INCL	R3
	MOVW	ORAB+RAB$W_RSZ,ORD
	PUSHL	8(AP)
	PUSHAQ	ORD
	PUSHL	4(AP)
	CALLS	#3,G^LBR$PUT_RECORD
	BLBS	R0,10$
	PUSHL	R0
	PUSHAQ	NPUT
	CALLS	#2,STAT
	BRB	10$
30$:	$CLOSE	FAB=OFAB
	PUSHL	R3
	PUSHAB	MOBJ
	CALLS	#2,OUT
	RET
80$:	PUSHL	R0
	PUSHAQ	NOBJ
	CALLS	#2,STAT
	RET
; SHOWNAM shows OPEN's resultant name and the NAM block's.
	.ENTRY	SHOWNAM,^M<R2>
	MOVL	RNSL,R2
	CMPL	R2,#128
	BLEQU	10$
	MOVL	#128,R2
10$:	MOVZWL	ONAM+NAM$W_FID+4,-(SP)
	MOVZWL	ONAM+NAM$W_FID+2,-(SP)
	MOVZWL	ONAM+NAM$W_FID,-(SP)
	PUSHAB	NRS
	MOVZBL	ONAM+NAM$B_RSL,-(SP)
	MOVZBL	ONAM+NAM$B_RSL,-(SP)
	PUSHAB	RNSB
	PUSHL	R2
	PUSHL	RNSL
	PUSHAB	MNAM
	CALLS	#10,OUT
	RET
; SEVENTEEN initializes 17 control indexes, showing each status.
	.ENTRY	SEVENTEEN,^M<R2,R3>
	CLRL	R2
	MOVAL	MANYX,R3
10$:	INCL	R2
	PUSHAL	TTXT
	PUSHAL	FREAD
	PUSHL	R3
	CALLS	#3,G^LBR$INI_CONTROL
	PUSHL	R0
	PUSHL	R2
	PUSHAB	MSEV
	CALLS	#3,OUT
	ADDL2	#4,R3
	CMPL	R2,#17
	BLSS	10$
	RET
	.ENTRY	C1,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
	PUSHAB	S1
	PUSHL	#1
	PUSHAB	MCASE
	CALLS	#3,OUT
	PUSHL	#CRE$C_VMSV2
	PUSHAQ	S2
	CALLS	#2,VALUE
	PUSHL	#CRE$C_VMSV3
	PUSHAQ	S3
	CALLS	#2,VALUE
	PUSHL	#CRE$C_HLPCASING
	PUSHAQ	S4
	CALLS	#2,VALUE
	PUSHL	#CRE$C_OBJCASING
	PUSHAQ	S5
	CALLS	#2,VALUE
	PUSHL	#CRE$C_MACTXTCAS
	PUSHAQ	S6
	CALLS	#2,VALUE
	PUSHL	#CRE$L_TYPE
	PUSHAQ	S7
