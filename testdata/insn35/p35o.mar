	.TITLE	P35O	Phase 35 octawords probe
	.IDENT	/V1.0/

; Written by testdata/insn35/gen.go: do not edit. Runs each case's
; instruction and writes, per case, its name, whether it completed, the
; PSL after it, R0-R11, any signal array, and DST to P35O.DMP. See
; gen.go for the record's layout.

	$SSDEF

	.PSECT	DATA,NOEXE,WRT,LONG
OFAB:	$FAB	FNM=<P35O.DMP>,FAC=PUT,RFM=VAR,MRS=512
ORAB:	$RAB	FAB=OFAB,RBF=REC,RSZ=260
	.ALIGN	LONG
REC:	.ASCII	/I35R/
STEP:	.LONG	0
NAME:	.BLKB	32
FLAGS:	.LONG	0
PSLV:	.LONG	0
REGV:	.BLKL	12
SIGV:	.BLKL	9
DST:	.BLKB	128
	.ALIGN	LONG
D_X:	.LONG	^X03020100,^X07060504,^X0B0A0908,^X0F0E0D0C
	.LONG	^X13121110,^X17161514,^X1B1A1918,^X1F1E1D1C
	.LONG	^X23222120,^X27262524,^X2B2A2928,^X2F2E2D2C
	.LONG	^X33323130,^X37363534,^X3B3A3938,^X3F3E3D3C
; 1: CLRO
N1:	.ASCII	|CLRO                            |
; 2: CLRO R6
N2:	.ASCII	|CLRO R6                         |
; 3: CLRO, CC clear
N3:	.ASCII	|CLRO, CC clear                  |
; 4: MOVO pattern
N4:	.ASCII	|MOVO pattern                    |
D4_1:	.BYTE	^X00,^X01,^X02,^X03,^X04,^X05,^X06,^X07,^X08,^X09,^X0A,^X0B,^X0C,^X0D,^X0E,^X0F
; 5: MOVO pattern, CC clear
N5:	.ASCII	|MOVO pattern, CC clear          |
D5_1:	.BYTE	^X00,^X01,^X02,^X03,^X04,^X05,^X06,^X07,^X08,^X09,^X0A,^X0B,^X0C,^X0D,^X0E,^X0F
; 6: MOVO zero
N6:	.ASCII	|MOVO zero                       |
D6_1:	.BYTE	^X00,^X00,^X00,^X00,^X00,^X00,^X00,^X00,^X00,^X00,^X00,^X00,^X00,^X00,^X00,^X00
; 7: MOVO negative
N7:	.ASCII	|MOVO negative                   |
D7_1:	.BYTE	^X00,^X00,^X00,^X00,^X00,^X00,^X00,^X00,^X00,^X00,^X00,^X00,^X00,^X00,^X00,^X80
; 8: MOVO low bit
N8:	.ASCII	|MOVO low bit                    |
D8_1:	.BYTE	^X01,^X00,^X00,^X00,^X00,^X00,^X00,^X00,^X00,^X00,^X00,^X00,^X00,^X00,^X00,^X00
; 9: MOVO bit 64
N9:	.ASCII	|MOVO bit 64                     |
D9_1:	.BYTE	^X00,^X00,^X00,^X00,^X00,^X00,^X00,^X00,^X01,^X00,^X00,^X00,^X00,^X00,^X00,^X00
; 10: MOVO to R6
N10:	.ASCII	|MOVO to R6                      |
D10_1:	.BYTE	^X00,^X01,^X02,^X03,^X04,^X05,^X06,^X07,^X08,^X09,^X0A,^X0B,^X0C,^X0D,^X0E,^X0F
; 11: MOVO from R2
N11:	.ASCII	|MOVO from R2                    |
; 12: MOVO R2 to R6
N12:	.ASCII	|MOVO R2 to R6                   |
; 13: MOVO R6 to R4 (overlap)
N13:	.ASCII	|MOVO R6 to R4 (overlap)         |
; 14: MOVO to (R2)+
N14:	.ASCII	|MOVO to (R2)+                   |
D14_1:	.BYTE	^X00,^X01,^X02,^X03,^X04,^X05,^X06,^X07,^X08,^X09,^X0A,^X0B,^X0C,^X0D,^X0E,^X0F
; 15: MOVO to -(R2)
N15:	.ASCII	|MOVO to -(R2)                   |
D15_1:	.BYTE	^X10,^X11,^X12,^X13,^X14,^X15,^X16,^X17,^X18,^X19,^X1A,^X1B,^X1C,^X1D,^X1E,^X1F
; 16: MOVO (R2)+ source
N16:	.ASCII	|MOVO (R2)+ source               |
; 17: MOVO -(R2) source
N17:	.ASCII	|MOVO -(R2) source               |
; 18: MOVO indexed
N18:	.ASCII	|MOVO indexed                    |
; 19: MOVO to indexed
N19:	.ASCII	|MOVO to indexed                 |
D19_1:	.BYTE	^X00,^X01,^X02,^X03,^X04,^X05,^X06,^X07,^X08,^X09,^X0A,^X0B,^X0C,^X0D,^X0E,^X0F
; 20: MOVO literal
N20:	.ASCII	|MOVO literal                    |
; 21: MOVO literal 63
N21:	.ASCII	|MOVO literal 63                 |
; 22: MOVO immediate -1
N22:	.ASCII	|MOVO immediate -1               |
; 23: MOVO immediate ^X12345678
N23:	.ASCII	|MOVO immediate ^X12345678       |
; 24: MOVO immediate ^X80000000
N24:	.ASCII	|MOVO immediate ^X80000000       |
; 25: MOVAO indexed
N25:	.ASCII	|MOVAO indexed                   |
; 26: MOVAO (R2)+
N26:	.ASCII	|MOVAO (R2)+                     |
; 27: PUSHAO indexed
N27:	.ASCII	|PUSHAO indexed                  |
; 28: MOVO R12 to R6
N28:	.ASCII	|MOVO R12 to R6                  |

	.PSECT	CODE,EXE,NOWRT,LONG
	.ENTRY	P35O,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	$CREATE	FAB=OFAB
	BLBS	R0,1$
	RET
1$:	$CONNECT RAB=ORAB
	BLBS	R0,2$
	RET
2$:
; 1: CLRO
	MOVL	#1,STEP
	MOVC3	#32,N1,NAME
	JSB	SETUP
	CALLS	#0,C1
	JSB	SAVE
; 2: CLRO R6
	MOVL	#2,STEP
	MOVC3	#32,N2,NAME
	JSB	SETUP
	CALLS	#0,C2
	JSB	SAVE
; 3: CLRO, CC clear
	MOVL	#3,STEP
	MOVC3	#32,N3,NAME
	JSB	SETUP
	CALLS	#0,C3
	JSB	SAVE
; 4: MOVO pattern
	MOVL	#4,STEP
	MOVC3	#32,N4,NAME
	JSB	SETUP
	CALLS	#0,C4
	JSB	SAVE
; 5: MOVO pattern, CC clear
