	JSB	SAVE
; 16: MOVO (R2)+ source
	MOVL	#16,STEP
	MOVC3	#32,N16,NAME
	JSB	SETUP
	CALLS	#0,C16
	JSB	SAVE
; 17: MOVO -(R2) source
