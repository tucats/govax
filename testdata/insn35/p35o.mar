	RET

; 24: MOVO immediate ^X80000000
	.ENTRY	C24,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	JSB	LOADREGS
	BICPSW	#^XEF
	BISPSW	#^X0F
	MOVO	#^X80000000,DST
	MOVPSL	PSLV
	JSB	SAVEREGS
	RET

; 25: MOVAO indexed
	.ENTRY	C25,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	JSB	LOADREGS
	MOVL	#^X2,R4
	BICPSW	#^XEF
	BISPSW	#^X0F
	MOVAO	D_X[R4],DST
	MOVPSL	PSLV
	SUBL2	#D_X,DST
	JSB	SAVEREGS
	RET

; 26: MOVAO (R2)+
	.ENTRY	C26,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	JSB	LOADREGS
	MOVAB	D_X,R2
	BICPSW	#^XEF
	BISPSW	#^X0F
	MOVAO	(R2)+,DST
	MOVPSL	PSLV
	SUBL2	#D_X,DST
	SUBL2	#D_X,R2
	JSB	SAVEREGS
	RET

; 27: PUSHAO indexed
	.ENTRY	C27,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	JSB	LOADREGS
	MOVL	#^X3,R4
	BICPSW	#^XEF
	BISPSW	#^X0F
	PUSHAO	D_X[R4]
	MOVPSL	PSLV
	SUBL3	#D_X,(SP)+,DST
	JSB	SAVEREGS
	RET

; 28: MOVO R12 to R6
	.ENTRY	C28,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	JSB	LOADREGS
	BICPSW	#^XEF
	BISPSW	#^X0F
	.BYTE	^XFD,^X7D,^X5C,^X56	; MOVO R12,R6
	MOVPSL	PSLV
	JSB	SAVEREGS
	RET

	.END	P35O
