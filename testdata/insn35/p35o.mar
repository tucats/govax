	JSB	SAVE
; 10: MOVO to R6
	MOVL	#10,STEP
	MOVC3	#32,N10,NAME
	JSB	SETUP
	CALLS	#0,C10
	JSB	SAVE
; 11: MOVO from R2
	MOVL	#11,STEP
	MOVC3	#32,N11,NAME
	JSB	SETUP
	CALLS	#0,C11
	JSB	SAVE
; 12: MOVO R2 to R6
	MOVL	#12,STEP
	MOVC3	#32,N12,NAME
	JSB	SETUP
	CALLS	#0,C12
	JSB	SAVE
; 13: MOVO R6 to R4 (overlap)
	MOVL	#13,STEP
	MOVC3	#32,N13,NAME
	JSB	SETUP
	CALLS	#0,C13
	JSB	SAVE
; 14: MOVO to (R2)+
	MOVL	#14,STEP
	MOVC3	#32,N14,NAME
	JSB	SETUP
	CALLS	#0,C14
	JSB	SAVE
; 15: MOVO to -(R2)
	MOVL	#15,STEP
	MOVC3	#32,N15,NAME
	JSB	SETUP
