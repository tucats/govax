$ !
$ WRITE SYS$OUTPUT "######## THE END"
######## THE END
$ DEFINE/USER_MODE PRIV94_PART "Z"
$ RUN PRIV94$DISK:[000000]PRIV94B
user SYSTEM       uic [1,4] base priority 4
  auth FFFFFFFFFFFFFFFF proc FFFFFFFFFFFFFFFF
  cur  FFFFFFFFFFFFFFFF imag 0000000000000000
parts Z
== 2 Z the end
  PRIV94_PMBX 00000001
  PRIV94_OT 00000001
  PRIV94_PT 00000001
  PRIV94_L21 00000001
  PRIV94_L49 00000001
  PRIV94_L51 00000001
  ~ swept 0
  R0 00000001 %SYSTEM-S-NORMAL, normal successful completion
end of cases
  auth FFFFFFFFFFFFFFFF proc FFFFFFFFFFFFFFFF
  cur  FFFFFFFFFFFFFFFF imag 0000000000000000
$ DEASSIGN/TABLE=LNM$SYSTEM_DIRECTORY PRIV94_DO
$ DEASSIGN/TABLE=LNM$SYSTEM_DIRECTORY PRIV94_DP
$ SHOW LOGICAL/SYSTEM PRIV94*

(LNM$SYSTEM_TABLE)

  "PRIV94$DISK" = "DUA1:"
$ SHOW LOGICAL/TABLE=LNM$SYSTEM_DIRECTORY PRIV94*

(LNM$SYSTEM_DIRECTORY)

  "PRIV94_TB10" [table] = ""
  "PRIV94_TB11" [table] = ""
  "PRIV94_TB12" [table] = ""
  "PRIV94_TB7" [table] = ""
  "PRIV94_TB8" [table] = ""
  "PRIV94_TB9" [table] = ""
$ SHOW LOGICAL/TABLE=LNM$GROUP_000200 PRIV94*

(LNM$GROUP_000200)
%SHOW-S-NOTRAN, no translation for logical name PRIV94*
$ !
$ WRITE SYS$OUTPUT "######## REMOVING THE ACCOUNT"
######## REMOVING THE ACCOUNT
$ HOME = F$ENVIRONMENT("DEFAULT")
$ SET DEFAULT SYS$SYSTEM
$ RUN SYS$SYSTEM:AUTHORIZE
REMOVE PRIV94
%UAF-I-REMMSG, record removed from system authorization file
%UAF-I-RDBREMMSGU, identifier PRIV94 value [000200,000003] removed from rights database
EXIT
%UAF-I-DONEMSG, system authorization file modified
%UAF-I-RDBDONEMSG, rights database modified
$ SET DEFAULT SYS$SYSROOT:[SYSMGR]
$ WRITE SYS$OUTPUT "PRIV94Y FINISHED"
PRIV94Y FINISHED
$ SET NOVERIFY
