	PUSHL	STAT
	CALLS	#1,SHOWSTAT
	CALLS	#0,SHOWINNER
	SAY	</  prvprv !XL!XL/>,PRVQ+4,PRVQ
	CALLS	#0,SHOWMASKS
	CALLS	#0,RESTOREPROC
	CALLS	#0,RESTORE
	RET
	.ENTRY	B245,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MNEGL	#1,PRVQ
	MNEGL	#1,PRVQ+4
	$SETPRV_S ENBFLG=#1,PRVADR=ALLQ,PRVPRV=PRVQ
	MOVL	R0,R2
	CALLS	#0,MASKS
	MOVL	R2,R0
	RET

; 246: $SETPRV OPER permanently and ALTPRI for the image, left so
	.ENTRY	C246,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	SAY	</!AS/>,#C246_XT
	CALLS	#0,SETALL
	PUSHAQ	C246_XM
	CALLS	#1,SETPRIVS
	CALLS	#0,B246
	MOVL	R0,STAT
	MOVL	#1,KEEP
	PUSHL	STAT
	CALLS	#1,SHOWSTAT
	SAY	</  first !XL/>,RES1
	CALLS	#0,SHOWMASKS
	RET
	.ENTRY	B246,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	$SETPRV_S ENBFLG=#1,PRVADR=OPERQ,PRMFLG=#1
	MOVL	R0,RES1
	$SETPRV_S ENBFLG=#1,PRVADR=ALTPRIQ
	MOVL	R0,R2
	CALLS	#0,MASKS
	MOVL	R2,R0
	RET

