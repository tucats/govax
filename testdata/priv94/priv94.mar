; 12: $CRELNM PRIV94_OT user-mode name
	.ENTRY	C12,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	SAY	</!AS/>,#C12_XT
	CALLS	#0,SETALL
	PUSHAQ	C12_XM
	CALLS	#1,SETPRIVS
	CALLS	#0,B12
	MOVL	R0,STAT
	CALLS	#0,SETALL
	PUSHL	STAT
	CALLS	#1,SHOWSTAT
	PUSHAQ	C12_N
	PUSHAQ	OTTAB
	CALLS	#2,LNMSHOW
	$DELLNM_S TABNAM=OTTAB,LOGNAM=C12_N,ACMODE=MODEU
	CALLS	#0,RESTORE
	RET
	.ENTRY	B12,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	$CRELNM_S TABNAM=OTTAB,LOGNAM=C12_N,ACMODE=MODEU,ITMLST=EQVLST
	RET

; 13: $CRELNM PRIV94_OT user-mode name
	.ENTRY	C13,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	SAY	</!AS/>,#C13_XT
	CALLS	#0,SETALL
	PUSHAQ	C13_XM
