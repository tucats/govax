	SAY	</  lksb !XL deq !XL/>,R1,RES1
	CALLS	#0,RESTORE
	RET
	.ENTRY	B123,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	CLRQ	LKSB
	CLRL	RES1
	$ENQW_S LKMODE=#LCK$K_EXMODE,LKSB=LKSB,FLAGS=#0,RESNAM=RESNAM
	BLBC	R0,9$
	MOVL	R0,R2
	$DEQ_S LKID=LKSB+4
	MOVL	R0,RES1
	MOVL	R2,R0
9$:
	RET

