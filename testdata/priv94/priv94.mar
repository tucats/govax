	CALLS	#1,SHOWSTAT
	SAY	</  prvprv !XL!XL/>,PRVQ+4,PRVQ
	CALLS	#0,SHOWMASKS
	CALLS	#0,RESTOREPROC
	CALLS	#0,RESTORE
	RET
