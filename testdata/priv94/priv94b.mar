	MOVL	R0,STAT
	CALLS	#0,SETALL
	PUSHL	STAT
	CALLS	#1,SHOWSTAT
	PUSHAQ	C4_N
	PUSHAQ	FILEDEV
	CALLS	#2,LNMSHOW
	CALLS	#0,DROPMBX
	CALLS	#0,RESTORE
	RET
	.ENTRY	B4,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	$CREMBX_S PRMFLG=#1,CHAN=CHAN,MAXMSG=#64,BUFQUO=#256,ACMODE=#3,LOGNAM=C4_N
	RET

