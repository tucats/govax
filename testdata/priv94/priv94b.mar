; 18: $CRELNT under PRIV94_OT, quota 100
	.ENTRY	C18,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	SAY	</!AS/>,#C18_XT
	CALLS	#0,SETALL
	PUSHAQ	C18_XM
	CALLS	#1,SETPRIVS
	CALLS	#0,B18
	MOVL	R0,STAT
	CALLS	#0,SETALL
	PUSHL	STAT
	CALLS	#1,SHOWSTAT
	PUSHAQ	C18_N
	PUSHAQ	OTTAB
	CALLS	#2,LNMSHOW
	$DELLNM_S TABNAM=OTTAB,LOGNAM=C18_N,ACMODE=MODEU
	CALLS	#0,RESTORE
	RET
	.ENTRY	B18,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	$CRELNT_S TABNAM=C18_N,PARTAB=OTTAB,QUOTA=C18_Q
	RET

