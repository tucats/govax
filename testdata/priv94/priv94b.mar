; 11: $ULKPAG of a page it locked, as round 1
	.ENTRY	C11,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	SAY	</!AS/>,#C11_XT
	CALLS	#0,SETALL
	$LCKPAG_S INADR=PAGEADR
	SAY	</  made !XL/>,R0
	PUSHAQ	C11_XM
	CALLS	#1,SETPRIVS
	CALLS	#0,B11
	MOVL	R0,STAT
	CALLS	#0,SETALL
	PUSHL	STAT
	CALLS	#1,SHOWSTAT
	SAY	</  retadr !XL !XL/>,RANGE,RANGE+4
	$ULKPAG_S INADR=PAGEADR
	SAY	</  undo ulkpag !XL/>,R0
	CLRQ	RANGE
	CALLS	#0,RESTORE
	RET
	.ENTRY	B11,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	CLRQ	RANGE
	$ULKPAG_S INADR=PAGEADR
	RET

