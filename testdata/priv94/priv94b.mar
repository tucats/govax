	.ALIGN	LONG
C36_XT:	.ASCID	"== 36 D user [] $DELLNM LNM$PROCESS_TABLE, acmode user, of names at user and exec"
C36_XM:	.LONG	^X00000000,^X00000000
C36_XD:	.LONG	^X00000000,^X00000000
C36_XA:	.LONG	1
	.ADDRESS B36
C36_N:	.ASCID	/PRIV94_LB7/

; 37: == 37 D user [SYSNAM] $DELLNM LNM$PROCESS_TABLE, no acmode, of names at exec
	.ALIGN	LONG
C37_XT:	.ASCID	"== 37 D user [SYSNAM] $DELLNM LNM$PROCESS_TABLE, no acmode, of names at exec"
C37_XM:	.LONG	^X00000004,^X00000000
C37_XD:	.LONG	^X00000000,^X00000000
C37_XA:	.LONG	1
	.ADDRESS B37
C37_N:	.ASCID	/PRIV94_LB8/

; 38: == 38 D user [SYSNAM] $DELLNM LNM$PROCESS_TABLE, acmode super, of names at user and super and exec and kernel
	.ALIGN	LONG
C38_XT:	.ASCID	"== 38 D user [SYSNAM] $DELLNM LNM$PROCESS_TABLE, acmode super, of names at user and super and exec and kernel"
C38_XM:	.LONG	^X00000004,^X00000000
C38_XD:	.LONG	^X00000000,^X00000000
C38_XA:	.LONG	1
	.ADDRESS B38
C38_N:	.ASCID	/PRIV94_LB9/

; 39: == 39 D user [SYSNAM] $DELLNM LNM$SYSTEM_TABLE, acmode exec, of names at user
	.ALIGN	LONG
C39_XT:	.ASCID	"== 39 D user [SYSNAM] $DELLNM LNM$SYSTEM_TABLE, acmode exec, of names at user"
C39_XM:	.LONG	^X00000004,^X00000000
C39_XD:	.LONG	^X00000000,^X00000000
C39_XA:	.LONG	1
	.ADDRESS B39
C39_N:	.ASCID	/PRIV94_LB10/

; 40: == 40 D user [SYSNAM] $DELLNM LNM$SYSTEM_TABLE, acmode user, of names at user and exec
	.ALIGN	LONG
C40_XT:	.ASCID	"== 40 D user [SYSNAM] $DELLNM LNM$SYSTEM_TABLE, acmode user, of names at user and exec"
C40_XM:	.LONG	^X00000004,^X00000000
C40_XD:	.LONG	^X00000000,^X00000000
C40_XA:	.LONG	1
	.ADDRESS B40
C40_N:	.ASCID	/PRIV94_LB11/

; The cases and their parts.
	.ALIGN	LONG
CASES:
	.ADDRESS C1
	.LONG	^A/F/
	.ADDRESS C2
	.LONG	^A/Z/
	.ADDRESS C3
	.LONG	^A/M/
	.ADDRESS C4
	.LONG	^A/M/
	.ADDRESS C5
	.LONG	^A/M/
	.ADDRESS C6
	.LONG	^A/M/
	.ADDRESS C7
	.LONG	^A/M/
	.ADDRESS C8
	.LONG	^A/M/
	.ADDRESS C9
	.LONG	^A/M/
	.ADDRESS C10
	.LONG	^A/M/
	.ADDRESS C11
	.LONG	^A/U/
	.ADDRESS C12
	.LONG	^A/U/
	.ADDRESS C13
	.LONG	^A/U/
	.ADDRESS C14
	.LONG	^A/U/
	.ADDRESS C15
	.LONG	^A/U/
	.ADDRESS C16
	.LONG	^A/U/
	.ADDRESS C17
	.LONG	^A/U/
	.ADDRESS C18
	.LONG	^A/N/
	.ADDRESS C19
	.LONG	^A/N/
	.ADDRESS C20
	.LONG	^A/N/
	.ADDRESS C21
	.LONG	^A/N/
	.ADDRESS C22
	.LONG	^A/N/
	.ADDRESS C23
	.LONG	^A/N/
	.ADDRESS C24
	.LONG	^A/N/
	.ADDRESS C25
	.LONG	^A/N/
	.ADDRESS C26
	.LONG	^A/N/
	.ADDRESS C27
	.LONG	^A/N/
	.ADDRESS C28
	.LONG	^A/N/
	.ADDRESS C29
	.LONG	^A/N/
	.ADDRESS C30
	.LONG	^A/D/
	.ADDRESS C31
	.LONG	^A/D/
	.ADDRESS C32
	.LONG	^A/D/
	.ADDRESS C33
	.LONG	^A/D/
	.ADDRESS C34
	.LONG	^A/D/
	.ADDRESS C35
	.LONG	^A/D/
	.ADDRESS C36
	.LONG	^A/D/
	.ADDRESS C37
	.LONG	^A/D/
	.ADDRESS C38
	.LONG	^A/D/
	.ADDRESS C39
	.LONG	^A/D/
	.ADDRESS C40
	.LONG	^A/D/
	.LONG	0,0

; Every name the cases make, for THEEND's sweep.
	.ALIGN	LONG
SWEEPN:
	.LONG	0

	.PSECT	CODE,NOWRT,EXE,LONG

	.ENTRY	START,^M<R2,R3,R4,R5,R6,R7,R8,R9>
	$GETJPIW_S ITMLST=SELFLST
	CALLS	#0,MASKS
	MOVQ	MASKBUF+16,INITQ
	MOVQ	MASKBUF+8,INITPROC
	SAY	</user !12AD uic !%U base priority !UL/>,#12,#USERBUF,OWNUIC,BASEPRI
	CALLS	#0,SHOWMASKS
	$TRNLNM_S TABNAM=FILEDEV,LOGNAM=PARTNAM,ITMLST=PARTLST
	BLBS	R0,2$
	MOVC3	#DEFLEN,DEFPART,PARTBUF
	MOVL	#DEFLEN,PARTLEN
2$:	MOVZWL	PARTLEN,PARTLEN
	$TRNLNM_S TABNAM=FILEDEV,LOGNAM=ONLYNAM,ITMLST=PIDLST
	BLBC	R0,3$
	PUSHAL	ONLY
	PUSHAB	PIDBUF
	MOVZWL	PIDLEN,-(SP)
	CALLS	#3,G^LIB$CVT_DTB
	SAY	</case !UL/>,ONLY
	BRB	4$
3$:	SAY	</parts !AD/>,PARTLEN,#PARTBUF
4$:	CALLS	#0,READPIDS
	MOVAB	CASES,R6
	CLRL	R9
10$:	MOVL	(R6)+,R7
	BNEQ	13$
	BRW	90$
13$:
	MOVL	(R6)+,R8
	INCL	R9
	TSTL	ONLY
	BEQL	11$
	CMPL	R9,ONLY
	BNEQ	10$
	BRB	12$
11$:	LOCC	R8,PARTLEN,PARTBUF
	BEQL	10$
12$:	CLRL	SIGCOND
	CALLS	#0,(R7)
	TSTL	SIGCOND
	BEQL	10$
	CALLS	#0,SHOWSIG
	BRB	10$
90$:	TSTL	KEEP
	BNEQ	91$
	CALLS	#0,RESTORE
91$:	CALLS	#0,MASKS
	SAY	</end of cases/>
	CALLS	#0,SHOWMASKS
	MOVL	#SS$_NORMAL,R0
	RET

; SHOWSIG: a condition that reached a case's handler, and the
; privileges the program started with back again.
	.ENTRY	SHOWSIG,^M<>
	SAY	</  signal !XL !XL !XL/>,SIGCOND,SIGARG1,SIGARG2
	TSTL	KEEP
	BNEQ	1$
	CALLS	#0,RESTORE
1$:	RET

; HANDLER records the condition (and an access violation's reason mask
; and address), then unwinds to the caller of the routine that
; established it, which gets the condition in R0. It ignores SS$_UNWIND.
	.ENTRY	HANDLER,^M<>
	MOVL	4(AP),R0
	CMPL	4(R0),#SS$_UNWIND
	BEQL	9$
	MOVL	4(R0),SIGCOND
	CLRQ	SIGARG1
	CMPL	SIGCOND,#SS$_ACCVIO
	BNEQ	1$
	MOVQ	8(R0),SIGARG1
1$:	MOVL	8(AP),R1
	MOVL	SIGCOND,12(R1)
	$UNWIND_S
9$:	RET

; SAYR text, a1, ...: format and write one line.
	.ENTRY	SAYR,^M<R2,R3,R4,R5>
	MOVL	#300,OUTD
	$FAOL_S	CTRSTR=@4(AP),OUTLEN=OUTLEN,OUTBUF=OUTD,PRMLST=8(AP)
	MOVZWL	OUTLEN,OUTD
	PUSHAQ	OUTD
	CALLS	#1,G^LIB$PUT_OUTPUT
	MOVL	#300,OUTD
	RET

; SHOWSTAT status: the status in hex and its message.
	.ENTRY	SHOWSTAT,^M<R2>
	MOVL	#256,MSGD
	$GETMSG_S MSGID=4(AP),MSGLEN=MSGLEN,BUFADR=MSGD,FLAGS=#15
	BLBS	R0,1$
	CLRW	MSGLEN
1$:	MOVZWL	MSGLEN,R2
	SAY	</  R0 !XL !AD/>,4(AP),R2,#MSGBUF
	RET

; SHOWIOSB: an I/O status block's status and second word.
	.ENTRY	SHOWIOSB,^M<R2,R3>
	MOVZWL	IOSB,R2
	MOVZWL	IOSB+2,R3
	SAY	</  iosb !XW !XW !XL/>,R2,R3,IOSB+4
	RET

; MASKS fetches the process's four privilege masks into MASKBUF; it is
; safe in any mode. SHOWMASKS prints them, each as 16 hex digits.
	.ENTRY	MASKS,^M<>
	CLRQ	MASKBUF
	CLRQ	MASKBUF+8
	CLRQ	MASKBUF+16
	CLRQ	MASKBUF+24
	$GETJPIW_S ITMLST=MASKLST
	RET
	.ENTRY	SHOWMASKS,^M<>
	SAY	</  auth !XL!XL proc !XL!XL/>,MASKBUF+4,MASKBUF,MASKBUF+12,MASKBUF+8
	SAY	</  cur  !XL!XL imag !XL!XL/>,MASKBUF+20,MASKBUF+16,MASKBUF+28,MASKBUF+24
	RET

; SETPRIVS mask: the privileges enabled become exactly those of the mask
; (as far as the process may enable them).
	.ENTRY	SETPRIVS,^M<R2>
	$SETPRV_S ENBFLG=#0,PRVADR=ALLQ
	MOVL	4(AP),R2
	$SETPRV_S ENBFLG=#1,PRVADR=(R2)
	CMPL	R0,#SS$_NORMAL
	BEQL	1$
	SAY	</  setprv !XL/>,R0
1$:	RET

; SETALL: every privilege the process is authorized for. RESTORE: the
; privileges the program started with. RESTOREPROC: the permanent ones
; too.
	.ENTRY	SETALL,^M<>
	$SETPRV_S ENBFLG=#1,PRVADR=ALLQ
	RET
	.ENTRY	RESTORE,^M<>
	$SETPRV_S ENBFLG=#0,PRVADR=ALLQ
	$SETPRV_S ENBFLG=#1,PRVADR=INITQ
	RET
	.ENTRY	RESTOREPROC,^M<>
	$SETPRV_S ENBFLG=#1,PRVADR=ALLQ
	$SETPRV_S ENBFLG=#0,PRVADR=ALLQ,PRMFLG=#1
	$SETPRV_S ENBFLG=#1,PRVADR=INITPROC,PRMFLG=#1
	$SETPRV_S ENBFLG=#1,PRVADR=ALLQ
	RET

; INNER body: in exec or kernel mode, take away the privilege that got
; here (DROPQ), keeping what was enabled before in PREVQ, then run the
; body. SHOWINNER prints what the body ran with.
	.ENTRY	INNER,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	$SETPRV_S ENBFLG=#0,PRVADR=DROPQ,PRVPRV=PREVQ
	CALLS	#0,@4(AP)
	RET
	.ENTRY	SHOWINNER,^M<>
	BICL2	DROPQ,PREVQ
	BICL2	DROPQ+4,PREVQ+4
	SAY	</  inner cur !XL!XL/>,PREVQ+4,PREVQ
	RET

; TRIVIAL: a routine for $CMKRNL and $CMEXEC to call.
	.ENTRY	TRIVIAL,^M<>
	MOVL	#SS$_NORMAL,R0
	RET

; LNMSHOW table, name: what the name translates to in the table, its
; mode, and the table it's in.
	.ENTRY	LNMSHOW,^M<R2,R3>
	CLRW	TRNLEN
	CLRW	TABLEN
	CLRB	TRNMODE
	$TRNLNM_S TABNAM=@4(AP),LOGNAM=@8(AP),ITMLST=TRNLST
	BLBS	R0,1$
	SAY	</  lnm !XL/>,R0
	RET
1$:	MOVZWL	TRNLEN,R2
	MOVZWL	TABLEN,R3
	MOVZBL	TRNMODE,R1
	SAY	</  lnm !AD mode !UL in !AD/>,R2,#TRNBUF,R1,R3,#TRNTAB
	RET

; SHOWPRI pid: a process's priority and base priority.
	.ENTRY	SHOWPRI,^M<>
	MOVL	@4(AP),TPID
	MNEGL	#1,PRI
	MNEGL	#1,PRIB
	$GETJPIW_S PIDADR=TPID,ITMLST=PRILST
	BLBS	R0,1$
	SAY	</  jpi !XL/>,R0
	RET
1$:	SAY	</  pri !UL prib !UL/>,PRI,PRIB
	RET

; SHOWCHILD pid: a process a case made: its base priority, UIC (shown
; only as the same as the program's or not), and privileges.
	.ENTRY	SHOWCHILD,^M<R2>
	MOVL	@4(AP),TPID
	BNEQ	1$
	SAY	</  no process/>
	RET
1$:	CLRQ	CMASK
	CLRQ	CMASK+8
	CLRQ	CMASK+16
	$GETJPIW_S PIDADR=TPID,ITMLST=CHILDLST
	BLBS	R0,2$
	SAY	</  jpi !XL/>,R0
	RET
2$:	SAY	</  child prib !UL uic !%U/>,PRIB,CUIC
	SAY	</  child auth !XL!XL proc !XL!XL cur !XL!XL/>,CMASK+4,CMASK,CMASK+12,CMASK+8,CMASK+20,CMASK+16
	RET

; DROPCHILD: delete a case's new process.
	.ENTRY	DROPCHILD,^M<>
	TSTL	CPID
	BEQL	1$
	$DELPRC_S PIDADR=CPID
	CLRL	CPID
1$:	RET

; DROPMBX: delete a case's mailbox and its channel.
	.ENTRY	DROPMBX,^M<>
	TSTL	CHAN
	BEQL	1$
	$DELMBX_S CHAN=CHAN
	$DASSGN_S CHAN=CHAN
	CLRL	CHAN
1$:	RET

; DROPRANGE: delete the pages a section case mapped.
	.ENTRY	DROPRANGE,^M<>
	TSTL	RANGE
	BEQL	1$
	$DELTVA_S INADR=RANGE
	CLRQ	RANGE
1$:	RET

; PAUSE: two seconds, for a process being deleted to go.
	.ENTRY	PAUSE,^M<>
	$SCHDWK_S DAYTIM=TWOSEC
	$HIBER_S
	RET
TWOSEC:	.LONG	-20000000,-1

; WALK: a wildcard $GETJPI over every process, counting what it sees.
	.ENTRY	WALK,^M<R2>
	MNEGL	#1,WILD
	CLRL	SEENS
	CLRL	SEENG
	CLRL	SEENW
	CLRL	SEENNP
	CLRL	SEENO
	MOVZWL	#1000,R2
1$:	$GETJPIW_S PIDADR=WILD,ITMLST=WALKLST
	MOVL	R0,RES1
	CMPL	R0,#SS$_NOMOREPROC
	BEQL	9$
	CMPL	R0,#SS$_NOPRIV
	BNEQ	2$
	INCL	SEENNP
	BRB	8$
2$:	BLBC	R0,8$
	CMPL	WPIDV,SELFPID
	BNEQ	3$
	INCL	SEENS
	BRB	8$
3$:	CMPL	WPIDV,GPID
	BNEQ	4$
	INCL	SEENG
	BRB	8$
4$:	CMPL	WPIDV,WPID
	BNEQ	5$
	INCL	SEENW
	BRB	8$
5$:	INCL	SEENO
8$:	DECL	R2
	BLEQ	9$
	BRW	1$
9$:	MOVL	#SS$_NORMAL,R0
	RET

; READPIDS: the holders' PIDs, from the names HOLDERS defined.
	.ENTRY	READPIDS,^M<>
	CLRL	GPID
	CLRL	WPID
	PUSHAQ	GPIDNAM
	PUSHAL	GPID
	CALLS	#2,READPID
	PUSHAQ	WPIDNAM
	PUSHAL	WPID
	CALLS	#2,READPID
	RET
	.ENTRY	READPID,^M<>
	$TRNLNM_S TABNAM=SYSTAB,LOGNAM=@8(AP),ITMLST=PIDLST
	BLBC	R0,1$
	PUSHL	4(AP)
	PUSHAB	PIDBUF
	MOVZWL	PIDLEN,-(SP)
	CALLS	#3,G^LIB$CVT_HTB
1$:	RET

; FIXTURES (part F, SYSTEM's run): the tables PRIV94_OT (open to all)
; and PRIV94_PT (closed to the group and the world), each with a name in
; it, and the permanent mailbox PRIV94_PMBX, open to all.
	.ENTRY	FIXTURES,^M<>
	$CRELNT_S TABNAM=OTTAB,PARTAB=SYSDIR,QUOTA=QUOTA,PROMSK=OPENPROT
	SAY	</  PRIV94_OT !XL/>,R0
	$CRELNT_S TABNAM=PTTAB,PARTAB=SYSDIR,QUOTA=QUOTA,PROMSK=SHUTPROT
	SAY	</  PRIV94_PT !XL/>,R0
	$CRELNM_S TABNAM=OTTAB,LOGNAM=OTN,ITMLST=EQVLST
	SAY	</  PRIV94_OTN !XL/>,R0
	$CRELNM_S TABNAM=PTTAB,LOGNAM=PTN,ITMLST=EQVLST
	SAY	</  PRIV94_PTN !XL/>,R0
	$CREMBX_S PRMFLG=#1,CHAN=CHAN,MAXMSG=#64,BUFQUO=#256,PROMSK=#0,LOGNAM=PMBXNAM
	SAY	</  PRIV94_PMBX !XL/>,R0
	$DASSGN_S CHAN=CHAN
	CLRL	CHAN
	MOVL	#SS$_NORMAL,R0
	RET
OPENPROT: .WORD	0
SHUTPROT: .WORD	^XFF00

; HOLDERS (part H): the holder processes, PRIV94_G in group 200 and
; PRIV94_W in group 300, each running PRIV94H (which hibernates), and
; their PIDs in the system table as PRIV94_G_PID and PRIV94_W_PID. Any
; holders already there are deleted first.
	.ENTRY	HOLDERS,^M<R2>
	CLRL	R2
	TSTL	GPID
	BEQL	1$
	$DELPRC_S PIDADR=GPID
	INCL	R2
1$:	TSTL	WPID
	BEQL	2$
	$DELPRC_S PIDADR=WPID
	INCL	R2
2$:	TSTL	R2
	BEQL	3$
	CALLS	#0,PAUSE
3$:	$CREPRC_S PIDADR=GPID,IMAGE=HIMAGE,PRCNAM=GNAME,UIC=#^X00800001,BASPRI=#4
	SAY	</  PRIV94_G !XL/>,R0
	$CREPRC_S PIDADR=WPID,IMAGE=HIMAGE,PRCNAM=WNAME,UIC=#^X00C00001,BASPRI=#4
	SAY	</  PRIV94_W !XL/>,R0
	PUSHAQ	GPIDNAM
	PUSHL	GPID
	CALLS	#2,DEFPID
	PUSHAQ	WPIDNAM
	PUSHL	WPID
	CALLS	#2,DEFPID
	MOVL	#SS$_NORMAL,R0
	RET
	.ENTRY	DEFPID,^M<>
	$FAO_S	CTRSTR=PIDFMT,OUTBUF=PIDTD,P1=4(AP)
	$CRELNM_S TABNAM=SYSTAB,LOGNAM=@8(AP),ITMLST=PIDEQV
	RET
PIDFMT:	.ASCID	/!XL/

; THEEND (part Z): the holders, the fixtures, and every name a case may
; have left.
	.ENTRY	THEEND,^M<R2,R3,R4>
	TSTL	GPID
	BEQL	1$
	$DELPRC_S PIDADR=GPID
	SAY	</  PRIV94_G !XL/>,R0
1$:	TSTL	WPID
	BEQL	2$
	$DELPRC_S PIDADR=WPID
	SAY	</  PRIV94_W !XL/>,R0
2$:	$DELLNM_S TABNAM=SYSTAB,LOGNAM=GPIDNAM
	$DELLNM_S TABNAM=SYSTAB,LOGNAM=WPIDNAM
	$ASSIGN_S DEVNAM=PMBXNAM,CHAN=CHAN
	BLBC	R0,3$
	$DELMBX_S CHAN=CHAN
	SAY	</  PRIV94_PMBX !XL/>,R0
	$DASSGN_S CHAN=CHAN
	CLRL	CHAN
3$:	$DELLNM_S TABNAM=SYSDIR,LOGNAM=OTTAB
	SAY	</  PRIV94_OT !XL/>,R0
	$DELLNM_S TABNAM=SYSDIR,LOGNAM=PTTAB
	SAY	</  PRIV94_PT !XL/>,R0
	CLRL	R4
	MOVAB	SWEEPN,R2
10$:	MOVL	(R2)+,R3
	BEQL	19$
	$DELLNM_S TABNAM=SYSTAB,LOGNAM=(R3),ACMODE=MODEK
	BLBC	R0,11$
	INCL	R4
11$:	$DELLNM_S TABNAM=G200TAB,LOGNAM=(R3),ACMODE=MODEK
	BLBC	R0,12$
	INCL	R4
12$:	$DELLNM_S TABNAM=G001TAB,LOGNAM=(R3),ACMODE=MODEK
	BLBC	R0,13$
	INCL	R4
13$:	$DELLNM_S TABNAM=SYSDIR,LOGNAM=(R3),ACMODE=MODEK
	BLBC	R0,14$
	INCL	R4
14$:	BRB	10$
19$:	SAY	</  ~ swept !UL/>,R4
	MOVL	#SS$_NORMAL,R0
	RET

; LNMMODES table, name: the name's translation asked for at each mode in
; turn (user, supervisor, executive, kernel), with the mode found.
	.ENTRY	LNMMODES,^M<R2,R3,R4,R5>
	MOVAB	MODEU,R4
	MOVL	#4,R5
1$:	CLRW	TRNLEN
	CLRW	TABLEN
	CLRB	TRNMODE
	$TRNLNM_S TABNAM=@4(AP),LOGNAM=@8(AP),ACMODE=(R4),ITMLST=TRNLST
	MOVZBL	(R4),R1
	BLBS	R0,2$
	SAY	</  at !UL: lnm !XL/>,R1,R0
	BRB	3$
2$:	MOVZBL	TRNMODE,R2
	SAY	</  at !UL: mode !UL/>,R1,R2
3$:	DECL	R4
	DECL	R5
	BLEQ	4$
	BRW	1$
4$:	RET

; THEEND2 (part Z of round 2): the fixtures, round 1's three names left in
; the system table, and every name round 2's cases may have left, at
; every mode.
	.ENTRY	THEEND2,^M<R2,R3,R4,R5>
	$ASSIGN_S DEVNAM=PMBXNAM,CHAN=CHAN
	BLBC	R0,1$
	$DELMBX_S CHAN=CHAN
	SAY	</  PRIV94_PMBX !XL/>,R0
	$DASSGN_S CHAN=CHAN
	CLRL	CHAN
1$:	$DELLNM_S TABNAM=SYSDIR,LOGNAM=OTTAB
	SAY	</  PRIV94_OT !XL/>,R0
	$DELLNM_S TABNAM=SYSDIR,LOGNAM=PTTAB
	SAY	</  PRIV94_PT !XL/>,R0
	MOVAB	ROUND1,R2
2$:	MOVL	(R2)+,R3
	BEQL	3$
	$DELLNM_S TABNAM=SYSTAB,LOGNAM=(R3),ACMODE=MODEU
	SAY	</  !AS !XL/>,R3,R0
	BRB	2$
3$:	CLRL	R4
	MOVAB	SWEEPN,R2
10$:	MOVL	(R2)+,R3
	BEQL	19$
	MOVAB	SWEEPT,R5
11$:	TSTL	(R5)
	BEQL	10$
	PUSHL	R3
	PUSHL	(R5)+
	CALLS	#2,DELALL
	ADDL2	R0,R4
	BRB	11$
19$:	SAY	</  ~ swept !UL/>,R4
	MOVL	#SS$_NORMAL,R0
	RET

; DELALL table, name: delete the name at each mode, returning how many
; it deleted.
	.ENTRY	DELALL,^M<R2,R3>
	CLRL	R3
	MOVAB	MODEU,R2
1$:	$DELLNM_S TABNAM=@4(AP),LOGNAM=@8(AP),ACMODE=(R2)
	BLBC	R0,2$
	INCL	R3
2$:	CMPL	R2,#MODEK
	BEQL	3$
	DECL	R2
	BRB	1$
3$:	MOVL	R3,R0
	RET

	.PSECT	DATA,WRT,NOEXE,LONG
	.ALIGN	LONG
ROUND1:	.ADDRESS R1L21,R1L49,R1L51
	.LONG	0
R1L21:	.ASCID	/PRIV94_L21/
R1L49:	.ASCID	/PRIV94_L49/
R1L51:	.ASCID	/PRIV94_L51/
SWEEPT:	.ADDRESS SYSTAB,G200TAB,G001TAB,SYSDIR,OTTAB,PRCTAB
	.LONG	0

	.PSECT	CODE,NOWRT,EXE,LONG

; 1: fixtures
	.ENTRY	C1,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	SAY	</!AS/>,#C1_XT
	CALLS	#0,B1
	PUSHL	R0
	CALLS	#1,SHOWSTAT
	RET
	.ENTRY	B1,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	CALLS	#0,FIXTURES
	RET

; 2: the end
	.ENTRY	C2,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	SAY	</!AS/>,#C2_XT
	CALLS	#0,B2
	PUSHL	R0
	CALLS	#1,SHOWSTAT
	RET
	.ENTRY	B2,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	CALLS	#0,THEEND2
	RET

; 3: $CREMBX prmflg 1 with no logical name
	.ENTRY	C3,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	SAY	</!AS/>,#C3_XT
	CALLS	#0,SETALL
	PUSHAQ	C3_XM
	CALLS	#1,SETPRIVS
	CALLS	#0,B3
	MOVL	R0,STAT
	CALLS	#0,SETALL
	PUSHL	STAT
	CALLS	#1,SHOWSTAT
	CALLS	#0,DROPMBX
	CALLS	#0,RESTORE
	RET
	.ENTRY	B3,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	$CREMBX_S PRMFLG=#1,CHAN=CHAN,MAXMSG=#64,BUFQUO=#256,ACMODE=#3
	RET

; 4: $CREMBX prmflg 1 with a logical name
