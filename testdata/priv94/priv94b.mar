; 16: $LCKPAG then $ULKPAG in the same body
	.ENTRY	C16,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	SAY	</!AS/>,#C16_XT
	CALLS	#0,SETALL
	PUSHAQ	C16_XM
	CALLS	#1,SETPRIVS
	CALLS	#0,B16
	MOVL	R0,STAT
	CALLS	#0,SETALL
	PUSHL	STAT
	CALLS	#1,SHOWSTAT
	SAY	</  lckpag !XL/>,RES1
	SAY	</  retadr !XL !XL/>,RANGE,RANGE+4
	$ULKPAG_S INADR=PAGEADR
	SAY	</  undo ulkpag !XL/>,R0
	CLRQ	RANGE
	CALLS	#0,RESTORE
	RET
	.ENTRY	B16,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	CLRQ	RANGE
	$LCKPAG_S INADR=PAGEADR
	MOVL	R0,RES1
	$ULKPAG_S INADR=PAGEADR,RETADR=RANGE
	RET

