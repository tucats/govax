$ ! TIR111.COM - VMS MACRO's TIR records, a module per question (testdata/tir111's
$ ! README). Written by testdata/tir111/gen.go. Run it with the exchange volume's
$ ! [000000] the default directory:
$ !
$ !     @TIR111/OUTPUT=TIR111.LOG
$ !
$ SET NOON
$ WRITE SYS$OUTPUT "==== TIRA"
$ MACRO/NOLIST TIRA
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== TIRB"
$ MACRO/NOLIST TIRB
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== TIRC1"
$ MACRO/NOLIST TIRC1
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== TIRC2"
$ MACRO/NOLIST TIRC2
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== TIRC3"
$ MACRO/NOLIST TIRC3
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== TIRC4"
$ MACRO/NOLIST TIRC4
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== TIRC8"
$ MACRO/NOLIST TIRC8
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== TIRD"
$ MACRO/NOLIST TIRD
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== TIRE"
$ MACRO/NOLIST TIRE
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== TIRF"
$ MACRO/NOLIST TIRF
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== TIRG"
$ MACRO/NOLIST TIRG
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== TIRR"
$ MACRO/NOLIST TIRR
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== TIRX"
$ MACRO/NOLIST TIRX
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "==== END"
$ EXIT
