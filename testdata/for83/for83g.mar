	.TITLE	FOR83G	Phase 83's probe of conditions
	.IDENT	/V1.0/

; Written by testdata/for83/gen.go: do not edit. One case per run, by the number
; on the command line, since a case may end its image. See gen.go.

	$SSDEF

	.PSECT	DATA,NOEXE,WRT,QUAD
HMODE:	.LONG	0		; what HND does
HMODE2:	.LONG	0		; what HND2 does
HCOUNT:	.LONG	0		; how many conditions, to stop a loop
HOOK:	.LONG	0		; a routine for mHook, and for the AST
HNEWPC:	.LONG	0		; where mUnwindPC goes
SFP:	.LONG	0		; the frame of the routine under test
SADDR:	.LONG	0		; and its address
XMODE:	.LONG	0		; what the exit handler does
XST:	.LONG	0		; the exit status it's given
XBLK:	.LONG	0
	.ADDRESS XHAND
	.LONG	1
	.ADDRESS XST
NEWF:	.FLOAT	1.5		; a new operand
LZERO:	.LONG	0
LONE:	.LONG	1
LTWO:	.LONG	2
LTHREE:	.LONG	3
WTHREE:	.WORD	3
WMINUS:	.WORD	-1
LVAL:	.LONG	^X55555555
FL1:	.LONG	0,0
FL2:	.LONG	0,0
	.ALIGN	QUAD
DQ1:	.LONG	^X8000,0
DL1:	.LONG	0,0,0,0
PBAD:	.BYTE	^XAA,^XAA
PMAX:	.PACKED	999
PTWO:	.PACKED	2
FTINY:	.FLOAT	1.0E-30
SFAKE:	.LONG	3,^X08018002,0,0
SUNW:	.LONG	3,SS$_UNWIND,0,0
MFAKE:	.LONG	4,0,0,0,0
FMTA:	.ASCIZ	~(A)~
FMTAA:	.ASCIZ	~(A,A)~
FMTI1:	.ASCIZ	~(I1)~
FMTI4:	.ASCIZ	~(I4)~
FMTBAD:	.ASCIZ	~(Q9~
FMTLOOP: .ASCIZ	~(/)~
RBUF:	.BLKB	40
RBD:	.WORD	40
	.BYTE	14,1
	.ADDRESS RBUF
IBUF:	.BLKB	20
IFD:	.WORD	20
	.BYTE	14,1
	.ADDRESS IBUF
PARAM:	.BLKB	16
PARD:	.WORD	16
	.BYTE	14,1
	.ADDRESS PARAM
PARL:	.WORD	0
OUTL:	.WORD	0
OUTB:	.BLKB	200
OUTD:	.WORD	200
	.BYTE	14,1
	.ADDRESS OUTB
ONE:	.WORD	0
	.BYTE	14,1
	.ADDRESS OUTB
MSHOW:	.ASCID	~ =!AS r0=!XL~
MSHOW2:	.ASCID	~ =!AS r0=!XL r1=!XL~
MSIG:	.ASCID	~ =c n=!UL cond=!XL arg=!XL !XL pc=+!XL psl=!XL~
MMECH:	.ASCID	~ =m n=!UL frame=+!XL depth=!SL r0=!XL r1=!XL~
MUNW:	.ASCID	~ =u the unwind's call of the handler~
MLOOP:	.ASCID	~ =too many conditions; the program stops itself~
MHAS:	.ASCID	~ =h !AS r0=!XL~
MFIX:	.ASCID	~FIXUP_FLT~
MRET:	.ASCID	~SIG_TO_RET~
MSTOP:	.ASCID	~SIG_TO_STOP~
MCOND:	.ASCID	~ =cond now !XL~
MV:	.ASCID	~ =value !XL~
MRB:	.ASCID	~ =read r0=!XL |!AD|~
MXH:	.ASCID	~ =exit handler status=!XL~
MBAD:	.ASCID	~ =no such case~
MINNER:	.ASCID	~ =i n=!UL cond=!XL~

	.PSECT	CODE,NOWRT,EXE
; OUT(control, args...)
	.ENTRY	OUT,^M<R2,R3,R4,R5>
	$FAOL_S	CTRSTR=@4(AP),OUTLEN=ONE,OUTBUF=OUTD,PRMLST=8(AP)
	PUSHAB	ONE
	CALLS	#1,G^LIB$PUT_OUTPUT
	RET
; SHOW(what, r0), SHOW2(what, r0, r1)
	.ENTRY	SHOW,^M<>
	PUSHL	8(AP)
	PUSHL	4(AP)
	PUSHAB	MSHOW
	CALLS	#3,OUT
	RET
	.ENTRY	SHOW2,^M<>
	PUSHL	12(AP)
	PUSHL	8(AP)
	PUSHL	4(AP)
	PUSHAB	MSHOW2
	CALLS	#4,OUT
	RET
	.ENTRY	SHOWV,^M<>
	PUSHL	4(AP)
	PUSHAB	MV
	CALLS	#2,OUT
	RET
; SHOWRB(r0): what a READ left, and fills the buffer for the next.
	.ENTRY	SHOWRB,^M<R2,R3,R4,R5>
	PUSHAB	RBUF
	PUSHL	#40
	PUSHL	4(AP)
	PUSHAB	MRB
	CALLS	#4,OUT
	MOVC5	#0,RBUF,#^A/./,#40,RBUF
	RET

; HND and HND2 are the handler, with their own modes. HCORE shows the arrays,
; then does what the mode says.
	.ENTRY	HND,^M<R2,R3,R4,R5,R6,R7>
	MOVL	HMODE,R6
	JSB	HCORE
	RET
	.ENTRY	HND2,^M<R2,R3,R4,R5,R6,R7>
	MOVL	HMODE2,R6
	JSB	HCORE
	RET
HCORE:	MOVL	4(AP),R2
	MOVL	8(AP),R3
	CMPL	4(R2),#SS$_UNWIND
	BNEQ	10$
	PUSHAB	MUNW
	CALLS	#1,OUT
	MOVL	#1,R0
	RSB
10$:	AOBLEQ	#12,HCOUNT,20$
	PUSHAB	MLOOP
	CALLS	#1,OUT
	$EXIT_S	#3
20$:	MOVL	(R2),R5			; PC and PSL are the last two
	PUSHL	(R2)[R5]
	DECL	R5
	SUBL3	SADDR,(R2)[R5],-(SP)
	CLRQ	-(SP)
	CMPL	(R2),#3
	BLEQ	26$
	MOVL	8(R2),(SP)
	CMPL	(R2),#4
	BLEQ	26$
	MOVL	12(R2),4(SP)
26$:	PUSHL	4(R2)
	PUSHL	(R2)
	PUSHAB	MSIG
	CALLS	#7,OUT
	PUSHL	16(R3)
	PUSHL	12(R3)
	PUSHL	8(R3)
	SUBL3	SFP,4(R3),-(SP)
	PUSHL	(R3)
	PUSHAB	MMECH
	CALLS	#6,OUT
	CASEL	R6,#0,#11
30$:	.WORD	40$-30$,41$-30$,42$-30$,43$-30$,44$-30$,45$-30$,46$-30$
	.WORD	47$-30$,48$-30$,49$-30$,50$-30$,51$-30$
40$:	MOVL	#SS$_CONTINUE,R0
	RSB
41$:	MOVL	#SS$_RESIGNAL,R0
	RSB
42$:	$UNWIND_S
	RSB
43$:	CLRL	-(SP)			; by hand: the service's own argument list
	PUSHAB	8(R3)
	CALLS	#2,G^SYS$UNWIND
	RSB
44$:	PUSHL	HNEWPC
	CLRL	-(SP)
	CALLS	#2,G^SYS$UNWIND
	RSB
45$:	MOVL	#^X33333333,12(R3)
	MOVL	#^X44444444,16(R3)
	MOVL	#SS$_CONTINUE,R0
	RSB
46$:	MOVL	#^X33333333,12(R3)
	MOVL	#^X44444444,16(R3)
	$UNWIND_S
	RSB
47$:	CALLS	#0,@HOOK
	MOVL	#SS$_CONTINUE,R0
	RSB
48$:	CALLG	(AP),G^LIB$FIXUP_FLT
	BRB	60$
49$:	PUSHAB	NEWF
	PUSHL	8(AP)
	PUSHL	4(AP)
	CALLS	#3,G^LIB$FIXUP_FLT
60$:	MOVL	R0,R7
	PUSHL	R0
	PUSHAB	MFIX
	PUSHAB	MHAS
	CALLS	#3,OUT
	MOVL	R7,R0
	RSB
50$:	CALLG	(AP),G^LIB$SIG_TO_RET
	MOVL	R0,R7
	PUSHL	R0
	PUSHAB	MRET
	PUSHAB	MHAS
	CALLS	#3,OUT
	MOVL	R7,R0
	RSB
51$:	CALLG	(AP),G^LIB$SIG_TO_STOP
	MOVL	R0,R7
	PUSHL	R0
	PUSHAB	MSTOP
	PUSHAB	MHAS
	CALLS	#3,OUT
	PUSHL	4(R2)
	PUSHAB	MCOND
	CALLS	#2,OUT
	MOVL	#SS$_RESIGNAL,R0
	RSB
; INNER is the handler over a hook's statement: it shows and continues.
	.ENTRY	INNER,^M<R2>
	MOVL	4(AP),R2
	CMPL	4(R2),#SS$_UNWIND
	BEQL	10$
	AOBLEQ	#12,HCOUNT,5$
	PUSHAB	MLOOP
	CALLS	#1,OUT
	$EXIT_S	#3
5$:	PUSHL	4(R2)
	PUSHL	(R2)
	PUSHAB	MINNER
	CALLS	#3,OUT
10$:	MOVL	#SS$_CONTINUE,R0
	RET
; ASTHOOK is an AST routine: it calls the hook.
	.ENTRY	ASTHOOK,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	CALLS	#0,@HOOK
	RET
; XHAND is the exit handler. By XMODE it writes a record on unit 12, or on a unit
; opened now.
	.ENTRY	XHAND,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	INNER,(FP)
	PUSHL	XST
	PUSHAB	MXH
	CALLS	#2,OUT
	CMPL	XMODE,#1
	BNEQ	10$
	PUSHAB	FMTA
	PUSHL	#12
	CALLS	#2,G^FOR$WRITE_SO
	PUSHAB	XTEXT
	CALLS	#1,G^FOR$IO_T_DS
	CALLS	#0,G^FOR$IO_END
	PUSHL	R0
	CALLS	#1,SHOWV
10$:	CMPL	XMODE,#2
	BNEQ	20$
	PUSHAB	FMTA
	PUSHL	#15
	CALLS	#2,G^FOR$WRITE_SO
	PUSHAB	XTEXT
	CALLS	#1,G^FOR$IO_T_DS
	CALLS	#0,G^FOR$IO_END
	PUSHL	R0
	CALLS	#1,SHOWV
20$:	RET
	.ENTRY	DEEP,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	CALLS	#0,DEEP2
	RET
	.ENTRY	DEEP2,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	CALLS	#0,DEEP3
	RET
	.ENTRY	DEEP3,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	PUSHAB	FMTA
	PUSHL	UNIT
	CALLS	#2,G^FOR$WRITE_SO
	PUSHAB	T0
	CALLS	#1,G^FOR$IO_T_DS
	CALLS	#0,G^FOR$IO_END
	PUSHL	R0
	PUSHAB	T1
	CALLS	#2,L^SHOW
	RET
	.ENTRY	AGAIN,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
	MOVL	FP,SFP
	MOVAB	AGAIN,SADDR
	TSTL	TURN
	BNEQ	10$
	PUSHAB	FMTAA
	PUSHL	#12
	CALLS	#2,G^FOR$WRITE_SO
	PUSHAB	T2
	CALLS	#1,G^FOR$IO_T_DS
	PUSHL	#^X08018003
	CALLS	#1,G^LIB$SIGNAL
	PUSHL	R0
	PUSHAB	T3
	CALLS	#2,L^SHOW
10$:	MOVL	#12,UNIT
	CALLS	#0,DEEP
	RET
; 1: gone at depth 1, then the same unit from deeper
	.ENTRY	C1,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	PUSHAB	T4
	CALLS	#1,G^LIB$PUT_OUTPUT
	PUSHAB	T6
	PUSHL	#^X070F
	PUSHAB	T5
	PUSHL	#^X070E
	PUSHL	#^X000C0201
	CALLS	#5,G^FOR$OPEN
	BRW	B0
	.ENTRY	S0,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
	MOVL	FP,SFP
	MOVAB	S0,SADDR
	PUSHAB	FMTAA
	PUSHL	#12
	CALLS	#2,G^FOR$WRITE_SO
	PUSHAB	T2
	CALLS	#1,G^FOR$IO_T_DS
	PUSHL	#^X08018003
	CALLS	#1,G^LIB$SIGNAL
	PUSHL	R0
	PUSHAB	T3
	CALLS	#2,L^SHOW
	RET
B0:
	MOVL	#2,HMODE
	CALLS	#0,L^S0
	PUSHL	R0
	PUSHAB	T7
	CALLS	#2,L^SHOW
	MOVL	#12,UNIT
	CALLS	#0,DEEP
	PUSHL	#^X000C0201
	CALLS	#1,G^FOR$CLOSE
	RET
; 2: gone, then the same unit from the same routine called again
	.ENTRY	C2,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	PUSHAB	T8
	CALLS	#1,G^LIB$PUT_OUTPUT
	PUSHAB	T6
	PUSHL	#^X070F
	PUSHAB	T5
	PUSHL	#^X070E
	PUSHL	#^X000C0201
	CALLS	#5,G^FOR$OPEN
	MOVL	#2,HMODE
	CLRL	TURN
	CALLS	#0,AGAIN
	PUSHL	R0
	PUSHAB	T9
	CALLS	#2,L^SHOW
	MOVL	#1,TURN
	CALLS	#0,AGAIN
	PUSHL	R0
	PUSHAB	T10
	CALLS	#2,L^SHOW
	PUSHL	#^X000C0201
	CALLS	#1,G^FOR$CLOSE
	RET
; 3: gone, then the same unit from the frame above
	.ENTRY	C3,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	PUSHAB	T11
	CALLS	#1,G^LIB$PUT_OUTPUT
	PUSHAB	T6
	PUSHL	#^X070F
	PUSHAB	T5
	PUSHL	#^X070E
	PUSHL	#^X000C0201
	CALLS	#5,G^FOR$OPEN
	BRW	B1
	.ENTRY	S1,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
	MOVL	FP,SFP
	MOVAB	S1,SADDR
	PUSHAB	FMTAA
	PUSHL	#12
	CALLS	#2,G^FOR$WRITE_SO
	PUSHAB	T2
	CALLS	#1,G^FOR$IO_T_DS
	PUSHL	#^X08018003
	CALLS	#1,G^LIB$SIGNAL
	PUSHL	R0
	PUSHAB	T3
	CALLS	#2,L^SHOW
	RET
B1:
	MOVL	#2,HMODE
	CALLS	#0,L^S1
	PUSHL	R0
	PUSHAB	T7
	CALLS	#2,L^SHOW
	PUSHAB	FMTA
	PUSHL	#12
	CALLS	#2,G^FOR$WRITE_SO
	PUSHAB	T12
	CALLS	#1,G^FOR$IO_T_DS
	CALLS	#0,G^FOR$IO_END
	PUSHL	R0
	PUSHAB	T12
	CALLS	#2,L^SHOW
	PUSHL	#^X000C0201
	CALLS	#1,G^FOR$CLOSE
	RET
; 4: gone inside an outer statement, which goes on
	.ENTRY	C4,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	PUSHAB	T13
	CALLS	#1,G^LIB$PUT_OUTPUT
	PUSHAB	T6
	PUSHL	#^X070F
	PUSHAB	T5
	PUSHL	#^X070E
	PUSHL	#^X000C0201
	CALLS	#5,G^FOR$OPEN
	PUSHAB	FMTAA
	PUSHL	#12
	CALLS	#2,G^FOR$WRITE_SO
	PUSHAB	T14
	CALLS	#1,G^FOR$IO_T_DS
	BRW	B2
	.ENTRY	S2,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
	MOVL	FP,SFP
	MOVAB	S2,SADDR
	PUSHAB	FMTAA
	PUSHL	#13
	CALLS	#2,G^FOR$WRITE_SO
	PUSHAB	T2
	CALLS	#1,G^FOR$IO_T_DS
	PUSHL	#^X08018003
	CALLS	#1,G^LIB$SIGNAL
	PUSHL	R0
	PUSHAB	T3
	CALLS	#2,L^SHOW
	RET
B2:
	MOVL	#2,HMODE
	CALLS	#0,L^S2
	PUSHL	R0
	PUSHAB	T7
	CALLS	#2,L^SHOW
	PUSHAB	T15
	CALLS	#1,G^FOR$IO_T_DS
	CALLS	#0,G^FOR$IO_END
	PUSHL	R0
	PUSHAB	T16
	CALLS	#2,L^SHOW
	PUSHL	#^X000C0201
	CALLS	#1,G^FOR$CLOSE
	PUSHL	#^X000D0201
	CALLS	#1,G^FOR$CLOSE
	RET
; 5: gone inside an outer statement, then its unit from deeper
	.ENTRY	C5,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	PUSHAB	T17
	CALLS	#1,G^LIB$PUT_OUTPUT
	PUSHAB	T6
	PUSHL	#^X070F
	PUSHAB	T5
	PUSHL	#^X070E
	PUSHL	#^X000C0201
	CALLS	#5,G^FOR$OPEN
	PUSHAB	FMTAA
	PUSHL	#12
	CALLS	#2,G^FOR$WRITE_SO
	PUSHAB	T14
	CALLS	#1,G^FOR$IO_T_DS
	BRW	B3
	.ENTRY	S3,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
	MOVL	FP,SFP
	MOVAB	S3,SADDR
	PUSHAB	FMTAA
	PUSHL	#13
	CALLS	#2,G^FOR$WRITE_SO
	PUSHAB	T2
	CALLS	#1,G^FOR$IO_T_DS
	PUSHL	#^X08018003
	CALLS	#1,G^LIB$SIGNAL
	PUSHL	R0
	PUSHAB	T3
	CALLS	#2,L^SHOW
	RET
B3:
	MOVL	#2,HMODE
	CALLS	#0,L^S3
	PUSHL	R0
	PUSHAB	T7
	CALLS	#2,L^SHOW
	MOVL	#13,UNIT
	CALLS	#0,DEEP
	PUSHAB	T15
	CALLS	#1,G^FOR$IO_T_DS
	CALLS	#0,G^FOR$IO_END
	PUSHL	R0
	PUSHAB	T16
	CALLS	#2,L^SHOW
	PUSHL	#^X000C0201
	CALLS	#1,G^FOR$CLOSE
	PUSHL	#^X000D0201
	CALLS	#1,G^FOR$CLOSE
	RET
; 6: live, then its unit from deeper
	.ENTRY	C6,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	PUSHAB	T18
	CALLS	#1,G^LIB$PUT_OUTPUT
	MOVAB	INNER,(FP)
	PUSHAB	T6
	PUSHL	#^X070F
	PUSHAB	T5
	PUSHL	#^X070E
	PUSHL	#^X000C0201
	CALLS	#5,G^FOR$OPEN
	PUSHAB	FMTAA
	PUSHL	#12
	CALLS	#2,G^FOR$WRITE_SO
	PUSHAB	T14
	CALLS	#1,G^FOR$IO_T_DS
	MOVL	#12,UNIT
	CALLS	#0,DEEP
	PUSHL	R0
	PUSHAB	T3
	CALLS	#2,L^SHOW
	RET
; 7: gone, then called again with nothing between
	.ENTRY	C7,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	PUSHAB	T19
	CALLS	#1,G^LIB$PUT_OUTPUT
	PUSHAB	T6
	PUSHL	#^X070F
	PUSHAB	T5
	PUSHL	#^X070E
	PUSHL	#^X000C0201
	CALLS	#5,G^FOR$OPEN
	MOVL	#2,HMODE
	CLRL	TURN
	CALLS	#0,AGAIN
	MOVL	#1,TURN
	CALLS	#0,AGAIN
	PUSHL	R0
	PUSHAB	T10
	CALLS	#2,L^SHOW
	PUSHL	#^X000C0201
	CALLS	#1,G^FOR$CLOSE
	RET
	.ENTRY	GONEAST,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	BRW	B4
	.ENTRY	S4,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
	MOVL	FP,SFP
	MOVAB	S4,SADDR
	PUSHAB	FMTAA
	PUSHL	#13
	CALLS	#2,G^FOR$WRITE_SO
	PUSHAB	T2
	CALLS	#1,G^FOR$IO_T_DS
	PUSHL	#^X08018003
	CALLS	#1,G^LIB$SIGNAL
	PUSHL	R0
	PUSHAB	T3
	CALLS	#2,L^SHOW
	RET
B4:
	MOVL	#2,HMODE
	CALLS	#0,L^S4
	PUSHL	R0
	PUSHAB	T7
	CALLS	#2,L^SHOW
	RET
; 8: gone in an AST, during a statement
	.ENTRY	C8,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	PUSHAB	T20
	CALLS	#1,G^LIB$PUT_OUTPUT
	MOVAB	GONEAST,HOOK
	PUSHAB	T6
	PUSHL	#^X070F
	PUSHAB	T5
	PUSHL	#^X070E
	PUSHL	#^X000C0201
	CALLS	#5,G^FOR$OPEN
	PUSHAB	FMTAA
	PUSHL	#12
	CALLS	#2,G^FOR$WRITE_SO
	PUSHAB	T14
	CALLS	#1,G^FOR$IO_T_DS
	PUSHL	#0
	PUSHL	#0
	PUSHL	#ASTHOOK
	CALLS	#3,G^SYS$DCLAST
	PUSHL	R0
	PUSHAB	T21
	CALLS	#2,L^SHOW
	PUSHAB	T15
	CALLS	#1,G^FOR$IO_T_DS
	CALLS	#0,G^FOR$IO_END
	PUSHL	R0
	PUSHAB	T16
	CALLS	#2,L^SHOW
	PUSHL	#^X000C0201
	CALLS	#1,G^FOR$CLOSE
	PUSHL	#^X000D0201
	CALLS	#1,G^FOR$CLOSE
	RET
; 9: exit handler declared after a WRITE to unit 6, before the OPEN
	.ENTRY	C9,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	PUSHAB	T22
	CALLS	#1,G^LIB$PUT_OUTPUT
	MOVL	#1,XMODE
	PUSHAB	FMTA
	PUSHL	#6
	CALLS	#2,G^FOR$WRITE_SO
	PUSHAB	T23
	CALLS	#1,G^FOR$IO_T_DS
	CALLS	#0,G^FOR$IO_END
	PUSHAB	XBLK
	CALLS	#1,G^SYS$DCLEXH
	PUSHAB	T6
	PUSHL	#^X070F
	PUSHAB	T5
	PUSHL	#^X070E
	PUSHL	#^X000C0201
	CALLS	#5,G^FOR$OPEN
	PUSHAB	FMTA
	PUSHL	#12
	CALLS	#2,G^FOR$WRITE_SO
	PUSHAB	T24
	CALLS	#1,G^FOR$IO_T_DS
	CALLS	#0,G^FOR$IO_END
	RET

	.ENTRY	START,^M<R2>
	PUSHAB	PARL
	CLRL	-(SP)
	PUSHAB	PARD
	CALLS	#3,G^LIB$GET_FOREIGN
	MOVW	PARL,PARD
	PUSHL	#1
	PUSHL	#4
	PUSHAB	LVAL
	PUSHAB	PARD
	CALLS	#4,G^OTS$CVT_TI_L
	MOVL	LVAL,R2
	CMPL	R2,#9
	BGTRU	90$
	TSTL	R2
	BEQL	90$
	MOVL	CTAB-4[R2],R0
	CALLS	#0,(R0)
	MOVL	#SS$_NORMAL,R0
	RET
90$:	PUSHAB	MBAD
	CALLS	#1,OUT
	MOVL	#SS$_NORMAL,R0
	RET

	.PSECT	DATA
T0:	.ASCID	~deep~
T1:	.ASCID	~deep statement~
T2:	.ASCID	~gone~
T3:	.ASCID	~NOT REACHED~
T4:	.ASCID	~#1 gone at depth 1, then the same unit from deeper~
T5:	.ASCID	~FOR83W.DAT~
T6:	.ASCID	~NEW~
T7:	.ASCID	~back~
T8:	.ASCID	~#2 gone, then the same unit from the same routine called again~
T9:	.ASCID	~first call~
T10:	.ASCID	~second call~
T11:	.ASCID	~#3 gone, then the same unit from the frame above~
T12:	.ASCID	~above~
T13:	.ASCID	~#4 gone inside an outer statement, which goes on~
T14:	.ASCID	~outer~
T15:	.ASCID	~second~
T16:	.ASCID	~outer's end~
T17:	.ASCID	~#5 gone inside an outer statement, then its unit from deeper~
T18:	.ASCID	~#6 live, then its unit from deeper~
T19:	.ASCID	~#7 gone, then called again with nothing between~
T20:	.ASCID	~#8 gone in an AST, during a statement~
T21:	.ASCID	~after~
T22:	.ASCID	~#9 exit handler declared after a WRITE to unit 6, before the OPEN~
T23:	.ASCID	~ on 6~
T24:	.ASCID	~from the program~
UNIT:	.LONG	0
TURN:	.LONG	0
XTEXT:	.ASCID	~from the exit handler~
CTAB:
	.ADDRESS	C1
	.ADDRESS	C2
	.ADDRESS	C3
	.ADDRESS	C4
	.ADDRESS	C5
	.ADDRESS	C6
	.ADDRESS	C7
	.ADDRESS	C8
	.ADDRESS	C9

	.END	START
