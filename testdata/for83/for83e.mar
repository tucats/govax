; 7: INPCONERR L, then an item
	.ENTRY	C7,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	PUSHAB	T11
	CALLS	#1,G^LIB$PUT_OUTPUT
	MOVL	#^X55555555,LVAL
	MOVL	#^X66666666,LVAL2
	BRW	B6
	.ENTRY	S6,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
