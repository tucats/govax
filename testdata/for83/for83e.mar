; 8: INPCONERR twice in a record
	.ENTRY	C8,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	PUSHAB	T12
	CALLS	#1,G^LIB$PUT_OUTPUT
	MOVL	#^X55555555,LVAL
	MOVL	#^X66666666,LVAL2
	BRW	B7
	.ENTRY	S7,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
	MOVL	FP,SFP
	MOVAB	S7,SADDR
	PUSHAB	T2
	PUSHL	#^X070F
	PUSHAB	T1
	PUSHL	#^X070E
	PUSHL	#^X000C0201
	CALLS	#5,G^FOR$OPEN
	PUSHAB	FMTII2
	PUSHL	#12
	CALLS	#2,G^FOR$READ_SO
	PUSHAB	LVAL
	CALLS	#1,G^FOR$IO_L_R
	PUSHAB	LVAL2
	CALLS	#1,G^FOR$IO_L_R
