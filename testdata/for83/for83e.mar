; 9: list-directed, a bad integer, then an item
	.ENTRY	C9,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	PUSHAB	T13
	CALLS	#1,G^LIB$PUT_OUTPUT
	MOVL	#^X55555555,LVAL
	MOVL	#^X66666666,LVAL2
	BRW	B8
	.ENTRY	S8,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HND,(FP)
	MOVL	FP,SFP
	MOVAB	S8,SADDR
	PUSHAB	T2
	PUSHL	#^X070F
	PUSHAB	T1
	PUSHL	#^X070E
	PUSHL	#^X000C0201
	CALLS	#5,G^FOR$OPEN
	PUSHL	#12
