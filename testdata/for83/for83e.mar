	.ENTRY	START,^M<R2>
	PUSHAB	PARL
	CLRL	-(SP)
	PUSHAB	PARD
	CALLS	#3,G^LIB$GET_FOREIGN
	MOVW	PARL,PARD
	PUSHL	#1
	PUSHL	#4
	PUSHAB	LVAL
	PUSHAB	PARD
	CALLS	#4,G^OTS$CVT_TI_L
	MOVL	LVAL,R2
	CMPL	R2,#18
	BGTRU	90$
	TSTL	R2
	BEQL	90$
	MOVL	CTAB-4[R2],R0
	CALLS	#0,(R0)
	MOVL	#SS$_NORMAL,R0
	RET
90$:	PUSHAB	MBAD
	CALLS	#1,OUT
	MOVL	#SS$_NORMAL,R0
	RET

	.PSECT	DATA
LVAL2:	.LONG	^X55555555
LONEF:	.FLOAT	1.0
ISHORT:	.WORD	4
	.BYTE	14,1
	.ADDRESS IBUF
FMTII:	.ASCIZ	~(I4,1X,I4)~
FMTII2:	.ASCIZ	~(I4,I1)~
FMTFI:	.ASCIZ	~(F4.0,1X,I4)~
FMTOI:	.ASCIZ	~(O4,1X,I4)~
FMTZI:	.ASCIZ	~(Z4,1X,I4)~
FMTLI:	.ASCIZ	~(L4,1X,I4)~
FMTI4A:	.ASCIZ	~(I4,A)~
FMTI4I:	.ASCIZ	~(I4,I4)~
FMTLONG: .ASCIZ	~(140X,A,A)~
FMTEND:	.ASCIZ	~(I4)~
T0:	.ASCID	~#1 INPCONERR I, then an item~
T1:	.ASCID	~FOR83F.DAT~
T2:	.ASCID	~OLD~
T3:	.ASCID	~after statement~
T4:	.ASCID	~back~
T5:	.ASCID	~#2 INPCONERR I, last item~
T6:	.ASCID	~#3 INPCONERR F, then an item~
T7:	.ASCID	~#4 INPCONERR O, then an item~
T8:	.ASCID	~#5 INPCONERR O, a digit too large, then an item~
T9:	.ASCID	~FOR83H.DAT~
T10:	.ASCID	~#6 INPCONERR Z, a letter, then an item~
T11:	.ASCID	~#7 INPCONERR L, then an item~
T12:	.ASCID	~#8 INPCONERR twice in a record~
T13:	.ASCID	~#9 list-directed, a bad integer, then an item~
T14:	.ASCID	~#10 FORVARMIS on output~
T15:	.ASCID	~FOR83W.DAT~
T16:	.ASCID	~NEW~
T17:	.ASCID	~NEXT~
T18:	.ASCID	~#11 FORVARMIS on input~
T19:	.ASCID	~#12 FORVARMIS on input, a field read~
T20:	.ASCID	~#13 FORVARMIS on input, an integer under F~
T21:	.ASCID	~#14 OUTSTAOVE on a unit~
T22:	.ASCID	~PAST~
T23:	.ASCID	~#15 OUTSTAOVE in an internal record~
T24:	.ASCID	~#16 INPRECTOO~
T25:	.ASCID	~FOR83G.DAT~
T26:	.ASCID	~#17 ERRDURWRI, a file opened to read~
T27:	.ASCID	~X~
T28:	.ASCID	~#18 ERR with no handler's choice: an INPCONERR at FOR$IO_END~
XTEXT:	.ASCID	~from the exit handler~
CTAB:
	.ADDRESS	C1
	.ADDRESS	C2
	.ADDRESS	C3
	.ADDRESS	C4
	.ADDRESS	C5
	.ADDRESS	C6
	.ADDRESS	C7
