	.ENTRY	START,^M<R2>
	PUSHAB	PARL
	CLRL	-(SP)
	PUSHAB	PARD
	CALLS	#3,G^LIB$GET_FOREIGN
	MOVW	PARL,PARD
	PUSHL	#1
	PUSHL	#4
	PUSHAB	LVAL
	PUSHAB	PARD
	CALLS	#4,G^OTS$CVT_TI_L
	MOVL	LVAL,R2
	CMPL	R2,#64
	BGTRU	90$
	TSTL	R2
	BEQL	90$
	MOVL	CTAB-4[R2],R0
	CALLS	#0,(R0)
	MOVL	#SS$_NORMAL,R0
	RET
90$:	PUSHAB	MBAD
	CALLS	#1,OUT
	MOVL	#SS$_NORMAL,R0
	RET

	.PSECT	DATA
