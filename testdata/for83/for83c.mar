	BGTRU	90$
	TSTL	R2
	BEQL	90$
	MOVL	CTAB-4[R2],R0
	CALLS	#0,(R0)
	MOVL	#SS$_NORMAL,R0
	RET
90$:	PUSHAB	MBAD
	CALLS	#1,OUT
	MOVL	#SS$_NORMAL,R0
	RET

