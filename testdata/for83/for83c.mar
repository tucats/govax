	MOVL	FP,SFP
	MOVAB	S1,SADDR
	MOVAB	NP1,HNEWPC
	PUSHL	#^X08018002
	MOVL	#^X11111111,R0
	MOVL	#^X22222222,R1
	CALLS	#1,G^LIB$SIGNAL
	PUSHL	R1
	PUSHL	R0
	PUSHAB	T1
	CALLS	#3,L^SHOW2
	RET
	NP1:
	PUSHL	R1
	PUSHL	R0
	PUSHAB	T2
	CALLS	#3,L^SHOW2
	RET
B1:
	MOVL	#0,HMODE
	CALLS	#0,L^S1
	PUSHL	R0
	PUSHAB	T3
	CALLS	#2,L^SHOW
	RET
