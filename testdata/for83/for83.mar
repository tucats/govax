	.ENTRY	C36,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	CALLS	#0,NOWF
	CLRF	C36_X
	PUSHAB	C36_X
	CALLS	#1,G^FOR$SECNDS
	PUSHL	R0
	MOVF	R0,C36_R
	SUBF3	C36_X,NOW,C36_E
	SUBF3	C36_E,C36_R,C36_E
	DIVF2	#100.0,C36_E
	CVTRFL	C36_E,C36_N
	CLRL	(SP)
	MOVL	(SP)+,R0
	RET

