	MOVAB	HANDLER,(FP)
	PUSHL	#0
	PUSHL	#0
	PUSHAB	C1_D
	PUSHAB	C1_L
	CALLS	#4,G^SYS$ASCTIM
	PUSHL	R0
	MOVL	(SP)+,R0
	RET

