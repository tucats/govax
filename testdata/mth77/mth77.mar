	.TITLE	MTH77
	.IDENT	/1/
; MTH77 - the Phase 77 probe of MTHRTL. Written by testdata/mth77/gen.go.
	$SSDEF
	.PSECT	RODATA,NOWRT,NOEXE,LONG
RO:	.LONG	1
	.PSECT	DATA,WRT,NOEXE,LONG
HEXTAB:	.ASCII	/0123456789ABCDEF/
TXTR:	.ASCII	/ R=/
TXTM:	.ASCII	/ M=/
TXTC:	.ASCII	/ c=/
TXTN:	.ASCII	/ n=/
TXTA:	.ASCII	/ a=/
TXTRET:	.ASCII	/ret /
TXTPCR:	.ASCII	/ pc=ret/
TXTPCO:	.ASCII	/ pc=oth/
TXTMR:	.ASCII	/ mr=/
TXTH:	.ASCII	/ h=/
TXTUNW:	.ASCII	/ unw/
EXPECT:	.BLKL	1		; the call's return address
MODE:	.BLKL	1		; what HANDLER does
HCOUNT:	.BLKL	1		; the signals in this case
UNWOUND:.BLKL	1		; HANDLER unwound
SAVED:	.BLKL	1		; the call came back
SIG:	.BLKL	12		; the first signal array
MECH0:	.BLKL	1		; the mechanism array's R0
MECH1:	.BLKL	1		; and R1
REGS:	.BLKL	12		; R0 to R11 after the call
RES:	.BLKL	8		; the result area
LINE:	.BLKB	500
LDSC:	.WORD	0
	.BYTE	14,1
	.ADDRESS LINE

	.PSECT	CODE,NOWRT,EXE,LONG
; HANDLER: see gen.go. It records the first signal, and continues from the library's
; conditions and the arithmetic traps, whose PC is past the instruction. Anything else
; would run the instruction again, so it unwinds to the driver, with the condition in R0.
	.ENTRY	HANDLER,^M<R2,R3>
	MOVL	4(AP),R2		; the signal array
	MOVL	8(AP),R3		; the mechanism array
	CMPL	4(R2),#SS$_UNWIND
	BNEQ	1$
	BRW	9$
1$:	INCL	HCOUNT
	CMPL	HCOUNT,#1
	BNEQ	3$
	MOVL	12(R3),MECH0		; CHF$L_MCH_SAVR0
	MOVL	16(R3),MECH1		; CHF$L_MCH_SAVR1
	CLRL	R0
2$:	CMPL	R0,(R2)			; the signal array's longwords, at most 12
	BGTR	3$
	CMPL	R0,#12
	BGEQ	3$
	MOVL	(R2)[R0],SIG[R0]
	INCL	R0
	BRB	2$
3$:	CMPL	HCOUNT,#1
	BNEQ	8$
	CMPL	MODE,#1
	BEQL	8$
	EXTZV	#16,#12,4(R2),R0
	CMPL	R0,#22			; the MTH facility
	BEQL	5$
	CMPL	4(R2),#SS$_INTOVF
	BEQL	5$
	CMPL	4(R2),#SS$_INTDIV
	BEQL	5$
	CMPL	4(R2),#SS$_FLTOVF
	BEQL	5$
	CMPL	4(R2),#SS$_FLTDIV
	BEQL	5$
	CMPL	4(R2),#SS$_FLTUND
	BNEQ	8$
5$:	CMPL	MODE,#2
	BNEQ	6$
	MOVL	#^X4180,12(R3)		; 1.5, in place of the reserved operand
	CLRL	16(R3)
6$:	MOVL	#SS$_CONTINUE,R0
	RET
8$:	MOVL	#1,UNWOUND
	MOVL	4(R2),12(R3)
	$UNWIND_S
9$:	RET

; SAVE keeps R0 to R11, as the call left them.
SAVE:	MOVL	R0,REGS
	MOVL	R1,REGS+4
	MOVL	R2,REGS+8
	MOVL	R3,REGS+12
	MOVL	R4,REGS+16
	MOVL	R5,REGS+20
	MOVL	R6,REGS+24
	MOVL	R7,REGS+28
	MOVL	R8,REGS+32
	MOVL	R9,REGS+36
	MOVL	R10,REGS+40
	MOVL	R11,REGS+44
	MOVL	#1,SAVED
	RSB

; MARK puts a marker in R1 to R11, so what a routine changes shows.
MARK:	MOVL	#^XA1A1A1A1,R1
	MOVL	#^XA2A2A2A2,R2
	MOVL	#^XA3A3A3A3,R3
	MOVL	#^XA4A4A4A4,R4
	MOVL	#^XA5A5A5A5,R5
	MOVL	#^XA6A6A6A6,R6
	MOVL	#^XA7A7A7A7,R7
	MOVL	#^XA8A8A8A8,R8
	MOVL	#^XA9A9A9A9,R9
	MOVL	#^XAAAAAAAA,R10
	MOVL	#^XABABABAB,R11
	RSB

; PUTHEX writes R1 in hex at (R3) and moves R3 on. It changes R0 and R2 too.
PUTHEX:	MOVL	#28,R2
1$:	EXTZV	R2,#4,R1,R0
	MOVB	HEXTAB[R0],(R3)+
	SUBL2	#4,R2
	BGEQ	1$
	RSB

; START runs the table's cases. Each entry is a case's routine, its title, and four
; bytes: the registers and result longwords to show, the handler's mode, and whether
; the entry is only a heading.
	.ENTRY	START,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAL	TABLE,R6
NEXT:	MOVL	(R6)+,R7
	BNEQ	10$
	MOVL	#1,R0
	RET
10$:	MOVL	(R6)+,R8
	MOVZBL	(R6),R9
	MOVZBL	1(R6),R10
	MOVZBL	2(R6),MODE
	MOVZBL	3(R6),R11
	ADDL2	#4,R6
	TSTL	R11
	BNEQ	20$
	CLRL	HCOUNT
	CLRL	UNWOUND
	CLRL	SAVED
	CLRL	EXPECT
	MOVC5	#0,(SP),#^X55,#32,RES
	CALLS	#0,(R7)
20$:	MOVAB	LINE,R3
	MOVZWL	(R8),R0
	MOVC3	R0,@4(R8),(R3)
	TSTL	R11
	BEQL	21$
	BRW	PRINT
21$:	TSTL	SAVED
	BEQL	30$
	TSTL	R9
	BEQL	25$
	MOVC3	#3,TXTR,(R3)
	CLRL	R4
22$:	CMPL	R4,R9
	BGEQ	25$
	TSTL	R4
	BEQL	23$
	MOVB	#^A/ /,(R3)+
23$:	MOVL	REGS[R4],R1
	BSBW	PUTHEX
	INCL	R4
	BRB	22$
25$:	TSTL	R10
	BEQL	30$
	MOVC3	#3,TXTM,(R3)
	CLRL	R4
26$:	CMPL	R4,R10
	BGEQ	30$
	TSTL	R4
	BEQL	27$
	MOVB	#^A/ /,(R3)+
27$:	MOVL	RES[R4],R1
	BSBW	PUTHEX
	INCL	R4
	BRB	26$
30$:	TSTL	HCOUNT
	BNEQ	31$
	BRW	PRINT
31$:	MOVC3	#3,TXTC,(R3)
	MOVL	SIG+4,R1
	BSBW	PUTHEX
	MOVC3	#3,TXTN,(R3)
	MOVL	SIG,R1
	BSBW	PUTHEX
	MOVL	#2,R7			; the arguments between the condition and the PC; MOVC3 changes R4
32$:	SUBL3	#2,SIG,R0
	CMPL	R7,R0
	BGTR	36$
	CMPL	R7,#11
	BGEQ	36$
	MOVC3	#3,TXTA,(R3)
	MOVL	SIG[R7],R1
	CMPL	R1,EXPECT
	BNEQ	33$
	MOVC3	#3,TXTRET,(R3)
	BRB	35$
33$:	BSBW	PUTHEX
35$:	INCL	R7
	BRB	32$
36$:	SUBL3	#1,SIG,R4		; the PC
	BLSS	38$
	CMPL	R4,#12
	BGEQ	38$
	CMPL	SIG[R4],EXPECT
	BNEQ	37$
	MOVC3	#7,TXTPCR,(R3)
	BRB	38$
37$:	MOVC3	#7,TXTPCO,(R3)
38$:	MOVC3	#4,TXTMR,(R3)
	MOVL	MECH0,R1
	BSBW	PUTHEX
	MOVB	#^A/ /,(R3)+
	MOVL	MECH1,R1
	BSBW	PUTHEX
	CMPL	HCOUNT,#1
	BEQL	39$
	MOVC3	#3,TXTH,(R3)
	MOVL	HCOUNT,R1
	BSBW	PUTHEX
39$:	TSTL	UNWOUND
	BEQL	PRINT
	MOVC3	#4,TXTUNW,(R3)
PRINT:	MOVAB	LINE,R0
	SUBL3	R0,R3,R1
	MOVW	R1,LDSC
	PUSHAQ	LDSC
	CALLS	#1,G^LIB$PUT_OUTPUT
	BRW	NEXT

	.ENTRY	C1,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	JSB	MARK
	MOVAB	1$,EXPECT
	PUSHAL	A1_0
	CALLS	#1,G^MTH$RANDOM
1$:	JSB	SAVE
	MOVL	A1_0,RES
	MOVL	#1,R0
	RET
	.ENTRY	C2,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
