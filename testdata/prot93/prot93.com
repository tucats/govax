$ ! File IDs for the opens by file ID, which pass over directories.
$ OPEN/WRITE FIDF PROT93$DISK:[PROT93LOG]FIDS.DAT
$ FID = F$FILE_ATTRIBUTES("PROT93$DISK:[PROT93.DN]A.DAT","FID") - "(" - ")"
$ FA = F$ELEMENT(0,",",FID)
$ FB = F$ELEMENT(1,",",FID)
$ FC = F$ELEMENT(2,",",FID)
$ WRITE FIDF "I- PROT93$DISK:[000000]|''FA'|''FB'|''FC'|G"
$ FID = F$FILE_ATTRIBUTES("PROT93$DISK:[PROT93.F]FNONE.DAT","FID") - "(" - ")"
$ FA = F$ELEMENT(0,",",FID)
$ FB = F$ELEMENT(1,",",FID)
$ FC = F$ELEMENT(2,",",FID)
$ WRITE FIDF "I- PROT93$DISK:[000000]|''FA'|''FB'|''FC'|G"
$ FID = F$FILE_ATTRIBUTES("PROT93$DISK:[PROT93.F]FR.DAT","FID") - "(" - ")"
$ FA = F$ELEMENT(0,",",FID)
$ FB = F$ELEMENT(1,",",FID)
$ FC = F$ELEMENT(2,",",FID)
$ WRITE FIDF "I- PROT93$DISK:[000000]|''FA'|''FB'|''FC'|G"
$ FID = F$FILE_ATTRIBUTES("PROT93$DISK:[PROT93.F]FALL.DAT","FID") - "(" - ")"
$ FA = F$ELEMENT(0,",",FID)
$ FB = F$ELEMENT(1,",",FID)
$ FC = F$ELEMENT(2,",",FID)
$ WRITE FIDF "I- PROT93$DISK:[000000]|''FA'|''FB'|''FC'|GP"
$ FID = F$FILE_ATTRIBUTES("PROT93$DISK:[PROT93.PX1.PY.PZ]X.DAT","FID") - "(" - ")"
$ FA = F$ELEMENT(0,",",FID)
$ FB = F$ELEMENT(1,",",FID)
$ FC = F$ELEMENT(2,",",FID)
$ WRITE FIDF "I- PROT93$DISK:[000000]|''FA'|''FB'|''FC'|G"
$ CLOSE FIDF
$ SET SECURITY/PROTECTION=(S:RWED,O:RWED,G:RE,W:RE) PROT93$DISK:[PROT93LOG]FIDS.DAT
$ TYPE PROT93$DISK:[PROT93LOG]FIDS.DAT
$ DIRECTORY/SECURITY PROT93$DISK:[PROT93...]
