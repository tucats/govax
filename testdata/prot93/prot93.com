$ ! PROT93.COM - Phase 93's probe of file protection: SYSTEM's run.
$ ! Written by testdata/prot93/gen.go. Run it as SYSTEM, from the exchange
$ ! volume, mounted /SYSTEM (README.md):
$ !
$ !     @DUA1:[000000]PROT93
$ !
$ ! It defines PROT93$DISK in the system table for the volume, makes the
$ ! accounts PROT93A, PROT93B, and PROT93C, builds the tree, and runs
$ ! SYSTEM's parts. Its log is PROT93$DISK:[PROT93LOG]PROT93.LOG.
$ !
$ IF P1 .EQS. "LOGGED" THEN GOTO BEGIN
$ HERE = F$ENVIRONMENT("PROCEDURE")
$ DEV = F$PARSE(HERE,,,"DEVICE")
$ DEFINE/SYSTEM/EXECUTIVE_MODE PROT93$DISK 'DEV'
$ LOGFILE = DEV + "[PROT93LOG]PROT93.LOG"
$ @'HERE'/OUTPUT='LOGFILE' LOGGED
$ WRITE SYS$OUTPUT "PROT93 finished; the log is ", LOGFILE
$ EXIT
$ BEGIN:
$ SET NOON
$ SET VERIFY
$ !
$ WRITE SYS$OUTPUT "######## ENVIRONMENT"
$ WRITE SYS$OUTPUT F$GETSYI("VERSION"), " ", F$GETSYI("HW_NAME"), " ", F$GETSYI("NODENAME")
$ SHOW LOGICAL PROT93$DISK
$ WRITE SYS$OUTPUT F$GETJPI("","USERNAME"), " ", F$GETJPI("","UIC")
$ SHOW PROCESS/PRIVILEGES
$ SHOW PROTECTION
$ WRITE SYS$OUTPUT F$ENVIRONMENT("PROTECTION")
$ SAVED_PROTECTION = F$ENVIRONMENT("PROTECTION")
$ SHOW SECURITY/CLASS=VOLUME PROT93$DISK:
$ DIRECTORY/SECURITY PROT93$DISK:[000000]
$ !
$ WRITE SYS$OUTPUT "######## VOLUME"
$ SET VOLUME/PROTECTION=(S:RWCD,O:RWCD,G:RWCD,W:RWCD) PROT93$DISK:
$ SET SECURITY/PROTECTION=(S:RWE,O:RWE,G:RWE,W:RWE) PROT93$DISK:[000000]000000.DIR
$ SET SECURITY/PROTECTION=(S:RWE,O:RWE,G:RWE,W:RWE) PROT93$DISK:[000000]PROT93LOG.DIR
$ SET SECURITY/PROTECTION=(S:RWED,O:RWED,G:RE,W:RE) PROT93$DISK:[000000]*.*;*/EXCLUDE=(*.DIR)
$ SHOW SECURITY/CLASS=VOLUME PROT93$DISK:
$ DIRECTORY/SECURITY PROT93$DISK:[000000]
$ !
$ WRITE SYS$OUTPUT "######## ACCOUNTS"
$ HOME = F$ENVIRONMENT("DEFAULT")
$ SET DEFAULT SYS$SYSTEM
$ RUN SYS$SYSTEM:AUTHORIZE
ADD/IDENTIFIER PROT93G2/VALUE=UIC=[200,177777]
ADD/IDENTIFIER PROT93G3/VALUE=UIC=[300,177777]
ADD PROT93A/UIC=[200,1]/PASSWORD=PROT93PW/NOPWDEXPIRED/PWDLIFETIME=NONE/FLAGS=NODISUSER/DEVICE=PROT93$DISK:/DIRECTORY=[PROT93LOG]/PRIVILEGES=(TMPMBX,NETMBX)/DEFPRIVILEGES=(TMPMBX,NETMBX)/ACCOUNT=PROT93/OWNER="PHASE 93 PROBE"
ADD PROT93B/UIC=[200,2]/PASSWORD=PROT93PW/NOPWDEXPIRED/PWDLIFETIME=NONE/FLAGS=NODISUSER/DEVICE=PROT93$DISK:/DIRECTORY=[PROT93LOG]/PRIVILEGES=(TMPMBX,NETMBX,READALL,GRPPRV,SYSPRV,BYPASS)/DEFPRIVILEGES=(TMPMBX,NETMBX)/ACCOUNT=PROT93/OWNER="PHASE 93 PROBE"
ADD PROT93C/UIC=[300,1]/PASSWORD=PROT93PW/NOPWDEXPIRED/PWDLIFETIME=NONE/FLAGS=NODISUSER/DEVICE=PROT93$DISK:/DIRECTORY=[PROT93LOG]/PRIVILEGES=(TMPMBX,NETMBX,READALL,GRPPRV,SYSPRV,BYPASS)/DEFPRIVILEGES=(TMPMBX,NETMBX)/ACCOUNT=PROT93/OWNER="PHASE 93 PROBE"
ADD/IDENTIFIER PROT93_TEAM
GRANT/IDENTIFIER PROT93_TEAM PROT93C
SHOW PROT93A/BRIEF
SHOW PROT93B/BRIEF
SHOW PROT93C/BRIEF
SHOW/IDENTIFIER PROT93*
EXIT
$ SET DEFAULT 'HOME'
$ WRITE SYS$OUTPUT F$IDENTIFIER("PROT93A","NAME_TO_NUMBER")
$ WRITE SYS$OUTPUT F$IDENTIFIER("PROT93_TEAM","NAME_TO_NUMBER")
$ !
$ WRITE SYS$OUTPUT "######## BUILD"
$ SET DEFAULT PROT93$DISK:[000000]
$ DEFINE/USER_MODE SYS$OUTPUT PROT93.MLG
$ MACRO/NOLIST PROT93
$ SHOW SYMBOL $STATUS
$ DEFINE/USER_MODE SYS$OUTPUT PROT93.LLG
$ LINK/NOMAP PROT93
$ SHOW SYMBOL $STATUS
$ IF F$SEARCH("PROT93.EXE") .EQS. "" THEN EXIT
$ MACRO/NOLIST HELLO
$ LINK/NOMAP HELLO
$ SET SECURITY/PROTECTION=(S:RWED,O:RWED,G:RE,W:RE) PROT93.EXE,HELLO.EXE
$ MACRO/NOLIST DEF_CHP
$ MACRO/NOLIST DEF_OSS
$ MACRO/NOLIST DEF_ACE
$ MACRO/NOLIST DEF_ACL
$ MACRO/NOLIST DEF_ARM
$ MACRO/NOLIST DEF_KGB
$ MACRO/NOLIST DEF_PRV
$ DIRECTORY/SIZE DEF_*.OBJ
$ !
$ WRITE SYS$OUTPUT "######## TREE"
$ CREATE PROT93$DISK:[PROT93LOG]T.DAT
RECORD ONE OF THE TEMPLATE
$ SET SECURITY/PROTECTION=(S:RWED,O:RWED,G:RE,W:RE) PROT93$DISK:[PROT93LOG]T.DAT
