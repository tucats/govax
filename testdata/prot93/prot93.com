$ SET SECURITY/ACL=(IDENTIFIER=[*,*],ACCESS=READ) PROT93$DISK:[PROT93.ACE]ACE05.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]ACE05.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.ACE]ACE06.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93_TEAM,ACCESS=NONE) PROT93$DISK:[PROT93.ACE]ACE06.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]ACE06.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.ACE]ACE07.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93A+PROT93_TEAM,ACCESS=READ) PROT93$DISK:[PROT93.ACE]ACE07.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]ACE07.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.ACE]ACE08.DAT
$ SET SECURITY/ACL=(IDENTIFIER=INTERACTIVE,ACCESS=READ) PROT93$DISK:[PROT93.ACE]ACE08.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]ACE08.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.ACE]ACE09.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93A,OPTIONS=PROTECTED,ACCESS=READ) PROT93$DISK:[PROT93.ACE]ACE09.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]ACE09.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.ACE]ACE10.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93A,OPTIONS=NOPROPAGATE,ACCESS=READ) PROT93$DISK:[PROT93.ACE]ACE10.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]ACE10.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.ACE]ACE11.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93A,OPTIONS=HIDDEN,ACCESS=READ) PROT93$DISK:[PROT93.ACE]ACE11.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]ACE11.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.ACE]ACE12.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93A,OPTIONS=DEFAULT,ACCESS=READ) PROT93$DISK:[PROT93.ACE]ACE12.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]ACE12.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.ACE]ACE13.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93A,OPTIONS=PROTECTED+NOPROPAGATE,ACCESS=READ) PROT93$DISK:[PROT93.ACE]ACE13.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]ACE13.DAT
$ CREATE/DIRECTORY PROT93$DISK:[PROT93.ACE.ACE14]
$ SET SECURITY/ACL=(DEFAULT_PROTECTION,S:RWED,O:RWED,G:RE,W:) PROT93$DISK:[PROT93.ACE]ACE14.DIR
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]ACE14.DIR
$ CREATE/DIRECTORY PROT93$DISK:[PROT93.ACE.ACE15]
$ SET SECURITY/ACL=(DEFAULT_PROTECTION,OPTIONS=PROTECTED,S:RWED,O:RWED,G,W) PROT93$DISK:[PROT93.ACE]ACE15.DIR
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]ACE15.DIR
$ CREATE/DIRECTORY PROT93$DISK:[PROT93.ACE.ACE16]
$ SET SECURITY/ACL=(CREATOR,ACCESS=READ+WRITE) PROT93$DISK:[PROT93.ACE]ACE16.DIR
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]ACE16.DIR
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.ACE]ACE17.DAT
$ SET SECURITY/ACL=(ALARM=SECURITY,ACCESS=READ+WRITE+SUCCESS+FAILURE) PROT93$DISK:[PROT93.ACE]ACE17.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]ACE17.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.ACE]ACE18.DAT
$ SET SECURITY/ACL=(AUDIT=SECURITY,ACCESS=DELETE+FAILURE) PROT93$DISK:[PROT93.ACE]ACE18.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]ACE18.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.ACE]ACE19.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93G2,ACCESS=READ) PROT93$DISK:[PROT93.ACE]ACE19.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]ACE19.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.ACE]ACE20.DAT
$ SET SECURITY/ACL=((IDENTIFIER=PROT93A,ACCESS=READ),(IDENTIFIER=PROT93B,ACCESS=WRITE)) PROT93$DISK:[PROT93.ACE]ACE20.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]ACE20.DAT
$ CREATE/DIRECTORY PROT93$DISK:[PROT93.ACE.ACE21]
$ SET SECURITY/ACL=(IDENTIFIER=PROT93A,OPTIONS=DEFAULT,ACCESS=READ) PROT93$DISK:[PROT93.ACE]ACE21.DIR
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]ACE21.DIR
$ !
$ ! Changing one ACL step by step.
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.ACE]M.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93A,ACCESS=READ) PROT93$DISK:[PROT93.ACE]M.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]M.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93B,ACCESS=READ) PROT93$DISK:[PROT93.ACE]M.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]M.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93C,ACCESS=READ)/AFTER=(IDENTIFIER=PROT93B,ACCESS=READ) PROT93$DISK:[PROT93.ACE]M.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]M.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93C,ACCESS=READ)/REPLACE=(IDENTIFIER=PROT93C,ACCESS=WRITE) PROT93$DISK:[PROT93.ACE]M.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]M.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93A,OPTIONS=PROTECTED,ACCESS=EXECUTE) PROT93$DISK:[PROT93.ACE]M.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]M.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93A,OPTIONS=NOPROPAGATE,ACCESS=DELETE) PROT93$DISK:[PROT93.ACE]M.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]M.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93B,ACCESS=READ)/DELETE PROT93$DISK:[PROT93.ACE]M.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]M.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93A,ACCESS=READ) PROT93$DISK:[PROT93.ACE]M.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]M.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93B,ACCESS=WRITE)/DELETE PROT93$DISK:[PROT93.ACE]M.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]M.DAT
$ SET SECURITY/ACL/DELETE PROT93$DISK:[PROT93.ACE]M.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]M.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93C,ACCESS=READ) PROT93$DISK:[PROT93.ACE]M.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]M.DAT
$ SET SECURITY/ACL/DELETE=ALL PROT93$DISK:[PROT93.ACE]M.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]M.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93A,ACCESS=READ)/DELETE PROT93$DISK:[PROT93.ACE]M.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]M.DAT
$ SET SECURITY/ACL=((IDENTIFIER=PROT93A,ACCESS=READ),(IDENTIFIER=PROT93B,ACCESS=WRITE),(IDENTIFIER=PROT93C,ACCESS=EXECUTE)) PROT93$DISK:[PROT93.ACE]M.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]M.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93C,ACCESS=READ)/DELETE=ALL PROT93$DISK:[PROT93.ACE]M.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]M.DAT
$ !
$ ! /LIKE and /DEFAULT with protected and nopropagate ACEs.
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.ACE]L1.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.ACE]L2.DAT
$ SET SECURITY/ACL=((IDENTIFIER=PROT93A,OPTIONS=PROTECTED,ACCESS=READ),(IDENTIFIER=PROT93B,OPTIONS=NOPROPAGATE,ACCESS=READ),(IDENTIFIER=PROT93C,ACCESS=READ)) PROT93$DISK:[PROT93.ACE]L1.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93_TEAM,OPTIONS=PROTECTED,ACCESS=WRITE) PROT93$DISK:[PROT93.ACE]L2.DAT
$ SET SECURITY/LIKE=NAME=PROT93$DISK:[PROT93.ACE]L1.DAT PROT93$DISK:[PROT93.ACE]L2.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]L1.DAT,PROT93$DISK:[PROT93.ACE]L2.DAT
$ SET SECURITY/DEFAULT PROT93$DISK:[PROT93.ACE]L1.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]L1.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.ACE]L1.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]L1.DAT
$ COPY PROT93$DISK:[PROT93.ACE]L2.DAT PROT93$DISK:[PROT93.ACE]L3.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]L3.DAT
$ !
$ ! Malformed ACEs.
$ SET SECURITY/ACL=(IDENTIFIER=NOSUCH,ACCESS=READ) PROT93$DISK:[PROT93.ACE]M.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93A,ACCESS=FLY) PROT93$DISK:[PROT93.ACE]M.DAT
$ SET SECURITY/ACL=(FOO=BAR) PROT93$DISK:[PROT93.ACE]M.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93A,ACCESS=READ PROT93$DISK:[PROT93.ACE]M.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93A) PROT93$DISK:[PROT93.ACE]M.DAT
$ SET SECURITY/ACL=(DEFAULT_PROTECTION,S:Q) PROT93$DISK:[PROT93.ACE]M.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93A,OPTIONS=WHATEVER,ACCESS=READ) PROT93$DISK:[PROT93.ACE]M.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]M.DAT
$ DIRECTORY/ACL PROT93$DISK:[PROT93.ACE]*.*
$ DIRECTORY/SECURITY PROT93$DISK:[PROT93.ACE]*.*
$ !
$ ! The ACLs' bytes, as $DISPLAY's XABPRO returns them.
$ DEFINE PROT93_TAG M4
$ DEFINE/USER_MODE SYS$INPUT PROT93$DISK:[000000]PROT93E.DAT
$ RUN PROT93$DISK:[000000]PROT93
$ SHOW SYMBOL $STATUS
$ !
$ WRITE SYS$OUTPUT "######## DISPLAY"
$ DIRECTORY/OWNER PROT93$DISK:[PROT93.F]
$ DIRECTORY/PROTECTION PROT93$DISK:[PROT93.F]
$ DIRECTORY/OWNER/PROTECTION PROT93$DISK:[PROT93.F]
$ DIRECTORY/SECURITY PROT93$DISK:[PROT93.F]
$ DIRECTORY/ACL PROT93$DISK:[PROT93.F]
$ DIRECTORY/FULL PROT93$DISK:[PROT93.F]
$ SHOW SECURITY PROT93$DISK:[PROT93.F]*.*
$ SHOW SECURITY PROT93$DISK:[PROT93]F.DIR
$ SHOW SECURITY PROT93$DISK:[PROT93]DN.DIR
$ DIRECTORY/OWNER/PROTECTION PROT93$DISK:[PROT93]
$ !
$ WRITE SYS$OUTPUT "######## PROGRAM AS SYSTEM"
$ SET PROCESS/PRIVILEGES=(NOREADALL,NOGRPPRV,NOSYSPRV,NOBYPASS)
$ WRITE SYS$OUTPUT "READALL=", F$PRIVILEGE("READALL"), " GRPPRV=", F$PRIVILEGE("GRPPRV"), " SYSPRV=", F$PRIVILEGE("SYSPRV"), " BYPASS=", F$PRIVILEGE("BYPASS")
$ DEFINE PROT93_TAG M0
$ DEFINE/USER_MODE SYS$INPUT PROT93$DISK:[000000]PROT93C.DAT
$ RUN PROT93$DISK:[000000]PROT93
$ SHOW SYMBOL $STATUS
$ DEFINE PROT93_TAG M0
$ DEFINE/USER_MODE SYS$INPUT PROT93$DISK:[000000]PROT93D.DAT
$ RUN PROT93$DISK:[000000]PROT93
$ SHOW SYMBOL $STATUS
$ DEFINE PROT93_TAG M0
$ DEFINE/USER_MODE SYS$INPUT PROT93$DISK:[PROT93LOG]FIDS.DAT
$ RUN PROT93$DISK:[000000]PROT93
$ SHOW SYMBOL $STATUS
$ SET PROCESS/PRIVILEGES=READALL
$ WRITE SYS$OUTPUT "READALL=", F$PRIVILEGE("READALL"), " GRPPRV=", F$PRIVILEGE("GRPPRV"), " SYSPRV=", F$PRIVILEGE("SYSPRV"), " BYPASS=", F$PRIVILEGE("BYPASS")
$ DEFINE PROT93_TAG M1
$ DEFINE/USER_MODE SYS$INPUT PROT93$DISK:[000000]PROT93C.DAT
$ RUN PROT93$DISK:[000000]PROT93
$ SHOW SYMBOL $STATUS
$ DEFINE PROT93_TAG M1
$ DEFINE/USER_MODE SYS$INPUT PROT93$DISK:[PROT93LOG]FIDS.DAT
$ RUN PROT93$DISK:[000000]PROT93
$ SHOW SYMBOL $STATUS
$ SET PROCESS/PRIVILEGES=(READALL,GRPPRV,SYSPRV,BYPASS)
$ WRITE SYS$OUTPUT "READALL=", F$PRIVILEGE("READALL"), " GRPPRV=", F$PRIVILEGE("GRPPRV"), " SYSPRV=", F$PRIVILEGE("SYSPRV"), " BYPASS=", F$PRIVILEGE("BYPASS")
$ DEFINE PROT93_TAG M4
$ DEFINE/USER_MODE SYS$INPUT PROT93$DISK:[000000]PROT93C.DAT
$ RUN PROT93$DISK:[000000]PROT93
$ SHOW SYMBOL $STATUS
$ DEFINE PROT93_TAG M4
$ DEFINE/USER_MODE SYS$INPUT PROT93$DISK:[PROT93LOG]FIDS.DAT
$ RUN PROT93$DISK:[000000]PROT93
$ SHOW SYMBOL $STATUS
$ !
$ WRITE SYS$OUTPUT "######## PART B AS SYSTEM WITHOUT PRIVILEGES"
$ SET PROCESS/PRIVILEGES=(NOREADALL,NOGRPPRV,NOSYSPRV,NOBYPASS)
$ WRITE SYS$OUTPUT "READALL=", F$PRIVILEGE("READALL"), " GRPPRV=", F$PRIVILEGE("GRPPRV"), " SYSPRV=", F$PRIVILEGE("SYSPRV"), " BYPASS=", F$PRIVILEGE("BYPASS")
$ @PROT93$DISK:[000000]PROT93B M0
$ SET PROCESS/PRIVILEGES=(READALL,GRPPRV,SYSPRV,BYPASS)
$ !
$ WRITE SYS$OUTPUT "######## END"
$ SHOW PROCESS/PRIVILEGES
$ WRITE SYS$OUTPUT "PROT93 FINISHED"
$ SET NOVERIFY
$ EXIT
