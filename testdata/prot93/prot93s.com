$ ! PROT93S.COM - Phase 93's probe, round 2: the accounts again, and
$ ! round 2's files opened to them (exchange2.cmd's copies gave the world
$ ! no access). Written by testdata/prot93/gen.go. Run it as SYSTEM in
$ ! place of PROT93R.COM, which has run (README.md's "Round 2"):
$ !
$ !     @DUA1:[000000]PROT93S
$ !
$ IF P1 .EQS. "LOGGED" THEN GOTO BEGIN
$ HERE = F$ENVIRONMENT("PROCEDURE")
$ DEV = F$PARSE(HERE,,,"DEVICE")
$ DEFINE/SYSTEM/EXECUTIVE_MODE PROT93$DISK 'DEV'
$ LOGFILE = DEV + "[PROT93LOG]PROT93S.LOG"
$ @'HERE'/OUTPUT='LOGFILE' LOGGED
$ WRITE SYS$OUTPUT "PROT93S finished; the log is ", LOGFILE
$ EXIT
$ BEGIN:
$ SET NOON
$ SET VERIFY
$ !
$ WRITE SYS$OUTPUT "######## ACCOUNTS"
$ HOME = F$ENVIRONMENT("DEFAULT")
$ SET DEFAULT SYS$SYSTEM
$ RUN SYS$SYSTEM:AUTHORIZE
ADD PROT93A/UIC=[200,1]/PASSWORD=PROT93PW/NOPWDEXPIRED/PWDLIFETIME=NONE/FLAGS=NODISUSER/DEVICE=PROT93$DISK:/DIRECTORY=[PROT93LOG]/PRIVILEGES=(TMPMBX,NETMBX)/DEFPRIVILEGES=(TMPMBX,NETMBX)/ACCOUNT=PROT93/OWNER="PHASE 93 PROBE"
ADD PROT93B/UIC=[200,2]/PASSWORD=PROT93PW/NOPWDEXPIRED/PWDLIFETIME=NONE/FLAGS=NODISUSER/DEVICE=PROT93$DISK:/DIRECTORY=[PROT93LOG]/PRIVILEGES=(TMPMBX,NETMBX,READALL,GRPPRV,SYSPRV,BYPASS)/DEFPRIVILEGES=(TMPMBX,NETMBX)/ACCOUNT=PROT93/OWNER="PHASE 93 PROBE"
ADD PROT93C/UIC=[300,1]/PASSWORD=PROT93PW/NOPWDEXPIRED/PWDLIFETIME=NONE/FLAGS=NODISUSER/DEVICE=PROT93$DISK:/DIRECTORY=[PROT93LOG]/PRIVILEGES=(TMPMBX,NETMBX,READALL,GRPPRV,SYSPRV,BYPASS)/DEFPRIVILEGES=(TMPMBX,NETMBX)/ACCOUNT=PROT93/OWNER="PHASE 93 PROBE"
ADD/IDENTIFIER PROT93_TEAM/VALUE=IDENTIFIER=65537
GRANT/IDENTIFIER PROT93_TEAM PROT93C
SHOW/IDENTIFIER/FULL PROT93
SHOW/IDENTIFIER/FULL PROT93_TEAM
EXIT
$ SET DEFAULT 'HOME'
$ WRITE SYS$OUTPUT F$IDENTIFIER("PROT93_TEAM","NAME_TO_NUMBER")
$ !
$ WRITE SYS$OUTPUT "######## ROUND 2'S FILES OPENED"
$ SET SECURITY/PROTECTION=(W:RE) PROT93$DISK:[000000]PROT93V.COM
$ SHOW SECURITY PROT93$DISK:[000000]PROT93V.COM
$ SET SECURITY/PROTECTION=(W:RE) PROT93$DISK:[000000]PROT93F.DAT
$ SHOW SECURITY PROT93$DISK:[000000]PROT93F.DAT
$ SET SECURITY/PROTECTION=(W:RE) PROT93$DISK:[000000]PROT93G.DAT
$ SHOW SECURITY PROT93$DISK:[000000]PROT93G.DAT
$ SET SECURITY/PROTECTION=(W:RE) PROT93$DISK:[000000]PROT93C.DAT
$ SHOW SECURITY PROT93$DISK:[000000]PROT93C.DAT
$ SET SECURITY/PROTECTION=(W:RE) PROT93$DISK:[000000]PROT93D.DAT
$ SHOW SECURITY PROT93$DISK:[000000]PROT93D.DAT
$ SET SECURITY/PROTECTION=(W:RE) PROT93$DISK:[000000]PROT93.EXE
$ SHOW SECURITY PROT93$DISK:[000000]PROT93.EXE
$ SET SECURITY/PROTECTION=(W:RE) PROT93$DISK:[PROT93LOG]FIDS.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93LOG]FIDS.DAT
$ SET SECURITY/PROTECTION=(W:RE) PROT93$DISK:[PROT93.IMG]PRO2E.COM
$ SHOW SECURITY PROT93$DISK:[PROT93.IMG]PRO2E.COM
$ SET SECURITY/PROTECTION=(W:RE) PROT93$DISK:[PROT93.IMG]PRO2R.COM
$ SHOW SECURITY PROT93$DISK:[PROT93.IMG]PRO2R.COM
$ SET SECURITY/PROTECTION=(W:RE) PROT93$DISK:[PROT93.IMG]PRO2N.COM
$ SHOW SECURITY PROT93$DISK:[PROT93.IMG]PRO2N.COM
$ !
$ WRITE SYS$OUTPUT "######## END"
$ WRITE SYS$OUTPUT "PROT93S FINISHED"
$ SET NOVERIFY
$ EXIT
