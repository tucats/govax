$ ! SEC93X.COM - Phase 93's probe, round 3: the cases that give a service malformed or unusual input. Run it as
$ ! SYSTEM after PROT93C's run, and again after a crash, with the volume
$ ! mounted /SYSTEM:
$ !
$ !     @DUA1:[000000]SEC93X
$ !
$ ! The last case is expected to crash VMS, and runs only with P1 CRASH:
$ !
$ !     @DUA1:[000000]SEC93X CRASH
$ !
$ ! Its log is PROT93$DISK:[PROT93LOG]SEC93X.LOG, and each case's
$ ! SEC93X_n.LOG.
$ ! Written by testdata/prot93/gen3.go (README.md's "Round 3").
$ !
$ IF P1 .EQS. "LOGGED" THEN GOTO BEGIN
$ HERE = F$ENVIRONMENT("PROCEDURE")
$ DEV = F$PARSE(HERE,,,"DEVICE")
$ DEFINE/SYSTEM/EXECUTIVE_MODE PROT93$DISK 'DEV'
$ LOGFILE = DEV + "[PROT93LOG]" + "SEC93X.LOG"
$ @'HERE'/OUTPUT='LOGFILE' LOGGED 'P1'
$ WRITE SYS$OUTPUT "SEC93X finished; the log is ", LOGFILE
$ EXIT
$ BEGIN:
$ SET NOON
$ SET VERIFY
$ HOME = F$ENVIRONMENT("DEFAULT")
$ SET PROCESS/PRIVILEGES=(READALL,GRPPRV,SYSPRV,BYPASS)
$ !
$ CASE_LOG = "PROT93$DISK:[PROT93LOG]SEC93X_567.LOG"
$ IF F$SEARCH(CASE_LOG) .NES. "" THEN GOTO DONE_567
$ WRITE SYS$OUTPUT "######## CASE 567: $GET_SECURITY FILE PROT93$DISK:[SEC93.GET]G1.DAT [item 99]"
$ DEFINE SEC93_ONLY "567"
$ DEFINE/USER_MODE SYS$OUTPUT 'CASE_LOG'
$ RUN PROT93$DISK:[SEC93]SEC93
$ SHOW SYMBOL $STATUS
$ TYPE 'CASE_LOG'
$ DONE_567:
$ !
$ CASE_LOG = "PROT93$DISK:[PROT93LOG]SEC93X_568.LOG"
$ IF F$SEARCH(CASE_LOG) .NES. "" THEN GOTO DONE_568
$ WRITE SYS$OUTPUT "######## CASE 568: $GET_SECURITY FILE PROT93$DISK:[SEC93.GET]G1.DAT [no items]"
$ DEFINE SEC93_ONLY "568"
$ DEFINE/USER_MODE SYS$OUTPUT 'CASE_LOG'
$ RUN PROT93$DISK:[SEC93]SEC93
$ SHOW SYMBOL $STATUS
$ TYPE 'CASE_LOG'
$ DONE_568:
$ !
$ CASE_LOG = "PROT93$DISK:[PROT93LOG]SEC93X_569.LOG"
$ IF F$SEARCH(CASE_LOG) .NES. "" THEN GOTO DONE_569
$ WRITE SYS$OUTPUT "######## CASE 569: $CHKPRO no items"
$ DEFINE SEC93_ONLY "569"
$ DEFINE/USER_MODE SYS$OUTPUT 'CASE_LOG'
$ RUN PROT93$DISK:[SEC93]SEC93
$ SHOW SYMBOL $STATUS
$ TYPE 'CASE_LOG'
$ DONE_569:
$ !
$ CASE_LOG = "PROT93$DISK:[PROT93LOG]SEC93X_570.LOG"
$ IF F$SEARCH(CASE_LOG) .NES. "" THEN GOTO DONE_570
$ WRITE SYS$OUTPUT "######## CASE 570: $CHKPRO item 99"
$ DEFINE SEC93_ONLY "570"
$ DEFINE/USER_MODE SYS$OUTPUT 'CASE_LOG'
$ RUN PROT93$DISK:[SEC93]SEC93
$ SHOW SYMBOL $STATUS
$ TYPE 'CASE_LOG'
$ DONE_570:
$ !
$ CASE_LOG = "PROT93$DISK:[PROT93LOG]SEC93X_571.LOG"
$ IF F$SEARCH(CASE_LOG) .NES. "" THEN GOTO DONE_571
$ WRITE SYS$OUTPUT "######## CASE 571: $CHKPRO 21 ACL items"
$ DEFINE SEC93_ONLY "571"
$ DEFINE/USER_MODE SYS$OUTPUT 'CASE_LOG'
$ RUN PROT93$DISK:[SEC93]SEC93
$ SHOW SYMBOL $STATUS
$ TYPE 'CASE_LOG'
$ DONE_571:
$ !
$ CASE_LOG = "PROT93$DISK:[PROT93LOG]SEC93X_572.LOG"
$ IF F$SEARCH(CASE_LOG) .NES. "" THEN GOTO DONE_572
$ WRITE SYS$OUTPUT "######## CASE 572: $CHKPRO ACL with an ACE of size 3"
$ DEFINE SEC93_ONLY "572"
$ DEFINE/USER_MODE SYS$OUTPUT 'CASE_LOG'
$ RUN PROT93$DISK:[SEC93]SEC93
$ SHOW SYMBOL $STATUS
$ TYPE 'CASE_LOG'
$ DONE_572:
$ !
$ CASE_LOG = "PROT93$DISK:[PROT93LOG]SEC93X_573.LOG"
$ IF F$SEARCH(CASE_LOG) .NES. "" THEN GOTO DONE_573
$ WRITE SYS$OUTPUT "######## CASE 573: $CHANGE_ACL PROT93$DISK:[SEC93.CHG]CX1.DAT item 99"
$ DEFINE SEC93_ONLY "573"
$ DEFINE/USER_MODE SYS$OUTPUT 'CASE_LOG'
$ RUN PROT93$DISK:[SEC93]SEC93
$ SHOW SYMBOL $STATUS
$ TYPE 'CASE_LOG'
$ DONE_573:
$ !
$ CASE_LOG = "PROT93$DISK:[PROT93LOG]SEC93X_574.LOG"
$ IF F$SEARCH(CASE_LOG) .NES. "" THEN GOTO DONE_574
$ WRITE SYS$OUTPUT "######## CASE 574: $CHANGE_ACL PROT93$DISK:[SEC93.CHG]CX2.DAT no items"
$ DEFINE SEC93_ONLY "574"
$ DEFINE/USER_MODE SYS$OUTPUT 'CASE_LOG'
$ RUN PROT93$DISK:[SEC93]SEC93
$ SHOW SYMBOL $STATUS
$ TYPE 'CASE_LOG'
$ DONE_574:
$ !
$ CASE_LOG = "PROT93$DISK:[PROT93LOG]SEC93X_575.LOG"
$ IF F$SEARCH(CASE_LOG) .NES. "" THEN GOTO DONE_575
$ WRITE SYS$OUTPUT "######## CASE 575: $CHANGE_ACL PROT93$DISK:[SEC93.CHG]CX3.DAT ACLLENGTH [a 2-byte buffer]"
$ DEFINE SEC93_ONLY "575"
$ DEFINE/USER_MODE SYS$OUTPUT 'CASE_LOG'
$ RUN PROT93$DISK:[SEC93]SEC93
$ SHOW SYMBOL $STATUS
$ TYPE 'CASE_LOG'
$ DONE_575:
$ !
$ CASE_LOG = "PROT93$DISK:[PROT93LOG]SEC93X_576.LOG"
$ IF F$SEARCH(CASE_LOG) .NES. "" THEN GOTO DONE_576
$ WRITE SYS$OUTPUT "######## CASE 576: $SET_SECURITY FILE PROT93$DISK:[SEC93.SET]SX1.DAT PROTECTION 1 byte"
$ DEFINE SEC93_ONLY "576"
$ DEFINE/USER_MODE SYS$OUTPUT 'CASE_LOG'
$ RUN PROT93$DISK:[SEC93]SEC93
$ SHOW SYMBOL $STATUS
$ TYPE 'CASE_LOG'
$ DONE_576:
$ !
$ CASE_LOG = "PROT93$DISK:[PROT93LOG]SEC93X_577.LOG"
$ IF F$SEARCH(CASE_LOG) .NES. "" THEN GOTO DONE_577
$ WRITE SYS$OUTPUT "######## CASE 577: $SET_SECURITY FILE PROT93$DISK:[SEC93.SET]SX2.DAT OWNER 2 bytes"
$ DEFINE SEC93_ONLY "577"
$ DEFINE/USER_MODE SYS$OUTPUT 'CASE_LOG'
$ RUN PROT93$DISK:[SEC93]SEC93
$ SHOW SYMBOL $STATUS
$ TYPE 'CASE_LOG'
$ DONE_577:
$ !
$ CASE_LOG = "PROT93$DISK:[PROT93LOG]SEC93X_578.LOG"
$ IF F$SEARCH(CASE_LOG) .NES. "" THEN GOTO DONE_578
$ WRITE SYS$OUTPUT "######## CASE 578: $SET_SECURITY FILE PROT93$DISK:[SEC93.SET]SX3.DAT item 99"
$ DEFINE SEC93_ONLY "578"
$ DEFINE/USER_MODE SYS$OUTPUT 'CASE_LOG'
$ RUN PROT93$DISK:[SEC93]SEC93
$ SHOW SYMBOL $STATUS
$ TYPE 'CASE_LOG'
$ DONE_578:
$ !
$ CASE_LOG = "PROT93$DISK:[PROT93LOG]SEC93X_579.LOG"
$ IF F$SEARCH(CASE_LOG) .NES. "" THEN GOTO DONE_579
$ WRITE SYS$OUTPUT "######## CASE 579: $SET_SECURITY FILE PROT93$DISK:[SEC93.SET]SX4.DAT no items"
$ DEFINE SEC93_ONLY "579"
$ DEFINE/USER_MODE SYS$OUTPUT 'CASE_LOG'
$ RUN PROT93$DISK:[SEC93]SEC93
$ SHOW SYMBOL $STATUS
$ TYPE 'CASE_LOG'
$ DONE_579:
$ !
$ CASE_LOG = "PROT93$DISK:[PROT93LOG]SEC93X_580.LOG"
$ IF F$SEARCH(CASE_LOG) .NES. "" THEN GOTO DONE_580
$ WRITE SYS$OUTPUT "######## CASE 580: $CHANGE_ACL PROT93$DISK:[SEC93.CHG]CX4.DAT ADDACLENT a buffer longer than its ACE"
$ DEFINE SEC93_ONLY "580"
$ DEFINE/USER_MODE SYS$OUTPUT 'CASE_LOG'
$ RUN PROT93$DISK:[SEC93]SEC93
$ SHOW SYMBOL $STATUS
$ TYPE 'CASE_LOG'
$ DONE_580:
$ !
$ CASE_LOG = "PROT93$DISK:[PROT93LOG]SEC93X_581.LOG"
$ IF F$SEARCH(CASE_LOG) .NES. "" THEN GOTO DONE_581
$ WRITE SYS$OUTPUT "######## CASE 581: $CHANGE_ACL PROT93$DISK:[SEC93.CHG]CX5.DAT ADDACLENT a buffer shorter than its ACE"
$ DEFINE SEC93_ONLY "581"
$ DEFINE/USER_MODE SYS$OUTPUT 'CASE_LOG'
$ RUN PROT93$DISK:[SEC93]SEC93
$ SHOW SYMBOL $STATUS
$ TYPE 'CASE_LOG'
$ DONE_581:
$ !
$ CASE_LOG = "PROT93$DISK:[PROT93LOG]SEC93X_582.LOG"
$ IF F$SEARCH(CASE_LOG) .NES. "" THEN GOTO DONE_582
$ WRITE SYS$OUTPUT "######## CASE 582: $CHANGE_ACL PROT93$DISK:[SEC93.CHG]CX6.DAT ADDACLENT an ACE of type 200"
$ DEFINE SEC93_ONLY "582"
$ DEFINE/USER_MODE SYS$OUTPUT 'CASE_LOG'
$ RUN PROT93$DISK:[SEC93]SEC93
$ SHOW SYMBOL $STATUS
$ TYPE 'CASE_LOG'
$ DONE_582:
$ !
$ CASE_LOG = "PROT93$DISK:[PROT93LOG]SEC93X_583.LOG"
$ IF F$SEARCH(CASE_LOG) .NES. "" THEN GOTO DONE_583
$ WRITE SYS$OUTPUT "######## CASE 583: $CHANGE_ACL PROT93$DISK:[SEC93.CHG]CX7.DAT ADDACLENT an ACE of size 3"
$ DEFINE SEC93_ONLY "583"
$ DEFINE/USER_MODE SYS$OUTPUT 'CASE_LOG'
$ RUN PROT93$DISK:[SEC93]SEC93
$ SHOW SYMBOL $STATUS
$ TYPE 'CASE_LOG'
$ DONE_583:
$ !
$ CASE_LOG = "PROT93$DISK:[PROT93LOG]SEC93X_584.LOG"
$ IF F$SEARCH(CASE_LOG) .NES. "" THEN GOTO DONE_584
$ WRITE SYS$OUTPUT "######## CASE 584: $SET_SECURITY FILE PROT93$DISK:[SEC93.SET]SX5.DAT ACL_ADD_ENTRY an ACE of size 3"
$ DEFINE SEC93_ONLY "584"
$ DEFINE/USER_MODE SYS$OUTPUT 'CASE_LOG'
$ RUN PROT93$DISK:[SEC93]SEC93
$ SHOW SYMBOL $STATUS
$ TYPE 'CASE_LOG'
$ DONE_584:
$ !
$ CASE_LOG = "PROT93$DISK:[PROT93LOG]SEC93X_585.LOG"
$ IF F$SEARCH(CASE_LOG) .NES. "" THEN GOTO DONE_585
$ WRITE SYS$OUTPUT "######## CASE 585: $SET_SECURITY FILE PROT93$DISK:[SEC93.SET]SX6.DAT ACL_ADD_ENTRY HIDDEN"
$ DEFINE SEC93_ONLY "585"
$ DEFINE/USER_MODE SYS$OUTPUT 'CASE_LOG'
$ RUN PROT93$DISK:[SEC93]SEC93
$ SHOW SYMBOL $STATUS
$ TYPE 'CASE_LOG'
$ DONE_585:
$ !
$ CASE_LOG = "PROT93$DISK:[PROT93LOG]SEC93X_586.LOG"
$ IF F$SEARCH(CASE_LOG) .NES. "" THEN GOTO DONE_586
$ WRITE SYS$OUTPUT "######## CASE 586: $CHANGE_ACL PROT93$DISK:[SEC93.CHG]CX8.DAT ADDACLENT [200,1] HIDDEN READ"
$ DEFINE SEC93_ONLY "586"
$ DEFINE/USER_MODE SYS$OUTPUT 'CASE_LOG'
$ RUN PROT93$DISK:[SEC93]SEC93
$ SHOW SYMBOL $STATUS
$ TYPE 'CASE_LOG'
$ DONE_586:
$ !
$ CASE_LOG = "PROT93$DISK:[PROT93LOG]SEC93X_587.LOG"
$ IF F$SEARCH(CASE_LOG) .NES. "" THEN GOTO DONE_587
$ WRITE SYS$OUTPUT "######## CASE 587: $CHANGE_ACL PROT93$DISK:[SEC93.CHG]CX9.DAT ADDACLENT [200,1] READ with a reserved longword"
$ DEFINE SEC93_ONLY "587"
$ DEFINE/USER_MODE SYS$OUTPUT 'CASE_LOG'
$ RUN PROT93$DISK:[SEC93]SEC93
$ SHOW SYMBOL $STATUS
$ TYPE 'CASE_LOG'
$ DONE_587:
$ !
$ CASE_LOG = "PROT93$DISK:[PROT93LOG]SEC93X_588.LOG"
$ IF F$SEARCH(CASE_LOG) .NES. "" THEN GOTO DONE_588
$ ! Expected to crash VMS: run only by @SEC93X CRASH.
$ IF P2 .NES. "CRASH" THEN GOTO DONE_588
$ WRITE SYS$OUTPUT "######## CASE 588: $CHANGE_ACL PROT93$DISK:[SEC93.CHG]CX10.DAT ADDACLENT alarm SUCCESS READ, journal JOURNAL1 (crashed VMS: SECAUDERR)"
$ DEFINE SEC93_ONLY "588"
$ DEFINE/USER_MODE SYS$OUTPUT 'CASE_LOG'
$ RUN PROT93$DISK:[SEC93]SEC93
$ SHOW SYMBOL $STATUS
$ TYPE 'CASE_LOG'
$ DONE_588:
$ IF F$TRNLNM("SEC93_ONLY") .NES. "" THEN DEASSIGN SEC93_ONLY
$ WRITE SYS$OUTPUT "SEC93X FINISHED"
$ SET NOVERIFY
$ EXIT
