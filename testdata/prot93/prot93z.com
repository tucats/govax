$ ! PROT93Z.COM - Phase 93's probe: the listing at the end, and the
$ ! accounts removed. Written by testdata/prot93/gen.go. Run it as SYSTEM
$ ! after the accounts' runs (README.md):
$ !
$ !     @PROT93$DISK:[000000]PROT93Z
$ !
$ IF P1 .EQS. "LOGGED" THEN GOTO BEGIN
$ HERE = F$ENVIRONMENT("PROCEDURE")
$ DEV = F$PARSE(HERE,,,"DEVICE")
$ LOGFILE = DEV + "[PROT93LOG]" + "PROT93Z.LOG"
$ @'HERE'/OUTPUT='LOGFILE' LOGGED
$ WRITE SYS$OUTPUT "PROT93Z finished; the log is ", LOGFILE
$ EXIT
$ BEGIN:
$ SET NOON
$ SET VERIFY
$ !
$ WRITE SYS$OUTPUT "######## THE TREE"
$ DIRECTORY/SECURITY PROT93$DISK:[PROT93...]*.*;*
$ DIRECTORY/SECURITY PROT93$DISK:[PROT93LOG]*.*;*
$ DIRECTORY/SECURITY PROT93$DISK:[000000]*.*;*
$ DIRECTORY/SECURITY PROT93$DISK:[PROT93TOP...]*.*;*,[300001...]*.*;*,[200002...]*.*;*
$ !
$ WRITE SYS$OUTPUT "######## REMOVING THE ACCOUNTS"
$ HOME = F$ENVIRONMENT("DEFAULT")
$ SET DEFAULT SYS$SYSTEM
$ RUN SYS$SYSTEM:AUTHORIZE
REMOVE PROT93A
REMOVE PROT93B
REMOVE PROT93C
REMOVE/IDENTIFIER PROT93_TEAM
REMOVE/IDENTIFIER PROT93G2
REMOVE/IDENTIFIER PROT93G3
EXIT
$ SET DEFAULT 'HOME'
$ WRITE SYS$OUTPUT "PROT93Z FINISHED"
$ DEASSIGN/SYSTEM/EXECUTIVE_MODE PROT93$DISK
$ SET NOVERIFY
$ EXIT
