$ SET SECURITY/OWNER=[1,4]/PROTECTION=(S:RWED,O:RWED,G,W) PROT93$DISK:[SEC93.NP]NS_M.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[SEC93.NP]NR_U.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:R,O:RWED,G:R,W:R) PROT93$DISK:[SEC93.NP]NR_U.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[SEC93.NP]NN_U.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S,O:RWED,G,W) PROT93$DISK:[SEC93.NP]NN_U.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[SEC93.NP]NC_U.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S,O:RWED,G,W) PROT93$DISK:[SEC93.NP]NC_U.DAT
$ SET SECURITY/ACL=(IDENTIFIER=[300,1],ACCESS=CONTROL) PROT93$DISK:[SEC93.NP]NC_U.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[SEC93.NP]NZ_U.DAT
$ SET SECURITY/OWNER=[0,0]/PROTECTION=(S,O,G,W) PROT93$DISK:[SEC93.NP]NZ_U.DAT
$ SET SECURITY/ACL=((IDENTIFIER=[1,4],ACCESS=READ),(IDENTIFIER=[300,1],ACCESS=READ)) PROT93$DISK:[SEC93.NP]NZ_U.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[SEC93.NP]NO_U.DAT
$ SET SECURITY/OWNER=[300,1]/PROTECTION=(S,O:RWED,G,W) PROT93$DISK:[SEC93.NP]NO_U.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[SEC93.NP]NS_U.DAT
$ SET SECURITY/OWNER=[1,4]/PROTECTION=(S:RWED,O:RWED,G,W) PROT93$DISK:[SEC93.NP]NS_U.DAT
$ OPEN/WRITE EXOF PROT93$DISK:[SEC93.EXO]EXONLY.COM
$ WRITE EXOF "$ WRITE SYS$OUTPUT ""EXONLY LINE 1 RAN"""
$ WRITE EXOF "$ WRITE SYS$OUTPUT ""VERIFY_PROCEDURE="", F$ENVIRONMENT(""VERIFY_PROCEDURE""), "" VERIFY_IMAGE="", F$ENVIRONMENT(""VERIFY_IMAGE"")"
$ WRITE EXOF "$ WRITE SYS$OUTPUT ""F$VERIFY="", F$VERIFY()"
$ WRITE EXOF "$ SET VERIFY"
$ WRITE EXOF "$ WRITE SYS$OUTPUT ""EXONLY AFTER SET VERIFY"""
$ WRITE EXOF "$ WRITE SYS$OUTPUT ""PROCEDURE="", F$ENVIRONMENT(""PROCEDURE"")"
$ WRITE EXOF "$ EXONLY_SYMBOL == ""SET BY EXONLY"""
$ WRITE EXOF "$ WRITE SYS$OUTPUT ""EXONLY LAST LINE"""
$ WRITE EXOF "$ EXIT 1"
$ CLOSE EXOF
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:E,O:RWED,G:E,W:E) PROT93$DISK:[SEC93.EXO]EXONLY.COM
$ OPEN/WRITE EXOF PROT93$DISK:[SEC93.EXO]EXNEST.COM
$ WRITE EXOF "$ WRITE SYS$OUTPUT ""EXNEST LINE 1 RAN"""
$ WRITE EXOF "$ @PROT93$DISK:[SEC93.EXO]EXONLY"
$ WRITE EXOF "$ WRITE SYS$OUTPUT ""EXNEST AFTER EXONLY, VERIFY_PROCEDURE="", F$ENVIRONMENT(""VERIFY_PROCEDURE"")"
$ WRITE EXOF "$ @PROT93$DISK:[SEC93.EXO]EXREAD"
$ WRITE EXOF "$ WRITE SYS$OUTPUT ""EXNEST LAST LINE"""
$ CLOSE EXOF
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:E,O:RWED,G:E,W:E) PROT93$DISK:[SEC93.EXO]EXNEST.COM
$ OPEN/WRITE EXOF PROT93$DISK:[SEC93.EXO]EXREAD.COM
$ WRITE EXOF "$ WRITE SYS$OUTPUT ""EXREAD LINE 1 RAN, VERIFY_PROCEDURE="", F$ENVIRONMENT(""VERIFY_PROCEDURE"")"
$ WRITE EXOF "$ WRITE SYS$OUTPUT ""EXREAD LAST LINE"""
$ CLOSE EXOF
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:R,O:RWED,G:R,W:R) PROT93$DISK:[SEC93.EXO]EXREAD.COM
$ OPEN/WRITE EXOF PROT93$DISK:[SEC93.EXO]EXDATA.COM
$ WRITE EXOF "$ WRITE SYS$OUTPUT ""EXDATA LINE 1 RAN"""
$ WRITE EXOF "$ READ SYS$INPUT LINE"
$ WRITE EXOF "A LINE OF DATA"
$ WRITE EXOF "$ WRITE SYS$OUTPUT ""EXDATA READ: "", LINE"
$ WRITE EXOF "$ TYPE SYS$INPUT"
$ WRITE EXOF "DATA TYPED FROM AN EXECUTE-ONLY PROCEDURE"
$ WRITE EXOF "$ WRITE SYS$OUTPUT ""EXDATA LAST LINE"""
$ CLOSE EXOF
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:E,O:RWED,G:E,W:E) PROT93$DISK:[SEC93.EXO]EXDATA.COM
$ OPEN/WRITE EXOF PROT93$DISK:[SEC93.EXO]EXERR.COM
$ WRITE EXOF "$ WRITE SYS$OUTPUT ""EXERR LINE 1 RAN"""
$ WRITE EXOF "$ NOSUCHVERB"
$ WRITE EXOF "$ WRITE SYS$OUTPUT ""EXERR NOT REACHED"""
$ CLOSE EXOF
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:E,O:RWED,G:E,W:E) PROT93$DISK:[SEC93.EXO]EXERR.COM
$ DIRECTORY/SECURITY PROT93$DISK:[SEC93...]*.*;*
$ !
$ WRITE SYS$OUTPUT "######## PROGRAM, ALL PRIVILEGES"
$ WRITE SYS$OUTPUT "READALL=", F$PRIVILEGE("READALL"), " GRPPRV=", F$PRIVILEGE("GRPPRV"), " SYSPRV=", F$PRIVILEGE("SYSPRV"), " BYPASS=", F$PRIVILEGE("BYPASS")
$ DEFINE SEC93_PART "PFCKHGSDQ"
$ RUN PROT93$DISK:[SEC93]SEC93
$ SHOW SYMBOL $STATUS
$ DEASSIGN SEC93_PART
$ !
$ WRITE SYS$OUTPUT "######## PROGRAM, NO PRIVILEGES"
$ SET PROCESS/PRIVILEGES=(NOREADALL,NOGRPPRV,NOSYSPRV,NOBYPASS)
$ WRITE SYS$OUTPUT "READALL=", F$PRIVILEGE("READALL"), " GRPPRV=", F$PRIVILEGE("GRPPRV"), " SYSPRV=", F$PRIVILEGE("SYSPRV"), " BYPASS=", F$PRIVILEGE("BYPASS")
$ DEFINE SEC93_PART "QM"
$ RUN PROT93$DISK:[SEC93]SEC93
$ SHOW SYMBOL $STATUS
$ DEASSIGN SEC93_PART
$ SET PROCESS/PRIVILEGES=(READALL,GRPPRV,SYSPRV,BYPASS)
$ WRITE SYS$OUTPUT "READALL=", F$PRIVILEGE("READALL"), " GRPPRV=", F$PRIVILEGE("GRPPRV"), " SYSPRV=", F$PRIVILEGE("SYSPRV"), " BYPASS=", F$PRIVILEGE("BYPASS")
$ !
$ WRITE SYS$OUTPUT "######## THE TREE AFTER"
$ DIRECTORY/SECURITY PROT93$DISK:[SEC93...]*.*;*
$ SHOW PROTECTION
$ !
$ WRITE SYS$OUTPUT "######## EXECUTE-ONLY PROCEDURES AS SYSTEM"
$ @PROT93$DISK:[SEC93.EXO]EXONLY
$ SET VERIFY
$ SHOW SYMBOL EXONLY_SYMBOL
$ !
$ WRITE SYS$OUTPUT "######## MACROS ROUND 9"
$ SET DEFAULT PROT93$DISK:[SEC93MAC]
$ @MACROS9/OUTPUT=MACROS9.LOG
$ SET VERIFY
$ DIRECTORY PROT93$DISK:[SEC93MAC]*.OBJ,*.ANL
$ SET DEFAULT 'HOME'
$ !
$ WRITE SYS$OUTPUT "######## END"
$ WRITE SYS$OUTPUT "SEC93 FINISHED"
$ SET NOVERIFY
$ EXIT
