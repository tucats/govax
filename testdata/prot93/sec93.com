$ ! SEC93.COM - Phase 93's probe, round 3: SYSTEM's run. Run it as SYSTEM, with the round 3 volume mounted /SYSTEM:
$ !
$ !     @DUA1:[000000]SEC93
$ !
$ ! Its log is PROT93$DISK:[PROT93LOG]SEC93.LOG.
$ ! Written by testdata/prot93/gen3.go (README.md's "Round 3").
$ !
$ IF P1 .EQS. "LOGGED" THEN GOTO BEGIN
$ HERE = F$ENVIRONMENT("PROCEDURE")
$ DEV = F$PARSE(HERE,,,"DEVICE")
$ DEFINE/SYSTEM/EXECUTIVE_MODE PROT93$DISK 'DEV'
$ LOGFILE = DEV + "[PROT93LOG]" + "SEC93.LOG"
$ @'HERE'/OUTPUT='LOGFILE' LOGGED
$ WRITE SYS$OUTPUT "SEC93 finished; the log is ", LOGFILE
$ EXIT
$ BEGIN:
$ SET NOON
$ SET VERIFY
$ !
$ WRITE SYS$OUTPUT "######## ENVIRONMENT"
$ WRITE SYS$OUTPUT F$GETSYI("VERSION"), " ", F$GETSYI("HW_NAME"), " ", F$GETSYI("NODENAME")
$ SHOW LOGICAL PROT93$DISK
$ WRITE SYS$OUTPUT F$GETJPI("","USERNAME"), " ", F$GETJPI("","UIC")
$ SHOW PROCESS/PRIVILEGES
$ SHOW PROTECTION
$ SAVED_PROTECTION = F$ENVIRONMENT("PROTECTION")
$ !
$ WRITE SYS$OUTPUT "######## ACCOUNTS"
$ HOME = F$ENVIRONMENT("DEFAULT")
$ SET DEFAULT SYS$SYSTEM
$ RUN SYS$SYSTEM:AUTHORIZE
ADD PROT93A/UIC=[200,1]/PASSWORD=PROT93PW/NOPWDEXPIRED/PWDLIFETIME=NONE/FLAGS=NODISUSER/DEVICE=PROT93$DISK:/DIRECTORY=[PROT93LOG]/PRIVILEGES=(TMPMBX,NETMBX)/DEFPRIVILEGES=(TMPMBX,NETMBX)/ACCOUNT=PROT93/OWNER="PHASE 93 PROBE"
ADD PROT93B/UIC=[200,2]/PASSWORD=PROT93PW/NOPWDEXPIRED/PWDLIFETIME=NONE/FLAGS=NODISUSER/DEVICE=PROT93$DISK:/DIRECTORY=[PROT93LOG]/PRIVILEGES=(TMPMBX,NETMBX,READALL,GRPPRV,SYSPRV,BYPASS)/DEFPRIVILEGES=(TMPMBX,NETMBX)/ACCOUNT=PROT93/OWNER="PHASE 93 PROBE"
ADD PROT93C/UIC=[300,1]/PASSWORD=PROT93PW/NOPWDEXPIRED/PWDLIFETIME=NONE/FLAGS=NODISUSER/DEVICE=PROT93$DISK:/DIRECTORY=[PROT93LOG]/PRIVILEGES=(TMPMBX,NETMBX,READALL,GRPPRV,SYSPRV,BYPASS)/DEFPRIVILEGES=(TMPMBX,NETMBX)/ACCOUNT=PROT93/OWNER="PHASE 93 PROBE"
ADD/IDENTIFIER PROT93_TEAM/VALUE=IDENTIFIER=65537
GRANT/IDENTIFIER PROT93_TEAM PROT93C
SHOW/IDENTIFIER/FULL PROT93
SHOW/IDENTIFIER/FULL PROT93_TEAM
SHOW PROT93A/BRIEF
SHOW PROT93B/BRIEF
SHOW PROT93C/BRIEF
EXIT
$ SET DEFAULT 'HOME'
$ WRITE SYS$OUTPUT F$IDENTIFIER("PROT93_TEAM","NAME_TO_NUMBER")
$ WRITE SYS$OUTPUT F$IDENTIFIER("PROT93","NAME_TO_NUMBER")
$ !
$ WRITE SYS$OUTPUT "######## BUILD"
$ SET DEFAULT PROT93$DISK:[SEC93]
$ MACRO/LIST=PROT93$DISK:[SEC93]SEC93.LIS/OBJECT=PROT93$DISK:[SEC93]SEC93.OBJ PROT93$DISK:[000000]SEC93
$ LINK/MAP=PROT93$DISK:[SEC93]SEC93.MAP/FULL SEC93
$ SET SECURITY/PROTECTION=(S:RWED,O:RWED,G:RE,W:RE) PROT93$DISK:[SEC93]SEC93.EXE
$ SHOW SECURITY PROT93$DISK:[SEC93]SEC93.EXE
$ SEARCH PROT93$DISK:[SEC93]SEC93.MAP SECURESHR,SYS$PARSE_ACL,SYS$FORMAT_ACL,SYS$CHANGE_ACL,SYS$CHECK_ACCESS,SYS$CHKPRO,SYS$GET_SECURITY,SYS$SET_SECURITY,SYS$SETDFPROT
$ SET DEFAULT 'HOME'
$ !
$ WRITE SYS$OUTPUT "######## VOLUME"
