$ ! SEC93Y.COM - Phase 93's probe, round 3: the end. Run it as SYSTEM after PROT93C's run:
$ !
$ !     @PROT93$DISK:[000000]SEC93Y
$ !
$ ! Its log is PROT93$DISK:[PROT93LOG]SEC93Y.LOG.
$ ! Written by testdata/prot93/gen3.go (README.md's "Round 3").
$ !
$ IF P1 .EQS. "LOGGED" THEN GOTO BEGIN
$ HERE = F$ENVIRONMENT("PROCEDURE")
$ DEV = F$PARSE(HERE,,,"DEVICE")
$ LOGFILE = DEV + "[PROT93LOG]" + "SEC93Y.LOG"
$ @'HERE'/OUTPUT='LOGFILE' LOGGED 'P1'
$ WRITE SYS$OUTPUT "SEC93Y finished; the log is ", LOGFILE
$ EXIT
$ BEGIN:
$ SET NOON
$ SET VERIFY
$ !
$ WRITE SYS$OUTPUT "######## THE TREE"
$ DIRECTORY/SECURITY PROT93$DISK:[SEC93...]*.*;*
$ !
$ WRITE SYS$OUTPUT "######## REMOVING THE ACCOUNTS"
$ HOME = F$ENVIRONMENT("DEFAULT")
$ SET DEFAULT SYS$SYSTEM
$ RUN SYS$SYSTEM:AUTHORIZE
REMOVE PROT93A
REMOVE PROT93B
REMOVE PROT93C
REMOVE/IDENTIFIER PROT93_TEAM
REMOVE/IDENTIFIER PROT93
EXIT
$ SET DEFAULT 'HOME'
$ WRITE SYS$OUTPUT "SEC93Y FINISHED"
$ DEASSIGN/SYSTEM/EXECUTIVE_MODE PROT93$DISK
$ SET NOVERIFY
$ EXIT
