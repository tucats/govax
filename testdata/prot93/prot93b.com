$ ! PROT93B.COM - Phase 93's probe: DCL's utilities and file protection.
$ ! Written by testdata/prot93/gen.go; run by PROT93.COM and PROT93U.COM,
$ ! with P1 the tag of the identity's own files (M0, A0, B0, C0).
$ SET NOON
$ T = P1
$ U = "PROT93$DISK:[PROT93.U]"
$ OT = "PROT93$DISK:[PROT93LOG]" + T + "_"
$ IMG = "PROT93$DISK:[PROT93.IMG]"
$ HOME = F$ENVIRONMENT("DEFAULT")
$ !
$ WRITE SYS$OUTPUT "######## UTILITIES ON UNONE.DAT"
$ TYPE 'U'UNONE.DAT
$ COPY 'U'UNONE.DAT 'OT'UNONE.TMP
$ DUMP/RECORD 'U'UNONE.DAT
$ DUMP/HEADER/BLOCKS=COUNT=0 'U'UNONE.DAT
$ SEARCH 'U'UNONE.DAT RECORD
$ DIFFERENCES 'U'UNONE.DAT 'U'UWLD.DAT
$ OPEN/READ FU 'U'UNONE.DAT
$ READ FU REC
$ SHOW SYMBOL REC
$ CLOSE FU
$ WRITE SYS$OUTPUT F$FILE_ATTRIBUTES("''U'UNONE.DAT","EOF")
$ WRITE SYS$OUTPUT F$FILE_ATTRIBUTES("''U'UNONE.DAT","PRO")
$ WRITE SYS$OUTPUT F$SEARCH("''U'UNONE.DAT")
$ DIRECTORY 'U'UNONE.DAT
$ DIRECTORY/FULL 'U'UNONE.DAT
$ DIRECTORY/SECURITY 'U'UNONE.DAT
$ SHOW SECURITY 'U'UNONE.DAT
$ ANALYZE/RMS_FILE/OUTPUT=NL: 'U'UNONE.DAT
$ CONVERT 'U'UNONE.DAT 'OT'UNONE.CNV
$ BACKUP 'U'UNONE.DAT 'OT'UNONE.BCK/SAVE_SET
$ MACRO/NOLIST/OBJECT='OT'MNONE.OBJ 'U'UMACNONE.MAR
$ LINK/NOMAP/EXECUTABLE='OT'LNONE.EXE 'U'ULNKNONE.OBJ
$ LIBRARY/LIST 'U'ULIBNONE.OLB
$ !
$ WRITE SYS$OUTPUT "######## CHANGES TO NONE FILES"
$ DELETE 'U'DEL_NONE_'T'.DAT;*
$ PURGE 'U'PUR_NONE_'T'.DAT
$ RENAME 'U'REN_NONE_'T'.DAT 'U'REN2_NONE_'T'.DAT
$ APPEND 'U'UWLD.DAT 'U'APP_NONE_'T'.DAT
$ COPY 'U'UWLD.DAT 'U'CPY_NONE_'T'.DAT
$ OPEN/WRITE FU 'U'OPW_NONE_'T'.DAT
$ WRITE FU "WRITTEN"
$ CLOSE FU
$ OPEN/APPEND FU 'U'OPA_NONE_'T'.DAT
$ WRITE FU "APPENDED"
$ CLOSE FU
$ SET SECURITY/PROTECTION=(W:R) 'U'SEC_NONE_'T'.DAT
$ SET FILE/PROTECTION=(W:R) 'U'SFI_NONE_'T'.DAT
$ SET PROTECTION=(W:R) 'U'SPR_NONE_'T'.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93C,ACCESS=READ) 'U'ACL_NONE_'T'.DAT
$ SET SECURITY/OWNER=[200,2] 'U'OWN_NONE_'T'.DAT
$ DIRECTORY/SECURITY 'U'*_NONE_'T'.*;*
$ !
$ WRITE SYS$OUTPUT "######## UTILITIES ON UGRP.DAT"
$ TYPE 'U'UGRP.DAT
$ COPY 'U'UGRP.DAT 'OT'UGRP.TMP
$ DUMP/RECORD 'U'UGRP.DAT
$ DUMP/HEADER/BLOCKS=COUNT=0 'U'UGRP.DAT
$ SEARCH 'U'UGRP.DAT RECORD
$ DIFFERENCES 'U'UGRP.DAT 'U'UWLD.DAT
$ OPEN/READ FU 'U'UGRP.DAT
$ READ FU REC
$ SHOW SYMBOL REC
$ CLOSE FU
$ WRITE SYS$OUTPUT F$FILE_ATTRIBUTES("''U'UGRP.DAT","EOF")
$ WRITE SYS$OUTPUT F$FILE_ATTRIBUTES("''U'UGRP.DAT","PRO")
$ WRITE SYS$OUTPUT F$SEARCH("''U'UGRP.DAT")
$ DIRECTORY 'U'UGRP.DAT
$ DIRECTORY/FULL 'U'UGRP.DAT
$ DIRECTORY/SECURITY 'U'UGRP.DAT
$ SHOW SECURITY 'U'UGRP.DAT
$ ANALYZE/RMS_FILE/OUTPUT=NL: 'U'UGRP.DAT
$ CONVERT 'U'UGRP.DAT 'OT'UGRP.CNV
$ BACKUP 'U'UGRP.DAT 'OT'UGRP.BCK/SAVE_SET
$ MACRO/NOLIST/OBJECT='OT'MGRP.OBJ 'U'UMACGRP.MAR
$ LINK/NOMAP/EXECUTABLE='OT'LGRP.EXE 'U'ULNKGRP.OBJ
$ LIBRARY/LIST 'U'ULIBGRP.OLB
$ !
$ WRITE SYS$OUTPUT "######## CHANGES TO GRP FILES"
$ DELETE 'U'DEL_GRP_'T'.DAT;*
$ PURGE 'U'PUR_GRP_'T'.DAT
$ RENAME 'U'REN_GRP_'T'.DAT 'U'REN2_GRP_'T'.DAT
$ APPEND 'U'UWLD.DAT 'U'APP_GRP_'T'.DAT
$ COPY 'U'UWLD.DAT 'U'CPY_GRP_'T'.DAT
$ OPEN/WRITE FU 'U'OPW_GRP_'T'.DAT
$ WRITE FU "WRITTEN"
$ CLOSE FU
$ OPEN/APPEND FU 'U'OPA_GRP_'T'.DAT
$ WRITE FU "APPENDED"
$ CLOSE FU
$ SET SECURITY/PROTECTION=(W:R) 'U'SEC_GRP_'T'.DAT
$ SET FILE/PROTECTION=(W:R) 'U'SFI_GRP_'T'.DAT
$ SET PROTECTION=(W:R) 'U'SPR_GRP_'T'.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93C,ACCESS=READ) 'U'ACL_GRP_'T'.DAT
$ SET SECURITY/OWNER=[200,2] 'U'OWN_GRP_'T'.DAT
$ DIRECTORY/SECURITY 'U'*_GRP_'T'.*;*
$ !
$ WRITE SYS$OUTPUT "######## UTILITIES ON UWLD.DAT"
$ TYPE 'U'UWLD.DAT
$ COPY 'U'UWLD.DAT 'OT'UWLD.TMP
$ DUMP/RECORD 'U'UWLD.DAT
$ DUMP/HEADER/BLOCKS=COUNT=0 'U'UWLD.DAT
$ SEARCH 'U'UWLD.DAT RECORD
$ DIFFERENCES 'U'UWLD.DAT 'U'UWLD.DAT
$ OPEN/READ FU 'U'UWLD.DAT
$ READ FU REC
$ SHOW SYMBOL REC
$ CLOSE FU
$ WRITE SYS$OUTPUT F$FILE_ATTRIBUTES("''U'UWLD.DAT","EOF")
$ WRITE SYS$OUTPUT F$FILE_ATTRIBUTES("''U'UWLD.DAT","PRO")
$ WRITE SYS$OUTPUT F$SEARCH("''U'UWLD.DAT")
$ DIRECTORY 'U'UWLD.DAT
$ DIRECTORY/FULL 'U'UWLD.DAT
$ DIRECTORY/SECURITY 'U'UWLD.DAT
$ SHOW SECURITY 'U'UWLD.DAT
$ ANALYZE/RMS_FILE/OUTPUT=NL: 'U'UWLD.DAT
$ CONVERT 'U'UWLD.DAT 'OT'UWLD.CNV
$ BACKUP 'U'UWLD.DAT 'OT'UWLD.BCK/SAVE_SET
$ MACRO/NOLIST/OBJECT='OT'MWLD.OBJ 'U'UMACWLD.MAR
$ LINK/NOMAP/EXECUTABLE='OT'LWLD.EXE 'U'ULNKWLD.OBJ
$ LIBRARY/LIST 'U'ULIBWLD.OLB
$ !
$ WRITE SYS$OUTPUT "######## CHANGES TO WLD FILES"
$ DELETE 'U'DEL_WLD_'T'.DAT;*
$ PURGE 'U'PUR_WLD_'T'.DAT
$ RENAME 'U'REN_WLD_'T'.DAT 'U'REN2_WLD_'T'.DAT
$ APPEND 'U'UWLD.DAT 'U'APP_WLD_'T'.DAT
$ COPY 'U'UWLD.DAT 'U'CPY_WLD_'T'.DAT
$ OPEN/WRITE FU 'U'OPW_WLD_'T'.DAT
$ WRITE FU "WRITTEN"
$ CLOSE FU
$ OPEN/APPEND FU 'U'OPA_WLD_'T'.DAT
$ WRITE FU "APPENDED"
$ CLOSE FU
$ SET SECURITY/PROTECTION=(W:R) 'U'SEC_WLD_'T'.DAT
$ SET FILE/PROTECTION=(W:R) 'U'SFI_WLD_'T'.DAT
$ SET PROTECTION=(W:R) 'U'SPR_WLD_'T'.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93C,ACCESS=READ) 'U'ACL_WLD_'T'.DAT
$ SET SECURITY/OWNER=[200,2] 'U'OWN_WLD_'T'.DAT
$ DIRECTORY/SECURITY 'U'*_WLD_'T'.*;*
$ !
$ WRITE SYS$OUTPUT "######## DIRECTORIES"
$ DIRECTORY PROT93$DISK:[PROT93.UDN]
$ DIRECTORY PROT93$DISK:[PROT93.UDN]A.DAT
$ TYPE PROT93$DISK:[PROT93.UDN]A.DAT
$ COPY 'U'UWLD.DAT PROT93$DISK:[PROT93.UDN]N_'T'.DAT
$ CREATE/DIRECTORY PROT93$DISK:[PROT93.UDN.S'T']
$ DIRECTORY PROT93$DISK:[PROT93.UDE]
$ DIRECTORY PROT93$DISK:[PROT93.UDE]*.DAT
$ DIRECTORY PROT93$DISK:[PROT93.UDE]A.DAT
$ DIRECTORY/FULL PROT93$DISK:[PROT93.UDE]A.DAT
$ TYPE PROT93$DISK:[PROT93.UDE]A.DAT
$ WRITE SYS$OUTPUT F$SEARCH("PROT93$DISK:[PROT93.UDE]*.DAT")
$ WRITE SYS$OUTPUT F$SEARCH("PROT93$DISK:[PROT93.UDE]A.DAT")
$ WRITE SYS$OUTPUT F$PARSE("PROT93$DISK:[PROT93.UDN]A.DAT")
$ DELETE PROT93$DISK:[PROT93.UDNW]DLW_'T'.DAT;*
$ CREATE PROT93$DISK:[PROT93.UDNW]CR_'T'.DAT
$ SET DEFAULT PROT93$DISK:[PROT93.UDN]
$ SHOW DEFAULT
$ DIRECTORY
$ SET DEFAULT 'HOME'
$ !
$ WRITE SYS$OUTPUT "######## IMAGES AND PROCEDURES"
$ RUN 'IMG'HELLOE.EXE
$ SHOW SYMBOL $STATUS
$ @'IMG'PROCE.COM
$ SHOW SYMBOL $STATUS
$ RUN 'IMG'HELLOR.EXE
$ SHOW SYMBOL $STATUS
$ @'IMG'PROCR.COM
$ SHOW SYMBOL $STATUS
$ RUN 'IMG'HELLON.EXE
$ SHOW SYMBOL $STATUS
$ @'IMG'PROCN.COM
$ SHOW SYMBOL $STATUS
$ SET DEFAULT 'HOME'
$ EXIT
