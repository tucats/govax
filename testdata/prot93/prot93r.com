$ !
$ WRITE SYS$OUTPUT "######## OBSOLETE FORMS WITH NO VALUE"
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.SEC]SP1.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) PROT93$DISK:[PROT93.SEC]SP1.DAT
$ SET PROTECTION PROT93$DISK:[PROT93.SEC]SP1.DAT
