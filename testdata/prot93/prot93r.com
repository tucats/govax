$ ! PROT93R.COM - Phase 93's probe, round 2: SYSTEM's run.
$ ! Written by testdata/prot93/gen.go. Run it as SYSTEM, with round 1's
$ ! exchange volume mounted /SYSTEM (README.md's "Round 2"):
$ !
$ !     @DUA1:[000000]PROT93R
$ !
$ ! Its log is PROT93$DISK:[PROT93LOG]PROT93R.LOG.
$ !
$ IF P1 .EQS. "LOGGED" THEN GOTO BEGIN
$ HERE = F$ENVIRONMENT("PROCEDURE")
$ DEV = F$PARSE(HERE,,,"DEVICE")
$ DEFINE/SYSTEM/EXECUTIVE_MODE PROT93$DISK 'DEV'
$ LOGFILE = DEV + "[PROT93LOG]PROT93R.LOG"
$ @'HERE'/OUTPUT='LOGFILE' LOGGED
$ WRITE SYS$OUTPUT "PROT93R finished; the log is ", LOGFILE
$ EXIT
$ BEGIN:
$ SET NOON
$ SET VERIFY
$ !
$ WRITE SYS$OUTPUT "######## ENVIRONMENT"
$ WRITE SYS$OUTPUT F$GETSYI("VERSION"), " ", F$GETSYI("HW_NAME"), " ", F$GETSYI("NODENAME")
$ SHOW LOGICAL PROT93$DISK
$ WRITE SYS$OUTPUT F$GETJPI("","USERNAME"), " ", F$GETJPI("","UIC")
$ SHOW PROCESS/PRIVILEGES
$ SHOW PROTECTION
$ WRITE SYS$OUTPUT F$ENVIRONMENT("PROTECTION")
$ SAVED_PROTECTION = F$ENVIRONMENT("PROTECTION")
$ SHOW SECURITY/CLASS=VOLUME PROT93$DISK:
$ DIRECTORY/SECURITY PROT93$DISK:[000000]
$ !
$ WRITE SYS$OUTPUT "######## ACCOUNTS"
$ HOME = F$ENVIRONMENT("DEFAULT")
$ SET DEFAULT SYS$SYSTEM
$ RUN SYS$SYSTEM:AUTHORIZE
ADD PROT93A/UIC=[200,1]/PASSWORD=PROT93PW/NOPWDEXPIRED/PWDLIFETIME=NONE/FLAGS=NODISUSER/DEVICE=PROT93$DISK:/DIRECTORY=[PROT93LOG]/PRIVILEGES=(TMPMBX,NETMBX)/DEFPRIVILEGES=(TMPMBX,NETMBX)/ACCOUNT=PROT93/OWNER="PHASE 93 PROBE"
ADD PROT93B/UIC=[200,2]/PASSWORD=PROT93PW/NOPWDEXPIRED/PWDLIFETIME=NONE/FLAGS=NODISUSER/DEVICE=PROT93$DISK:/DIRECTORY=[PROT93LOG]/PRIVILEGES=(TMPMBX,NETMBX,READALL,GRPPRV,SYSPRV,BYPASS)/DEFPRIVILEGES=(TMPMBX,NETMBX)/ACCOUNT=PROT93/OWNER="PHASE 93 PROBE"
ADD PROT93C/UIC=[300,1]/PASSWORD=PROT93PW/NOPWDEXPIRED/PWDLIFETIME=NONE/FLAGS=NODISUSER/DEVICE=PROT93$DISK:/DIRECTORY=[PROT93LOG]/PRIVILEGES=(TMPMBX,NETMBX,READALL,GRPPRV,SYSPRV,BYPASS)/DEFPRIVILEGES=(TMPMBX,NETMBX)/ACCOUNT=PROT93/OWNER="PHASE 93 PROBE"
ADD/IDENTIFIER PROT93_TEAM/VALUE=IDENTIFIER=65537
GRANT/IDENTIFIER PROT93_TEAM PROT93C
SHOW/IDENTIFIER/FULL PROT93
SHOW/IDENTIFIER/FULL PROT93_TEAM
EXIT
$ SET DEFAULT 'HOME'
$ WRITE SYS$OUTPUT F$IDENTIFIER("PROT93_TEAM","NAME_TO_NUMBER")
$ !
$ WRITE SYS$OUTPUT "######## IMAGES"
$ ! Round 1 named both images in one SET SECURITY, which 7.1 refuses.
$ SET SECURITY/PROTECTION=(S:RWED,O:RWED,G:RE,W:RE) PROT93$DISK:[000000]PROT93.EXE
$ SHOW SECURITY PROT93$DISK:[000000]PROT93.EXE
$ SET SECURITY/PROTECTION=(S:RWED,O:RWED,G:RE,W:RE) PROT93$DISK:[000000]HELLO.EXE
$ SHOW SECURITY PROT93$DISK:[000000]HELLO.EXE
$ !
$ WRITE SYS$OUTPUT "######## ROUND 2 TREE"
$ ! FACLCTL as round 1 made it: its owner and PROT93C changed it in Part B.
$ SET SECURITY/PROTECTION=(S,O,G,W) PROT93$DISK:[PROT93.F]FACLCTL.DAT
$ CREATE/DIRECTORY PROT93$DISK:[PROT93.DRWO]
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.DRWO]A.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) PROT93$DISK:[PROT93.DRWO]A.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RW,O:RW,G:RW,W:RW) PROT93$DISK:[PROT93]DRWO.DIR
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.DW]E2_M0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) PROT93$DISK:[PROT93.DW]E2_M0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.DW]N2_M0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) PROT93$DISK:[PROT93.DW]N2_M0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.DRWO]E3_M0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) PROT93$DISK:[PROT93.DRWO]E3_M0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.DRWO]N3_M0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) PROT93$DISK:[PROT93.DRWO]N3_M0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.NV]NP_M0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) PROT93$DISK:[PROT93.NV]NP_M0.DAT
$ SET SECURITY/ACL=((IDENTIFIER=PROT93A,OPTIONS=NOPROPAGATE,ACCESS=READ),(IDENTIFIER=PROT93_TEAM,ACCESS=READ),(IDENTIFIER=PROT93B,OPTIONS=PROTECTED+NOPROPAGATE,ACCESS=READ)) PROT93$DISK:[PROT93.NV]NP_M0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.NV]SUPD_M0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RD,O:RD,G:RD,W:RD) PROT93$DISK:[PROT93.NV]SUPD_M0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.NV]SUPW_M0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) PROT93$DISK:[PROT93.NV]SUPW_M0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.NV]NVR_M0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:R,O:R,G:R,W:R) PROT93$DISK:[PROT93.NV]NVR_M0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.CTL]OS_M0.DAT
$ SET SECURITY/OWNER=[1,4]/PROTECTION=(S:RWED,O:RWED,G:RE,W:RE) PROT93$DISK:[PROT93.CTL]OS_M0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.CTL]OT_M0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RE,W:RE) PROT93$DISK:[PROT93.CTL]OT_M0.DAT
$ SET SECURITY/ACL=(IDENTIFIER=SYSTEM,ACCESS=CONTROL) PROT93$DISK:[PROT93.CTL]OT_M0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.DW]E2_A0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) PROT93$DISK:[PROT93.DW]E2_A0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.DW]N2_A0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) PROT93$DISK:[PROT93.DW]N2_A0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.DRWO]E3_A0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) PROT93$DISK:[PROT93.DRWO]E3_A0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.DRWO]N3_A0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) PROT93$DISK:[PROT93.DRWO]N3_A0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.NV]NP_A0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) PROT93$DISK:[PROT93.NV]NP_A0.DAT
$ SET SECURITY/ACL=((IDENTIFIER=PROT93A,OPTIONS=NOPROPAGATE,ACCESS=READ),(IDENTIFIER=PROT93_TEAM,ACCESS=READ),(IDENTIFIER=PROT93B,OPTIONS=PROTECTED+NOPROPAGATE,ACCESS=READ)) PROT93$DISK:[PROT93.NV]NP_A0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.NV]SUPD_A0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RD,O:RD,G:RD,W:RD) PROT93$DISK:[PROT93.NV]SUPD_A0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.NV]SUPW_A0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) PROT93$DISK:[PROT93.NV]SUPW_A0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.NV]NVR_A0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:R,O:R,G:R,W:R) PROT93$DISK:[PROT93.NV]NVR_A0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.CTL]OS_A0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RE,W:RE) PROT93$DISK:[PROT93.CTL]OS_A0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.CTL]OT_A0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RE,W:RE) PROT93$DISK:[PROT93.CTL]OT_A0.DAT
