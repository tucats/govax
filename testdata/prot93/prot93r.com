$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.DW]E2_B0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) PROT93$DISK:[PROT93.DW]E2_B0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.DW]N2_B0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) PROT93$DISK:[PROT93.DW]N2_B0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.DRWO]E3_B0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) PROT93$DISK:[PROT93.DRWO]E3_B0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.DRWO]N3_B0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) PROT93$DISK:[PROT93.DRWO]N3_B0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.NV]NP_B0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) PROT93$DISK:[PROT93.NV]NP_B0.DAT
$ SET SECURITY/ACL=((IDENTIFIER=PROT93A,OPTIONS=NOPROPAGATE,ACCESS=READ),(IDENTIFIER=PROT93_TEAM,ACCESS=READ),(IDENTIFIER=PROT93B,OPTIONS=PROTECTED+NOPROPAGATE,ACCESS=READ)) PROT93$DISK:[PROT93.NV]NP_B0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.NV]SUPD_B0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RD,O:RD,G:RD,W:RD) PROT93$DISK:[PROT93.NV]SUPD_B0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.NV]SUPW_B0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) PROT93$DISK:[PROT93.NV]SUPW_B0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.NV]NVR_B0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:R,O:R,G:R,W:R) PROT93$DISK:[PROT93.NV]NVR_B0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.CTL]OS_B0.DAT
$ SET SECURITY/OWNER=[200,2]/PROTECTION=(S:RWED,O:RWED,G:RE,W:RE) PROT93$DISK:[PROT93.CTL]OS_B0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.CTL]OT_B0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RE,W:RE) PROT93$DISK:[PROT93.CTL]OT_B0.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93B,ACCESS=CONTROL) PROT93$DISK:[PROT93.CTL]OT_B0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.DW]E2_C0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) PROT93$DISK:[PROT93.DW]E2_C0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.DW]N2_C0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) PROT93$DISK:[PROT93.DW]N2_C0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.DRWO]E3_C0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) PROT93$DISK:[PROT93.DRWO]E3_C0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.DRWO]N3_C0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) PROT93$DISK:[PROT93.DRWO]N3_C0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.NV]NP_C0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) PROT93$DISK:[PROT93.NV]NP_C0.DAT
$ SET SECURITY/ACL=((IDENTIFIER=PROT93A,OPTIONS=NOPROPAGATE,ACCESS=READ),(IDENTIFIER=PROT93_TEAM,ACCESS=READ),(IDENTIFIER=PROT93B,OPTIONS=PROTECTED+NOPROPAGATE,ACCESS=READ)) PROT93$DISK:[PROT93.NV]NP_C0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.NV]SUPD_C0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RD,O:RD,G:RD,W:RD) PROT93$DISK:[PROT93.NV]SUPD_C0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.NV]SUPW_C0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWED,O:RWED,G:RWED,W:RWED) PROT93$DISK:[PROT93.NV]SUPW_C0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.NV]NVR_C0.DAT
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:R,O:R,G:R,W:R) PROT93$DISK:[PROT93.NV]NVR_C0.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.CTL]OS_C0.DAT
$ SET SECURITY/OWNER=[300,1]/PROTECTION=(S:RWED,O:RWED,G:RE,W:RE) PROT93$DISK:[PROT93.CTL]OS_C0.DAT
