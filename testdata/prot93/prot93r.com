$ SET SECURITY/ACL=(IDENTIFIER=PROT93C,ACCESS=CONTROL) PROT93$DISK:[PROT93.CTL]OT_C0.DAT
$ OPEN/WRITE PF PROT93$DISK:[PROT93.IMG]PRO2E.COM
$ WRITE PF "$ WRITE SYS$OUTPUT ""PRO2E RAN"""
$ CLOSE PF
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:E,O:RWED,G:E,W:E) PROT93$DISK:[PROT93.IMG]PRO2E.COM
$ OPEN/WRITE PF PROT93$DISK:[PROT93.IMG]PRO2R.COM
$ WRITE PF "$ WRITE SYS$OUTPUT ""PRO2R RAN"""
