$ CREATE/DIRECTORY PROT93$DISK:[PROT93.SEC.SD1]
$ SET SECURITY/OWNER=[200,1]/PROTECTION=(S:RWE,O:RWE,G:E,W) PROT93$DISK:[PROT93.SEC]SD1.DIR
$ SET SECURITY/DEFAULT PROT93$DISK:[PROT93.SEC]SD1.DIR
$ SHOW SECURITY PROT93$DISK:[PROT93.SEC]SD1.DIR
$ SHOW SECURITY PROT93$DISK:[PROT93.ACE]L2.DAT
$ !
$ WRITE SYS$OUTPUT "######## PROGRAM AS SYSTEM"
$ SET PROCESS/PRIVILEGES=(NOREADALL,NOGRPPRV,NOSYSPRV,NOBYPASS)
$ WRITE SYS$OUTPUT "READALL=", F$PRIVILEGE("READALL"), " GRPPRV=", F$PRIVILEGE("GRPPRV"), " SYSPRV=", F$PRIVILEGE("SYSPRV"), " BYPASS=", F$PRIVILEGE("BYPASS")
$ DEFINE PROT93_TAG M0
$ DEFINE/USER_MODE SYS$INPUT PROT93$DISK:[000000]PROT93F.DAT
$ RUN PROT93$DISK:[000000]PROT93
$ SHOW SYMBOL $STATUS
$ DEFINE PROT93_TAG M0
