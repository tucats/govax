	.TITLE	SEC93	Phase 93's security services probe
	.IDENT	/V1.0/
;
; Written by testdata/prot93/gen3.go: do not edit. Round 3 of Phase 93's
; probe (docs/planning/PHASE-93 - file protection.md): calls the security
; services case by case, each case a routine of its own under HANDLER,
; and prints what each returned. SEC93_PART names the parts to run, a
; letter each (all of them if it isn't defined):
;
;	P $PARSE_ACL	F $FORMAT_ACL	C $CHANGE_ACL	K $CHKPRO
;	H $CHECK_ACCESS	G $GET_SECURITY	S $SET_SECURITY	D $SETDFPROT
;	Q $CHKPRO with the caller's own rights and privileges
;	M SYSTEM's cases without privileges	U PROT93C's cases
;
	$SSDEF
	$LNMDEF
	$FABDEF
	$XABDEF
	$XABPRODEF

; SAY text, a1, ... a10: format text with $FAOL and the arguments (each
; a longword, pushed by value) and write the line.
	.MACRO	SAY	TEXT,A1,A2,A3,A4,A5,A6,A7,A8,A9,A10,?LBL,?OVER
	BRW	OVER
LBL:	.ASCID	TEXT
OVER:
	$$N = 1
	.IRP	ARG,<A10,A9,A8,A7,A6,A5,A4,A3,A2,A1>
	.IF	NOT_BLANK,<ARG>
	PUSHL	ARG
	$$N = $$N + 1
	.ENDC
	.ENDR
	PUSHAQ	LBL
	CALLS	#$$N,SAYR
	.ENDM	SAY

; RMS service, fab: an RMS service with no completion routines.
	.MACRO	RMS	SERVICE,FAB
	CLRQ	-(SP)
	PUSHAB	FAB
	CALLS	#3,G^SYS$'SERVICE
	.ENDM	RMS

; Values from round 1 (testdata/prot93/defined.txt).
ACL$C_ACLLENGTH = ^X8
ACL$C_ADDACLENT = ^X1
ACL$C_DELACLENT = ^X2
ACL$C_DELETEACL = ^X6
ACL$C_DELETE_ALL = ^XF
ACL$C_DEVICE = ^X2
ACL$C_FILE = ^X1
ACL$C_FNDACETYP = ^X5
ACL$C_FNDACLENT = ^X4
ACL$C_GRANT_ACE = ^XD
ACL$C_MODACLENT = ^X3
ACL$C_NEXT_ACE = ^XE
ACL$C_READACE = ^X9
ACL$C_READACL = ^X7
ACL$C_RLOCK_ACL = ^XA
ACL$C_UNLOCK_ACL = ^XC
ACL$C_WLOCK_ACL = ^XB
CHP$_ACCESS = ^X1
CHP$_ACL = ^XE
CHP$_ACMODE = ^X4
CHP$_ADDRIGHTS = ^X7
CHP$_ALARMNAME = ^X10
CHP$_AUDITNAME = ^XF
CHP$_FLAGS = ^X2
CHP$_MATCHEDACE = ^X11
CHP$_MATCHED_ACE = ^X11
CHP$_MODE = ^X8
CHP$_MODES = ^X9
CHP$_OWNER = ^XC
CHP$_PRIV = ^X3
CHP$_PRIVUSED = ^X12
CHP$_PROT = ^XD
CHP$_RIGHTS = ^X6
CHP$_UIC = ^X16
OSS$M_LOCAL = ^X4
OSS$M_RELCTX = ^X2
OSS$M_WLOCK = ^X1
OSS$_ACCESS_CLASS_NAME = ^X1F
OSS$_ACCESS_NAMES = ^X1
OSS$_ACCESS_NAMES_LENGTH = ^X2
OSS$_ACL_ADD_ENTRY = ^X3
OSS$_ACL_DELETE = ^X5
OSS$_ACL_DELETE_ALL = ^X6
OSS$_ACL_DELETE_ENTRY = ^X4
OSS$_ACL_FIND_ENTRY = ^X7
OSS$_ACL_FIND_NEXT = ^X8
OSS$_ACL_FIND_TYPE = ^X9
OSS$_ACL_GRANT_ACE = ^XA
OSS$_ACL_LENGTH = ^XB
OSS$_ACL_MODIFY_ENTRY = ^XC
OSS$_ACL_POSITION_BOTTOM = ^XF
OSS$_ACL_POSITION_TOP = ^XE
OSS$_ACL_READ = ^X11
OSS$_ACL_READ_ENTRY = ^X10
OSS$_CLASS_NAME = ^X1B
OSS$_DAMAGED_ACL = ^X20
OSS$_FIRST_TEMPLATE = ^X1C
OSS$_GRP_PROT = ^X19
OSS$_IN_TRANSITION = ^X21
OSS$_NEXT_OBJECT = ^X14
OSS$_OBJECT_NAME = ^X1E
OSS$_OWNER = ^X15
OSS$_OWN_PROT = ^X18
OSS$_PROTECTION = ^X16
OSS$_SYS_PROT = ^X17
OSS$_TRANQUILITY_COUNT = ^X22
OSS$_WOR_PROT = ^X1A

	.PSECT	DATA,WRT,NOEXE,LONG
SIGCOND: .LONG	0		; the condition HANDLER was given
SIGARG1: .LONG	0		; an access violation's reason mask
SIGARG2: .LONG	0		; and address
CONTEXT: .LONG	0		; the context cases share
CHAN:	.LONG	0		; OPENCHAN's channel
PARTBUF: .BLKB	32
PARTLEN: .LONG	0
TABNAM:	.ASCID	/LNM$FILE_DEV/
PARTNAM: .ASCID	/SEC93_PART/
TRNLST:	.WORD	32,LNM$_STRING
	.ADDRESS PARTBUF,PARTLEN
	.LONG	0
DEFPART: .ASCII	/PFCKHGSDQ/
DEFLEN	= 9
OUTD:	.LONG	600
	.ADDRESS OUTBUF
OUTBUF:	.BLKB	600
OUTLEN:	.WORD	0,0
HEXTAB:	.ASCII	/0123456789ABCDEF/
LINE:	.BLKB	80
FMTBUF:	.BLKB	1024
FMTD:	.LONG	1024
	.ADDRESS FMTBUF
FMTLEN:	.WORD	0,0
ACED:	.LONG	0,0

; The probe's own names for the access bits, for the accnam argument:
; LOOK, TOUCH, RUN, KILL, OWN, then X5 to X31.
	.ALIGN	LONG
ACCNAM:
	.LONG	4
	.ADDRESS AN0
	.LONG	5
	.ADDRESS AN1
	.LONG	3
	.ADDRESS AN2
	.LONG	4
	.ADDRESS AN3
	.LONG	3
	.ADDRESS AN4
	$$I = 5
	.REPT	5
	.LONG	2
	.ADDRESS ANX+<<$$I-5>*2>
	$$I = $$I + 1
	.ENDR
	.REPT	22
	.LONG	3
	.ADDRESS ANY+<<$$I-10>*3>
	$$I = $$I + 1
	.ENDR
AN0:	.ASCII	/LOOK/
AN1:	.ASCII	/TOUCH/
AN2:	.ASCII	/RUN/
AN3:	.ASCII	/KILL/
AN4:	.ASCII	/OWN/
ANX:	.ASCII	/X5X6X7X8X9/
ANY:	.ASCII	/X10X11X12X13X14X15X16X17X18X19X20X21X22X23X24X25X26X27X28X29X30X31/

; SHOWFILE's blocks.
	.ALIGN	LONG
FABS:	$FAB	FAC=GET,SHR=<GET,PUT,UPD,DEL>
	.ALIGN	LONG
XABS:	$XABPRO	ACLBUF=ACLB,ACLSIZ=512
ACLB:	.BLKB	512
	.ALIGN	LONG
FABC:	$FAB	FOP=UFO,SHR=GET

