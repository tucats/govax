; 582: $PARSE_ACL (IDENTIFIER=PROT93A,ACCESS=READ)
	.ENTRY	C582,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	SAY	</!AS/>,#C582_T
	MOVC5	#0,(SP),#0,#256,C582_B
	MOVW	#^XFFFF,C582_E
	CLRL	-(SP)
	CLRL	-(SP)
	CLRL	-(SP)
	PUSHAW	C582_E
	PUSHAQ	C582_BD
	PUSHAQ	C582_S
	CALLS	#6,G^SYS$PARSE_ACL
	MOVL	R0,R2
	MOVZWL	C582_E,R3
	MOVZBL	C582_B,R4
	SAY	</  $PARSE_ACL r0=!XL errpos=!UL size=!UL/>,R2,R3,R4
	MOVZWL	C582_S,R5
	CMPL	R3,R5
	BGTRU	10$
	SUBL2	R3,R5
	ADDL3	R3,C582_S+4,R6
	SAY	</  rest !UL "!AF"/>,R5,R5,R6
10$:
	CMPL	R4,#256
	BLEQ	20$
	MOVL	#256,R4
20$:
	PUSHL	R4
	PUSHAB	C582_B
	CALLS	#2,ACLWALK
	RET

