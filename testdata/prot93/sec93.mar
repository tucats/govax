	.LONG	^A/U/
	.ADDRESS C576
	.LONG	^A/U/
	.ADDRESS C577
	.LONG	^A/U/
	.ADDRESS C578
	.LONG	^A/U/
	.ADDRESS C579
	.LONG	^A/U/
	.ADDRESS C580
	.LONG	^A/U/
	.ADDRESS C581
	.LONG	^A/U/
	.ADDRESS C582
	.LONG	^A/U/
	.ADDRESS C583
	.LONG	^A/U/
	.ADDRESS C584
	.LONG	^A/U/
	.ADDRESS C585
	.LONG	^A/U/
	.ADDRESS C586
	.LONG	^A/U/
	.ADDRESS C587
	.LONG	^A/U/
	.ADDRESS C588
	.LONG	^A/U/
	.LONG	0,0

	.PSECT	CODE,NOWRT,EXE

	.ENTRY	START,^M<R2,R3,R4,R5,R6,R7,R8>
	$TRNLNM_S TABNAM=TABNAM,LOGNAM=PARTNAM,ITMLST=TRNLST
	BLBS	R0,2$
	MOVC3	#DEFLEN,DEFPART,PARTBUF
	MOVL	#DEFLEN,PARTLEN
2$:	MOVZWL	PARTLEN,PARTLEN
	SAY	</parts !AD/>,PARTLEN,#PARTBUF
	MOVAB	CASES,R6
10$:	MOVL	(R6)+,R7
	BEQL	90$
	MOVL	(R6)+,R8
	LOCC	R8,PARTLEN,PARTBUF
	BEQL	10$
	CLRL	SIGCOND
	CALLS	#0,(R7)
	TSTL	SIGCOND
	BEQL	10$
	SAY	</  signal !XL !XL !XL/>,SIGCOND,SIGARG1,SIGARG2
	BRB	10$
90$:	SAY	</end of cases/>
	MOVL	#SS$_NORMAL,R0
	RET

; HANDLER records the condition (and an access violation's reason mask
; and address), then unwinds to the caller of the routine that
; established it, which gets the condition in R0. It ignores SS$_UNWIND.
	.ENTRY	HANDLER,^M<>
	MOVL	4(AP),R0
	CMPL	4(R0),#SS$_UNWIND
	BEQL	9$
	MOVL	4(R0),SIGCOND
	CLRQ	SIGARG1
	CMPL	SIGCOND,#SS$_ACCVIO
	BNEQ	1$
	MOVQ	8(R0),SIGARG1
1$:	MOVL	8(AP),R1
	MOVL	SIGCOND,12(R1)
	$UNWIND_S
9$:	RET

; SAYR text, a1, ...: format and write one line.
	.ENTRY	SAYR,^M<R2,R3,R4,R5>
	MOVL	#600,OUTD
	$FAOL_S	CTRSTR=@4(AP),OUTLEN=OUTLEN,OUTBUF=OUTD,PRMLST=8(AP)
	MOVZWL	OUTLEN,OUTD
	PUSHAQ	OUTD
	CALLS	#1,G^LIB$PUT_OUTPUT
	MOVL	#600,OUTD
	RET

; HEXLINES address, length: the bytes in hex, 16 to a line.
	.ENTRY	HEXLINES,^M<R2,R3,R4,R5,R6>
	MOVL	4(AP),R2
	MOVL	8(AP),R3
1$:	TSTL	R3
	BLEQ	9$
	MOVAB	LINE,R4
	MOVL	#^X20202020,(R4)+
	MOVL	#16,R5
2$:	MOVZBL	(R2)+,R6
	EXTZV	#4,#4,R6,R0
	MOVB	HEXTAB[R0],(R4)+
	EXTZV	#0,#4,R6,R0
	MOVB	HEXTAB[R0],(R4)+
	MOVB	#^A/ /,(R4)+
	DECL	R3
	BLEQ	3$
	SOBGTR	R5,2$
3$:	MOVAB	LINE,R0
	SUBL3	R0,R4,R0
	DECL	R0
	SAY	</!AD/>,R0,#LINE
	BRB	1$
9$:	RET

; ACLWALK address, length: each ACE in the bytes, in hex, then as
; $FORMAT_ACL writes it. It stops at an ACE of size 0, and says so if an
; ACE claims more bytes than are left.
	.ENTRY	ACLWALK,^M<R2,R3,R4>
	MOVL	4(AP),R2
	MOVL	8(AP),R3
1$:	TSTL	R3
	BLEQ	9$
	MOVZBL	(R2),R4
	BEQL	9$
	CMPL	R4,R3
	BGTR	8$
	PUSHL	R4
	PUSHL	R2
	CALLS	#2,HEXLINES
	PUSHL	R4
	PUSHL	R2
	CALLS	#2,FORMAT1
	ADDL2	R4,R2
	SUBL2	R4,R3
	BRB	1$
8$:	SAY	</    ACE size !UL with !UL bytes left/>,R4,R3
	PUSHL	R3
	PUSHL	R2
	CALLS	#2,HEXLINES
9$:	RET

; FORMAT1 address, length: one ACE as $FORMAT_ACL writes it, by default.
	.ENTRY	FORMAT1,^M<R2>
	MOVAB	HANDLER,(FP)
	MOVL	4(AP),ACED+4
	MOVL	8(AP),ACED
	MOVL	#1024,FMTD
	CLRL	FMTLEN
	CLRQ	-(SP)
	CLRQ	-(SP)
	CLRQ	-(SP)
	PUSHAQ	FMTD
	PUSHAW	FMTLEN
	PUSHAQ	ACED
	CALLS	#9,G^SYS$FORMAT_ACL
	MOVL	R0,R2
	MOVZWL	FMTLEN,R0
	BLBC	R2,5$
	SAY	</      !AD/>,R0,#FMTBUF
	RET
5$:	SAY	</      $FORMAT_ACL r0=!XL len=!UL/>,R2,R0
	RET

; SHOWOUT name, retlen, buffer, size, kind: an output item. A return
; length address of 0 means the size; a length past the size is cut to it.
	.ENTRY	SHOWOUT,^M<R2,R3,R4,R5>
	MOVL	12(AP),R3
	MOVL	16(AP),R4
	MOVL	8(AP),R2
	BEQL	1$
	MOVZWL	(R2),R5
	SAY	</  !AS retlen=!UL/>,4(AP),R5
	BRB	2$
1$:	MOVL	R4,R5
	SAY	</  !AS/>,4(AP)
2$:	CMPL	20(AP),#3
	BNEQ	3$
	MOVL	R4,R5
3$:	CMPL	R5,R4
	BLEQ	4$
	MOVL	R4,R5
4$:	CMPL	20(AP),#1
	BNEQ	5$
	SAY	</    "!AF"/>,R5,R3
	RET
5$:	CMPL	20(AP),#2
	BNEQ	6$
	PUSHL	R5
	PUSHL	R3
	CALLS	#2,ACLWALK
	RET
6$:	PUSHL	R5
	PUSHL	R3
	CALLS	#2,HEXLINES
	RET

; SHOWFILE name: the file's owner, protection, and ACL, by RMS's $OPEN
; and $DISPLAY with a XABPRO.
	.ENTRY	SHOWFILE,^M<R2,R3,R4,R5>
	MOVAB	HANDLER,(FP)
	MOVL	4(AP),R2
	MOVB	(R2),FABS+FAB$B_FNS
	MOVL	4(R2),FABS+FAB$L_FNA
	MOVC5	#0,(SP),#0,#512,ACLB
	CLRL	XABS+XAB$L_ACLCTX
	CLRW	XABS+XAB$W_ACLLEN
	CLRL	XABS+XAB$L_ACLSTS
	CLRL	XABS+XAB$L_UIC
	CLRW	XABS+XAB$W_PRO
	MOVAB	XABS,FABS+FAB$L_XAB
	RMS	OPEN,FABS
	BLBS	R0,10$
	MOVL	FABS+FAB$L_STS,R2
	MOVL	FABS+FAB$L_STV,R3
	SAY	</  file $OPEN sts=!XL stv=!XL/>,R2,R3
	RET
10$:	RMS	DISPLAY,FABS
	MOVL	XABS+XAB$L_UIC,R2
	MOVZWL	XABS+XAB$W_PRO,R3
	MOVZWL	XABS+XAB$W_ACLLEN,R4
	MOVL	XABS+XAB$L_ACLSTS,R5
	SAY	</  file owner=!XL pro=!XW acllen=!UL aclsts=!XL/>,R2,R3,R4,R5
	CMPL	R4,#512
	BLEQ	20$
	MOVL	#512,R4
20$:	PUSHL	R4
	PUSHAB	ACLB
	CALLS	#2,ACLWALK
	RMS	CLOSE,FABS
	RET

; OPENCHAN name, fac: open the file for user file open with the access
; given, and keep the channel RMS assigned in CHAN.
	.ENTRY	OPENCHAN,^M<R2,R3>
	MOVL	4(AP),R2
	MOVB	(R2),FABC+FAB$B_FNS
	MOVL	4(R2),FABC+FAB$L_FNA
	MOVB	8(AP),FABC+FAB$B_FAC
	CLRL	CHAN
	RMS	OPEN,FABC
	MOVL	FABC+FAB$L_STS,R2
	MOVL	FABC+FAB$L_STV,R3
	SAY	</  open for a channel sts=!XL stv=!XL/>,R2,R3
	BLBC	R2,9$
	MOVL	R3,CHAN
9$:	RET

; CLOSECHAN: deassign CHAN.
	.ENTRY	CLOSECHAN,^M<>
	TSTL	CHAN
	BEQL	9$
	$DASSGN_S CHAN=CHAN
	CLRL	CHAN
9$:	RET

; 1: $PARSE_ACL (IDENTIFIER=[200,1],ACCESS=READ)
	.ENTRY	C1,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	SAY	</!AS/>,#C1_T
	MOVC5	#0,(SP),#0,#256,C1_B
	MOVW	#^XFFFF,C1_E
	CLRL	-(SP)
	CLRL	-(SP)
	CLRL	-(SP)
	PUSHAW	C1_E
	PUSHAQ	C1_BD
	PUSHAQ	C1_S
	CALLS	#6,G^SYS$PARSE_ACL
	MOVL	R0,R2
	MOVZWL	C1_E,R3
	MOVZBL	C1_B,R4
	SAY	</  $PARSE_ACL r0=!XL errpos=!UL size=!UL/>,R2,R3,R4
	MOVZWL	C1_S,R5
	CMPL	R3,R5
	BGTRU	10$
	SUBL2	R3,R5
	ADDL3	R3,C1_S+4,R6
	SAY	</  rest !UL "!AF"/>,R5,R5,R6
10$:
	CMPL	R4,#256
	BLEQ	20$
	MOVL	#256,R4
20$:
	PUSHL	R4
	PUSHAB	C1_B
	CALLS	#2,ACLWALK
	RET

