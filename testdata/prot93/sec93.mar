	MOVL	R0,R2
	MOVZWL	C588_P,R3
	SAY	</  $SETDFPROT r0=!XL cur=!XW/>,R2,R3
	PUSHAW	C588_P
	PUSHAW	C588_Q
	CALLS	#2,G^SYS$SETDFPROT
	MOVL	R0,R2
	MOVZWL	C588_P,R3
	SAY	</  set: r0=!XL previous=!XW/>,R2,R3
	PUSHAW	C588_Q
	CLRL	-(SP)
	CALLS	#2,G^SYS$SETDFPROT
	MOVL	R0,R2
	MOVZWL	C588_Q,R3
	SAY	</  query: r0=!XL cur=!XW/>,R2,R3
	RET

