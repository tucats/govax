	MOVL	R0,R2
	MOVZWL	C484_P,R3
	SAY	</  $SETDFPROT r0=!XL cur=!XW/>,R2,R3
	MOVW	#^XFF00,C484_Q
	PUSHAW	C484_P
	PUSHAW	C484_Q
	CALLS	#2,G^SYS$SETDFPROT
	MOVL	R0,R2
	MOVZWL	C484_P,R3
	SAY	</  set FF00: r0=!XL previous=!XW/>,R2,R3
	PUSHAW	C484_Q
	CLRL	-(SP)
	CALLS	#2,G^SYS$SETDFPROT
	MOVL	R0,R2
	MOVZWL	C484_Q,R3
	SAY	</  query: r0=!XL cur=!XW/>,R2,R3
	PUSHL	#0
	PUSHAW	C484_P
	CALLS	#2,G^SYS$SETDFPROT
	MOVL	R0,R2
	SAY	</  set back: r0=!XL/>,R2
	CLRQ	-(SP)
	CALLS	#2,G^SYS$SETDFPROT
	MOVL	R0,R2
	SAY	</  no arguments: r0=!XL/>,R2
	PUSHL	#4
	CLRL	-(SP)
	CALLS	#2,G^SYS$SETDFPROT
	MOVL	R0,R2
	SAY	</  cur at address 4: r0=!XL/>,R2
	CLRL	-(SP)
	PUSHL	#4
	CALLS	#2,G^SYS$SETDFPROT
	MOVL	R0,R2
	SAY	</  new at address 4: r0=!XL/>,R2
	RET

