	MOVAB	HANDLER,(FP)
	SAY	</!AS/>,#C439_T
	MOVC5	#0,(SP),#0,#4,C439_I1
	MOVW	#^XFFFF,C439_I1R
	PUSHAL	C439_AM
	CLRL	-(SP)
	PUSHAB	C439_L
	CLRL	-(SP)
	CLRL	-(SP)
	PUSHAQ	C439_NM
	PUSHAQ	C439_CN
	CALLS	#7,G^SYS$GET_SECURITY
	MOVL	R0,R2
	SAY	</  $GET_SECURITY r0=!XL/>,R2
	PUSHL	#0
	PUSHL	#4
	PUSHAB	C439_I1
	PUSHAW	C439_I1R
	PUSHAQ	C439_I1N
	CALLS	#5,SHOWOUT
	RET

