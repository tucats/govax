$ ! PROT93V.COM - Phase 93's probe, round 2: an account's run.
$ ! Written by testdata/prot93/gen.go. Run it logged in as PROT93A, then
$ ! PROT93B, then PROT93C, after SYSTEM's PROT93R.COM (README.md):
$ !
$ !     @PROT93$DISK:[000000]PROT93V
$ !
$ ! Its log is PROT93$DISK:[PROT93LOG]PROT93V_username.LOG.
$ !
$ IF P1 .EQS. "LOGGED" THEN GOTO BEGIN
$ HERE = F$ENVIRONMENT("PROCEDURE")
$ DEV = F$PARSE(HERE,,,"DEVICE")
$ LOGFILE = DEV + "[PROT93LOG]" + "PROT93V_" + F$EDIT(F$GETJPI("","USERNAME"),"TRIM") + ".LOG"
$ @'HERE'/OUTPUT='LOGFILE' LOGGED
$ WRITE SYS$OUTPUT "PROT93V finished; the log is ", LOGFILE
$ EXIT
$ BEGIN:
$ SET NOON
$ SET VERIFY
$ !
$ WRITE SYS$OUTPUT "######## ENVIRONMENT"
$ USER = F$EDIT(F$GETJPI("","USERNAME"),"TRIM")
$ LETTER = F$EXTRACT(F$LENGTH(USER)-1,1,USER)
$ T = LETTER + "0"
$ ME = F$GETJPI("","UIC")
$ WRITE SYS$OUTPUT USER, " ", ME, " ", T
$ SHOW PROCESS/PRIVILEGES
$ SHOW SECURITY PROT93$DISK:[000000]PROT93.EXE
$ !
$ WRITE SYS$OUTPUT "######## PROGRAM, NO PRIVILEGES"
$ SET PROCESS/PRIVILEGES=(NOREADALL,NOGRPPRV,NOSYSPRV,NOBYPASS)
$ WRITE SYS$OUTPUT "READALL=", F$PRIVILEGE("READALL"), " GRPPRV=", F$PRIVILEGE("GRPPRV"), " SYSPRV=", F$PRIVILEGE("SYSPRV"), " BYPASS=", F$PRIVILEGE("BYPASS")
$ DEFINE PROT93_TAG 'T'
$ DEFINE/USER_MODE SYS$INPUT PROT93$DISK:[000000]PROT93C.DAT
$ RUN PROT93$DISK:[000000]PROT93
$ SHOW SYMBOL $STATUS
$ DEFINE PROT93_TAG 'T'
$ DEFINE/USER_MODE SYS$INPUT PROT93$DISK:[000000]PROT93F.DAT
$ RUN PROT93$DISK:[000000]PROT93
$ SHOW SYMBOL $STATUS
$ DEFINE PROT93_TAG 'T'
$ DEFINE/USER_MODE SYS$INPUT PROT93$DISK:[000000]PROT93D.DAT
$ RUN PROT93$DISK:[000000]PROT93
$ SHOW SYMBOL $STATUS
$ DEFINE PROT93_TAG 'T'
$ DEFINE/USER_MODE SYS$INPUT PROT93$DISK:[000000]PROT93G.DAT
$ RUN PROT93$DISK:[000000]PROT93
$ SHOW SYMBOL $STATUS
$ DEFINE PROT93_TAG 'T'
$ DEFINE/USER_MODE SYS$INPUT PROT93$DISK:[PROT93LOG]FIDS.DAT
$ RUN PROT93$DISK:[000000]PROT93
$ SHOW SYMBOL $STATUS
$ !
$ WRITE SYS$OUTPUT "######## PROGRAM, GRPPRV"
$ SET PROCESS/PRIVILEGES=GRPPRV
$ WRITE SYS$OUTPUT "READALL=", F$PRIVILEGE("READALL"), " GRPPRV=", F$PRIVILEGE("GRPPRV"), " SYSPRV=", F$PRIVILEGE("SYSPRV"), " BYPASS=", F$PRIVILEGE("BYPASS")
$ IF .NOT. F$PRIVILEGE("GRPPRV") THEN GOTO NO_GRPPRV
$ TN = LETTER + "2"
$ DEFINE PROT93_TAG 'TN'
$ DEFINE/USER_MODE SYS$INPUT PROT93$DISK:[000000]PROT93C.DAT
$ RUN PROT93$DISK:[000000]PROT93
$ SHOW SYMBOL $STATUS
$ DEFINE PROT93_TAG 'TN'
$ DEFINE/USER_MODE SYS$INPUT PROT93$DISK:[000000]PROT93F.DAT
$ RUN PROT93$DISK:[000000]PROT93
$ SHOW SYMBOL $STATUS
$ DEFINE PROT93_TAG 'TN'
$ DEFINE/USER_MODE SYS$INPUT PROT93$DISK:[PROT93LOG]FIDS.DAT
$ RUN PROT93$DISK:[000000]PROT93
$ SHOW SYMBOL $STATUS
$ NO_GRPPRV:
$ SET PROCESS/PRIVILEGES=(NOREADALL,NOGRPPRV,NOSYSPRV,NOBYPASS)
$ !
$ WRITE SYS$OUTPUT "######## OWNERS"
$ ! OS: owned by this account; OT: owned by PROT93A, whose ACL gives this
$ ! account CONTROL.
$ SET SECURITY/OWNER='ME' PROT93$DISK:[PROT93.CTL]OS_'T'.DAT
$ SET SECURITY/OWNER=[200,1] PROT93$DISK:[PROT93.CTL]OS_'T'.DAT
$ SET SECURITY/OWNER='ME' PROT93$DISK:[PROT93.CTL]OT_'T'.DAT
$ SET SECURITY/PROTECTION=(W:RWED) PROT93$DISK:[PROT93.CTL]OT_'T'.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.CTL]OS_'T'.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.CTL]OT_'T'.DAT
$ CREATE/OWNER_UIC='ME' PROT93$DISK:[PROT93.OWN]CM_'T'.DAT
RECORD
$ CREATE/OWNER_UIC=[200,1] PROT93$DISK:[PROT93.OWN]CA_'T'.DAT
RECORD
$ CREATE/DIRECTORY/OWNER_UIC=[200,1] PROT93$DISK:[PROT93.OWN.DO'T']
$ CREATE/DIRECTORY/OWNER_UIC=PARENT PROT93$DISK:[PROT93.OWN.DP'T']
$ DIRECTORY/SECURITY PROT93$DISK:[PROT93.OWN]C%_'T'.DAT;*
$ DIRECTORY/SECURITY PROT93$DISK:[PROT93.OWN]D%'T'.DIR;*
$ !
$ WRITE SYS$OUTPUT "######## NEW FILES' ACLS"
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.DP]R2_'T'.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.DP]R2_'T'.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.NV]NP_'T'.DAT;*
$ !
$ WRITE SYS$OUTPUT "######## PROCEDURES"
$ @PROT93$DISK:[PROT93.IMG]PRO2E.COM
$ SHOW SYMBOL $STATUS
$ @PROT93$DISK:[PROT93.IMG]PRO2R.COM
$ SHOW SYMBOL $STATUS
$ @PROT93$DISK:[PROT93.IMG]PRO2N.COM
$ SHOW SYMBOL $STATUS
$ !
$ WRITE SYS$OUTPUT "######## END"
$ WRITE SYS$OUTPUT "PROT93V FINISHED"
$ SET NOVERIFY
$ EXIT
