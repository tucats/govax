$ ! PROT93Y.COM - Phase 93's probe, round 2: the listing at the end, and
$ ! the accounts removed. Written by testdata/prot93/gen.go. Run it as
$ ! SYSTEM after the accounts' runs (README.md's "Round 2"):
$ !
$ !     @PROT93$DISK:[000000]PROT93Y
$ !
$ IF P1 .EQS. "LOGGED" THEN GOTO BEGIN
$ HERE = F$ENVIRONMENT("PROCEDURE")
$ DEV = F$PARSE(HERE,,,"DEVICE")
$ LOGFILE = DEV + "[PROT93LOG]" + "PROT93Y.LOG"
$ @'HERE'/OUTPUT='LOGFILE' LOGGED
$ WRITE SYS$OUTPUT "PROT93Y finished; the log is ", LOGFILE
$ EXIT
$ BEGIN:
$ SET NOON
$ SET VERIFY
$ !
$ WRITE SYS$OUTPUT "######## THE TREE"
$ DIRECTORY/SECURITY PROT93$DISK:[PROT93...]*.*;*
$ !
$ WRITE SYS$OUTPUT "######## REMOVING THE ACCOUNTS"
$ HOME = F$ENVIRONMENT("DEFAULT")
$ SET DEFAULT SYS$SYSTEM
$ RUN SYS$SYSTEM:AUTHORIZE
REMOVE PROT93A
REMOVE PROT93B
REMOVE PROT93C
REMOVE/IDENTIFIER PROT93_TEAM
REMOVE/IDENTIFIER PROT93
EXIT
$ SET DEFAULT 'HOME'
$ WRITE SYS$OUTPUT "PROT93Y FINISHED"
$ DEASSIGN/SYSTEM/EXECUTIVE_MODE PROT93$DISK
$ SET NOVERIFY
$ EXIT
