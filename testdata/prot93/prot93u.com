$ ! PROT93U.COM - Phase 93's probe of file protection: an account's run.
$ ! Written by testdata/prot93/gen.go. Run it logged in as PROT93A, then
$ ! PROT93B, then PROT93C, after SYSTEM's PROT93.COM (README.md):
$ !
$ !     @PROT93$DISK:[000000]PROT93U
$ !
$ ! Its log is PROT93$DISK:[PROT93LOG]PROT93U_username.LOG.
$ !
$ IF P1 .EQS. "LOGGED" THEN GOTO BEGIN
$ HERE = F$ENVIRONMENT("PROCEDURE")
$ DEV = F$PARSE(HERE,,,"DEVICE")
$ LOGFILE = DEV + "[PROT93LOG]" + "PROT93U_" + F$EDIT(F$GETJPI("","USERNAME"),"TRIM") + ".LOG"
$ @'HERE'/OUTPUT='LOGFILE' LOGGED
$ WRITE SYS$OUTPUT "PROT93U finished; the log is ", LOGFILE
$ EXIT
$ BEGIN:
$ SET NOON
$ SET VERIFY
$ !
$ WRITE SYS$OUTPUT "######## ENVIRONMENT"
$ USER = F$EDIT(F$GETJPI("","USERNAME"),"TRIM")
$ LETTER = F$EXTRACT(F$LENGTH(USER)-1,1,USER)
$ T = LETTER + "0"
$ WRITE SYS$OUTPUT USER, " ", F$GETJPI("","UIC"), " ", T
$ SHOW PROCESS/PRIVILEGES
$ SHOW PROTECTION
$ WRITE SYS$OUTPUT F$ENVIRONMENT("PROTECTION")
$ SHOW DEFAULT
$ !
$ WRITE SYS$OUTPUT "######## PROGRAM, NO PRIVILEGES"
$ SET PROCESS/PRIVILEGES=(NOREADALL,NOGRPPRV,NOSYSPRV,NOBYPASS)
$ DEFINE PROT93_TAG 'T'
$ DEFINE/USER_MODE SYS$INPUT PROT93$DISK:[000000]PROT93C.DAT
$ RUN PROT93$DISK:[000000]PROT93
$ SHOW SYMBOL $STATUS
$ DEFINE PROT93_TAG 'T'
$ DEFINE/USER_MODE SYS$INPUT PROT93$DISK:[000000]PROT93D.DAT
$ RUN PROT93$DISK:[000000]PROT93
$ SHOW SYMBOL $STATUS
$ DEFINE PROT93_TAG 'T'
$ DEFINE/USER_MODE SYS$INPUT PROT93$DISK:[PROT93LOG]FIDS.DAT
$ RUN PROT93$DISK:[000000]PROT93
$ SHOW SYMBOL $STATUS
$ !
$ WRITE SYS$OUTPUT "######## PROGRAM, EACH PRIVILEGE"
$ ! The passes only for an account that may have the privileges.
$ SET PROCESS/PRIVILEGES=BYPASS
$ IF .NOT. F$PRIVILEGE("BYPASS") THEN GOTO NO_PASSES
$ N = 1
$ PASS:
$ PRIV = F$ELEMENT(N,",","NONE,READALL,GRPPRV,SYSPRV,BYPASS")
$ IF PRIV .EQS. "," THEN GOTO NO_PASSES
$ SET PROCESS/PRIVILEGES=(NOREADALL,NOGRPPRV,NOSYSPRV,NOBYPASS)
$ SET PROCESS/PRIVILEGES='PRIV'
$ WRITE SYS$OUTPUT "READALL=", F$PRIVILEGE("READALL"), " GRPPRV=", F$PRIVILEGE("GRPPRV"), " SYSPRV=", F$PRIVILEGE("SYSPRV"), " BYPASS=", F$PRIVILEGE("BYPASS")
$ TN = LETTER + F$STRING(N)
$ DEFINE PROT93_TAG 'TN'
$ DEFINE/USER_MODE SYS$INPUT PROT93$DISK:[000000]PROT93C.DAT
$ RUN PROT93$DISK:[000000]PROT93
$ SHOW SYMBOL $STATUS
$ DEFINE PROT93_TAG 'TN'
$ DEFINE/USER_MODE SYS$INPUT PROT93$DISK:[PROT93LOG]FIDS.DAT
$ RUN PROT93$DISK:[000000]PROT93
$ SHOW SYMBOL $STATUS
$ N = N + 1
$ GOTO PASS
$ NO_PASSES:
$ SET PROCESS/PRIVILEGES=(NOREADALL,NOGRPPRV,NOSYSPRV,NOBYPASS)
$ !
$ WRITE SYS$OUTPUT "######## PART B"
$ @PROT93$DISK:[000000]PROT93B 'T'
$ !
$ WRITE SYS$OUTPUT "######## ACL-GRANTED AND -DENIED FILES"
$ TYPE PROT93$DISK:[PROT93.F]FUIC0.DAT
$ TYPE PROT93$DISK:[PROT93.F]FUIC0ACL.DAT
$ TYPE PROT93$DISK:[PROT93.F]FACLDENY.DAT
$ TYPE PROT93$DISK:[PROT93.F]FACLGRANT.DAT
$ TYPE PROT93$DISK:[PROT93.F]FACLTEAM.DAT
$ TYPE PROT93$DISK:[PROT93.F]FACLOWN.DAT
$ TYPE PROT93$DISK:[PROT93.F]FACLCTL.DAT
$ TYPE PROT93$DISK:[PROT93.F]FACLWILD.DAT
$ TYPE PROT93$DISK:[PROT93.F]FACLSYS.DAT
$ TYPE PROT93$DISK:[PROT93.F]FACLINT.DAT
$ TYPE PROT93$DISK:[PROT93.F]FACLTWO.DAT
$ !
$ WRITE SYS$OUTPUT "######## CONTROL"
$ SET SECURITY/PROTECTION=(W:RWED) PROT93$DISK:[PROT93.CTL]DCT_'T'.DAT
$ SET SECURITY/PROTECTION=(W:RWED) PROT93$DISK:[PROT93.CTL]DCC_'T'.DAT
$ SET SECURITY/ACL=(IDENTIFIER=PROT93A,ACCESS=READ) PROT93$DISK:[PROT93.CTL]DCC_'T'.DAT
$ ME = F$GETJPI("","UIC")
$ SET SECURITY/OWNER='ME' PROT93$DISK:[PROT93.CTL]DCO_'T'.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.CTL]D*_'T'.DAT
$ SET SECURITY/PROTECTION=(W:RE) PROT93$DISK:[PROT93.F]FACLCTL.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.F]FACLCTL.DAT
$ !
$ WRITE SYS$OUTPUT "######## OWN FILES"
$ CREATE PROT93$DISK:[PROT93LOG]OWN_'T'.DAT
RECORD
$ SHOW SECURITY PROT93$DISK:[PROT93LOG]OWN_'T'.DAT
$ SET SECURITY/PROTECTION=(W:RWED) PROT93$DISK:[PROT93LOG]OWN_'T'.DAT
$ SET SECURITY/OWNER=[300,1] PROT93$DISK:[PROT93LOG]OWN_'T'.DAT
$ SET SECURITY/OWNER=[200,2] PROT93$DISK:[PROT93LOG]OWN_'T'.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93LOG]OWN_'T'.DAT
$ SET PROTECTION=(G:RWED,W:R)/DEFAULT
$ SHOW PROTECTION
$ CREATE PROT93$DISK:[PROT93LOG]DEF_'T'.DAT
RECORD
$ SHOW SECURITY PROT93$DISK:[PROT93LOG]DEF_'T'.DAT
$ SET PROTECTION=(S:RWED,O:RWED,G:RE,W)/DEFAULT
$ !
$ WRITE SYS$OUTPUT "######## NEW FILES AND DIRECTORIES IN OTHERS' DIRECTORIES"
$ CREATE/DIRECTORY PROT93$DISK:[PROT93.OWN.D'T']
$ CREATE/DIRECTORY PROT93$DISK:[PROT93.DP.D'T']
$ CREATE/DIRECTORY PROT93$DISK:[PROT93.DR.D'T']
$ CREATE PROT93$DISK:[PROT93.DP]N_'T'.DAT
RECORD
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.OWN]CP_'T'.DAT
$ COPY PROT93$DISK:[PROT93LOG]T.DAT PROT93$DISK:[PROT93.OWN]NVO_'T'.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.OWN]D'T'.DIR
$ SHOW SECURITY PROT93$DISK:[PROT93.DP]D'T'.DIR
$ SHOW SECURITY PROT93$DISK:[PROT93.DP]N_'T'.DAT,PROT93$DISK:[PROT93.OWN]CP_'T'.DAT
$ SHOW SECURITY PROT93$DISK:[PROT93.OWN]NVO_'T'.DAT;*
$ !
$ WRITE SYS$OUTPUT "######## END"
$ WRITE SYS$OUTPUT "PROT93U FINISHED"
$ SET NOVERIFY
$ EXIT
