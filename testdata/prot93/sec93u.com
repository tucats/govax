$ ! SEC93U.COM - Phase 93's probe, round 3: PROT93C's run. Log in as PROT93C (a new login), then:
$ !
$ !     @PROT93$DISK:[000000]SEC93U
$ !
$ ! Its log is PROT93$DISK:[PROT93LOG]SEC93U.LOG.
$ ! Written by testdata/prot93/gen3.go (README.md's "Round 3").
$ !
$ IF P1 .EQS. "LOGGED" THEN GOTO BEGIN
$ HERE = F$ENVIRONMENT("PROCEDURE")
$ DEV = F$PARSE(HERE,,,"DEVICE")
$ LOGFILE = DEV + "[PROT93LOG]" + "SEC93U.LOG"
$ @'HERE'/OUTPUT='LOGFILE' LOGGED 'P1'
$ WRITE SYS$OUTPUT "SEC93U finished; the log is ", LOGFILE
$ EXIT
$ BEGIN:
$ SET NOON
$ SET VERIFY
$ !
$ WRITE SYS$OUTPUT "######## ENVIRONMENT"
$ WRITE SYS$OUTPUT F$GETJPI("","USERNAME"), " ", F$GETJPI("","UIC")
$ SHOW PROCESS/PRIVILEGES
$ WRITE SYS$OUTPUT "READALL=", F$PRIVILEGE("READALL"), " GRPPRV=", F$PRIVILEGE("GRPPRV"), " SYSPRV=", F$PRIVILEGE("SYSPRV"), " BYPASS=", F$PRIVILEGE("BYPASS")
$ !
$ WRITE SYS$OUTPUT "######## PROGRAM, NO PRIVILEGES"
$ DEFINE SEC93_PART "U"
$ RUN PROT93$DISK:[SEC93]SEC93
$ SHOW SYMBOL $STATUS
$ DEASSIGN SEC93_PART
$ !
$ WRITE SYS$OUTPUT "######## EXECUTE-ONLY, VERIFY ON"
$ WRITE SYS$OUTPUT "VERIFY_PROCEDURE=", F$ENVIRONMENT("VERIFY_PROCEDURE")
$ @PROT93$DISK:[SEC93.EXO]EXONLY
$ SHOW SYMBOL $STATUS
$ SHOW SYMBOL EXONLY_SYMBOL
$ WRITE SYS$OUTPUT "VERIFY_PROCEDURE=", F$ENVIRONMENT("VERIFY_PROCEDURE")
$ DELETE/SYMBOL/GLOBAL EXONLY_SYMBOL
$ !
$ WRITE SYS$OUTPUT "######## EXECUTE-ONLY, VERIFY OFF"
$ SET NOVERIFY
$ WRITE SYS$OUTPUT "VERIFY_PROCEDURE=", F$ENVIRONMENT("VERIFY_PROCEDURE")
$ @PROT93$DISK:[SEC93.EXO]EXONLY
$ WRITE SYS$OUTPUT "$STATUS=", $STATUS
$ WRITE SYS$OUTPUT "VERIFY_PROCEDURE=", F$ENVIRONMENT("VERIFY_PROCEDURE")
$ SET VERIFY
$ !
$ WRITE SYS$OUTPUT "######## EXECUTE-ONLY, NESTED"
$ @PROT93$DISK:[SEC93.EXO]EXNEST
$ SET NOVERIFY
$ @PROT93$DISK:[SEC93.EXO]EXNEST
$ SET VERIFY
$ !
$ WRITE SYS$OUTPUT "######## EXECUTE-ONLY, DATA AND AN ERROR"
$ @PROT93$DISK:[SEC93.EXO]EXDATA
$ @PROT93$DISK:[SEC93.EXO]EXERR
$ SHOW SYMBOL $STATUS
$ !
$ WRITE SYS$OUTPUT "######## EXECUTE-ONLY, OUTPUT TO A FILE"
$ @PROT93$DISK:[SEC93.EXO]EXONLY/OUTPUT=PROT93$DISK:[PROT93LOG]EXO.OUT
$ TYPE PROT93$DISK:[PROT93LOG]EXO.OUT
$ !
$ WRITE SYS$OUTPUT "######## EXECUTE-ONLY, READ AS A FILE"
$ TYPE PROT93$DISK:[SEC93.EXO]EXONLY.COM
$ OPEN/READ EXOF PROT93$DISK:[SEC93.EXO]EXONLY.COM
$ CLOSE EXOF
$ WRITE SYS$OUTPUT F$FILE_ATTRIBUTES("PROT93$DISK:[SEC93.EXO]EXONLY.COM","EOF")
$ WRITE SYS$OUTPUT F$SEARCH("PROT93$DISK:[SEC93.EXO]EXONLY.COM")
$ DIRECTORY/SECURITY PROT93$DISK:[SEC93.EXO]
$ !
$ WRITE SYS$OUTPUT "######## END"
$ WRITE SYS$OUTPUT "SEC93U FINISHED"
$ SET NOVERIFY
$ EXIT
