$ WRITE SYS$OUTPUT F$GETSYI("VERSION"), " ", F$GETSYI("HW_NAME")
V7.1     VAX 8600
$ DEFINE/USER_MODE SYS$OUTPUT TPA80.MLG
$ MACRO/LIST TPA80
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000002"
$ LINK/MAP/FULL TPA80
%LINK-E-ERRORS, compilation errors
	in module TPA80 file DUA1:[000000]TPA80.OBJ;1
%LINK-E-NOIMGFIL, image file not created
$ SHOW SYMBOL $STATUS
  $STATUS == "%X106482B2"
$ DEFINE/USER_MODE SYS$OUTPUT TPA80.OUT
$ RUN TPA80
%DCL-W-ACTIMAGE, error activating image TPA80
-CLI-E-IMAGEFNF, image file not found DUA1:[000000]TPA80.EXE;
$ SHOW SYMBOL $STATUS
  $STATUS == "%X100388B2"
$ DEFINE/USER_MODE SYS$OUTPUT TPA80B.MLG
$ MACRO/LIST TPA80B
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000002"
$ DEFINE/USER_MODE SYS$OUTPUT TPA80C.MLG
$ MACRO/LIST TPA80C
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000002"
$ ANALYZE/OBJECT/OUTPUT=TPA80B.ANL TPA80B
%ANALYZE-I-ERRORS, DUA1:[000000]TPA80B.OBJ;1                               0 errors
$ ANALYZE/OBJECT/OUTPUT=TPA80.ANL TPA80
%ANALYZE-I-ERRORS, DUA1:[000000]TPA80.OBJ;1                                0 errors
