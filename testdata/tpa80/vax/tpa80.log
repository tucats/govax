$ ! TPA80.COM - the Phase 80 probe of LIB$TPARSE and $FILESCAN.
$ ! Written by testdata/tpa80/gen.go. Run it on the exchange volume, with its
$ ! [000000] as the default directory: @TPA80/OUTPUT=TPA80.LOG
$ SET NOON
$ SET VERIFY
$ WRITE SYS$OUTPUT F$GETSYI("VERSION"), " ", F$GETSYI("HW_NAME")
V7.1     VAX 8600
$ DEFINE/USER_MODE SYS$OUTPUT TPA80.MLG
$ MACRO/LIST TPA80
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ LINK/MAP/FULL TPA80
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ DEFINE/USER_MODE SYS$OUTPUT TPA80.OUT
$ RUN TPA80
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00000001"
$ DEFINE/USER_MODE SYS$OUTPUT TPA80B.MLG
$ MACRO/LIST TPA80B
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ DEFINE/USER_MODE SYS$OUTPUT TPA80C.MLG
$ MACRO/LIST TPA80C
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000002"
$ ANALYZE/OBJECT/OUTPUT=TPA80B.ANL TPA80B
%ANALYZE-I-ERRORS, DUA1:[000000]TPA80B.OBJ;1                               0 errors
$ ANALYZE/OBJECT/OUTPUT=TPA80.ANL TPA80
%ANALYZE-I-ERRORS, DUA1:[000000]TPA80.OBJ;1                                0 errors
