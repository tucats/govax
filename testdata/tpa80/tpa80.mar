	.TITLE	TPA80	Phase 80 LIB$TPARSE and $FILESCAN probe
	.IDENT	/V1.0/

; Written by testdata/tpa80/gen.go: do not edit. Runs LIB$TPARSE and
; LIB$TABLE_PARSE on state tables made by the macros and on bytes it holds
; itself, and $FILESCAN, printing what each returned and stored.

	$SSDEF
	$TPADEF
	$FSCNDEF

COMMA = 44
EIGHT = 8			; round 1: a type starting with a digit is refused
TWO = 1+1
LETA = 65

	.MACRO	P CTR,A,B,C,D,E,F,G,H
	.SAVE_PSECT LOCAL_BLOCK
	.PSECT	TEXT,NOEXE,NOWRT
	.NCHR	$$$PN,<CTR>
$$$PD = .
	.LONG	$$$PN
	.ADDRESS $$$PD+8
	.ASCII	~CTR~
	.RESTORE_PSECT
	$$$PC = 0
	.IRP	X,<H,G,F,E,D,C,B,A>
	.IF	NOT_BLANK <X>
	PUSHL	X
	$$$PC = $$$PC+1
	.ENDC
	.ENDR
	PUSHAB	$$$PD
	CALLS	#$$$PC+1,PRINT
	.ENDM	P

	.PSECT	DATA,NOEXE,WRT,QUAD
BLOCK:	.BLKL	12		; the argument block, and room past it
CELL:	.BLKL	2		; msk-adr's place
QCHAR:	.BLKL	1		; the quote example's character
SIGCOND:	.LONG	0		; the condition HANDLER was given
STRBASE:	.LONG	0		; the input string's address
OUTLEN:	.WORD	0
OUTD:	.LONG	200
	.ADDRESS OUTB
OUTB:	.BLKB	200
LINED:	.LONG	0
	.ADDRESS OUTB
CH:	.BLKB	1
	.ALIGN	LONG
MAPL:	.BLKB	64
MAPD:	.LONG	64
	.ADDRESS MAPL
SCANI:	.WORD	0,1
	.LONG	0
	.WORD	0,2
	.LONG	0
	.WORD	0,3
	.LONG	0
	.WORD	0,4
	.LONG	0
	.WORD	0,5
	.LONG	0
	.WORD	0,6
	.LONG	0
	.WORD	0,7
	.LONG	0
	.WORD	0,8
	.LONG	0
	.WORD	0,9
	.LONG	0
	.WORD	0,10
	.LONG	0
	.WORD	0,11
	.LONG	0
	.LONG	0
SCANBAD:	.WORD	0,12
	.LONG	0
	.LONG	0
SCANF:	.LONG	0
AUXB:	.BLKB	64
AUXD:	.LONG	64
	.ADDRESS AUXB
AUXL:	.WORD	0

	.PSECT	CODE,EXE,NOWRT
; PRINT writes a line from a $FAO control string and its parameters.
	.ENTRY	PRINT,^M<>
	PUSHAL	8(AP)
	PUSHAQ	OUTD
	PUSHAW	OUTLEN
	PUSHL	4(AP)
	CALLS	#4,G^SYS$FAOL
	MOVZWL	OUTLEN,LINED
	PUSHAQ	LINED
	CALLS	#1,G^LIB$PUT_OUTPUT
	RET

; HANDLER records a condition, and unwinds to the case's caller with it in R0.
	.ENTRY	HANDLER,^M<>
	MOVL	4(AP),R0
	MOVL	8(AP),R1
	CMPL	4(R0),#SS$_UNWIND
	BEQL	10$
	MOVL	4(R0),SIGCOND
	MOVL	4(R0),12(R1)
	$UNWIND_S
10$:	MOVL	#SS$_RESIGNAL,R0
	RET

; ACTBLOCK leaves the argument block's address in R1: AP, or the one argument
; if the routine was called with one.
	.ENTRY	ACTLOG,^M<R2,R3,R4,R5>
	MOVL	4(AP),R2	; the caller's AP
	MOVL	R2,R3
	CMPL	(R2),#1
	BNEQ	10$
	MOVL	4(R2),R3
10$:	MOVAL	BLOCK,R4
	SUBL3	R4,R3,R5	; 0 when it's the block
	PUSHL	R5
	PUSHL	(R2)
	PUSHL	8(AP)		; the low bit of R0 on entry
	PUSHAB	ACTLOGF
	CALLS	#4,PRINT
	SUBL3	STRBASE,TPA$L_TOKENPTR(R3),R4
	SUBL3	STRBASE,TPA$L_STRINGPTR(R3),R5
	P	<    rest=!UL@!SL tok=!UL@!SL char=!XB num=!XL param=!XL opt=!XL>,-
		TPA$L_STRINGCNT(R3),R5,TPA$L_TOKENCNT(R3),R4,TPA$B_CHAR(R3),TPA$L_NUMBER(R3),TPA$L_PARAM(R3),TPA$L_OPTIONS(R3)
	MOVL	R3,R0
	RET

; ACT logs its call and returns its argument.
	.ENTRY	ACT,^M<R2>
	BICL3	#^XFFFFFFFE,R0,R2
	PUSHL	R2
	PUSHL	AP
	CALLS	#2,ACTLOG
	MOVL	TPA$L_PARAM(R0),R0
	RET

; ACTOFF and ACTON turn the blanks flag off and on.
	.ENTRY	ACTOFF,^M<R2>
	BICL3	#^XFFFFFFFE,R0,R2
	PUSHL	R2
	PUSHL	AP
	CALLS	#2,ACTLOG
	BICL2	#TPA$M_BLANKS,TPA$L_OPTIONS(R0)
	MOVL	#1,R0
	RET
	.ENTRY	ACTON,^M<R2>
	BICL3	#^XFFFFFFFE,R0,R2
	PUSHL	R2
	PUSHL	AP
	CALLS	#2,ACTLOG
	BISL2	#TPA$M_BLANKS,TPA$L_OPTIONS(R0)
	MOVL	#1,R0
	RET

; ACTSKIP takes a character off the string itself.
	.ENTRY	ACTSKIP,^M<R2>
	BICL3	#^XFFFFFFFE,R0,R2
	PUSHL	R2
	PUSHL	AP
	CALLS	#2,ACTLOG
	DECL	TPA$L_STRINGCNT(R0)
	INCL	TPA$L_STRINGPTR(R0)
	MOVL	#1,R0
	RET

; ACTSIG signals through the parser.
	.ENTRY	ACTSIG,^M<>
	PUSHL	#^X1234
	CALLS	#1,G^LIB$SIGNAL
	MOVL	#1,R0
	RET

; TESTQ is the manual's: it refuses the quoting character.
	.ENTRY	TESTQ,^M<R2>
	MOVL	AP,R2
	CMPL	(AP),#1
	BNEQ	5$
	MOVL	4(AP),R2
5$:	MOVL	#1,R0
	CMPB	TPA$B_CHAR(R2),QCHAR
	BNEQ	10$
	CLRL	R0
10$:	RET

; RUN(routine, block, state, keys) makes the call under HANDLER.
	.ENTRY	RUN,^M<>
	MOVAB	HANDLER,(FP)
	PUSHL	16(AP)
	PUSHL	12(AP)
	PUSHL	8(AP)
	CALLS	#3,@4(AP)
	RET

; CASE(name, state, string, options, count, routine): one case.
	.ENTRY	CASE,^M<R2,R3,R4,R5,R6>
	MOVAL	BLOCK,R2
	MOVQ	@12(AP),R3	; length (low word), address
	MOVZWL	R3,R3
	MOVL	R4,STRBASE
	MOVL	20(AP),(R2)
	MOVL	16(AP),TPA$L_OPTIONS(R2)
	MOVL	R3,TPA$L_STRINGCNT(R2)
	MOVL	R4,TPA$L_STRINGPTR(R2)
	MOVL	#^X55555555,R0
	MOVL	R0,TPA$L_TOKENCNT(R2)
	MOVL	R4,TPA$L_TOKENPTR(R2)
	MOVL	R0,TPA$B_CHAR(R2)
	MOVL	R0,TPA$L_NUMBER(R2)
	MOVL	R0,TPA$L_PARAM(R2)
	MOVL	R0,CELL
	MOVL	R0,CELL+4
	CLRL	SIGCOND
	PUSHL	4(AP)
	PUSHAB	CASEF
	CALLS	#2,PRINT
	PUSHAB	KT
	PUSHL	8(AP)
	PUSHL	R2
	PUSHL	24(AP)
	CALLS	#4,RUN
	MOVL	R0,R6
	P	<  R0=!XL signal=!XL>,R6,SIGCOND
	CMPL	TPA$L_TOKENCNT(R2),#^X55555555
	BEQL	10$
	SUBL3	R4,TPA$L_TOKENPTR(R2),R5
	P	<  tok=!UL@!SL "!AF">,TPA$L_TOKENCNT(R2),R5,TPA$L_TOKENCNT(R2),TPA$L_TOKENPTR(R2)
10$:	SUBL3	R4,TPA$L_STRINGPTR(R2),R5
	P	<  rest=!UL@!SL "!AF">,TPA$L_STRINGCNT(R2),R5,TPA$L_STRINGCNT(R2),TPA$L_STRINGPTR(R2)
	P	<  char=!XL num=!XL param=!XL opt=!XL>,TPA$B_CHAR(R2),TPA$L_NUMBER(R2),TPA$L_PARAM(R2),TPA$L_OPTIONS(R2)
	CMPL	CELL+4,#^X55555555
	BEQL	20$
	SUBL3	R4,CELL+4,R5
	P	<  cell=!XL desc @!SL>,CELL,R5
	RET
20$:	P	<  cell=!XL>,CELL
	RET

; MAPIT(state, type name): every character tried on a state, a line of 64
; characters at a time, 1 for one that matched with the whole string consumed.
	.ENTRY	MAPIT,^M<R2,R3,R4,R5>
	PUSHL	8(AP)
	PUSHAB	MAPF
	CALLS	#2,PRINT
	MOVAL	BLOCK,R2
	CLRL	R3
10$:	MOVB	R3,CH
	MOVL	#8,(R2)
	MOVL	#TPA$M_BLANKS,TPA$L_OPTIONS(R2)
	MOVL	#1,TPA$L_STRINGCNT(R2)
	MOVAB	CH,TPA$L_STRINGPTR(R2)
	PUSHAB	KT
	PUSHL	4(AP)
	PUSHL	R2
	PUSHAB	G^LIB$TPARSE
	CALLS	#4,RUN
	MOVB	#^A/0/,R5
	BLBC	R0,20$
	MOVB	#^A/1/,R5
	TSTL	TPA$L_STRINGCNT(R2)
	BEQL	20$
	MOVB	#^A/2/,R5
20$:	BICL3	#^XFFFFFFC0,R3,R4
	MOVB	R5,MAPL[R4]
	CMPL	R4,#63
	BNEQ	30$
	P	<  !AS>,#MAPD
30$:	AOBLSS	#256,R3,10$
	RET

; DUMP(address, length): bytes in hexadecimal, 16 a line.
	.ENTRY	DUMP,^M<R2,R3,R4>
	MOVL	4(AP),R2
	MOVL	8(AP),R3
10$:	TSTL	R3
	BLEQ	30$
	MOVL	#16,R4
	CMPL	R3,R4
	BGEQ	20$
	MOVL	R3,R4
20$:	PUSHL	R2
	PUSHL	R4
	PUSHAB	DUMPF
	CALLS	#3,PRINTHEX
	ADDL2	R4,R2
	SUBL2	R4,R3
	BRB	10$
30$:	RET

; PRINTHEX(control, n, address): n bytes as hexadecimal.
	.ENTRY	PRINTHEX,^M<R2,R3,R4,R5>
	MOVL	8(AP),R2
	MOVL	12(AP),R3
	MOVAB	HEXBUF,R4
	MOVL	R2,R5
10$:	TSTL	R5
	BEQL	20$
	MOVZBL	(R3)+,R0
	EXTZV	#4,#4,R0,R1
	MOVB	HEXC[R1],(R4)+
	BICL3	#^XFFFFFFF0,R0,R1
	MOVB	HEXC[R1],(R4)+
	MOVB	#^A/ /,(R4)+
	DECL	R5
	BRB	10$
20$:	MULL3	#3,R2,R0
	MOVAB	HEXBUF,R1
	PUSHL	R1
	PUSHL	R0
	PUSHL	4(AP)
	CALLS	#3,PRINT
	RET

; SCAN(string): $FILESCAN of a string, every part, and the flags.
	.ENTRY	SCAN,^M<R2,R3,R4,R5>
	MOVL	4(AP),R2
	MOVZWL	(R2),R3
	MOVL	4(R2),R4
	P	<!/scan "!AF">,R3,R4
	$FILESCAN_S SRCSTR=(R2),VALUELST=SCANI,FLDFLAGS=SCANF
	MOVL	R0,R5
	P	<  R0=!XL flags=!XL>,R5,SCANF
	MOVAL	SCANI,R2
10$:	TSTL	(R2)
	BEQL	20$
	MOVZWL	2(R2),R0
	MOVZWL	(R2),R1
	CLRL	R5
	TSTL	4(R2)
	BEQL	15$
	SUBL3	R4,4(R2),R5
15$:	PUSHL	R5
	PUSHL	R1
	PUSHL	R0
	PUSHAB	SCANF2
	CALLS	#4,PRINT
	ADDL2	#8,R2
	BRB	10$
20$:	RET

	.PSECT	TEXT
ACTLOGF:	.ASCID	\  action r0low=!UL argc=!XL block=!SL\
CASEF:	.ASCID	\!/!AS\
MAPF:	.ASCID	\!/map !AS\
DUMPF:	.ASCID	\  !AD\
HEXC:	.ASCII	/0123456789ABCDEF/
SCANF2:	.ASCID	\  item !UL len=!UL at=!UL\
	.PSECT	DATA
HEXBUF:	.BLKB	64

H_11223344 = ^X11223344
H_55667788 = ^X55667788
H_01020304 = ^X01020304
H_05060708 = ^X05060708
H_1230 = ^X1230
H_1240 = ^X1240
H_0F = ^X0F
H_F0 = ^XF0
H_1 = ^X1
H_2 = ^X2
H_4 = ^X4
H_8 = ^X8
	$INIT_STATE	DT,DK
	$STATE D1
	$TRAN 'A'
	$TRAN 'B',D1
	$TRAN 'C',TPA$_EXIT
	$TRAN 'D',TPA$_FAIL
	$STATE
	$TRAN 'KW1'
	$TRAN 'KW2',D1
	$TRAN 'K*'
	$STATE
	$TRAN 'KW3'
	$TRAN 'KW1'
	$STATE D2
	$TRAN !D1
	$TRAN !D1,D2
	$TRAN !D1,TPA$_EXIT
	$STATE
	$TRAN TPA$_ANY,,D1
	$TRAN TPA$_ALPHA,,,H_11223344,D1
	$TRAN TPA$_DIGIT,,,,D1
	$TRAN TPA$_STRING,,,,,H_55667788
	$STATE
	$TRAN TPA$_SYMBOL,D2,D1,H_01020304,D2,H_05060708
	$TRAN !D2,D2,D1,H_01020304,D2,H_05060708
	$TRAN 'KW4',D2,D1,H_01020304,D2,H_05060708
	$STATE
	$TRAN TPA$_BLANK
	$TRAN TPA$_DECIMAL
	$TRAN TPA$_OCTAL
	$TRAN TPA$_HEX
	$TRAN TPA$_LAMBDA
	$TRAN TPA$_EOS
	$TRAN TPA$_UIC
	$TRAN TPA$_IDENT
	$TRAN TPA$_FILESPEC
	$STATE
	$TRAN EIGHT
	$TRAN COMMA
	$TRAN <','>
	$TRAN '/'
	$TRAN '='
	$TRAN TWO
	$END_STATE

	$INIT_STATE	TP,KT
	$STATE	CHAR
