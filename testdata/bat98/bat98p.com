$ ! BAT98P.COM - Phase 98's probe: who may do what to a queue. Written
$ ! by testdata/bat98/gen.go. BAT98.COM submits it as each probe account
$ ! for each protection state of BAT98_P:
$ !
$ !     P1  the state's letter
$ !     P2  SYSTEM's held jobs in BAT98_P, one for each pass
$ !     P3  a job of SYSTEM's retained in BAT98_P
$ !
$ ! BAT98O, authorized for every privilege, tries everything once with
$ ! none of them, then once with each (or each pair) enabled; the others
$ ! once with what they have.
$ !
$ SET NOON
$ WHO = F$EDIT(F$GETJPI("","USERNAME"),"TRIM")
$ WRITE SYS$OUTPUT "######## BAT98P STATE ", P1, " AS ", WHO
$ PASSES = "NONE"
$ IF WHO .EQS. "BAT98O" THEN PASSES = "NONE,OPER,ALTPRI,CMKRNL,CMKRNL+SYSPRV,SYSNAM,BYPASS,SYSPRV,GRPPRV,READALL,SECURITY,WORLD,GROUP"
$ R = P3
$ I = 0
$ PASS:
$ P = F$ELEMENT(I,",",PASSES)
$ IF P .EQS. "," THEN GOTO FINISHED
$ H = F$ELEMENT(I,",",P2)
$ IF H .EQS. "," THEN H = ""
$ D = "BAT98_D" + F$STRING(I+1)
$ PRIVS = "TMPMBX,NETMBX"
$ J = 0
$ PRIV_LOOP:
$ Q = F$ELEMENT(J,"+",P)
$ IF Q .EQS. "+" THEN GOTO PRIV_DONE
$ IF Q .NES. "NONE" THEN PRIVS = PRIVS + "," + Q
$ J = J + 1
$ GOTO PRIV_LOOP
$ PRIV_DONE:
$ SET PROCESS/PRIVILEGES=NOALL
$ SET PROCESS/PRIVILEGES=('PRIVS')
$ WRITE SYS$OUTPUT "######## PASS ", P, " AS ", WHO, " STATE ", P1, " HELD ", H, " RETAINED ", R, " QUEUE ", D
$ SHOW PROCESS/PRIVILEGES
$ WRITE SYS$OUTPUT "== ''P' 1"
$ SHOW QUEUE BAT98_P
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== ''P' 2"
$ SHOW QUEUE/FULL/ALL BAT98_P
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== ''P' 3"
$ IF R .EQS. "" THEN WRITE SYS$OUTPUT "  NO R"
$ IF R .NES. "" THEN SHOW ENTRY 'R'
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== ''P' 4"
$ IF H .EQS. "" THEN WRITE SYS$OUTPUT "  NO H"
$ IF H .NES. "" THEN SHOW ENTRY/FULL 'H'
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== ''P' 5"
$ WRITE SYS$OUTPUT "  GETQUI PROTECTION ", F$GETQUI("DISPLAY_QUEUE","PROTECTION","BAT98_P")
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== ''P' 6"
$ WRITE SYS$OUTPUT "  GETQUI OWNER ", F$GETQUI("DISPLAY_QUEUE","OWNER_UIC","BAT98_P")
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== ''P' 7"
$ IF F$TYPE($ENTRY) .NES. "" THEN DELETE/SYMBOL/LOCAL $ENTRY
$ SUBMIT/QUEUE=BAT98_P/HOLD/NOPRINTER/NOLOG_FILE/NAME=OWN98 BAT98$DISK:[000000]BAT98OK
$ SHOW SYMBOL $STATUS
$ OWN = ""
$ IF F$TYPE($ENTRY) .NES. "" THEN OWN = $ENTRY
$ WRITE SYS$OUTPUT "  OWN = ", OWN
$ WRITE SYS$OUTPUT "== ''P' 8"
$ IF OWN .EQS. "" THEN WRITE SYS$OUTPUT "  NO OWN"
$ IF OWN .NES. "" THEN SHOW ENTRY 'OWN'
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== ''P' 9"
$ IF OWN .EQS. "" THEN WRITE SYS$OUTPUT "  NO OWN"
$ IF OWN .NES. "" THEN SET ENTRY 'OWN'/NOTE="OWN NOTE"
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== ''P' 10"
$ IF F$TYPE($ENTRY) .NES. "" THEN DELETE/SYMBOL/LOCAL $ENTRY
$ SUBMIT/QUEUE=BAT98_P/HOLD/NOPRINTER/NOLOG_FILE/PRIORITY=200 BAT98$DISK:[000000]BAT98OK
$ SHOW SYMBOL $STATUS
$ HI = ""
$ IF F$TYPE($ENTRY) .NES. "" THEN HI = $ENTRY
$ WRITE SYS$OUTPUT "  HI = ", HI
$ WRITE SYS$OUTPUT "== ''P' 11"
$ IF HI .EQS. "" THEN WRITE SYS$OUTPUT "  NO HI"
$ IF HI .NES. "" THEN DELETE/ENTRY='HI' BAT98_P
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== ''P' 12"
$ IF F$TYPE($ENTRY) .NES. "" THEN DELETE/SYMBOL/LOCAL $ENTRY
$ SUBMIT/QUEUE=BAT98_P/HOLD/NOPRINTER/NOLOG_FILE/USER=BAT98W BAT98$DISK:[000000]BAT98OK
$ SHOW SYMBOL $STATUS
$ OTH = ""
$ IF F$TYPE($ENTRY) .NES. "" THEN OTH = $ENTRY
$ WRITE SYS$OUTPUT "  OTH = ", OTH
$ WRITE SYS$OUTPUT "== ''P' 13"
$ IF OTH .EQS. "" THEN WRITE SYS$OUTPUT "  NO OTH"
$ IF OTH .NES. "" THEN DELETE/ENTRY='OTH' BAT98_P
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== ''P' 14"
$ IF H .EQS. "" THEN WRITE SYS$OUTPUT "  NO H"
$ IF H .NES. "" THEN SET ENTRY 'H'/NOTE="CHANGED"
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== ''P' 15"
$ IF R .EQS. "" THEN WRITE SYS$OUTPUT "  NO R"
$ IF R .NES. "" THEN SYNCHRONIZE/ENTRY='R'
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== ''P' 16"
$ IF H .EQS. "" THEN WRITE SYS$OUTPUT "  NO H"
$ IF H .NES. "" THEN STOP/QUEUE/ENTRY='H' BAT98_P
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== ''P' 17"
$ STOP/QUEUE/NEXT BAT98_P
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== ''P' 18"
$ START/QUEUE BAT98_P
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== ''P' 19"
$ SET QUEUE/JOB_LIMIT=2 BAT98_P
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== ''P' 20"
$ SET QUEUE/JOB_LIMIT=1 BAT98_P
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== ''P' 21"
$ INITIALIZE/QUEUE/BATCH BAT98_X
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== ''P' 22"
$ DELETE/QUEUE BAT98_X
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== ''P' 23"
$ SET SECURITY/CLASS=QUEUE/ACL=(IDENTIFIER=[300,10],ACCESS=READ) 'D'
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== ''P' 24"
$ SHOW SECURITY/CLASS=QUEUE 'D'
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== ''P' 25"
$ INITIALIZE/QUEUE/BATCH/JOB_LIMIT=2 'D'
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== ''P' 26"
$ START/QUEUE 'D'
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== ''P' 27"
$ STOP/QUEUE/NEXT 'D'
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== ''P' 28"
$ DELETE/QUEUE 'D'
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== ''P' 29"
$ IF OWN .EQS. "" THEN WRITE SYS$OUTPUT "  NO OWN"
$ IF OWN .NES. "" THEN DELETE/ENTRY='OWN' BAT98_P
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== ''P' 30"
$ IF H .EQS. "" THEN WRITE SYS$OUTPUT "  NO H"
$ IF H .NES. "" THEN DELETE/ENTRY='H' BAT98_P
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== ''P' 31"
$ SHOW QUEUE/MANAGER
$ SHOW SYMBOL $STATUS
$ I = I + 1
$ GOTO PASS
$ FINISHED:
$ SET PROCESS/PRIVILEGES=NOALL
$ SET PROCESS/PRIVILEGES=(TMPMBX,NETMBX)
$ WRITE SYS$OUTPUT "BAT98P FINISHED"
$ EXIT
