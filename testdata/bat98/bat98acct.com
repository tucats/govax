$ ! BAT98ACCT.COM - Phase 98's probe: the accounts, in the VAX's own
$ ! SYSUAF. Written by testdata/bat98/gen.go. BAT98.COM runs it as SYSTEM;
$ ! BAT98DROP.COM undoes everything it does.
$ !
$ !   BAT98   [200,10]  TMPMBX, NETMBX; holds the identifier BAT98_ID
$ !   BAT98O  [200,11]  authorized for every privilege, TMPMBX and NETMBX
$ !                     by default
$ !   BAT98W  [300,10]  TMPMBX, NETMBX; another group
$ !
$ ! Each has the password BAT98PW (nothing logs in with it: a batch
$ ! job's login asks for none) and a home of its own on the exchange
$ ! volume, with a LOGIN.COM that says when it ran.
$ !
$ SET NOON
$ SET VERIFY
$ WRITE SYS$OUTPUT "######## ACCOUNTS"
$ IF F$TRNLNM("SYSUAF","LNM$PROCESS") .NES. "" THEN DEASSIGN/PROCESS/EXECUTIVE_MODE SYSUAF
$ IF F$TRNLNM("RIGHTSLIST","LNM$PROCESS") .NES. "" THEN DEASSIGN/PROCESS/EXECUTIVE_MODE RIGHTSLIST
$ HOME = F$ENVIRONMENT("DEFAULT")
$ SET DEFAULT SYS$SYSTEM
$ MCR AUTHORIZE
ADD BAT98/UIC=[200,10]/PASSWORD=BAT98PW/FLAGS=NODISUSER
MODIFY BAT98/DEVICE=BAT98$DISK:/DIRECTORY=[BAT98]/ACCOUNT=GOVAX98/OWNER="GOVAX PROBE"
MODIFY BAT98/PRIVILEGES=(TMPMBX,NETMBX)/DEFPRIVILEGES=(TMPMBX,NETMBX)/LGICMD=""
COPY BAT98 BAT98O/UIC=[200,11]/PASSWORD=BAT98PW
MODIFY BAT98O/DIRECTORY=[BAT98O]/PRIVILEGES=ALL/DEFPRIVILEGES=(TMPMBX,NETMBX)
COPY BAT98 BAT98W/UIC=[300,10]/PASSWORD=BAT98PW
MODIFY BAT98W/DIRECTORY=[BAT98W]
ADD/IDENTIFIER BAT98_ID
GRANT/IDENTIFIER BAT98_ID BAT98
SHOW BAT98/FULL
SHOW BAT98O/FULL
SHOW BAT98W/FULL
EXIT
$ SET DEFAULT 'HOME'
$ !
$ ! Each home owned by its account, with its LOGIN.COM.
$ SET SECURITY/OWNER=[200,10]/PROTECTION=(S:RWE,O:RWE,G:RE,W:RE) BAT98$DISK:[000000]BAT98.DIR
$ SET SECURITY/OWNER=[200,10]/PROTECTION=(S:RWED,O:RWED,G:RE,W:RE) BAT98$DISK:[BAT98]*.*;*
$ DIRECTORY/SECURITY BAT98$DISK:[BAT98]
$ SET SECURITY/OWNER=[200,11]/PROTECTION=(S:RWE,O:RWE,G:RE,W:RE) BAT98$DISK:[000000]BAT98O.DIR
$ SET SECURITY/OWNER=[200,11]/PROTECTION=(S:RWED,O:RWED,G:RE,W:RE) BAT98$DISK:[BAT98O]*.*;*
$ DIRECTORY/SECURITY BAT98$DISK:[BAT98O]
$ SET SECURITY/OWNER=[300,10]/PROTECTION=(S:RWE,O:RWE,G:RE,W:RE) BAT98$DISK:[000000]BAT98W.DIR
$ SET SECURITY/OWNER=[300,10]/PROTECTION=(S:RWED,O:RWED,G:RE,W:RE) BAT98$DISK:[BAT98W]*.*;*
$ DIRECTORY/SECURITY BAT98$DISK:[BAT98W]
$ EXIT
