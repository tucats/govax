$ ! BAT98B.COM - Phase 98's probe of batch queues: round 2, SYSTEM's run,
$ ! BAT98Q again with its output items corrected. Written by
$ ! testdata/bat98/gen.go. Run it as SYSTEM, from the exchange volume,
$ ! mounted /SYSTEM (README.md, "Round 2"):
$ !
$ !     @DUA1:[000000]BAT98B
$ !
$ ! Its log is BAT98$DISK:[BAT98LOG]BAT98B.LOG.
$ !
$ IF P1 .EQS. "LOGGED" THEN GOTO BEGIN
$ BEGIN:
$ SET NOON
$ SET VERIFY
$ WRITE SYS$OUTPUT F$GETSYI("VERSION"), " ", F$GETSYI("NODENAME"), " ", F$TIME()
V7.1     SIMVAX 16-NOV-2026 13:28:09.84
$ SHOW QUEUE/MANAGER
Queue manager SYS$QUEUE_MANAGER, running, on SIMVAX::
$ @BAT98$DISK:[000000]BAT98Z BAT98_Q
$ ! BAT98Z.COM - Phase 98's probe: its queues taken away. Written by
$ ! testdata/bat98/gen.go. With a queue's name as P1, that queue; with
$ ! none, every queue the probe makes. Each is reset (its executing jobs
$ ! aborted) and deleted, with its jobs.
$ !
$ SET NOON
$ IF P1 .NES. "" THEN GOTO ONE
$ ONE:
$ X = F$GETQUI("CANCEL_OPERATION")
$ Q = ""
$ Q = F$GETQUI("DISPLAY_QUEUE","QUEUE_NAME",P1)
$ IF Q .EQS. "" THEN EXIT
$ @BAT98$DISK:[000000]BAT98Z BAT98_Q2
$ ! BAT98Z.COM - Phase 98's probe: its queues taken away. Written by
$ ! testdata/bat98/gen.go. With a queue's name as P1, that queue; with
$ ! none, every queue the probe makes. Each is reset (its executing jobs
$ ! aborted) and deleted, with its jobs.
$ !
$ SET NOON
$ IF P1 .NES. "" THEN GOTO ONE
$ ONE:
$ X = F$GETQUI("CANCEL_OPERATION")
$ Q = ""
$ Q = F$GETQUI("DISPLAY_QUEUE","QUEUE_NAME",P1)
$ IF Q .EQS. "" THEN EXIT
$ !
$ WRITE SYS$OUTPUT "######## SERVICES"
######## SERVICES
$ SET DEFAULT BAT98$DISK:[000000]
$ WRITE SYS$OUTPUT "== 1"
== 1
$ MACRO DEF_SJC
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ WRITE SYS$OUTPUT "== 2"
== 2
$ MACRO DEF_QUI
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ WRITE SYS$OUTPUT "== 3"
== 3
$ MACRO DEF_JBC
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ WRITE SYS$OUTPUT "== 4"
== 4
$ MACRO BAT98Q
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ WRITE SYS$OUTPUT "== 5"
== 5
$ LINK BAT98Q
$ SHOW SYMBOL $STATUS
  $STATUS == "%X10000001"
$ WRITE SYS$OUTPUT "== 6"
== 6
$ RUN BAT98Q
