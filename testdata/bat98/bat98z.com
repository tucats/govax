$ ! BAT98Z.COM - Phase 98's probe: its queues taken away. Written by
$ ! testdata/bat98/gen.go. With a queue's name as P1, that queue; with
$ ! none, every queue the probe makes. Each is reset (its executing jobs
$ ! aborted) and deleted, with its jobs.
$ !
$ SET NOON
$ IF P1 .NES. "" THEN GOTO ONE
$ @'F$ENVIRONMENT("PROCEDURE")' BAT98_A
$ @'F$ENVIRONMENT("PROCEDURE")' BAT98_B
$ @'F$ENVIRONMENT("PROCEDURE")' BAT98_D
$ @'F$ENVIRONMENT("PROCEDURE")' BAT98_E
$ @'F$ENVIRONMENT("PROCEDURE")' BAT98_P
$ @'F$ENVIRONMENT("PROCEDURE")' BAT98_X
$ @'F$ENVIRONMENT("PROCEDURE")' BAT98_Q
$ @'F$ENVIRONMENT("PROCEDURE")' BAT98_Q2
$ @'F$ENVIRONMENT("PROCEDURE")' BAT98_D1
$ @'F$ENVIRONMENT("PROCEDURE")' BAT98_D2
$ @'F$ENVIRONMENT("PROCEDURE")' BAT98_D3
$ @'F$ENVIRONMENT("PROCEDURE")' BAT98_D4
$ @'F$ENVIRONMENT("PROCEDURE")' BAT98_D5
$ @'F$ENVIRONMENT("PROCEDURE")' BAT98_D6
$ @'F$ENVIRONMENT("PROCEDURE")' BAT98_D7
$ @'F$ENVIRONMENT("PROCEDURE")' BAT98_D8
$ @'F$ENVIRONMENT("PROCEDURE")' BAT98_D9
$ @'F$ENVIRONMENT("PROCEDURE")' BAT98_D10
$ @'F$ENVIRONMENT("PROCEDURE")' BAT98_D11
$ @'F$ENVIRONMENT("PROCEDURE")' BAT98_D12
$ @'F$ENVIRONMENT("PROCEDURE")' BAT98_D13
$ EXIT
$ ONE:
$ X = F$GETQUI("CANCEL_OPERATION")
$ Q = ""
$ Q = F$GETQUI("DISPLAY_QUEUE","QUEUE_NAME",P1)
$ IF Q .EQS. "" THEN EXIT
$ STOP/QUEUE/RESET 'P1'
$ DELETE/QUEUE 'P1'
$ EXIT
