$ ! BAT98B.COM - Phase 98's probe of batch queues: round 2, SYSTEM's run.
$ ! Written by testdata/bat98/gen.go. Run it as SYSTEM, from the exchange
$ ! volume, mounted /SYSTEM, after round 1 and before BAT98DROP.COM
$ ! (README.md, "Round 2"):
$ !
$ !     @DUA1:[000000]BAT98B
$ !
$ ! Its log is BAT98$DISK:[BAT98LOG]BAT98B.LOG.
$ !
$ IF P1 .EQS. "LOGGED" THEN GOTO BEGIN
$ HERE = F$ENVIRONMENT("PROCEDURE")
$ DEV = F$PARSE(HERE,,,"DEVICE")
$ DEFINE/SYSTEM/EXECUTIVE_MODE BAT98$DISK 'DEV'
$ LOGFILE = DEV + "[BAT98LOG]BAT98B.LOG"
$ @'HERE'/OUTPUT='LOGFILE' LOGGED
$ WRITE SYS$OUTPUT "BAT98B finished; the log is ", LOGFILE
$ EXIT
$ BEGIN:
$ SET NOON
$ SET VERIFY
$ !
$ WRITE SYS$OUTPUT "######## ENVIRONMENT"
$ WRITE SYS$OUTPUT F$GETSYI("VERSION"), " ", F$GETSYI("NODENAME"), " ", F$TIME()
$ SHOW QUEUE/MANAGER/FULL
$ SHOW QUEUE/FULL/ALL BAT98*
$ SET SECURITY/PROTECTION=(S:RWED,O:RWED,G:RE,W:RE) BAT98$DISK:[000000]*.COM;*
$ SET SECURITY/PROTECTION=(S:RWED,O:RWED,G:RE,W:RE) BAT98$DISK:[000000]*.MAR;*
$ DIRECTORY/SECURITY BAT98$DISK:[000000]
$ MCR AUTHORIZE SHOW BAT98*/BRIEF
$ INITIALIZE/QUEUE/BATCH/JOB_LIMIT=3/BASE_PRIORITY=3/RETAIN=ERROR/START BAT98_A
$ SHOW QUEUE/FULL BAT98_A
$ SET DEFAULT BAT98$DISK:[BAT98SCR]
$ !
$ WRITE SYS$OUTPUT "######## RESTART"
$ DELETE BAT98$DISK:[BAT98SCR]*.RUN;*
$ WRITE SYS$OUTPUT "== 1"
$ IF F$TYPE($ENTRY) .NES. "" THEN DELETE/SYMBOL/LOCAL $ENTRY
$ SUBMIT/QUEUE=BAT98_A/NOPRINTER/KEEP/NAME=BAT98X3B/LOG_FILE=BAT98$DISK:[BAT98LOG]BAT98X3B.LOG/RESTART/PARAMETERS=BAT98X3B BAT98$DISK:[000000]BAT98R
$ SHOW SYMBOL $STATUS
$ X3 = ""
$ IF F$TYPE($ENTRY) .NES. "" THEN X3 = $ENTRY
$ WRITE SYS$OUTPUT "  X3 = ", X3
$ CALL AWAIT BAT98X3B 'X3'
$ WRITE SYS$OUTPUT "== 2"
$ STOP/QUEUE/REQUEUE/HOLD/ENTRY='X3' BAT98_A
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== 3"
$ SHOW ENTRY/FULL 'X3'
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== 4"
$ SET ENTRY 'X3'/RELEASE
$ SHOW SYMBOL $STATUS
$ CALL RELEASE 'X3'
$ WRITE SYS$OUTPUT "== 5"
$ SHOW ENTRY/FULL 'X3'
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== 6"
$ IF X3 .NES. "" THEN SYNCHRONIZE/ENTRY='X3'
$ SHOW SYMBOL $STATUS
$ DIRECTORY/SIZE/OWNER/PROTECTION BAT98$DISK:[BAT98LOG]BAT98X3B.LOG;*
$ TYPE BAT98$DISK:[BAT98LOG]BAT98X3B.LOG;*
$ !
$ WRITE SYS$OUTPUT "######## THE JOB'S VIEW"
$ WRITE SYS$OUTPUT "== 7"
$ IF F$TYPE($ENTRY) .NES. "" THEN DELETE/SYMBOL/LOCAL $ENTRY
$ SUBMIT/QUEUE=BAT98_A/NOPRINTER/KEEP/NAME=BAT98V_SYSTEM/LOG_FILE=BAT98$DISK:[BAT98LOG]BAT98V_SYSTEM.LOG/PARAMETERS=(ALPHA,"two words",3,"",E,F,G,"H h") BAT98$DISK:[000000]BAT98J
$ SHOW SYMBOL $STATUS
$ V1 = ""
