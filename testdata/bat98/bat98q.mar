; The program: each case, then the messages.
	.ENTRY	START,^M<>
	CALLS	#0,C1
	CALLS	#0,C2
	CALLS	#0,C3
	CALLS	#0,C4
	CALLS	#0,C5
	CALLS	#0,C6
	CALLS	#0,C7
	CALLS	#0,C8
	CALLS	#0,C9
	CALLS	#0,C10
	CALLS	#0,C11
	CALLS	#0,C12
	CALLS	#0,C13
	CALLS	#0,C14
	CALLS	#0,C15
	CALLS	#0,C16
	CALLS	#0,C17
	CALLS	#0,C18
	CALLS	#0,C19
	CALLS	#0,C20
	CALLS	#0,C21
	CALLS	#0,C22
	CALLS	#0,C23
	CALLS	#0,C24
	CALLS	#0,C25
	CALLS	#0,C26
	CALLS	#0,C27
	CALLS	#0,C28
	CALLS	#0,C29
	CALLS	#0,C30
	CALLS	#0,C31
	CALLS	#0,C32
	CALLS	#0,C33
	CALLS	#0,C34
	CALLS	#0,C35
	CALLS	#0,C36
	CALLS	#0,C37
	CALLS	#0,C38
	CALLS	#0,C39
	CALLS	#0,C40
	CALLS	#0,C41
	CALLS	#0,C42
	CALLS	#0,C43
	CALLS	#0,C44
	CALLS	#0,C45
	CALLS	#0,C46
	CALLS	#0,C47
	CALLS	#0,C48
	CALLS	#0,C49
	CALLS	#0,C50
	CALLS	#0,C51
	CALLS	#0,C52
	CALLS	#0,C53
	CALLS	#0,C54
	CALLS	#0,C55
	CALLS	#0,C56
	CALLS	#0,C57
	CALLS	#0,C58
	CALLS	#0,C59
	CALLS	#0,MESSAGES
	SAY	</BAT98Q FINISHED/>
	MOVL	#SS$_NORMAL,R0
	RET

; SAYR text, a1, ...: format and write one line.
	.ENTRY	SAYR,^M<R2,R3,R4,R5>
	MOVL	#300,OUTD
	$FAOL_S	CTRSTR=@4(AP),OUTLEN=OUTLEN,OUTBUF=OUTD,PRMLST=8(AP)
	MOVZWL	OUTLEN,OUTD
	PUSHAQ	OUTD
	CALLS	#1,G^LIB$PUT_OUTPUT
	MOVL	#300,OUTD
	RET

; MSGTEXT status: its message in MSGBUF, MSGLEN long (0 if none); R0 is
; $GETMSG's status.
	.ENTRY	MSGTEXT,^M<>
	MOVL	#256,MSGD
	CLRW	MSGLEN
	CLRL	-(SP)			; outadr
	PUSHL	#15			; flags: every part
	PUSHAQ	MSGD
	PUSHAW	MSGLEN
	PUSHL	4(AP)			; msgid
	CALLS	#5,G^SYS$GETMSG
	BLBS	R0,1$
	CLRW	MSGLEN
1$:	RET

; SHOWST r0: the service's R0 and the IOSB's status, each with its message.
	.ENTRY	SHOWST,^M<R2>
	PUSHL	4(AP)
	CALLS	#1,MSGTEXT
	MOVZWL	MSGLEN,R2
	SAY	</  R0   !XL !AD/>,4(AP),R2,#MSGBUF
	PUSHL	IOSB
	CALLS	#1,MSGTEXT
	MOVZWL	MSGLEN,R2
	SAY	</  IOSB !XL !XL !AD/>,IOSB,IOSB+4,R2,#MSGBUF
	RET

; SHOWITEM name, buffer, length word: an output item's returned length and
; its bytes (at most 256), 16 to a line, in hex and as text.
	.ENTRY	SHOWITEM,^M<R2,R3,R4,R5,R6,R7,R8,R9>
	MOVZWL	@12(AP),R2
	SAY	</  !AS len=!UL/>,4(AP),R2
	MOVL	8(AP),R3
	CMPL	R2,#256
	BLEQ	1$
	MOVL	#256,R2
1$:	TSTL	R2
	BNEQ	2$
	BRW	9$
2$:	MOVL	R2,R4			; this line's bytes
	CMPL	R4,#16
	BLEQ	3$
	MOVL	#16,R4
3$:	MOVAB	HEXLINE,R5
	MOVAB	ASCLINE,R7
	MOVL	R4,R6
4$:	MOVZBL	(R3)+,R8
	EXTZV	#4,#4,R8,R9
	MOVB	HEXDIG[R9],(R5)+
	EXTZV	#0,#4,R8,R9
	MOVB	HEXDIG[R9],(R5)+
	MOVB	#^A/ /,(R5)+
	CMPB	R8,#^A/ /
	BLSSU	5$
	CMPB	R8,#^A/~/
	BGTRU	5$
	MOVB	R8,(R7)+
	BRB	6$
5$:	MOVB	#^A/./,(R7)+
6$:	SOBGTR	R6,4$
	MOVAB	HEXLINE,R8
	SUBL3	R8,R5,R8
	MOVAB	ASCLINE,R9
	SUBL3	R9,R7,R9
	SAY	</    !48<!AD!> |!AD|/>,R8,#HEXLINE,R9,#ASCLINE
	SUBL2	R4,R2
	BLEQ	9$
	BRW	2$
9$:	RET

; MESSAGES: every message of the JBC facility $GETMSG knows, by message
; number (0 to 1023) and severity (0 to 7).
	.ENTRY	MESSAGES,^M<R2,R3,R4,R5,R6>
	SAY	</######## JBC MESSAGES/>
	MOVL	#JBC$_NORMAL,R2
	BICL2	#^XF000FFFF,R2		; the facility, bits 16 to 27
	SAY	</  JBC$_NORMAL !XL/>,#JBC$_NORMAL
	CLRL	R3
1$:	CLRL	R4
2$:	ASHL	#3,R3,R5
	BISL2	R2,R5
	BISL2	R4,R5
	PUSHL	R5
	CALLS	#1,MSGTEXT
	CMPL	R0,#SS$_NORMAL
	BNEQ	3$
	MOVZWL	MSGLEN,R6
	SAY	</  !XL !AD/>,R5,R6,#MSGBUF
3$:	AOBLEQ	#7,R4,2$
	AOBLEQ	#1023,R3,1$
	RET

	.END	START
