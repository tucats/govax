	CALLS	#7,G^SYS$SNDJBCW
	PUSHL	R0
	CALLS	#1,SHOWST
	RET

; 54: ALTER_QUEUE
	.ENTRY	C54,^M<R2,R3,R4,R5,R6,R7,R8,R9>
	PUSHAQ	C54_T
	CALLS	#1,SAYR
	CLRQ	IOSB
	CLRL	-(SP)		; astprm
	CLRL	-(SP)		; astadr
	PUSHAQ	IOSB
	PUSHAB	C54_IL
	CLRL	-(SP)		; nullarg or context
	PUSHL	#SJC$_ALTER_QUEUE
	CLRL	-(SP)		; efn
	CALLS	#7,G^SYS$SNDJBCW
	PUSHL	R0
	CALLS	#1,SHOWST
	RET

; 55: DISPLAY_QUEUE after ALTER_QUEUE
	.ENTRY	C55,^M<R2,R3,R4,R5,R6,R7,R8,R9>
	PUSHAQ	C55_T
	CALLS	#1,SAYR
	CLRQ	IOSB
	CLRL	-(SP)		; astprm
	CLRL	-(SP)		; astadr
	PUSHAQ	IOSB
	PUSHAB	C55_IL
	CLRL	-(SP)		; nullarg or context
	PUSHL	#QUI$_DISPLAY_QUEUE
	CLRL	-(SP)		; efn
	CALLS	#7,G^SYS$GETQUIW
	PUSHL	R0
	CALLS	#1,SHOWST
	PUSHAW	C55_R2
	PUSHAB	C55_B2
	PUSHAQ	C55_N2
	CALLS	#3,SHOWITEM
	PUSHAW	C55_R3
	PUSHAB	C55_B3
	PUSHAQ	C55_N3
	CALLS	#3,SHOWITEM
	PUSHAW	C55_R4
	PUSHAB	C55_B4
	PUSHAQ	C55_N4
	CALLS	#3,SHOWITEM
	RET

