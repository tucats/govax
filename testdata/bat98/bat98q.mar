	.TITLE	BAT98Q	Phase 98's probe of $SNDJBC and $GETQUI
	.IDENT	/V1.0/
;
; Written by testdata/bat98/gen.go: do not edit. Each case calls
; $SNDJBCW or $GETQUIW with an item list, and shows R0 and the IOSB's
; status (each with its message) and every output item: the length the
; service returned and the bytes, in hex and as text. At the end it lists
; the JBC facility's messages by $GETMSG. BAT98.COM runs it as SYSTEM;
; it works on queues of its own, BAT98_Q and BAT98_Q2.
;
	$SSDEF
	$SJCDEF
	$QUIDEF
	$JBCMSGDEF

; SAY text, a1, ... a10: format text with $FAOL and the arguments (each
; a longword, pushed by value) and write the line.
	.MACRO	SAY	TEXT,A1,A2,A3,A4,A5,A6,A7,A8,A9,A10,?LBL,?OVER
	BRW	OVER
LBL:	.ASCID	TEXT
OVER:
	$$N = 1
	.IRP	ARG,<A10,A9,A8,A7,A6,A5,A4,A3,A2,A1>
	.IF	NOT_BLANK,<ARG>
	PUSHL	ARG
	$$N = $$N + 1
	.ENDC
	.ENDR
	PUSHAQ	LBL
	CALLS	#$$N,SAYR
	.ENDM	SAY

	.PSECT	DATA,WRT,NOEXE,LONG
IOSB:	.QUAD	0
QENTRY:	.LONG	0		; the first job's entry
QE2:	.LONG	0		; BAT98's held job
QE3:	.LONG	0		; the second held job
QE4:	.LONG	0		; the job made by CREATE_JOB
OUTD:	.LONG	300
	.ADDRESS OUTBUF
OUTLEN:	.WORD	0
OUTBUF:	.BLKB	300
MSGD:	.LONG	256
	.ADDRESS MSGBUF
MSGLEN:	.WORD	0
MSGBUF:	.BLKB	256
HEXDIG:	.ASCII	/0123456789ABCDEF/
HEXLINE: .BLKB	64
ASCLINE: .BLKB	32

; 1: CREATE_QUEUE BAT98_Q
C1_T:	.ASCID	|== 1 SNDJBCW CREATE_QUEUE BAT98_Q|
C1_B1:	.ASCII	|BAT98_Q|
	.ALIGN	LONG
C1_B3:	.LONG	2
	.ALIGN	LONG
C1_B4:	.LONG	3
	.ALIGN	LONG
C1_B5:	.LONG	^X00010004
	.ALIGN	LONG
C1_B6:	.LONG	150
C1_B7:	.ASCII	|BAT98 Q|
	.ALIGN	LONG
C1_IL:
	.WORD	7,SJC$_QUEUE
	.ADDRESS C1_B1
	.LONG	0
	.WORD	0,SJC$_BATCH
	.LONG	0,0
	.WORD	4,SJC$_JOB_LIMIT
	.ADDRESS C1_B3
	.LONG	0
	.WORD	4,SJC$_BASE_PRIORITY
	.ADDRESS C1_B4
	.LONG	0
	.WORD	4,SJC$_OWNER_UIC
	.ADDRESS C1_B5
	.LONG	0
	.WORD	4,SJC$_WSDEFAULT
	.ADDRESS C1_B6
	.LONG	0
	.WORD	7,SJC$_QUEUE_DESCRIPTION
	.ADDRESS C1_B7
	.LONG	0
	.LONG	0

