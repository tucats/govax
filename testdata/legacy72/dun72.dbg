! DUN72.DBG - Phase 72's debugger session on DUNGEON.EXE, a VMS V1
! image (README.md). Addresses are given with %X: DUNGEON is FORTRAN,
! whose default radix is decimal.
!
! Where the debugger starts, and how it names the language and module.
SHOW LANGUAGE
SHOW RADIX
SHOW CALLS
EXAMINE/INSTRUCTION .PC
!
! The images: where DUNGEON's sections and VMSRTL (and what VMSRTL
! uses) were mapped.
SHOW IMAGE
SHOW MODULE
!
! The startup stub, the first transfer address: a jump to the old
! SYS$IMGSTA.
EXAMINE/WORD %X1A433
EXAMINE/INSTRUCTION %X1A435
!
! The old system service vector in S0: SYS$IMGSTA (^X168), SYS$NUMTIM
! (^X1B8, the one service DUNGEON calls there), and the first entry,
! each as its entry mask and its first two instructions; then the same
! P1 vector entries.
EXAMINE/WORD %X80000168
EXAMINE/INSTRUCTION %X8000016A
EXAMINE/INSTRUCTION
EXAMINE/WORD %X800001B8
EXAMINE/INSTRUCTION %X800001BA
EXAMINE/INSTRUCTION
EXAMINE/WORD %X80000000
EXAMINE/INSTRUCTION %X80000002
EXAMINE/INSTRUCTION
EXAMINE/WORD %X7FFEDF68
EXAMINE/INSTRUCTION %X7FFEDF6A
EXAMINE/WORD %X7FFEDFB8
EXAMINE/INSTRUCTION %X7FFEDFBA
!
! VMSRTL's transfer vector where DUNGEON calls it (VMSRTL_001, from
! ^X1A600), as longwords, then the entries DUNGEON uses, each as its
! entry mask and its first instruction.
EXAMINE/LONGWORD/HEXADECIMAL %X1A600:%X1A83C
EXAMINE/WORD %X1A600
EXAMINE/INSTRUCTION %X1A602
EXAMINE/WORD %X1A688
EXAMINE/INSTRUCTION %X1A68A
EXAMINE/WORD %X1A6A8
EXAMINE/INSTRUCTION %X1A6AA
EXAMINE/WORD %X1A6F8
EXAMINE/INSTRUCTION %X1A6FA
EXAMINE/WORD %X1A770
EXAMINE/INSTRUCTION %X1A772
EXAMINE/WORD %X1A778
EXAMINE/INSTRUCTION %X1A77A
EXAMINE/WORD %X1A830
EXAMINE/INSTRUCTION %X1A832
EXAMINE/LONGWORD/HEXADECIMAL %X1AA30:%X1AA3C
!
! Whether the old VMSRTL_002 (^X1AE00, 49 pages) and VMSRTL_003
! (^X21000, 2 pages) ranges are mapped, and where VMSRTL ends.
EXAMINE/LONGWORD/HEXADECIMAL %X1AE00
EXAMINE/LONGWORD/HEXADECIMAL %X1DE00
EXAMINE/LONGWORD/HEXADECIMAL %X1E000
EXAMINE/LONGWORD/HEXADECIMAL %X21000
EXAMINE/LONGWORD/HEXADECIMAL %X21200
EXAMINE/LONGWORD/HEXADECIMAL %X21400
!
! Two steps: the second calls INIT, which opens the game's files.
STEP
SHOW CALLS
STEP
SHOW CALLS
