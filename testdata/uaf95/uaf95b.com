$ ! UAF95B.COM - Phase 95's probe, round 3: the login procedures.
$ ! Written by testdata/uaf95/gen.go. Run it as SYSTEM, from a fresh
$ ! exchange volume, mounted /SYSTEM (README.md, "Round 3"):
$ !
$ !     @DUA1:[000000]UAF95B
$ !
$ ! It defines UAF95$DISK, lists identifiers and rights from scratch files,
$ ! makes the accounts (UAF95ACCT.COM), and runs the batch jobs. Its log is
$ ! UAF95$DISK:[UAF95LOG]UAF95B.LOG.
$ !
$ IF P1 .EQS. "LOGGED" THEN GOTO BEGIN
$ HERE = F$ENVIRONMENT("PROCEDURE")
$ DEV = F$PARSE(HERE,,,"DEVICE")
$ DEFINE/SYSTEM/EXECUTIVE_MODE UAF95$DISK 'DEV'
$ LOGFILE = DEV + "[UAF95LOG]UAF95B.LOG"
$ @'HERE'/OUTPUT='LOGFILE' LOGGED
$ WRITE SYS$OUTPUT "UAF95B finished; the log is ", LOGFILE
$ EXIT
$ BEGIN:
$ SET NOON
$ SET VERIFY
$ WRITE SYS$OUTPUT "######## VOLUME"
$ SET VOLUME/PROTECTION=(S:RWCD,O:RWCD,G:RWCD,W:RWCD) UAF95$DISK:
$ SET SECURITY/PROTECTION=(S:RWE,O:RWE,G:RWE,W:RWE) UAF95$DISK:[000000]000000.DIR
$ SET SECURITY/PROTECTION=(S:RWE,O:RWE,G:RWE,W:RWE) UAF95$DISK:[000000]UAF95LOG.DIR
$ SET SECURITY/PROTECTION=(S:RWED,O:RWED,G:RE,W:RE) UAF95$DISK:[000000]*.COM;*
$ DIRECTORY/SECURITY UAF95$DISK:[000000]
$ !
$ WRITE SYS$OUTPUT "######## SCRATCH FILES"
$ SET DEFAULT UAF95$DISK:[UAF95SCR]
$ DEFINE/PROCESS/EXECUTIVE_MODE SYSUAF UAF95$DISK:[UAF95SCR]SYSUAF.DAT
$ DEFINE/PROCESS/EXECUTIVE_MODE RIGHTSLIST UAF95$DISK:[UAF95SCR]RIGHTSLIST.DAT
$ DEFINE/PROCESS/EXECUTIVE_MODE NETPROXY UAF95$DISK:[UAF95SCR]NETPROXY.DAT
$ DEFINE/PROCESS/EXECUTIVE_MODE NET$PROXY UAF95$DISK:[UAF95SCR]NET$PROXY.DAT
$ MCR AUTHORIZE
YES
CREATE/RIGHTS
EXIT
$ IF F$SEARCH("UAF95$DISK:[UAF95SCR]SYSUAF.DAT") .EQS. "" THEN GOTO NO_SCRATCH
$ IF F$SEARCH("UAF95$DISK:[UAF95SCR]RIGHTSLIST.DAT") .EQS. "" THEN GOTO NO_SCRATCH
$ GOTO SCRATCH_MADE
$ NO_SCRATCH:
$ WRITE SYS$OUTPUT "NO SCRATCH SYSUAF.DAT OR RIGHTSLIST.DAT: AUTHORIZE'S CASES NOT RUN"
$ GOTO ACCOUNTS
$ SCRATCH_MADE:
$ WRITE SYS$OUTPUT "######## LIST"
$ WRITE SYS$OUTPUT "== L1"
$ MCR AUTHORIZE ADD UAFA/UIC=[300,1]
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== L2"
$ MCR AUTHORIZE ADD UAFB/UIC=[300,2]
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== L3"
$ MCR AUTHORIZE ADD/IDENTIFIER PROJX
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== L4"
$ MCR AUTHORIZE ADD/IDENTIFIER PROJY/ATTRIBUTES=RESOURCE
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== L5"
$ MCR AUTHORIZE GRANT/IDENTIFIER PROJX UAFA
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== L6"
$ MCR AUTHORIZE GRANT/IDENTIFIER/ATTRIBUTES=RESOURCE PROJY UAFA
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== L7"
$ MCR AUTHORIZE GRANT/IDENTIFIER PROJX UAFB
$ SHOW SYMBOL $STATUS
$ WRITE SYS$OUTPUT "== L8"
$ MCR AUTHORIZE LIST/IDENTIFIER *
$ SHOW SYMBOL $STATUS
$ TYPE UAF95$DISK:[UAF95SCR]RIGHTSLIST.LIS
$ WRITE SYS$OUTPUT "== L9"
$ MCR AUTHORIZE LIST/IDENTIFIER PROJX
$ SHOW SYMBOL $STATUS
$ TYPE UAF95$DISK:[UAF95SCR]RIGHTSLIST.LIS
$ WRITE SYS$OUTPUT "== L10"
$ MCR AUTHORIZE LIST/IDENTIFIER/FULL *
$ SHOW SYMBOL $STATUS
$ TYPE UAF95$DISK:[UAF95SCR]RIGHTSLIST.LIS
$ WRITE SYS$OUTPUT "== L11"
$ MCR AUTHORIZE LIST/RIGHTS UAFA
$ SHOW SYMBOL $STATUS
$ TYPE UAF95$DISK:[UAF95SCR]RIGHTSLIST.LIS
$ WRITE SYS$OUTPUT "== L12"
$ MCR AUTHORIZE LIST/RIGHTS *
$ SHOW SYMBOL $STATUS
$ TYPE UAF95$DISK:[UAF95SCR]RIGHTSLIST.LIS
$ WRITE SYS$OUTPUT "== L13"
$ MCR AUTHORIZE LIST/IDENTIFIER/VALUE=UIC=[300,1]
$ SHOW SYMBOL $STATUS
$ TYPE UAF95$DISK:[UAF95SCR]RIGHTSLIST.LIS
$ ACCOUNTS:
$ DEASSIGN/PROCESS/EXECUTIVE_MODE SYSUAF
$ DEASSIGN/PROCESS/EXECUTIVE_MODE RIGHTSLIST
$ DEASSIGN/PROCESS/EXECUTIVE_MODE NETPROXY
$ DEASSIGN/PROCESS/EXECUTIVE_MODE NET$PROXY
$ SET DEFAULT UAF95$DISK:[000000]
$ !
$ @UAF95$DISK:[000000]UAF95ACCT
$ !
$ WRITE SYS$OUTPUT "######## BATCH"
$ SHOW QUEUE/BATCH/ALL
$ SUBMIT/USER=UAF95/NOPRINTER/KEEP/NAME=UAF95J/LOG_FILE=UAF95$DISK:[UAF95LOG]UAF95J_UAF95.LOG UAF95$DISK:[000000]UAF95I.COM
$ IF F$TYPE($ENTRY) .NES. "" THEN SYNCHRONIZE/ENTRY='$ENTRY'
$ SUBMIT/USER=UAF95L/NOPRINTER/KEEP/NAME=UAF95LJ/LOG_FILE=UAF95$DISK:[UAF95LOG]UAF95J_UAF95L.LOG UAF95$DISK:[000000]UAF95I.COM
$ IF F$TYPE($ENTRY) .NES. "" THEN SYNCHRONIZE/ENTRY='$ENTRY'
$ DIRECTORY UAF95$DISK:[UAF95LOG]
$ WRITE SYS$OUTPUT "UAF95B FINISHED"
$ EXIT
