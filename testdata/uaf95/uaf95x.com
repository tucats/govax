$ ! UAF95X.COM - Phase 95's probe: UAF95L's LGICMD. Written by
$ ! testdata/uaf95/gen.go. After recording, it runs a command that fails
$ ! with a warning, then one that fails with an error, to show what a
$ ! failing login procedure does to the login.
$ !
$ IF F$TYPE(UAF95_ORDER) .EQS. "" THEN UAF95_ORDER == ""
$ UAF95_ORDER == UAF95_ORDER + ",LGICMD"
$ UAF95_LGICMD_VERIFY == F$VERIFY()
$ UAF95_LGICMD_PROCEDURE == F$ENVIRONMENT("PROCEDURE")
$ UAF95_LGICMD_DEPTH == F$ENVIRONMENT("DEPTH")
$ UAF95_LGICMD_MODE == F$MODE()
$ UAF95_LGICMD_DEFAULT == F$ENVIRONMENT("DEFAULT")
$ UAF95_LGICMD_SYS_LOGIN == F$TRNLNM("SYS$LOGIN")
$ UAF95_LGICMD_PRIVS == F$GETJPI("","CURPRIV")
$ UAF95_LGICMD_P1 == P1
$ UAF95_LGICMD_STATUS == $STATUS
$ UAF95_LGICMD_BEFORE == "YES"
$ NOSUCHVERB
$ UAF95_LGICMD_AFTER_WARNING == "YES"
$ OPEN UAF95_NOFILE UAF95$DISK:[UAF95]NOSUCH.FILE
$ UAF95_LGICMD_AFTER_ERROR == "YES"
$ EXIT
