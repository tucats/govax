$ !
$ ! SYS$SYLOGIN, kept and replaced at the mode it was defined in.
$ OLD = F$TRNLNM("SYS$SYLOGIN","LNM$SYSTEM_TABLE")
$ MODE = F$TRNLNM("SYS$SYLOGIN","LNM$SYSTEM_TABLE",,,,"ACCESS_MODE")
$ IF MODE .EQS. "" THEN MODE = "EXECUTIVE"
$ SHOW LOGICAL/FULL SYS$SYLOGIN
   "SYS$SYLOGIN" [exec] = "SYS$MANAGER:SYLOGIN" (LNM$SYSTEM_TABLE)
$ IF OLD .NES. "" THEN DEFINE/SYSTEM/EXECUTIVE_MODE UAF95$OLD_SYLOGIN "SYS$MANAGER:SYLOGIN"
$ DEFINE/SYSTEM/EXECUTIVE_MODE UAF95$OLD_SYLOGIN_MODE "EXECUTIVE"
$ DEFINE/SYSTEM/EXECUTIVE_MODE SYS$SYLOGIN UAF95$DISK:[000000]UAF95S.COM
%DCL-I-SUPERSEDE, previous value of SYS$SYLOGIN has been superseded
$ SHOW LOGICAL/FULL SYS$SYLOGIN
   "SYS$SYLOGIN" [exec] = "UAF95$DISK:[000000]UAF95S.COM" (LNM$SYSTEM_TABLE)
$ SHOW LOGICAL/FULL UAF95$OLD_SYLOGIN*

(LNM$PROCESS_TABLE)	[kernel]
			[no protection information]

(LNM$JOB_81C38B00)	[kernel]  [shareable]  [Quota=(3904,4096)]
			[Protection=(RWCD,RWCD,,)]  [Owner=[SYSTEM]]

(LNM$GROUP_000001)	[kernel]  [shareable,group]
			[Protection=(RWCD,R,R,)]  [Owner=[1,*]]

(LNM$SYSTEM_TABLE)	[kernel]  [shareable,system]
			[Protection=(RWC,RWC,R,R)]  [Owner=[SYSTEM]]

  "UAF95$OLD_SYLOGIN" [exec] = "SYS$MANAGER:SYLOGIN"
  "UAF95$OLD_SYLOGIN_MODE" [exec] = "EXECUTIVE"
$ EXIT
