$ ! UAF95S.COM - Phase 95's probe: SYS$SYLOGIN while the probe runs.
$ ! Written by testdata/uaf95/gen.go. For the probe's accounts it records
$ ! what it sees; for every other user it runs the VAX's own SYLOGIN,
$ ! whose name UAF95ACCT.COM kept in UAF95$OLD_SYLOGIN.
$ !
$ IF F$EXTRACT(0,5,F$GETJPI("","USERNAME")) .NES. "UAF95" THEN GOTO OTHERS
$ IF F$TYPE(UAF95_ORDER) .EQS. "" THEN UAF95_ORDER == ""
$ UAF95_ORDER == UAF95_ORDER + ",SYLOGIN"
$ UAF95_SYLOGIN_VERIFY == F$VERIFY()
$ UAF95_SYLOGIN_PROCEDURE == F$ENVIRONMENT("PROCEDURE")
$ UAF95_SYLOGIN_DEPTH == F$ENVIRONMENT("DEPTH")
$ UAF95_SYLOGIN_MODE == F$MODE()
$ UAF95_SYLOGIN_DEFAULT == F$ENVIRONMENT("DEFAULT")
$ UAF95_SYLOGIN_SYS_LOGIN == F$TRNLNM("SYS$LOGIN")
$ UAF95_SYLOGIN_PRIVS == F$GETJPI("","CURPRIV")
$ UAF95_SYLOGIN_P1 == P1
$ UAF95_SYLOGIN_STATUS == $STATUS
$ EXIT
$ ! LOGIN.COM - Phase 95's probe: UAF95's SYS$LOGIN:LOGIN.COM (and
$ ! UAF95L's, which its LGICMD should keep from running). Written by
$ ! testdata/uaf95/gen.go.
$ !
$ IF F$TYPE(UAF95_ORDER) .EQS. "" THEN UAF95_ORDER == ""
$ UAF95_ORDER == UAF95_ORDER + ",LOGIN"
$ UAF95_LOGIN_VERIFY == F$VERIFY()
$ UAF95_LOGIN_PROCEDURE == F$ENVIRONMENT("PROCEDURE")
$ UAF95_LOGIN_DEPTH == F$ENVIRONMENT("DEPTH")
$ UAF95_LOGIN_MODE == F$MODE()
$ UAF95_LOGIN_DEFAULT == F$ENVIRONMENT("DEFAULT")
$ UAF95_LOGIN_SYS_LOGIN == F$TRNLNM("SYS$LOGIN")
$ UAF95_LOGIN_PRIVS == F$GETJPI("","CURPRIV")
$ UAF95_LOGIN_P1 == P1
$ UAF95_LOGIN_STATUS == $STATUS
$ EXIT
$ ! UAF95I.COM - Phase 95's probe: a process's state after logging in.
$ ! Written by testdata/uaf95/gen.go. The batch jobs run it, and each
$ ! account runs it by hand after logging in (README.md):
$ !
$ !     $ @UAF95$DISK:[000000]UAF95I
$ !
$ ! It writes UAF95$DISK:[UAF95LOG]UAF95I_user_mode.LOG (NOLOG: to
$ ! SYS$OUTPUT, as UAF95.COM uses it for SYSTEM).
$ !
$ IF P1 .EQS. "LOGGED" .OR. P1 .EQS. "NOLOG" THEN GOTO BEGIN
$ HERE = F$ENVIRONMENT("PROCEDURE")
$ WHO = F$EDIT(F$GETJPI("","USERNAME"),"TRIM")
$ LOGFILE = "UAF95$DISK:[UAF95LOG]UAF95I_" + WHO + "_" + F$MODE() + ".LOG"
$ @DISK$UAF95:[000000]UAF95I.COM;1/OUTPUT=UAF95$DISK:[UAF95LOG]UAF95I_UAF95_BATCH.LOG LOGGED
%UAF-E-NAOFIL, unable to open system authorization file (SYSUAF.DAT)
-RMS-E-FNF, file not found
%UAF-E-NAOFIL, unable to open system authorization file (SYSUAF.DAT)
-RMS-E-PRV, insufficient privilege or file protection violation
$ WRITE SYS$OUTPUT "UAF95I finished; the log is ", LOGFILE
UAF95I finished; the log is UAF95$DISK:[UAF95LOG]UAF95I_UAF95_BATCH.LOG
$ EXIT
