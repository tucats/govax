$ !
$ ! The scratch files. With SYSUAF and RIGHTSLIST naming files that don't
$ ! exist yet, AUTHORIZE offers to make a new SYSUAF.DAT (the data line
$ ! YES answers it) holding its own DEFAULT and SYSTEM records, and
$ ! CREATE/RIGHTS makes RIGHTSLIST.DAT. Nothing below may run unless the
$ ! scratch SYSUAF.DAT is there, so the VAX's own is never changed.
$ !
$ WRITE SYS$OUTPUT "######## SCRATCH FILES"
######## SCRATCH FILES
$ SET DEFAULT UAF95$DISK:[UAF95SCR]
$ DEFINE SYSUAF UAF95$DISK:[UAF95SCR]SYSUAF.DAT
$ DEFINE RIGHTSLIST UAF95$DISK:[UAF95SCR]RIGHTSLIST.DAT
$ DEFINE NETPROXY UAF95$DISK:[UAF95SCR]NETPROXY.DAT
$ DEFINE NET$PROXY UAF95$DISK:[UAF95SCR]NET$PROXY.DAT
$ SHOW LOGICAL/FULL SYSUAF
   "SYSUAF" [super] = "UAF95$DISK:[UAF95SCR]SYSUAF.DAT" (LNM$PROCESS_TABLE)
$ MCR AUTHORIZE
%UAF-E-NAOFIL, unable to open system authorization file (SYSUAF.DAT)
-RMS-E-FNF, file not found
YES
CREATE/RIGHTS
%UAF-E-RDBCREERR, unable to create rights database (RIGHTSLIST.DAT)
-RMS-E-FEX, file already exists, not superseded
SHOW DEFAULT/BRIEF
       Owner         Username           UIC       Account  Privs Pri Directory

                     DEFAULT         [200,200]             Normal  4 Disuser
EXIT
%UAF-I-DONEMSG, system authorization file modified
%UAF-I-RDBNOMODS, no modifications made to rights database
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00000001"
$ IF F$SEARCH("UAF95$DISK:[UAF95SCR]SYSUAF.DAT") .NES. "" THEN GOTO SCRATCH_MADE
$ SCRATCH_MADE:
$ DIRECTORY/FULL UAF95$DISK:[UAF95SCR]

