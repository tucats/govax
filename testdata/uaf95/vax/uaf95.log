$ !
$ ! The scratch files. With SYSUAF and RIGHTSLIST naming files that don't
$ ! exist yet, AUTHORIZE offers to make a new SYSUAF.DAT (the data line
$ ! YES answers it) holding its own DEFAULT and SYSTEM records, and
$ ! CREATE/RIGHTS makes RIGHTSLIST.DAT. The names are executive-mode
$ ! process names: round 1's supervisor-mode RIGHTSLIST was ignored, and
$ ! AUTHORIZE used the VAX's own rights database. Nothing below may run
$ ! unless both scratch files are there, so the VAX's are never changed.
$ !
$ WRITE SYS$OUTPUT "######## SCRATCH FILES"
######## SCRATCH FILES
$ SET DEFAULT UAF95$DISK:[UAF95SCR]
$ DEFINE/PROCESS/EXECUTIVE_MODE SYSUAF UAF95$DISK:[UAF95SCR]SYSUAF.DAT
$ DEFINE/PROCESS/EXECUTIVE_MODE RIGHTSLIST UAF95$DISK:[UAF95SCR]RIGHTSLIST.DAT
$ DEFINE/PROCESS/EXECUTIVE_MODE NETPROXY UAF95$DISK:[UAF95SCR]NETPROXY.DAT
$ DEFINE/PROCESS/EXECUTIVE_MODE NET$PROXY UAF95$DISK:[UAF95SCR]NET$PROXY.DAT
$ SHOW LOGICAL/FULL SYSUAF
   "SYSUAF" [exec] = "UAF95$DISK:[UAF95SCR]SYSUAF.DAT" (LNM$PROCESS_TABLE)
$ SHOW LOGICAL/FULL RIGHTSLIST
   "RIGHTSLIST" [exec] = "UAF95$DISK:[UAF95SCR]RIGHTSLIST.DAT" (LNM$PROCESS_TABLE)
$ MCR AUTHORIZE
%UAF-E-NAOFIL, unable to open system authorization file (SYSUAF.DAT)
-RMS-E-FNF, file not found
YES
CREATE/RIGHTS
%UAF-I-RDBCREMSG, rights database created
SHOW DEFAULT/BRIEF
       Owner         Username           UIC       Account  Privs Pri Directory

                     DEFAULT         [200,200]             Normal  4 Disuser
EXIT
%UAF-I-DONEMSG, system authorization file modified
%UAF-I-RDBDONEMSG, rights database modified
$ SHOW SYMBOL $STATUS
  $STATUS == "%X00000001"
$ IF F$SEARCH("UAF95$DISK:[UAF95SCR]SYSUAF.DAT") .EQS. "" THEN GOTO NO_SCRATCH
$ IF F$SEARCH("UAF95$DISK:[UAF95SCR]RIGHTSLIST.DAT") .EQS. "" THEN GOTO NO_SCRATCH
$ GOTO SCRATCH_MADE
$ SCRATCH_MADE:
$ DIRECTORY/FULL UAF95$DISK:[UAF95SCR]

