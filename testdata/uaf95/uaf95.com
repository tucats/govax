$ MCR AUTHORIZE ADD UAFD/UIC=[300,4]/OWNER="GOVAX CASE D"/ACCOUNT=CASED/DEVICE=DUA1:/DIRECTORY=[UAFD]/CLI=DCL/LGICMD=MYLOGIN/FLAGS=(DISUSER,DISCTLY,DEFCLI,LOCKPWD,CAPTIVE,DISNEWMAIL,DISWELCOME)/PRIORITY=3/PRIVILEGES=(TMPMBX,NETMBX,SYSPRV)/DEFPRIVILEGES=(TMPMBX,NETMBX)/PASSWORD=UAFDPW1/ASTLM=31/BIOLM=32/BYTLM=33000/DIOLM=34/ENQLM=35/FILLM=36/JTQUOTA=3700/PGFLQUOTA=38000/PRCLM=9/TQELM=11/WSDEFAULT=301/WSQUOTA=601/WSEXTENT=1201/MAXJOBS=2/MAXACCTJOBS=3/MAXDETACH=4/SHRFILLM=5/QUEPRIO=6/CPUTIME=0-00:10:00
