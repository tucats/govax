$ WRITE SYS$OUTPUT "######## SCRATCH FILES AT THE END"
$ DIRECTORY/FULL UAF95$DISK:[UAF95SCR]
$ ACCOUNTS:
$ DEASSIGN SYSUAF
$ DEASSIGN RIGHTSLIST
$ DEASSIGN NETPROXY
$ DEASSIGN NET$PROXY
$ SET DEFAULT UAF95$DISK:[000000]
$ !
$ @UAF95$DISK:[000000]UAF95ACCT
$ !
$ ! The batch jobs: UAF95 (SYS$LOGIN:LOGIN.COM) and UAF95L (its LGICMD),
$ ! each running UAF95I.COM, which writes its own log. The batch logs
$ ! show the login itself. SYNCHRONIZE waits for each.
$ !
$ WRITE SYS$OUTPUT "######## BATCH"
$ SHOW QUEUE/BATCH/ALL
$ SUBMIT/USER=UAF95/NOPRINTER/KEEP/NAME=UAF95J/LOG_FILE=UAF95$DISK:[UAF95LOG]UAF95J_UAF95.LOG UAF95$DISK:[000000]UAF95I.COM
$ SHOW SYMBOL $STATUS
$ IF F$TYPE($ENTRY) .NES. "" THEN SYNCHRONIZE/ENTRY='$ENTRY'
$ SUBMIT/USER=UAF95L/NOPRINTER/KEEP/NAME=UAF95LJ/LOG_FILE=UAF95$DISK:[UAF95LOG]UAF95J_UAF95L.LOG UAF95$DISK:[000000]UAF95I.COM
$ SHOW SYMBOL $STATUS
$ IF F$TYPE($ENTRY) .NES. "" THEN SYNCHRONIZE/ENTRY='$ENTRY'
$ SUBMIT/USER=UAF95D/NOPRINTER/KEEP/NAME=UAF95DJ/LOG_FILE=UAF95$DISK:[UAF95LOG]UAF95J_UAF95D.LOG UAF95$DISK:[000000]UAF95I.COM
$ SHOW SYMBOL $STATUS
$ IF F$TYPE($ENTRY) .NES. "" THEN SYNCHRONIZE/ENTRY='$ENTRY'
$ DIRECTORY UAF95$DISK:[UAF95LOG]
$ SET DEFAULT SYS$SYSTEM
$ MCR AUTHORIZE SHOW UAF95/FULL
$ MCR AUTHORIZE SHOW UAF95L/FULL
$ SET DEFAULT UAF95$DISK:[000000]
$ !
$ WRITE SYS$OUTPUT "######## STATE SYSTEM"
$ @UAF95$DISK:[000000]UAF95I NOLOG
$ WRITE SYS$OUTPUT "UAF95 FINISHED"
$ EXIT
