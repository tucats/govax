$ ! LOGIN.COM - Phase 95's probe: UAF95's SYS$LOGIN:LOGIN.COM (and
$ ! UAF95L's, which its LGICMD should keep from running). Written by
$ ! testdata/uaf95/gen.go.
$ !
$ IF F$TYPE(UAF95_ORDER) .EQS. "" THEN UAF95_ORDER == ""
$ UAF95_ORDER == UAF95_ORDER + ",LOGIN"
$ UAF95_LOGIN_VERIFY == F$VERIFY()
$ UAF95_LOGIN_PROCEDURE == F$ENVIRONMENT("PROCEDURE")
$ UAF95_LOGIN_DEPTH == F$ENVIRONMENT("DEPTH")
$ UAF95_LOGIN_MODE == F$MODE()
$ UAF95_LOGIN_DEFAULT == F$ENVIRONMENT("DEFAULT")
$ UAF95_LOGIN_SYS_LOGIN == F$TRNLNM("SYS$LOGIN")
$ UAF95_LOGIN_PRIVS == F$GETJPI("","CURPRIV")
$ UAF95_LOGIN_P1 == P1
$ UAF95_LOGIN_STATUS == $STATUS
$ EXIT
