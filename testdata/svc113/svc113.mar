; HANDLER records the condition (and an access violation's reason mask
; and address), then unwinds to the case routine's caller, which gets
; the condition in R0. It ignores SS$_UNWIND, the call an unwind makes.
	.ENTRY	HANDLER,^M<>
	MOVL	4(AP),R0		; the signal array
	CMPL	4(R0),#SS$_UNWIND
	BEQL	9$
	MOVL	4(R0),SIGCOND
	CLRQ	SIGARG1
	CMPL	SIGCOND,#SS$_ACCVIO
	BNEQ	1$
	MOVQ	8(R0),SIGARG1
1$:	MOVL	8(AP),R1		; the mechanism array
	MOVL	SIGCOND,12(R1)		; CHF$L_MCH_SAVR0
	$UNWIND_S
9$:	RET

; SHOWR0 name, r0: the case's line.
	.ENTRY	SHOWR0,^M<>
	TSTL	SIGCOND
	BNEQ	1$
	$FAO_S	CTRSTR=R0CTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP),P2=8(AP)
	BRB	2$
1$:	$FAO_S	CTRSTR=SIGCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP),P2=8(AP),-
		P3=SIGCOND,P4=SIGARG1,P5=SIGARG2
2$:	MOVW	LINLEN,OUTDSC
	PUSHAQ	OUTDSC
	CALLS	#1,G^LIB$PUT_OUTPUT
	RET

; SHOWMEM name, address, count: count longwords in hex.
	.ENTRY	SHOWMEM,^M<R2,R3,R4>
	MOVL	8(AP),R2
	MOVL	12(AP),R3
	$FAO_S	CTRSTR=MEMCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP)
	MOVZWL	LINLEN,R4
1$:	TSTL	R3
	BEQL	2$
	MOVAB	LINE[R4],PARTDSC+4
	$FAO_S	CTRSTR=LWCTL,OUTBUF=PARTDSC,P1=(R2)+
	ADDL2	#9,R4
	DECL	R3
	BRB	1$
2$:	MOVW	R4,OUTDSC
	PUSHAQ	OUTDSC
	CALLS	#1,G^LIB$PUT_OUTPUT
	RET

; SHOWTXT name, descriptor: a class S or D string's length and text.
	.ENTRY	SHOWTXT,^M<R2>
	MOVL	8(AP),R2
	MOVZWL	(R2),R0
	$FAO_S	CTRSTR=TXTCTL,OUTLEN=LINLEN,OUTBUF=LINDSC,P1=4(AP),P2=R0,P3=R0,P4=4(R2)
	MOVW	LINLEN,OUTDSC
	PUSHAQ	OUTDSC
	CALLS	#1,G^LIB$PUT_OUTPUT
	RET

; 1: GETUTC now
	.ENTRY	C1,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	PUSHAB	C1_U
	CALLS	#1,G^SYS$GETUTC
	PUSHL	R0
	MOVL	(SP)+,R0
	RET

; 2: GETUTC 0
	.ENTRY	C2,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	PUSHL	#0
	CALLS	#1,G^SYS$GETUTC
	PUSHL	R0
	MOVL	(SP)+,R0
	RET

; 3: GETUTC no args
	.ENTRY	C3,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	CALLS	#0,G^SYS$GETUTC
	PUSHL	R0
	MOVL	(SP)+,R0
	RET

; 4: GETUTC vs GETTIM
	.ENTRY	C4,^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	MOVAB	HANDLER,(FP)
	PUSHAB	C4_G
	CALLS	#1,G^SYS$GETTIM
	PUSHAB	C4_U
	CALLS	#1,G^SYS$GETUTC
	PUSHL	#0
	PUSHAB	C4_U
	PUSHAB	C4_S
	CALLS	#3,G^SYS$TIMCON
	PUSHL	R0
	SUBL2	C4_G,C4_S
	SBWC	C4_G+4,C4_S+4
	CLRL	C4_Z
	TSTL	C4_S+4
	BNEQ	C4_X
	CMPL	C4_S,#10000000
	BGTRU	C4_X
	MOVL	#1,C4_Z
	C4_X:
	MOVL	(SP)+,R0
	RET

