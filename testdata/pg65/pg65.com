$ ! PG65.COM - Phase 65's probe of sections under the pager
$ ! (testdata/pg65/README.md). Run it, from SYSTEM, with the exchange
$ ! volume's [000000] as the default directory:
$ !
$ !     @PG65/OUTPUT=PG65.LOG
$ !
$ ! PG65.LOG gets this procedure's log; PG65x.OUT each part x's lines
$ ! (PG65H.OUT the holder subprocess's); PG65_BUILD.LOG MACRO's and
$ ! LINK's messages.
$ SET NOON
$ SET VERIFY
$ WRITE SYS$OUTPUT F$GETSYI("VERSION"), " ", F$GETSYI("HW_NAME")
$ RUN SYS$SYSTEM:SYSGEN
USE ACTIVE
SHOW GBLSECTIONS
SHOW GBLPAGES
SHOW GBLPAGFIL
SHOW PFCDEFAULT
SHOW PAGTBLPFC
SHOW MPW_HILIMIT
SHOW MPW_LOLIMIT
SHOW MPW_WRTCLUSTER
SHOW MINWSCNT
SHOW WSMAX
SHOW BORROWLIM
SHOW GROWLIM
SHOW FREELIM
SHOW FREEGOAL
EXIT
$ SHOW WORKING_SET
$ SHOW MEMORY/PHYSICAL_PAGES
$ GOSUB GBL
$ !
$ ! The program, assembled and linked.
$ !
$ DEFINE/USER_MODE SYS$OUTPUT PG65_BUILD.LOG
$ DEFINE/USER_MODE SYS$ERROR PG65_BUILD.LOG
$ MACRO/NOLIST PG65
$ DEFINE/USER_MODE SYS$OUTPUT PG65_BUILD.LOG
$ DEFINE/USER_MODE SYS$ERROR PG65_BUILD.LOG
$ LINK/NOMAP PG65
$ !
$ ! Part M makes PG65.DAT, which the other parts map.
$ !
$ DEFINE PG65_PART M
$ DEFINE/USER_MODE SYS$OUTPUT PG65M.OUT
$ RUN PG65
$ SHOW SYMBOL $STATUS
$ DIRECTORY/FULL PG65.DAT
$ !
$ ! The global section limits.
$ !
$ DEFINE PG65_PART G
$ DEFINE/USER_MODE SYS$OUTPUT PG65G.OUT
$ RUN PG65
$ SHOW SYMBOL $STATUS
$ GOSUB GBL
$ !
$ ! A permanent page-file section (F), the writer run with its pages on
$ ! the modified list (D), and the section mapped again and deleted (R).
$ !
$ DEFINE PG65_PART F
$ DEFINE/USER_MODE SYS$OUTPUT PG65F.OUT
$ RUN PG65
$ SHOW SYMBOL $STATUS
$ GOSUB GBL
$ SHOW MEMORY/PHYSICAL_PAGES
$ DEFINE PG65_PART D
$ DEFINE/USER_MODE SYS$OUTPUT PG65D.OUT
$ RUN PG65
$ SHOW SYMBOL $STATUS
$ GOSUB GBL
$ SHOW MEMORY/PHYSICAL_PAGES
$ DEFINE PG65_PART R
$ DEFINE/USER_MODE SYS$OUTPUT PG65R.OUT
$ RUN PG65
$ SHOW SYMBOL $STATUS
$ GOSUB GBL
$ !
$ ! Global pages leaving a small working set; copy-on-reference;
$ ! $UPDSEC; read clustering.
$ !
$ DEFINE PG65_PART P
$ DEFINE/USER_MODE SYS$OUTPUT PG65P.OUT
$ RUN PG65
$ SHOW SYMBOL $STATUS
$ DEFINE PG65_PART C
$ DEFINE/USER_MODE SYS$OUTPUT PG65C.OUT
$ RUN PG65
$ SHOW SYMBOL $STATUS
$ GOSUB GBL
$ DEFINE PG65_PART U
$ DEFINE/USER_MODE SYS$OUTPUT PG65U.OUT
$ RUN PG65
$ SHOW SYMBOL $STATUS
$ DEFINE PG65_PART K
$ DEFINE/USER_MODE SYS$OUTPUT PG65K.OUT
$ RUN PG65
$ SHOW SYMBOL $STATUS
$ GOSUB GBL
$ !
$ ! Pages another process holds: the holder (part H) in a subprocess,
$ ! part S here; they step through common event flags. The holder ends
$ ! by itself; STOP is for a holder left waiting.
$ !
$ DEFINE PG65_PART H
$ SPAWN/NOWAIT/PROCESS=PG65HLD/OUTPUT=PG65H.OUT RUN PG65
$ DEFINE PG65_PART S
$ DEFINE/USER_MODE SYS$OUTPUT PG65S.OUT
$ RUN PG65
$ SHOW SYMBOL $STATUS
$ WAIT 00:00:05
$ STOP PG65HLD
$ GOSUB GBL
$ DEASSIGN PG65_PART
$ TYPE PG65M.OUT
$ TYPE PG65G.OUT
$ TYPE PG65F.OUT
$ TYPE PG65D.OUT
$ TYPE PG65R.OUT
$ TYPE PG65P.OUT
$ TYPE PG65C.OUT
$ TYPE PG65U.OUT
$ TYPE PG65K.OUT
$ TYPE PG65S.OUT
$ TYPE PG65H.OUT
$ SET NOVERIFY
$ EXIT
$ !
$ ! GBL: the global section and page file counts.
$ !
$ GBL:
$ WRITE SYS$OUTPUT "gbl free_gblsects=", F$GETSYI("FREE_GBLSECTS"), -
	" free_gblpages=", F$GETSYI("FREE_GBLPAGES"), -
	" contig_gblpages=", F$GETSYI("CONTIG_GBLPAGES"), -
	" pagefile_free=", F$GETSYI("PAGEFILE_FREE")
$ RETURN
