module $IODEF;
/*+
/* I/O FUNCTION CODE DEFINITIONS
/*-


/*
/* *** START PHYSICAL I/O FUNCTION CODES ***
/*

constant NOP		equals 0  prefix IO tag $;	/*NO OPERATION 
constant UNLOAD		equals 1  prefix IO tag $;	/*UNLOAD DRIVE 
constant LOADMCODE	equals 1  prefix IO tag $;	/*LOAD MICROCODE 
constant START_BUS	equals 1  prefix IO tag $;	/*START LAVC BUS
constant SEEK		equals 2  prefix IO tag $;	/*SEEK CYLINDER 
constant SPACEFILE	equals 2  prefix IO tag $;	/*SPACE FILES 
constant STARTMPROC	equals 2  prefix IO tag $;	/*START MICROPROCESSOR 
constant STOP_BUS	equals 2  prefix IO tag $;	/*STOP LAVC BUS
constant RECAL		equals 3  prefix IO tag $;	/*RECALIBRATE DRIVE 
constant DUPLEX		equals 3  prefix IO tag $;	/*ENTER DUPLEX MODE
constant STOP		equals 3  prefix IO tag $;	/*STOP 
constant DEF_COMP	equals 3  prefix IO tag $;	/*DEFINE NETWORK COMPONENT
constant DRVCLR		equals 4  prefix IO tag $;	/*DRIVE CLEAR 
constant INITIALIZE	equals 4  prefix IO tag $;	/*INITIALIZE 
constant MIMIC		equals 4  prefix IO tag $;	/*ENTER MIMIC MODE
constant DEF_COMP_LIST	equals 4  prefix IO tag $;	/*DEFINE NETWORK COMPONENT LIST
constant RELEASE	equals 5  prefix IO tag $;	/*RELEASE PORT 
constant SETCLOCKP	equals 5  prefix IO tag $;	/*SET CLOCK (PHYSICAL) 
constant START_ANALYSIS	equals 5  prefix IO tag $;	/*START LAVC FAILURE ANALYSIS
constant BIND		equals 5  prefix IO tag $;	/*BIND UNITS INTO A STORAGE POOL
constant PATH_VERIFY	equals 5  prefix IO tag $;	/*VERIFY PATH TO DEVICE 
constant OFFSET		equals 6  prefix IO tag $;	/*OFFSET READ HEADS 
constant ERASETAPE	equals 6  prefix IO tag $;	/*ERASE TAPE 
constant STARTDATAP	equals 6  prefix IO tag $;	/*START DATA TRANSFER (PHYSICAL) 
constant STOP_ANALYSIS  equals 6  prefix IO tag $;	/*STOP LAVC FAILURE ANALYSIS
constant UNBIND		equals 6  prefix IO tag $;	/*REMOVE UNITS FROM A STORAGE POOL
constant RETCENTER	equals 7  prefix IO tag $;	/*RETURN TO CENTERLINE 
constant QSTOP		equals 7  prefix IO tag $;	/*QUEUE STOP REQUEST 
constant START_MONITOR  equals 7  prefix IO tag $;      /*START LAVC CHANNEL MONITOR.
constant CREDISK	equals 7  prefix IO tag $;	/*CREATE A DISK IN A STORAGE POOL
constant LOCAL_DRAIN	equals 7  prefix IO tag $;	/*DRAIN LOCAL IO
constant PACKACK	equals 8  prefix IO tag $;	/*PACK ACKNOWLEDGE 
constant STOP_MONITOR   equals 8  prefix IO tag $;      /*STOP LAVC CHANNEL MONITOR.
constant SEARCH		equals 9  prefix IO tag $;	/*SEARCH FOR SECTOR 
constant SPACERECORD	equals 9  prefix IO tag $;	/*SPACE RECORDS 
constant READRCT	equals 9  prefix IO tag $;	/*READ REPLACEMENT & CACHING TABLE
constant REMDISK	equals 9  prefix IO tag $;	/*REMOVE A DISK FROM A STORAGE POOL
constant MANAGE_PE	equals 9  prefix IO tag $;	/*MANAGE PEDRIVER
constant WRITECHECK	equals 10  prefix IO tag $;	/*WRITE CHECK DATA 
constant EXPORT		equals 10  prefix IO tag $;	/*EXPORT A DISK FROM A STORAGE POOL
constant WRITEPBLK	equals 11  prefix IO tag $;	/*WRITE PHYSICAL BLOCK 
constant READPBLK	equals 12  prefix IO tag $;	/*READ PHYSICAL BLOCK 
constant WRITEHEAD	equals 13  prefix IO tag $;	/*WRITE HEADER AND DATA 
constant RDSTATS	equals 13  prefix IO tag $;	/*READ STATISTICS 
constant CRESHAD	equals 13  prefix IO tag $;	/*CREATE A SHADOW SET
constant READHEAD	equals 14  prefix IO tag $;	/*READ HEADER AND DATA 
constant ADDSHAD	equals 14  prefix IO tag $;	/*ADD MEMBER TO SHADOW SET
constant WRITETRACKD	equals 15  prefix IO tag $;	/*WRITE TRACK DATA 
constant COPYSHAD	equals 15  prefix IO tag $;	/*PERFORM SHADOW SET COPY OPERATIONS
constant READTRACKD	equals 16  prefix IO tag $;	/*READ TRACK DATA 
constant REMSHAD	equals 16  prefix IO tag $;	/*REMOVE MEMBER FROM SHADOW SET
constant AVAILABLE	equals 17  prefix IO tag $;	/*AVAILABLE (DISK AND TAPE CLASS) 
constant SETPRFPATH	equals 18  prefix IO tag $;	/*SET PREFERRED PATH
constant DISPLAY	equals 19  prefix IO tag $;	/*DISPLAY VOLUME LABEL
constant REMSHADMBR	equals 20  prefix IO tag $;	/*REMOVE MEMBER FROM SHADOW SET
constant DSE		equals 21  prefix IO tag $;	/*DATA SECURITY ERASE (AND REWIND) 
constant REREADN	equals 22  prefix IO tag $;	/*REREAD NEXT 
constant DISK_COPY_DATA	equals 22  prefix IO tag $;	/*DISK_COPY_DATA
constant MOUNTSHAD	equals 23  prefix IO tag $;	/*CREATE A SHADOW SET
constant REREADP	equals 23  prefix IO tag $;	/*REREAD PREVIOUS 
constant WHM		equals 23  prefix IO tag $;	/*WRITE HISTORY MANAGEMENT
constant AS_SETCHAR	equals 23  prefix IO tag $;	/*ASIAN SET CHARACTERISTICS
constant WRITERET	equals 24  prefix IO tag $;	/*WRITE RETRY 
constant WRITECHECKH	equals 24  prefix IO tag $;	/*WRITE CHECK HEADER AND DATA 
constant AS_SENSECHAR	equals 24  prefix IO tag $;	/*ASIAN SENSE CHARACTERISTICS
constant ADDSHADMBR	equals 25  prefix IO tag $;	/*ADD MEMBER TO SHADOW SET
constant READPRESET	equals 25  prefix IO tag $;	/*READIN PRESET 
constant STARTSPNDL	equals 25  prefix IO tag $;	/*START SPINDLE 
constant SETCHAR	equals 26  prefix IO tag $;	/*SET CHARACTERISTICS 
constant SENSECHAR	equals 27  prefix IO tag $;	/*SENSE TAPE CHARACTERISTICS 
constant WRITEMARK	equals 28  prefix IO tag $;	/*WRITE TAPE MARK 
constant COPYMEM	equals 28  prefix IO tag $;	/*COPY MEMORY
constant PSXSETCHAR	equals 28  prefix IO tag $;	/*POSIX SET CHARACTERISTICS
constant WRTTMKR	equals 29  prefix IO tag $;	/*WRITE TAPE MARK RETRY 
constant DIAGNOSE	equals 29  prefix IO tag $;	/*DIAGNOSE 
constant SHADMV		equals 29  prefix IO tag $;	/*PREFORM MOUNT VER. ON SHADOW SET
constant PSXSENSECHAR	equals 29  prefix IO tag $;	/*POSIX SENSE CHARACTERISTICS
constant FORMAT		equals 30  prefix IO tag $;	/*FORMAT 
constant CLEAN		equals 30  prefix IO tag $;	/*CLEAN TAPE 
constant UPSHAD		equals 30  prefix IO tag $;	/*UPDATE SHADOW SYSDEVICE
constant PHYSICAL	equals 31  prefix IO tag $;	/*HIGHEST PHYSICAL I/O FUNCTION CODE 

/*
/* *** START LOGICAL I/O FUNCTION CODES ***
/*

constant WRITELBLK	equals 32  prefix IO tag $;	/*WRITE LOGICAL BLOCK 
constant READLBLK	equals 33  prefix IO tag $;	/*READ LOGICAL BLOCK 
constant REWINDOFF	equals 34  prefix IO tag $;	/*REWIND AND SET OFFLINE 
constant READRCTL	equals 34  prefix IO tag $;	/*READ RCT SECTOR ZERO
constant SETMODE	equals 35  prefix IO tag $;	/*SET MODE 
constant REWIND		equals 36  prefix IO tag $;	/*REWIND TAPE 
constant SKIPFILE	equals 37  prefix IO tag $;	/*SKIP FILES 
constant PSXSETMODE	equals 37  prefix IO tag $;	/*POSIX SET MODE
constant SKIPRECORD	equals 38  prefix IO tag $;	/*SKIP RECORDS 
constant PSXSENSEMODE	equals 38  prefix IO tag $;	/*POSIX SENSE MODE
constant SENSEMODE	equals 39  prefix IO tag $;	/*SENSE TAPE MODE 
constant WRITEOF	equals 40  prefix IO tag $;	/*WRITE END OF FILE 
constant TTY_PORT_BUFIO	equals 40  prefix IO tag $;	/*BUFFERED I/O TERMINAL PORT FDT ROUTINE
constant TTY_PORT	equals 41  prefix IO tag $;	/*TERMINAL PORT FDT ROUTINE
constant FREECAP	equals 41  prefix IO tag $;	/*RETURN FREE CAPACITY
constant FLUSH		equals 42  prefix IO tag $;	/*FLUSH CONTROLLER CACHE
constant AS_SETMODE	equals 42  prefix IO tag $;	/*ASIAN SET MODE
constant READLCHUNK	equals 43  prefix IO tag $;	/*READ LARGE LOGICAL BLOCK
constant AS_SENSEMODE	equals 43  prefix IO tag $;	/*ASIAN SENSE MODE
constant WRITELCHUNK	equals 44  prefix IO tag $;	/*WRITE LARGE LOGICAL BLOCK
constant LOGICAL	equals 47  prefix IO tag $;	/*HIGHEST LOGICAL I/O FUNCTION CODE 

/*
/* *** START VIRTUAL I/O FUNCTION CODES
/*

constant WRITEVBLK	equals 48  prefix IO tag $;	/*WRITE VIRTUAL BLOCK 
constant READVBLK	equals 49  prefix IO tag $;	/*READ VIRTUAL BLOCK 
constant ACCESS		equals 50  prefix IO tag $;	/*ACCESS FILE 
constant PSXWRITEVBLK	equals 50  prefix IO tag $;	/*POSIX WRITE VIRTUAL
constant CREATE		equals 51  prefix IO tag $;	/*CREATE FILE 
constant DEACCESS	equals 52  prefix IO tag $;	/*DEACCESS FILE 
constant PSXREADVBLK	equals 52  prefix IO tag $;	/*POSIX READ VIRTUAL
constant DELETE		equals 53  prefix IO tag $;	/*DELETE FILE 
constant MODIFY		equals 54  prefix IO tag $;	/*MODIFY FILE 
constant NETCONTROL	equals 54  prefix IO tag $;	/*X25 NETWORK CONTROL FUNCTION 
constant READPROMPT	equals 55  prefix IO tag $;	/*READ TERMINAL WITH PROMPT 
constant SETCLOCK	equals 55  prefix IO tag $;	/*SET CLOCK 
constant AUDIO		equals 55  prefix IO tag $;	/*CD-ROM AUDIO
constant ACPCONTROL	equals 56  prefix IO tag $;	/*MISCELLANEOUS ACP CONTROL 
constant STARTDATA	equals 56  prefix IO tag $;	/*START DATA 
constant IOCTLV         equals 56  prefix IO tag $;     /*GENERIC UNIX IOCTL FUNCTIONS
constant MOUNT		equals 57  prefix IO tag $;	/*MOUNT VOLUME 
constant TTYREADALL	equals 58  prefix IO tag $;	/* TERMINAL READ PASSALL 
constant DISMOUNT	equals 58  prefix IO tag $;	/* F64 dismount
constant TTYREADPALL	equals 59  prefix IO tag $;	/* TERM READ W/PROMPT PASSALL 
constant USBATTR        equals 59  prefix IO tag $;     /* USB device attributes
constant CONINTREAD	equals 60  prefix IO tag $;	/* Connect to interrupt readonly 
constant CONINTWRITE	equals 61  prefix IO tag $;	/* Connect to interrupt with write 
constant READDIR   	equals 62  prefix IO tag $;	/*READ DIRECTORY CONTENTS
constant VIRTUAL	equals 63  prefix IO tag $;	/*HIGHEST VIRTUAL I/O FUNCTION 

/*
/* FUNCTION MODIFIER BIT DEFINITIONS
/*


aggregate IODEF  union prefix IO$;

    /* Basic I/O function code/modifiers structure

    #fcode_size = 6;

    FCODE_STRUCTURE structure fill;
        FCODE bitfield mask length #fcode_size;		/* Function Code Field
	FMODIFIERS bitfield mask length 16-#fcode_size;	/* Function Modifiers Field
    end FCODE_STRUCTURE;

    /* Function modifiers common to all drivers which do error logging
    
    ERRLOG_MODIFIERS structure fill;
	fcode_fill_1 bitfield length #fcode_size fill;
	filler_1 bitfield length 5 fill;	
        INHERLOG bitfield mask;				/* Inhibit error logging
    end ERRLOG_MODIFIERS;    
	
    /* General disk and tape function code modifiers

    DISK_TAPE_MODIFIERS structure fill;
	fcode_fill_2 bitfield length #fcode_size fill;
	rsvd_for_devdepend_1 bitfield length 4 fill;
        ERASE bitfield mask;				/* Erase data
	filler_2 bitfield length 1 fill;		/* IO$M_INHERLOG
    	rsvd_for_devdepend_2 bitfield length 1 fill;
	EXFUNC bitfield mask;				/* func<31:16> are valid
        DATACHECK bitfield mask;			/* Write check data after transfer
        INHRETRY bitfield mask;				/* Inhibit error retry
	/* the following are only valid if EXFUNC is set
	SYNCSTS bitfield mask;				/* allow synchronous completion
	NOVCACHE bitfield mask;				/* do not use VBN cache
	BUFOBJ bitfield mask; 				/* Buffer object I/O
	TRUSTED bitfield mask;                          /* I/O from trusted component
	FILE_FLUSH bitfield mask;			/* Flush file to disk
	BARRIER bitfield mask;				/* Insert a barrier after the write
	
    end DISK_TAPE_MODIFIERS;

    /* General disk function code modifiers

    DISK_MODIFIERS structure fill;
    	fcode_fill_3 bitfield length #fcode_size fill;
    	rsvd_for_devdepend_3 bitfield length 6 fill;
    	INHSEEK bitfield mask;				/* Inhibit implied seek on physical functions
    end DISK_MODIFIERS;

    /* General tape function code modifiers

    TAPE_MODIFIERS structure fill;
    	fcode_fill_4 bitfield length #fcode_size fill;
        REVERSE bitfield mask;				/* Reverse operation
        NOWAIT bitfield mask;				/* No wait for rewind to complete
    	rsvd_for_devdepend_4 bitfield length 4 fill;
        INHEXTGAP bitfield mask;			/* Inhibit extended inter-record gap 
	RETENSION bitfield mask;			/* Traverse the entire tape to uniformly set the tape's tension.
							/*  Applies only to IO$_REWIND/REWINDOFF functions
        ALLOWFAST bitfield mask;                        /* Allow fast skip by filemarks when enabled
							/*  Applies only to IO$_SKIPFILE/SPACEFILE functions
        MT3_DENSITY bitfield mask;                      /* Density Setmode and Sensemode for MTD enhanced tape drivers.
    end TAPE_MODIFIERS;
    	
    /* DU  & TU, disk & tape class driver transfer function modifier bits

    DUTU_XFER_MODIFIERS structure fill;
	fcode_fill_5 bitfield length #fcode_size fill;
	dutux_reserved bitfield length 2 fill;
	MSCPMODIFS bitfield mask;			/* Use MSCP modifiers in P5
    end DUTU_XFER_MODIFIERS;

    DU_SENSE_MODIFIERS structure fill;
	fcode_fill_6 bitfield length #fcode_size fill;
	SHADOW bitfield mask;				/* Shadowing SENSECHAR
	LOCATE bitfield mask;				/* Shadowing Locate function
    end DU_SENSE_MODIFIERS;

    DU_PACKACK_MODIFIERS structure fill;
	fcode_fill_7 bitfield length #fcode_size fill;
	MSCP_FORMAT bitfield mask;			/* PACKACK media for formatting
    end DU_PACKACK_MODIFIERS;

    DU_AVAIL_MODIFIERS structure fill;
	fcode_fill_8 bitfield length #fcode_size fill;
	ALLHOSTS bitfield mask;				/* Do available as for all class drivers
	DISSOLVE bitfield mask;				/* Dissolve shadow set
	NOCLEANUP bitfield mask;			/* Normal shadow set cleanup not necessary
    end DU_AVAIL_MODIFIERS;

    DU_REMSHAD_MODIFIERS structure fill;
	fcode_fill_9 bitfield length #fcode_size fill;
	SPINDOWN bitfield mask;				/* Spin down removed member
    end DU_REMSHAD_MODIFIERS;

    DU_DCD_MODIFIERS structure fill;
	fcode_fill_11 bitfield length #fcode_size fill;
	EST_COM_PATH bitfield mask;			/* Establish Communication Path
	LCL_SRC_UNIT bitfield mask;			/* Local Source Unit
	RTN_COM_PATH bitfield mask;			/* Retain Communication Path
    end DU_DCD_MODIFIERS;

    DU_WHM_MODIFIERS structure fill;
	fcode_fill_12 bitfield length #fcode_size fill;
	DEALC_ALL bitfield mask;			/* Deallocate All
	DEALC_HRN bitfield mask;			/* Deallocate by Host Reference Number
	DEALC_ENTLOC bitfield mask;			/* Deallocate by Entry Locator
	DECR_AFC bitfield mask;				/* Decrement Allocation Failure Count
	READ_ALL bitfield mask;				/* Read All
	READ_HRN bitfield mask;				/* Read by Host Reference Number
	BREAK_CONN bitfield mask;			/* Break Connection
    end DU_WHM_MODIFIERS;

    /* HBS driver transfer function modifier bits

/* Make sure that IO$V_SHADOW .ne. IO$V_LOCATE .ne. IO$V_COPYOP

    HBS_COPYSHAD_MODIFIERS structure fill;
	fcode_fill_13 bitfield length #fcode_size fill;
	STEPOVER bitfield mask;				/* Stepover SCBLBN.
	cs_fill  bitfield length 1 fill;
	COPYOP   bitfield mask;				/* Shad Server Cpy Operation
    end HBS_COPYSHAD_MODIFIERS;

    HBS_CRESHAD_MODIFIERS structure fill;
	fcode_fill_14 bitfield length #fcode_size fill;
	EXISTS bitfield mask;				/* VU already exists.
	CBS bitfield mask;				/* Controller based shadowing.
	BOOTING bitfield mask;				/* Creshad for system disk.
	REQ_MINICOPY bitfield mask;			/* MINICOPY required
	OPT_MINICOPY bitfield mask;			/* MINICOPY optional
	NOMINICOPY bitfield mask;			/* NOMINICOPY
    end HBS_CRESHAD_MODIFIERS;

{ Make sure HBS XFER Modifiers are above and unique with DUTU XFER modifiers.

    HBS_XFER_MODIFIERS structure fill;
	fcode_fill_15 bitfield length #fcode_size+3 fill;
	VUEX_FC    bitfield mask;			/* Exclude Full copy members
    end HBS_WRITEPBLK_MODIFIERS;

    /* Function modifier bits for Set Preferred Path. 

    PRFPATH_MODIFIERS structure fill;
	fcode_fill_10 bitfield length #fcode_size fill;
							/* No modifiers set, passes in a preferred path (DUDRIVER)
	FORCEPATH bitfield mask;			/* Make path change happen (DUDRIVER)
	PREFERRED_CPU bitfield mask;			/* Set Fast Path CPU affinity of port (port driver)
	SYS_ASSIGNABLE bitfield mask;			/* system assignable port
    end PRFPATH_MODIFIERS;

    /* DR driver function modifier bits.

    DR_MODIFIERS structure fill;
	fcode_fill_16 bitfield length #fcode_size fill;
        COMMOD bitfield mask;				/* Diagnostic command
        MOVETRACKD bitfield mask;			/* Move track descriptor
        DIAGNOSTIC bitfield mask;			/* Diagnostic function
        SKPSECINH bitfield mask;			/* Skip sector inhibit
    end DR_MODIFIERS;
    
    /* DY driver function modifier bits.

    DY_MODIFIERS structure fill;
	fcode_fill_17 bitfield length #fcode_size fill;
        DELDATA bitfield mask;				/* Write deleted data mark
    end DY_MODIFIERS;
    
    /* DD driver (TU58) function modifier bits.

    DD_MODIFIERS structure fill;
	fcode_fill_18 bitfield length #fcode_size fill;
        NOMRSP bitfield mask;				/* Do not use MRSP for this operation
    end DD_MODIFIERS;
    
    /* Magnetic tape I/O function modifier bits for the TS11.

    TS11_MODIFIERS structure fill;
	fcode_fill_19 bitfield length #fcode_size fill;
    	rsvd_for_devdepend_5 bitfield length 2 fill;
        SWAP bitfield mask;				/* Swap byte (TS11)
        OPPOSITE bitfield mask;				/* Opposite bit for rereads (TS11)
    end TS11_MODIFIERS;

    /* TU driver function modifier bits

    TU_MODIFIERS structure fill;
    	fcode_fill_20 bitfield length #fcode_size fill;
    	rsvd_for_devdepend_6 bitfield length 3 fill;
	CLSEREXCP bitfield mask;			/* Clear serious exception condition
    end TU_MODIFIERS;
    	
    /* Tape class driver segmented and large transfer modifier bits

    TU_LG_TRANSFER_MODIFIERS structure fill;
	fcode_fill_21 bitfield length #fcode_size fill;
	CHUNKDIAG bitfield mask;			/* Allow diagnostic buffers
	rsvd_for_devdepend_7 bitfield length 3 fill;
	TBC bitfield mask;				/* To be continued modifier
    end TU_LG_TRANSFER_MODIFIERS;


    /* TUDRIVER SETMODE function modifier bits.

    TU_SETMODE_MODIFIERS structure fill;
	fcode_fill_22 bitfield length #fcode_size fill;
	ENAREP bitfield mask;				/* Enable media quality
    end TU_SETMODE_MODIFIERS;				/* reporting.

    /* ACP function modifier bits.

    ACP_MODIFIERS structure fill;
	fcode_fill_23 bitfield length #fcode_size fill;
        ACCESS bitfield mask;				/* Access file
        CREATE bitfield mask;				/* Create file
        DELETE bitfield mask;				/* Delete file
        MOUNT bitfield mask;				/* Mount volume
        DMOUNT bitfield mask;				/* Dismount volume
        REMOUNT bitfield mask;				/* Remount volume
	MOVEFILE bitfield mask;				/* Move a file
	filler_8 bitfield length 1 fill; 		/* Used for EXFUNC
	RWSHELVED bitfield mask;			/* Access shelved files
	SETDIR bitfield mask;				/* Set file as a directory
							/* Bit 19 used for TRUSTED
    end ACP_MODIFIERS;
    
    /* CR (card reader) driver function modifier bits.

    CR_MODIFIERS structure fill;
	fcode_fill_24 bitfield length #fcode_size fill;
        BINARY bitfield mask;				/* Binary read
        PACKED bitfield mask;				/* Packed read
    end CR_MODIFIERS;

    /* MB (mailbox) driver function modifier bits.
    /* The following modifers are for the QIO READ, WRITE and SENSEMODE
    /* functions.

    MB_MODIFIERS structure fill;
	fcode_fill_25 bitfield length #fcode_size fill;
        NOW bitfield mask;				/* Do not wait for operation complete
 	STREAM bitfield mask;				/* Perform stream mode operation (vs. record mode)
  	READERCHECK bitfield mask;			/* Perform operation if no read channel is assigned to the mailbox.
 	WRITERCHECK bitfield mask;			/* Perform operation if no write channel is assigned to the mailbox.
	NORSWAIT bitfield mask;				/* Do not allow resource waits
							/* Bit 13 used for EXFUNC
							/* Bit 19 used for TRUSTED
    end MB_MODIFIERS;
    
    /* More MB (mailbox) driver function modifier bits.
    /* Mailbox QIO SETMODE function modifiers.

    MB_SETMODE_MODIFIERS structure fill;
	fcode_fill_26 bitfield length #fcode_size fill;
        MB_ROOM_NOTIFY bitfield mask;			/* Notify when some (any) space in the mailbox is available.
        READATTN bitfield mask;				/* Request ast on waiting reader
        WRTATTN bitfield mask;				/* Request ast on waiting writer
        SETPROT bitfield mask;				/* Set volume protection
  	READERWAIT bitfield mask;			/* Wait for a read channel to be assigned to the mailbox.
  	WRITERWAIT bitfield mask;			/* Wait for a write channel to be assigned to the mailbox.
    end MB_SETMODE_MODIFIERS;
    
    /* TT driver READ function modifier bits.

    TT_READ_MODIFIERS structure fill;
	fcode_fill_27 bitfield length #fcode_size fill;
        NOECHO bitfield mask;				/* Noecho
        TIMED bitfield mask;				/* Timed
        CVTLOW bitfield mask;				/* Convert lower case
        NOFILTR bitfield mask;				/* No filter
        DSABLMBX bitfield mask;				/* Disable mailbox
        PURGE bitfield mask;				/* Purge typeahead
        TRMNOECHO bitfield mask;			/* Terminators are not echoed
        REFRESH bitfield mask;				/* Control-R interrupted read
        ESCAPE bitfield mask;				/* Terminate read on escape sequence
        EXTEND bitfield mask;				/* Used by alternate class drivers
    end TT_READ_MODIFIERS;
    
    /* TT driver WRITE function modifier bits.

    TT_WRITE_MODIFIERS structure fill;
	fcode_fill_28 bitfield length #fcode_size fill;
        CANCTRLO bitfield mask;				/* Cancel control O
        ENABLMBX bitfield mask;				/* Enable mailbox
        NOFORMAT bitfield mask;				/* Do not format output
	BREAKTHRU bitfield mask;			/* Broadcast I/O
	NEWLINE bitfield mask;				/* Output a newline
							{  NOTE: bit 13 is refresh
    end TT_WRITE_MODIFIERS;
    
    /* TT driver SENSEMODE function modifier bits.

    TT_SENSEMODE_MODIFIERS structure fill;
	fcode_fill_29 bitfield length #fcode_size fill;
        TYPEAHDCNT bitfield mask;			/* Sense typeahead information
        reserve_rd_modem bitfield length 1 fill;	{  Reserve RD_MODEM bit
    end TT_SENSEMODE_MODIFIERS;

    /* TT driver SETMODE subfunction modifier bits.

    TT_SETMODE_MODIFIERS structure fill;
	fcode_fill_30 bitfield length #fcode_size fill;
        MAINT bitfield mask;				/* Enable maint sub modifiers
        CTRLYAST bitfield mask;				/* Set control Y AST
        CTRLCAST bitfield mask;				/* Set Control C
        HANGUP bitfield mask;				/* Set mode and hang up line
        OUTBAND bitfield mask;				/* Set out of band AST
	TT_CONNECT BITFIELD MASK;			/* Connect to detached terminal
	TT_DISCON BITFIELD MASK;			/* Disconnect detached terminal
	TT_PROCESS BITFIELD MASK;			/* Define controlling process
	BRDCST BITFIELD MASK;				/* Define broadcast mask
    end TT_SETMODE_MODIFIERS;
    
    /* TT driver MAINTIANCE subfunction submodifier bits.

    TT_MAINT_MODIFIERS structure fill;
	fcode_fill_31 bitfield length #fcode_size fill;
	reserve_maint_escape_1 bitfield length 1 fill;	{  Reserve maintenance escape
        LOOP bitfield mask;				/* Diagnostic loopback
        UNLOOP bitfield mask;				/* Diagnostic reset loopback
        LINE_OFF bitfield mask;				/* Disable line
        SET_MODEM bitfield mask;			/* Diagnostic modem control
        LINE_ON bitfield mask;				/* Enable line
        LOOP_EXT bitfield mask;				/* Diagnostic external loopback
	AUTXOF_ENA bitfield mask;			/* Enable auto XOFF
	AUTXOF_DIS bitfield mask;			/* Disable auto XOFF
	reserve_int_disable bitfield length 1 fill;	{  Reserve internal disable bit
    end TT_MAINT_MODIFIERS;
    
    /* TT driver out-of-band modifier bits.

    TT_OUTOFBAND_MODIFIERS structure fill;
	fcode_fill_32 bitfield length #fcode_size fill;
	reserve_maint_escape_2 bitfield length 5 fill;	{  Reserve maintenance escape
        INCLUDE bitfield mask;				/* Include character in stream
	TT_ABORT BITFIELD MASK;				/* Abort current I/O
    end TT_OUTOFBAND_MODIFIERS;
    
    /* Posix terminal driver SETMODE subfunction modifier bits.

    TT_PSXSETMODE_MODIFIERS structure fill;
	fcode_fill_33 bitfield length #fcode_size fill;
        POSIXINIT bitfield mask;			/* Enable initialization subfunctions
	POSIXFLOW bitfield mask;			/* Enable flow control subfunctions
    end TT_PSXSETMODE_MODIFIERS;

    /* Posix terminal driver INIT subfunction submodifier bits.

    TT_POSIXINIT_MODIFIERS structure fill;
	fcode_fill_34 bitfield length #fcode_size fill;
	reserve_init_escape bitfield length 1 fill;	{  Reserve init escape
        SET_POSIX bitfield mask;			/* Set TT3$M_POSIX and set up PTC
        CLEAR_POSIX bitfield mask;			/* Clear TT3$M_POSIX (opt. delete PTC)
	SET_TERMIOS bitfield mask;			/* Set up termios
	SET_PTC bitfield mask;				/* Set up all of PTC
	CLEAR_PTC bitfield mask;			/* clear PTC
	FLUSH_TAB bitfield mask;			/* flush typeahead buffer
	FLUSH_OUTPUT bitfield mask;			/* flush outstanding writes
	UPDATE_PTC bitfield mask;			/* update PTC
    end TT_POSIXINIT_MODIFIERS;

    /* Posix terminal driver FLOW subfunction submodifier bits.

    TT_POSIXFLOW_MODIFIERS structure fill;
	fcode_fill_35 bitfield length #fcode_size fill;
	reserve_flow_escape bitfield length 2 fill;	{  Reserve flow escape
        OUT_XOFF bitfield mask;				/* Simulate output XOFF
        OUT_XON bitfield mask;				/* Simulate output XON
        IN_XOFF bitfield mask;				/* Simulate input XOFF
        IN_XON bitfield mask;				/* Simulate input XON
    end TT_POSIXFLOW_MODIFIERS;

    /* Posix terminal driver READ function modifier bits.

    TT_PSXREAD_MODIFIERS structure fill;
	fcode_fill_36 bitfield length #fcode_size fill;
        O_NONBLOCK bitfield mask;			/* Nonblock
    end TT_PSXREAD_MODIFIERS;

    /* Network WRITE and READ VIRTUAL function modifier bits.

    NET_WRITE_READ_MODIFIERS structure fill;
	fcode_fill_37 bitfield length #fcode_size fill;
        INTERRUPT bitfield mask;			/* Interrupt message
	MULTIPLE  bitfield mask;			/* Multiple write/read request 
	LOCKBUF   bitfield mask;			/* Direct I/O request
	NOBLOCK   bitfield mask;			/* Segment message w/o blocking
							/* Bit 13 used for EXFUNC
							/* Bit 19 used for TRUSTED
    end NET_WRITE_READ_MODIFIERS;

    /* Network ACCESS/DEACCESS function modifier bits.

    NET_ACCDEA_MODIFIERS structure fill;
	fcode_fill_38 bitfield length #fcode_size fill;
	reserved bitfield length 2 fill;
        ABORT bitfield mask;				/* Disconnect abort/connect reject
        SYNCH bitfield mask;				/* Synchronous disconnect
    end NET_ACCDEA_MODIFIERS;

    /* DATALINK driver WRITE subfunction modifier bits.

    DLINK_WRITE_MODIFIERS structure fill;
	fcode_fill_39 bitfield length #fcode_size fill;
        RESPONSE bitfield mask;				/* Transmit this packet as a response
    end DLINK_WRITE_MODIFIERS;

    /* DATALINK driver SETMODE subfunction modifier bits. 

    DLINK_SETMODE_MODIFIERS structure fill;
	fcode_fill_40 bitfield length #fcode_size fill;
        STARTUP bitfield mask;				/* Start protocol
        SHUTDOWN bitfield mask;				/* Stop protocol
        ATTNAST bitfield mask;				/* Attention AST
        CTRL bitfield mask;				/* Controller (ie. not station) function
	reserve_set_modem bitfield length 1 fill;	{  Reserve set modem bit
	SET_MAC bitfield mask;				/* Set MAC parameters
	UPDATE_MAP bitfield mask;			/* Functional Addr Map
	ROUTE bitfield mask; 				/* Source Routing Ops
    end DLINK_SETMODE_MODIFIERS;

    /* DATALINK driver SENSEMODE subfunction modifier bits.

    DLINK_SENSEMODE_MODIFIERS structure fill;
	fcode_fill_41 bitfield length #fcode_size fill;
        RD_MEM bitfield mask;				/* Read device memory
        RD_MODEM bitfield mask;				/* Read modem status
        RD_COUNT bitfield mask;				/* Read counters
	reserve_ctrl bitfield length 1 fill;		{  Controller function (SETMODE compatible)
        CLR_COUNT bitfield mask;			/* Clear counters
	SENSE_MAC bitfield mask;			/* Sense MAC parameters
	SHOW_MAP bitfield mask;				/* Functional Addr Map
	SHOW_ROUTE bitfield mask; 			/* Source Routing Ops
    end DLINK_SENSEMODE_MODIFIERS;
    
    constant SRRUNOUT	equals 0;			/* Send or rcv until cnt runout 
    constant PTPBSC	equals 8192;			/* Point to point BSC control 
    constant LOOPTEST	equals 57344;			/* Loop test 

    /* X25 driver WRITEBLK function modifier bits.

    X25_WRITE_MODIFIERS structure fill;
	fcode_fill_42 bitfield length #fcode_size fill;
        MORE bitfield mask;				/* More data follows (M-bit)
        QUALIFIED bitfield mask;			/* Use qualified sub-channel (Q-bit)
    end X25_WRITE_MODIFIERS;
    
    /* X25 driver ACCESS function modifier bits.

    X25_ACCESS_MODIFIERS structure fill;
	fcode_fill_43 bitfield length #fcode_size fill;
        REDIRECT bitfield mask;				/* Redirect virtual call
        ACCEPT bitfield mask;				/* Accept virtual call
    end X25_ACCESS_MODIFIERS;
    
    /* LPA-11 driver STARTDATA modifier bits.

    LPA_START_MODIFIERS structure fill;
	fcode_fill_44 bitfield length #fcode_size fill;
        SETEVF bitfield mask;				/* Set event flag
    end LPA_START_MODIFIERS;

    /* XA (DR11-W) driver function modifier bits.

    XA_MODIFIERS structure fill;
	fcode_fill_45 bitfield length #fcode_size fill;
        "WORD" bitfield mask;				/* Word (interrupt)/block (DMA) mode specifier
	filler_3 bitfield length 1 fill;		/* IO$M_TIMED
	filler_4 bitfield length 1 fill;		/* IO$M_ATTNAST, IO$M_DIAGNOSTIC
        SETFNCT bitfield mask;				/* Set "FNCT" bits in device CSR
        DATAPATH bitfield mask;				/* Change UBA datapath (direct/buffered)
	filler_5 bitfield length 1 fill;		/* IO$M_INHERLOG (former def'n for RESET)
        CYCLE bitfield mask;				/* Set "cycle" bit in device CSR
        RESET bitfield mask;				/* Device reset specifier
    end XA_MODIFIERS;
    
    /* 3271 driver function modifier bits.

    IBM3271_MODIFIERS structure fill;
	fcode_fill_46 bitfield length #fcode_size fill;
	filler_6 bitfield length 2 fill;
        SETCUADR bitfield mask;				/* Set a new CU address
        SETBSIZE bitfield mask;				/* Set a new maximum buffer size
        SETPOOLSZ bitfield mask;			/* Set a new pool size
        SETENQCNT bitfield mask;			/* Set a new ENQ threshold
        CLEAR bitfield mask;				/* Zero status counters
        LPBEXT bitfield mask;				/* Loopback is external loopback
        LPBINT bitfield mask;				/* Loopback is internal loopback (DUP11)
        READCSR bitfield mask;				/* Read CSRs on DUP11
    end IBM3271_MODIFIERS;
    
    /* XW driver function modifier bits.

    XW_MODIFIERS structure fill;
	fcode_fill_47 bitfield length #fcode_size fill;
        NOCTSWAIT bitfield mask;			/* Diagnostic function 
        SLAVLOOP bitfield mask;				/* Diagnostic function 
        NODSRWAIT bitfield mask;			/* Do not wait for DSR (diag) 
        MAINTLOOP bitfield mask;			/* Internal maint loop 
        LASTBLOCK bitfield mask;			/* Last block of message 
        filler_7 bitfield length 1 fill;
        INTCLOCK bitfield mask;				/* Internal clock 
    end XW_MODIFIERS;

    /* LAT driver function modifier bits.

    LT_MODIFIERS structure fill;
	fcode_fill_48 bitfield length #fcode_size fill;
	LT_CONNECT bitfield mask;			/* Solicit connection to remote LAT device
	LT_DISCON bitfield mask;			/* Disconnect LAT session
	LT_READPORT bitfield mask;			/* Read LAT device info
	LT_MAP_PORT bitfield mask;			/* Map application port
	LT_RATING bitfield mask;			/* Set service rating
	LT_SOL_INFO bitfield mask;			/* Request solicit info
	LT_RCV_INFO bitfield mask;			/* Setup to recive reply
	LT_SETMODE bitfield mask;			/* SETMODE on LTA device
	LT_SENSEMODE bitfield mask;			/* SENSEMODE on LTA device
	LT_QUE_CHG_NOTIF bitfield mask;			/* Queue change AST
    end LT_MODIFIERS;

    /* LAT item list definitions for MAP_PORT

    LT_MAPITEM structure fill;
	LT_MAP_FILLER bitfield mask;			/* Item 0 not used
	LT_MAP_NODNAM bitfield mask;			/* Server node name
	LT_MAP_PORNAM bitfield mask;			/* Server port name
	LT_MAP_SRVNAM bitfield mask;			/* Server service name
	LT_MAP_LNKNAM bitfield mask;			/* Link name
	LT_MAP_NETADR bitfield mask;			/* Server Ethernet Add.
    end LT_MAPITEM;

    /* FSDRIVER function modifiers for Dollar.

    FS_MODIFIERS structure fill;
    	fcode_fill_49 bitfield length #fcode_size fill;
	FLUSH bitfield mask;				/* Flush writes
	WRITE_BARRIER bitfield mask;			/* Barrier writes to this point
    end FS_MODIFIERS;

    /* MKDRIVER function modifiers for SETMODE

    MK_SETMODE_MODIFIERS structure fill;
        fcode_fill_50 bitfield length #fcode_size fill;
        MKFILL1 bitfield mask;                           /* Filler to not coincide with TU modifier (for safety)
        ALLOWFAST_NEVER bitfield mask;                  /* Disable all skip by filemarks
        ALLOWFAST_PER_IO bitfield mask;                 /* Enable skip by filemarks with i/o fcn modifier
        ALLOWFAST_ALWAYS bitfield mask;                 /* Default all IO$_SKIPFILE to use skip by filemarks
    end MK_SETMODE_MODIFIERS;

    /* Snapshot-capable disk (SD) driver function modifier bits.

    SD_MODIFIERS structure fill;
	fcode_fill_51 bitfield length #fcode_size fill;
        ADD bitfield mask;				/* Add UNIT to an existing pool
    end SD_MODIFIERS;
    
    /* USB usbattr modifiers

    USB_USBATTR_MODIFIERS structure fill;
       fcode_fill_52 bitfield length #fcode_size fill;
       IDSTRING bitfield mask;				/* Request for printer's 1284 device ID string
       SERIALNUM bitfield mask;				/* Request for printer's serial number (if supported)
    end USB_USBATTR_MODIFIERS;

    /* QIOServer PACKACK modifier

    QSRV_PACKACK_MODIFIERS structure fill;
	fcode_fill_53 bitfield length #fcode_size fill;
	QSRVFILL1 bitfield mask;			/* Filler to coincide with MSCP_FORMAT modifier (for safety)
	QSRV_CLIENT_UPDATE bitfield mask;		/* The PACKACK is just to update the client device database
    end QSRV_PACKACK_MODIFIERS;

end IODEF;

end_module $IODEF;
