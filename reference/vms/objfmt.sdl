        constant EOMMAX equals . prefix EOM$ tag C;	/*Maximum length of EOM record 
	TFRFLG_BITS structure fill;
            WKTFR bitfield mask;			/*Transfer address is weak 
	end TFRFLG_BITS;
    end TFRFLG_OVERLAY;
