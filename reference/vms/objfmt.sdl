/*
      
aggregate EGSDEF structure prefix EGSD$;
    RECTYP word unsigned;				/*Record type (OBJ$C_GSD) 
    constant ENTRIES equals . prefix EGSD$ tag K;	/*Offset to first entry in record 
    constant ENTRIES equals . prefix EGSD$ tag C;	/*Offset to first entry in record 
    RECSIZ word unsigned;				/*Size of theis EVAX EGSD
    ALIGNLW longword unsigned;				/*Insure that subrecords are QW aligned
    GSDTYP word unsigned;				/*Type of entry (first byte of entry) 
    constant PSC	equals 0  prefix EGSD tag $C;	/*Psect definition 
    constant SYM	equals 1  prefix EGSD tag $C;	/*Symbol specification 
    constant IDC	equals 2  prefix EGSD tag $C;	/*Random entity check 
    constant SPSC	equals 5  prefix EGSD tag $C;	/*Shareable image psect definition 
    constant SYMV	equals 6  prefix EGSD tag $C;	/*Vectored (dual-valued) versions of SYM,
    constant SYMM	equals 7  prefix EGSD tag $C;   /*Masked versions of SYM,
    constant SYMG       equals 8  prefix EGSD tag $C;   /*EGST - gst version of SYM
    constant PSC64      equals 9  prefix EGSD tag $C;   /*Psect with 64-bit length
    constant SPSC64	equals 10 prefix EGSD tag $C;	/*Shareable image psect definition w/64b len/base
    constant MAXRECTYP	equals 10 prefix EGSD tag $C;	/*Maximum entry type defined 
    GSDSIZ word unsigned;				/*Size of this entry 

end EGSDEF;

end_module $EGSDEF;

module $EGPSDEF;

