    TEMP byte unsigned;					/*pad for alignment 
    FLAGS word unsigned;				/*Maps over GSY$W_FLAGS 
    VAL_OVERLAY union fill;
    	"VALUE" quadword unsigned;
	"VALUE" longword unsigned;
    end VAL_OVERLAY;
    CA_OVERLAY union fill;
    	"CODE_ADDRESS" quadword unsigned;
	"CODE_ADDRESS" longword unsigned;
    end CA_OVERLAY;
    CA_PSINDX longword unsigned;                        /*Psect index of the code address (which is in
                                                        /*LP_1 if the norm bit is set).
    PSINDX longword unsigned;				/*Owning psect number 
    NAMLNG byte unsigned;				/*Length of name 
    constant NAME equals . prefix ESDF$ tag K;
    constant NAME equals . prefix ESDF$ tag C;
    NAME character length 31;				/*Symbol name 
end ESDFDEF;

end_module $ESDFDEF;

