    "ALIGN" byte unsigned;				/*P-sect alignment 
    TEMP byte unsigned;					/*pad for allignment
    FLAGS_OVERLAY union fill;
        FLAGS word unsigned;				/*P-sect flags 
	FLAGS_BITS structure fill;
            PIC bitfield mask;				/*Position independent 
            LIB bitfield mask;				/*From a shareable image 
            OVR bitfield mask;				/*Overlaid memory allocation 
            REL bitfield mask;				/*Relocatable 
            GBL bitfield mask;				/*Global scope 
            SHR bitfield mask;				/*Shareable 
            EXE bitfield mask;				/*Executable 
            RD bitfield mask;				/*Readable 
            WRT bitfield mask;				/*Writeable 
            VEC bitfield mask;				/*Vector psect 
	    NOMOD bitfield mask;			/*Not stored into
	    COM bitfield mask;				/*Associated with COMM sym
	    ALLOC_64BIT bitfield mask;			/*Load in 64-bit space
	end FLAGS_BITS;
    end FLAGS_OVERLAY;
    ALLOC_OVERLAY union fill;
	ALLOC quadword unsigned;			/*Length of this psect in shr image 
        ALLOC longword unsigned;			/* Low Longword
    end ALLOC_OVERLAY;
    BASE_OVERLAY union fill;
	BASE quadword unsigned;				/*Offset into img of psect, copy of symbol vector
        BASE longword unsigned;				/* Low Longword
    end BASE_OVERLAY;
    VALUE_OVERLAY union fill;
    	VALUE quadword unsigned;
	VALUE longword unsigned;
    end VALUE_OVERLAY;
    NAMLNG byte unsigned;				/*Length of p-sect name 
    constant NAME equals . prefix ESGPS64$ tag K;
    constant NAME equals . prefix ESGPS64$ tag C;
    NAME character length 31;				/*Name field 
end ESGPS64DEF;

end_module $ESGPSDEF;

module $EGSYDEF;
/*
/* EVAX GSD entry - Symbol definition
/*
/* common to definitions, references, and entry
/* point definitions.
/*

aggregate EGSYDEF structure prefix EGSY$ origin FILL_1;
    GSDTYP_OVERLAY union fill;
        GSDTYP word unsigned;				/*Type field 
	GSDTYP_FIELDS structure fill;
ifsymbol not_h_files;
            START character length 0 tag T;
end_ifsymbol;
            FILL_1 byte fill prefix EGSYDEF tag $$;
	end GSDTYP_FIELDS;
    end GSDTYP_OVERLAY;
    SIZE word unsigned;					/*size of this EGSY
    DATYP byte unsigned;				/*Symbol data type 
    TEMP byte unsigned;					/*pad for alignment
    FLAGS_OVERLAY union fill;
        FLAGS word unsigned;				/*Symbol flags 
	FLAGS_BITS structure fill;
            WEAK bitfield mask;				/*Weak symbol 
            DEF bitfield mask;				/*Definition 
            UNI bitfield mask;				/*Universal 
            REL bitfield mask;				/*Relocatable 
	    COMM bitfield mask;				/*C common globaldef
	    VECEP bitfield mask;			/*Vectored Entry Point
	    NORM bitfield mask;				/*Normal Procedure(FD)
	    QUAD_VAL bitfield mask;			/*Value is quadword
	end FLAGS_BITS;
    end FLAGS_OVERLAY;
end EGSYDEF;

end_module $EGSYDEF;

module $EGSTDEF;
/*
/* EVAX Universal Symbol Definition - used by the linker instead of ESDF$ records
/* when building the global symbol table.  The def and univ. bits should always
/* be set for these records.
/*
aggregate EGSTDEF structure prefix EGST$ origin FILL_1;
    GSDTYP_OVERLAY union fill;
        GSDTYP word unsigned;				/*Maps over GSY$B_GSDTYP 
	GSDTYP_FIELDS structure fill;
ifsymbol not_h_files;
            START character length 0 tag T;
end_ifsymbol;
            FILL_1 word fill prefix EGSTDEF tag $$;
	end GSDTYP_FIELDS;
    end GSDTYP_OVERLAY;
    SIZE word unsigned;					/*size of this EGST
    DATYP byte unsigned;				/*Maps over GSY$B_DATYP
    TEMP byte unsigned;					/*pad for alignment 
    FLAGS word unsigned;				/*Maps over GSY$W_FLAGS 
    VAL_OVERLAY union fill;
    	"VALUE" quadword unsigned;
	"VALUE" longword unsigned;
    end VAL_OVERLAY;
    LP1_OVERLAY union fill;
    	"LP_1" quadword unsigned;
	"LP_1" longword unsigned;
    end LP1_OVERLAY;
    LP2_OVERLAY union fill;
    	"LP_2" quadword unsigned;
	"LP_2" longword unsigned;
    end VAL_OVERLAY;
    PSINDX longword unsigned;				/*Owning psect number 
    NAMLNG byte unsigned;				/*Length of name 
    constant NAME equals . prefix EGST$ tag K;
    constant NAME equals . prefix EGST$ tag C;
    NAME character length 31;				/*Symbol name 
end EGSTDEF;

end_module $EGSTDEF;

module $ESDFDEF;
/*
/* EVAX Symbol definition
/*
aggregate ESDFDEF structure prefix ESDF$ origin FILL_1;
