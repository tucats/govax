; Storage map for RAMP, a REAL function
;   $VALUE  REAL (0:?)  hidden argument 1       @RAMP.$VALUE(AP)
;   N       INTEGER     argument 2              @RAMP.N(AP)
;   RAMP    REAL (0:?)  descriptor at $LOCAL+4  RAMP.RAMP
;   I       INTEGER     $LOCAL+0                RAMP.I
;
RAMP.$VALUE = 4				; $VALUE's value goes through hidden argument 1
RAMP.N = 8				; N is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
RAMP.I:	.BLKL	1			; I
RAMP.RAMP:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_F,DSC$K_CLASS_A
	.LONG	0			; RAMP: not allocated
	.BYTE	0,0,^XE0,1		; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0			; multipliers
	.LONG	0,0			; bounds
RAMP.$C1:
	.BLKL	1			; DO (line 12)'s count

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;    1        OPTIONS /F90
;    2  C     Array-valued functions (Phase 104, subtask 7b): a value whose bounds
;    3  C     are known only when the program runs, made by the function on the heap
;    4  C     and described in the caller's class NCA descriptor; a lower bound that
;    5  C     isn't 1; bounds from SIZE of an assumed-shape dummy; a recursive
;    6  C     function's reference to itself; references in an assignment, a
;    7  C     reduction, an output list, as an argument, and in a CALL with
;    8  C     alternate returns.
;    9        FUNCTION RAMP(N)
	.ENTRY	RAMP,^M<>
	MOVL	@RAMP.N(AP),RAMP.RAMP+28
	ADDL3	RAMP.RAMP+28,#1,RAMP.RAMP+20
	BLSS	RAMP.$2
	BRW	RAMP.$1
RAMP.$2:
	CLRL	RAMP.RAMP+20
RAMP.$1:
	MULL3	#4,RAMP.RAMP+20,RAMP.RAMP+12
	PUSHAQ	RAMP.RAMP
	CALLS	#1,G^FTN$GET_TEMP
	MOVAL	@RAMP.RAMP+4,RAMP.RAMP+16
	MOVL	#168427524,@RAMP.$VALUE(AP)
	MOVL	#2,R0
	MOVL	#16777216,@RAMP.$VALUE(AP)[R0]
	MOVL	#1,R0
	MOVL	RAMP.RAMP+4,@RAMP.$VALUE(AP)[R0]
	MOVL	#3,R0
	MOVL	RAMP.RAMP+12,@RAMP.$VALUE(AP)[R0]
	MOVL	#4,R0
	MOVL	RAMP.RAMP+16,@RAMP.$VALUE(AP)[R0]
	MOVL	#5,R0
	MOVL	#4,@RAMP.$VALUE(AP)[R0]
	MOVL	#6,R0
	CLRL	@RAMP.$VALUE(AP)[R0]
	MOVL	#7,R0
	SUBL3	#1,RAMP.RAMP+20,@RAMP.$VALUE(AP)[R0]
;   10        INTEGER N, I
;   11        REAL RAMP(0:N)
;   12        DO I = 0, N
	ADDL3	@RAMP.N(AP),#1,RAMP.$C1	; DO (line 12)'s count
	CLRL	RAMP.I
	TSTL	RAMP.$C1
	BGTR	RAMP.$4
	BRW	RAMP.$3
RAMP.$4:
RAMP.$5:				; DO (line 12)'s body
;   13          RAMP(I) = I
	MOVL	RAMP.RAMP+16,R0
	MOVL	RAMP.I,R1
	CVTLF	RAMP.I,(R0)[R1]
;   14        END DO
	INCL	RAMP.I
	DECL	RAMP.$C1		; one pass fewer
	BLEQ	RAMP.$6
	BRW	RAMP.$5
RAMP.$6:
RAMP.$3:
;   15        END FUNCTION
	RET

