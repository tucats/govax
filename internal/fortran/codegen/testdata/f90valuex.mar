; Storage map for TRI, a RECURSIVE INTEGER function
;   $VALUE  INTEGER (?)  hidden argument 1  @TRI.$VALUE(AP)
;   N       INTEGER      argument 2         @TRI.N(AP)
;   R       INTEGER (?)  FP-88              TRI.R(FP)
;
TRI.$VALUE = 4				; $VALUE's value goes through hidden argument 1
TRI.N = 8				; N is argument 2
TRI.R = -88				; R's value, INTEGER (?), made on the heap at entry: its descriptor, in the frame
TRI.$I1 = -56				; an array statement's loop index, in the frame
TRI.$T1 = -52				; temporary, in the frame
TRI.$G1 = -48				; a function's value of run-time shape, for one statement: its descriptor, in the frame
TRI.$T2 = -16				; temporary, in the frame
TRI.$T3 = -12				; temporary, in the frame
TRI.$T4 = -8				; temporary, in the frame
TRI.$C1 = -4				; array (line 40), dimension 1's count, in the frame

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;   35        END SUBROUTINE
;   36        OPTIONS /F90
;   37        RECURSIVE FUNCTION TRI(N) RESULT(R)
	.ENTRY	TRI,^M<R2,R3>
	SUBL2	#88,SP			; this activation's own storage
	MOVL	#67633156,TRI.R(FP)	; the descriptor's length, 4, type, and class
	MOVL	#31457280,TRI.R+8(FP)	; its flags and dimensions
	CLRL	TRI.R+12(FP)		; the array's size in bytes
	CLRL	TRI.R+20(FP)		; dimension 1's multiplier
	MOVL	#1,TRI.R+24(FP)		; dimension 1's lower bound
	CLRL	TRI.R+28(FP)		; dimension 1's upper bound
	MOVL	@TRI.N(AP),TRI.R+28(FP)
	MOVL	TRI.R+28(FP),TRI.R+20(FP)
	BLSS	TRI.$2
	BRW	TRI.$1
TRI.$2:
	CLRL	TRI.R+20(FP)		; dimension 1's multiplier
TRI.$1:
	MULL3	#4,TRI.R+20(FP),TRI.R+12(FP)
	PUSHAQ	TRI.R(FP)
	CALLS	#1,G^FTN$GET_TEMP
	MOVL	TRI.R+4(FP),R0
	MOVAL	-4(R0),TRI.R+16(FP)
	MOVL	#168296452,@TRI.$VALUE(AP)
	MOVL	#2,R0
	MOVL	#16777216,@TRI.$VALUE(AP)[R0]
	MOVL	#1,R0
	MOVL	TRI.R+4(FP),@TRI.$VALUE(AP)[R0]
	MOVL	#3,R0
	MOVL	TRI.R+12(FP),@TRI.$VALUE(AP)[R0]
	MOVL	#4,R0
	MOVL	TRI.R+16(FP),@TRI.$VALUE(AP)[R0]
	MOVL	#5,R0
	MOVL	#4,@TRI.$VALUE(AP)[R0]
	MOVL	#6,R0
	MOVL	#1,@TRI.$VALUE(AP)[R0]
	MOVL	#7,R0
	MOVL	TRI.R+20(FP),@TRI.$VALUE(AP)[R0]
	CLRL	TRI.$G1+4(FP)		; no string yet
;   38        INTEGER N, R(N)
;   39        R(N) = N
	MOVL	TRI.R+16(FP),R0
	MOVL	@TRI.N(AP),R1
	MOVL	@TRI.N(AP),(R0)[R1]
;   40        IF (N > 1) R(1:N - 1) = TRI(N - 1)
	CMPL	@TRI.N(AP),#1
	BGTR	TRI.$4
	BRW	TRI.$3
TRI.$4:
	SUBL3	#1,@TRI.N(AP),TRI.$T1(FP)
	TSTL	TRI.$G1+4(FP)
	BNEQ	TRI.$6
	BRW	TRI.$5
TRI.$6:
	PUSHL	#0
	PUSHAQ	TRI.$G1(FP)
	CALLS	#2,G^FTN$DEALLOCATE
TRI.$5:
	SUBL3	#1,@TRI.N(AP),TRI.$T2(FP)
	PUSHAL	TRI.$T2(FP)
	PUSHAQ	TRI.$G1(FP)
	CALLS	#2,G^TRI
	SUBL3	#1,TRI.$G1+24(FP),TRI.$T3(FP)
	MOVL	TRI.$T1(FP),TRI.$T4(FP)
	BLSS	TRI.$8
	BRW	TRI.$7
TRI.$8:
	CLRL	TRI.$T4(FP)
TRI.$7:
	MOVL	TRI.$T4(FP),TRI.$C1(FP)	; array (line 40), dimension 1's count
	MOVL	#1,TRI.$I1(FP)
	TSTL	TRI.$C1(FP)
	BGTR	TRI.$10
	BRW	TRI.$9
TRI.$10:
TRI.$11:				; array (line 40), dimension 1's body
	MOVL	TRI.$G1+16(FP),R0
	ADDL3	TRI.$I1(FP),TRI.$T3(FP),R1
	MOVL	TRI.R+16(FP),R2
	MOVL	TRI.$I1(FP),R3
	MOVL	(R0)[R1],(R2)[R3]
	INCL	TRI.$I1(FP)
	DECL	TRI.$C1(FP)		; one pass fewer
	BLEQ	TRI.$12
	BRW	TRI.$11
TRI.$12:
TRI.$9:
	TSTL	TRI.$G1+4(FP)
	BNEQ	TRI.$14
	BRW	TRI.$13
TRI.$14:
	PUSHL	#0
	PUSHAQ	TRI.$G1(FP)
	CALLS	#2,G^FTN$DEALLOCATE
TRI.$13:
TRI.$3:
;   41        END FUNCTION
	RET

	.END
