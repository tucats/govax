	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;   16        OPTIONS /F90
;   17        SUBROUTINE USE(A, N)
	.ENTRY	USE,^M<R2,R3>
