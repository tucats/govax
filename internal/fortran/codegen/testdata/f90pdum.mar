	.TITLE	TEST
	$DSCDEF				; descriptor codes, DSC$K_

; Storage map for F90PDUM, a subroutine
;   IP    INTEGER, POINTER            an argument  @F90PDUM.$A1
;   AP    REAL, POINTER (:)           an argument  @F90PDUM.$A2
;   CP    CHARACTER*(*), POINTER      argument 3   @F90PDUM.CP(AP)
;   OP    INTEGER, POINTER, OPTIONAL  an argument  @F90PDUM.$A4
;   N     INTEGER, TARGET             $LOCAL+0     F90PDUM.N
;   V     REAL, TARGET (10)           $LOCAL+4     F90PDUM.V
;   S     CHARACTER*8, TARGET         $LOCAL+44    F90PDUM.S
;
F90PDUM.CP = 12				; CP is argument 3

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
F90PDUM.N:
	.BLKL	1			; N
F90PDUM.V:
	.BLKL	10			; V, REAL, TARGET (10)
F90PDUM.S:
	.BLKL	2			; S
F90PDUM.$A4:
	.BLKL	1			; OP's longword of the argument list, set at each entry point
F90PDUM.$A1:
	.BLKL	1			; IP's longword of the argument list, set at each entry point
F90PDUM.$A2:
	.BLKL	1			; AP's longword of the argument list, set at each entry point
F90PDUM.$I1:
	.BLKL	1			; an array statement's loop index
F90PDUM.$D1:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_F,DSC$K_CLASS_NCA
	.LONG	0			; set when the descriptor is used
	.BYTE	0,0,0,1			; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0			; strides, in bytes
	.LONG	0,0			; bounds

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;    1        OPTIONS /F90
;    2  C     Pointer dummy arguments (Phase 107, subtask 6a): each is the
;    3  C     address of the caller's own pointer storage, a longword (IP), a
;    4  C     class S descriptor (CP, its length the caller's), or a class NCA
;    5  C     descriptor (AP, reached as a located cell at the address its
;    6  C     argument holds); =>, an element, ALLOCATE, DEALLOCATE, NULLIFY of
;    7  C     an OPTIONAL one, ASSOCIATED, and LEN through them; the pointers
;    8  C     passed on to an internal procedure's pointer dummies, which also
;    9  C     reach the host's.
;   10        SUBROUTINE F90PDUM(IP, AP, CP, OP)
	.ENTRY	F90PDUM,^M<R2>
	CLRL	F90PDUM.$A4		; OP is argument 4, if the caller passed it
	CMPB	(AP),#4
	BLSSU	F90PDUM.$9
	MOVL	16(AP),F90PDUM.$A4
F90PDUM.$9:
	MOVL	4(AP),F90PDUM.$A1	; IP is argument 1
	MOVL	8(AP),F90PDUM.$A2	; AP is argument 2
;   11        INTEGER, POINTER :: IP
;   12        REAL, POINTER :: AP(:)
;   13        CHARACTER(LEN=*), POINTER :: CP
;   14        INTEGER, POINTER, OPTIONAL :: OP
;   15        INTEGER, TARGET :: N
;   16        REAL, TARGET :: V(10)
;   17        CHARACTER(LEN=8), TARGET :: S
;   18        IP => N
	MOVAL	F90PDUM.N,@F90PDUM.$A1
;   19        IP = IP + 1
	MOVL	@F90PDUM.$A1,R0
	MOVL	@F90PDUM.$A1,R1
	ADDL3	(R0),#1,(R1)
;   20        AP => V(2:10:2)
	MOVL	F90PDUM.$A2,R0
	MOVAL	F90PDUM.V+4,4(R0)
	MOVL	F90PDUM.$A2,R0
	MOVL	#8,20(R0)
	MOVL	F90PDUM.$A2,R0
	MOVL	#1,24(R0)
	MOVL	F90PDUM.$A2,R0
	MOVL	#5,28(R0)
	MOVL	F90PDUM.$A2,R0
	MOVL	F90PDUM.$A2,R1
	SUBL3	#8,4(R0),16(R1)
	MOVL	F90PDUM.$A2,R0
	MOVL	#20,12(R0)
;   21        AP(2) = AP(1)
	MOVL	F90PDUM.$A2,R0
	MOVL	F90PDUM.$A2,R1
	ADDL3	16(R0),20(R1),R0
	MOVL	F90PDUM.$A2,R1
	MOVL	F90PDUM.$A2,R2
	MULL3	#2,20(R2),R2
	ADDL3	16(R1),R2,R1
	MOVF	(R0),(R1)
;   22        CP => S(1:4)
	MOVL	F90PDUM.CP(AP),R0
	MOVAB	F90PDUM.S,4(R0)
;   23        ALLOCATE (AP(N))
	PUSHL	F90PDUM.N
	PUSHL	#1
	PUSHL	#2
	PUSHAL	@F90PDUM.$A2
	CALLS	#4,G^FTN$ALLOCATE
;   24        DEALLOCATE (AP)
	PUSHL	#2
	PUSHAL	@F90PDUM.$A2
	CALLS	#2,G^FTN$DEALLOCATE
;   25        IF (PRESENT (OP)) NULLIFY (OP)
	TSTL	F90PDUM.$A4
	BNEQ	F90PDUM.$2
	BRW	F90PDUM.$1
F90PDUM.$2:
	CLRL	@F90PDUM.$A4
F90PDUM.$1:
;   26        IF (ASSOCIATED (AP, V)) N = LEN (CP)
	MOVAL	F90PDUM.V,F90PDUM.$D1+4
	MOVL	#4,F90PDUM.$D1+20
	MOVL	#1,F90PDUM.$D1+24
	MOVL	#10,F90PDUM.$D1+28
	SUBL3	#4,F90PDUM.$D1+4,F90PDUM.$D1+16
	MOVL	#40,F90PDUM.$D1+12
	MOVL	F90PDUM.$A2,R0
	CMPL	4(R0),F90PDUM.$D1+4
	BEQL	F90PDUM.$4
	BRW	F90PDUM.$3
F90PDUM.$4:
	MOVL	F90PDUM.$A2,R0
	TSTL	4(R0)
	BNEQ	F90PDUM.$5
	BRW	F90PDUM.$3
F90PDUM.$5:
	MOVL	F90PDUM.$A2,R0
	CMPL	20(R0),F90PDUM.$D1+20
	BEQL	F90PDUM.$6
	BRW	F90PDUM.$3
F90PDUM.$6:
	MOVL	F90PDUM.$A2,R0
	MOVL	F90PDUM.$A2,R1
	SUBL3	24(R1),28(R0),R0
	SUBL3	F90PDUM.$D1+24,F90PDUM.$D1+28,R1
	CMPL	R0,R1
	BEQL	F90PDUM.$7
	BRW	F90PDUM.$3
F90PDUM.$7:
	TSTL	F90PDUM.$D1+12
	BGTR	F90PDUM.$8
	BRW	F90PDUM.$3
F90PDUM.$8:
	MOVZWL	@F90PDUM.CP(AP),F90PDUM.N
F90PDUM.$3:
;   27        CALL INNER(IP, AP)
	PUSHAL	@F90PDUM.$A2
	PUSHAL	@F90PDUM.$A1
	CALLS	#2,F90PDUM.INNER
;   28        CONTAINS
	RET

; Storage map for F90PDUM.INNER, a subroutine
;   JP    INTEGER, POINTER   argument 1  @F90PDUM.INNER.JP(AP)
;   BP    REAL, POINTER (:)  argument 2  @F90PDUM.INNER.BP(AP)
;
F90PDUM.INNER.JP = 4			; JP is argument 1
F90PDUM.INNER.BP = 8			; BP is argument 2

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;   29        SUBROUTINE INNER(JP, BP)
F90PDUM.INNER:
	.WORD	^M<>			; internal procedure INNER of F90PDUM
;   30        INTEGER, POINTER :: JP
;   31        REAL, POINTER :: BP(:)
;   32        JP => IP
	MOVL	@F90PDUM.$A1,@F90PDUM.INNER.JP(AP)
;   33        BP => AP
	MOVL	F90PDUM.$A2,R0
	MOVL	F90PDUM.INNER.BP(AP),R1
	MOVL	4(R0),4(R1)
	MOVL	F90PDUM.$A2,R0
	MOVL	F90PDUM.INNER.BP(AP),R1
	MOVL	8(R0),8(R1)
	MOVL	F90PDUM.$A2,R0
	MOVL	F90PDUM.INNER.BP(AP),R1
	MOVL	12(R0),12(R1)
	MOVL	F90PDUM.$A2,R0
	MOVL	F90PDUM.INNER.BP(AP),R1
	MOVL	16(R0),16(R1)
	MOVL	F90PDUM.$A2,R0
	MOVL	F90PDUM.INNER.BP(AP),R1
	MOVL	20(R0),20(R1)
	MOVL	F90PDUM.$A2,R0
	MOVL	F90PDUM.INNER.BP(AP),R1
	MOVL	24(R0),24(R1)
	MOVL	F90PDUM.$A2,R0
	MOVL	F90PDUM.INNER.BP(AP),R1
	MOVL	28(R0),28(R1)
;   34        END SUBROUTINE
	RET
;   35        END

	.END
