	.TITLE	TEST
	$DSCDEF				; descriptor codes, DSC$K_

; Storage map for SPAN, an INTEGER function
;   SPAN  INTEGER (3)  hidden argument 1  @SPAN.SPAN(AP)
;   N     INTEGER      argument 2         @SPAN.N(AP)
;
SPAN.SPAN = 4				; SPAN's value goes through hidden argument 1
SPAN.N = 8				; N is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
SPAN.$I1:
	.BLKL	1			; an array statement's loop index
SPAN.$C1:
	.BLKL	1			; array (line 9), dimension 1's count

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;    1        OPTIONS /F90
;    2  C     Array-valued functions (Phase 104, subtask 7a): a function whose value
;    3  C     is an array of a shape known when compiling, assigned whole and by
;    4  C     element; references through an interface body, from an internal
;    5  C     function, and a recursive one's to itself with RESULT; a value in an
;    6  C     expression, as an argument, in an output list; a CHARACTER array value.
;    7        FUNCTION SPAN(N)
	.ENTRY	SPAN,^M<>
;    8        INTEGER N, SPAN(3)
;    9        SPAN = N
	MOVL	#3,SPAN.$C1		; array (line 9), dimension 1's count
	MOVL	#1,SPAN.$I1
SPAN.$1:				; array (line 9), dimension 1's body
	SUBL3	#1,SPAN.$I1,R0
	MOVL	@SPAN.N(AP),@SPAN.SPAN(AP)[R0]
	INCL	SPAN.$I1
	DECL	SPAN.$C1		; one pass fewer
	BLEQ	SPAN.$2
	BRW	SPAN.$1
SPAN.$2:
;   10        SPAN(2) = 2 * N
	MOVL	#1,R0
	MULL3	#2,@SPAN.N(AP),@SPAN.SPAN(AP)[R0]
;   11        END FUNCTION
	RET

; Storage map for USE, a subroutine
;   A     REAL (3)         argument 1  @USE.A(AP)
;   K     INTEGER (3)      $LOCAL+0    USE.K
;   C     CHARACTER*4 (2)  $LOCAL+12   USE.C
;
USE.A = 4				; A is argument 1

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
USE.K:	.BLKL	3			; K, INTEGER (3)
USE.C:	.BLKL	2			; C, CHARACTER*4 (2)
USE.$I1:
	.BLKL	1			; an array statement's loop index
USE.$W1:
	.BLKL	3			; an array temporary of 12 bytes, for one statement
USE.$C1:
	.BLKL	1			; array (line 22), dimension 1's count
USE.$W2:
	.BLKL	3			; an array temporary of 12 bytes, for one statement
USE.$D1:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_F,DSC$K_CLASS_NCA
	.LONG	0			; set when the descriptor is used
	.BYTE	0,0,0,1			; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0			; strides, in bytes
	.LONG	0,0			; bounds
USE.$C2:
	.BLKL	1			; array (line 23), dimension 1's count
USE.$C3:
	.BLKL	1			; array (line 24), dimension 1's count
USE.$D2:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_L,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used
USE.$I2:
	.BLKL	1			; an array statement's loop index
USE.$T1:
	.BLKL	1			; temporary
USE.$C4:
	.BLKL	1			; array (line 24), dimension 1's count
USE.$W3:
	.BLKL	3			; an array temporary of 12 bytes, for one statement
USE.$C5:
	.BLKL	1			; array (line 25), dimension 1's count
USE.$W4:
	.BLKL	2			; an array temporary of 8 bytes, for one statement
USE.$C6:
	.BLKL	1			; array (line 26), dimension 1's count

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
USE.$K1:
	.LONG	4
USE.$IO1:
	.WORD	8			; an I/O statement's control block: its size
	.WORD	^X0000			; flags: none
	.LONG	0			; (not used yet)
USE.$K2:
	.LONG	1
USE.$D3:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_F,DSC$K_CLASS_S
	.ADDRESS USE.$T1
USE.$D4:
	.WORD	2			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS USE.$K3
USE.$D5:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_A
	.ADDRESS USE.$W4
	.BYTE	0,0,^XE0,1		; scale, digits, flags, dimensions
	.LONG	8			; the array's size in bytes
	.ADDRESS USE.$W4-4		; A0, where the element with zero subscripts would be
	.LONG	2			; multipliers
	.LONG	1,2			; bounds
USE.$F1:
	.LONG	^X00004100		; 2.0
USE.$K3:
	.ASCII	/AB/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;   12        OPTIONS /F90
;   13        SUBROUTINE USE(A)
	.ENTRY	USE,^M<R2,R3,R4,R5>
;   14        REAL A(3)
;   15        INTEGER K(3)
;   16        CHARACTER*4 C(2)
;   17        INTERFACE
;   18          FUNCTION SPAN(N)
;   19          INTEGER N, SPAN(3)
;   20          END FUNCTION
;   21        END INTERFACE
;   22        K = SPAN(4) + 1
	PUSHAL	USE.$K1
	PUSHAL	USE.$W1
	CALLS	#2,G^SPAN
	MOVL	#3,USE.$C1		; array (line 22), dimension 1's count
	MOVL	#1,USE.$I1
USE.$1:					; array (line 22), dimension 1's body
	MOVL	USE.$I1,R0
	MOVL	USE.$I1,R1
	ADDL3	USE.$W1-4[R0],#1,USE.K-4[R1]
	INCL	USE.$I1
	DECL	USE.$C1			; one pass fewer
	BLEQ	USE.$2
	BRW	USE.$1
USE.$2:
;   23        A = HALF(A) * 2.0
	MOVAL	@USE.A(AP),USE.$D1+4
	MOVL	#4,USE.$D1+20
	MOVL	#1,USE.$D1+24
	MOVL	#3,USE.$D1+28
	SUBL3	#4,USE.$D1+4,USE.$D1+16
	MOVL	#12,USE.$D1+12
	PUSHAQ	USE.$D1
	PUSHAL	USE.$W2
	CALLS	#2,USE.HALF
	MOVL	#3,USE.$C2		; array (line 23), dimension 1's count
	MOVL	#1,USE.$I1
USE.$3:					; array (line 23), dimension 1's body
	MOVL	USE.$I1,R0
	SUBL3	#1,USE.$I1,R1
	MULF3	USE.$W2-4[R0],USE.$F1,@USE.A(AP)[R1]
	INCL	USE.$I1
	DECL	USE.$C2			; one pass fewer
	BLEQ	USE.$4
	BRW	USE.$3
USE.$4:
;   24        PRINT *, SPAN(1), SUM(HALF(A))
	PUSHL	#-1
	PUSHAB	USE.$IO1
	CALLS	#2,G^FTN$WRITE_SL
	PUSHAL	USE.$K2
	PUSHAL	USE.$W1
	CALLS	#2,G^SPAN
	MOVL	#3,USE.$C3		; array (line 24), dimension 1's count
	MOVL	#1,USE.$I1
USE.$5:					; array (line 24), dimension 1's body
	MOVL	USE.$I1,R0
	MOVAL	USE.$W1-4[R0],USE.$D2+4
	PUSHAQ	USE.$D2
	CALLS	#1,G^FTN$IO_ITEM
	INCL	USE.$I1
	DECL	USE.$C3			; one pass fewer
	BLEQ	USE.$6
	BRW	USE.$5
USE.$6:
	MOVAL	@USE.A(AP),USE.$D1+4
	MOVL	#4,USE.$D1+20
	MOVL	#1,USE.$D1+24
	MOVL	#3,USE.$D1+28
	SUBL3	#4,USE.$D1+4,USE.$D1+16
	MOVL	#12,USE.$D1+12
	PUSHAQ	USE.$D1
	PUSHAL	USE.$W2
	CALLS	#2,USE.HALF
	CLRF	USE.$T1
	MOVL	#3,USE.$C4		; array (line 24), dimension 1's count
	MOVL	#1,USE.$I2
USE.$7:					; array (line 24), dimension 1's body
	MOVL	USE.$I2,R0
	ADDF2	USE.$W2-4[R0],USE.$T1
	INCL	USE.$I2
	DECL	USE.$C4			; one pass fewer
	BLEQ	USE.$8
	BRW	USE.$7
USE.$8:
	PUSHAQ	USE.$D3
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   25        CALL TAKE(HALF(A))
	MOVAL	@USE.A(AP),USE.$D1+4
	MOVL	#4,USE.$D1+20
	MOVL	#1,USE.$D1+24
	MOVL	#3,USE.$D1+28
	SUBL3	#4,USE.$D1+4,USE.$D1+16
	MOVL	#12,USE.$D1+12
	PUSHAQ	USE.$D1
	PUSHAL	USE.$W3
	CALLS	#2,USE.HALF
	MOVL	#3,USE.$C5		; array (line 25), dimension 1's count
	MOVL	#1,USE.$I2
USE.$9:					; array (line 25), dimension 1's body
	MOVL	USE.$I2,R0
	MOVL	USE.$I2,R1
	MOVF	USE.$W3-4[R0],USE.$W2-4[R1]
	INCL	USE.$I2
	DECL	USE.$C5			; one pass fewer
	BLEQ	USE.$10
	BRW	USE.$9
USE.$10:
	MOVAL	USE.$W2,R0
	PUSHL	R0
	CALLS	#1,G^TAKE
;   26        C = TAGS('AB')
	PUSHAQ	USE.$D4
	PUSHAQ	USE.$D5
	CALLS	#2,USE.TAGS
	MOVL	#2,USE.$C6		; array (line 26), dimension 1's count
	MOVL	#1,USE.$I2
USE.$11:				; array (line 26), dimension 1's body
	MULL3	USE.$I2,#4,R0
	MULL3	USE.$I2,#4,R1
	MOVC3	#4,USE.$W4-4[R0],USE.C-4[R1]
	INCL	USE.$I2
	DECL	USE.$C6			; one pass fewer
	BLEQ	USE.$12
	BRW	USE.$11
USE.$12:
;   27        CONTAINS
	RET

; Storage map for USE.HALF, a REAL function
;   HALF  REAL (3)  hidden argument 1  @USE.HALF.HALF(AP)
;   V     REAL (:)  argument 2         @USE.HALF.V(AP)
;
USE.HALF.HALF = 4			; HALF's value goes through hidden argument 1
USE.HALF.V = 8				; V is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
USE.HALF.$B1:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_F,DSC$K_CLASS_NCA
	.LONG	0			; V's bounds: set at each entry point
	.BYTE	0,0,0,1			; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0			; strides, in bytes
	.LONG	0,0			; bounds
USE.HALF.$T1:
	.BLKL	1			; temporary
USE.HALF.$I1:
	.BLKL	1			; an array statement's loop index
USE.HALF.$C1:
	.BLKL	1			; array (line 30), dimension 1's count

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
USE.HALF.$F1:
	.LONG	^X00004100		; 2.0

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;   28          FUNCTION HALF(V)
USE.HALF:
	.WORD	^M<>			; internal procedure HALF of USE
	MOVL	USE.HALF.V(AP),R0
	MOVL	4(R0),USE.HALF.$B1+4
	MOVL	USE.HALF.V(AP),R0
	CMPB	3(R0),#4
	BNEQ	USE.HALF.$2
	BRW	USE.HALF.$1
USE.HALF.$2:
	MOVL	USE.HALF.V(AP),R0
	MOVL	20(R0),USE.HALF.$B1+20
	MOVL	USE.HALF.V(AP),R0
	MOVL	USE.HALF.V(AP),R1
	SUBL3	24(R1),28(R0),R0
	ADDL3	R0,#1,USE.HALF.$T1
	BRW	USE.HALF.$3
USE.HALF.$1:
	MOVL	#4,USE.HALF.$B1+20
	MOVL	USE.HALF.V(AP),R0
	MOVL	20(R0),USE.HALF.$T1
USE.HALF.$3:
	MOVL	#1,USE.HALF.$B1+24
	TSTL	USE.HALF.$T1
	BLSS	USE.HALF.$5
	BRW	USE.HALF.$4
USE.HALF.$5:
	CLRL	USE.HALF.$T1
USE.HALF.$4:
	MOVL	USE.HALF.$T1,USE.HALF.$B1+28
	SUBL3	USE.HALF.$B1+20,USE.HALF.$B1+4,USE.HALF.$B1+16
	MULL3	#4,USE.HALF.$B1+28,USE.HALF.$B1+12
;   29          REAL V(:), HALF(3)
;   30          HALF = V / 2.0
	MOVL	#3,USE.HALF.$C1		; array (line 30), dimension 1's count
	MOVL	#1,USE.HALF.$I1
USE.HALF.$6:				; array (line 30), dimension 1's body
	MULL3	USE.HALF.$I1,USE.HALF.$B1+20,R0
	ADDL2	USE.HALF.$B1+16,R0
	SUBL3	#1,USE.HALF.$I1,R1
	DIVF3	USE.HALF.$F1,(R0),@USE.HALF.HALF(AP)[R1]
	INCL	USE.HALF.$I1
	DECL	USE.HALF.$C1		; one pass fewer
	BLEQ	USE.HALF.$7
	BRW	USE.HALF.$6
USE.HALF.$7:
;   31          END FUNCTION
	RET

; Storage map for USE.TAGS, a CHARACTER*4 function
;   TAGS  CHARACTER*4 (2)  hidden argument 1  @USE.TAGS.TAGS(AP)
;   S     CHARACTER*(*)    argument 2         @USE.TAGS.S(AP)
;
USE.TAGS.TAGS = 4			; TAGS's value goes through hidden argument 1
USE.TAGS.S = 8				; S is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
USE.TAGS.$D1:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_D
	.LONG	0			; set when the descriptor is used
USE.TAGS.$T1:
	.BLKB	2			; temporary
	.BLKB	2

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
USE.TAGS.$K1:
	.ASCII	/X/
USE.TAGS.$K2:
	.ASCII	/Y/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;   32          FUNCTION TAGS(S)
USE.TAGS:
	.WORD	^M<R2,R3,R4,R5>		; internal procedure TAGS of USE
;   33          CHARACTER*(*) S
;   34          CHARACTER*4 TAGS(2)
;   35          TAGS(1) = S // 'X'
	MOVZWL	@USE.TAGS.S(AP),R0
	INCL	R0
	CVTLW	R0,USE.TAGS.$T1
	PUSHAQ	USE.TAGS.$D1
	PUSHAW	USE.TAGS.$T1
	CALLS	#2,G^LIB$SGET1_DD
	MOVZWL	@USE.TAGS.S(AP),R0
	MOVL	USE.TAGS.S(AP),R1
	MOVC3	R0,@4(R1),@USE.TAGS.$D1+4
	MOVL	USE.TAGS.$D1+4,R0
	MOVZWL	@USE.TAGS.S(AP),R1
	MOVC3	#1,USE.TAGS.$K1,(R0)[R1]
	MOVZWL	@USE.TAGS.S(AP),R0
	INCL	R0
	MOVL	USE.TAGS.TAGS(AP),R1
	MOVC5	R0,@USE.TAGS.$D1+4,#^A/ /,#4,@4(R1)
	PUSHAQ	USE.TAGS.$D1
	CALLS	#1,G^LIB$SFREE1_DD
;   36          TAGS(2) = 'Y' // S
	MOVZWL	@USE.TAGS.S(AP),R0
	INCL	R0
	CVTLW	R0,USE.TAGS.$T1
	PUSHAQ	USE.TAGS.$D1
	PUSHAW	USE.TAGS.$T1
	CALLS	#2,G^LIB$SGET1_DD
	MOVC3	#1,USE.TAGS.$K2,@USE.TAGS.$D1+4
	MOVZWL	@USE.TAGS.S(AP),R0
	MOVL	USE.TAGS.S(AP),R1
	MOVL	USE.TAGS.$D1+4,R2
	MOVC3	R0,@4(R1),1(R2)
	MOVZWL	@USE.TAGS.S(AP),R0
	INCL	R0
	MOVL	USE.TAGS.TAGS(AP),R1
	MOVL	4(R1),R1
	MOVC5	R0,@USE.TAGS.$D1+4,#^A/ /,#4,4(R1)
	PUSHAQ	USE.TAGS.$D1
	CALLS	#1,G^LIB$SFREE1_DD
;   37          END FUNCTION
	RET

; Storage map for STEP, a RECURSIVE INTEGER function
;   R     INTEGER (2)  hidden argument 1  @STEP.R(AP)
;   N     INTEGER      argument 2         @STEP.N(AP)
;
STEP.R = 4				; R's value goes through hidden argument 1
STEP.N = 8				; N is argument 2
STEP.$I1 = -32				; an array statement's loop index, in the frame
STEP.$C1 = -28				; array (line 43), dimension 1's count, in the frame
STEP.$W1 = -24				; an array temporary of 8 bytes, for one statement, in the frame
STEP.$T1 = -16				; temporary, in the frame
STEP.$C2 = -12				; array (line 45), dimension 1's count, in the frame
STEP.$I2 = -8				; an array statement's loop index, in the frame
STEP.$C3 = -4				; array (line 46), dimension 1's count, in the frame

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
STEP.$K1:
	.LONG	0,1

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;   38        END SUBROUTINE
;   39        OPTIONS /F90
;   40        RECURSIVE FUNCTION STEP(N) RESULT(R)
	.ENTRY	STEP,^M<>
	SUBL2	#32,SP			; this activation's own storage
;   41        INTEGER N, R(2)
;   42        IF (N .LE. 1) THEN
	CMPL	@STEP.N(AP),#1
	BLEQ	STEP.$2
	BRW	STEP.$1
STEP.$2:
;   43          R = (/ 0, 1 /)
	MOVL	#2,STEP.$C1(FP)		; array (line 43), dimension 1's count
	MOVL	#1,STEP.$I1(FP)
STEP.$3:				; array (line 43), dimension 1's body
	MOVL	STEP.$I1(FP),R0
	SUBL3	#1,STEP.$I1(FP),R1
	MOVL	STEP.$K1-4[R0],@STEP.R(AP)[R1]
	INCL	STEP.$I1(FP)
	DECL	STEP.$C1(FP)		; one pass fewer
	BLEQ	STEP.$4
	BRW	STEP.$3
STEP.$4:
;   44        ELSE
	BRW	STEP.$5
STEP.$1:
;   45          R = STEP(N - 1)
	SUBL3	#1,@STEP.N(AP),STEP.$T1(FP)
	PUSHAL	STEP.$T1(FP)
	PUSHAL	STEP.$W1(FP)
	CALLS	#2,G^STEP
	MOVL	#2,STEP.$C2(FP)		; array (line 45), dimension 1's count
	MOVL	#1,STEP.$I1(FP)
STEP.$6:				; array (line 45), dimension 1's body
	MOVL	STEP.$I1(FP),R0
	SUBL3	#1,STEP.$I1(FP),R1
	MOVL	STEP.$W1-4(FP)[R0],@STEP.R(AP)[R1]
	INCL	STEP.$I1(FP)
	DECL	STEP.$C2(FP)		; one pass fewer
	BLEQ	STEP.$7
	BRW	STEP.$6
STEP.$7:
;   46          R = (/ R(2), R(1) + R(2) /)
	CLRL	STEP.$I2(FP)
	INCL	STEP.$I2(FP)
	MOVL	#1,R0
	MOVL	STEP.$I2(FP),R1
	MOVL	@STEP.R(AP)[R0],STEP.$W1-4(FP)[R1]
	INCL	STEP.$I2(FP)
	MOVL	#1,R0
	MOVL	STEP.$I2(FP),R1
	ADDL3	@STEP.R(AP),@STEP.R(AP)[R0],STEP.$W1-4(FP)[R1]
	MOVL	#2,STEP.$C3(FP)		; array (line 46), dimension 1's count
	MOVL	#1,STEP.$I1(FP)
STEP.$8:				; array (line 46), dimension 1's body
	MOVL	STEP.$I1(FP),R0
	SUBL3	#1,STEP.$I1(FP),R1
	MOVL	STEP.$W1-4(FP)[R0],@STEP.R(AP)[R1]
	INCL	STEP.$I1(FP)
	DECL	STEP.$C3(FP)		; one pass fewer
	BLEQ	STEP.$9
	BRW	STEP.$8
STEP.$9:
;   47        END IF
STEP.$5:
;   48        END FUNCTION
	RET

	.END
