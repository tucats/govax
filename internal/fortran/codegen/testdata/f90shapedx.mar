	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;   15        SUBROUTINE GIVE(A, N, IV, S, O)
	.ENTRY	GIVE,^M<R2,R3,R4,R5>
	CLRL	GIVE.$A5		; O is argument 5, if the caller passed it
	CMPB	(AP),#5
	BLSSU	GIVE.$57
	MOVL	20(AP),GIVE.$A5
GIVE.$57:
	TSTL	GIVE.$A5
	BNEQ	GIVE.$2
	BRW	GIVE.$1
GIVE.$2:
	MOVL	GIVE.$A5,R0
	MOVL	4(R0),GIVE.$B1+4
	MOVL	GIVE.$A5,R0
	CMPB	3(R0),#4
	BNEQ	GIVE.$4
	BRW	GIVE.$3
GIVE.$4:
	MOVL	GIVE.$A5,R0
	MOVL	20(R0),GIVE.$B1+20
	MOVL	GIVE.$A5,R0
	MOVL	GIVE.$A5,R1
	SUBL3	24(R1),28(R0),R0
	ADDL3	R0,#1,GIVE.$T1
	BRW	GIVE.$5
GIVE.$3:
	MOVL	#4,GIVE.$B1+20
	MOVL	GIVE.$A5,R0
	MOVL	20(R0),GIVE.$T1
GIVE.$5:
	MOVL	#1,GIVE.$B1+24
	TSTL	GIVE.$T1
	BLSS	GIVE.$7
	BRW	GIVE.$6
GIVE.$7:
	CLRL	GIVE.$T1
GIVE.$6:
	MOVL	GIVE.$T1,GIVE.$B1+28
	SUBL3	GIVE.$B1+20,GIVE.$B1+4,GIVE.$B1+16
	MULL3	#4,GIVE.$B1+28,GIVE.$B1+12
GIVE.$1:
	MOVAL	@GIVE.A(AP),GIVE.$B2+4
	MOVL	@GIVE.N(AP),GIVE.$B2+28
	MOVL	GIVE.$B2+28,GIVE.$B2+20
	MOVL	#-1,R0
	MOVAL	@GIVE.A(AP)[R0],GIVE.$B2+16
	MULL3	#4,GIVE.$B2+20,GIVE.$B2+12
;   16        INTEGER N, IV(3)
;   17        REAL A(N)
;   18        CHARACTER*4 S(5)
;   19        REAL, OPTIONAL :: O(:)
;   20        INTERFACE
;   21          SUBROUTINE TAKE(V, C, O)
;   22          REAL V(:)
;   23          CHARACTER*(*) C(:)
;   24          REAL, OPTIONAL :: O(:)
;   25          END SUBROUTINE
;   26        END INTERFACE
;   27        INTERFACE G
;   28          SUBROUTINE TAKEG(V)
;   29          REAL V(:)
;   30          END SUBROUTINE
;   31        END INTERFACE
;   32        CALL TAKE(A(IV), S(2:4)(2:3), O)
	MOVL	#3,GIVE.$C1		; array (line 32), dimension 1's count
	MOVL	#1,GIVE.$I1
GIVE.$8:				; array (line 32), dimension 1's body
	MOVL	GIVE.$B2+16,R0
	SUBL3	#1,GIVE.$I1,R1
	MOVL	@GIVE.IV(AP)[R1],R1
	MOVL	GIVE.$I1,R2
	MOVF	(R0)[R1],GIVE.$W1-4[R2]
	INCL	GIVE.$I1
	DECL	GIVE.$C1		; one pass fewer
	BLEQ	GIVE.$9
	BRW	GIVE.$8
GIVE.$9:
	MOVAL	GIVE.$W1,GIVE.$D1+4
	MOVL	#4,GIVE.$D1+20
	MOVL	#1,GIVE.$D1+24
	MOVL	#3,GIVE.$D1+28
	SUBL3	#4,GIVE.$D1+4,GIVE.$D1+16
	MOVL	#12,GIVE.$D1+12
	MOVL	GIVE.S(AP),R0
	MOVL	4(R0),R0
	MOVAB	4(R0),R0
	ADDL3	R0,#1,GIVE.$D2+4
	MOVL	#4,GIVE.$D2+20
	MOVL	#1,GIVE.$D2+24
	MOVL	#3,GIVE.$D2+28
	SUBL3	#4,GIVE.$D2+4,GIVE.$D2+16
	MOVL	#6,GIVE.$D2+12
	CLRL	GIVE.$T1
	TSTL	GIVE.$A5
	BNEQ	GIVE.$11
	BRW	GIVE.$10
GIVE.$11:
	MOVAL	GIVE.$B1,GIVE.$T1
GIVE.$10:
	PUSHL	GIVE.$T1
	PUSHAQ	GIVE.$D2
	PUSHAQ	GIVE.$D1
	CALLS	#3,G^TAKE
;   33        CALL TAKE(A * 2.0, S(IV), (A))
	MOVL	GIVE.$B2+20,GIVE.$T1
	BLSS	GIVE.$13
	BRW	GIVE.$12
GIVE.$13:
	CLRL	GIVE.$T1
GIVE.$12:
	MOVL	GIVE.$T1,GIVE.$R1+20
	MOVL	GIVE.$R1+20,GIVE.$R1+28
	MULL3	#4,GIVE.$R1+20,GIVE.$R1+12
	MOVL	SP,GIVE.$T2		; where the statement's storage starts
	CMPL	GIVE.$R1+12,#65536
	BLEQ	GIVE.$15
	BRW	GIVE.$14
GIVE.$15:
	SUBL2	GIVE.$R1+12,SP		; storage of a size known only now
	BICL2	#3,SP
	MOVL	SP,GIVE.$R1+4
	BRW	GIVE.$16
GIVE.$14:
	PUSHAQ	GIVE.$R1
	CALLS	#1,G^FTN$GET_TEMP
GIVE.$16:
	MOVL	GIVE.$R1+4,R0
	MOVAL	-4(R0),GIVE.$R1+16
	MOVL	GIVE.$R1+20,GIVE.$T3
	BLSS	GIVE.$18
	BRW	GIVE.$17
GIVE.$18:
	CLRL	GIVE.$T3
GIVE.$17:
	MOVL	GIVE.$T3,GIVE.$C2	; array (line 33), dimension 1's count
	MOVL	#1,GIVE.$I1
	TSTL	GIVE.$C2
	BGTR	GIVE.$20
	BRW	GIVE.$19
GIVE.$20:
GIVE.$21:				; array (line 33), dimension 1's body
	MOVL	GIVE.$B2+16,R0
	MOVL	GIVE.$I1,R1
	MOVL	GIVE.$R1+16,R2
	MOVL	GIVE.$I1,R3
	MULF3	(R0)[R1],GIVE.$KF1,(R2)[R3]
	INCL	GIVE.$I1
	DECL	GIVE.$C2		; one pass fewer
	BLEQ	GIVE.$22
	BRW	GIVE.$21
GIVE.$22:
GIVE.$19:
	MOVAL	@GIVE.$R1+4,GIVE.$D1+4
	MOVL	#4,GIVE.$D1+20
	MOVL	#1,GIVE.$D1+24
	MOVL	GIVE.$R1+28,GIVE.$D1+28
	SUBL3	#4,GIVE.$D1+4,GIVE.$D1+16
	MULL3	#4,GIVE.$R1+20,GIVE.$D1+12
	MOVL	#3,GIVE.$C3		; array (line 33), dimension 1's count
	MOVL	#1,GIVE.$I3
GIVE.$23:				; array (line 33), dimension 1's body
	MOVL	GIVE.S(AP),R0
	MOVL	4(R0),R0
	SUBL3	#1,GIVE.$I3,R1
	MULL3	@GIVE.IV(AP)[R1],#4,R1
	MULL3	GIVE.$I3,#4,R2
	MOVC3	#4,-4(R0)[R1],GIVE.$W2-4[R2]
	INCL	GIVE.$I3
	DECL	GIVE.$C3		; one pass fewer
	BLEQ	GIVE.$24
	BRW	GIVE.$23
GIVE.$24:
	MOVAB	GIVE.$W2,GIVE.$D3+4
	MOVL	#4,GIVE.$D3+20
	MOVL	#1,GIVE.$D3+24
	MOVL	#3,GIVE.$D3+28
	SUBL3	#4,GIVE.$D3+4,GIVE.$D3+16
	MOVL	#12,GIVE.$D3+12
	MOVL	GIVE.$B2+20,GIVE.$T4
	BLSS	GIVE.$26
	BRW	GIVE.$25
GIVE.$26:
	CLRL	GIVE.$T4
GIVE.$25:
	MOVL	GIVE.$T4,GIVE.$R2+20
