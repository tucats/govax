; Storage map for TAKE, a subroutine
;   V     REAL (:)           argument 1   @TAKE.V(AP)
;   C     CHARACTER*(*) (:)  argument 2   @TAKE.C(AP)
;   O     REAL (:)           an argument  @TAKE.$A3
;
TAKE.V = 4				; V is argument 1
TAKE.C = 8				; C is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
TAKE.$A3:
	.BLKL	1			; O's longword of the argument list, set at each entry point
TAKE.$B1:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_F,DSC$K_CLASS_NCA
	.LONG	0			; V's bounds: set at each entry point
	.BYTE	0,0,0,1			; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0			; strides, in bytes
	.LONG	0,0			; bounds
TAKE.$B2:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_NCA
	.LONG	0			; C's bounds: set at each entry point
	.BYTE	0,0,0,1			; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0			; strides, in bytes
	.LONG	0,0			; bounds
TAKE.$B3:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_F,DSC$K_CLASS_NCA
	.LONG	0			; O's bounds: set at each entry point
	.BYTE	0,0,0,1			; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0			; strides, in bytes
	.LONG	0,0			; bounds
TAKE.$T1:
	.BLKL	1			; temporary
TAKE.$I1:
	.BLKL	1			; an array statement's loop index
TAKE.$T2:
	.BLKL	1			; temporary
TAKE.$D2:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used
TAKE.$T3:
	.BLKL	1			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
TAKE.$IO1:
	.WORD	8			; an I/O statement's control block: its size
	.WORD	^X0000			; flags: none
	.LONG	0			; (not used yet)
TAKE.$D1:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_L,DSC$K_CLASS_S
	.ADDRESS TAKE.$T2
TAKE.$D3:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_LU,DSC$K_CLASS_S
	.ADDRESS TAKE.$T3

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;    1        OPTIONS /F90
;    2  C     Fortran 90's assumed-shape dummies (Phase 104, subtask 5b): actual
;    3  C     arguments computed into a temporary of the statement's (an expression, a
;    4  C     vector-subscripted section, an array in parentheses, one of a size known
;    5  C     only when the program runs), a substring of a section described where it
;    6  C     is, an OPTIONAL dummy passed on (absent if it was), and a generic name
;    7  C     whose specific has an assumed-shape dummy. The entry accepts a class A
;    8  C     descriptor as well as an NCA one.
;    9        SUBROUTINE TAKE(V, C, O)
	.ENTRY	TAKE,^M<>
	CLRL	TAKE.$A3		; O is argument 3, if the caller passed it
	CMPB	(AP),#3
	BLSSU	TAKE.$21
	MOVL	12(AP),TAKE.$A3
TAKE.$21:
	MOVL	TAKE.V(AP),R0
	MOVL	4(R0),TAKE.$B1+4
	MOVL	TAKE.V(AP),R0
	CMPB	3(R0),#4
	BNEQ	TAKE.$2
	BRW	TAKE.$1
TAKE.$2:
	MOVL	TAKE.V(AP),R0
	MOVL	20(R0),TAKE.$B1+20
	MOVL	TAKE.V(AP),R0
	MOVL	TAKE.V(AP),R1
	SUBL3	24(R1),28(R0),R0
	ADDL3	R0,#1,TAKE.$T1
	BRW	TAKE.$3
TAKE.$1:
	MOVL	#4,TAKE.$B1+20
	MOVL	TAKE.V(AP),R0
	MOVL	20(R0),TAKE.$T1
TAKE.$3:
	MOVL	#1,TAKE.$B1+24
	TSTL	TAKE.$T1
	BLSS	TAKE.$5
	BRW	TAKE.$4
TAKE.$5:
	CLRL	TAKE.$T1
TAKE.$4:
	MOVL	TAKE.$T1,TAKE.$B1+28
	SUBL3	TAKE.$B1+20,TAKE.$B1+4,TAKE.$B1+16
	MULL3	#4,TAKE.$B1+28,TAKE.$B1+12
	MOVW	@TAKE.C(AP),TAKE.$B2
	MOVL	TAKE.C(AP),R0
	MOVL	4(R0),TAKE.$B2+4
	MOVL	TAKE.C(AP),R0
	CMPB	3(R0),#4
	BNEQ	TAKE.$7
	BRW	TAKE.$6
TAKE.$7:
	MOVL	TAKE.C(AP),R0
	MOVL	20(R0),TAKE.$B2+20
	MOVL	TAKE.C(AP),R0
	MOVL	TAKE.C(AP),R1
	SUBL3	24(R1),28(R0),R0
	ADDL3	R0,#1,TAKE.$T1
	BRW	TAKE.$8
TAKE.$6:
	MOVZWL	@TAKE.C(AP),TAKE.$B2+20
	MOVL	TAKE.C(AP),R0
	MOVL	20(R0),TAKE.$T1
TAKE.$8:
	MOVL	#1,TAKE.$B2+24
	TSTL	TAKE.$T1
	BLSS	TAKE.$10
	BRW	TAKE.$9
TAKE.$10:
	CLRL	TAKE.$T1
TAKE.$9:
	MOVL	TAKE.$T1,TAKE.$B2+28
	SUBL3	TAKE.$B2+20,TAKE.$B2+4,TAKE.$B2+16
	MOVZWL	@TAKE.C(AP),R0
	MULL3	R0,TAKE.$B2+28,TAKE.$B2+12
	TSTL	TAKE.$A3
	BNEQ	TAKE.$12
	BRW	TAKE.$11
TAKE.$12:
	MOVL	TAKE.$A3,R0
	MOVL	4(R0),TAKE.$B3+4
	MOVL	TAKE.$A3,R0
	CMPB	3(R0),#4
	BNEQ	TAKE.$14
	BRW	TAKE.$13
TAKE.$14:
	MOVL	TAKE.$A3,R0
	MOVL	20(R0),TAKE.$B3+20
	MOVL	TAKE.$A3,R0
	MOVL	TAKE.$A3,R1
	SUBL3	24(R1),28(R0),R0
	ADDL3	R0,#1,TAKE.$T1
	BRW	TAKE.$15
TAKE.$13:
	MOVL	#4,TAKE.$B3+20
	MOVL	TAKE.$A3,R0
	MOVL	20(R0),TAKE.$T1
TAKE.$15:
	MOVL	#1,TAKE.$B3+24
	TSTL	TAKE.$T1
	BLSS	TAKE.$17
	BRW	TAKE.$16
TAKE.$17:
	CLRL	TAKE.$T1
TAKE.$16:
	MOVL	TAKE.$T1,TAKE.$B3+28
	SUBL3	TAKE.$B3+20,TAKE.$B3+4,TAKE.$B3+16
	MULL3	#4,TAKE.$B3+28,TAKE.$B3+12
TAKE.$11:
;   10        REAL V(:)
;   11        CHARACTER*(*) C(:)
;   12        REAL, OPTIONAL :: O(:)
;   13        PRINT *, SIZE(V), C(1), PRESENT(O)
	PUSHL	#-1
	PUSHAB	TAKE.$IO1
	CALLS	#2,G^FTN$WRITE_SL
	MOVL	TAKE.$B1+28,TAKE.$T1
	BLSS	TAKE.$19
	BRW	TAKE.$18
TAKE.$19:
	CLRL	TAKE.$T1
TAKE.$18:
	MOVL	TAKE.$T1,TAKE.$T2
	PUSHAQ	TAKE.$D1
	CALLS	#1,G^FTN$IO_ITEM
	MOVW	@TAKE.C(AP),TAKE.$D2
	ADDL3	TAKE.$B2+16,TAKE.$B2+20,R0
	MOVAB	(R0),TAKE.$D2+4
	PUSHAQ	TAKE.$D2
	CALLS	#1,G^FTN$IO_ITEM
	CLRL	R0
	TSTL	TAKE.$A3
	BEQL	TAKE.$20
	MNEGL	#1,R0
TAKE.$20:
	MOVL	R0,TAKE.$T3
	PUSHAQ	TAKE.$D3
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   14        END
	RET

