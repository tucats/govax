	.TITLE	TEST
; Descriptor codes (the OpenVMS Calling Standard's DSC$K_ values)
DSC$K_DTYPE_BU = 2			; byte logical
DSC$K_DTYPE_WU = 3			; word logical
DSC$K_DTYPE_W = 7			; word integer
DSC$K_CLASS_S = 1			; scalar or fixed-length string
DSC$K_CLASS_A = 4			; array
;

; Storage map for SHORTS, the main program
;   B     LOGICAL*1      $LOCAL+0   SHORTS.B
;   BV    LOGICAL*1 (3)  $LOCAL+1   SHORTS.BV
;   L2    LOGICAL*2      $LOCAL+4   SHORTS.L2
;   I2    INTEGER*2      $LOCAL+6   SHORTS.I2
;   J2    INTEGER*2      $LOCAL+8   SHORTS.J2
;   IV    INTEGER*2 (3)  $LOCAL+10  SHORTS.IV
;   I4    INTEGER        $LOCAL+16  SHORTS.I4
;   X     REAL           $LOCAL+20  SHORTS.X
;

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
SHORTS.B:
	.BLKB	1			; B
SHORTS.BV:
	.BLKB	3			; BV, LOGICAL*1 (3)
SHORTS.L2:
	.BLKB	2			; L2
SHORTS.I2:
	.BLKB	2			; I2
SHORTS.J2:
	.BLKB	2			; J2
SHORTS.IV:
	.BLKB	6			; IV, INTEGER*2 (3)
SHORTS.I4:
	.BLKL	1			; I4
SHORTS.X:
	.BLKL	1			; X
SHORTS.$D4:
	.WORD	2			; length
	.BYTE	DSC$K_DTYPE_W,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used
SHORTS.$C1:
	.BLKL	1			; DO 10's count

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
SHORTS.$K1:
	.LONG	5
SHORTS.$IO1:
	.WORD	8			; an I/O statement's control block: its size
	.WORD	^X0000			; flags: none
	.LONG	0			; (not used yet)
SHORTS.$D1:
	.WORD	1			; length
	.BYTE	DSC$K_DTYPE_BU,DSC$K_CLASS_S
	.ADDRESS SHORTS.B
SHORTS.$D2:
	.WORD	2			; length
	.BYTE	DSC$K_DTYPE_WU,DSC$K_CLASS_S
	.ADDRESS SHORTS.L2
SHORTS.$D3:
	.WORD	2			; length
	.BYTE	DSC$K_DTYPE_W,DSC$K_CLASS_S
	.ADDRESS SHORTS.I2
SHORTS.$D5:
	.WORD	2			; length
	.BYTE	DSC$K_DTYPE_W,DSC$K_CLASS_A
	.ADDRESS SHORTS.IV
	.BYTE	0,0,^XE0,1		; scale, digits, flags, dimensions
	.LONG	6			; the array's size in bytes
	.ADDRESS SHORTS.IV-2		; A0, where the element with zero subscripts would be
	.LONG	3			; multipliers
	.LONG	1,3			; bounds

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;    1  C     Each length's instructions (Phase 78, subtask 2).
;    2        PROGRAM SHORTS
	.ENTRY	SHORTS,^M<>
;    3        BYTE B, BV(3)
;    4        LOGICAL*2 L2
;    5        INTEGER*2 I2, J2, IV(3)
;    6        INTEGER I4
;    7        B = 255
	MOVB	#-1,SHORTS.B
;    8        I2 = 0
	CLRW	SHORTS.I2
;    9        J2 = I2 + 1
	ADDW3	SHORTS.I2,#1,SHORTS.J2
;   10        J2 = J2 + 1
	INCW	SHORTS.J2
;   11        J2 = J2*I2
	MULW2	SHORTS.I2,SHORTS.J2
;   12        I4 = I2
	CVTWL	SHORTS.I2,SHORTS.I4
;   13        I2 = I4
	CVTLW	SHORTS.I4,SHORTS.I2
;   14        X = I2
	CVTWF	SHORTS.I2,SHORTS.X
;   15        J2 = X
	CVTFW	SHORTS.X,SHORTS.J2
;   16        B = B .AND. L2
	CVTBW	SHORTS.B,R0
	MCOMW	SHORTS.L2,R1
	BICW2	R1,R0
	CVTWB	R0,SHORTS.B
;   17        L2 = L2 .XOR. L2
	XORW2	SHORTS.L2,SHORTS.L2
;   18        L2 = L2 .EQV. L2
	XORW3	SHORTS.L2,SHORTS.L2,R0
	MCOMW	R0,SHORTS.L2
;   19        I2 = .NOT. I2
	MCOMW	SHORTS.I2,SHORTS.I2
;   20        J2 = -I2
	MNEGW	SHORTS.I2,SHORTS.J2
;   21        I4 = IV(I4)
	MOVL	SHORTS.I4,R0
	CVTWL	SHORTS.IV-2[R0],SHORTS.I4
;   22        IV(J2) = I2
	CVTWL	SHORTS.J2,R0
	MOVW	SHORTS.I2,SHORTS.IV-2[R0]
;   23        BV(I4) = B
	MOVL	SHORTS.I4,R0
	MOVB	SHORTS.B,SHORTS.BV-1[R0]
;   24        IF (B) I2 = 1
	BITB	#1,SHORTS.B
	BNEQ	SHORTS.$2
	BRW	SHORTS.$1
SHORTS.$2:
	MOVW	#1,SHORTS.I2
SHORTS.$1:
;   25        IF (BV(I4)) I2 = 2
	MOVL	SHORTS.I4,R0
	BITB	#1,SHORTS.BV-1[R0]
	BNEQ	SHORTS.$4
	BRW	SHORTS.$3
SHORTS.$4:
	MOVW	#2,SHORTS.I2
SHORTS.$3:
;   26        IF (.NOT. L2) I2 = 3
	BITW	#1,SHORTS.L2
	BEQL	SHORTS.$6
	BRW	SHORTS.$5
SHORTS.$6:
	MOVW	#3,SHORTS.I2
SHORTS.$5:
;   27        IF (B .AND. L2) I2 = 4
	CVTBW	SHORTS.B,R0
	BLBS	R0,SHORTS.$8
	BRW	SHORTS.$7
SHORTS.$8:
	BITW	#1,SHORTS.L2
	BNEQ	SHORTS.$9
	BRW	SHORTS.$7
SHORTS.$9:
	MOVW	#4,SHORTS.I2
SHORTS.$7:
;   28        IF (I2 .LT. 7) I2 = 5
	CMPW	SHORTS.I2,#7
	BLSS	SHORTS.$11
	BRW	SHORTS.$10
SHORTS.$11:
	MOVW	#5,SHORTS.I2
SHORTS.$10:
;   29        CALL SUB(I2, IV(I4), BV(I4), 5)
	PUSHAL	SHORTS.$K1
	MOVL	SHORTS.I4,R0
	PUSHAB	SHORTS.BV-1[R0]
	MOVL	SHORTS.I4,R0
	PUSHAW	SHORTS.IV-2[R0]
	PUSHAW	SHORTS.I2
	CALLS	#4,G^SUB
;   30        PRINT *, B, L2, I2, IV(I4), IV
	PUSHL	#-1
	PUSHAB	SHORTS.$IO1
	CALLS	#2,G^FTN$WRITE_SL
	PUSHAQ	SHORTS.$D1
	CALLS	#1,G^FTN$IO_ITEM
	PUSHAQ	SHORTS.$D2
	CALLS	#1,G^FTN$IO_ITEM
	PUSHAQ	SHORTS.$D3
	CALLS	#1,G^FTN$IO_ITEM
	MOVL	SHORTS.I4,R0
	MOVAW	SHORTS.IV-2[R0],SHORTS.$D4+4
	PUSHAQ	SHORTS.$D4
	CALLS	#1,G^FTN$IO_ITEM
	PUSHAQ	SHORTS.$D5
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   31        DO 10 I2 = 1, J2
	CVTWL	SHORTS.J2,SHORTS.$C1	; DO 10's count
	MOVW	#1,SHORTS.I2
	TSTL	SHORTS.$C1
	BGTR	SHORTS.$13
	BRW	SHORTS.$12
SHORTS.$13:
;   32     10 CONTINUE
SHORTS.L10:				; DO 10's body
	INCW	SHORTS.I2
	DECL	SHORTS.$C1		; one pass fewer
	BLEQ	SHORTS.$14
	BRW	SHORTS.L10
SHORTS.$14:
SHORTS.$12:
;   33        END
	MOVL	#1,R0			; SS$_NORMAL
	RET

; Storage map for SUB, a subroutine
;   A     REAL           argument 1  @SUB.A(AP)
;   W     INTEGER*2 (*)  argument 2  @SUB.W(AP)
;   C     LOGICAL*1      argument 3  @SUB.C(AP)
;   K     INTEGER        argument 4  @SUB.K(AP)
;
SUB.A = 4				; A is argument 1
SUB.W = 8				; W is argument 2
SUB.C = 12				; C is argument 3
SUB.K = 16				; K is argument 4

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;   34        SUBROUTINE SUB(A, W, C, K)
	.ENTRY	SUB,^M<>
;   35        INTEGER*2 W(*)
;   36        BYTE C
;   37        W(K) = W(K+1)
	MOVL	@SUB.K(AP),R0
	SUBL3	#1,@SUB.K(AP),R1
	MOVW	@SUB.W(AP)[R0],@SUB.W(AP)[R1]
;   38        C = C
;   39        END
	RET

	.END	SHORTS
