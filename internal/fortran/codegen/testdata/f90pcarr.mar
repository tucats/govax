	.TITLE	TEST
	$DSCDEF				; descriptor codes, DSC$K_

; Storage map for F90PCARR, a subroutine
;   N     INTEGER                argument 1  @F90PCARR.N(AP)
;   H     TYPE(HOLDER)           $LOCAL+0    F90PCARR.H
;   P     TYPE(HOLDER), POINTER  $LOCAL+36   F90PCARR.P
;   T     TYPE(TREE)             $LOCAL+40   F90PCARR.T
;   A     INTEGER (10)           $LOCAL+76   F90PCARR.A
;   Type HOLDER, 36 bytes
;     +0     K     INTEGER
;     +4     V     INTEGER, POINTER (:)
;   Type TREE, 36 bytes
;     +0     KEY   INTEGER
;     +4     KIDS  TYPE(TREE), POINTER (:)
;
F90PCARR.N = 4				; N is argument 1

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
F90PCARR.H:
	.BLKL	9			; H
F90PCARR.P:
	.BLKL	1			; P
F90PCARR.T:
	.BLKL	9			; T
F90PCARR.A:
	.BLKL	10			; A, INTEGER (10)
F90PCARR.$T1:
	.BLKL	1			; temporary
F90PCARR.$I1:
	.BLKL	1			; an array statement's loop index
F90PCARR.$T2:
	.BLKL	1			; temporary
F90PCARR.$T3:
	.BLKL	1			; temporary
F90PCARR.$D1:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_L,DSC$K_CLASS_NCA
	.LONG	0			; set when the descriptor is used
	.BYTE	0,0,0,1			; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0			; strides, in bytes
	.LONG	0,0			; bounds
F90PCARR.$T4:
	.BLKL	1			; temporary
F90PCARR.$T5:
	.BLKL	1			; temporary
F90PCARR.$C1:
	.BLKL	1			; array (line 31), dimension 1's count

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;    1        OPTIONS /F90
;    2  C     Array pointer components (Phase 107, subtask 5b): a component's
;    3  C     descriptor reached where its record is, in $LOCAL (H%V) and through
;    4  C     a pointer (P%V, its record's address in a temporary); => to a
;    5  C     whole array and a section, the header written first; an element
;    6  C     and a section; ALLOCATE and DEALLOCATE with the descriptor's address;
;    7  C     ASSOCIATED; a constructor filling the component in its record; and
;    8  C     an array pointer of the type itself, a field of each record it
;    9  C     points at.
;   10        SUBROUTINE F90PCARR(N)
	.ENTRY	F90PCARR,^M<>
;   11        TYPE HOLDER
;   12          INTEGER K
;   13          INTEGER, POINTER :: V(:)
;   14        END TYPE
;   15        TYPE TREE
;   16          INTEGER KEY
;   17          TYPE(TREE), POINTER :: KIDS(:)
;   18        END TYPE
;   19        TYPE(HOLDER) :: H
;   20        TYPE(HOLDER), POINTER :: P
;   21        TYPE(TREE) :: T
;   22        INTEGER, TARGET :: A(10)
;   23        INTEGER N
;   24        H%V => A
	MOVL	#168296452,F90PCARR.H+4
	MOVL	#16777216,F90PCARR.H+12
	MOVAL	F90PCARR.A,F90PCARR.H+8
	MOVL	#4,F90PCARR.H+24
	MOVL	#1,F90PCARR.H+28
	MOVL	#10,F90PCARR.H+32
	SUBL3	#4,F90PCARR.H+8,F90PCARR.H+20
	MOVL	#40,F90PCARR.H+16
;   25        P%V => A(2:N:2)
	MOVL	F90PCARR.P,R0
	MOVAL	4(R0),F90PCARR.$T1
	MOVL	#168296452,@F90PCARR.$T1
	MOVL	F90PCARR.$T1,R0
	MOVL	#16777216,8(R0)
	MOVL	@F90PCARR.N(AP),F90PCARR.$T2
	DIVL3	#2,F90PCARR.$T2,F90PCARR.$T3
	BLSS	F90PCARR.$2
	BRW	F90PCARR.$1
F90PCARR.$2:
	CLRL	F90PCARR.$T3
F90PCARR.$1:
	MOVL	F90PCARR.$T1,R0
	MOVAL	F90PCARR.A+4,4(R0)
	MOVL	F90PCARR.$T1,R0
	MOVL	#8,20(R0)
	MOVL	F90PCARR.$T1,R0
	MOVL	#1,24(R0)
	MOVL	F90PCARR.$T1,R0
	MOVL	F90PCARR.$T3,28(R0)
	MOVL	F90PCARR.$T1,R0
	MOVL	F90PCARR.$T1,R1
	SUBL3	#8,4(R0),16(R1)
	MOVL	F90PCARR.$T1,R0
	MULL3	#4,F90PCARR.$T3,12(R0)
;   26        H%V(N) = P%V(1) + 1
	MOVL	F90PCARR.P,R0
	MOVAL	4(R0),F90PCARR.$T3
	MOVL	F90PCARR.$T3,R0
	MOVL	F90PCARR.$T3,R1
	ADDL3	16(R0),20(R1),R0
	MULL3	@F90PCARR.N(AP),F90PCARR.H+24,R1
	ADDL2	F90PCARR.H+20,R1
	ADDL3	(R0),#1,(R1)
;   27        ALLOCATE (P%V(0:N))
	MOVL	F90PCARR.P,R0
	MOVAL	4(R0),F90PCARR.$T3
	MOVL	#168296452,@F90PCARR.$T3
	MOVL	F90PCARR.$T3,R0
	MOVL	#16777216,8(R0)
	PUSHL	@F90PCARR.N(AP)
	PUSHL	#0
	PUSHL	#2
	PUSHAL	@F90PCARR.$T3
	CALLS	#4,G^FTN$ALLOCATE
;   28        IF (ASSOCIATED (H%V, A)) N = 1
	MOVAL	F90PCARR.A,F90PCARR.$D1+4
	MOVL	#4,F90PCARR.$D1+20
	MOVL	#1,F90PCARR.$D1+24
	MOVL	#10,F90PCARR.$D1+28
	SUBL3	#4,F90PCARR.$D1+4,F90PCARR.$D1+16
	MOVL	#40,F90PCARR.$D1+12
	CMPL	F90PCARR.H+8,F90PCARR.$D1+4
	BEQL	F90PCARR.$4
	BRW	F90PCARR.$3
F90PCARR.$4:
	TSTL	F90PCARR.H+8
	BNEQ	F90PCARR.$5
	BRW	F90PCARR.$3
F90PCARR.$5:
	CMPL	F90PCARR.H+24,F90PCARR.$D1+20
	BEQL	F90PCARR.$6
	BRW	F90PCARR.$3
F90PCARR.$6:
	SUBL3	F90PCARR.H+28,F90PCARR.H+32,R0
	SUBL3	F90PCARR.$D1+24,F90PCARR.$D1+28,R1
	CMPL	R0,R1
	BEQL	F90PCARR.$7
	BRW	F90PCARR.$3
F90PCARR.$7:
	TSTL	F90PCARR.$D1+12
	BGTR	F90PCARR.$8
	BRW	F90PCARR.$3
F90PCARR.$8:
	MOVL	#1,@F90PCARR.N(AP)
F90PCARR.$3:
;   29        DEALLOCATE (P%V)
	MOVL	F90PCARR.P,R0
	MOVAL	4(R0),F90PCARR.$T3
	PUSHL	#2
	PUSHAL	@F90PCARR.$T3
	CALLS	#2,G^FTN$DEALLOCATE
;   30        H = HOLDER(3, A(N:1:-1))
	MOVL	#3,F90PCARR.H
	MOVL	#168296452,F90PCARR.H+4
	MOVL	#16777216,F90PCARR.H+12
	MOVL	@F90PCARR.N(AP),F90PCARR.$T3
	ADDL3	F90PCARR.$T3,#1,F90PCARR.$T2
	MOVL	F90PCARR.$T3,F90PCARR.$T1
	BLSS	F90PCARR.$10
	BRW	F90PCARR.$9
F90PCARR.$10:
	CLRL	F90PCARR.$T1
F90PCARR.$9:
	MOVL	F90PCARR.$T2,R0
	MOVAL	F90PCARR.A-8[R0],F90PCARR.H+8
	MOVL	#-4,F90PCARR.H+24
	MOVL	#1,F90PCARR.H+28
	MOVL	F90PCARR.$T1,F90PCARR.H+32
	ADDL3	F90PCARR.H+8,#4,F90PCARR.H+20
	MULL3	#4,F90PCARR.$T1,F90PCARR.H+16
;   31        N = SUM (T%KIDS%KEY)
	MOVL	F90PCARR.T+28,F90PCARR.$T1
	MOVL	F90PCARR.T+32,F90PCARR.$T2
	SUBL3	#1,F90PCARR.$T1,F90PCARR.$T3
	SUBL3	F90PCARR.$T1,F90PCARR.$T2,R0
	ADDL3	R0,#1,F90PCARR.$T4
	BLSS	F90PCARR.$12
	BRW	F90PCARR.$11
F90PCARR.$12:
	CLRL	F90PCARR.$T4
F90PCARR.$11:
	CLRL	F90PCARR.$T5
	MOVL	F90PCARR.$T4,F90PCARR.$C1 ; array (line 31), dimension 1's count
	MOVL	#1,F90PCARR.$I1
	TSTL	F90PCARR.$C1
	BGTR	F90PCARR.$14
	BRW	F90PCARR.$13
F90PCARR.$14:
F90PCARR.$15:				; array (line 31), dimension 1's body
	ADDL3	F90PCARR.$I1,F90PCARR.$T3,R0
	MULL2	F90PCARR.T+24,R0
	ADDL2	F90PCARR.T+20,R0
	ADDL2	(R0),F90PCARR.$T5
	INCL	F90PCARR.$I1
	DECL	F90PCARR.$C1		; one pass fewer
	BLEQ	F90PCARR.$16
	BRW	F90PCARR.$15
F90PCARR.$16:
F90PCARR.$13:
	MOVL	F90PCARR.$T5,@F90PCARR.N(AP)
;   32        END
	RET

	.END
