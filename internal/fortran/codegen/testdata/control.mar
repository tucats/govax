	.TITLE	TEST
; Descriptor codes (the OpenVMS Calling Standard's DSC$K_ values)
DSC$K_DTYPE_T = 14			; text
DSC$K_CLASS_S = 1			; scalar or fixed-length string
;

; Storage map for CONTROL, the main program
;   N     INTEGER  $LOCAL+0  CONTROL.N
;   I     INTEGER  $LOCAL+4  CONTROL.I
;

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
CONTROL.N:
	.BLKL	1			; N
CONTROL.I:
	.BLKL	1			; I
CONTROL.$C1:
	.BLKL	1			; DO 20's count
CONTROL.$C2:
	.BLKL	1			; DO 30's count

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
CONTROL.$D1:
	.WORD	14			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS CONTROL.$K1
CONTROL.$D2:
	.WORD	5			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS CONTROL.$K2
CONTROL.$D3:
	.WORD	13			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS CONTROL.$K3
CONTROL.$D4:
	.WORD	11			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS CONTROL.$K4
CONTROL.$D5:
	.WORD	8			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS CONTROL.$K5
CONTROL.$D6:
	.WORD	7			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS CONTROL.$K6
CONTROL.$D7:
	.WORD	2			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.ADDRESS CONTROL.$K7
CONTROL.$K1:
	.ASCII	/CHECK THE TAPE/
CONTROL.$K2:
	.ASCII	/00123/
CONTROL.$K3:
	.ASCII	/N IS POSITIVE/
CONTROL.$K4:
	.ASCII	/IN THE LOOP/
CONTROL.$K5:
	.ASCII	/LOOP END/
CONTROL.$K6:
	.ASCII	/TOO BIG/
CONTROL.$K7:
	.ASCII	/98/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;    1  C     Phase 79, subtask 4: STOP and PAUSE with and without a display,
;    2  C     PAUSE in a logical IF, and RETURN and END in a subprogram.
;    3        PROGRAM CONTROL
	.ENTRY	CONTROL,^M<>
;    4        INTEGER N
;    5        N = 0
	CLRL	CONTROL.N
;    6        PAUSE
	CALLS	#0,G^FTN$PAUSE
;    7        PAUSE 'CHECK THE TAPE'
	PUSHAQ	CONTROL.$D1
	CALLS	#1,G^FTN$PAUSE
;    8        PAUSE 00123
	PUSHAQ	CONTROL.$D2
	CALLS	#1,G^FTN$PAUSE
;    9        CALL BUMP(N)
	PUSHAL	CONTROL.N
	CALLS	#1,G^BUMP
;   10        IF (N .GT. 0) PAUSE 'N IS POSITIVE'
	TSTL	CONTROL.N
	BGTR	CONTROL.$2
	BRW	CONTROL.$1
CONTROL.$2:
	PUSHAQ	CONTROL.$D3
	CALLS	#1,G^FTN$PAUSE
CONTROL.$1:
;   11        DO 20 I = 1, 2
	MOVL	#2,CONTROL.$C1		; DO 20's count
	MOVL	#1,CONTROL.I
;   12     20 PAUSE 'IN THE LOOP'
CONTROL.L20:				; DO 20's body
	PUSHAQ	CONTROL.$D4
	CALLS	#1,G^FTN$PAUSE
	INCL	CONTROL.I
	DECL	CONTROL.$C1		; one pass fewer
	BLEQ	CONTROL.$3
	BRW	CONTROL.L20
CONTROL.$3:
;   13        DO 30 I = 1, 2
	MOVL	#2,CONTROL.$C2		; DO 30's count
	MOVL	#1,CONTROL.I
CONTROL.$4:				; DO 30's body
;   14           N = N + I
	ADDL2	CONTROL.I,CONTROL.N
;   15     30 STOP 'LOOP END'
CONTROL.L30:
	PUSHAQ	CONTROL.$D5
	CALLS	#1,G^FTN$STOP
	INCL	CONTROL.I
	DECL	CONTROL.$C2		; one pass fewer
	BLEQ	CONTROL.$5
	BRW	CONTROL.$4
CONTROL.$5:
;   16        IF (N .GT. 5) STOP 'TOO BIG'
	CMPL	CONTROL.N,#5
	BGTR	CONTROL.$7
	BRW	CONTROL.$6
CONTROL.$7:
	PUSHAQ	CONTROL.$D6
	CALLS	#1,G^FTN$STOP
CONTROL.$6:
;   17        IF (N .LT. 0) STOP 98
	TSTL	CONTROL.N
	BLSS	CONTROL.$9
	BRW	CONTROL.$8
CONTROL.$9:
	PUSHAQ	CONTROL.$D7
	CALLS	#1,G^FTN$STOP
CONTROL.$8:
;   18        STOP
	CALLS	#0,G^FTN$STOP
;   19        END

; Storage map for BUMP, a subroutine
;   K     INTEGER  argument 1  @BUMP.K(AP)
;
BUMP.K = 4				; K is argument 1

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;   20
;   21        SUBROUTINE BUMP(K)
	.ENTRY	BUMP,^M<>
;   22        INTEGER K
;   23        K = K + 1
	INCL	@BUMP.K(AP)
;   24        IF (K .GT. 10) RETURN
	CMPL	@BUMP.K(AP),#10
	BGTR	BUMP.$2
	BRW	BUMP.$1
BUMP.$2:
	RET
BUMP.$1:
;   25        K = K + 1
	INCL	@BUMP.K(AP)
;   26        END
	RET

	.END	CONTROL
