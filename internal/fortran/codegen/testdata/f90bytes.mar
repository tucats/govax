	.TITLE	TEST
	$DSCDEF				; descriptor codes, DSC$K_

; Storage map for F90BYTES, the main program
;   I     INTEGER*1  $LOCAL+0  F90BYTES.I
;   J     INTEGER*1  $LOCAL+1  F90BYTES.J
;   K     INTEGER*1  $LOCAL+2  F90BYTES.K
;   W     INTEGER*2  $LOCAL+4  F90BYTES.W
;   L     LOGICAL*1  $LOCAL+6  F90BYTES.L
;

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
F90BYTES.I:
	.BLKB	1			; I
F90BYTES.J:
	.BYTE	-5			; J = -(kind 5 1)
F90BYTES.K:
	.BLKB	1			; K
	.BLKB	1
F90BYTES.W:
	.BLKB	2			; W
F90BYTES.L:
	.BLKB	1			; L
	.BLKB	1
F90BYTES.$T1:
	.BLKB	2			; temporary
	.BLKB	2
F90BYTES.$T2:
	.BLKB	2			; temporary
	.BLKB	2

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
F90BYTES.$IO1:
	.WORD	8			; an I/O statement's control block: its size
	.WORD	^X0000			; flags: none
	.LONG	0			; (not used yet)
F90BYTES.$D1:
	.WORD	1			; length
	.BYTE	DSC$K_DTYPE_B,DSC$K_CLASS_S
	.ADDRESS F90BYTES.I
F90BYTES.$D2:
	.WORD	1			; length
	.BYTE	DSC$K_DTYPE_B,DSC$K_CLASS_S
	.ADDRESS F90BYTES.J
F90BYTES.$D3:
	.WORD	1			; length
	.BYTE	DSC$K_DTYPE_B,DSC$K_CLASS_S
	.ADDRESS F90BYTES.K

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;    1  C     Fortran 90's INTEGER(1) (Phase 100, subtask 5): INTEGER*1 and
;    2  C     INTEGER(1), operations of two bytes in a byte, a byte beside a wider
;    3  C     type in that type (a constant is a longword), the generic functions
;    4  C     through INTEGER*2 and back, INT by the default integer, a specific
;    5  C     name's own result, and a power.
;    6        PROGRAM F90BYTES
	.ENTRY	F90BYTES,^M<>
;    7        INTEGER*1 I
;    8        INTEGER(1) :: J = -5_1, K
;    9        INTEGER*2 W
;   10        LOGICAL*1 L
;   11        K = I + J
	ADDB3	F90BYTES.I,F90BYTES.J,F90BYTES.K
;   12        K = I * J - 3_1
	MULB3	F90BYTES.I,F90BYTES.J,R0
	SUBB3	#3,R0,F90BYTES.K
;   13        W = I + W
	CVTBW	F90BYTES.I,R0
	ADDW2	R0,F90BYTES.W
;   14        W = I + 5
	CVTBL	F90BYTES.I,R0
	ADDL2	#5,R0
	CVTLW	R0,F90BYTES.W
;   15        K = ABS(J)
	CVTBW	F90BYTES.J,F90BYTES.$T1
	BLSS	F90BYTES.$2
	BRW	F90BYTES.$1
F90BYTES.$2:
	MNEGW	F90BYTES.$T1,F90BYTES.$T1
F90BYTES.$1:
	CVTWB	F90BYTES.$T1,F90BYTES.K
;   16        K = MAX(I, J)
	CVTBW	F90BYTES.I,F90BYTES.$T1
	CVTBW	F90BYTES.J,F90BYTES.$T2
	CMPW	F90BYTES.$T2,F90BYTES.$T1
	BGTR	F90BYTES.$4
	BRW	F90BYTES.$3
F90BYTES.$4:
	MOVW	F90BYTES.$T2,F90BYTES.$T1
F90BYTES.$3:
	CVTWB	F90BYTES.$T1,F90BYTES.K
;   17        K = IAND(I, J)
	CVTBW	F90BYTES.I,R0
	CVTBW	F90BYTES.J,R1
	MCOMW	R1,R1
	BICW2	R1,R0
	CVTWB	R0,F90BYTES.K
;   18        W = INT(J)
	CVTBW	F90BYTES.J,R0
	CVTWL	R0,R0
	CVTLW	R0,F90BYTES.W
;   19        W = IIABS(J)
	CVTBW	F90BYTES.J,F90BYTES.$T2
	BLSS	F90BYTES.$6
	BRW	F90BYTES.$5
F90BYTES.$6:
	MNEGW	F90BYTES.$T2,F90BYTES.$T2
F90BYTES.$5:
	MOVW	F90BYTES.$T2,F90BYTES.W
;   20        K = J ** I
	CVTBW	F90BYTES.I,R0
	CVTWL	R0,R0
	PUSHL	R0
	CVTBW	F90BYTES.J,R0
	CVTWL	R0,R0
	PUSHL	R0
	CALLS	#2,G^OTS$POWII
	MOVW	R0,F90BYTES.$T2
	CVTWB	F90BYTES.$T2,F90BYTES.K
;   21        K = L + I
	CVTBW	F90BYTES.L,R0
	CVTWB	R0,R0
	ADDB3	R0,F90BYTES.I,F90BYTES.K
;   22        IF (I .LT. J) K = -K
	CMPB	F90BYTES.I,F90BYTES.J
	BLSS	F90BYTES.$8
	BRW	F90BYTES.$7
F90BYTES.$8:
	MNEGB	F90BYTES.K,F90BYTES.K
F90BYTES.$7:
;   23        PRINT *, I, J, K
	PUSHL	#-1
	PUSHAB	F90BYTES.$IO1
	CALLS	#2,G^FTN$WRITE_SL
	PUSHAQ	F90BYTES.$D1
	CALLS	#1,G^FTN$IO_ITEM
	PUSHAQ	F90BYTES.$D2
	CALLS	#1,G^FTN$IO_ITEM
	PUSHAQ	F90BYTES.$D3
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   24        END
	MOVL	#1,R0			; SS$_NORMAL
	RET

	.END	F90BYTES
