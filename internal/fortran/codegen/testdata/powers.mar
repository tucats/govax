	.TITLE	TEST

; Storage map for POWERS, the main program
;   I     INTEGER     $LOCAL+0   POWERS.I
;   N     INTEGER     $LOCAL+4   POWERS.N
;   I2    INTEGER*2   $LOCAL+8   POWERS.I2
;   X     REAL        $LOCAL+12  POWERS.X
;   Y     REAL        $LOCAL+16  POWERS.Y
;   A     REAL (3)    $LOCAL+20  POWERS.A
;   D     REAL*8      $LOCAL+32  POWERS.D
;   C     COMPLEX     $LOCAL+40  POWERS.C
;   Z     COMPLEX*16  $LOCAL+48  POWERS.Z
;

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
POWERS.I:
	.BLKL	1			; I
POWERS.N:
	.BLKL	1			; N
POWERS.I2:
	.BLKB	2			; I2
	.BLKB	2
POWERS.X:
	.BLKL	1			; X
POWERS.Y:
	.BLKL	1			; Y
POWERS.A:
	.BLKL	3			; A, REAL (3)
POWERS.D:
	.BLKL	2			; D
POWERS.C:
	.BLKL	2			; C
POWERS.Z:
	.BLKL	4			; Z
POWERS.$T1:
	.BLKL	1			; temporary
POWERS.$T2:
	.BLKL	1			; temporary
POWERS.$T3:
	.BLKL	1			; temporary
POWERS.$T4:
	.BLKL	1			; temporary
POWERS.$T5:
	.BLKL	2			; temporary
POWERS.$T6:
	.BLKL	2			; temporary
POWERS.$T7:
	.BLKL	2			; temporary
POWERS.$T8:
	.BLKL	2			; temporary
POWERS.$T9:
	.BLKL	2			; temporary
POWERS.$T10:
	.BLKL	4			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
POWERS.$F1:
	.LONG	^X00004080		; 1.0
POWERS.$F2:
	.LONG	^X00000000		; 0.0

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;    1  C     Powers: in line for a constant exponent from 1 to 8, in OTS$'s order,
;    2  C     each value used again computed once; by the OTS$ routines otherwise,
;    3  C     with INTEGER*2 values passed as longwords; COMPLEX always called.
;    4        PROGRAM POWERS
	.ENTRY	POWERS,^M<R2,R3>
;    5        INTEGER I, N
;    6        INTEGER*2 I2
;    7        REAL X, Y, A(3)
;    8        DOUBLE PRECISION D
;    9        COMPLEX C
;   10        COMPLEX*16 Z
;   11        I = I**7
	MULL3	POWERS.I,POWERS.I,POWERS.$T1
	MULL3	POWERS.I,POWERS.$T1,R0
	MULL3	POWERS.$T1,POWERS.$T1,R1
	MULL3	R0,R1,POWERS.I
;   12        I2 = I2**3 + I2**N
	PUSHL	POWERS.N
	CVTWL	POWERS.I2,R0
	PUSHL	R0
	CALLS	#2,G^OTS$POWJJ
	MOVL	R0,POWERS.$T1
	MULW3	POWERS.I2,POWERS.I2,R0
	MULW2	POWERS.I2,R0
	CVTWL	R0,R0
	ADDL2	POWERS.$T1,R0
	CVTLW	R0,POWERS.I2
;   13        X = (X + 1.0)**2 + A(I)**3
	ADDF3	POWERS.X,POWERS.$F1,POWERS.$T2
	MOVL	POWERS.I,R0
	MOVL	POWERS.I,R1
	MULF3	POWERS.A-4[R0],POWERS.A-4[R1],R0
	MOVL	POWERS.I,R1
	MULF2	POWERS.A-4[R1],R0
	MULF3	POWERS.$T2,POWERS.$T2,R1
	ADDF3	R1,R0,POWERS.X
;   14        Y = X**(-2) + X**Y + X**9
	PUSHL	#-2
	PUSHL	POWERS.X
	CALLS	#2,G^OTS$POWRJ
	MOVF	R0,POWERS.$T2
	PUSHL	POWERS.Y
	PUSHL	POWERS.X
	CALLS	#2,G^OTS$POWRR
	MOVF	R0,POWERS.$T3
	PUSHL	#9
	PUSHL	POWERS.X
	CALLS	#2,G^OTS$POWRJ
	MOVF	R0,POWERS.$T4
	ADDF3	POWERS.$T2,POWERS.$T3,R0
	ADDF3	R0,POWERS.$T4,POWERS.Y
;   15        D = D**8 + X**D
	MULD3	POWERS.D,POWERS.D,POWERS.$T5
	MULD3	POWERS.$T5,POWERS.$T5,POWERS.$T6
	MOVQ	POWERS.D,-(SP)
	PUSHL	POWERS.X
	CALLS	#3,G^OTS$POWRD
	MOVD	R0,POWERS.$T7
	MULD3	POWERS.$T6,POWERS.$T6,R0
	ADDD3	R0,POWERS.$T7,POWERS.D
;   16        C = C**2 + C**Y
	PUSHL	#2
	PUSHL	POWERS.C+4
	PUSHL	POWERS.C
	CALLS	#3,G^OTS$POWCJ
	MOVQ	R0,POWERS.$T8
	PUSHL	POWERS.$F2
	PUSHL	POWERS.Y
	PUSHL	POWERS.C+4
	PUSHL	POWERS.C
	CALLS	#4,G^OTS$POWCC
	MOVQ	R0,POWERS.$T9
	ADDF3	POWERS.$T8,POWERS.$T9,POWERS.C
	ADDF3	POWERS.$T8+4,POWERS.$T9+4,POWERS.C+4
;   17        Z = Z**N
	PUSHL	POWERS.N
	MOVQ	POWERS.Z+8,-(SP)
	MOVQ	POWERS.Z,-(SP)
	CALLS	#5,G^OTS$POWCDJ_R3
	MOVO	R0,POWERS.$T10
	MOVD	POWERS.$T10,POWERS.Z
	MOVD	POWERS.$T10+8,POWERS.Z+8
;   18        END
	MOVL	#1,R0			; SS$_NORMAL
	RET

	.END	POWERS
