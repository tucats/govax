	.TITLE	TEST

; Storage map for JUMPS, the main program
;   K     INTEGER      $LOCAL+0   JUMPS.K
;   L     INTEGER (3)  $LOCAL+4   JUMPS.L
;   N2    INTEGER*2    $LOCAL+16  JUMPS.N2
;   X     REAL         $LOCAL+20  JUMPS.X
;

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
JUMPS.K:
	.BLKL	1			; K
JUMPS.L:
	.BLKL	3			; L, INTEGER (3)
JUMPS.N2:
	.BLKB	2			; N2
	.BLKB	2
JUMPS.X:
	.BLKL	1			; X

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
JUMPS.$F1:
	.LONG	^X00004080		; 1.0

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;    1  C     Phase 79, subtask 2: GO TO in every form, ASSIGN, and the
;    2  C     arithmetic IF.
;    3        PROGRAM JUMPS
	.ENTRY	JUMPS,^M<>
;    4        INTEGER K, L(3)
;    5        INTEGER*2 N2
;    6        REAL X
;    7        ASSIGN 20 TO K
	MOVAB	JUMPS.L20,JUMPS.K
;    8        GO TO K
	JMP	@JUMPS.K
;    9     10 GO TO (20, 30, 40), L(2)
JUMPS.L10:
	CASEL	JUMPS.L+4,#1,#2
JUMPS.$1:
	.WORD	JUMPS.L20-JUMPS.$1
	.WORD	JUMPS.L30-JUMPS.$1
	.WORD	JUMPS.L40-JUMPS.$1
;   10     20 GO TO (30, 40), N2 + 1
JUMPS.L20:
	ADDW3	JUMPS.N2,#1,R0
	CVTWL	R0,R0
	CASEL	R0,#1,#1
JUMPS.$2:
	.WORD	JUMPS.L30-JUMPS.$2
	.WORD	JUMPS.L40-JUMPS.$2
;   11     30 GO TO (40), X
JUMPS.L30:
	CVTFL	JUMPS.X,R0
	CASEL	R0,#1,#0
JUMPS.$3:
	.WORD	JUMPS.L40-JUMPS.$3
;   12        IF (X - 1.0) 40, 40, 50
	SUBF3	JUMPS.$F1,JUMPS.X,R0
	BLEQ	JUMPS.$4
	BRW	JUMPS.L50
JUMPS.$4:
;   13     40 IF (N2) 50, 60, 50
JUMPS.L40:
	TSTW	JUMPS.N2
	BNEQ	JUMPS.$5
	BRW	JUMPS.L60
JUMPS.$5:
;   14     50 IF (L(1)) 60, 70, 80
JUMPS.L50:
	TSTL	JUMPS.L
	BLEQ	JUMPS.$6
	BRW	JUMPS.L80
JUMPS.$6:
	BNEQ	JUMPS.$7
	BRW	JUMPS.L70
JUMPS.$7:
;   15     60 ASSIGN 70 TO K
JUMPS.L60:
	MOVAB	JUMPS.L70,JUMPS.K
;   16        GO TO K, (70, 80)
	JMP	@JUMPS.K
;   17     70 IF (X .GT. 0.0) GO TO (80, 10), N2
JUMPS.L70:
	TSTF	JUMPS.X
	BGTR	JUMPS.$9
	BRW	JUMPS.$8
JUMPS.$9:
	CVTWL	JUMPS.N2,R0
	CASEL	R0,#1,#1
JUMPS.$10:
	.WORD	JUMPS.L80-JUMPS.$10
	.WORD	JUMPS.L10-JUMPS.$10
JUMPS.$8:
;   18        CALL SUB(K)
	PUSHAL	JUMPS.K
	CALLS	#1,G^SUB
;   19     80 IF (2) 10, 20, 90
JUMPS.L80:
;   20     90 GO TO (10, 20), 3
JUMPS.L90:
;   21        END
	MOVL	#1,R0			; SS$_NORMAL
	RET

; Storage map for SUB, a subroutine
;   K     INTEGER  argument 1  @SUB.K(AP)
;
SUB.K = 4				; K is argument 1

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;   22
;   23        SUBROUTINE SUB(K)
	.ENTRY	SUB,^M<>
;   24        INTEGER K
;   25        ASSIGN 10 TO K
	MOVAB	SUB.L10,@SUB.K(AP)
;   26        GO TO K
	MOVL	@SUB.K(AP),R0
	JMP	(R0)
;   27     10 RETURN
SUB.L10:
	RET
;   28        END

	.END	JUMPS
