;   26        SUBROUTINE SHAPED(W, C)
	.ENTRY	SHAPED,^M<R2,R3,R4,R5>
	MOVL	SHAPED.W(AP),R0
	MOVL	4(R0),SHAPED.$B1+4
	MOVL	SHAPED.W(AP),R0
