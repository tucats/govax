	.TITLE	TEST
	$DSCDEF				; descriptor codes, DSC$K_

; Storage map for GIVE, a subroutine
;   A     REAL (?,3)       argument 1  @GIVE.A(AP)
;   N     INTEGER          argument 2  @GIVE.N(AP)
;   S     CHARACTER*4 (5)  argument 3  @GIVE.S(AP)
;   X     REAL             $LOCAL+0    GIVE.X
;
GIVE.A = 4				; A is argument 1
GIVE.N = 8				; N is argument 2
GIVE.S = 12				; S is argument 3

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
GIVE.X:	.BLKL	1			; X
GIVE.$B1:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_F,DSC$K_CLASS_A
	.LONG	0			; A's bounds: set at each entry point
	.BYTE	0,0,^XE0,2		; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0,3			; multipliers
	.LONG	1,0,1,3			; bounds
GIVE.$I1:
	.BLKL	1			; an array statement's loop index
GIVE.$T1:
	.BLKL	1			; temporary
GIVE.$T2:
	.BLKL	1			; temporary
GIVE.$T3:
	.BLKL	1			; temporary
GIVE.$W1:
	.BLKL	3			; an array temporary of 12 bytes, for one statement
GIVE.$C1:
	.BLKL	1			; array (line 20), dimension 1's count
GIVE.$I2:
	.BLKL	1			; an array statement's loop index
GIVE.$C2:
	.BLKL	1			; array (line 20), dimension 1's count
GIVE.$W2:
	.BLKL	2			; an array temporary of 8 bytes, for one statement
GIVE.$C3:
	.BLKL	1			; array (line 21), dimension 1's count
GIVE.$R1:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_F,DSC$K_CLASS_A
	.LONG	0			; $W: not allocated
	.BYTE	0,0,^XE0,1		; scale, digits, flags, dimensions
	.LONG	0			; the array's size in bytes
	.LONG	0			; A0, where the element with zero subscripts would be
	.LONG	0			; multipliers
	.LONG	1,0			; bounds
GIVE.$T4:
	.BLKL	1			; temporary
GIVE.$T5:
	.BLKL	1			; temporary
GIVE.$C4:
	.BLKL	1			; array (line 22), dimension 1's count
GIVE.$W3:
	.BLKL	3			; an array temporary of 12 bytes, for one statement
GIVE.$C5:
	.BLKL	1			; array (line 23), dimension 1's count
GIVE.$C6:
	.BLKL	1			; array (line 23), dimension 1's count
GIVE.$T6:
	.BLKL	1			; temporary
GIVE.$C7:
	.BLKL	1			; array (line 24), dimension 1's count
GIVE.$C8:
	.BLKL	1			; array (line 24), dimension 1's count

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
GIVE.$D1:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_A
	.ADDRESS GIVE.$W3
	.BYTE	0,0,^XE0,1		; scale, digits, flags, dimensions
	.LONG	12			; the array's size in bytes
	.ADDRESS GIVE.$W3-4		; A0, where the element with zero subscripts would be
	.LONG	3			; multipliers
	.LONG	1,3			; bounds

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;    1        OPTIONS /F90
;    2  C     Sections and array expressions given to dummies that aren't
;    3  C     assumed-shape (Phase 104, subtask 6): a section known to be contiguous,
;    4  C     passed as its first element's address; one that isn't, copied into a
;    5  C     temporary and back, but not back to an INTENT(IN) dummy; an expression,
;    6  C     never copied back; a CHARACTER section by a class A descriptor; an
;    7  C     assumed-shape array, and a section of one, tested when the program runs;
;    8  C     an assumed-shape array as an internal file; and a function reference
;    9  C     whose copy back comes when its call returns.
;   10        SUBROUTINE GIVE(A, N, S)
	.ENTRY	GIVE,^M<R2,R3,R4,R5>
	MOVAL	@GIVE.A(AP),GIVE.$B1+4
	MOVL	@GIVE.N(AP),GIVE.$B1+32
	MOVL	GIVE.$B1+32,GIVE.$B1+20
	MNEGL	GIVE.$B1+20,R0
	DECL	R0
	MOVAL	@GIVE.A(AP)[R0],GIVE.$B1+16
	MULL3	#4,GIVE.$B1+20,R0
	MULL3	R0,#3,GIVE.$B1+12
;   11        INTEGER N
;   12        REAL A(N, 3)
;   13        CHARACTER*4 S(5)
;   14        INTERFACE
;   15          SUBROUTINE LOOK(V)
;   16          REAL, INTENT(IN) :: V(2)
;   17          END SUBROUTINE
;   18        END INTERFACE
;   19        CALL TAKE(A(:, 2))
	MOVL	GIVE.$B1+32,GIVE.$T1
	MOVL	GIVE.$T1,GIVE.$T2
	BLSS	GIVE.$2
	BRW	GIVE.$1
GIVE.$2:
	CLRL	GIVE.$T2
GIVE.$1:
	MOVL	GIVE.$B1+16,R0
	MULL3	#2,GIVE.$B1+20,R1
	MOVAL	4(R0)[R1],GIVE.$T3
	PUSHL	GIVE.$T3
	CALLS	#1,G^TAKE
;   20        CALL TAKE(A(1, :))
	MOVL	#3,GIVE.$C1		; array (line 20), dimension 1's count
	MOVL	#1,GIVE.$I1
GIVE.$3:				; array (line 20), dimension 1's body
	MOVL	GIVE.$B1+16,R0
	MULL3	GIVE.$I1,GIVE.$B1+20,R1
	MOVL	GIVE.$I1,R2
	MOVF	4(R0)[R1],GIVE.$W1-4[R2]
	INCL	GIVE.$I1
	DECL	GIVE.$C1		; one pass fewer
	BLEQ	GIVE.$4
	BRW	GIVE.$3
GIVE.$4:
	MOVAL	GIVE.$W1,R0
	PUSHL	R0
	CALLS	#1,G^TAKE
	MOVL	#3,GIVE.$C2		; array (line 20), dimension 1's count
	MOVL	#1,GIVE.$I2
GIVE.$5:				; array (line 20), dimension 1's body
	MOVL	GIVE.$I2,R0
	MOVL	GIVE.$B1+16,R1
	MULL3	GIVE.$I2,GIVE.$B1+20,R2
	MOVF	GIVE.$W1-4[R0],4(R1)[R2]
	INCL	GIVE.$I2
	DECL	GIVE.$C2		; one pass fewer
	BLEQ	GIVE.$6
	BRW	GIVE.$5
GIVE.$6:
;   21        CALL LOOK(A(1, 1:2))
	MOVL	#2,GIVE.$C3		; array (line 21), dimension 1's count
	MOVL	#1,GIVE.$I2
GIVE.$7:				; array (line 21), dimension 1's body
	MOVL	GIVE.$B1+16,R0
	MULL3	GIVE.$I2,GIVE.$B1+20,R1
	MOVL	GIVE.$I2,R2
	MOVF	4(R0)[R1],GIVE.$W2-4[R2]
	INCL	GIVE.$I2
	DECL	GIVE.$C3		; one pass fewer
	BLEQ	GIVE.$8
	BRW	GIVE.$7
GIVE.$8:
	MOVAL	GIVE.$W2,R0
	PUSHL	R0
	CALLS	#1,G^LOOK
;   22        CALL TAKE(A(:, 1) + 1.0)
	MOVL	GIVE.$B1+32,GIVE.$T3
	MOVL	GIVE.$T3,GIVE.$T2
	BLSS	GIVE.$10
	BRW	GIVE.$9
GIVE.$10:
	CLRL	GIVE.$T2
GIVE.$9:
	MOVL	GIVE.$T2,GIVE.$R1+20
	MOVL	GIVE.$R1+20,GIVE.$R1+28
	MULL3	#4,GIVE.$R1+20,GIVE.$R1+12
	MOVL	SP,GIVE.$T1		; where the statement's storage starts
	CMPL	GIVE.$R1+12,#65536
	BLEQ	GIVE.$12
	BRW	GIVE.$11
GIVE.$12:
	SUBL2	GIVE.$R1+12,SP		; storage of a size known only now
	BICL2	#3,SP
	MOVL	SP,GIVE.$R1+4
	BRW	GIVE.$13
GIVE.$11:
	PUSHAQ	GIVE.$R1
	CALLS	#1,G^FTN$GET_TEMP
GIVE.$13:
	MOVL	GIVE.$R1+4,R0
	MOVAL	-4(R0),GIVE.$R1+16
	MOVL	GIVE.$B1+32,GIVE.$T4
	MOVL	GIVE.$R1+20,GIVE.$T5
	BLSS	GIVE.$15
	BRW	GIVE.$14
GIVE.$15:
	CLRL	GIVE.$T5
GIVE.$14:
	MOVL	GIVE.$T5,GIVE.$C4	; array (line 22), dimension 1's count
	MOVL	#1,GIVE.$I1
	TSTL	GIVE.$C4
	BGTR	GIVE.$17
	BRW	GIVE.$16
GIVE.$17:
GIVE.$18:				; array (line 22), dimension 1's body
	MOVL	GIVE.$B1+16,R0
	ADDL3	GIVE.$B1+20,GIVE.$I1,R1
	MOVL	GIVE.$R1+16,R2
	MOVL	GIVE.$I1,R3
	ADDF3	(R0)[R1],S^#1.0,(R2)[R3]
	INCL	GIVE.$I1
	DECL	GIVE.$C4		; one pass fewer
	BLEQ	GIVE.$19
	BRW	GIVE.$18
GIVE.$19:
GIVE.$16:
	MOVAL	@GIVE.$R1+4,R0
	PUSHL	R0
	CALLS	#1,G^TAKE
	CMPL	GIVE.$R1+12,#65536
	BGTR	GIVE.$21
	BRW	GIVE.$20
GIVE.$21:
	PUSHL	#0
	PUSHAQ	GIVE.$R1
	CALLS	#2,G^FTN$DEALLOCATE
GIVE.$20:
	MOVL	GIVE.$T1,SP		; the statement's storage given back
;   23        CALL WORDS(S(1:5:2))
	MOVL	#3,GIVE.$C5		; array (line 23), dimension 1's count
	MOVL	#1,GIVE.$I1
GIVE.$22:				; array (line 23), dimension 1's body
	MOVL	GIVE.S(AP),R0
	MOVL	4(R0),R0
	MULL3	GIVE.$I1,#2,R1
	MULL2	#4,R1
	MULL3	GIVE.$I1,#4,R2
	MOVC3	#4,-8(R0)[R1],GIVE.$W3-4[R2]
	INCL	GIVE.$I1
	DECL	GIVE.$C5		; one pass fewer
	BLEQ	GIVE.$23
	BRW	GIVE.$22
GIVE.$23:
	MOVAL	GIVE.$D1,R0
	PUSHL	R0
	CALLS	#1,G^WORDS
	MOVL	#3,GIVE.$C6		; array (line 23), dimension 1's count
	MOVL	#1,GIVE.$I2
GIVE.$24:				; array (line 23), dimension 1's body
	MULL3	GIVE.$I2,#4,R0
	MOVL	GIVE.S(AP),R1
	MOVL	4(R1),R1
	MULL3	GIVE.$I2,#2,R2
	MULL2	#4,R2
	MOVC3	#4,GIVE.$W3-4[R0],-8(R1)[R2]
	INCL	GIVE.$I2
	DECL	GIVE.$C6		; one pass fewer
	BLEQ	GIVE.$25
	BRW	GIVE.$24
GIVE.$25:
;   24        X = F(A(2, :)) + 1.0
	MOVL	#3,GIVE.$C7		; array (line 24), dimension 1's count
	MOVL	#1,GIVE.$I2
GIVE.$26:				; array (line 24), dimension 1's body
	MOVL	GIVE.$B1+16,R0
	MULL3	GIVE.$I2,GIVE.$B1+20,R1
	MOVL	GIVE.$I2,R2
	MOVF	8(R0)[R1],GIVE.$W1-4[R2]
	INCL	GIVE.$I2
	DECL	GIVE.$C7		; one pass fewer
	BLEQ	GIVE.$27
	BRW	GIVE.$26
GIVE.$27:
	MOVAL	GIVE.$W1,R0
	PUSHL	R0
	CALLS	#1,G^F
	MOVF	R0,GIVE.$T6
	MOVL	#3,GIVE.$C8		; array (line 24), dimension 1's count
	MOVL	#1,GIVE.$I1
GIVE.$28:				; array (line 24), dimension 1's body
	MOVL	GIVE.$I1,R0
	MOVL	GIVE.$B1+16,R1
	MULL3	GIVE.$I1,GIVE.$B1+20,R2
	MOVF	GIVE.$W1-4[R0],8(R1)[R2]
	INCL	GIVE.$I1
	DECL	GIVE.$C8		; one pass fewer
	BLEQ	GIVE.$29
	BRW	GIVE.$28
GIVE.$29:
	ADDF3	GIVE.$T6,S^#1.0,GIVE.X
;   25        END
	RET

