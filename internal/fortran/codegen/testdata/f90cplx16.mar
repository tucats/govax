	.TITLE	TEST

; Storage map for F90CPLX16, the main program
;   Z     COMPLEX*32      $LOCAL+0    F90CPLX16.Z
;   W     COMPLEX*32      $LOCAL+32   F90CPLX16.W
;   A     COMPLEX*32 (3)  $LOCAL+64   F90CPLX16.A
;   V     COMPLEX*32      $LOCAL+160  F90CPLX16.V
;   D     COMPLEX*16      $LOCAL+192  F90CPLX16.D
;   H     REAL*16         $LOCAL+208  F90CPLX16.H
;   I     INTEGER         $LOCAL+224  F90CPLX16.I
;

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
F90CPLX16.Z:
; Z = (complex (kind 1.5 16) (- (kind 2.0 16)))
	.LONG	^X80004001,^X00000000,^X00000000,^X00000000,^X0000C002,^X00000000,^X00000000,^X00000000
F90CPLX16.W:
	.BLKL	8			; W
F90CPLX16.A:
	.BLKL	24			; A, COMPLEX*32 (3)
F90CPLX16.V:
	.BLKL	8			; V
F90CPLX16.D:
	.BLKL	4			; D
F90CPLX16.H:
	.BLKL	4			; H
F90CPLX16.I:
	.BLKL	1			; I
F90CPLX16.$T1:
	.BLKL	4			; temporary
F90CPLX16.$T2:
	.BLKL	8			; temporary
F90CPLX16.$T3:
	.BLKL	2			; temporary
F90CPLX16.$T4:
	.BLKL	8			; temporary
F90CPLX16.$X1:
	.BLKL	4			; a part of an expression, set aside

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
F90CPLX16.$F1:
	.LONG	^X00004000,^X00000000,^X00000000,^X00000000 ; 0.5Q0
F90CPLX16.$F2:
	.LONG	^X00004001,^X00000000,^X00000000,^X00000000 ; 1Q0
F90CPLX16.$F3:
	.LONG	^X00004002,^X00000000,^X00000000,^X00000000 ; ^X00000000000000000000000000004002
F90CPLX16.$F4:
	.LONG	^X80004002,^X00000000,^X00000000,^X00000000 ; ^X00000000000000000000000080004002

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;    1  C     Fortran 90's COMPLEX(16) (Phase 100, subtask 7): COMPLEX*32 and
;    2  C     COMPLEX(16), a constant with a part of kind 16, sums, differences,
;    3  C     products, quotients, negation, comparisons, conversions both ways,
;    4  C     CMPLX with KIND=16, an initial value, an element, and a function's
;    5  C     result, arrays and dummy arrays with indexes.
;    6        PROGRAM F90CPLX16
	.ENTRY	F90CPLX16,^M<R2,R3>
;    7        COMPLEX(16) :: Z = (1.5_16, -2.0_16), W, A(3)
;    8        COMPLEX*32 V
;    9        COMPLEX*16 D
;   10        REAL*16 H
;   11        COMPLEX(16) TWICE
;   12        W = Z + (0.5_16, 1.0)
	ADDH3	F90CPLX16.Z,F90CPLX16.$F1,F90CPLX16.$T1
	ADDH3	F90CPLX16.Z+16,F90CPLX16.$F2,F90CPLX16.W+16
	MOVH	F90CPLX16.$T1,F90CPLX16.W
;   13        V = Z * W - A(2)
	MULH3	F90CPLX16.Z,F90CPLX16.W,F90CPLX16.$X1
	MULH3	F90CPLX16.Z+16,F90CPLX16.W+16,R0
	SUBH3	R0,F90CPLX16.$X1,R0
	SUBH3	F90CPLX16.A+32,R0,F90CPLX16.$T1
	MULH3	F90CPLX16.Z,F90CPLX16.W+16,F90CPLX16.$X1
	MULH3	F90CPLX16.Z+16,F90CPLX16.W,R0
	ADDH2	F90CPLX16.$X1,R0
	SUBH3	F90CPLX16.A+48,R0,F90CPLX16.V+16
	MOVH	F90CPLX16.$T1,F90CPLX16.V
;   14        V = Z / W
	PUSHAO	F90CPLX16.W
	PUSHAO	F90CPLX16.Z
	PUSHAO	F90CPLX16.$T2
	CALLS	#3,G^FTN$DIVCH
	MOVH	F90CPLX16.$T2,F90CPLX16.V
	MOVH	F90CPLX16.$T2+16,F90CPLX16.V+16
;   15        V = -V
	MNEGH	F90CPLX16.V,F90CPLX16.$T1
	MNEGH	F90CPLX16.V+16,F90CPLX16.V+16
	MOVH	F90CPLX16.$T1,F90CPLX16.V
;   16        A(3) = V
	MOVO	F90CPLX16.V,F90CPLX16.A+64
	MOVO	F90CPLX16.V+16,F90CPLX16.A+80
;   17        D = V
	CVTHD	F90CPLX16.V,F90CPLX16.$T3
	CVTHD	F90CPLX16.V+16,F90CPLX16.D+8
	MOVD	F90CPLX16.$T3,F90CPLX16.D
;   18        V = D
	CVTDH	F90CPLX16.D,F90CPLX16.$T1
	CVTDH	F90CPLX16.D+8,F90CPLX16.V+16
	MOVH	F90CPLX16.$T1,F90CPLX16.V
;   19        H = V
	MOVH	F90CPLX16.V,F90CPLX16.H
;   20        V = H
	MOVH	F90CPLX16.H,F90CPLX16.V
	CLRH	F90CPLX16.V+16
;   21        V = CMPLX(H, H, KIND=16)
	MOVH	F90CPLX16.H,F90CPLX16.$T1
	MOVH	F90CPLX16.H,F90CPLX16.V+16
	MOVH	F90CPLX16.$T1,F90CPLX16.V
;   22        H = AIMAG(V) + REAL(V)
	ADDH3	F90CPLX16.V+16,F90CPLX16.V,F90CPLX16.H
;   23        V = CONJG(V)
	MOVH	F90CPLX16.V,F90CPLX16.$T1
	MNEGH	F90CPLX16.V+16,F90CPLX16.V+16
	MOVH	F90CPLX16.$T1,F90CPLX16.V
;   24        D = DCMPLX(V)
	CVTHD	F90CPLX16.V,F90CPLX16.$T3
	CVTHD	F90CPLX16.V+16,F90CPLX16.D+8
	MOVD	F90CPLX16.$T3,F90CPLX16.D
;   25        IF (Z .EQ. W) V = Z
	CMPH	F90CPLX16.Z,F90CPLX16.W
	BEQL	F90CPLX16.$2
	BRW	F90CPLX16.$1
F90CPLX16.$2:
	CMPH	F90CPLX16.Z+16,F90CPLX16.W+16
	BEQL	F90CPLX16.$3
	BRW	F90CPLX16.$1
F90CPLX16.$3:
	MOVO	F90CPLX16.Z,F90CPLX16.V
	MOVO	F90CPLX16.Z+16,F90CPLX16.V+16
F90CPLX16.$1:
;   26        IF (Z .NE. W) V = TWICE(Z)
	CMPH	F90CPLX16.Z,F90CPLX16.W
	BEQL	F90CPLX16.$6
	BRW	F90CPLX16.$5
F90CPLX16.$6:
	CMPH	F90CPLX16.Z+16,F90CPLX16.W+16
	BNEQ	F90CPLX16.$7
	BRW	F90CPLX16.$4
F90CPLX16.$7:
F90CPLX16.$5:
	PUSHAO	F90CPLX16.Z
	PUSHAO	F90CPLX16.$T2
	CALLS	#2,G^TWICE
	MOVO	F90CPLX16.$T2,F90CPLX16.V
	MOVO	F90CPLX16.$T2+16,F90CPLX16.V+16
F90CPLX16.$4:
;   27        CALL TAKE(Z, A)
	PUSHAO	F90CPLX16.A
	PUSHAO	F90CPLX16.Z
	CALLS	#2,G^TAKE
;   28        V = (2.0_16, 3.0_16)
	MOVO	F90CPLX16.$F3,F90CPLX16.V
	MOVO	F90CPLX16.$F4,F90CPLX16.V+16
;   29        A(I) = V
	MULL3	F90CPLX16.I,#2,R0
	MOVO	F90CPLX16.V,F90CPLX16.A-32[R0]
	MULL3	F90CPLX16.I,#2,R0
	MOVO	F90CPLX16.V+16,F90CPLX16.A-16[R0]
;   30        V = A(I) * A(I+1)
	MULL3	F90CPLX16.I,#2,R0
	MULL3	F90CPLX16.I,#2,R1
	MULH3	F90CPLX16.A-32[R0],F90CPLX16.A[R1],F90CPLX16.$X1
	MULL3	F90CPLX16.I,#2,R0
	MULL3	F90CPLX16.I,#2,R1
	MULH3	F90CPLX16.A-16[R0],F90CPLX16.A+16[R1],R0
	SUBH3	R0,F90CPLX16.$X1,F90CPLX16.$T1
	MULL3	F90CPLX16.I,#2,R0
	MULL3	F90CPLX16.I,#2,R1
	MULH3	F90CPLX16.A-32[R0],F90CPLX16.A+16[R1],F90CPLX16.$X1
	MULL3	F90CPLX16.I,#2,R0
	MULL3	F90CPLX16.I,#2,R1
	MULH3	F90CPLX16.A-16[R0],F90CPLX16.A[R1],R0
	ADDH3	F90CPLX16.$X1,R0,F90CPLX16.V+16
	MOVH	F90CPLX16.$T1,F90CPLX16.V
;   31        CALL TAKE(A(I), V / A(I))
	MULL3	F90CPLX16.I,#2,R0
	PUSHAO	F90CPLX16.A-32[R0]
	PUSHAO	F90CPLX16.V
	PUSHAO	F90CPLX16.$T4
	CALLS	#3,G^FTN$DIVCH
	MOVH	F90CPLX16.$T4,F90CPLX16.$T2
	MOVH	F90CPLX16.$T4+16,F90CPLX16.$T2+16
	PUSHAO	F90CPLX16.$T2
	MULL3	F90CPLX16.I,#2,R0
	PUSHAO	F90CPLX16.A-32[R0]
	CALLS	#2,G^TAKE
;   32        END
	MOVL	#1,R0			; SS$_NORMAL
	RET

; Storage map for TWICE, a COMPLEX*32 function
;   TWICE  COMPLEX*32  hidden argument 1  @TWICE.TWICE(AP)
;   X      COMPLEX*32  argument 2         @TWICE.X(AP)
;
TWICE.TWICE = 4				; TWICE's value goes through hidden argument 1
TWICE.X = 8				; X is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
TWICE.$T1:
	.BLKL	4			; temporary

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;   33
;   34        COMPLEX(16) FUNCTION TWICE(X)
	.ENTRY	TWICE,^M<R2>
;   35        COMPLEX(16) X
;   36        TWICE = X + X
	ADDH3	@TWICE.X(AP),@TWICE.X(AP),TWICE.$T1
	MOVL	#1,R0
	MOVL	#1,R1
	MOVL	#1,R2
	ADDH3	@TWICE.X(AP)[R0],@TWICE.X(AP)[R1],@TWICE.TWICE(AP)[R2]
	MOVH	TWICE.$T1,@TWICE.TWICE(AP)
;   37        END
	RET

; Storage map for TAKE, a subroutine
;   X     COMPLEX*32      argument 1  @TAKE.X(AP)
;   Y     COMPLEX*32 (*)  argument 2  @TAKE.Y(AP)
;   N     INTEGER         $LOCAL+0    TAKE.N
;
TAKE.X = 4				; X is argument 1
TAKE.Y = 8				; Y is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
TAKE.N:	.BLKL	1			; N
TAKE.$T1:
	.BLKL	8			; temporary

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;   38
;   39        SUBROUTINE TAKE(X, Y)
	.ENTRY	TAKE,^M<>
;   40        COMPLEX(16) X, Y(*)
;   41        Y(N) = X
	MULL3	TAKE.N,#2,R0
	SUBL2	#2,R0
	MOVO	@TAKE.X(AP),@TAKE.Y(AP)[R0]
	MOVL	#1,R0
	MULL3	TAKE.N,#2,R1
	DECL	R1
	MOVO	@TAKE.X(AP)[R0],@TAKE.Y(AP)[R1]
;   42        Y(N+2) = Y(N-1) / X
	PUSHAO	@TAKE.X(AP)
	MULL3	TAKE.N,#2,R0
	SUBL2	#4,R0
	PUSHAO	@TAKE.Y(AP)[R0]
	PUSHAO	TAKE.$T1
	CALLS	#3,G^FTN$DIVCH
	MULL3	TAKE.N,#2,R0
	ADDL2	#2,R0
	MOVH	TAKE.$T1,@TAKE.Y(AP)[R0]
	MULL3	TAKE.N,#2,R0
	ADDL2	#3,R0
	MOVH	TAKE.$T1+16,@TAKE.Y(AP)[R0]
;   43        END
	RET

	.END	F90CPLX16
