	.TITLE	TEST

; Storage map for CPLX, the main program
;   C     COMPLEX      $LOCAL+0   CPLX.C
;   D     COMPLEX      $LOCAL+8   CPLX.D
;   A     COMPLEX (4)  $LOCAL+16  CPLX.A
;   Z     COMPLEX*16   $LOCAL+48  CPLX.Z
;   W     COMPLEX*16   $LOCAL+64  CPLX.W
;   X     REAL         $LOCAL+80  CPLX.X
;   I     INTEGER      $LOCAL+84  CPLX.I
;

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
CPLX.C:	.BLKL	2			; C
CPLX.D:	.BLKL	2			; D
CPLX.A:	.BLKL	8			; A, COMPLEX (4)
CPLX.Z:	.BLKL	4			; Z
CPLX.W:	.BLKL	4			; W
CPLX.X:	.BLKL	1			; X
CPLX.I:	.BLKL	1			; I
CPLX.$T1:
	.BLKL	1			; temporary
CPLX.$T2:
	.BLKL	2			; temporary
CPLX.$T3:
	.BLKL	2			; temporary
CPLX.$T4:
	.BLKL	4			; temporary
CPLX.$T5:
	.BLKL	2			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
CPLX.$F1:
	.LONG	^X00004080,^X00004100	; (1.0, 2.0)
CPLX.$F2:
	.LONG	^X00004080,^X00000000	; 1D0
CPLX.$F3:
	.LONG	^X00004080		; 1.0

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;    1  C     COMPLEX values split into their parts (Phase 78, subtask 4).
;    2        PROGRAM CPLX
	.ENTRY	CPLX,^M<R2,R3>
;    3        COMPLEX C, D, A(4), CF
;    4        COMPLEX*16 Z, W
;    5        REAL X
;    6        C = (1.0, 2.0)
	MOVQ	CPLX.$F1,CPLX.C		; (1.0, 2.0)
;    7        D = C
	MOVQ	CPLX.C,CPLX.D
;    8        C = C*D
	MULF3	CPLX.C,CPLX.D,R0
	MULF3	CPLX.C+4,CPLX.D+4,R1
	SUBF3	R1,R0,CPLX.$T1
	MULF3	CPLX.C,CPLX.D+4,R0
	MULF3	CPLX.C+4,CPLX.D,R1
	ADDF3	R0,R1,CPLX.C+4
	MOVF	CPLX.$T1,CPLX.C
;    9        A(I) = C + X
	ADDF3	CPLX.C,CPLX.X,CPLX.$T1
	MULL3	CPLX.I,#2,R0
	MOVF	CPLX.C+4,CPLX.A-4[R0]
	MULL3	CPLX.I,#2,R0
	MOVF	CPLX.$T1,CPLX.A-8[R0]
;   10        A(I+1) = A(I)/D
	PUSHL	CPLX.D+4
	PUSHL	CPLX.D
	MULL3	CPLX.I,#2,R0
	PUSHL	CPLX.A-4[R0]
	MULL3	CPLX.I,#2,R0
	PUSHL	CPLX.A-8[R0]
	CALLS	#4,G^OTS$DIVC
	MOVQ	R0,CPLX.$T2
	MULL3	CPLX.I,#2,R0
	MOVF	CPLX.$T2,CPLX.A[R0]
	MULL3	CPLX.I,#2,R0
	MOVF	CPLX.$T2+4,CPLX.A+4[R0]
;   11        Z = C
	CVTFD	CPLX.C,CPLX.$T3
	CVTFD	CPLX.C+4,CPLX.Z+8
	MOVD	CPLX.$T3,CPLX.Z
;   12        W = Z*Z
	MOVQ	CPLX.Z+8,-(SP)
	MOVQ	CPLX.Z,-(SP)
	MOVQ	CPLX.Z+8,-(SP)
	MOVQ	CPLX.Z,-(SP)
	CALLS	#8,G^OTS$MULCD_R3
	MOVO	R0,CPLX.$T4
	MOVD	CPLX.$T4,CPLX.W
	MOVD	CPLX.$T4+8,CPLX.W+8
;   13        W = W/Z - 1
	MOVQ	CPLX.Z+8,-(SP)
	MOVQ	CPLX.Z,-(SP)
	MOVQ	CPLX.W+8,-(SP)
	MOVQ	CPLX.W,-(SP)
	CALLS	#8,G^OTS$DIVCD_R3
	MOVO	R0,CPLX.$T4
	SUBD3	CPLX.$F2,CPLX.$T4,CPLX.W
	MOVD	CPLX.$T4+8,CPLX.W+8
;   14        X = C
	MOVF	CPLX.C,CPLX.X
;   15        IF (C .EQ. D) X = 1.0
	CMPF	CPLX.C,CPLX.D
	BEQL	CPLX.$2
	BRW	CPLX.$1
CPLX.$2:
	CMPF	CPLX.C+4,CPLX.D+4
	BEQL	CPLX.$3
	BRW	CPLX.$1
CPLX.$3:
	MOVL	#^X00004080,CPLX.X	; 1.0
CPLX.$1:
;   16        IF (C .NE. (0.0, 1.0)) X = 2.0
	TSTF	CPLX.C
	BEQL	CPLX.$6
	BRW	CPLX.$5
CPLX.$6:
	CMPF	CPLX.C+4,CPLX.$F3
	BNEQ	CPLX.$7
	BRW	CPLX.$4
CPLX.$7:
CPLX.$5:
	MOVL	#^X00004100,CPLX.X	; 2.0
CPLX.$4:
;   17        CALL S(C, C*D, A(I), (C))
	MULF3	CPLX.C,CPLX.D,R0
	MULF3	CPLX.C+4,CPLX.D+4,R1
	SUBF3	R1,R0,CPLX.$T2
	MULF3	CPLX.C,CPLX.D+4,R0
	MULF3	CPLX.C+4,CPLX.D,R1
	ADDF3	R0,R1,CPLX.$T2+4
	MOVQ	CPLX.C,CPLX.$T5
	PUSHAQ	CPLX.$T5
	MOVL	CPLX.I,R0
	PUSHAQ	CPLX.A-8[R0]
	PUSHAQ	CPLX.$T2
	PUSHAQ	CPLX.C
	CALLS	#4,G^S
;   18        D = CF(-C)
	MNEGF	CPLX.C,CPLX.$T5
	MNEGF	CPLX.C+4,CPLX.$T5+4
	PUSHAQ	CPLX.$T5
	CALLS	#1,G^CF
	MOVQ	R0,CPLX.D
;   19        END
	MOVL	#1,R0			; SS$_NORMAL
	RET

; Storage map for CF, a COMPLEX function
;   V     COMPLEX (*)  argument 1  @CF.V(AP)
;   CF    COMPLEX      $LOCAL+0    CF.CF
;   N     INTEGER      $LOCAL+8    CF.N
;
CF.V = 4				; V is argument 1

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
CF.CF:	.BLKL	2			; CF, the function's value
CF.N:	.BLKL	1			; N
CF.$T1:	.BLKL	1			; temporary

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;   20        COMPLEX FUNCTION CF(V)
	.ENTRY	CF,^M<R2>
;   21        COMPLEX V(*)
;   22        CF = V(2)*V(N)
	MOVL	#2,R0
	MULL3	CF.N,#2,R1
	SUBL2	#2,R1
	MULF3	@CF.V(AP)[R0],@CF.V(AP)[R1],R0
	MOVL	#3,R1
	MULL3	CF.N,#2,R2
	DECL	R2
	MULF3	@CF.V(AP)[R1],@CF.V(AP)[R2],R1
	SUBF3	R1,R0,CF.$T1
	MOVL	#2,R0
	MULL3	CF.N,#2,R1
	DECL	R1
	MULF3	@CF.V(AP)[R0],@CF.V(AP)[R1],R0
	MOVL	#3,R1
	MULL3	CF.N,#2,R2
	SUBL2	#2,R2
	MULF3	@CF.V(AP)[R1],@CF.V(AP)[R2],R1
	ADDF3	R0,R1,CF.CF+4
	MOVF	CF.$T1,CF.CF
;   23        END
	MOVQ	CF.CF,R0		; the function's value
	RET

; Storage map for GS, a subroutine
;   Z     COMPLEX*16  argument 1  @GS.Z(AP)
;
GS.Z = 4				; Z is argument 1

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
GS.$T1:	.BLKL	4			; temporary

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;   24        OPTIONS /G_FLOATING
;   25        SUBROUTINE GS(Z)
	.ENTRY	GS,^M<R2,R3>
;   26        COMPLEX*16 Z
;   27        Z = Z*Z
	MOVL	#1,R0
	MOVQ	@GS.Z(AP)[R0],-(SP)
	MOVQ	@GS.Z(AP),-(SP)
	MOVL	#1,R0
	MOVQ	@GS.Z(AP)[R0],-(SP)
	MOVQ	@GS.Z(AP),-(SP)
	CALLS	#8,G^OTS$MULCG_R3
	MOVO	R0,GS.$T1
	MOVG	GS.$T1,@GS.Z(AP)
	MOVL	#1,R0
	MOVG	GS.$T1+8,@GS.Z(AP)[R0]
;   28        END
	RET

	.END	CPLX
