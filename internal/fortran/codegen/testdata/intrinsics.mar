	.TITLE	TEST

; Storage map for INTRINS, the main program
;   I     INTEGER      $LOCAL+0   INTRINS.I
;   J     INTEGER      $LOCAL+4   INTRINS.J
;   K     INTEGER      $LOCAL+8   INTRINS.K
;   N     INTEGER (3)  $LOCAL+12  INTRINS.N
;   I2    INTEGER*2    $LOCAL+24  INTRINS.I2
;   J2    INTEGER*2    $LOCAL+26  INTRINS.J2
;   L     LOGICAL      $LOCAL+28  INTRINS.L
;   L2    LOGICAL*2    $LOCAL+32  INTRINS.L2
;   X     REAL         $LOCAL+36  INTRINS.X
;   Y     REAL         $LOCAL+40  INTRINS.Y
;   D     REAL*8       $LOCAL+44  INTRINS.D
;   C     COMPLEX      $LOCAL+52  INTRINS.C
;   S     CHARACTER*8  $LOCAL+60  INTRINS.S
;   T     CHARACTER*1  $LOCAL+68  INTRINS.T
;

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
INTRINS.I:
	.BLKL	1			; I
INTRINS.J:
	.BLKL	1			; J
INTRINS.K:
	.BLKL	1			; K
INTRINS.N:
	.BLKL	3			; N, INTEGER (3)
INTRINS.I2:
	.BLKB	2			; I2
INTRINS.J2:
	.BLKB	2			; J2
INTRINS.L:
	.BLKL	1			; L
INTRINS.L2:
	.BLKB	2			; L2
	.BLKB	2
INTRINS.X:
	.BLKL	1			; X
INTRINS.Y:
	.BLKL	1			; Y
INTRINS.D:
	.BLKL	2			; D
INTRINS.C:
	.BLKL	2			; C
INTRINS.S:
	.BLKL	2			; S
INTRINS.T:
	.BLKB	1			; T
	.BLKB	3
INTRINS.$T1:
	.BLKL	1			; temporary
INTRINS.$T2:
	.BLKL	1			; temporary
INTRINS.$T3:
	.BLKB	2			; temporary
	.BLKB	2
INTRINS.$T4:
	.BLKL	1			; temporary
INTRINS.$T5:
	.BLKL	1			; temporary
INTRINS.$T6:
	.BLKL	1			; temporary
INTRINS.$T7:
	.BLKB	1			; temporary
	.BLKB	3
INTRINS.$T8:
	.BLKL	2			; characters, for one statement

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
INTRINS.$K1:
	.LONG	3
INTRINS.$K2:
	.LONG	8
INTRINS.$F1:
	.LONG	^X00004080		; 1.0
INTRINS.$K3:
	.ASCII	/AB/
INTRINS.$K4:
	.ASCII	/M/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;    1  C     In-line intrinsic functions: the ones that branch (ABS, MAX, MIN, DIM,
;    2  C     SIGN) through a temporary before the statement; MOD's division;
;    3  C     conversions, NINT, and ZEXT; COMPLEX parts; the bit functions on
;    4  C     words and longwords; ISHFTC by FTNRTL; the character functions.
;    5        PROGRAM INTRINS
	.ENTRY	INTRINS,^M<R2,R3,R4,R5>
;    6        INTEGER I, J, K, N(3)
;    7        INTEGER*2 I2, J2
;    8        LOGICAL L
;    9        LOGICAL*2 L2
;   10        REAL X, Y
;   11        DOUBLE PRECISION D
;   12        COMPLEX C
;   13        CHARACTER*8 S
;   14        CHARACTER*1 T
;   15        I = ABS(I) + MAX(I, J, N(K)) - MIN0(J2, 5)
	MOVL	INTRINS.I,INTRINS.$T1
	BLSS	INTRINS.$2
	BRW	INTRINS.$1
INTRINS.$2:
	MNEGL	INTRINS.$T1,INTRINS.$T1
INTRINS.$1:
	MOVL	INTRINS.I,INTRINS.$T2
	CMPL	INTRINS.J,INTRINS.$T2
	BGTR	INTRINS.$4
	BRW	INTRINS.$3
INTRINS.$4:
	MOVL	INTRINS.J,INTRINS.$T2
INTRINS.$3:
	MOVL	INTRINS.K,R0
	CMPL	INTRINS.N-4[R0],INTRINS.$T2
	BGTR	INTRINS.$6
	BRW	INTRINS.$5
INTRINS.$6:
	MOVL	INTRINS.K,R0
	MOVL	INTRINS.N-4[R0],INTRINS.$T2
INTRINS.$5:
	MOVW	INTRINS.J2,INTRINS.$T3
	CMPW	#5,INTRINS.$T3
	BLSS	INTRINS.$8
	BRW	INTRINS.$7
INTRINS.$8:
	MOVW	#5,INTRINS.$T3
INTRINS.$7:
	ADDL3	INTRINS.$T1,INTRINS.$T2,R0
	CVTWL	INTRINS.$T3,R1
	SUBL3	R1,R0,INTRINS.I
;   16        X = SIGN(X, Y) + DIM(X, 1.0) + AMAX0(I, J)
	MOVF	INTRINS.X,INTRINS.$T4
	TSTF	INTRINS.Y
	BGEQ	INTRINS.$10
	BRW	INTRINS.$9
INTRINS.$10:
	TSTF	INTRINS.$T4
	BGEQ	INTRINS.$12
	BRW	INTRINS.$11
INTRINS.$12:
	BRW	INTRINS.$13
INTRINS.$9:
	TSTF	INTRINS.$T4
	BGTR	INTRINS.$14
	BRW	INTRINS.$13
INTRINS.$14:
INTRINS.$11:
	MNEGF	INTRINS.$T4,INTRINS.$T4
INTRINS.$13:
	CLRF	INTRINS.$T5
	CMPF	INTRINS.X,INTRINS.$F1
	BGTR	INTRINS.$16
	BRW	INTRINS.$15
INTRINS.$16:
	SUBF3	INTRINS.$F1,INTRINS.X,INTRINS.$T5
INTRINS.$15:
	MOVL	INTRINS.I,INTRINS.$T2
	CMPL	INTRINS.J,INTRINS.$T2
	BGTR	INTRINS.$18
	BRW	INTRINS.$17
INTRINS.$18:
	MOVL	INTRINS.J,INTRINS.$T2
INTRINS.$17:
	ADDF3	INTRINS.$T4,INTRINS.$T5,R0
	CVTLF	INTRINS.$T2,R1
	ADDF3	R0,R1,INTRINS.X
;   17        I = MOD(I, J) + IFIX(X) + NINT(D) + INT(I2)
	DIVL3	INTRINS.J,INTRINS.I,R0
	MULL2	INTRINS.J,R0
	SUBL3	R0,INTRINS.I,R0
	CVTFL	INTRINS.X,R1
	ADDL2	R1,R0
	CVTRDL	INTRINS.D,R1
	ADDL2	R1,R0
	CVTWL	INTRINS.I2,R1
	ADDL3	R0,R1,INTRINS.I
;   18        I2 = ININT(X) + IZEXT(I2) + ISIGN(I2, 3)
	MOVW	INTRINS.I2,INTRINS.$T3
	BLSS	INTRINS.$20
	BRW	INTRINS.$19
INTRINS.$20:
	MNEGW	INTRINS.$T3,INTRINS.$T3
INTRINS.$19:
	CVTRFL	INTRINS.X,R0
	CVTLW	R0,R0
	ADDW2	INTRINS.I2,R0
	ADDW3	R0,INTRINS.$T3,INTRINS.I2
;   19        X = AIMAG(C) + REAL(C) + DPROD(X, Y)
	CVTFD	INTRINS.X,R0
	CVTFD	INTRINS.Y,R2
	MULD2	R2,R0
	ADDF3	INTRINS.C+4,INTRINS.C,R2
	CVTFD	R2,R2
	ADDD2	R2,R0
	CVTDF	R0,INTRINS.X
;   20        C = CMPLX(X, I) + CONJG(C)
	ADDF3	INTRINS.X,INTRINS.C,INTRINS.$T5
	CVTLF	INTRINS.I,R0
	MNEGF	INTRINS.C+4,R1
	ADDF3	R0,R1,INTRINS.C+4
	MOVF	INTRINS.$T5,INTRINS.C
;   21        I = IAND(I, 255) + IOR(I, J) + IEOR(I, -1) + NOT(J)
	BICL3	#-256,INTRINS.I,R0
	BISL3	INTRINS.I,INTRINS.J,R1
	ADDL2	R1,R0
	XORL3	INTRINS.I,#-1,R1
	ADDL2	R1,R0
	MCOML	INTRINS.J,R1
	ADDL3	R0,R1,INTRINS.I
;   22        I2 = IISHFT(I2, 3) + ISHFT(I2, -3) + IBSET(I2, 4)
	MOVZWL	INTRINS.I2,R0
	ASHL	#3,R0,R0
	MOVZWL	INTRINS.I2,R1
	EXTZV	#3,#13,R1,R1
	ADDW2	R1,R0
	BISW3	INTRINS.I2,#16,R1
	ADDW3	R0,R1,INTRINS.I2
;   23        I = ISHFT(I, 5) + ISHFT(I, -5) + IBITS(I, J, 4) + IBITS(I2, 2, 3)
	ASHL	#5,INTRINS.I,R0
	EXTZV	#5,#27,INTRINS.I,R1
	ADDL2	R1,R0
	EXTZV	INTRINS.J,#4,INTRINS.I,R1
	ADDL2	R1,R0
	MOVZWL	INTRINS.I2,R1
	EXTZV	#2,#3,R1,R1
	CVTWL	R1,R1
	ADDL3	R0,R1,INTRINS.I
;   24        I = IBCLR(I, J) + IBCLR(I2, J2) + ISHFTC(I, 3, 8)
	PUSHAL	INTRINS.$K2
	PUSHAL	INTRINS.$K1
	PUSHAL	INTRINS.I
	CALLS	#3,G^FTN$JISHFTC
	MOVL	R0,INTRINS.$T2
	ASHL	INTRINS.J,#1,R0
	BICL3	R0,INTRINS.I,R0
	CVTWL	INTRINS.J2,R1
	ASHL	R1,#1,R1
	BICW3	R1,INTRINS.I2,R1
	CVTWL	R1,R1
	ADDL2	R1,R0
	ADDL3	R0,INTRINS.$T2,INTRINS.I
;   25        L = BTEST(I, 3)
	EXTZV	#3,#1,INTRINS.I,R0
	MNEGL	R0,INTRINS.L
;   26        L2 = BTEST(I2, J2)
	MOVZWL	INTRINS.I2,R0
	CVTWL	INTRINS.J2,R1
	EXTZV	R1,#1,R0,R0
	MNEGL	R0,R0
	MOVW	R0,INTRINS.L2
;   27        I = LEN(S) + INDEX(S, 'AB') + ICHAR(S(I:I)) + INDEX(S(I:), S(J:K))
	MATCHC	#2,INTRINS.$K3,#8,INTRINS.S
	BNEQ	INTRINS.$21
	SUBL3	R2,#7,R0
	BRB	INTRINS.$22
INTRINS.$21:
	CLRL	R0
INTRINS.$22:
	MOVL	R0,INTRINS.$T2
	SUBL3	INTRINS.I,#9,R0
	SUBL3	INTRINS.J,INTRINS.K,R1
	SUBL3	R1,R0,INTRINS.$T1
	SUBL3	INTRINS.J,INTRINS.K,R0
	INCL	R0
	MOVL	INTRINS.J,R1
	SUBL3	INTRINS.I,#9,R2
	MOVL	INTRINS.I,R3
	MATCHC	R0,INTRINS.S-1[R1],R2,INTRINS.S-1[R3]
	BNEQ	INTRINS.$23
	SUBL3	R2,INTRINS.$T1,R0
	BRB	INTRINS.$24
INTRINS.$23:
	CLRL	R0
INTRINS.$24:
	MOVL	R0,INTRINS.$T6
	MOVL	INTRINS.I,R0
	MOVZBL	INTRINS.S-1[R0],R0
	ADDL2	INTRINS.$T2,R0
	ADDL2	INTRINS.$T6,R0
	ADDL3	R0,#8,INTRINS.I
;   28        T = CHAR(I)
	MOVB	INTRINS.I,INTRINS.$T7
	MOVC3	#1,INTRINS.$T7,INTRINS.T
;   29        S = CHAR(J) // S(2:)
	MOVB	INTRINS.J,INTRINS.$T7
	MOVC3	#1,INTRINS.$T7,INTRINS.$T8
	MOVC3	#7,INTRINS.S+1,INTRINS.$T8+1
	MOVC3	#8,INTRINS.$T8,INTRINS.S
;   30        L = LLT(S, 'M') .AND. LGE(S(I:J), T)
	CMPC5	#8,INTRINS.S,#^A/ /,#1,INTRINS.$K4
	BGEQU	INTRINS.$25
	MNEGL	#1,R0
	BRB	INTRINS.$26
INTRINS.$25:
	CLRL	R0
INTRINS.$26:
	MOVL	R0,INTRINS.$T6
	SUBL3	INTRINS.I,INTRINS.J,R0
	INCL	R0
	MOVL	INTRINS.I,R1
	CMPC5	R0,INTRINS.S-1[R1],#^A/ /,#1,INTRINS.T
	BLSSU	INTRINS.$27
	MNEGL	#1,R0
	BRB	INTRINS.$28
INTRINS.$27:
	CLRL	R0
INTRINS.$28:
	MOVL	R0,INTRINS.$T1
	MCOML	INTRINS.$T1,R0
	BICL3	R0,INTRINS.$T6,INTRINS.L
;   31        END
	MOVL	#1,R0			; SS$_NORMAL
	RET

	.END	INTRINS
