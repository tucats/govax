	.TITLE	TEST
	$DSCDEF				; descriptor codes, DSC$K_

; Storage map for F90SELECT, the main program
;   I      INTEGER          $LOCAL+0   F90SELECT.I
;   N      INTEGER          $LOCAL+4   F90SELECT.N
;   K      INTEGER*2        $LOCAL+8   F90SELECT.K
;   WORD   CHARACTER*8      $LOCAL+10  F90SELECT.WORD
;   WORDS  CHARACTER*8 (4)  $LOCAL+18  F90SELECT.WORDS
;   L      LOGICAL          $LOCAL+52  F90SELECT.L
;

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
F90SELECT.I:
	.BLKL	1			; I
F90SELECT.N:
	.BLKL	1			; N
F90SELECT.K:
	.BLKB	2			; K
F90SELECT.WORD:
	.BLKL	2			; WORD
F90SELECT.WORDS:
	.BLKL	8			; WORDS, CHARACTER*8 (4)
	.BLKB	2
F90SELECT.L:
	.BLKL	1			; L
F90SELECT.$T1:
	.BLKL	1			; temporary
F90SELECT.$T2:
	.BLKL	1			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
F90SELECT.$IO1:
	.WORD	8			; an I/O statement's control block: its size
	.WORD	^X0000			; flags: none
	.LONG	0			; (not used yet)
F90SELECT.$D1:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_L,DSC$K_CLASS_S
	.ADDRESS F90SELECT.N
F90SELECT.$K1:
	.ASCII	/A/
F90SELECT.$K2:
	.ASCII	/M/
F90SELECT.$K3:
	.ASCII	/ZZ/
F90SELECT.$K4:
	.ASCII	/I/
F90SELECT.$K5:
	.ASCII	/E/
F90SELECT.$K6:
	.ASCII	/C/
F90SELECT.$K7:
	.ASCII	/G/
F90SELECT.$K8:
	.ASCII	/K/
F90SELECT.$K9:
	.ASCII	/O/
F90SELECT.$K10:
	.ASCII	/X/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;    1  C     Fortran 90's CASE construct lowered (Phase 101, subtask 4): each of
;    2  C     caseForm's forms, on both sides of its thresholds.
;    3        PROGRAM F90SELECT
	.ENTRY	F90SELECT,^M<R2,R3>
;    4        INTEGER I, N
;    5        INTEGER*2 K
;    6        CHARACTER*8 WORD, WORDS(4)
;    7        LOGICAL L
;    8  C     A table: 4 tests over 16 values (4 slots a test), DEFAULT for the gaps,
;    9  C     and the open range tested when CASEL finds the value outside it.
;   10        SELECT CASE (I)
	CASEL	F90SELECT.I,#-1,#15
F90SELECT.$1:
	.WORD	F90SELECT.$2-F90SELECT.$1
	.WORD	F90SELECT.$3-F90SELECT.$1
	.WORD	F90SELECT.$3-F90SELECT.$1
	.WORD	F90SELECT.$3-F90SELECT.$1
	.WORD	F90SELECT.$4-F90SELECT.$1
	.WORD	F90SELECT.$3-F90SELECT.$1
	.WORD	F90SELECT.$3-F90SELECT.$1
	.WORD	F90SELECT.$3-F90SELECT.$1
	.WORD	F90SELECT.$3-F90SELECT.$1
	.WORD	F90SELECT.$3-F90SELECT.$1
	.WORD	F90SELECT.$3-F90SELECT.$1
	.WORD	F90SELECT.$3-F90SELECT.$1
	.WORD	F90SELECT.$3-F90SELECT.$1
	.WORD	F90SELECT.$3-F90SELECT.$1
	.WORD	F90SELECT.$3-F90SELECT.$1
	.WORD	F90SELECT.$4-F90SELECT.$1
	CMPL	F90SELECT.I,#100
	BLSS	F90SELECT.$6
	BRW	F90SELECT.$5
F90SELECT.$6:
	BRW	F90SELECT.$3
F90SELECT.$2:
;   11        CASE (-1)
;   12          N = 1
	MOVL	#1,F90SELECT.N
;   13        CASE (3, 14)
	BRW	F90SELECT.$7
F90SELECT.$4:
;   14          N = 2
	MOVL	#2,F90SELECT.N
;   15        CASE (100:)
	BRW	F90SELECT.$7
F90SELECT.$5:
;   16          N = 4
	MOVL	#4,F90SELECT.N
;   17        CASE DEFAULT
	BRW	F90SELECT.$7
F90SELECT.$3:
;   18          N = 5
	MOVL	#5,F90SELECT.N
;   19        END SELECT
F90SELECT.$7:
;   20  C     A chain: 4 tests over 17 values, too sparse for a table.
;   21        SELECT CASE (I)
	CMPL	F90SELECT.I,#1
	BNEQ	F90SELECT.$9
	BRW	F90SELECT.$8
F90SELECT.$9:
	CMPL	F90SELECT.I,#3
	BNEQ	F90SELECT.$11
	BRW	F90SELECT.$10
F90SELECT.$11:
	CMPL	F90SELECT.I,#17
	BNEQ	F90SELECT.$13
	BRW	F90SELECT.$12
F90SELECT.$13:
	CMPL	F90SELECT.I,#10
	BNEQ	F90SELECT.$15
	BRW	F90SELECT.$14
F90SELECT.$15:
	BRW	F90SELECT.$16
F90SELECT.$8:
;   22        CASE (1)
;   23          N = 1
	MOVL	#1,F90SELECT.N
;   24        CASE (3)
	BRW	F90SELECT.$16
F90SELECT.$10:
;   25          N = 2
	MOVL	#2,F90SELECT.N
;   26        CASE (17)
	BRW	F90SELECT.$16
F90SELECT.$12:
;   27          N = 3
	MOVL	#3,F90SELECT.N
;   28        CASE (10)
	BRW	F90SELECT.$16
F90SELECT.$14:
;   29          N = 4
	MOVL	#4,F90SELECT.N
;   30        END SELECT
F90SELECT.$16:
;   31  C     A chain: 3 tests, too few for a table however dense.
;   32        SELECT CASE (I)
	CMPL	F90SELECT.I,#1
	BNEQ	F90SELECT.$18
	BRW	F90SELECT.$17
F90SELECT.$18:
	CMPL	F90SELECT.I,#2
	BNEQ	F90SELECT.$19
	BRW	F90SELECT.$17
F90SELECT.$19:
	CMPL	F90SELECT.I,#3
	BNEQ	F90SELECT.$20
	BRW	F90SELECT.$17
F90SELECT.$20:
	BRW	F90SELECT.$21
F90SELECT.$17:
;   33        CASE (1, 2, 3)
;   34          N = 1
	MOVL	#1,F90SELECT.N
;   35        END SELECT
F90SELECT.$21:
;   36  C     A binary search: 8 tests, sparse.
;   37        SELECT CASE (I)
	CMPL	F90SELECT.I,#35
	BLSS	F90SELECT.$23
	BRW	F90SELECT.$22
F90SELECT.$23:
	CMPL	F90SELECT.I,#10
	BLSS	F90SELECT.$25
	BRW	F90SELECT.$24
F90SELECT.$25:
	TSTL	F90SELECT.I
	BGTR	F90SELECT.$27
	BRW	F90SELECT.$26
F90SELECT.$27:
	BRW	F90SELECT.$28
F90SELECT.$24:
	CMPL	F90SELECT.I,#20
	BLSS	F90SELECT.$30
	BRW	F90SELECT.$29
F90SELECT.$30:
	CMPL	F90SELECT.I,#10
	BNEQ	F90SELECT.$32
	BRW	F90SELECT.$31
F90SELECT.$32:
	BRW	F90SELECT.$28
F90SELECT.$29:
	CMPL	F90SELECT.I,#29
	BGTR	F90SELECT.$33
	BRW	F90SELECT.$31
F90SELECT.$33:
	BRW	F90SELECT.$28
F90SELECT.$22:
	CMPL	F90SELECT.I,#50
	BLSS	F90SELECT.$35
	BRW	F90SELECT.$34
F90SELECT.$35:
	CMPL	F90SELECT.I,#40
	BLSS	F90SELECT.$37
	BRW	F90SELECT.$36
F90SELECT.$37:
	CMPL	F90SELECT.I,#35
	BNEQ	F90SELECT.$39
	BRW	F90SELECT.$38
F90SELECT.$39:
	BRW	F90SELECT.$28
F90SELECT.$36:
	CMPL	F90SELECT.I,#40
	BNEQ	F90SELECT.$41
	BRW	F90SELECT.$40
F90SELECT.$41:
	BRW	F90SELECT.$28
F90SELECT.$34:
	CMPL	F90SELECT.I,#60
	BLSS	F90SELECT.$43
	BRW	F90SELECT.$42
F90SELECT.$43:
	CMPL	F90SELECT.I,#50
	BNEQ	F90SELECT.$44
	BRW	F90SELECT.$40
F90SELECT.$44:
	BRW	F90SELECT.$28
F90SELECT.$42:
	BRW	F90SELECT.$40
F90SELECT.$31:
;   38        CASE (10, 20:29)
;   39          N = 1
	MOVL	#1,F90SELECT.N
;   40        CASE (40, 50, 60:)
	BRW	F90SELECT.$28
F90SELECT.$40:
;   41          N = 2
	MOVL	#2,F90SELECT.N
;   42        CASE (:0)
	BRW	F90SELECT.$28
F90SELECT.$26:
;   43          N = 3
	MOVL	#3,F90SELECT.N
;   44        CASE (35)
	BRW	F90SELECT.$28
F90SELECT.$38:
;   45          N = 4
	MOVL	#4,F90SELECT.N
;   46        END SELECT
F90SELECT.$28:
;   47  C     A chain: 7 tests, sparse.
;   48        SELECT CASE (I)
	CMPL	F90SELECT.I,#10
	BNEQ	F90SELECT.$46
	BRW	F90SELECT.$45
F90SELECT.$46:
	CMPL	F90SELECT.I,#20
	BGEQ	F90SELECT.$48
	BRW	F90SELECT.$47
F90SELECT.$48:
	CMPL	F90SELECT.I,#29
	BGTR	F90SELECT.$49
	BRW	F90SELECT.$45
F90SELECT.$49:
F90SELECT.$47:
	CMPL	F90SELECT.I,#40
	BNEQ	F90SELECT.$51
	BRW	F90SELECT.$50
F90SELECT.$51:
	CMPL	F90SELECT.I,#50
	BNEQ	F90SELECT.$52
	BRW	F90SELECT.$50
F90SELECT.$52:
	CMPL	F90SELECT.I,#60
	BLSS	F90SELECT.$53
	BRW	F90SELECT.$50
F90SELECT.$53:
	TSTL	F90SELECT.I
	BGTR	F90SELECT.$55
	BRW	F90SELECT.$54
F90SELECT.$55:
	BRW	F90SELECT.$56
F90SELECT.$45:
;   49        CASE (10, 20:29)
;   50          N = 1
	MOVL	#1,F90SELECT.N
;   51        CASE (40, 50, 60:)
	BRW	F90SELECT.$56
F90SELECT.$50:
;   52          N = 2
	MOVL	#2,F90SELECT.N
;   53        CASE (:0)
	BRW	F90SELECT.$56
F90SELECT.$54:
;   54          N = 3
	MOVL	#3,F90SELECT.N
;   55        END SELECT
F90SELECT.$56:
;   56  C     INTEGER*2: widened, the range clipped to what it holds, which needs
;   57  C     no test of its high end; nor does the one reaching its lowest value.
;   58        SELECT CASE (K)
	CVTWL	F90SELECT.K,F90SELECT.$T1
	CMPL	F90SELECT.$T1,#30000
	BLSS	F90SELECT.$58
	BRW	F90SELECT.$57
F90SELECT.$58:
	CMPL	F90SELECT.$T1,#-1
	BGTR	F90SELECT.$60
	BRW	F90SELECT.$59
F90SELECT.$60:
	BRW	F90SELECT.$61
F90SELECT.$57:
;   59        CASE (30000:100000)
;   60          N = 1
	MOVL	#1,F90SELECT.N
;   61        CASE (-32768:-1)
	BRW	F90SELECT.$61
F90SELECT.$59:
;   62          N = 3
	MOVL	#3,F90SELECT.N
;   63        END SELECT
F90SELECT.$61:
;   64  C     An expression, and a constant one.
;   65        SELECT CASE (I + N)
	ADDL3	F90SELECT.I,F90SELECT.N,F90SELECT.$T1
	CMPL	F90SELECT.$T1,#2
	BNEQ	F90SELECT.$63
	BRW	F90SELECT.$62
F90SELECT.$63:
	BRW	F90SELECT.$64
F90SELECT.$62:
;   66        CASE (2)
;   67          N = 1
	MOVL	#1,F90SELECT.N
;   68        END SELECT
F90SELECT.$64:
;   69        SELECT CASE (3)
	BRW	F90SELECT.$65
;   70        CASE (1:2)
;   71          N = 1
	MOVL	#1,F90SELECT.N
;   72        CASE (3:)
	BRW	F90SELECT.$66
F90SELECT.$65:
;   73          N = 2
	MOVL	#2,F90SELECT.N
;   74        END SELECT
F90SELECT.$66:
;   75  C     LOGICAL.
;   76        SELECT CASE (L)
	BLBC	F90SELECT.L,F90SELECT.$68
	BRW	F90SELECT.$67
F90SELECT.$68:
;   77        CASE (.FALSE.)
;   78          N = 1
	MOVL	#1,F90SELECT.N
;   79        CASE DEFAULT
	BRW	F90SELECT.$69
F90SELECT.$67:
;   80          N = 2
	MOVL	#2,F90SELECT.N
;   81        END SELECT
F90SELECT.$69:
;   82  C     CHARACTER: a chain, then a search, then a place found at run time.
;   83        SELECT CASE (WORD)
	CMPC5	#8,F90SELECT.WORD,#^A/ /,#1,F90SELECT.$K1
	BGEQU	F90SELECT.$72
	BRW	F90SELECT.$71
F90SELECT.$72:
	CMPC5	#8,F90SELECT.WORD,#^A/ /,#1,F90SELECT.$K2
	BGTRU	F90SELECT.$73
	BRW	F90SELECT.$70
F90SELECT.$73:
F90SELECT.$71:
	CMPC5	#8,F90SELECT.WORD,#^A/ /,#2,F90SELECT.$K3
	BNEQ	F90SELECT.$74
	BRW	F90SELECT.$70
F90SELECT.$74:
	BRW	F90SELECT.$75
F90SELECT.$70:
;   84        CASE ('A':'M', 'ZZ')
;   85          N = 1
	MOVL	#1,F90SELECT.N
;   86        CASE DEFAULT
	BRW	F90SELECT.$76
F90SELECT.$75:
;   87          N = 2
	MOVL	#2,F90SELECT.N
;   88        END SELECT
F90SELECT.$76:
;   89        SELECT CASE (WORD(1:2))
	CMPC5	#2,F90SELECT.WORD,#^A/ /,#1,F90SELECT.$K4
	BLSSU	F90SELECT.$78
	BRW	F90SELECT.$77
F90SELECT.$78:
	CMPC5	#2,F90SELECT.WORD,#^A/ /,#1,F90SELECT.$K5
	BLSSU	F90SELECT.$80
	BRW	F90SELECT.$79
F90SELECT.$80:
	CMPC5	#2,F90SELECT.WORD,#^A/ /,#1,F90SELECT.$K6
	BLSSU	F90SELECT.$82
	BRW	F90SELECT.$81
F90SELECT.$82:
	CMPC5	#2,F90SELECT.WORD,#^A/ /,#1,F90SELECT.$K1
	BNEQ	F90SELECT.$84
	BRW	F90SELECT.$83
F90SELECT.$84:
	BRW	F90SELECT.$85
F90SELECT.$81:
	CMPC5	#2,F90SELECT.WORD,#^A/ /,#1,F90SELECT.$K6
	BNEQ	F90SELECT.$86
	BRW	F90SELECT.$83
F90SELECT.$86:
	BRW	F90SELECT.$85
F90SELECT.$79:
	CMPC5	#2,F90SELECT.WORD,#^A/ /,#1,F90SELECT.$K7
	BLSSU	F90SELECT.$88
	BRW	F90SELECT.$87
F90SELECT.$88:
	CMPC5	#2,F90SELECT.WORD,#^A/ /,#1,F90SELECT.$K5
	BNEQ	F90SELECT.$89
	BRW	F90SELECT.$83
F90SELECT.$89:
	BRW	F90SELECT.$85
F90SELECT.$87:
	CMPC5	#2,F90SELECT.WORD,#^A/ /,#1,F90SELECT.$K7
	BNEQ	F90SELECT.$90
	BRW	F90SELECT.$83
F90SELECT.$90:
	BRW	F90SELECT.$85
F90SELECT.$77:
	CMPC5	#2,F90SELECT.WORD,#^A/ /,#1,F90SELECT.$K2
	BLSSU	F90SELECT.$92
	BRW	F90SELECT.$91
F90SELECT.$92:
	CMPC5	#2,F90SELECT.WORD,#^A/ /,#1,F90SELECT.$K8
	BLSSU	F90SELECT.$94
	BRW	F90SELECT.$93
F90SELECT.$94:
	CMPC5	#2,F90SELECT.WORD,#^A/ /,#1,F90SELECT.$K4
	BNEQ	F90SELECT.$96
	BRW	F90SELECT.$95
F90SELECT.$96:
	BRW	F90SELECT.$85
F90SELECT.$93:
	CMPC5	#2,F90SELECT.WORD,#^A/ /,#1,F90SELECT.$K8
	BNEQ	F90SELECT.$97
	BRW	F90SELECT.$95
F90SELECT.$97:
	BRW	F90SELECT.$85
F90SELECT.$91:
	CMPC5	#2,F90SELECT.WORD,#^A/ /,#1,F90SELECT.$K9
	BLSSU	F90SELECT.$99
	BRW	F90SELECT.$98
F90SELECT.$99:
	CMPC5	#2,F90SELECT.WORD,#^A/ /,#1,F90SELECT.$K2
	BNEQ	F90SELECT.$100
	BRW	F90SELECT.$95
F90SELECT.$100:
	BRW	F90SELECT.$85
F90SELECT.$98:
	CMPC5	#2,F90SELECT.WORD,#^A/ /,#1,F90SELECT.$K9
	BNEQ	F90SELECT.$101
	BRW	F90SELECT.$95
F90SELECT.$101:
	BRW	F90SELECT.$85
F90SELECT.$83:
;   90        CASE ('A', 'C', 'E', 'G')
;   91          N = 1
	MOVL	#1,F90SELECT.N
;   92        CASE ('I', 'K', 'M', 'O')
	BRW	F90SELECT.$85
F90SELECT.$95:
;   93          N = 2
	MOVL	#2,F90SELECT.N
;   94        END SELECT
F90SELECT.$85:
;   95        SELECT CASE (WORDS(I))
	MULL3	F90SELECT.I,#8,R0
	MOVAB	F90SELECT.WORDS-8[R0],F90SELECT.$T1
	MOVL	#8,F90SELECT.$T2
	CMPC5	F90SELECT.$T2,@F90SELECT.$T1,#^A/ /,#1,F90SELECT.$K10
	BNEQ	F90SELECT.$103
	BRW	F90SELECT.$102
F90SELECT.$103:
	BRW	F90SELECT.$104
F90SELECT.$102:
;   96        CASE ('X')
;   97          N = 1
	MOVL	#1,F90SELECT.N
;   98        END SELECT
F90SELECT.$104:
;   99  C     A jump to END SELECT from inside it.
;  100        SELECT CASE (N)
	CMPL	F90SELECT.N,#1
	BNEQ	F90SELECT.$106
	BRW	F90SELECT.$105
F90SELECT.$106:
	BRW	F90SELECT.L10
F90SELECT.$105:
;  101        CASE (1)
;  102          IF (L) GO TO 10
	BLBC	F90SELECT.L,F90SELECT.$107
	BRW	F90SELECT.L10
F90SELECT.$107:
;  103          N = 6
	MOVL	#6,F90SELECT.N
;  104     10 END SELECT
F90SELECT.L10:
;  105        PRINT *, N
	PUSHL	#-1
	PUSHAB	F90SELECT.$IO1
	CALLS	#2,G^FTN$WRITE_SL
	PUSHAQ	F90SELECT.$D1
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;  106        END
	MOVL	#1,R0			; SS$_NORMAL
	RET

; Storage map for PICK, a subroutine
;   S     CHARACTER*(*)  argument 1  @PICK.S(AP)
;   N     INTEGER        argument 2  @PICK.N(AP)
;
PICK.S = 4				; S is argument 1
PICK.N = 8				; N is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
PICK.$D1:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_D
	.LONG	0			; set when the descriptor is used
PICK.$T1:
	.BLKB	2			; temporary
	.BLKB	2
PICK.$T2:
	.BLKL	1			; temporary
PICK.$T3:
	.BLKL	1			; temporary
PICK.$T4:
	.BLKL	1			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
PICK.$K1:
	.ASCII	/X/
PICK.$K2:
	.ASCII	/AX/

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  107  C     A value only known at run time: a dynamic string, freed after the
;  108  C     comparisons.
;  109        SUBROUTINE PICK(S, N)
	.ENTRY	PICK,^M<R2,R3,R4,R5>
;  110        CHARACTER*(*) S
;  111        SELECT CASE (S // 'X')
	MOVZWL	@PICK.S(AP),R0
	INCL	R0
	CVTLW	R0,PICK.$T1
	PUSHAQ	PICK.$D1
	PUSHAW	PICK.$T1
	CALLS	#2,G^LIB$SGET1_DD
	MOVZWL	@PICK.S(AP),R0
	MOVL	PICK.S(AP),R1
	MOVC3	R0,@4(R1),@PICK.$D1+4
	MOVL	PICK.$D1+4,R0
	MOVZWL	@PICK.S(AP),R1
	MOVC3	#1,PICK.$K1,(R0)[R1]
	MOVAB	@PICK.$D1+4,PICK.$T2
	MOVZWL	@PICK.S(AP),R0
	ADDL3	R0,#1,PICK.$T3
	CMPC5	PICK.$T3,@PICK.$T2,#^A/ /,#2,PICK.$K2
	BNEQ	PICK.$2
	BRW	PICK.$1
PICK.$2:
	MOVL	#1,PICK.$T4
	BRW	PICK.$3
PICK.$1:
	MOVL	#2,PICK.$T4
PICK.$3:
	PUSHAQ	PICK.$D1
	CALLS	#1,G^LIB$SFREE1_DD
	CASEL	PICK.$T4,#1,#1
PICK.$4:
	.WORD	PICK.$5-PICK.$4
	.WORD	PICK.$6-PICK.$4
	BRW	PICK.$5
PICK.$6:
;  112        CASE ('AX')
;  113          N = 1
	MOVL	#1,@PICK.N(AP)
;  114        CASE DEFAULT
	BRW	PICK.$7
PICK.$5:
;  115          N = 2
	MOVL	#2,@PICK.N(AP)
;  116        END SELECT
PICK.$7:
;  117        END
	RET

	.END	F90SELECT
