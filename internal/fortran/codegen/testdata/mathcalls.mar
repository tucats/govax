	.TITLE	TEST

; Storage map for MATHS, the main program
;   I     INTEGER     $LOCAL+0   MATHS.I
;   J     INTEGER     $LOCAL+4   MATHS.J
;   I2    INTEGER*2   $LOCAL+8   MATHS.I2
;   J2    INTEGER*2   $LOCAL+10  MATHS.J2
;   X     REAL        $LOCAL+12  MATHS.X
;   Y     REAL        $LOCAL+16  MATHS.Y
;   D     REAL*8      $LOCAL+20  MATHS.D
;   Q     REAL*16     $LOCAL+28  MATHS.Q
;   C     COMPLEX     $LOCAL+44  MATHS.C
;   Z     COMPLEX*16  $LOCAL+52  MATHS.Z
;

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
MATHS.I:
	.BLKL	1			; I
MATHS.J:
	.BLKL	1			; J
MATHS.I2:
	.BLKB	2			; I2
MATHS.J2:
	.BLKB	2			; J2
MATHS.X:
	.BLKL	1			; X
MATHS.Y:
	.BLKL	1			; Y
MATHS.D:
	.BLKL	2			; D
MATHS.Q:
	.BLKL	4			; Q
MATHS.C:
	.BLKL	2			; C
MATHS.Z:
	.BLKL	4			; Z
MATHS.$T1:
	.BLKL	1			; temporary
MATHS.$T2:
	.BLKL	1			; temporary
MATHS.$T3:
	.BLKL	1			; temporary
MATHS.$T4:
	.BLKL	1			; temporary
MATHS.$T5:
	.BLKL	2			; temporary
MATHS.$T6:
	.BLKL	2			; temporary
MATHS.$T7:
	.BLKL	4			; temporary
MATHS.$T8:
	.BLKL	4			; temporary
MATHS.$T9:
	.BLKL	2			; temporary
MATHS.$T10:
	.BLKL	2			; temporary
MATHS.$T11:
	.BLKL	4			; temporary
MATHS.$T12:
	.BLKL	1			; temporary
MATHS.$T13:
	.BLKB	2			; temporary
	.BLKB	2

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
MATHS.$K1:
	.LONG	^X00004100,^X00000000	; 2D0
MATHS.$F1:
	.LONG	^X00004080		; 1.0
MATHS.$F2:
	.LONG	^X00004001,^X00000000,^X00000000,^X00000000 ; 1Q0

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;    1  C     Intrinsic functions MTHRTL computes, called with their arguments by
;    2  C     reference: a value in R0, in R0 and R1, or through a hidden first
;    3  C     argument for REAL*16 and COMPLEX*16; ISHFT by a count that isn't
;    4  C     constant; intrinsic functions' names passed as arguments, MTHRTL's
;    5  C     routines and FTNRTL's; and a G_floating unit's routines.
;    6        PROGRAM MATHS
	.ENTRY	MATHS,^M<R2,R3>
;    7        INTRINSIC SIN, DSQRT, IABS, LEN, CHAR, QEXT
;    8        INTEGER I, J
;    9        INTEGER*2 I2, J2
;   10        REAL X, Y
;   11        DOUBLE PRECISION D
;   12        REAL*16 Q
;   13        COMPLEX C
;   14        COMPLEX*16 Z
;   15        X = SQRT(X) + SIN(X + 1.0) * ATAN2D(Y, X)
	PUSHAL	MATHS.X
	CALLS	#1,G^MTH$SQRT
	MOVF	R0,MATHS.$T1
	ADDF3	MATHS.X,MATHS.$F1,MATHS.$T3
	PUSHAL	MATHS.$T3
	CALLS	#1,G^MTH$SIN
	MOVF	R0,MATHS.$T2
	PUSHAL	MATHS.X
	PUSHAL	MATHS.Y
	CALLS	#2,G^MTH$ATAND2
	MOVF	R0,MATHS.$T4
	MULF3	MATHS.$T2,MATHS.$T4,R0
	ADDF3	MATHS.$T1,R0,MATHS.X
;   16        D = DLOG10(D) + MOD(D, 2.0D0) + ABS(C)
	PUSHAD	MATHS.D
	CALLS	#1,G^MTH$DLOG10
	MOVD	R0,MATHS.$T5
	PUSHAD	MATHS.$K1
	PUSHAD	MATHS.D
	CALLS	#2,G^MTH$DMOD
	MOVD	R0,MATHS.$T6
	PUSHAQ	MATHS.C
	CALLS	#1,G^MTH$CABS
	MOVF	R0,MATHS.$T4
	ADDD3	MATHS.$T5,MATHS.$T6,R0
	CVTFD	MATHS.$T4,R2
	ADDD3	R0,R2,MATHS.D
;   17        Q = EXP(Q) + QMAX1(Q, 1Q0)
	PUSHAH	MATHS.Q
	PUSHAH	MATHS.$T7
	CALLS	#2,G^MTH$HEXP
	MOVH	MATHS.Q,MATHS.$T8
	CMPH	MATHS.$F2,MATHS.$T8
	BGTR	MATHS.$2
	BRW	MATHS.$1
MATHS.$2:
	MOVH	MATHS.$F2,MATHS.$T8	; 1Q0
MATHS.$1:
	ADDH3	MATHS.$T7,MATHS.$T8,MATHS.Q
;   18        C = CSQRT(C) * CEXP(C)
	PUSHAQ	MATHS.C
	CALLS	#1,G^MTH$CSQRT
	MOVQ	R0,MATHS.$T9
	PUSHAQ	MATHS.C
	CALLS	#1,G^MTH$CEXP
	MOVQ	R0,MATHS.$T10
	MULF3	MATHS.$T9,MATHS.$T10,R0
	MULF3	MATHS.$T9+4,MATHS.$T10+4,R1
	SUBF3	R1,R0,MATHS.C
	MULF3	MATHS.$T9,MATHS.$T10+4,R0
	MULF3	MATHS.$T9+4,MATHS.$T10,R1
	ADDF3	R0,R1,MATHS.C+4
;   19        Z = CDLOG(Z)
	PUSHAO	MATHS.Z
	PUSHAO	MATHS.$T11
	CALLS	#2,G^MTH$CDLOG
	MOVO	MATHS.$T11,MATHS.Z
;   20        X = CABS(C) + ABS(Z) + AINT(X) + ANINT(Y)
	PUSHAQ	MATHS.C
	CALLS	#1,G^MTH$CABS
	MOVF	R0,MATHS.$T4
	PUSHAO	MATHS.Z
	CALLS	#1,G^MTH$CDABS
	MOVD	R0,MATHS.$T6
	PUSHAL	MATHS.X
	CALLS	#1,G^MTH$AINT
	MOVF	R0,MATHS.$T3
	PUSHAL	MATHS.Y
	CALLS	#1,G^MTH$ANINT
	MOVF	R0,MATHS.$T2
	CVTFD	MATHS.$T4,R0
	ADDD2	MATHS.$T6,R0
	CVTFD	MATHS.$T3,R2
	ADDD2	R2,R0
	CVTFD	MATHS.$T2,R2
	ADDD2	R2,R0
	CVTDF	R0,MATHS.X
;   21        I = ISHFT(I, J) + ISHFT(I2, J2)
	PUSHAL	MATHS.J
	PUSHAL	MATHS.I
	CALLS	#2,G^MTH$JISHFT
	MOVL	R0,MATHS.$T12
	PUSHAW	MATHS.J2
	PUSHAW	MATHS.I2
	CALLS	#2,G^MTH$IISHFT
	MOVW	R0,MATHS.$T13
	CVTWL	MATHS.$T13,R0
	ADDL3	MATHS.$T12,R0,MATHS.I
;   22        CALL APPLY(SIN, DSQRT, IABS, LEN, CHAR, QEXT)
	PUSHAB	G^FTN$QEXT
	PUSHAB	G^FTN$CHAR
	PUSHAB	G^FTN$LEN
	PUSHAB	G^MTH$JIABS
	PUSHAB	G^MTH$DSQRT
	PUSHAB	G^MTH$SIN
	CALLS	#6,G^APPLY
;   23        CALL GUNIT
	CALLS	#0,G^GUNIT
;   24        END
	MOVL	#1,R0			; SS$_NORMAL
	RET

; Storage map for GUNIT, a subroutine
;   D     REAL*8      $LOCAL+0  GUNIT.D
;   Z     COMPLEX*16  $LOCAL+8  GUNIT.Z
;

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
GUNIT.D:
	.BLKL	2			; D
GUNIT.Z:
	.BLKL	4			; Z
GUNIT.$T1:
	.BLKL	2			; temporary
GUNIT.$T2:
	.BLKL	2			; temporary
GUNIT.$T3:
	.BLKL	2			; temporary
GUNIT.$T4:
	.BLKL	4			; temporary

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
GUNIT.$K1:
	.LONG	^X00004010,^X00000000	; 1D0

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;   25  C
;   26        OPTIONS /G_FLOATING
;   27        SUBROUTINE GUNIT
	.ENTRY	GUNIT,^M<>
;   28        INTRINSIC DSIN, DBLEQ
;   29        DOUBLE PRECISION D
;   30        COMPLEX*16 Z
;   31        D = DSIN(D) + DATAN2D(D, 1D0) + CDABS(Z)
	PUSHAG	GUNIT.D
	CALLS	#1,G^MTH$GSIN
	MOVG	R0,GUNIT.$T1
	PUSHAG	GUNIT.$K1
	PUSHAG	GUNIT.D
	CALLS	#2,G^MTH$GATAND2
	MOVG	R0,GUNIT.$T2
	PUSHAO	GUNIT.Z
	CALLS	#1,G^MTH$CGABS
	MOVG	R0,GUNIT.$T3
	ADDG3	GUNIT.$T1,GUNIT.$T2,R0
	ADDG3	R0,GUNIT.$T3,GUNIT.D
;   32        Z = SQRT(Z)
	PUSHAO	GUNIT.Z
	PUSHAO	GUNIT.$T4
	CALLS	#2,G^MTH$CGSQRT
	MOVO	GUNIT.$T4,GUNIT.Z
;   33        CALL APPLY(DSIN, DBLEQ)
	PUSHAB	G^FTN$GBLEQ
	PUSHAB	G^MTH$GSIN
	CALLS	#2,G^APPLY
;   34        END
	RET

	.END	MATHS
