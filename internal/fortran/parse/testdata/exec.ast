== SUBROUTINE EXEC
4           SUBROUTINE EXEC(X, *, *)
5           ASSIGN 10 TO NSTART
6           GO TO (12, 24, 36) INDEX
7           GO TO NSTART (10, 12)
8           IF (- THETA CHI) 50, 50, 100
9     10    DO WHILE (.LT. X 5)
10          X = (+ X 1)
11          END DO
12          DO I = 1, 10
13          IF (.EQ. I 5) RETURN 1
14          END DO
15    12    READ (1, 1250) J K ARRAY(J, K)
16    1250  FORMAT (I1,1X,I1,1X,F6.2)
17    24    WRITE (6, 10) J K(3) 4 (/ (paren (+ L 4)) 2) N
18          WRITE (6, 40) K L M N O P
19    40    FORMAT (3I6.6/I6,2F8.4)
20    36    OPEN (1, FILE='DATA.DAT', STATUS='OLD', READONLY)
21          READ (1, REC=10, ERR=50) X
22          INQUIRE (FILE='DATA.DAT', EXIST=EX)
23          CLOSE (1, STATUS='KEEP')
24          DEFINE FILE 3(1000, 48, U, NREC)
25          FIND (3, REC=1)
26          DECODE (12, 100, A) K
27    100   FORMAT (3I4)
28          ENCODE (12, 100, B) K(3) K(2) K(1)
29          PRINT * (do (do ARRAY(I, J); I = 1, 2); J = 1, 3)
30          TYPE 100 I J
31          PAUSE 'WAIT'
32    50    REWIND (5)
33    60    RETURN 2
34          END
