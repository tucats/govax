== main program SHAPES
3           PROGRAM SHAPES
4           IMPLICIT TYPE(POINT) (P)
5           TYPE POINT
6             SEQUENCE
7             REAL :: X, Y
8             END TYPE POINT
9           TYPE, PRIVATE :: HIDDEN
10            INTEGER I
11            END TYPE
12          TYPE SEGMENT
13            TYPE(POINT) :: ENDS(2)
14            CHARACTER(LEN=8) :: LABEL
15            END TYPE SEGMENT
16          TYPE(POINT) :: A, B(3)
17          TYPE(SEGMENT), DIMENSION(4) :: PATH
18          REAL R
19          A%X = 1.0
20          B(2)%Y = (+ A%X 2.0)
21          PATH(1)%ENDS(2)%X = B(2)%Y
22          PATH(1)%LABEL(2:4) = 'abc'
23          R = (+ A.X PATH(1).ENDS(1).Y)
24          P%X = 3.0
25          END PROGRAM SHAPES
== BLOCK DATA INITS
27          BLOCK DATA INITS
28          TYPE POINT
29            SEQUENCE
30            REAL X, Y
31            END TYPE
32          TYPE(POINT) O, Q(2)
33          COMMON /PTS/ O, Q
34          DATA O /POINT((/ 1.0 2), (- 3))/ Q(1)%X, Q(2) /2*POINT(0, 0)/
35          END BLOCK DATA INITS
== FUNCTION MID
37          TYPE(POINT) FUNCTION MID(A, B)
38          TYPE POINT
39            REAL X, Y
40            END TYPE
41          TYPE(POINT) A, B
42          MID%X = (/ (paren (+ A%X B%X)) 2)
43          END FUNCTION MID
== FUNCTION TWICE
45          RECURSIVE TYPE(POINT) FUNCTION TWICE(A)
46          TYPE POINT
47            REAL X, Y
48            END TYPE
49          TYPE(POINT) A
50          END
