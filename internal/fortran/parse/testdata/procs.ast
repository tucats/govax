== main program PROCS
5           PROGRAM PROCS
6           STRUCTURE /PAIR/
7             REAL A, B
8             RECORD /PAIR/ INNER
9             END STRUCTURE
10          RECORD /PAIR/ P, Q(3)
11          INTERFACE
              == SUBROUTINE SOLVE
12            SUBROUTINE SOLVE(A, TOL)
13            REAL A(*)
14            REAL, OPTIONAL :: TOL
15            END SUBROUTINE SOLVE
              == FUNCTION AREA
16            FUNCTION AREA(R)
17            REAL AREA, R
18            END FUNCTION
19          END INTERFACE
20          INTERFACE SWAP
              == SUBROUTINE SWAPR
21            SUBROUTINE SWAPR(X, Y)
22            REAL X, Y
23            END SUBROUTINE
24            MODULE PROCEDURE SWAPI, SWAPC
25          END INTERFACE
26          INTERFACE OPERATOR(.CROSS.)
              == FUNCTION CROSS
27            FUNCTION CROSS(U, V)
28            REAL CROSS(3), U(3), V(3)
29            END FUNCTION CROSS
30          END INTERFACE
31          INTERFACE OPERATOR(+)
32          END INTERFACE
33          INTERFACE OPERATOR(.EQ.)
34          END INTERFACE
35          INTERFACE OPERATOR(/)
36          END INTERFACE
37          INTERFACE OPERATOR(//)
38          END INTERFACE
39          INTERFACE ASSIGNMENT(=)
40          END INTERFACE
41          CALL SOLVE(X, TOL=1.0E-6)
42          CALL SOLVE(TOL=T, A=X)
43          Y = (** (.INVERSE. A) 2)
44          Y = (.CROSS. (+ A B) (.EQV. C D))
45          Y = (.DOT. X Z)
46          Y = (.DOT. (.DOT. (paren X) (+ Z 1)) 2)
47          Y = (+ P.A Q(2).INNER.B)
48          Y = P.A.DOT.Z
49          Y = X.A
50          WRITE (*, 10) (.INVERSE. A) (paren (.INVERSE. B))
51          CONTAINS
              == SUBROUTINE INNER
52            SUBROUTINE INNER(N)
53            Y = P.A.DOT.Z
54            Y = (.DOT. N Z)
55            CONTAINS
56            END SUBROUTINE INNER
              == FUNCTION TWICE
57            REAL FUNCTION TWICE(X)
59            TWICE = (* 2 X)
60            END FUNCTION TWICE
61          END PROGRAM PROCS
== SUBROUTINE HOST
63          SUBROUTINE HOST
64          INTERFACE
              == SUBROUTINE S
65            SUBROUTINE S(F)
66            INTERFACE
                == FUNCTION F
67              FUNCTION F(X)
68              END FUNCTION
69            END INTERFACE
72            END SUBROUTINE
74          END INTERFACE
76          CALL S
77          CONTAINS
              == SUBROUTINE A
78            SUBROUTINE A
79            END
81          END SUBROUTINE HOST
== SUBROUTINE NOCONTAINS
83          SUBROUTINE NOCONTAINS
84          CONTAINS
85          END
== SUBROUTINE OPEN
87          SUBROUTINE OPEN
88          error: INTERFACE
90          INTERFACE
              == SUBROUTINE T
91            SUBROUTINE T
92            END SUBROUTINE T
93          END
== SUBROUTINE UNENDED
95          SUBROUTINE UNENDED
96          Y = A.B1.C
97          CONTAINS
              == SUBROUTINE U
98            SUBROUTINE U
99            END SUBROUTINE U
== main program NEXT
100         PROGRAM NEXT
101         END PROGRAM NEXT

