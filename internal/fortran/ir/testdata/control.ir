routine CONTROL main
  cell  N       L  $LOCAL+0    variable N
  cell  I       L  $LOCAL+4    variable I
  cell  $C1     L  $LOCAL+8    DO 20's count
  cell  $C2     L  $LOCAL+12   DO 30's count
  $LOCAL is 16 bytes
  datum $K1     text 'CHECK THE TAPE'
  datum $D1     descriptor T S 14 $K1
  datum $K2     text '00123'
  datum $D2     descriptor T S 5 $K2
  datum $K3     text 'N IS POSITIVE'
  datum $D3     descriptor T S 13 $K3
  datum $K4     text 'IN THE LOOP'
  datum $D4     descriptor T S 11 $K4
  datum $K5     text 'LOOP END'
  datum $D5     descriptor T S 8 $K5
  datum $K6     text 'TOO BIG'
  datum $D6     descriptor T S 7 $K6
  datum $K7     text '98'
  datum $D7     descriptor T S 2 $K7
B1:
  ; line 5
  assign N = 0
  ; line 6
  call FTN$PAUSE()
  ; line 7
  call FTN$PAUSE(ref $D1)
  ; line 8
  call FTN$PAUSE(ref $D2)
  ; line 9
  call BUMP(ref N)
  ; line 10
  branch gt.L(N, 0) B2 B3
B2:
  call FTN$PAUSE(ref $D3)
  jump B3
B3:
  ; line 11
  assign $C1 = 2
  assign I = 1
  jump B4
B4: L20  ; DO 20's body
  ; line 12
  call FTN$PAUSE(ref $D4)
  assign I = add.L(I, 1)
  assign $C1 = sub.L($C1, 1)
  branch gt.L($C1, 0) B4 B5
B5:
  ; line 13
  assign $C2 = 2
  assign I = 1
  jump B6
B6:  ; DO 30's body
  ; line 14
  assign N = add.L(N, I)
  ; line 15
  jump B7
B7: L30
  call FTN$STOP(ref $D5)
  noreturn
B8:
  assign I = add.L(I, 1)
  assign $C2 = sub.L($C2, 1)
  branch gt.L($C2, 0) B6 B9
B9:
  ; line 16
  branch gt.L(N, 5) B10 B11
B10:
  call FTN$STOP(ref $D6)
  noreturn
B11:
  ; line 17
  branch lt.L(N, 0) B12 B13
B12:
  call FTN$STOP(ref $D7)
  noreturn
B13:
  ; line 18
  call FTN$STOP()
  noreturn
routine BUMP subroutine
  param K       L  argument 1
  $LOCAL is 0 bytes
B1:
  ; line 23
  assign @K = add.L(@K, 1)
  ; line 24
  branch gt.L(@K, 10) B2 B3
B2:
  return
B3:
  ; line 25
  assign @K = add.L(@K, 1)
  ; line 26
  return
