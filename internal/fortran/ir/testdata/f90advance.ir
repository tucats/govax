routine F90ADV main
  cell  S       B  $LOCAL+0    variable S
  cell  A       B  $LOCAL+8    variable A
  cell  N       W  $LOCAL+16   variable N
  cell  I       L  $LOCAL+20   variable I
  cell  $FKC1   L  $LOCAL+24   the parsed form of a FORMAT
  cell  $T1     L  $LOCAL+28   temporary
  cell  $T2     L  $LOCAL+32   temporary
  $LOCAL is 36 bytes
  datum $IO1    control F90 nonadvancing
  datum $K1     text '(A)'
  datum $FK1    format constant $K1 cache $FKC1
  datum $D1     descriptor T S 8 S
  datum $IO2    control END= F90 nonadvancing EOR=
  datum $IO3    control END= IOSTAT= F90 nonadvancing
  datum $D2     descriptor T S 8 A
  datum $IO4    control F90
  datum $IO5    control F90 bad ADVANCE=
B1:
  ; line 10
  call FTN$WRITE_SF(ref $IO1, val 6, ref $FK1)
  call FTN$IO_ITEM(ref $D1)
  call FTN$IO_END()
  ; line 11
  call FTN$READ_SF(ref $IO2, val 5, ref $FK1)
  call FTN$IO_ITEM(ref $D1)
  call FTN$IO_END(ref $T1) -> $T2
  assign N = cvt.LW($T1)
  branch eq.L($T2, -2) B4 B2
B2:
  sign $T2 B7 B3 B3
B3:
  ; line 12
  jump B4
B4: L10
  call FTN$READ_SF(ref $IO3, val 5, ref $FK1)
  call FTN$IO_ITEM(ref $D1)
  call FTN$IO_END() -> $T2
  assign I = $T2
  branch eq.L($T2, -2) B6 B5
B5:
  sign $T2 B7 B6 B6
B6:
  ; line 13
  jump B7
B7: L20
  call FTN$ADVANCE(ref $D2) -> $T2
  switch $T2 base 0 [B8 B9] B10
B8:
  call FTN$READ_SF(ref $IO4, val 5, ref $FK1)
  jump B11
B9:
  call FTN$READ_SF(ref $IO1, val 5, ref $FK1)
  jump B11
B10:
  call FTN$READ_SF(ref $IO5, val 5, ref $FK1)
  jump B11
B11:
  call FTN$IO_ITEM(ref $D1)
  call FTN$IO_END()
  ; line 14
  return 1
