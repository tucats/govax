routine SHORTS main
  cell  B       B  $LOCAL+0    variable B
  cell  BV      B  $LOCAL+1    array BV, 3 bytes
  cell  L2      W  $LOCAL+4    variable L2
  cell  I2      W  $LOCAL+6    variable I2
  cell  J2      W  $LOCAL+8    variable J2
  cell  IV      W  $LOCAL+10   array IV, 6 bytes
  cell  I4      L  $LOCAL+16   variable I4
  cell  X       F  $LOCAL+20   variable X
  cell  $D4     L  $LOCAL+24   descriptor W S 2
  cell  $C1     L  $LOCAL+32   DO 10's count
  $LOCAL is 36 bytes
  datum $K1     L 5
  datum $IO1    control PRINT *
  datum $D1     descriptor BU S 1 B
  datum $D2     descriptor WU S 2 L2
  datum $D3     descriptor W S 2 I2
  datum $D5     descriptor W A 2 (1:3) IV
B1:
  ; line 7
  assign B = -1
  ; line 8
  assign I2 = 0
  ; line 9
  assign J2 = add.W(I2, 1)
  ; line 10
  assign J2 = add.W(J2, 1)
  ; line 11
  assign J2 = mul.W(J2, I2)
  ; line 12
  assign I4 = cvt.WL(I2)
  ; line 13
  assign I2 = cvt.LW(I4)
  ; line 14
  assign X = cvt.WF(I2)
  ; line 15
  assign J2 = cvt.FW(X)
  ; line 16
  assign B = cvt.WB(and.W(cvt.BW(B), L2))
  ; line 17
  assign L2 = xor.W(L2, L2)
  ; line 18
  assign L2 = not.W(xor.W(L2, L2))
  ; line 19
  assign I2 = not.W(I2)
  ; line 20
  assign J2 = neg.W(I2)
  ; line 21
  assign I4 = cvt.WL(IV-2[I4])
  ; line 22
  assign IV-2[cvt.WL(J2)] = I2
  ; line 23
  assign BV-1[I4] = B
  ; line 24
  branch B B2 B3
B2:
  assign I2 = 1
  jump B3
B3:
  ; line 25
  branch BV-1[I4] B4 B5
B4:
  assign I2 = 2
  jump B5
B5:
  ; line 26
  branch not.W(L2) B6 B7
B6:
  assign I2 = 3
  jump B7
B7:
  ; line 27
  branch and.W(cvt.BW(B), L2) B8 B9
B8:
  assign I2 = 4
  jump B9
B9:
  ; line 28
  branch lt.W(I2, 7) B10 B11
B10:
  assign I2 = 5
  jump B11
B11:
  ; line 29
  call SUB(ref I2, ref IV-2[I4], ref BV-1[I4], ref $K1)
  ; line 30
  call FTN$PRINT_LIST(ref $IO1)
  call FTN$IO_ITEM(ref $D1)
  call FTN$IO_ITEM(ref $D2)
  call FTN$IO_ITEM(ref $D3)
  assign $D4+4 = addr(IV-2[I4])
  call FTN$IO_ITEM(ref $D4)
  call FTN$IO_ITEM(ref $D5)
  call FTN$IO_END()
  ; line 31
  assign $C1 = cvt.WL(J2)
  assign I2 = 1
  branch le.L($C1, 0) B13 B12
B12: L10  ; DO 10's body
  ; line 32
  assign I2 = add.W(I2, 1)
  assign $C1 = sub.L($C1, 1)
  branch gt.L($C1, 0) B12 B13
B13:
  ; line 33
  return 1
routine SUB subroutine
  param A       F  argument 1
  param W       W  argument 2
  param C       B  argument 3
  param K       L  argument 4
  $LOCAL is 0 bytes
B1:
  ; line 37
  assign @W-2[@K] = @W[@K]
  ; line 38
  assign @C = @C
  ; line 39
  return
