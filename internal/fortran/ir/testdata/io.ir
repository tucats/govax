  call FTN$IO_ITEM(ref $D1)
  call FTN$IO_ITEM(ref $D2)
  call FTN$IO_END() -> $T1
  assign IOS = $T1
  sign $T1 B10 B4 B11
B4:
  ; line 24
  call FTN$WRITE_SF(ref $IO4, val 6, ref $F10)
  call FTN$IO_ITEM(ref $D1)
  call FTN$IO_ITEM(ref $D2)
  call FTN$IO_END() -> $T1
  assign IOS2 = cvt.LW($T1)
  sign $T1 B11 B5 B11
B5:
  ; line 25
  call FTN$WRITE_SF(ref $IO1, val -1, ref $F10)
  assign $C2 = 2
