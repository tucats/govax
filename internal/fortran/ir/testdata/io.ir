  ; line 26
  call FTN$WRITE_SL(ref $IO1, val add.L(I, 1))
  call FTN$IO_ITEM(ref $D2)
  call FTN$IO_END()
  ; line 27
  call FTN$READ_IF(ref $IO1, ref $D9, ref $F10)
  call FTN$IO_ITEM(ref $D1)
  call FTN$IO_ITEM(ref $D2)
  call FTN$IO_END()
  ; line 28
  call FTN$WRITE_IL(ref $IO1, ref $D10)
  call FTN$IO_ITEM(ref $D1)
  call FTN$IO_END()
  ; line 29
  call FTN$WRITE_IF(ref $IO2, ref $D11, ref $D12)
