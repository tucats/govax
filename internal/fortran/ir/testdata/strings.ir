  datum $D1     descriptor T S 8 S
  datum $K2     text 'LITERAL'
  datum $D2     descriptor T S 7 $K2
  datum $D5     descriptor T S 8 $T1
  datum $D6     descriptor T A 4 (1:3) LIST
B1:
