routine SUM function F
  param A       F  argument 1
  param M       L  argument 2
  param N       L  argument 3
  cell  SUM     F  $LOCAL+0    result SUM
  cell  J       L  $LOCAL+4    variable J
  cell  I       L  $LOCAL+8    variable I
  cell  $B1     L  $LOCAL+12   descriptor F A 4 (?,?)
  cell  $C1     L  $LOCAL+56   DO 10's count
  cell  $C2     L  $LOCAL+60   DO 10's count
  $LOCAL is 64 bytes
B1:
  assign $B1+4 = addr(@A)
  assign $B1+32 = @M
  assign $B1+20 = $B1+32
  assign $B1+40 = @N
  assign $B1+24 = $B1+40
  assign $B1+16 = addr(@A-4[neg.L($B1+20)])
  assign $B1+12 = mul.L(mul.L(4, $B1+20), $B1+24)
  ; line 5
  assign SUM = 0.0
  ; line 6
  assign $C1 = @N
  assign J = 1
  branch le.L($C1, 0) B5 B2
B2:  ; DO 10's body
  ; line 7
  assign $C2 = @M
  assign I = 1
  branch le.L($C2, 0) B4 B3
B3: L10  ; DO 10's body
  ; line 8
  assign SUM = add.F(SUM, @($B1+16)[add.L(mul.L(J, $B1+20), I)])
  assign I = add.L(I, 1)
  assign $C2 = sub.L($C2, 1)
  branch gt.L($C2, 0) B3 B4
B4:
  assign J = add.L(J, 1)
  assign $C1 = sub.L($C1, 1)
  branch gt.L($C1, 0) B2 B5
B5:
  ; line 9
  return SUM
routine SUB subroutine
  param X       F  argument 1
  param I       L  argument 2
  param J       L  argument 3
  param Y       F  argument 4
  param Z       F  argument 5
  cell  K       L  SHAPE+0    variable K
  cell  $B1     L  $LOCAL+0    descriptor F A 4 (?,?)
  cell  $B2     L  $LOCAL+44   descriptor F A 4 (1:2,?)
  cell  $B3     L  $LOCAL+88   descriptor F A 4 (1:3,?,?)
  cell  $T1     L  $LOCAL+144  temporary
  $LOCAL is 148 bytes
  datum $IO1    control PRINT *
  datum $D1     descriptor L S 4 $T1
B1:
  assign $B1+4 = addr(@X)
  assign $B1+28 = neg.L(div.L(@I, 2))
  assign $B1+32 = div.L(@I, 2)
  assign $B1+20 = add.L(sub.L($B1+32, $B1+28), 1)
  assign $B1+40 = @J
  assign $B1+24 = $B1+40
  assign $B1+16 = addr(@X[neg.L(add.L($B1+20, $B1+28))])
  assign $B1+12 = mul.L(mul.L(4, $B1+20), $B1+24)
  assign $B2+4 = addr(@Y)
  assign $B2+40 = K
  assign $B2+24 = add.L($B2+40, 1)
  assign $B2+16 = addr(@Y-4)
  assign $B2+12 = mul.L(8, $B2+24)
  assign $B3+4 = addr(@Z)
  assign $B3+44 = K
  assign $B3+24 = $B3+44
  assign $B3+16 = addr(@Z-4[neg.L(mul.L(add.L($B3+24, 1), 3))])
  ; line 15
  assign @($B1+16)[add.L(mul.L(@J, $B1+20), div.L(@I, 2))] = 999.0
  ; line 16
  assign @($B2+16)+4[mul.L(add.L(@I, 1), 2)] = 1.0
  ; line 17
  assign @($B3+16)+4[mul.L(add.L(mul.L(@J, $B3+24), 2), 3)] = 2.0
  ; line 18
  call FTN$PRINT_LIST(ref $IO1)
  call FTN$IO_ITEM(ref $B1)
  call FTN$IO_ITEM(ref $B2)
  assign $T1 = $B1+12
  call FTN$IO_ITEM(ref $D1)
  call FTN$IO_END()
  ; line 19
  call OTHER(ref @X, ref @($B2+16)+12)
  ; line 20
  return
routine CHARS subroutine
  param A       B  argument 1
  param B       B  argument 2
  param N       L  argument 3
  cell  $B1     L  $LOCAL+0    descriptor T A 8 (?)
  cell  $B2     L  $LOCAL+32   descriptor T A 0 (?)
  $LOCAL is 64 bytes
  datum $IO1    control PRINT *
B1:
  assign $B1+4 = addr(@(@(arg A)+4))
  assign $B1+28 = @N
  assign $B1+20 = $B1+28
  assign $B1+16 = addr(@(@(arg A)+4)-8)
  assign $B1+12 = mul.L(8, $B1+20)
  assign $B2 = @(arg B)
  assign $B2+4 = addr(@(@(arg B)+4))
  assign $B2+28 = @N
  assign $B2+20 = add.L($B2+28, 1)
  assign $B2+16 = addr(@(@(arg B)+4))
  assign $B2+12 = mul.L(zext.WL(@(arg B)), $B2+20)
  ; line 26
  move @($B1+16)[mul.L(@N, 8)](8) = @($B2+16)[mul.L(sub.L(@N, 1), zext.WL(@(arg B)))](zext.WL(@(arg B)))
  ; line 27
  call FTN$PRINT_LIST(ref $IO1)
  call FTN$IO_ITEM(ref $B1)
  call FTN$IO_ITEM(ref $B2)
  call FTN$IO_END()
  ; line 28
  return
routine E subroutine
  param A       O  through $A1
  param N       L  through $A2
  entry 1 E A=1 N=2
  entry 2 E1 N=1 A=2 at B4
  entry 3 E2 A=1 at B3
  cell  $A1     L  $LOCAL+0    address of A
  cell  $A2     L  $LOCAL+4    address of N
  cell  $B1     L  $LOCAL+8    descriptor DC A 16 (?)
  $LOCAL is 40 bytes
B1:
  assign $B1+4 = addr(@A)
  assign $B1+28 = @N
  assign $B1+20 = $B1+28
  assign $B1+16 = addr(@A-16)
  assign $B1+12 = mul.L(16, $B1+20)
  ; line 34
  assign @N = 1
  ; line 35
  jump B2
B2:  ; ENTRY E1
  ; line 36
  assign @($B1+16)[@N] = (0D0, 1D0)
  ; line 37
  return
B3:  ; ENTRY E2
  ; line 39
  return
B4:  ; E1's adjustable arrays' bounds
  assign $B1+4 = addr(@A)
  assign $B1+28 = @N
  assign $B1+20 = $B1+28
  assign $B1+16 = addr(@A-16)
  assign $B1+12 = mul.L(16, $B1+20)
  jump B2
