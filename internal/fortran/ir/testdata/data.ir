routine DATAS main
  cell  A       L  $LOCAL+0    array A, 48 bytes
  cell  B       L  $LOCAL+48   array B, 20 bytes
  cell  K       L  $LOCAL+68   variable K
  cell  X       F  $LOCAL+72   variable X
  cell  R       F  $LOCAL+76   array R, 8 bytes
  cell  D       D  $LOCAL+84   variable D
  cell  W       W  $LOCAL+92   variable W
  cell  L       B  $LOCAL+94   variable L
  cell  STARS   B  $LOCAL+95   variable STARS
  cell  C       B  $LOCAL+104  variable C
  cell  CI      L  $LOCAL+104  variable CI
  cell  I       L  SHARED+0    variable I
  cell  J       L  SHARED+4    variable J
  cell  Y       F  SHARED+8    variable Y
  $LOCAL is 108 bytes
  init  $LOCAL+0 A(1) = 00 00 00 00
  init  $LOCAL+4 A(2) = 00 00 00 00
  init  $LOCAL+8 A(3) = 00 00 00 00
  init  $LOCAL+12 A(4) = 00 00 00 00
  init  $LOCAL+16 A(5) = 00 00 00 00
  init  $LOCAL+20 A(6) = 00 00 00 00
  init  $LOCAL+24 A(7) = 00 00 00 00
  init  $LOCAL+28 A(8) = 00 00 00 00
  init  $LOCAL+32 A(9) = 00 00 00 00
  init  $LOCAL+36 A(10) = 00 00 00 00
  init  $LOCAL+40 A(11) = 00 00 00 00
  init  $LOCAL+44 A(12) = 00 00 00 00
  init  $LOCAL+52 B(2) = 07 00 00 00
  init  $LOCAL+60 B(4) = 08 00 00 00
  init  $LOCAL+68 K = 05 00 00 00
  init  $LOCAL+72 X = C0 40 00 00
  init  $LOCAL+76 R(1) = 00 00 00 00
  init  $LOCAL+80 R(2) = 00 00 00 00
  init  $LOCAL+84 D = 80 40 00 00 00 00 00 00
  init  $LOCAL+92 W = FE FF
  init  $LOCAL+94 L = FF
  init  $LOCAL+95 STARS = 2A 2A 2A 2A 20 20
  init  $LOCAL+105 C(2:3) = 58 59
  init  SHARED+4 J = 03 00 00 00
  external BLKDAT
  datum $IO1    control
  datum $D1     descriptor L S 4 K
  datum $D2     descriptor F S 4 X
  datum $D3     descriptor L S 4 B+4
  datum $D4     descriptor F S 4 Y
B1:
  ; line 18
  assign K = add.L(K, I)
  ; line 19
  call FTN$WRITE_SL(ref $IO1, val -1)
  call FTN$IO_ITEM(ref $D1)
  call FTN$IO_ITEM(ref $D2)
  call FTN$IO_ITEM(ref $D3)
  call FTN$IO_ITEM(ref $D4)
  call FTN$IO_END()
  ; line 20
  return 1
routine BLKDAT block data
  cell  I       L  SHARED+0    variable I
  cell  J       L  SHARED+4    variable J
  cell  Y       F  SHARED+8    variable Y
  cell  DBL     D  OTHER+0    array DBL, 16 bytes
  $LOCAL is 0 bytes
  init  OTHER+0 DBL(1) = 00 00 00 00 00 00 00 00
  init  OTHER+8 DBL(2) = 00 00 00 00 00 00 00 00
  init  SHARED+8 Y = 20 41 00 00
