routine SQUARES main
  cell  I       L  $LOCAL+0    variable I
  cell  $C1     L  $LOCAL+4    DO 10's count
  cell  $T1     L  $LOCAL+8    temporary
  $LOCAL is 12 bytes
  datum $IO1    control PRINT *
  datum $D1     descriptor L S 4 I
  datum $D2     descriptor L S 4 $T1
B1:
  ; line 3
  assign $C1 = 5
  assign I = 1
  jump B2
B2:  ; DO 10's body
  ; line 4
  call FTN$PRINT_LIST(ref $IO1)
  call FTN$IO_ITEM(ref $D1)
  assign $T1 = mul.L(I, I)
  call FTN$IO_ITEM(ref $D2)
  call FTN$IO_END()
  ; line 5
  jump B3
B3: L10
  assign I = add.L(I, 1)
  assign $C1 = sub.L($C1, 1)
  branch gt.L($C1, 0) B2 B4
B4:
  ; line 6
  return 1
