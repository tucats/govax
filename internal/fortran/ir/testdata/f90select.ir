  call LIB$SGET1_DD(ref $T1, ref $D1)
  move @($D1+4)(zext.WL(@(arg S))) = @(@(arg S)+4)(zext.WL(@(arg S)))
  move @($D1+4)[zext.WL(@(arg S))](1) = $K1(1)
  assign $T2 = addr(@($D1+4))
  assign $T3 = add.L(zext.WL(@(arg S)), 1)
  branch eq.T(@($T2)($T3), $K2(2)) B4 B2
B2:
  jump B3
B3:
