routine PICK subroutine
  param S       B  argument 1
  param N       L  argument 2
  cell  $D1     L  $LOCAL+0    descriptor T D 0
  cell  $T1     W  $LOCAL+8    temporary
  cell  $T2     L  $LOCAL+12   temporary
