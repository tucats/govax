routine FLOATS main
  cell  D       D  $LOCAL+0    variable D
  cell  E       D  $LOCAL+8    variable E
  cell  DV      D  $LOCAL+16   array DV, 24 bytes
  cell  Q       H  $LOCAL+40   variable Q
  cell  QV      H  $LOCAL+56   array QV, 32 bytes
  cell  I2      W  $LOCAL+88   variable I2
  cell  X       F  $LOCAL+92   variable X
  cell  I       L  $LOCAL+96   variable I
  cell  $C1     L  $LOCAL+100  DO 10's count
  $LOCAL is 104 bytes
  datum $K1     D 1D0
  datum $IO1    control
  datum $D1     descriptor D S 8 D
  datum $D2     descriptor H S 16 Q
  datum $D3     descriptor D A 8 (1:3) DV
  datum $D4     descriptor H S 16 QV
  datum $K2     D 3.5D0
  datum $D5     descriptor D S 8 $K2
B1:
  ; line 6
  assign D = 0.1D0
  ; line 7
  assign E = 0.1D0
  ; line 8
  assign X = cvt.DF(D)
  ; line 9
  assign D = cvt.FD(X)
  ; line 10
  assign D = add.D(D, cvt.FD(mul.F(X, 2.0)))
  ; line 11
  assign E = div.D(mul.D(add.D(D, E), sub.D(D, E)), add.D(E, 1D0))
  ; line 12
  assign Q = cvt.DH(D)
  ; line 13
  assign Q = add.H(mul.H(Q, Q), 1Q0)
  ; line 14
  assign Q = mul.H(add.H(Q, Q), sub.H(Q, Q))
  ; line 15
  assign Q = mul.H(add.H(Q, QV-16[I]), sub.H(Q, QV[I]))
  ; line 16
  assign D = cvt.HD(Q)
  ; line 17
  assign I = cvt.DL(D)
  ; line 18
  assign I2 = cvt.HW(Q)
  ; line 19
  assign D = cvt.WD(I2)
  ; line 20
  assign DV-8[I] = neg.D(DV[I])
  ; line 21
  assign QV-16[I] = 0Q0
  ; line 22
  branch lt.D(D, E) B2 B3
B2:
  assign D = 2.5D0
  jump B3
B3:
  ; line 23
  branch eq.H(Q, 0Q0) B4 B5
B4:
  assign Q = 1Q0
  jump B5
B5:
  ; line 24
  call DF(ref D) -> D
  ; line 25
  call SUB(ref D, ref Q, ref $K1, ref DV-8[I])
  ; line 26
  call FTN$WRITE_SL(ref $IO1, val -1)
  call FTN$IO_ITEM(ref $D1)
  call FTN$IO_ITEM(ref $D2)
  call FTN$IO_ITEM(ref $D3)
  call FTN$IO_ITEM(ref $D4)
  call FTN$IO_ITEM(ref $D5)
  call FTN$IO_END()
  ; line 27
  assign $C1 = 3
  assign D = 1D0
  jump B6
B6: L10  ; DO 10's body
  ; line 28
  assign D = add.D(D, 0.5D0)
  assign $C1 = sub.L($C1, 1)
  branch gt.L($C1, 0) B6 B7
B7:
  ; line 29
  return 1
routine DF function D
  param A       D  argument 1
  cell  DF      D  $LOCAL+0    result DF
  $LOCAL is 8 bytes
B1:
  ; line 32
  assign DF = mul.D(@A, @A)
  ; line 33
  return DF
routine SUB subroutine
  param A       G  argument 1
  param B       H  argument 2
  param C       G  argument 3
  param V       G  argument 4
  cell  $D1     L  $LOCAL+0    descriptor G S 8
  $LOCAL is 8 bytes
  datum $IO1    control
B1:
  ; line 38
  assign @A = add.G(add.G(@A, mul.G(@C, 0.1D0)), @V+8)
  ; line 39
  assign @B = cvt.GH(@A)
  ; line 40
  call FTN$WRITE_SL(ref $IO1, val -1)
  assign $D1+4 = addr(@A)
  call FTN$IO_ITEM(ref $D1)
  call FTN$IO_END()
  ; line 41
  return
