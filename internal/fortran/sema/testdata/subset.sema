== main program SUBSET
  SUBSET                  program unit
  I         INTEGER       variable         $LOCAL+0
  N         INTEGER       variable         $LOCAL+4
  TABLE     INTEGER       array(1:10)      $LOCAL+8
  X         REAL          variable         $LOCAL+48
  Y         REAL          variable         $LOCAL+52
  AVG       REAL          function
  DONE      LOGICAL       variable         $LOCAL+56
  V         REAL          array(0:9)       $LOCAL+60
  SUMUP                   subroutine
  $LOCAL is 100 bytes
7           N = 10
8           DONE = .FALSE.
10          DO 10 I = 1, N, 1
11            TABLE[I] = (+:I (-:I (*:I I I) (*:I 2 I)) 1)
12            V[(-:I I 1)] = (/:R (REAL I) 2.0)
13    10      CONTINUE
14          CALL SUMUP(TABLE[], N, X)
15          Y = AVG(TABLE[], N)
16          IF (.AND.:L (.GT.:R Y 100.0) (.NOT.:L DONE)) THEN
17            PRINT * 'BIG' Y
18          ELSE IF (.GT.:R Y 10.0) THEN
19            WRITE (*,*) 'MEDIUM' Y
20          ELSE
21            WRITE (*,*) 'SMALL' Y DONE V[]
22          END IF
23          I = 0
24    20    I = (+:I I 1)
25          IF (.LT.:I I 3) GO TO 20
26          IF (.NE.:I I 3) STOP 'WRONG COUNT'
27          PRINT *
28          STOP
29          END
== SUBROUTINE SUMUP
  SUMUP                   program unit
  T         INTEGER       array(1:*)       argument 1
  N         INTEGER       variable         argument 2
  S         REAL          variable         argument 3
  K         INTEGER       variable         $LOCAL+0
  $LOCAL is 4 bytes
33          S = 0.0
34          DO 100 K = N, 1, -1
35    100     S = (+:R S (REAL T[K]))
36          RETURN
37          END
== FUNCTION AVG
  AVG       REAL          result           $LOCAL+0
  T         INTEGER       array(1:10)      argument 1
  N         INTEGER       variable         argument 2
  J         INTEGER       variable         $LOCAL+4
  $LOCAL is 8 bytes
41          AVG = 0.0
42          DO 200 J = 1, N, 1
43            AVG = (+:R AVG (REAL T[J]))
44    200     CONTINUE
45          AVG = (/:R AVG (REAL N))
46          END
