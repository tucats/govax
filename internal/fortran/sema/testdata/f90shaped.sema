== SUBROUTINE SHAPED
  SHAPED                  program unit
  A         REAL          array(N:, 1:)    argument 1
  N         INTEGER       variable         argument 2
  C         CHARACTER*(*) array(1:)        argument 3
  O         REAL          array(1:)        argument 4 optional
  $LOCAL is 0 bytes
13          A[N, 1] = (+:R A[(+:I N 1), 2] (REAL SIZE(A[])))
14          PRINT * C[2] LBOUND(A[], DIM=1) UBOUND(A[], DIM=2)
15          IF (PRESENT O) O[1] = 0.0
16          END
== SUBROUTINE CALLER
  CALLER                  program unit
  X         REAL          array(1:M, 1:3)  argument 1
  M         INTEGER       variable         argument 2
  Y         REAL          array(1:4, 1:3)  $LOCAL+0
  H         REAL          array(:, :)      $LOCAL+48 allocatable freed
  S         CHARACTER*4   array(1:6)       $LOCAL+92
  SHAPED                  subroutine        interface(line 24)
  $LOCAL is 116 bytes
31          ALLOCATE H(1:2, 1:2)
32          CALL SHAPED(Y[], 0, S[], )
33          CALL SHAPED(Y[1:4:2, 3:1:-1], 1, S[2:6:2], Y[2, 1:3:1])
34          CALL SHAPED(X[], M, S[], X[M, 1:3:1])
35          CALL SHAPED(H[], 2, S[6:1:-1], )
36          END
