== main program ERRS
  ERRS                 program unit
  I         INTEGER    variable         $LOCAL+0
  A         INTEGER    array(1:10)      $LOCAL+4
  X         REAL       variable         $LOCAL+44
  J         INTEGER    variable         $LOCAL+48
  SUB                  subroutine
  $LOCAL is 52 bytes
6           I = 1
13          DO 10 I = 1, 10, 1
15            IF (LOGICAL A[I]) GO TO 30
16    10      CONTINUE
18          CALL SUB(A[], X)
19          GO TO 20
20          END
