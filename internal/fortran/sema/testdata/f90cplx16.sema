== main program F90CPLX16
  F90CPLX16               program unit
  Z         COMPLEX*32    variable         $LOCAL+0 saved
  W         COMPLEX*32    variable         $LOCAL+32
  A         COMPLEX*32    array(1:3)       $LOCAL+64
  V         COMPLEX*32    variable         $LOCAL+160
  D         COMPLEX*16    variable         $LOCAL+192
  H         REAL*16       variable         $LOCAL+208
  TWICE     COMPLEX*32    function
  TAKE                    subroutine
  I         INTEGER       variable         $LOCAL+224
  $LOCAL is 228 bytes
  initial $LOCAL+0 Z COMPLEX*32 = 01 40 00 80 00 00 00 00 00 00 00 00 00 00 00 00 02 C0 00 00 00 00 00 00 00 00 00 00 00 00 00 00
12          W = (+:X Z (0.5Q0, 1.0Q0))
13          V = (-:X (*:X Z W) A[2])
14          V = (/:X Z W)
15          V = (-:X V)
16          A[3] = V
17          D = (COMPLEX*16 V)
18          V = (COMPLEX*32 D)
19          H = (REAL*16 V)
20          V = (COMPLEX*32 H)
21          V = (cmplx:COMPLEX*32 CMPLX H H)
22          H = (+:R (imag:REAL*16 AIMAG V) (REAL*16 V))
23          V = (conjg:COMPLEX*32 CONJG V)
24          D = (COMPLEX*16 V)
25          IF (.EQ.:X Z W) V = Z
26          IF (.NE.:X Z W) V = TWICE(Z)
27          CALL TAKE(Z, A[])
28          V = (2.0Q0, 3.0Q0)
29          A[I] = V
30          V = (*:X A[I] A[(+:I I 1)])
31          CALL TAKE(A[I], (/:X V A[I]))
32          END
== FUNCTION TWICE
  TWICE     COMPLEX*32    result
  X         COMPLEX*32    variable         argument 1
  $LOCAL is 0 bytes
36          TWICE = (+:X X X)
37          END
== SUBROUTINE TAKE
  TAKE                    program unit
  X         COMPLEX*32    variable         argument 1
  Y         COMPLEX*32    array(1:*)       argument 2
  N         INTEGER       variable         $LOCAL+0
  $LOCAL is 4 bytes
41          Y[N] = X
42          Y[(+:I N 2)] = (/:X Y[(-:I N 1)] X)
43          END
