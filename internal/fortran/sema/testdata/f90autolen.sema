== SUBROUTINE AUTOLEN
  AUTOLEN                 program unit
  S         CHARACTER*(N) variable         argument 1
  N         INTEGER       variable         argument 2
  C         CHARACTER*(*) variable         argument 3
  T         CHARACTER*(LEN(C)+1) variable         $LOCAL+0 automatic-scalar
  W         CHARACTER*(N) array(1:N)       $LOCAL+8 automatic-array
  SHOW                    subroutine
  $LOCAL is 40 bytes
11          T = C
12          S = T
13          W[1] = S
14          PRINT * (len:INTEGER LEN S) (len:INTEGER LEN T) (len:INTEGER LEN W[]) T W[1]
15          CALL SHOW(T, S)
16          END
