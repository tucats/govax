== SUBROUTINE TAKE
  TAKE                    program unit
  V         REAL          array(1:)        argument 1
  C         CHARACTER*(*) array(1:)        argument 2
  O         REAL          array(1:)        argument 3 optional
  $LOCAL is 0 bytes
13          PRINT * SIZE(V[]) C[1] (PRESENT O)
14          END
== SUBROUTINE GIVE
  GIVE                    program unit
  A         REAL          array(1:N)       argument 1
  N         INTEGER       variable         argument 2
  IV        INTEGER       array(1:3)       argument 3
  S         CHARACTER*4   array(1:5)       argument 4
  O         REAL          array(1:)        argument 5 optional
  TAKE                    subroutine        interface(line 21)
  TAKEG                   subroutine        interface(line 28)
  G                       subroutine
  $LOCAL is 0 bytes
32          CALL TAKE(A[<IV[]>], S[2:4:1](2:3), O[])
33          CALL TAKE((*:R A[] 2.0), S[<IV[]>], (copy A[]))
34          CALL TAKE((/:R 1.0 2.0 /), (//:C S[] 'X'), )
35          CALL TAKEG((+:R A[1:N:2] 1.0))
36          END
