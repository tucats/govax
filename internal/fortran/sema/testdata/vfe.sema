== SUBROUTINE VFE
  VFE                     program unit
  N         INTEGER       variable         argument 1
  S         CHARACTER*(*) variable         argument 2
  F         REAL          function
  X         REAL          variable         $LOCAL+0
  I         INTEGER       variable         $LOCAL+4
  K         INTEGER       variable         $LOCAL+8
  $LOCAL is 12 bytes
7           WRITE (6,10) (I, I = 1, N, 1) X
8           WRITE (6,20) N
9           ASSIGN 10 TO K
10          WRITE (6,assigned K) 1
11          END
