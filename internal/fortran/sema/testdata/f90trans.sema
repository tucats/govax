== SUBROUTINE TRANS
  TRANS                   program unit
  V         INTEGER       array(1:6)       argument 1
  M         INTEGER       array(1:3, 1:3)  argument 2
  L         LOGICAL       array(1:3, 1:3)  argument 3
  N         INTEGER       variable         argument 4
  K         INTEGER       variable         argument 5
  W         INTEGER       array(1:3)       $LOCAL+0
  $LOCAL is 12 bytes
10          M[] = SPREAD(V[1:3:1], N, DIM=2)
11          V[] = CSHIFT(V[], (-:I K), DIM=1)
12          M[] = EOSHIFT(M[], 1, DIM=2, PAD=-1)
13          W[] = PACK(M[], MASK=L[])
14          M[] = UNPACK(W[], 0, MASK=L[])
15          PRINT * RESHAPE(V[], (/:I 2 N /))
16          END
== SUBROUTINE DIMS
  DIMS                    program unit
  M         INTEGER       array(1:3, 1:3)  argument 1
  K         INTEGER       variable         argument 2
  W         INTEGER       array(1:3)       argument 3
  $LOCAL is 0 bytes
20          W[] = SUM(M[], DIM=K)
21          END
