== main program LOOPS
  LOOPS                   program unit
  I         INTEGER       variable         $LOCAL+0
  J         INTEGER       variable         $LOCAL+4
  K         INTEGER       variable         $LOCAL+8
  N         INTEGER       variable         $LOCAL+12
  MORE      LOGICAL       variable         $LOCAL+16
  $LOCAL is 20 bytes
6           N = 0
7           DO I = 1, 3, 1
8             DO J = I, 3, 1
9               N = (+:I N J)
10            END DO
11          END DO
12          K = 1
13          DO WHILE (.LT.:I K 100)
14            K = (*:I K 2)
15          END DO
16          DO 10 WHILE (.GT.:I K 0)
17            K = (-:I K 30)
18    10      CONTINUE
19          DO 20 I = 1, N, 1
20            IF (.GT.:I I 2) GO TO 20
21            MORE = (.EQ.:I I 1)
22    20    END DO
23          DO 40 I = 1, 2, 1
24            GO TO 30
25    25      N = (+:I N 1)
26    40      CONTINUE
27          STOP
28    30    N = (-:I N 1)
29          GO TO 25
30          END
