== main program NEST
  NEST                 program unit
  I         INTEGER    variable         $LOCAL+0
  J         INTEGER    variable         $LOCAL+4
  K         INTEGER    variable         $LOCAL+8
  M         INTEGER    array(1:3, 1:4)  $LOCAL+12
  L         LOGICAL    variable         $LOCAL+60
  X         REAL       variable         $LOCAL+64
  $LOCAL is 68 bytes
5           L = .TRUE.
6           DO 20 I = 1, 3, 1
7             DO 20 J = 1, 4, 1
8               M[I, J] = (+:I I J)
9               IF (.GT.:I M[I, J] 5) GO TO 20
10              M[I, J] = (-:I M[I, J])
11    20        CONTINUE
12          K = 0
13          IF L THEN
14            DO 30 X = 0.5, 2.5, 0.5
15              IF (.EQ.:R X 1.5) THEN
16                K = (+:I K 1)
17              ELSE IF (.GT.:R X 2.0) THEN
18                GO TO 40
19              END IF
20    30        CONTINUE
21    40    END IF
22          IF (LOGICAL K) PRINT * 'ODD' K
23          IF (.OR.:L (.NOT.:L L) (.EQ.:I K 1)) K = 3
24          L = (LOGICAL (.AND.:I K 6))
25          END
