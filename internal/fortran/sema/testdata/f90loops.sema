== main program F90LOOPS
  F90LOOPS                program unit
  I         INTEGER       variable         $LOCAL+0
  J         INTEGER       variable         $LOCAL+4
  K         INTEGER       variable         $LOCAL+8
  N         INTEGER       variable         $LOCAL+12
  $LOCAL is 16 bytes
6           N = 0
8           DO I = 1, 10, 1
9             IF (.EQ.:I I 2) CYCLE (loop of line 8)
10            IF (.EQ.:I I 8) EXIT (loop of line 8)
11            N = (+:I N I)
12          END DO
14          OUTER: DO I = 1, 3, 1
15            INNER: DO J = 1, 3, 1
16              IF (.EQ.:I J 2) CYCLE (loop of line 14)
17              IF (.EQ.:I I 3) THEN
18                EXIT (loop of line 14)
19              END IF
20              N = (+:I N 10)
21            END DO INNER
22          END DO OUTER
24          DO 10 I = 1, 4, 1
25            IF (.EQ.:I I 3) CYCLE (loop of line 24)
26    10      N = (+:I N 100)
28          DO 20 I = 1, 2, 1
29            IF (.GT.:I N 0) CYCLE (loop of line 28)
30            N = 0
31    20    END DO
33          K = 0
34          DO WHILE (.LT.:I K 5)
35            K = (+:I K 1)
36            IF (.EQ.:I K 3) CYCLE (loop of line 34)
37            N = (+:I N 1000)
38          END DO
40          K = 0
41          FOREVER: DO
42            K = (+:I K 1)
43            IF (.GE.:I K 4) EXIT (loop of line 41)
44          END DO FOREVER
45          PRINT * N K
46          END
