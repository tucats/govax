	.TITLE	FTN_LISTOUT - FTNRTL's list-directed output
	.IDENT	/V1.0/
;
; List-directed output: PRINT *, WRITE (u,*), and TYPE *, whose values
; are written in formats the type of each one chooses rather than a FORMAT
; statement's (the 1988 VAX FORTRAN Language Reference Manual, 7.3.1.2).
; FTN_STATEMENT begins and ends the statement, and calls this module's
; three routines, each given the statement's context (whose fields
; FTN_STATEMENT describes): FTN$$LIST_START at its begin call,
; FTN$$LIST_ITEM for each item, and FTN$$LIST_END at its end. The record
; is built in the context, so that a statement a function does for one of
; the items builds its own.
;
; An item's argument is a descriptor (the VAX calling standard's): of a
; scalar (class S), whose data type says how it's written, or of a whole
; array (class A), whose elements are written one after another, in
; storage order. The formats are the manual's Table 7-1:
;
;	BYTE, LOGICAL*1	(DSC$K_DTYPE_BU)	I5		"   42"
;	LOGICAL*2	(DSC$K_DTYPE_WU)	L2		" T" or " F"
;	LOGICAL*4	(DSC$K_DTYPE_LU)	L2		" T" or " F"
;	INTEGER*2	(DSC$K_DTYPE_W)		I7		"     42"
;	INTEGER*4	(DSC$K_DTYPE_L)		I12		"          42"
;	REAL*4		(DSC$K_DTYPE_F)		1PG15.7E2	"   3.400000    "
;	REAL*8		(DSC$K_DTYPE_D)		1PG24.16E2
;	REAL*8		(DSC$K_DTYPE_G)		1PG24.15E3	with /G_FLOATING
;	REAL*16		(DSC$K_DTYPE_H)		1PG43.33E4
;	COMPLEX*8	(DSC$K_DTYPE_FC)	'(',1PG14.7E2,',',1PG14.7E2,')'
;	COMPLEX*16	(DSC$K_DTYPE_DC)	'(',1PG23.16E2,',',1PG23.16E2,')'
;	COMPLEX*16	(DSC$K_DTYPE_GC)	'(',1PG23.15E3,',',1PG23.15E3,')'
;						with /G_FLOATING
;	CHARACTER	(DSC$K_DTYPE_T)		An		the text itself
;
; A complex value is written "with no embedded spaces" (7.3.1.2): each
; part's G field without its leading and trailing blanks, so (1.0,2.0) is
; " (1.000000,2.000000)". The blank before it is govax's, so that it
; begins with a blank as every other numeric format's field does, and is
; kept apart from the value before it. Its field is put as any other
; value's, never split across records, though the manual allows a split
; after the comma. Both are govax's choices, unconfirmed.
;
; A record is at most 80 bytes long, its first the carriage control, a
; blank (a new line). FTN$$LIST_START begins a record with that blank; each
; value goes at the record's end, unless it doesn't fit there, when the
; record is written and the value begins the next; FTN$$LIST_END writes
; the last record. A record that RMS can't write is the statement's error,
; FOR$_ERRDURWRI, and what is left of the statement writes nothing. So a statement writes at least one record, and a value is
; never split across records, but for a character value longer than a
; record, which begins a record and fills as many as it needs. The
; record length (80), the values following one another with no blank
; between them beyond their fields' own, and a character value's start
; on a fresh record are govax's choices, unconfirmed.
;
; G editing (8.3.6.4, Table 8-2), Gw.dEe, writes a value whose magnitude,
; rounded to d significant digits, is from 0.1 up to 10**d in F form, in
; the field's first w-(e+2) columns with d significant digits, followed
; by e+2 blanks; any other in E form, where the scale factor 1P (8.3.7)
; puts one digit before the point and d after it, and the exponent has e
; digits after its sign. Zero is below 0.1, so it is E form too (govax's
; reading, unconfirmed). For REAL*4's 1PG15.7E2:
;
;	3.4		"   3.400000    "	F form: 1 digit, then 6
;	1234567.0	"   1234567.    "	F form: 7 digits, then none
;	0.25		"  0.2500000    "	F form: 0 digits, then 7
;	0.0009765625	"  9.7656250E-04"	E form
;	1.0E-5		"  9.9999997E-06"	E form: the F_floating value
;						nearest 10**-5 is below it
;	0.0		"  0.0000000E+00"	E form
;
; and the other types' are the same with their own widths and digits:
; 0.1D0 is "  0.1000000000000000    " as a REAL*8 in D_floating.
;
; The digits come from LIBRTL's OTS$$CVT_F_T_R8 (and its D, G, and H
; forms), the routines VMS's own FORTRAN run-time library uses, which writes a value's decimal digits,
; rounded to as many significant digits as asked, into its caller's
; frame (internal/librtl/otscvtfor.go has its interface).
;
	$SSDEF				; SS$_NORMAL, SS$_BADPARAM

; The descriptor's fields and codes (the VAX calling standard's; govax's
; STARLET has no $DSCDEF yet).
DSC$W_LENGTH	= 0			; the length, in bytes
DSC$B_DTYPE	= 2			; the data type
DSC$B_CLASS	= 3			; the class
DSC$A_POINTER	= 4			; the data's address
DSC$L_ARSIZE	= 12			; an array's size in bytes
DSC$K_DTYPE_BU	= 2			; byte logical
DSC$K_DTYPE_WU	= 3			; word logical
DSC$K_DTYPE_LU	= 4			; longword logical
DSC$K_DTYPE_W	= 7			; word integer
DSC$K_DTYPE_L	= 8			; longword integer
DSC$K_DTYPE_F	= 10			; F_floating
DSC$K_DTYPE_D	= 11			; D_floating
DSC$K_DTYPE_FC	= 12			; F_floating complex
DSC$K_DTYPE_DC	= 13			; D_floating complex
DSC$K_DTYPE_T	= 14			; text
DSC$K_DTYPE_G	= 27			; G_floating
DSC$K_DTYPE_H	= 28			; H_floating
DSC$K_DTYPE_GC	= 29			; G_floating complex
DSC$K_CLASS_S	= 1			; a scalar or fixed-length string
DSC$K_CLASS_A	= 4			; an array

RECORD_MAX	= 80			; a record's length, at most

; The statement's context's fields this module uses (FTN_STATEMENT's).
CTX_STATUS	= 16			; long: the first error's condition, or 0
CTX_STREAM	= 20			; long: the unit's stream (FTN_UNITS)
CTX_RECLEN	= 24			; long: the bytes in the record so far
CTX_RECORD	= 28			; the record being built

FOR$_ERRDURWRI	= ^X00188134		; FORRTL's condition: a write failed

	.PSECT	$FTN_CODE,EXE,NOWRT,PIC,SHR,LONG

;
; FTN$$LIST_START(context)
;
; Starts a list-directed output statement's first record.
;
	.ENTRY	FTN$$LIST_START,^M<>
	PUSHL	4(AP)
	CALLS	#1,NEW_RECORD
	RET

;
; FTN$$LIST_ITEM(context, desc)
;
; Writes one output item, a scalar or a whole array, described by desc.
;
	.ENTRY	FTN$$LIST_ITEM,^M<R2,R3,R4,R5,R6>
	MOVL	4(AP),R6		; the context
	MOVL	8(AP),R5		; the descriptor
	MOVZWL	DSC$W_LENGTH(R5),R2	; an element's length
	MOVL	DSC$A_POINTER(R5),R3	; the first element
	MOVL	#1,R4			; how many: one, for a scalar
	CMPB	DSC$B_CLASS(R5),#DSC$K_CLASS_A
	BNEQ	10$
	TSTL	R2			; an array of no bytes: nothing
	BEQL	90$
	DIVL3	R2,DSC$L_ARSIZE(R5),R4	; the array's elements
	BEQL	90$
10$:	PUSHL	R6			; each element: the context,
	PUSHL	R2			;  its length,
	PUSHL	R3			;  its address,
	MOVZBL	DSC$B_DTYPE(R5),-(SP)	;  and its type
	CALLS	#4,PUT_VALUE
	ADDL2	R2,R3			; the next element
	SOBGTR	R4,10$
90$:	RET

;
; FTN$$LIST_END(context)
;
; Ends a list-directed output statement: writes the last record.
;
	.ENTRY	FTN$$LIST_END,^M<>
	PUSHL	4(AP)
	CALLS	#1,PUT_RECORD
	RET

;
; NEW_RECORD(context): starts a record with its carriage control, a blank.
;
NEW_RECORD:
	.WORD	^M<>
	MOVL	4(AP),R0
	MOVB	#^A/ /,CTX_RECORD(R0)
	MOVL	#1,CTX_RECLEN(R0)
	RET

;
; PUT_RECORD(context): writes the record built so far, and starts the
; next. Nothing is written once the statement has failed; a write that
; fails is the statement's error.
;
PUT_RECORD:
	.WORD	^M<R2>
	MOVL	4(AP),R2
	TSTL	CTX_STATUS(R2)
	BNEQ	10$
	PUSHL	CTX_RECLEN(R2)
	PUSHAB	CTX_RECORD(R2)
	PUSHL	CTX_STREAM(R2)
	CALLS	#3,FTN$$UNIT_PUT	; FTN_UNITS
	BLBS	R0,10$
	MOVL	#FOR$_ERRDURWRI,CTX_STATUS(R2)
10$:	PUSHL	R2
	CALLS	#1,NEW_RECORD
	RET

;
; PUT_FIELD(context, address, length): puts one value's field, length
; bytes at address, at the record's end, after writing the record first if
; the field doesn't fit there (and the record holds a value already).
;
PUT_FIELD:
	.WORD	^M<R2,R3,R4,R5,R6>
	MOVL	4(AP),R6		; the context
	ADDL3	CTX_RECLEN(R6),12(AP),R0 ; the record's length with the field
	CMPL	R0,#RECORD_MAX
	BLEQ	10$			; it fits
	CMPL	CTX_RECLEN(R6),#1
	BLEQ	10$			; a record of its own, then
	PUSHL	R6
	CALLS	#1,PUT_RECORD
10$:	MOVAB	CTX_RECORD(R6),R3
	ADDL2	CTX_RECLEN(R6),R3	; where the field goes
	ADDL2	12(AP),CTX_RECLEN(R6)
	MOVC3	12(AP),@8(AP),(R3)	; MOVC3 changes R0 to R5
	RET

;
; PUT_TEXT(context, address, length): puts a character value at the
; record's end. One that doesn't fit begins a new record, and one longer
; than a record fills as many as it needs, the last left for what follows.
;
PUT_TEXT:
	.WORD	^M<R2,R3,R4,R5,R6,R7,R8>
	MOVL	4(AP),R8		; the context
	MOVL	8(AP),R6		; the text not yet put
	MOVL	12(AP),R7		; and its length
	ADDL3	CTX_RECLEN(R8),R7,R0
	CMPL	R0,#RECORD_MAX
	BLEQ	10$			; it fits
	CMPL	CTX_RECLEN(R8),#1
	BLEQ	10$			; nothing in the record yet
	PUSHL	R8
	CALLS	#1,PUT_RECORD
10$:	TSTL	R7			; any text left?
	BLEQ	90$
	SUBL3	CTX_RECLEN(R8),#RECORD_MAX,R2 ; the record's room
	CMPL	R7,R2
	BGEQ	20$
	MOVL	R7,R2			; the rest, if less
20$:	MOVAB	CTX_RECORD(R8),R3
	ADDL2	CTX_RECLEN(R8),R3
	ADDL2	R2,CTX_RECLEN(R8)
	SUBL2	R2,R7
	PUSHL	R2			; MOVC3 changes R2; keep the count
	MOVC3	R2,(R6),(R3)
	ADDL2	(SP)+,R6		; past the text put
	TSTL	R7
	BLEQ	90$			; that was the end of it
	PUSHL	R8
	CALLS	#1,PUT_RECORD		; the record is full
	BRB	10$
90$:	RET

;
; PUT_VALUE(type, address, length, context): puts one value, of data
; type type (a DSC$K_DTYPE_ code), length bytes at address, in its
; list-directed format, in the record of the statement whose context is
; given. A type FTNRTL can't write ends the image with SS$_BADPARAM.
;
; The routine works in a frame of its own (below FP, made by subtracting
; from SP): OTS$$CVT_x_T_R8 reads its arguments and writes its results at
; fixed offsets from the FP it is given, the first seven of these; the
; rest are this routine's own.
;
CVT_KIND	= -9			; byte: 0 for E editing's rounding
CVT_SIGNIF	= -16			; the significant digits to round to
CVT_BUFFER	= -20			; the digit buffer's address
CVT_SIGN	= -24			; out: 1, -1, or 0 for zero
CVT_EXPONENT	= -28			; out: the value is 0.ddd x 10**this
CVT_FIRST	= -32			; out: the first digit's offset
CVT_FDIGITS	= -36			; F editing's digits (not used here)
DIGITS		= -76			; the digit buffer, 40 bytes: a guard
DIGITS_LEN	= 40			;  digit and REAL*16's 34 digits
FIELD		= -124			; the field being formatted, 48 bytes
FIELD_DESC	= -132			; a descriptor of FIELD
FMT_W		= -136			; a floating format's width, w,
FMT_D		= -140			;  its significant digits, d,
FMT_E		= -144			;  its exponent's digits, e,
FMT_KIND	= -148			;  and which OTS$$CVT_x_T_R8: 0 F,
					;  1 D, 2 G, 3 H
CTEXT		= -200			; a complex value's text, 52 bytes
CTEXT_LEN	= -204			;  and its length so far
FRAME_SIZE	= 204

PUT_VALUE:
	.WORD	^M<R2,R3,R4,R5,R6,R7,R8,R9,R10>
	SUBL2	#FRAME_SIZE,SP		; the frame's local storage
	MOVL	8(AP),R6		; the value
	CMPB	4(AP),#DSC$K_DTYPE_G	; G and H are past the table
	BNEQ	1$
	BRW	REAL_G
1$:	CMPB	4(AP),#DSC$K_DTYPE_H
	BNEQ	2$
	BRW	REAL_H
2$:	CMPB	4(AP),#DSC$K_DTYPE_GC
	BNEQ	3$
	BRW	COMPLEX_G
3$:	CASEB	4(AP),#DSC$K_DTYPE_BU,#<DSC$K_DTYPE_T-DSC$K_DTYPE_BU>
10$:	.WORD	BYTE_I5-10$		; 2: BU
	.WORD	LOGICAL-10$		; 3: WU
	.WORD	LOGICAL-10$		; 4: LU
	.WORD	BAD_TYPE-10$		; 5
	.WORD	BAD_TYPE-10$		; 6
	.WORD	WORD_I7-10$		; 7: W
	.WORD	LONG_I12-10$		; 8: L
	.WORD	BAD_TYPE-10$		; 9
	.WORD	REAL_F-10$		; 10: F
	.WORD	REAL_D-10$		; 11: D
	.WORD	COMPLEX_F-10$		; 12: FC
	.WORD	COMPLEX_D-10$		; 13: DC
	.WORD	TEXT-10$		; 14: T
BAD_TYPE:
	PUSHL	#SS$_BADPARAM
	CALLS	#1,G^LIB$STOP		; never returns

;
; L2: a blank, then T or F by the value's bit 0 (the manual's C.4: only
; the low bit of a LOGICAL is defined). BIT looks at the first byte alone,
; which every length of LOGICAL has; BLBC would read a longword.
;
LOGICAL:
	MOVB	#^A/ /,FIELD(FP)
	MOVB	#^A/F/,FIELD+1(FP)
	BITB	#1,(R6)
	BEQL	10$
	MOVB	#^A/T/,FIELD+1(FP)
10$:	PUSHL	#2
	BRW	PUT_THE_FIELD

;
; I5, I7, and I12: OTS$CVT_L_TI writes the integer, R7 bytes long,
; right-justified in a field of R8 columns, with blanks before it. Its
; third argument is the fewest digits to write. No value of a type is too
; long for its field.
;
BYTE_I5:
	MOVL	#1,R7
	MOVL	#5,R8
	BRB	INTEGER
WORD_I7:
	MOVL	#2,R7
	MOVL	#7,R8
	BRB	INTEGER
LONG_I12:
	MOVL	#4,R7
	MOVL	#12,R8
INTEGER:
	BISL3	R8,#<DSC$K_CLASS_S@24>!<DSC$K_DTYPE_T@16>,FIELD_DESC(FP)
	MOVAB	FIELD(FP),FIELD_DESC+DSC$A_POINTER(FP)
	PUSHL	R7
	PUSHL	#1
	PUSHAB	FIELD_DESC(FP)
	PUSHL	R6
	CALLS	#4,G^OTS$CVT_L_TI
	BLBS	R0,10$
	PUSHL	R0			; can't happen: each field is room enough
	CALLS	#1,G^LIB$STOP
10$:	PUSHL	R8
	BRW	PUT_THE_FIELD

;
; A character value: the text itself.
;
TEXT:
	PUSHL	12(AP)
	PUSHL	R6
	PUSHL	16(AP)			; the context
	CALLS	#3,PUT_TEXT
	RET

;
; The floating types, G editing as the module's introduction describes:
; each type's format sets the field's width (FMT_W), its significant
; digits (FMT_D), its exponent's digits (FMT_E), and which routine gives
; its digits (FMT_KIND), and goes on at REAL, which has FORMAT_REAL make
; the field.
;
REAL_F:	MOVL	#15,FMT_W(FP)		; 1PG15.7E2
	MOVL	#7,FMT_D(FP)
	MOVL	#2,FMT_E(FP)
	CLRL	FMT_KIND(FP)
	BRB	REAL
REAL_D:	MOVL	#24,FMT_W(FP)		; 1PG24.16E2
	MOVL	#16,FMT_D(FP)
	MOVL	#2,FMT_E(FP)
	MOVL	#1,FMT_KIND(FP)
	BRB	REAL
REAL_G:	MOVL	#24,FMT_W(FP)		; 1PG24.15E3
	MOVL	#15,FMT_D(FP)
	MOVL	#3,FMT_E(FP)
	MOVL	#2,FMT_KIND(FP)
	BRB	REAL
REAL_H:	MOVL	#43,FMT_W(FP)		; 1PG43.33E4
	MOVL	#33,FMT_D(FP)
	MOVL	#4,FMT_E(FP)
	MOVL	#3,FMT_KIND(FP)
REAL:	BSBW	FORMAT_REAL
	PUSHL	FMT_W(FP)
	BRW	PUT_THE_FIELD

;
; The complex types: each part's G field, as REAL's, with its blanks taken
; out (PART), between " (", ",", and ")" in CTEXT, and that put as one
; field. The parts' length is half the value's, 12(AP).
;
COMPLEX_F:
	MOVL	#14,FMT_W(FP)		; 1PG14.7E2
	MOVL	#7,FMT_D(FP)
	MOVL	#2,FMT_E(FP)
	CLRL	FMT_KIND(FP)
	BRB	COMPLEX
COMPLEX_D:
	MOVL	#23,FMT_W(FP)		; 1PG23.16E2
	MOVL	#16,FMT_D(FP)
	MOVL	#2,FMT_E(FP)
	MOVL	#1,FMT_KIND(FP)
	BRB	COMPLEX
COMPLEX_G:
	MOVL	#23,FMT_W(FP)		; 1PG23.15E3
	MOVL	#15,FMT_D(FP)
	MOVL	#3,FMT_E(FP)
	MOVL	#2,FMT_KIND(FP)
COMPLEX:
	MOVW	#^A/ (/,CTEXT(FP)
	MOVL	#2,CTEXT_LEN(FP)
	BSBW	PART			; the real part
	MOVL	CTEXT_LEN(FP),R0
	MOVB	#^A/,/,CTEXT(FP)[R0]
	INCL	CTEXT_LEN(FP)
	DIVL3	#2,12(AP),R0		; a part's length
	ADDL2	R0,R6			; the imaginary part
	BSBW	PART
	MOVL	CTEXT_LEN(FP),R0
	MOVB	#^A/)/,CTEXT(FP)[R0]
	INCL	CTEXT_LEN(FP)
	PUSHL	CTEXT_LEN(FP)
	PUSHAB	CTEXT(FP)
	PUSHL	16(AP)			; the context
	CALLS	#3,PUT_FIELD
	RET

;
; PART, a subroutine of PUT_VALUE: the part at R6 in its G field, then
; the field's characters, from its first that isn't a blank to the blank
; after them (a G field has none between), added to CTEXT.
;
PART:	BSBW	FORMAT_REAL
	SKPC	#^A/ /,FMT_W(FP),FIELD(FP) ; R0: the bytes from the first
	MOVQ	R0,R2			;  that isn't a blank, R1: its address
	LOCC	#^A/ /,R2,(R3)		; R0: the bytes from the blank after
	SUBL3	R0,R2,R0		; the characters' length
	MOVL	CTEXT_LEN(FP),R1
	ADDL2	R0,CTEXT_LEN(FP)
	MOVC3	R0,(R3),CTEXT(FP)[R1]
	RSB

;
; FORMAT_REAL, a subroutine of PUT_VALUE (BSBW, RSB, in its frame): the
; value at R6 in FIELD(FP), G edited in the format FMT_W(FP) to
; FMT_KIND(FP) say, FMT_W(FP) bytes long. Changes R0 to R5 and R7 to R10.
;
FORMAT_REAL:
	MOVC5	#0,(SP),#^A/ /,FMT_W(FP),FIELD(FP) ; w blanks
	;
	; The digits rounded to d significant ones tell which form: F, for
	; a magnitude from 0.1 (0.1 x 10**0) to under 10**d (0.1 x
	; 10**(d+1)). Zero's sign is 0, and its digits are all zeros: E form,
	; the first digit at offset 0, 0.0 x 10**1, so E+00.
	;
	MOVL	FMT_D(FP),R0
	BSBW	DIGITS_OF
	TSTL	CVT_SIGN(FP)
	BNEQ	10$
	CLRL	R7
	MOVL	#1,R8
	BRW	E_FORM
10$:	CMPL	R8,FMT_D(FP)
	BLEQU	F_FORM			; an exponent from 0 to d
	BRW	E_DIGITS
	;
	; F form in the field's first w-(e+2) columns, right-justified: the
	; d digits, R8 of them before the point (or a 0, for none), the rest
	; after it, and a minus sign before them all for a negative value.
	; R10 is the column of the leftmost character written so far (MOVC3
	; changes R0 to R5, so nothing it needs after is kept in those).
	;
F_FORM:	SUBL3	R8,FMT_D(FP),R9		; the digits after the point
	ADDL3	#2,FMT_E(FP),R10
	SUBL3	R10,FMT_W(FP),R10	; the F form's last column, plus 1
	SUBL2	R9,R10			; where the digits after the point start
	ADDL3	R7,R8,R0		; the first of them in the buffer
	MOVC3	R9,DIGITS(FP)[R0],FIELD(FP)[R10]
	DECL	R10
	MOVB	#^A/./,FIELD(FP)[R10]
	TSTL	R8			; digits before the point?
	BNEQ	20$
	DECL	R10			; no: a 0
	MOVB	#^A/0/,FIELD(FP)[R10]
	BRB	30$
20$:	SUBL2	R8,R10
	MOVC3	R8,DIGITS(FP)[R7],FIELD(FP)[R10]
30$:	TSTL	CVT_SIGN(FP)
	BGEQ	40$
	DECL	R10
	MOVB	#^A/-/,FIELD(FP)[R10]
40$:	RSB
	;
	; E form: the digits again, rounded to d+1 significant ones this
	; time, then "sd.ddd...Esxx" right-justified in the w columns: the
	; first digit before the point, d after it, and the exponent, e
	; digits, one less than OTS$'s, since the point is after the first
	; digit rather than before it. R10 is the first digit's column,
	; w-(d+e+4).
	;
E_DIGITS:
	ADDL3	#1,FMT_D(FP),R0
	BSBW	DIGITS_OF
E_FORM:	ADDL3	FMT_D(FP),FMT_E(FP),R10
	SUBL3	R10,FMT_W(FP),R10
	SUBL2	#4,R10
	MOVB	DIGITS(FP)[R7],FIELD(FP)[R10]
	MOVB	#^A/./,FIELD+1(FP)[R10]
	INCL	R7
	ADDL3	#2,R10,R9
	MOVC3	FMT_D(FP),DIGITS(FP)[R7],FIELD(FP)[R9]
	TSTL	CVT_SIGN(FP)
	BGEQ	10$
	MOVB	#^A/-/,FIELD-1(FP)[R10]
10$:	SUBL3	FMT_E(FP),FMT_W(FP),R10
	SUBL2	#2,R10			; the E's column
	MOVB	#^A/E/,FIELD(FP)[R10]
	MOVB	#^A/+/,FIELD+1(FP)[R10]
	DECL	R8			; the exponent shown
	BGEQ	20$
	MOVB	#^A/-/,FIELD+1(FP)[R10]
	MNEGL	R8,R8
20$:	SUBL3	#1,FMT_W(FP),R10	; the last column
	MOVL	FMT_E(FP),R9		; the exponent's digits, the last first
30$:	MOVL	R8,R2			; R2:R3 as a quadword, for EDIV
	CLRL	R3
	EDIV	#10,R2,R8,R1		; the rest in R8, this digit in R1
	ADDB3	#^A/0/,R1,FIELD(FP)[R10]
	DECL	R10
	SOBGTR	R9,30$
	RSB

;
; Every format but A and complex ends here, the field's length on the
; stack.
;
PUT_THE_FIELD:
	PUSHAB	FIELD(FP)
	PUSHL	16(AP)			; the context
	CALLS	#3,PUT_FIELD
	RET

;
; DIGITS_OF, a subroutine of PUT_VALUE (BSBW, RSB, in its frame): the
; value at R6 in the digit buffer, rounded to R0 significant digits, by
; the routine for its format, FMT_KIND(FP). On return R7 is the first
; digit's offset in the buffer and R8 the decimal exponent; CVT_SIGN(FP)
; is the sign. OTS$$CVT_x_T_R8 may change R0 to R6, so the value's
; address is put back in R6 after it.
;
DIGITS_OF:
	CLRB	CVT_KIND(FP)		; E editing's rounding
	MOVL	R0,CVT_SIGNIF(FP)
	MOVAB	DIGITS(FP),CVT_BUFFER(FP)
	CLRL	CVT_FDIGITS(FP)
	CLRL	CVT_SIGN(FP)
	MOVL	R6,-(SP)		; keep the value's address
	MOVL	R6,R0			; the value
	MOVL	FP,R1			; the frame
	MOVL	#DIGITS_LEN,R2		; the buffer's size
	CASEL	FMT_KIND(FP),#0,#3
10$:	.WORD	20$-10$			; 0: F
	.WORD	30$-10$			; 1: D
	.WORD	40$-10$			; 2: G
	.WORD	50$-10$			; 3: H
20$:	JSB	G^OTS$$CVT_F_T_R8
	BRB	90$
30$:	JSB	G^OTS$$CVT_D_T_R8
	BRB	90$
40$:	JSB	G^OTS$$CVT_G_T_R8
	BRB	90$
50$:	JSB	G^OTS$$CVT_H_T_R8
90$:	MOVL	(SP)+,R6
	MOVL	CVT_FIRST(FP),R7
	MOVL	CVT_EXPONENT(FP),R8
	RSB

	.END
