	.TITLE	FTN_INTRINSICS - FTNRTL's intrinsic functions
	.IDENT	/V1.0/
;
; The intrinsic functions (the 1988 Language Reference Manual, 6.3 and
; Table D-3) that MTHRTL, the VMS mathematics library, hasn't: ISHFTC,
; which a compiled program calls since no instruction or two does it, and
; the functions a program writes in line but may also pass as an actual
; argument (section 4.9), which the routine given one calls. Each routine
; here is named for its function's specific name under FTN$.
;
; Each is called as a FORTRAN function is, with CALLS: its arguments by
; reference (the argument list holds their addresses), a CHARACTER one by
; descriptor (the address of a descriptor: its length a word at 0, the
; text's address at 4), its value in R0, or R0 and R1. A CHARACTER or
; REAL*16 value goes through a hidden first argument instead, the
; address of the result's descriptor or of its place.
;
; A routine called through an argument can't see its argument's type,
; and a few of these functions take more than one (Table D-3): CHAR reads
; a byte, and IZEXT and JZEXT a word, the low part of any longer value,
; since the VAX keeps a value's low bytes first.
;
; The MACRO and VAX conventions these lines rely on are explained once,
; in FTN_VECTOR.MAR's "Reading these sources".
;
	$DSCDEF				; descriptors' fields

	.PSECT	$FTN_CODE,EXE,NOWRT,PIC,SHR,LONG

;
; value = FTN$JISHFTC(i, shift, size)
; value = FTN$IISHFTC(i, shift, size)
;
; ISHFTC, the circular shift (Table D-3 and section D.5.2): the rightmost
; SIZE bits of I shifted SHIFT places to the left (-SHIFT to the right),
; the bits shifted out at one end coming back in at the other; I's other
; bits are as they were. JISHFTC's arguments are INTEGER*4, IISHFTC's
; INTEGER*2; both return an INTEGER*4, as Table D-3 prints it, IISHFTC's
; the word it computes, sign-extended (Phase 78's survey, the author's
; answer 3). SIZE must be from 1 to the integer's bits, and SHIFT's
; magnitude at most SIZE; I is returned as it is for a SIZE less than 1.
;
	.ENTRY	FTN$JISHFTC,^M<R2,R3,R4,R5,R6,R7>
	MOVL	@4(AP),R0		; I
	MOVL	@8(AP),R1		; SHIFT
	MOVL	@12(AP),R2		; SIZE
	BSBB	CIRCULAR
	RET

	.ENTRY	FTN$IISHFTC,^M<R2,R3,R4,R5,R6,R7>
	MOVZWL	@4(AP),R0		; I, a word, the longword's high bits clear
	CVTWL	@8(AP),R1		; SHIFT
	CVTWL	@12(AP),R2		; SIZE
	BSBB	CIRCULAR
	CVTWL	R0,R0			; the word, sign-extended
	RET

;
; CIRCULAR shifts the low R2 bits of R0 R1 places to the left, circularly,
; changing R1 and R3 to R7.
;
; A shift to the right is the shift of SIZE less that to the left, and a
; shift of SIZE none. The field F is written twice side by side in the
; quadword R4:R5, F above F; SIZE bits of that, from bit SIZE-SHIFT, are F
; rotated SHIFT places to the left, which INSV puts back in R0's field.
; EXTZV takes a field from a register and the one after it when the field
; doesn't end in the first, as long as it starts in the first: SIZE-SHIFT
; is from 1 to 31, since a shift of none has returned already.
;
CIRCULAR:
	TSTL	R2			; a size of 1 or more?
	BLEQ	30$			; no: I as it is
	TSTL	R1			; a shift to the right
	BGEQ	10$
	ADDL2	R2,R1			; is one of SIZE less to the left
10$:	CMPL	R1,R2			; a shift of SIZE
	BLSS	20$
	SUBL2	R2,R1			; is none
20$:	TSTL	R1
	BEQL	30$			; no shift: I as it is
	EXTZV	#0,R2,R0,R4		; F, its high bits clear
	CLRL	R5
	ASHQ	R2,R4,R6		; F shifted left SIZE places
	BISL2	R6,R4			; F twice, side by side, in R4:R5
	BISL2	R7,R5
	SUBL3	R1,R2,R3		; SIZE-SHIFT
	EXTZV	R3,R2,R4,R3		; F rotated SHIFT places to the left
	INSV	R3,#0,R2,R0		; back in I's field
30$:	RSB

;
; length = FTN$LEN(string)
;
; LEN: a CHARACTER value's length, from its descriptor.
;
	.ENTRY	FTN$LEN,^M<>
	MOVZWL	@4(AP),R0		; DSC$W_LENGTH, an unsigned word
	RET

;
; position = FTN$INDEX(string, substring)
;
; INDEX: where SUBSTRING first is in STRING, counted from 1, or 0 if it
; isn't. MATCHC leaves in R2 the bytes of STRING after the match, so the
; match starts at LEN(STRING)+1-LEN(SUBSTRING)-R2. An empty SUBSTRING
; matches at once, at 1.
;
	.ENTRY	FTN$INDEX,^M<R2,R3,R6,R7>
	MOVL	4(AP),R6		; STRING's descriptor
	MOVL	8(AP),R7		; SUBSTRING's
	MATCHC	(R7),@4(R7),(R6),@4(R6)
	BNEQ	10$			; no match
	MOVZWL	(R6),R0
	INCL	R0
	MOVZWL	(R7),R1
	SUBL2	R1,R0
	SUBL2	R2,R0
	RET
10$:	CLRL	R0
	RET

;
; code = FTN$ICHAR(string)
;
; ICHAR: the code of a CHARACTER value's first character, from 0 to 255.
;
	.ENTRY	FTN$ICHAR,^M<>
	MOVL	4(AP),R0		; the descriptor
	MOVZBL	@4(R0),R0		; the first byte of its text
	RET

;
; CALL FTN$CHAR(result, code)
;
; CHAR: the character whose code is CODE's low byte, the first of the
; text RESULT's descriptor describes. Table D-3's argument is from 0 to
; 255, of any integer or LOGICAL*1 type.
;
	.ENTRY	FTN$CHAR,^M<>
	MOVL	4(AP),R0		; the result's descriptor
	MOVB	@8(AP),@4(R0)
	RET

;
; truth = FTN$LLT(string1, string2), FTN$LLE, FTN$LGT, FTN$LGE
;
; The lexical comparisons (section 6.3.2.2): .TRUE. (-1) if STRING1 is
; less than (less than or equal to, greater than, greater than or equal
; to) STRING2 in ASCII's order, the shorter compared as though blanks
; followed it, and .FALSE. (0) if not. CMPC5 compares unsigned bytes and
; sets the condition codes as an unsigned comparison does, which BSBB,
; RSB, and the branches leave as they are.
;
	.ENTRY	FTN$LLT,^M<R2,R3>
	BSBB	COMPARE
	BLSSU	TRUE
	BRB	FALSE

	.ENTRY	FTN$LLE,^M<R2,R3>
	BSBB	COMPARE
	BLEQU	TRUE
	BRB	FALSE

	.ENTRY	FTN$LGT,^M<R2,R3>
	BSBB	COMPARE
	BGTRU	TRUE
	BRB	FALSE

	.ENTRY	FTN$LGE,^M<R2,R3>
	BSBB	COMPARE
	BGEQU	TRUE
FALSE:	CLRL	R0
	RET
TRUE:	MNEGL	#1,R0
	RET

;
; COMPARE compares the strings the argument list's first two descriptors
; describe, changing R0 to R3.
;
COMPARE:
	MOVL	4(AP),R0
	MOVL	8(AP),R1
	CMPC5	(R0),@4(R0),#^A/ /,(R1),@4(R1)
	RSB

;
; truth = FTN$BJTEST(i, pos)
; truth = FTN$BITEST(i, pos)
;
; BTEST: .TRUE. (-1) if bit POS of I is set, .FALSE. (0) if it is clear.
; BJTEST's arguments are INTEGER*4, BITEST's INTEGER*2, and BITEST's
; LOGICAL*2 value is R0's low word. POS must be less than I's bits.
;
	.ENTRY	FTN$BJTEST,^M<>
	MOVL	@8(AP),R1		; POS
	BRB	BIT_TEST

	.ENTRY	FTN$BITEST,^M<>
	CVTWL	@8(AP),R1		; POS
BIT_TEST:
	CLRL	R0
	BBC	R1,@4(AP),10$		; the bit, in I's bytes
	MNEGL	#1,R0
10$:	RET

;
; field = FTN$JIBITS(i, pos, len)
; field = FTN$IIBITS(i, pos, len)
;
; IBITS: the LEN bits of I from bit POS, zero-extended. JIBITS's arguments
; are INTEGER*4, IIBITS's INTEGER*2; both return an INTEGER*4, as Table
; D-3 prints it, IIBITS's the word it computes, sign-extended (Phase 78's
; survey, the author's answer 3). POS+LEN must be at most I's bits.
;
	.ENTRY	FTN$JIBITS,^M<>
	EXTZV	@8(AP),@12(AP),@4(AP),R0
	RET

	.ENTRY	FTN$IIBITS,^M<>
	CVTWL	@8(AP),R1		; POS
	EXTZV	R1,@12(AP),@4(AP),R0	; LEN, a byte: the word's low byte
	CVTWL	R0,R0			; the word, sign-extended
	RET

;
; value = FTN$JIBSET(i, pos)
; value = FTN$IIBSET(i, pos)
; value = FTN$JIBCLR(i, pos)
; value = FTN$IIBCLR(i, pos)
;
; IBSET and IBCLR: I with bit POS set, or clear. The J forms' arguments and
; values are INTEGER*4. IIBSET's are INTEGER*2, its value R0's low word;
; IIBCLR's value is an INTEGER*4, as Table D-3 prints it, the word
; sign-extended. A POS past a word's bits changes R0's high word only, as
; the in-line forms' mask of the word's low bits does nothing.
;
	.ENTRY	FTN$JIBSET,^M<>
	MOVL	@4(AP),R0
	BBSS	@8(AP),R0,10$
10$:	RET

	.ENTRY	FTN$IIBSET,^M<>
	MOVZWL	@4(AP),R0
	CVTWL	@8(AP),R1		; POS
	BBSS	R1,R0,10$
10$:	RET

	.ENTRY	FTN$JIBCLR,^M<>
	MOVL	@4(AP),R0
	BBCC	@8(AP),R0,10$
10$:	RET

	.ENTRY	FTN$IIBCLR,^M<>
	MOVZWL	@4(AP),R0
	CVTWL	@8(AP),R1		; POS
	BBCC	R1,R0,10$
10$:	CVTWL	R0,R0			; the word, sign-extended
	RET

;
; value = FTN$IZEXT(i)
; value = FTN$JZEXT(i)
;
; ZEXT: I's low word, zero-extended, an INTEGER*2 (IZEXT) or INTEGER*4
; (JZEXT). A routine reached through an argument reads a word whatever
; it is given (this module's header).
;
	.ENTRY	FTN$IZEXT,^M<>
	MOVZWL	@4(AP),R0
	RET

	.ENTRY	FTN$JZEXT,^M<>
	MOVZWL	@4(AP),R0
	RET

;
; value = FTN$SNGLQ(q)
; value = FTN$DBLEQ(q)
; value = FTN$GBLEQ(q)
;
; SNGLQ and DBLEQ: a REAL*16 rounded to a REAL*4, or a REAL*8, in R0 (and
; R1): D_floating, or G_floating for DBLEQ under /G_FLOATING, GBLEQ.
;
	.ENTRY	FTN$SNGLQ,^M<>
	CVTHF	@4(AP),R0
	RET

	.ENTRY	FTN$DBLEQ,^M<>
	CVTHD	@4(AP),R0
	RET

	.ENTRY	FTN$GBLEQ,^M<>
	CVTHG	@4(AP),R0
	RET

;
; CALL FTN$QEXT(result, x)
; CALL FTN$QEXTD(result, x)
; CALL FTN$QEXTG(result, x)
; CALL FTN$QFLOAT(result, i)
;
; QEXT, QEXTD, and QFLOAT: a REAL*4, a REAL*8 (D_floating, or G_floating
; for QEXTD under /G_FLOATING, QEXTG), or an INTEGER*4 made a REAL*16,
; exactly, at RESULT. QFLOAT is a generic name, with no specific name for
; any argument (Table D-3); passed, it takes an INTEGER*4.
;
	.ENTRY	FTN$QEXT,^M<>
	CVTFH	@8(AP),@4(AP)
	RET

	.ENTRY	FTN$QEXTD,^M<>
	CVTDH	@8(AP),@4(AP)
	RET

	.ENTRY	FTN$QEXTG,^M<>
	CVTGH	@8(AP),@4(AP)
	RET

	.ENTRY	FTN$QFLOAT,^M<>
	CVTLH	@8(AP),@4(AP)
	RET

;
; count = FTN$NWORKERS()
;
; NWORKERS: the processes running the routine, which is always 1: govax's
; FORTRAN leaves out the parallel processing directives (docs/PHASE-74 -
; FORTRAN plan.md, Decision 1).
;
	.ENTRY	FTN$NWORKERS,^M<>
	MOVL	#1,R0
	RET

;
; CALL FTN$DIVCH(result, x, y)
;
; X / Y for two COMPLEX*32 values, Fortran 90's COMPLEX(16), whose parts
; are H_floating: the quotient at RESULT. It isn't an intrinsic function
; but the operator, which the compiler calls as it calls OTS$DIVC for a
; COMPLEX*8, since OTS$ has no H complex routine (docs/planning/PHASE-100
; - Fortran 90 declarations and kinds.md, subtask 7). Each value is two
; H_floating octawords, the real part first. With X = (a, b) and
; Y = (c, d), the quotient is the manual's
;
;	((a*c + b*d) / (c*c + d*d), (b*c - a*d) / (c*c + d*d))
;
; computed an instruction at a time, each result rounded, which is what
; the compiler's folding of a constant quotient does too
; (vaxfloat.ComplexDivSteps). A Y of (0, 0) divides by zero, SS$_FLTDIV_F,
; and a part too large overflows, SS$_FLTOVF_F; a part too small is 0.
; Everything is read before anything is written, so RESULT may be X or Y.
;
	.ENTRY	FTN$DIVCH,^M<R2,R3,R4,R5,R6,R7,R8,R9>
	MOVQ	8(AP),R8		; R8 -> X, (a, b); R9 -> Y, (c, d)
	SUBL2	#32,SP			; two H_floating values, at 0(SP) and 16(SP)
	MULH3	(R9),(R9),R0		; c*c
	MULH3	16(R9),16(R9),R4	; d*d
	ADDH3	R4,R0,(SP)		; the denominator, c*c + d*d
	MULH3	(R8),(R9),R0		; a*c
	MULH3	16(R8),16(R9),R4	; b*d
	ADDH3	R4,R0,16(SP)		; the real part's numerator
	MULH3	16(R8),(R9),R0		; b*c
	MULH3	(R8),16(R9),R4		; a*d
	SUBH2	R4,R0			; the imaginary part's, b*c - a*d
	MOVL	4(AP),R8		; R8 -> RESULT
	DIVH3	(SP),16(SP),(R8)	; the real part
	DIVH3	(SP),R0,16(R8)		; the imaginary part
	RET				; (RET puts SP back)

;
; Fortran 90's character functions (docs/planning/PHASE-108 - Fortran 90
; intrinsic procedures.md, finding 3): those the compiler doesn't write in
; line. ADJUSTL, ADJUSTR, and REPEAT make a CHARACTER value, into the place
; the first argument's descriptor describes: a temporary of the caller's of
; the value's length, or, for a REPEAT whose length the compiler didn't
; know, an empty dynamic string (class D) that FTN$REPEAT gives storage
; to. SCAN, VERIFY, and INDEX searching back return a position, counted from
; 1, or 0 for none. BACK is a LOGICAL by reference, its low bit the truth.
;
FOR$_BADREPEAT	= ^X18898C		; FOR number 305, severity F

;
; CALL FTN$ADJUSTL(result, string)
;
; ADJUSTL: STRING with its leading blanks moved to its end. SKPC passes
; over the blanks, leaving in R0 the bytes after them and in R1 their
; address; MOVC5 moves those to RESULT and fills the rest with blanks.
;
	.ENTRY	FTN$ADJUSTL,^M<R2,R3,R4,R5>
	MOVL	8(AP),R2		; STRING's descriptor
	SKPC	#^A/ /,(R2),@4(R2)	; past the leading blanks
	MOVL	4(AP),R2		; RESULT's descriptor
	MOVC5	R0,(R1),#^A/ /,(R2),@4(R2)
	RET

;
; CALL FTN$ADJUSTR(result, string)
;
; ADJUSTR: STRING with its trailing blanks moved to its start. TRAILING
; counts the characters before the trailing blanks; RESULT is blanks as
; many as there were, then those characters.
;
	.ENTRY	FTN$ADJUSTR,^M<R2,R3,R4,R5,R6>
	MOVL	8(AP),R6		; STRING's descriptor
	MOVZWL	(R6),R0
	MOVL	4(R6),R1
	BSBB	TRAILING		; R0: the characters to keep
	MOVL	R0,R6			;  kept a while
	MOVL	4(AP),R2		; RESULT's descriptor
	MOVZWL	(R2),R4
	SUBL2	R6,R4			; the blanks
	MOVC5	#0,(R2),#^A/ /,R4,@4(R2) ; the blanks; R3 -> the byte after them
	MOVL	R3,R4
	MOVL	8(AP),R2
	MOVC3	R6,@4(R2),(R4)		; the characters
	RET

;
; TRAILING is LEN_TRIM: the length R0 of the text at R1 less its trailing
; blanks, in R0, from the end back.
;
TRAILING:
10$:	TSTL	R0			; nothing left?
	BEQL	20$
	CMPB	-1(R1)[R0],#^A/ /	; the last character a blank?
	BNEQ	20$
	DECL	R0
	BRB	10$
20$:	RSB

;
; CALL FTN$REPEAT(result, string, ncopies)
;
; REPEAT: NCOPIES (an INTEGER*4) copies of STRING, one after another. An
; NCOPIES less than 0, or a value longer than a descriptor's word can say,
; 65,535 characters, is govax's BADREPEAT (FOR number 305). A dynamic
; RESULT is given its storage, by LIB$SGET1_DD, once the length is known;
; any other is as long as the value.
;
	.ENTRY	FTN$REPEAT,^M<R2,R3,R4,R5,R6,R7,R8,R9>
	MOVL	@12(AP),R7		; NCOPIES
	BLSS	BAD_REPEAT
	MOVL	8(AP),R2		; STRING's descriptor
	MOVZWL	(R2),R8			; its length
	EMUL	R7,R8,#0,R4		; the value's length, in R4:R5
	TSTL	R5
	BNEQ	BAD_REPEAT
	CMPL	R4,#65535
	BGTRU	BAD_REPEAT
	MOVL	4(AP),R6		; RESULT's descriptor
	CMPB	DSC$B_CLASS(R6),#DSC$K_CLASS_D
	BNEQ	10$
	PUSHL	R4			; a dynamic string: room for the value
	PUSHL	R6
	PUSHAW	4(SP)			;  (the length, a word, by reference)
	CALLS	#2,G^LIB$SGET1_DD
	ADDL2	#4,SP
	BLBS	R0,10$
	PUSHL	R0			; no room
	CALLS	#1,G^LIB$STOP
10$:	MOVL	DSC$A_POINTER(R6),R9	; where the next copy goes
	MOVL	8(AP),R2
	MOVL	DSC$A_POINTER(R2),R2	; STRING's text
	MOVL	R2,R6
20$:	TSTL	R7			; another copy?
	BEQL	30$
	MOVC3	R8,(R6),(R9)		; R3 -> the byte after it
	MOVL	R3,R9
	DECL	R7
	BRB	20$
30$:	RET
BAD_REPEAT:
	PUSHL	#FOR$_BADREPEAT
	CALLS	#1,G^LIB$STOP
	RET

;
; position = FTN$SCAN(string, set, back)
; position = FTN$VERIFY(string, set, back)
;
; SCAN: where in STRING a character of SET first is, or with BACK last.
; VERIFY: where a character not in SET first (or last) is. A table of 256
; bytes on the stack, one per character, is 1 for SET's characters and 0
; for the rest; SCANC finds the first byte whose entry is 1, SPANC the
; first whose isn't, and from the back a loop looks at each in turn. The
; two share SEARCH, told which by R9: 1 for SCAN, 0 for VERIFY.
;
	.ENTRY	FTN$SCAN,^M<R2,R3,R4,R5,R6,R7,R8,R9>
	MOVL	#1,R9
	BRB	SEARCH

	.ENTRY	FTN$VERIFY,^M<R2,R3,R4,R5,R6,R7,R8,R9>
	CLRL	R9
SEARCH:	SUBL2	#256,SP			; the table
	MOVC5	#0,(SP),#0,#256,(SP)	; all 0
	MOVL	8(AP),R2		; SET's descriptor
	MOVZWL	(R2),R7
	MOVL	DSC$A_POINTER(R2),R8
10$:	TSTL	R7			; each of SET's characters
	BEQL	20$
	MOVZBL	(R8)+,R0
	MOVB	#1,(SP)[R0]		;  is 1 in the table
	DECL	R7
	BRB	10$
20$:	MOVL	4(AP),R2		; STRING's descriptor
	MOVZWL	(R2),R6			; its length
	MOVL	DSC$A_POINTER(R2),R7	; its text
	BLBS	@12(AP),50$		; BACK?
	TSTL	R9
	BEQL	30$
	SCANC	R6,(R7),(SP),#1		; SCAN: the first in SET
	BRB	40$
30$:	SPANC	R6,(R7),(SP),#1		; VERIFY: the first not in it
40$:	TSTL	R0			; R0: the bytes from it on, 0 if none
	BEQL	70$
	SUBL3	R0,R6,R0		; the bytes before it,
	INCL	R0			;  and 1, its position
	RET				; (RET puts SP back)
50$:	TSTL	R6			; from the back: position R6
	BEQL	70$
	MOVZBL	-1(R7)[R6],R0
	MOVZBL	(SP)[R0],R0		; in SET?
	CMPL	R0,R9			; SCAN wants 1, VERIFY 0
	BEQL	60$
	DECL	R6
	BRB	50$
60$:	MOVL	R6,R0
	RET
70$:	CLRL	R0			; none
	RET

;
; position = FTN$INDEX_BACK(string, substring, back)
;
; INDEX with BACK (Fortran 90's 13.13.46): where SUBSTRING last starts in
; STRING, or, if BACK is false, first (FTN$INDEX); 0 if nowhere. An empty
; SUBSTRING is at LEN(STRING)+1. From the back, CMPC3 compares SUBSTRING
; with each place it fits, the last first.
;
	.ENTRY	FTN$INDEX_BACK,^M<R2,R3,R6,R7,R8,R9>
	BLBS	@12(AP),10$		; BACK?
	MOVQ	4(AP),-(SP)		; no: FTN$INDEX(string, substring)
	CALLS	#2,FTN$INDEX
	RET
10$:	MOVL	4(AP),R2		; STRING's descriptor
	MOVZWL	(R2),R6
	MOVL	DSC$A_POINTER(R2),R8
	MOVL	8(AP),R2		; SUBSTRING's
	MOVZWL	(R2),R7
	MOVL	DSC$A_POINTER(R2),R9
	SUBL2	R7,R6			; the last place it fits,
	INCL	R6			;  counted from 1
20$:	TSTL	R6			; none left?
	BLEQ	30$
	CMPC3	R7,-1(R8)[R6],(R9)
	BEQL	40$
	DECL	R6
	BRB	20$
30$:	CLRL	R6
40$:	MOVL	R6,R0
	RET

	.END
