	.TITLE	FTN_VECTOR - FTNRTL's transfer vector
	.IDENT	/V1.0/
;
; FTNRTL.EXE is the run-time library of govax's FORTRAN compiler: the
; routines a compiled program calls to do what the instructions it was
; compiled into don't (I/O, STOP, ...). It is a shareable image, so a
; program links against it rather than copying its routines, and many
; programs share one copy (docs/PHASE-74 - FORTRAN plan.md, Decision 13).
;
; A program linked against a shareable image refers to each routine by
; the image's name and the routine's offset in the image. If the
; routines themselves were those targets, their offsets would change
; whenever one of them grew, and every program linked before would call
; the wrong code. So the image starts with a transfer vector: one small
; entry per routine, at an offset that never changes, which jumps to the
; routine wherever it is. LINK links this module first, in a cluster of
; its own (FTNRTL.OPT), so the vector is at the start of the image.
;
; Each entry is 8 bytes, as the VMS Linker manual lays out a CALL entry
; (its Example 4-1):
;
;	.TRANSFER name	tells LINK that name is a universal symbol, one
;			that programs linking against the image may use,
;			whose value is this entry's address (no bytes);
;	.MASK name	the routine's entry mask (2 bytes): CALLS and CALLG
;			read the register save mask at the address they're
;			given, so the entry needs one, the routine's own;
;	JMP L^name+2	a jump past the routine's own mask to its first
;			instruction (6 bytes).
;
; New entries go at the end, never between, so that the old ones keep
; their offsets; each one added raises GSMATCH's minor number in
; FTNRTL.OPT.
;
; Reading these sources
; ---------------------
;
; FTNRTL's modules are VAX MACRO-32, the VAX's assembly language, and
; they share the conventions below, which each module takes for granted.
; This is a reader's guide, not the whole language: the VAX MACRO and
; Instruction Set Reference Manual has the rest, and docs/FORTRAN-
; INTERNALS.md, section 14, follows FTNRTL's design from the compiler's
; side.
;
; A line. Each line is label:, opcode, operands, and ; comment, any of
; them missing. A line ending in "-" goes on to the next. A name = value
; line (CTX_POS = 28) defines a symbol, a number, and makes no storage:
; most of FTNRTL's symbols are offsets in a block of memory, the fields
; of a structure in a language that has no structures. A label ending
; in "::" is global, seen by the other modules when LINK puts them
; together (FTN$$EDIT_FIELD::); one ending in ":" is the module's own. A
; label like 10$ is local: it means something only between two
; ordinary labels, so every routine may have its own 10$. The $xxxDEF
; lines ($DSCDEF, $FORDEF, $SSDEF) are macros from the system macro
; library that define VMS's symbols, and $EXIT_S and $SETAST_S are
; macros that call system services.
;
; Sections. .PSECT starts a program section: LINK gathers each
; section's pieces from every module into one place in the image. FTNRTL
; has four:
;
;	$$FTN_VECTOR	this transfer vector, first in the image;
;	$FTN_CODE	the instructions: read-only, and shared (SHR) by every
;			process running a FORTRAN program;
;	$FTN_PDATA	constant data (texts, tables): read-only and shared;
;	$FTN_DATA	writable data, each process's own copy (NOSHR).
;
; PIC (position-independent code) means the image works wherever it is
; put in memory, which differs from program to program. So the code
; never stores an address in its data: it reaches its data relative to
; the PC (a label as an operand is assembled that way), and builds any
; descriptor that needs an address on the stack when it runs.
;
; Registers. The VAX has sixteen 32-bit registers: R0 to R11, then AP
; (R12, the argument pointer), FP (R13, the frame pointer), SP (R14, the
; stack pointer), and PC (R15). By VMS's calling standard a routine
; returns its value in R0 (or R0 and R1), may change R0 and R1 freely,
; and must give the caller back R2 to R11 as they were: the .ENTRY line's
; mask, ^M<R2,R3>, names the ones the routine changes, and CALLS saves
; them for it.
;
; Instructions. An opcode is an operation and a data type: MOVL moves a
; longword (L, 4 bytes), MOVW a word (W, 2), MOVB a byte (B), MOVQ a
; quadword (Q, 8); F, D, G, and H are the floating formats. Operands go
; left to right, source first, then destination:
;
;	ADDL2	A,B		B = B + A
;	ADDL3	A,B,C		C = A + B
;	SUBL3	A,B,C		C = B - A (the second less the first)
;	MOVZBL	A,B		a byte made a longword, zero-extended
;	CVTBL	A,B		a byte made a longword, sign-extended
;	MOVAB	A,B		B = A's address, not its contents
;	PUSHL	A		push A on the stack (MOVL A,-(SP))
;	PUSHAB	A		push A's address
;	BICL2	M,B		clear in B the bits set in M
;	BISL2	M,B		set in B the bits set in M
;	EXTZV	P,S,B,R		R = the S bits of B from bit P, zero-extended
;	CLRL	A		A = 0
;	TSTL	A		set the condition codes by A, change nothing
;	CMPL	A,B		set them by A - B, change nothing
;
; Operands. How an operand names its value:
;
;	R3		the register
;	#5		the number 5 itself (an immediate)
;	(R3)		the longword (or byte, ...) whose address is in R3
;	8(R3)		the one at R3 plus 8: a field of a block R3 points at
;	@8(R3)		the one whose address is stored at 8(R3) (deferred)
;	(R3)+		the one at R3, then R3 is moved past it
;	-(SP)		SP is moved down first, then the one at SP: a push
;	(SP)+		the one at SP, then SP moves up past it: a pop
;	TABLE[R2]	element R2 of TABLE, R2 times the operand's size added
;	G^LIB$STOP	a name another image defines; LINK resolves it
;	L^NAME, B^NAME	a displacement written as a longword or a byte
;
; In expressions, ^X1F is hexadecimal, ^A/0/ a character's code, ^M<...>
; a register mask, ^C5 the bits of 5 complemented (BICL2 #^C1,R0 clears
; all but bit 0); A@B is A shifted left B bits, A!B an inclusive OR, and
; <...> brackets.
;
; Condition codes and branches. Nearly every instruction that writes a
; value also sets the N (negative) and Z (zero) condition codes by it, so
; MOVL X,R0 followed by BEQL is "if X was zero". CMP and TST set them
; for a comparison. BEQL and BNEQ branch on equal or not; BLSS, BLEQ,
; BGTR, and BGEQ compare signed numbers, and BLSSU, BLEQU, BGTRU, and
; BGEQU unsigned ones (addresses and lengths). BLBS and BLBC branch on a
; value's low bit: a VMS status is odd for success and even for failure,
; so BLBC R0,FAIL is "if the call failed". BBS and BBC branch on any
; bit. BRB reaches only 127 bytes; BRW 32,767. So code often branches
; around a BRW when what it would branch to is far away:
;
;	BEQL	10$		; not taken: go on to the BRW
;	BRW	FAR_AWAY
;   10$:
;
; CASEB X,#BASE,#LIMIT, followed by a table of .WORD offsets, is a
; switch: it jumps by entry X-BASE, or past the table if X is outside
; BASE to BASE+LIMIT.
;
; Calls. CALLS #n,ROUTINE calls a routine with the n longwords last
; pushed as its arguments: they are pushed last first, so the code reads
; backward from the call. CALLS makes a frame on the stack, sets AP to
; the argument list, and FP to the frame; RET takes the frame down,
; restores the saved registers, and pops the arguments. In the routine:
;
;	(AP)		the number of arguments, a byte
;	4(AP)		the first argument, 8(AP) the second, ...
;	@4(AP)		what the first argument points at (FORTRAN passes
;			most arguments by reference: their addresses)
;	(AP)[R0]	with R0 the count, the last argument
;	8(FP)		the caller's AP, saved in the frame
;	12(FP)		the caller's FP
;	16(FP)		the PC the call returns to, which FTNRTL's messages
;			call the user PC
;
; .ENTRY name,^M<...> starts a routine and makes its name global. A
; routine that only its own module calls may start instead with a plain
; label and .WORD ^M<...>, its entry mask written as data, which is all
; .ENTRY puts there: the name stays the module's own.
;
; A routine wanting room of its own moves SP down (SUBL2 #n,SP) and
; finds that room at negative offsets from FP; RET gives it back. A
; string is passed by descriptor: a quadword holding the text's length
; (a word, DSC$W_LENGTH), its type and class (bytes), and its address
; (DSC$A_POINTER).
;
; JSB, BSBB, and BSBW call a subroutine more cheaply: they push only the
; return address, and RSB pops it. Such a subroutine has no frame or
; arguments of its own; it shares its caller's registers, and its AP and
; FP are the enclosing routine's, so it can read that routine's
; arguments. Each one's comment says which registers it changes. Most
; are a module's own; a few are shared by a global label
; (FTN$$LI_SKIP), and LIBRTL's OTS$$CVT_x_T_R8 is one in another image.
; (BSBB and BSBW reach a nearby label, as BRB and BRW do; JSB any
; address.)
;
; Strings. The character instructions (MOVC3, MOVC5, CMPC3, CMPC5, LOCC,
; SKPC, MATCHC) work through R0 to R5 as they go, and leave them changed:
; that is why a routine that uses them saves R2 to R5. LOCC and SKPC
; leave in R0 the bytes left from the one they stopped at, and in R1 its
; address, with Z set if they reached the end.
;
; Conditions. A VMS condition value (FOR$_INVLOGUNI, SS$_NORMAL) is a
; longword: bits 0 to 2 its severity (1 success, 3 information, 0
; warning, 2 error, 4 severe), bits 3 to 15 the message's number, and the
; bits above them the facility (FOR is FORTRAN's). EXTZV #3,#12,R3,R0
; takes a FOR condition's number, which IOSTAT= and ERRSNS give a FORTRAN
; program. LIB$SIGNAL reports a condition to the program's handlers and
; may come back; LIB$STOP reports it and never does.
;
; FTNRTL's names. FTN$name is an entry in this vector, which programs
; call. FTN$$name is global but private: one module's routine that
; another calls, which programs may not use, since it has no vector entry
; and may move. Plain names are a module's own, but for the few that
; are .ENTRY routines (FTN_STATEMENT's POP_TO and POP_GONE), whose names
; LINK sees, though no other module calls them. Many routines keep the
; I/O statement's context (FTN_STATEMENT) in R11 throughout, and each
; module defines the context's fields it uses as offsets (CTX_...); they
; must agree with FTN_STATEMENT's.
;
; The entries
; -----------
;
; Each entry's comment gives its offset in the image and the FORTRAN it
; serves; the routine itself, and its comment, are in the module named.
;
	.PSECT	$$FTN_VECTOR,EXE,NOWRT,PIC,SHR,GBL,PAGE

	.TRANSFER FTN$VERSION		; 0: FTNRTL's version (FTN_CONTROL)
	.MASK	FTN$VERSION
	JMP	L^FTN$VERSION+2

	.TRANSFER FTN$STOP		; 8: STOP (FTN_CONTROL)
	.MASK	FTN$STOP
	JMP	L^FTN$STOP+2

	.TRANSFER FTN$PRINT_LIST	; 16: PRINT *'s start (Phase 75's)
	.MASK	FTN$PRINT_LIST
	JMP	L^FTN$PRINT_LIST+2

	.TRANSFER FTN$WRITE_LIST	; 24: WRITE (*,*)'s start (Phase 75's)
	.MASK	FTN$WRITE_LIST
	JMP	L^FTN$WRITE_LIST+2

	.TRANSFER FTN$IO_ITEM		; 32: an I/O list's item (FTN_STATEMENT)
	.MASK	FTN$IO_ITEM
	JMP	L^FTN$IO_ITEM+2

	.TRANSFER FTN$IO_END		; 40: an I/O statement's end
	.MASK	FTN$IO_END
	JMP	L^FTN$IO_END+2

	.TRANSFER FTN$IISHFTC		; 48: ISHFTC of an INTEGER*2 (FTN_INTRINSICS)
	.MASK	FTN$IISHFTC
	JMP	L^FTN$IISHFTC+2

	.TRANSFER FTN$JISHFTC		; 56: ISHFTC of an INTEGER*4
	.MASK	FTN$JISHFTC
	JMP	L^FTN$JISHFTC+2

;
; The intrinsic functions a compiled program computes in line, but may
; also pass as an actual argument (FORTRAN's INTRINSIC statement): the
; routine it passes them to calls them through these (FTN_INTRINSICS).
;
	.TRANSFER FTN$LEN	; 64: LEN, passed as an argument
	.MASK	FTN$LEN
	JMP	L^FTN$LEN+2

	.TRANSFER FTN$INDEX	; 72: INDEX, passed
	.MASK	FTN$INDEX
	JMP	L^FTN$INDEX+2

	.TRANSFER FTN$ICHAR	; 80: ICHAR, passed
	.MASK	FTN$ICHAR
	JMP	L^FTN$ICHAR+2

	.TRANSFER FTN$CHAR	; 88: CHAR, passed
	.MASK	FTN$CHAR
	JMP	L^FTN$CHAR+2

	.TRANSFER FTN$LLT	; 96: LLT, passed
	.MASK	FTN$LLT
	JMP	L^FTN$LLT+2

	.TRANSFER FTN$LLE	; 104: LLE, passed
	.MASK	FTN$LLE
	JMP	L^FTN$LLE+2

	.TRANSFER FTN$LGT	; 112: LGT, passed
	.MASK	FTN$LGT
	JMP	L^FTN$LGT+2

	.TRANSFER FTN$LGE	; 120: LGE, passed
	.MASK	FTN$LGE
	JMP	L^FTN$LGE+2

	.TRANSFER FTN$BITEST	; 128: BITEST (BTEST of INTEGER*2), passed
	.MASK	FTN$BITEST
	JMP	L^FTN$BITEST+2

	.TRANSFER FTN$BJTEST	; 136: BJTEST (BTEST of INTEGER*4), passed
	.MASK	FTN$BJTEST
	JMP	L^FTN$BJTEST+2

	.TRANSFER FTN$IIBITS	; 144: IIBITS (IBITS of INTEGER*2), passed
	.MASK	FTN$IIBITS
	JMP	L^FTN$IIBITS+2

	.TRANSFER FTN$JIBITS	; 152: JIBITS (IBITS of INTEGER*4), passed
	.MASK	FTN$JIBITS
	JMP	L^FTN$JIBITS+2

	.TRANSFER FTN$IIBSET	; 160: IIBSET (IBSET of INTEGER*2), passed
	.MASK	FTN$IIBSET
	JMP	L^FTN$IIBSET+2

	.TRANSFER FTN$JIBSET	; 168: JIBSET (IBSET of INTEGER*4), passed
	.MASK	FTN$JIBSET
	JMP	L^FTN$JIBSET+2

	.TRANSFER FTN$IIBCLR	; 176: IIBCLR (IBCLR of INTEGER*2), passed
	.MASK	FTN$IIBCLR
	JMP	L^FTN$IIBCLR+2

	.TRANSFER FTN$JIBCLR	; 184: JIBCLR (IBCLR of INTEGER*4), passed
	.MASK	FTN$JIBCLR
	JMP	L^FTN$JIBCLR+2

	.TRANSFER FTN$IZEXT	; 192: IZEXT, passed
	.MASK	FTN$IZEXT
	JMP	L^FTN$IZEXT+2

	.TRANSFER FTN$JZEXT	; 200: JZEXT, passed
	.MASK	FTN$JZEXT
	JMP	L^FTN$JZEXT+2

	.TRANSFER FTN$SNGLQ	; 208: SNGLQ (REAL*16 to REAL*4), passed
	.MASK	FTN$SNGLQ
	JMP	L^FTN$SNGLQ+2

	.TRANSFER FTN$DBLEQ	; 216: DBLEQ (REAL*16 to D REAL*8), passed
	.MASK	FTN$DBLEQ
	JMP	L^FTN$DBLEQ+2

	.TRANSFER FTN$GBLEQ	; 224: DBLEQ under /G_FLOATING, passed
	.MASK	FTN$GBLEQ
	JMP	L^FTN$GBLEQ+2

	.TRANSFER FTN$QEXT	; 232: QEXT (REAL*4 to REAL*16), passed
	.MASK	FTN$QEXT
	JMP	L^FTN$QEXT+2

	.TRANSFER FTN$QEXTD	; 240: QEXTD (D REAL*8 to REAL*16), passed
	.MASK	FTN$QEXTD
	JMP	L^FTN$QEXTD+2

	.TRANSFER FTN$QEXTG	; 248: QEXTD under /G_FLOATING, passed
	.MASK	FTN$QEXTG
	JMP	L^FTN$QEXTG+2

	.TRANSFER FTN$QFLOAT	; 256: QFLOAT (INTEGER*4 to REAL*16), passed
	.MASK	FTN$QFLOAT
	JMP	L^FTN$QFLOAT+2

	.TRANSFER FTN$NWORKERS	; 264: NWORKERS, always 1
	.MASK	FTN$NWORKERS
	JMP	L^FTN$NWORKERS+2

	.TRANSFER FTN$PAUSE		; 272: PAUSE (FTN_CONTROL)
	.MASK	FTN$PAUSE
	JMP	L^FTN$PAUSE+2

;
; Each I/O statement's begin call (FTN_STATEMENT; Phase 80). PRINT * and
; WRITE (*,*) call FTN$WRITE_SL now; FTN$PRINT_LIST and FTN$WRITE_LIST,
; above, stay for programs linked before.
;
	.TRANSFER FTN$READ_SF	; 280: READ with a format
	.MASK	FTN$READ_SF
	JMP	L^FTN$READ_SF+2

	.TRANSFER FTN$WRITE_SF	; 288: WRITE, PRINT, TYPE with a format
	.MASK	FTN$WRITE_SF
	JMP	L^FTN$WRITE_SF+2

	.TRANSFER FTN$READ_SL	; 296: list-directed READ
	.MASK	FTN$READ_SL
	JMP	L^FTN$READ_SL+2

	.TRANSFER FTN$WRITE_SL	; 304: list-directed WRITE
	.MASK	FTN$WRITE_SL
	JMP	L^FTN$WRITE_SL+2

	.TRANSFER FTN$READ_SN	; 312: namelist READ
	.MASK	FTN$READ_SN
	JMP	L^FTN$READ_SN+2

	.TRANSFER FTN$WRITE_SN	; 320: namelist WRITE
	.MASK	FTN$WRITE_SN
	JMP	L^FTN$WRITE_SN+2

	.TRANSFER FTN$READ_IF	; 328: READ of an internal file
	.MASK	FTN$READ_IF
	JMP	L^FTN$READ_IF+2

	.TRANSFER FTN$WRITE_IF	; 336: WRITE of an internal file
	.MASK	FTN$WRITE_IF
	JMP	L^FTN$WRITE_IF+2

	.TRANSFER FTN$READ_IL	; 344: list-directed READ of one
	.MASK	FTN$READ_IL
	JMP	L^FTN$READ_IL+2

	.TRANSFER FTN$WRITE_IL	; 352: list-directed WRITE of one
	.MASK	FTN$WRITE_IL
	JMP	L^FTN$WRITE_IL+2

	.TRANSFER FTN$DECODE	; 360: DECODE
	.MASK	FTN$DECODE
	JMP	L^FTN$DECODE+2

	.TRANSFER FTN$ENCODE	; 368: ENCODE
	.MASK	FTN$ENCODE
	JMP	L^FTN$ENCODE+2
;
; The system subroutine ERRSNS (FTN_STATEMENT; Phase 80, subtask 12), for
; INTEGER*4 and INTEGER*2 arguments.
;
	.TRANSFER FTN$ERRSNS	; 376: ERRSNS, INTEGER*4 arguments
	.MASK	FTN$ERRSNS
	JMP	L^FTN$ERRSNS+2

	.TRANSFER FTN$ERRSNS_W	; 384: ERRSNS, INTEGER*2 arguments
	.MASK	FTN$ERRSNS_W
	JMP	L^FTN$ERRSNS_W+2
;
; The file statements (FTN_OPEN; docs/PHASE-81 - FORTRAN files.md).
;
	.TRANSFER FTN$OPEN	; 392: OPEN
	.MASK	FTN$OPEN
	JMP	L^FTN$OPEN+2

	.TRANSFER FTN$CLOSE	; 400: CLOSE
	.MASK	FTN$CLOSE
	JMP	L^FTN$CLOSE+2

	.TRANSFER FTN$INQUIRE	; 408: FTN_INQUIRE
	.MASK	FTN$INQUIRE
	JMP	L^FTN$INQUIRE+2
;
; REWIND, BACKSPACE, and ENDFILE (FTN_POSITION).
;
	.TRANSFER FTN$REWIND	; 416: REWIND
	.MASK	FTN$REWIND
	JMP	L^FTN$REWIND+2

	.TRANSFER FTN$BACKSPACE	; 424: BACKSPACE
	.MASK	FTN$BACKSPACE
	JMP	L^FTN$BACKSPACE+2

	.TRANSFER FTN$ENDFILE	; 432: ENDFILE
	.MASK	FTN$ENDFILE
	JMP	L^FTN$ENDFILE+2
;
; Unformatted sequential READ and WRITE (FTN_STATEMENT, FTN_UNFORMATTED).
;
	.TRANSFER FTN$READ_SU	; 440: unformatted sequential READ
	.MASK	FTN$READ_SU
	JMP	L^FTN$READ_SU+2

	.TRANSFER FTN$WRITE_SU	; 448: unformatted sequential WRITE
	.MASK	FTN$WRITE_SU
	JMP	L^FTN$WRITE_SU+2

;
; Direct access READ and WRITE (FTN_STATEMENT), FIND and DEFINE FILE
; (FTN_DIRECT).
;
	.TRANSFER FTN$READ_DF	; 456: formatted direct READ (REC=)
	.MASK	FTN$READ_DF
	JMP	L^FTN$READ_DF+2

	.TRANSFER FTN$READ_DU	; 464: unformatted direct READ
	.MASK	FTN$READ_DU
	JMP	L^FTN$READ_DU+2

	.TRANSFER FTN$WRITE_DF	; 472: formatted direct WRITE
	.MASK	FTN$WRITE_DF
	JMP	L^FTN$WRITE_DF+2

	.TRANSFER FTN$WRITE_DU	; 480: unformatted direct WRITE
	.MASK	FTN$WRITE_DU
	JMP	L^FTN$WRITE_DU+2

	.TRANSFER FTN$FIND	; 488: FIND
	.MASK	FTN$FIND
	JMP	L^FTN$FIND+2

	.TRANSFER FTN$DEF_FILE	; 496: DEFINE FILE, INTEGER*4 arguments
	.MASK	FTN$DEF_FILE
	JMP	L^FTN$DEF_FILE+2

	.TRANSFER FTN$DEF_FILE_W	; 504: DEFINE FILE, INTEGER*2 arguments
	.MASK	FTN$DEF_FILE_W
	JMP	L^FTN$DEF_FILE_W+2

;
; DELETE and UNLOCK (FTN_RECORD), REWRITE and the keyed READ (FTN_STATEMENT).
;
	.TRANSFER FTN$DELETE	; 512: DELETE of the current record
	.MASK	FTN$DELETE
	JMP	L^FTN$DELETE+2

	.TRANSFER FTN$DELETE_D	; 520: DELETE (u'r) by record number
	.MASK	FTN$DELETE_D
	JMP	L^FTN$DELETE_D+2

	.TRANSFER FTN$UNLOCK	; 528: UNLOCK
	.MASK	FTN$UNLOCK
	JMP	L^FTN$UNLOCK+2

	.TRANSFER FTN$REWRITE_SF	; 536: formatted REWRITE
	.MASK	FTN$REWRITE_SF
	JMP	L^FTN$REWRITE_SF+2

	.TRANSFER FTN$REWRITE_SU	; 544: unformatted REWRITE
	.MASK	FTN$REWRITE_SU
	JMP	L^FTN$REWRITE_SU+2

	.TRANSFER FTN$READ_KF	; 552: formatted keyed READ (KEY=)
	.MASK	FTN$READ_KF
	JMP	L^FTN$READ_KF+2

	.TRANSFER FTN$READ_KU	; 560: unformatted keyed READ
	.MASK	FTN$READ_KU
	JMP	L^FTN$READ_KU+2

;
; The system subroutines (FTN_SYSTEM).
;
	.TRANSFER FTN$DATE	; 568: CALL DATE
	.MASK	FTN$DATE
	JMP	L^FTN$DATE+2

	.TRANSFER FTN$DATE_T_DS	; 576: CALL DATE, CHARACTER argument
	.MASK	FTN$DATE_T_DS
	JMP	L^FTN$DATE_T_DS+2

	.TRANSFER FTN$TIME	; 584: CALL TIME
	.MASK	FTN$TIME
	JMP	L^FTN$TIME+2

	.TRANSFER FTN$TIME_T_DS	; 592: CALL TIME, CHARACTER argument
	.MASK	FTN$TIME_T_DS
	JMP	L^FTN$TIME_T_DS+2

	.TRANSFER FTN$IDATE	; 600: CALL IDATE, INTEGER*2 arguments
	.MASK	FTN$IDATE
	JMP	L^FTN$IDATE+2

	.TRANSFER FTN$JDATE	; 608: CALL IDATE, INTEGER*4 arguments
	.MASK	FTN$JDATE
	JMP	L^FTN$JDATE+2

	.TRANSFER FTN$SECNDS	; 616: the SECNDS function
	.MASK	FTN$SECNDS
	JMP	L^FTN$SECNDS+2

	.TRANSFER FTN$EXIT	; 624: CALL EXIT, INTEGER*4 status
	.MASK	FTN$EXIT
	JMP	L^FTN$EXIT+2

	.TRANSFER FTN$EXIT_W	; 632: CALL EXIT, INTEGER*2 status
	.MASK	FTN$EXIT_W
	JMP	L^FTN$EXIT_W+2

	.TRANSFER FTN$IMVBITS	; 640: CALL MVBITS, INTEGER*2 arguments
	.MASK	FTN$IMVBITS
	JMP	L^FTN$IMVBITS+2

	.TRANSFER FTN$JMVBITS	; 648: CALL MVBITS, INTEGER*4 arguments
	.MASK	FTN$JMVBITS
	JMP	L^FTN$JMVBITS+2

;
; Two more that a compiled program calls: /CHECK=BOUNDS's report of an
; adjustable array whose bounds are wrong on entry (FTN_CONTROL), and
; FOR$RAB, a unit's RMS record access block, for a program that calls
; RMS itself (FTN_UNITS).
;
	.TRANSFER FTN$ADJARRDIM	; 656: adjustable array bounds wrong
	.MASK	FTN$ADJARRDIM
	JMP	L^FTN$ADJARRDIM+2

	.TRANSFER FTN$RAB	; 664: FOR$RAB(unit)
	.MASK	FTN$RAB
	JMP	L^FTN$RAB+2

	.END
