	.TITLE	FTN_VECTOR - FTNRTL's transfer vector
	.IDENT	/V1.0/
;
; FTNRTL.EXE is the run-time library of govax's FORTRAN compiler: the
; routines a compiled program calls to do what the instructions it was
; compiled into don't (I/O, STOP, ...). It is a shareable image, so a
; program links against it rather than copying its routines, and many
; programs share one copy (docs/PHASE-74 - FORTRAN plan.md, Decision 13).
;
; A program linked against a shareable image refers to each routine by
; the image's name and the routine's offset in the image. If the
; routines themselves were those targets, their offsets would change
; whenever one of them grew, and every program linked before would call
; the wrong code. So the image starts with a transfer vector: one small
; entry per routine, at an offset that never changes, which jumps to the
; routine wherever it is. LINK links this module first, in a cluster of
; its own (FTNRTL.OPT), so the vector is at the start of the image.
;
; Each entry is 8 bytes, as the VMS Linker manual lays out a CALL entry
; (its Example 4-1):
;
;	.TRANSFER name	tells LINK that name is a universal symbol, one
;			that programs linking against the image may use,
;			whose value is this entry's address (no bytes);
;	.MASK name	the routine's entry mask (2 bytes): CALLS and CALLG
;			read the register save mask at the address they're
;			given, so the entry needs one, the routine's own;
;	JMP L^name+2	a jump past the routine's own mask to its first
;			instruction (6 bytes).
;
; New entries go at the end, never between, so that the old ones keep
; their offsets; each one added raises GSMATCH's minor number in
; FTNRTL.OPT.
;
	.PSECT	$$FTN_VECTOR,EXE,NOWRT,PIC,SHR,GBL,PAGE

	.TRANSFER FTN$VERSION		; 0: FTNRTL's version
	.MASK	FTN$VERSION
	JMP	L^FTN$VERSION+2

	.TRANSFER FTN$STOP		; 8: the STOP statement
	.MASK	FTN$STOP
	JMP	L^FTN$STOP+2

	.TRANSFER FTN$PRINT_LIST	; 16: PRINT *'s start (Phase 75's)
	.MASK	FTN$PRINT_LIST
	JMP	L^FTN$PRINT_LIST+2

	.TRANSFER FTN$WRITE_LIST	; 24: WRITE (*,*)'s start (Phase 75's)
	.MASK	FTN$WRITE_LIST
	JMP	L^FTN$WRITE_LIST+2

	.TRANSFER FTN$IO_ITEM		; 32: an I/O list's item
	.MASK	FTN$IO_ITEM
	JMP	L^FTN$IO_ITEM+2

	.TRANSFER FTN$IO_END		; 40: an I/O statement's end
	.MASK	FTN$IO_END
	JMP	L^FTN$IO_END+2

	.TRANSFER FTN$IISHFTC		; 48: ISHFTC of an INTEGER*2
	.MASK	FTN$IISHFTC
	JMP	L^FTN$IISHFTC+2

	.TRANSFER FTN$JISHFTC		; 56: ISHFTC of an INTEGER*4
	.MASK	FTN$JISHFTC
	JMP	L^FTN$JISHFTC+2

	.TRANSFER FTN$LEN		; 64
	.MASK	FTN$LEN
	JMP	L^FTN$LEN+2

	.TRANSFER FTN$INDEX		; 72
	.MASK	FTN$INDEX
	JMP	L^FTN$INDEX+2

	.TRANSFER FTN$ICHAR		; 80
	.MASK	FTN$ICHAR
	JMP	L^FTN$ICHAR+2

	.TRANSFER FTN$CHAR		; 88
	.MASK	FTN$CHAR
	JMP	L^FTN$CHAR+2

	.TRANSFER FTN$LLT		; 96
	.MASK	FTN$LLT
	JMP	L^FTN$LLT+2

	.TRANSFER FTN$LLE		; 104
	.MASK	FTN$LLE
	JMP	L^FTN$LLE+2

	.TRANSFER FTN$LGT		; 112
	.MASK	FTN$LGT
	JMP	L^FTN$LGT+2

	.TRANSFER FTN$LGE		; 120
	.MASK	FTN$LGE
	JMP	L^FTN$LGE+2

	.TRANSFER FTN$BITEST		; 128
	.MASK	FTN$BITEST
	JMP	L^FTN$BITEST+2

	.TRANSFER FTN$BJTEST		; 136
	.MASK	FTN$BJTEST
	JMP	L^FTN$BJTEST+2

	.TRANSFER FTN$IIBITS		; 144
	.MASK	FTN$IIBITS
	JMP	L^FTN$IIBITS+2

	.TRANSFER FTN$JIBITS		; 152
	.MASK	FTN$JIBITS
	JMP	L^FTN$JIBITS+2

	.TRANSFER FTN$IIBSET		; 160
	.MASK	FTN$IIBSET
	JMP	L^FTN$IIBSET+2

	.TRANSFER FTN$JIBSET		; 168
	.MASK	FTN$JIBSET
	JMP	L^FTN$JIBSET+2

	.TRANSFER FTN$IIBCLR		; 176
	.MASK	FTN$IIBCLR
	JMP	L^FTN$IIBCLR+2

	.TRANSFER FTN$JIBCLR		; 184
	.MASK	FTN$JIBCLR
	JMP	L^FTN$JIBCLR+2

	.TRANSFER FTN$IZEXT		; 192
	.MASK	FTN$IZEXT
	JMP	L^FTN$IZEXT+2

	.TRANSFER FTN$JZEXT		; 200
	.MASK	FTN$JZEXT
	JMP	L^FTN$JZEXT+2

	.TRANSFER FTN$SNGLQ		; 208
	.MASK	FTN$SNGLQ
	JMP	L^FTN$SNGLQ+2

	.TRANSFER FTN$DBLEQ		; 216
	.MASK	FTN$DBLEQ
	JMP	L^FTN$DBLEQ+2

	.TRANSFER FTN$GBLEQ		; 224
	.MASK	FTN$GBLEQ
	JMP	L^FTN$GBLEQ+2

	.TRANSFER FTN$QEXT		; 232
	.MASK	FTN$QEXT
	JMP	L^FTN$QEXT+2

	.TRANSFER FTN$QEXTD		; 240
	.MASK	FTN$QEXTD
	JMP	L^FTN$QEXTD+2

	.TRANSFER FTN$QEXTG		; 248
	.MASK	FTN$QEXTG
	JMP	L^FTN$QEXTG+2

	.TRANSFER FTN$QFLOAT		; 256
	.MASK	FTN$QFLOAT
	JMP	L^FTN$QFLOAT+2

	.TRANSFER FTN$NWORKERS		; 264
	.MASK	FTN$NWORKERS
	JMP	L^FTN$NWORKERS+2

	.TRANSFER FTN$PAUSE		; 272: the PAUSE statement
	.MASK	FTN$PAUSE
	JMP	L^FTN$PAUSE+2

;
; Each I/O statement's begin call (FTN_STATEMENT; Phase 80). PRINT * and
; WRITE (*,*) call FTN$WRITE_SL now; FTN$PRINT_LIST and FTN$WRITE_LIST,
; above, stay for programs linked before.
;
	.TRANSFER FTN$READ_SF	; 280: READ with a format
	.MASK	FTN$READ_SF
	JMP	L^FTN$READ_SF+2

	.TRANSFER FTN$WRITE_SF	; 288: WRITE, PRINT, TYPE with a format
	.MASK	FTN$WRITE_SF
	JMP	L^FTN$WRITE_SF+2

	.TRANSFER FTN$READ_SL	; 296: list-directed READ
	.MASK	FTN$READ_SL
	JMP	L^FTN$READ_SL+2

	.TRANSFER FTN$WRITE_SL	; 304: list-directed WRITE
	.MASK	FTN$WRITE_SL
	JMP	L^FTN$WRITE_SL+2

	.TRANSFER FTN$READ_SN	; 312: namelist READ
	.MASK	FTN$READ_SN
	JMP	L^FTN$READ_SN+2

	.TRANSFER FTN$WRITE_SN	; 320: namelist WRITE
	.MASK	FTN$WRITE_SN
	JMP	L^FTN$WRITE_SN+2

	.TRANSFER FTN$READ_IF	; 328: READ of an internal file
	.MASK	FTN$READ_IF
	JMP	L^FTN$READ_IF+2

	.TRANSFER FTN$WRITE_IF	; 336: WRITE of an internal file
	.MASK	FTN$WRITE_IF
	JMP	L^FTN$WRITE_IF+2

	.TRANSFER FTN$READ_IL	; 344: list-directed READ of one
	.MASK	FTN$READ_IL
	JMP	L^FTN$READ_IL+2

	.TRANSFER FTN$WRITE_IL	; 352: list-directed WRITE of one
	.MASK	FTN$WRITE_IL
	JMP	L^FTN$WRITE_IL+2

	.TRANSFER FTN$DECODE	; 360: DECODE
	.MASK	FTN$DECODE
	JMP	L^FTN$DECODE+2

	.TRANSFER FTN$ENCODE	; 368: ENCODE
	.MASK	FTN$ENCODE
	JMP	L^FTN$ENCODE+2
;
; The system subroutine ERRSNS (FTN_STATEMENT; Phase 80, subtask 12), for
; INTEGER*4 and INTEGER*2 arguments.
;
	.TRANSFER FTN$ERRSNS	; 376
	.MASK	FTN$ERRSNS
	JMP	L^FTN$ERRSNS+2

	.TRANSFER FTN$ERRSNS_W	; 384
	.MASK	FTN$ERRSNS_W
	JMP	L^FTN$ERRSNS_W+2

	.END
