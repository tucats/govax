	.MEXIT
	.ENDC
	PUSHL	PERM
	PUSHL	PROT
	$PUSHADRVAL NAME,EFN,CONTEXT=Q
	CALLS	#4,G^SYS$ASCEFC
	.ENDM	$ASCEFC_S

