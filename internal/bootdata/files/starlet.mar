; STARLET.MAR: govax's own system macros.
;
; This is the source of govax's STARLET.MLB, the macro library MACRO uses
; when neither SYS$LIBRARY:STARLET.MLB on a mounted volume nor STARLET.MLB
; in the host library directory exists. The macros are written from the
; argument lists in the OpenVMS System Services Reference Manual, not
; copied from VMS's STARLET, and a test (internal/asm) checks that each
; call expands to the same code as the real library's.
;
; After changing this file, run "go generate ./internal/bootdata" to
; rebuild starlet.mlb; a test fails if the two don't match. The library is
; built as LIBRARY/CREATE/MACRO builds one, which squeezes out comments
; (from each line's last semicolon), so keep semicolons out of strings.
;
; Helper macros:
;
;   $PUSHADR ADDR,CONTEXT=L
;	Push the address of an argument passed by reference, or zero for an
;	omitted one (0). CONTEXT is the operand's size (B, W, L, Q), which
;	matters only for an addressing mode whose address depends on it:
;	a literal (short or immediate), autoincrement, autodecrement, or an
;	indexed operand. Everything else is pushed with PUSHAB. A literal
;	is recognized by its "#" (absolute mode's "@#" isn't one), not by
;	.NTYPE, so it doesn't matter how .NTYPE numbers the PC modes.
;
;   $PUSHVALS A,B
;	Push two longwords passed by value, A first, or clear a quadword
;	when both are #0.
;
;   $PUSHVALADR VAL,ADDR,CONTEXT=L
;	Push VAL by value, then ADDR by reference, or clear a quadword when
;	VAL is #0 and ADDR is 0.
;
;   $PUSHADRVAL ADDR,VAL,CONTEXT=L
;	Push ADDR by reference, then VAL by value, or clear a quadword when
;	ADDR is 0 and VAL is #0.
;
; An argument list is pushed last argument first, so each service macro
; pushes its arguments in the reverse of their order in the call.

	.MACRO	$PUSHADR ADDR,CONTEXT=L
	.IF	IDN,<0>,<ADDR>
	PUSHL	#0
	.MEXIT
	.ENDC
	$$SIZED = 0
	.IIF	LT,%LOCATE(<#>,ADDR)-%LENGTH(ADDR),	$$SIZED = 1	; literal
	.IIF	LT,%LOCATE(<@#>,ADDR)-%LENGTH(ADDR),	$$SIZED = 0	; absolute
	.NTYPE	$$MODE,ADDR
	.IIF	NE,<$$MODE&^XFF00>,	$$SIZED = 1	; indexed
	.IIF	EQ,<$$MODE&^XF0>-^X70,	$$SIZED = 1	; autodecrement
	.IIF	EQ,<$$MODE&^XF0>-^X80,	$$SIZED = 1	; autoincrement
	.IF	NE,$$SIZED
	PUSHA'CONTEXT	ADDR
	.IFF
	PUSHAB	ADDR
	.ENDC
	.ENDM	$PUSHADR

	.MACRO	$PUSHVALS A,B
	.IF	IDN,<#0>,<A>
	.IF	IDN,<#0>,<B>
	CLRQ	-(SP)
	.MEXIT
	.ENDC
	.ENDC
	PUSHL	A
	PUSHL	B
	.ENDM	$PUSHVALS

	.MACRO	$PUSHVALADR VAL,ADDR,CONTEXT=L
	.IF	IDN,<#0>,<VAL>
	.IF	IDN,<0>,<ADDR>
	CLRQ	-(SP)
	.MEXIT
	.ENDC
	.ENDC
	PUSHL	VAL
	$PUSHADR ADDR,CONTEXT=CONTEXT
	.ENDM	$PUSHVALADR

	.MACRO	$PUSHADRVAL ADDR,VAL,CONTEXT=L
	.IF	IDN,<0>,<ADDR>
	.IF	IDN,<#0>,<VAL>
	CLRQ	-(SP)
	.MEXIT
	.ENDC
	.ENDC
	$PUSHADR ADDR,CONTEXT=CONTEXT
	PUSHL	VAL
	.ENDM	$PUSHADRVAL

; $ASSIGN devnam, chan, [acmode], [mbxnam], [flags]
;	devnam and mbxnam are descriptors, by reference. chan is a word
;	written by the service, by reference. acmode and flags are by value.

	.MACRO	$ASSIGN_S DEVNAM,CHAN,ACMODE=#0,MBXNAM=0,FLAGS=#0
	.GLOBL	SYS$ASSIGN
	PUSHL	FLAGS
	$PUSHADRVAL MBXNAM,ACMODE,CONTEXT=Q
	$PUSHADR CHAN,CONTEXT=W
	$PUSHADR DEVNAM,CONTEXT=Q
	CALLS	#5,G^SYS$ASSIGN
	.ENDM	$ASSIGN_S

; $DASSGN chan
;	chan is a word, by value.

	.MACRO	$DASSGN_S CHAN
	.GLOBL	SYS$DASSGN
	MOVZWL	CHAN,-(SP)
	CALLS	#1,G^SYS$DASSGN
	.ENDM	$DASSGN_S

; $EXIT [code]
;	code is a longword, by value.

	.MACRO	$EXIT_S	CODE=#1
	.GLOBL	SYS$EXIT
	PUSHL	CODE
	CALLS	#1,G^SYS$EXIT
	.ENDM	$EXIT_S

; $QIO [efn], chan, func, [iosb], [astadr], [astprm], [p1]...[p6]
; $QIOW takes the same arguments.
;	efn and astprm are longwords, by value. chan and func are words, by
;	value. iosb is a quadword, by reference, and astadr a procedure, by
;	reference. p1 is by reference (a buffer's address), and p2 through
;	p6 by value.

	.MACRO	$QIO_S	EFN=#0,CHAN,FUNC,IOSB=0,ASTADR=0,ASTPRM=#0,-
			P1=0,P2=#0,P3=#0,P4=#0,P5=#0,P6=#0
	.GLOBL	SYS$QIO
	$PUSHVALS P6,P5
	$PUSHVALS P4,P3
	PUSHL	P2
	$PUSHADR P1
	$PUSHVALADR ASTPRM,ASTADR
	$PUSHADR IOSB,CONTEXT=Q
	MOVZWL	FUNC,-(SP)
	MOVZWL	CHAN,-(SP)
	PUSHL	EFN
	CALLS	#12,G^SYS$QIO
	.ENDM	$QIO_S

	.MACRO	$QIOW_S	EFN=#0,CHAN,FUNC,IOSB=0,ASTADR=0,ASTPRM=#0,-
			P1=0,P2=#0,P3=#0,P4=#0,P5=#0,P6=#0
	.GLOBL	SYS$QIOW
	$PUSHVALS P6,P5
	$PUSHVALS P4,P3
	PUSHL	P2
	$PUSHADR P1
	$PUSHVALADR ASTPRM,ASTADR
	$PUSHADR IOSB,CONTEXT=Q
	MOVZWL	FUNC,-(SP)
	MOVZWL	CHAN,-(SP)
	PUSHL	EFN
	CALLS	#12,G^SYS$QIOW
	.ENDM	$QIOW_S

; The RMS control block initialization macros (docs/PHASE-32.md, subtask
; 5), written from the RMS Reference Manual's appendix A and from what
; real VAX MACRO assembled for govax's oracle probes (testdata/mar/rms,
; docs/RMS-MACROS.md). Each one defines its block's symbols ($xxxDEF),
; notes a block that isn't longword aligned, stores the block's
; identification bytes, moves to the block's end and back, stores each
; field in the order real MACRO's objects show, moving to it with ". ="
; where they show a move, and ends at the block's end. A longword field
; is stored with .ADDRESS, even a number, as real MACRO's objects show.
;
; Helper macros:
;
;   $$RMSCHK
;	Display the informational message for a block at an address that
;	isn't longword aligned, and set $$RMSBLK to the block's address.
;
;   $$RMSBITS SYM,PFX,LIST,ALT
;	Set SYM to the OR of the bits at the PFX'X bit positions of the
;	options X in LIST, trying ALT'X first when ALT is given (FAB$V_SHR:
;	SHR's GET is FAB$V_SHRGET). Real MACRO's listings show the macros
;	referring to the $V_ positions, not the $M_ masks: FAC=GET refers
;	to FAB$V_GET, RAT=CR to FAB$V_CR, ROP=PMT to RAB$V_PMT
;	(testdata/mar/vax/forth.lis's symbol table, VMS 7.3).
;	An unknown option is an error.
;
;   $$RMSCODE SYM,PFX,X
;	Set SYM to PFX'X, the code for the single choice X. An unknown
;	choice is an error.
;
;   $$RMSPRO SYM,PRO
;	Set SYM to the XABPRO protection word for <system,owner,group,world>:
;	each class four deny bits, cleared by its letters R, W, E, and D; an
;	omitted class denies everything (^XF).

	.MACRO	$$RMSCHK
	.IIF	NE,.&3, .PRINT ;%MACRO-I-GENINFO, Generated INFO: RMS BLOCK NOT LONGWORD ALIGNED;
	$$RMSBLK = .
	.ENDM	$$RMSCHK

	.MACRO	$$RMSBIT SYM,PFX,X,ALT
	.IF	NB,<ALT>
	.IF	DF,ALT'X
	SYM = SYM!<1@ALT'X>
	.MEXIT
	.ENDC
	.ENDC
	.IF	DF,PFX'X
	SYM = SYM!<1@PFX'X>
	.IFF
	.ERROR	; UNDEFINED BIT VALUE CODE: X;
	.ENDC
	.ENDM	$$RMSBIT

	.MACRO	$$RMSBITS SYM,PFX,LIST,ALT
	SYM = 0
	.IF	NB,<LIST>
	.IRP	$$RMSX,<LIST>
	$$RMSBIT SYM,PFX,$$RMSX,ALT
	.ENDR
	.ENDC
	.ENDM	$$RMSBITS

	.MACRO	$$RMSCODE SYM,PFX,X
	.IF	DF,PFX'X
	SYM = PFX'X
	.IFF
	SYM = 0
	.ERROR	; UNDEFINED VALUE FOR FIELD : X;
	.ENDC
	.ENDM	$$RMSCODE

	.MACRO	$$RMSCLASS SYM,LETTERS
	$$RMSK = ^XF
	.IRPC	$$RMSL,<LETTERS>
	.IIF	IDN,<$$RMSL>,<R>,	$$RMSK = $$RMSK&^C1
	.IIF	IDN,<$$RMSL>,<W>,	$$RMSK = $$RMSK&^C2
	.IIF	IDN,<$$RMSL>,<E>,	$$RMSK = $$RMSK&^C4
	.IIF	IDN,<$$RMSL>,<D>,	$$RMSK = $$RMSK&^C8
	.ENDR
	SYM = SYM!<$$RMSK@$$RMSSH>
	$$RMSSH = $$RMSSH+4
	.ENDM	$$RMSCLASS

	.MACRO	$$RMSPRO SYM,PRO
	.IF	B,<PRO>
	SYM = ^XFFFF
	.MEXIT
	.ENDC
	SYM = 0
	$$RMSSH = 0
	.IRP	$$RMSC,<PRO>
	$$RMSCLASS SYM,$$RMSC
	.ENDR
	.REPT	<16-$$RMSSH>/4
	SYM = SYM!<^XF@$$RMSSH>
	$$RMSSH = $$RMSSH+4
	.ENDR
	.ENDM	$$RMSPRO

; $FAB ALQ,BKS,BLS,CHAN_MODE,CTX,DEQ,DNA,DNM,DNS,FAC,FNA,FNM,FNS,FOP,FSZ,
;	GBC,LNM_MODE,MRN,MRS,NAM,ORG,RAT,RFM,RTV,SHR,XAB (manual A-2)
;	RFM defaults to VAR, ORG to SEQ, everything else to 0. FNM= and DNM=
;	strings go in psect $RMSNAM, and FNA/FNS and DNA/DNS are set to them.

	.MACRO	$FAB	ALQ=0,BKS=0,BLS=0,CHAN_MODE=0,CTX=0,DEQ=0,DNA=0,DNM,-
			DNS=0,FAC,FNA=0,FNM,FNS=0,FOP,FSZ=0,GBC=0,LNM_MODE=0,-
			MRN=0,MRS=0,NAM=0,ORG=SEQ,RAT,RFM=VAR,RTV=0,SHR,XAB=0
	$FABDEF
	$$RMSCHK
	.BYTE	FAB$C_BID,FAB$C_BLN
	. = $$RMSBLK+FAB$C_BLN
	. = $$RMSBLK+FAB$L_FOP
	$$RMSBITS $$RMSV,FAB$V_,<FOP>
	.ADDRESS $$RMSV
	. = $$RMSBLK+FAB$L_ALQ
	.ADDRESS ALQ
	.WORD	DEQ
	$$RMSBITS $$RMSV,FAB$V_,<FAC>
	.BYTE	$$RMSV
	$$RMSBITS $$RMSV,FAB$V_,<SHR>,FAB$V_SHR
	.BYTE	$$RMSV
	.ADDRESS CTX
	$$RMSCODE $$RMSV,FAB$C_,ORG
	$$RMSBITS $$RMSW,FAB$V_,<RAT>
	$$RMSCODE $$RMSU,FAB$C_,RFM
	.BYTE	RTV,$$RMSV,$$RMSW,$$RMSU,0,0,0,0
	.ADDRESS XAB
	.ADDRESS NAM
	.ADDRESS FNA
	.ADDRESS DNA
	.BYTE	FNS,DNS
	.WORD	MRS
	.ADDRESS MRN
	.WORD	BLS
	.BYTE	BKS,FSZ
	. = $$RMSBLK+FAB$W_GBC
	.WORD	GBC
	.BYTE	<CHAN_MODE@FAB$V_CHAN_MODE>!<LNM_MODE@FAB$V_LNM_MODE>
	.IF	NB,<FNM>
	.SAVE
	.PSECT	$RMSNAM
	$$RMSS = .
	.ASCII	\FNM\
	$$RMSL = .-$$RMSS
	.RESTORE
	. = $$RMSBLK+FAB$L_FNA
	.ADDRESS $$RMSS
	. = $$RMSBLK+FAB$B_FNS
	.BYTE	$$RMSL
	.ENDC
	.IF	NB,<DNM>
	.SAVE
	.PSECT	$RMSNAM
	$$RMSS = .
	.ASCII	\DNM\
	$$RMSL = .-$$RMSS
	.RESTORE
	. = $$RMSBLK+FAB$L_DNA
	.ADDRESS $$RMSS
	. = $$RMSBLK+FAB$B_DNS
	.BYTE	$$RMSL
	.ENDC
	. = $$RMSBLK+FAB$C_BLN
	.ENDM	$FAB

; $RAB BKT,CTX,FAB,KBF,KRF,KSZ,MBC,MBF,PBF,PSZ,RAC,RBF,RHB,ROP,RSZ,TMO,
;	UBF,USZ,XAB (manual A-11)
;	RAC defaults to SEQ, everything else to 0. PBF and PSZ share KBF's
;	and KSZ's fields, and are stored over them when given.

	.MACRO	$RAB	BKT=0,CTX=0,FAB=0,KBF=0,KRF=0,KSZ=0,MBC=0,MBF=0,PBF,-
			PSZ,RAC=SEQ,RBF=0,RHB=0,ROP,RSZ=0,TMO=0,UBF=0,USZ=0,-
			XAB=0
	$RABDEF
	$$RMSCHK
	.BYTE	RAB$C_BID,RAB$C_BLN
	. = $$RMSBLK+RAB$C_BLN
	. = $$RMSBLK+RAB$L_ROP
	$$RMSBITS $$RMSV,RAB$V_,<ROP>
	.ADDRESS $$RMSV
	. = $$RMSBLK+RAB$L_CTX
	.ADDRESS CTX
	. = $$RMSBLK+RAB$B_RAC
	$$RMSCODE $$RMSV,RAB$C_,RAC
	.BYTE	$$RMSV,TMO
	.WORD	USZ,RSZ
	.ADDRESS UBF
	.ADDRESS RBF
	.ADDRESS RHB
	.ADDRESS KBF
	.IF	NB,<PBF>
	. = $$RMSBLK+RAB$L_PBF
	.ADDRESS PBF
	.ENDC
	.BYTE	KSZ
	.IF	NB,<PSZ>
	. = $$RMSBLK+RAB$B_PSZ
	.BYTE	PSZ
	.ENDC
	.BYTE	KRF,MBF,MBC
	.ADDRESS BKT
	.ADDRESS FAB
	.ADDRESS XAB
	. = $$RMSBLK+RAB$C_BLN
	.ENDM	$RAB

; $NAM ESA,ESS,NOP,RLF,RSA,RSS (manual A-5)

	.MACRO	$NAM	ESA=0,ESS=0,NOP,RLF=0,RSA=0,RSS=0
	$NAMDEF
	$$RMSCHK
	.BYTE	NAM$C_BID,NAM$C_BLN
	. = $$RMSBLK+NAM$C_BLN
	. = $$RMSBLK+NAM$B_RSS
	.BYTE	RSS
	. = $$RMSBLK+NAM$L_RSA
	.ADDRESS RSA
	. = $$RMSBLK+NAM$B_NOP
	$$RMSBITS $$RMSV,NAM$V_,<NOP>
	.ADDRESS $$RMSV
	. = $$RMSBLK+NAM$B_ESS
	.BYTE	ESS
	. = $$RMSBLK+NAM$L_ESA
	.ADDRESS ESA
	.ADDRESS RLF
	. = $$RMSBLK+NAM$C_BLN
	.ENDM	$NAM

; $XABALL AID,ALN,ALQ,AOP,BKZ,DEQ,LOC,NXT,RFI,VOL (manual A-18)
;	ALN is stored only when given. RFI is three words, <f1,f2,f3>.

	.MACRO	$XABALL	AID=0,ALN,ALQ=0,AOP,BKZ=0,DEQ=0,LOC=0,NXT=0,-
			RFI=<0,0,0>,VOL=0
	$XABDEF
	$XABALLDEF
	$$RMSCHK
	.BYTE	XAB$C_ALL,XAB$C_ALLLEN
	. = $$RMSBLK+XAB$C_ALLLEN
	. = $$RMSBLK+XAB$W_VOL
	.WORD	VOL
	.IF	NB,<ALN>
	. = $$RMSBLK+XAB$B_ALN
	$$RMSCODE $$RMSV,XAB$C_,ALN
	.BYTE	$$RMSV
	.ENDC
	. = $$RMSBLK+XAB$B_AOP
	$$RMSBITS $$RMSV,XAB$V_,<AOP>
	.BYTE	$$RMSV
	. = $$RMSBLK+XAB$L_LOC
	.ADDRESS LOC
	$$RMSV = $$RMSBLK+XAB$W_RFI
	.IRP	$$RMSX,<RFI>
	. = $$RMSV
	.WORD	$$RMSX
	$$RMSV = $$RMSV+2
	.ENDR
	. = $$RMSBLK+XAB$L_ALQ
	.ADDRESS ALQ
	. = $$RMSBLK+XAB$B_AID
	.BYTE	AID
	. = $$RMSBLK+XAB$B_BKZ
	.BYTE	BKZ
	. = $$RMSBLK+XAB$W_DEQ
	.WORD	DEQ
	. = $$RMSBLK+XAB$L_NXT
	.ADDRESS NXT
	. = $$RMSBLK+XAB$C_ALLLEN
	.ENDM	$XABALL

; $XABDAT EDT,NXT (manual A-20)

	.MACRO	$XABDAT	EDT=0,NXT=0
	$XABDEF
	$XABDATDEF
	$$RMSCHK
	.BYTE	XAB$C_DAT,XAB$C_DATLEN
	. = $$RMSBLK+XAB$C_DATLEN
	. = $$RMSBLK+XAB$Q_EDT
	.QUAD	EDT
	. = $$RMSBLK+XAB$L_NXT
	.ADDRESS NXT
	. = $$RMSBLK+XAB$C_DATLEN
	.ENDM	$XABDAT

; $XABFHC NXT, $XABRDT NXT, $XABSUM NXT (manual A-22, A-30, A-33)

	.MACRO	$XABFHC	NXT=0
	$XABDEF
	$XABFHCDEF
	$$RMSCHK
	.BYTE	XAB$C_FHC,XAB$C_FHCLEN
	. = $$RMSBLK+XAB$C_FHCLEN
	. = $$RMSBLK+XAB$L_NXT
	.ADDRESS NXT
	. = $$RMSBLK+XAB$C_FHCLEN
	.ENDM	$XABFHC

	.MACRO	$XABRDT	NXT=0
	$XABDEF
	$XABRDTDEF
	$$RMSCHK
	.BYTE	XAB$C_RDT,XAB$C_RDTLEN
	. = $$RMSBLK+XAB$C_RDTLEN
	. = $$RMSBLK+XAB$L_NXT
	.ADDRESS NXT
	. = $$RMSBLK+XAB$C_RDTLEN
	.ENDM	$XABRDT

	.MACRO	$XABSUM	NXT=0
	$XABDEF
	$XABSUMDEF
	$$RMSCHK
	.BYTE	XAB$C_SUM,XAB$C_SUMLEN
	. = $$RMSBLK+XAB$C_SUMLEN
	. = $$RMSBLK+XAB$L_NXT
	.ADDRESS NXT
	. = $$RMSBLK+XAB$C_SUMLEN
	.ENDM	$XABSUM

; $XABITM ITEMLIST,MODE,NXT (manual A-24)
;	MODE is SENSEMODE (the default) or SETMODE.

	.MACRO	$XABITM	ITEMLIST=0,MODE=SENSEMODE,NXT=0
	$XABDEF
	$XABITMDEF
	$$RMSCHK
	.BYTE	XAB$C_ITM,XAB$C_ITMLEN
	. = $$RMSBLK+XAB$C_ITMLEN
	. = $$RMSBLK+XAB$L_NXT
	.ADDRESS NXT
	. = $$RMSBLK+XAB$L_ITEMLIST
	.ADDRESS ITEMLIST
	. = $$RMSBLK+XAB$B_MODE
	$$RMSCODE $$RMSV,XAB$K_,MODE
	.BYTE	$$RMSV
	. = $$RMSBLK+XAB$C_ITMLEN
	.ENDM	$XABITM

; $XABKEY COLTBL,DAN,DFL,DTP,FLG,IAN,IFL,KNM,LAN,NUL,NXT,POS,PROLOG,REF,
;	SIZ (manual A-25)
;	POS and SIZ are one value, or a list of up to eight for a segmented
;	key. With no FLG, an alternate key (REF not 0) allows duplicates and
;	changes; a primary key may not change.

	.MACRO	$XABKEY	COLTBL=0,DAN=0,DFL=0,DTP=STG,FLG,IAN=0,IFL=0,KNM=0,-
			LAN=0,NUL=0,NXT=0,POS=0,PROLOG=0,REF=0,SIZ=0
	$XABDEF
	$XABKEYDEF
	$$RMSCHK
	.BYTE	XAB$C_KEY,XAB$C_KEYLEN
	. = $$RMSBLK+XAB$C_KEYLEN
	. = $$RMSBLK+XAB$B_DAN
	.BYTE	DAN
	. = $$RMSBLK+XAB$W_DFL
	.WORD	DFL
	. = $$RMSBLK+XAB$B_IAN
	.BYTE	IAN
	. = $$RMSBLK+XAB$W_IFL
	.WORD	IFL
	. = $$RMSBLK+XAB$L_KNM
	.ADDRESS KNM
	. = $$RMSBLK+XAB$B_LAN
	.BYTE	LAN
	. = $$RMSBLK+XAB$B_NUL
	.BYTE	NUL
	. = $$RMSBLK+XAB$B_REF
	.BYTE	REF
	. = $$RMSBLK+XAB$B_PROLOG
	.BYTE	PROLOG
	. = $$RMSBLK+XAB$L_COLTBL
	.ADDRESS COLTBL
	. = $$RMSBLK+XAB$L_COLSIZ
	.ADDRESS 0
	. = $$RMSBLK+XAB$L_COLNAM
	.ADDRESS 0
	. = $$RMSBLK+XAB$B_FLG
	.IF	B,<FLG>
	$$RMSV = 0
	.IIF	NE,REF,	$$RMSV = XAB$M_DUP!XAB$M_CHG
	.IFF
	$$RMSBITS $$RMSV,XAB$V_,<FLG>
	.IF	EQ,REF
	.IIF	NE,$$RMSV&XAB$M_CHG, .ERROR ; PRIMARY KEY MAY NOT CHANGE;
	.ENDC
	.ENDC
	.BYTE	$$RMSV
	. = $$RMSBLK+XAB$B_DTP
	$$RMSCODE $$RMSV,XAB$C_,DTP
	.BYTE	$$RMSV
	$$RMSV = $$RMSBLK+XAB$W_POS0
	.IRP	$$RMSX,<POS>
	. = $$RMSV
	.WORD	$$RMSX
	$$RMSV = $$RMSV+2
	.ENDR
	$$RMSV = $$RMSBLK+XAB$B_SIZ0
	.IRP	$$RMSX,<SIZ>
	. = $$RMSV
	.BYTE	$$RMSX
	$$RMSV = $$RMSV+1
	.ENDR
	. = $$RMSBLK+XAB$L_NXT
	.ADDRESS NXT
	. = $$RMSBLK+XAB$C_KEYLEN
	.ENDM	$XABKEY

; $XABPRO ACLBUF,ACLCTX,ACLSIZ,MTACC,NXT,PRO,PROT_OPT,UIC (manual A-28)
;	PRO is <system,owner,group,world>; with no PRO, the field is ^XFFFF.
;	UIC is <group,member>, each octal; anything else is an error.

	.MACRO	$XABPRO	ACLBUF=0,ACLCTX=0,ACLSIZ=0,MTACC=0,NXT=0,PRO,-
			PROT_OPT,UIC=<0,0>
	$XABDEF
	$XABPRODEF
	$$RMSCHK
	.BYTE	XAB$C_PRO,XAB$C_PROLEN
	. = $$RMSBLK+XAB$C_PROLEN
	$$RMSN = 0
	.IRP	$$RMSX,<UIC>
	$$RMSN = $$RMSN+1
	.ENDR
	.IIF	NE,$$RMSN-2, .ERROR ; INVALID UIC_FIELD;
	$$RMSV = XAB$W_GRP
	.IRP	$$RMSX,<UIC>
	. = $$RMSBLK+$$RMSV
	.WORD	^O'$$RMSX
	$$RMSV = XAB$W_MBM
	.ENDR
	. = $$RMSBLK+XAB$W_PRO
	$$RMSPRO $$RMSV,<PRO>
	.WORD	$$RMSV
	. = $$RMSBLK+XAB$B_MTACC
	.BYTE	MTACC
	. = $$RMSBLK+XAB$B_PROT_MODE
	.BYTE	0
	. = $$RMSBLK+XAB$B_PROT_OPT
	$$RMSBITS $$RMSV,XAB$V_,<PROT_OPT>
	.BYTE	$$RMSV
	. = $$RMSBLK+XAB$L_ACLBUF
	.ADDRESS ACLBUF
	. = $$RMSBLK+XAB$W_ACLSIZ
	.WORD	ACLSIZ
	. = $$RMSBLK+XAB$L_ACLCTX
	.ADDRESS ACLCTX
	. = $$RMSBLK+XAB$L_NXT
	.ADDRESS NXT
	. = $$RMSBLK+XAB$C_PROLEN
	.ENDM	$XABPRO

; $XABTRM ITMLST,ITMLST_LEN,NXT (manual A-35)

	.MACRO	$XABTRM	ITMLST=0,ITMLST_LEN=0,NXT=0
	$XABDEF
	$XABTRMDEF
	$$RMSCHK
	.BYTE	XAB$C_TRM,XAB$C_TRMLEN
	. = $$RMSBLK+XAB$C_TRMLEN
	. = $$RMSBLK+XAB$L_NXT
	.ADDRESS NXT
	. = $$RMSBLK+XAB$L_ITMLST
	.ADDRESS ITMLST
	. = $$RMSBLK+XAB$W_ITMLST_LEN
	.WORD	ITMLST_LEN
	. = $$RMSBLK+XAB$C_TRMLEN
	.ENDM	$XABTRM

; The RMS control block store macros (docs/PHASE-32.md, subtask 6),
; written from the RMS Reference Manual's appendices A and B and from the
; code real VAX MACRO assembled for govax's oracle probes. Each one
; defines its block's symbols, takes the block's address from the FAB=,
; RAB=, NAM=, or XAB= argument (a register is used as it is; an address
; is loaded into R0 with MOVAL; with neither, R0 holds it), and passes
; its arguments, by position, to an inner macro that stores each given
; field off that register:
;
;	an option or keyword field	MOVx #mask or MOVB #code
;	an address field		MOVAL value
;	a value field			MOVx value (by the field's size)
;	CHAN_MODE, LNM_MODE		INSV value into FAB$B_ACMODES
;	DID, FID, RFA, RFI		a register pair: MOVL Rn, MOVW Rn+1
;
; Each macro stores the fields given in a fixed order of its own, whatever
; order the call gives them in: the order the second oracle round's
; probes, which give every keyword at once, show (testdata/mar/rms,
; r2_order_*).
;
; Helper macros:
;
;   $$RMSBASE ARG
;	Set $$RMSR to 1 if ARG is a register; otherwise, if ARG is given,
;	MOVAL it into R0.
;
;   $$RMSOPT SIZE,PFX,LIST,FIELD,BASE,ALT
;	Store the options in LIST ($$RMSBITS) into FIELD(BASE).
;
;   $$RMSCHO PFX,X,FIELD,BASE
;	Store the code for the choice X ($$RMSCODE) into FIELD(BASE).
;
;   $$RMSPAIR VAL,FIELD,NAME,BASE
;	Store register pair VAL into the three-word FIELD(BASE). Anything
;	but a register, or R12, is an error.
;
;   $$RMSLIST SIZE,LIST,FIELD,STEP,BASE
;	Store each element of LIST into FIELD(BASE), STEP bytes apart.
;
;   $$RMSPROS PRO,FIELD,BASE and $$RMSUICS UIC,BASE
;	XABPRO's PRO and UIC: a list is stored as constants, and an address
;	as the value there. PRO is a list when it holds only the letters R,
;	W, E, and D, and commas (so PRO=RW is RW protection, not the word at
;	RW); UIC is a list when it holds a comma (so UIC=<377> is an address).
;	Both are real MACRO's rules (testdata/mar/rms, r2_pro_*, r2_uic_*).

	.MACRO	$$RMSBASE ARG
	$$RMSR = 0
	.IF	NB,<ARG>
	.NTYPE	$$RMSM,ARG
	.IF	EQ,<$$RMSM&^XF0>-^X50
	$$RMSR = 1
	.IFF
	MOVAL	ARG,R0
	.ENDC
	.ENDC
	.ENDM	$$RMSBASE

	.MACRO	$$RMSOPT SIZE,PFX,LIST,FIELD,BASE,ALT
	.IF	NB,<LIST>
	$$RMSBITS $$RMSV,PFX,<LIST>,ALT
	MOV'SIZE	#$$RMSV,FIELD(BASE)
	.ENDC
	.ENDM	$$RMSOPT

	.MACRO	$$RMSCHO PFX,X,FIELD,BASE
	.IF	NB,<X>
	$$RMSCODE $$RMSV,PFX,X
	MOVB	#$$RMSV,FIELD(BASE)
	.ENDC
	.ENDM	$$RMSCHO

	.MACRO	$$RMSPR2 N,FIELD,BASE
	MOVW	R'N,FIELD+4(BASE)
	.ENDM	$$RMSPR2

	.MACRO	$$RMSPAIR VAL,FIELD,NAME,BASE
	.IF	NB,<VAL>
	.NTYPE	$$RMSM,VAL
	.IF	EQ,<$$RMSM&^XF0>-^X50
	.IF	EQ,<$$RMSM&^XF>-12
	.ERROR	;ILLEGAL USE OF REGISTER : VAL ;
	.IFF
	MOVL	VAL,FIELD(BASE)
	$$RMSN = <$$RMSM&^XF>+1
	$$RMSPR2 \$$RMSN,FIELD,BASE
	.ENDC
	.IFF
	.ERROR	; ** VAL ** -- ILLEGAL ADDRESSING MODE FOR NAME;
	.ENDC
	.ENDC
	.ENDM	$$RMSPAIR

	.MACRO	$$RMSLIST SIZE,LIST,FIELD,STEP,BASE
	.IF	NB,<LIST>
	$$RMSI = 0
	.IRP	$$RMSX,<LIST>
	MOV'SIZE	$$RMSX,FIELD+$$RMSI(BASE)
	$$RMSI = $$RMSI+STEP
	.ENDR
	.ENDC
	.ENDM	$$RMSLIST

	.MACRO	$$RMSPROS PRO,FIELD,BASE
	.IF	NB,<PRO>
	$$RMSA = 0
	.IRPC	$$RMSL,<PRO>
	$$RMSA = $$RMSA+1
	.IIF	IDN,<$$RMSL>,<R>,	$$RMSA = $$RMSA-1
	.IIF	IDN,<$$RMSL>,<W>,	$$RMSA = $$RMSA-1
	.IIF	IDN,<$$RMSL>,<E>,	$$RMSA = $$RMSA-1
	.IIF	IDN,<$$RMSL>,<D>,	$$RMSA = $$RMSA-1
	.IIF	IDN,<$$RMSL>,<,>,	$$RMSA = $$RMSA-1
	.ENDR
	.IF	EQ,$$RMSA
	$$RMSPRO $$RMSV,<PRO>
	MOVW	#$$RMSV,FIELD(BASE)
	.IFF
	MOVW	PRO,FIELD(BASE)
	.ENDC
	.ENDC
	.ENDM	$$RMSPROS

	.MACRO	$$RMSUICS UIC,BASE
	.IF	NB,<UIC>
	.IF	LT,%LOCATE(<,>,<UIC>)-%LENGTH(<UIC>)
	$$RMSV = XAB$W_GRP
	.IRP	$$RMSX,<UIC>
	MOVW	#^O'$$RMSX,$$RMSV(BASE)
	$$RMSV = XAB$W_MBM
	.ENDR
	.IFF
	MOVL	UIC,XAB$L_UIC(BASE)
	.ENDC
	.ENDC
	.ENDM	$$RMSUICS

	.MACRO	$FAB_STORE	FAB,FAC,FOP,ORG,RAT,RFM,SHR,DNA,FNA,-
			NAM,XAB,ALQ,BKS,BLS,CHAN_MODE,CTX,DEQ,DNS,FNS,-
			FSZ,GBC,LNM_MODE,MRN,MRS,RTV
	$FABDEF
	$$RMSBASE	FAB
	.IF	NE,$$RMSR
	$$FAB_STO	FAB,<FAC>,<FOP>,<ORG>,<RAT>,<RFM>,<SHR>,<DNA>,-
			<FNA>,<NAM>,<XAB>,<ALQ>,<BKS>,<BLS>,-
			<CHAN_MODE>,<CTX>,<DEQ>,<DNS>,<FNS>,<FSZ>,-
			<GBC>,<LNM_MODE>,<MRN>,<MRS>,<RTV>
	.IFF
	$$FAB_STO	R0,<FAC>,<FOP>,<ORG>,<RAT>,<RFM>,<SHR>,<DNA>,-
			<FNA>,<NAM>,<XAB>,<ALQ>,<BKS>,<BLS>,-
			<CHAN_MODE>,<CTX>,<DEQ>,<DNS>,<FNS>,<FSZ>,-
			<GBC>,<LNM_MODE>,<MRN>,<MRS>,<RTV>
	.ENDC
	.ENDM	$FAB_STORE

	.MACRO	$$FAB_STO	$$B,FAC,FOP,ORG,RAT,RFM,SHR,DNA,FNA,-
			NAM,XAB,ALQ,BKS,BLS,CHAN_MODE,CTX,DEQ,DNS,FNS,-
			FSZ,GBC,LNM_MODE,MRN,MRS,RTV
	$$RMSOPT	B,FAB$V_,<FAC>,FAB$B_FAC,$$B,
	$$RMSOPT	B,FAB$V_,<SHR>,FAB$B_SHR,$$B,FAB$V_SHR
	.IIF	NB,<FNA>,	MOVAL	FNA,FAB$L_FNA($$B)
	.IIF	NB,<FNS>,	MOVB	FNS,FAB$B_FNS($$B)
	.IIF	NB,<DNA>,	MOVAL	DNA,FAB$L_DNA($$B)
	.IIF	NB,<DNS>,	MOVB	DNS,FAB$B_DNS($$B)
	.IIF	NB,<RTV>,	MOVB	RTV,FAB$B_RTV($$B)
	$$RMSCHO	FAB$C_,ORG,FAB$B_ORG,$$B
	$$RMSOPT	B,FAB$V_,<RAT>,FAB$B_RAT,$$B,
	$$RMSOPT	L,FAB$V_,<FOP>,FAB$L_FOP,$$B,
	.IIF	NB,<XAB>,	MOVAL	XAB,FAB$L_XAB($$B)
	.IIF	NB,<MRS>,	MOVW	MRS,FAB$W_MRS($$B)
	.IIF	NB,<MRN>,	MOVL	MRN,FAB$L_MRN($$B)
	.IIF	NB,<ALQ>,	MOVL	ALQ,FAB$L_ALQ($$B)
	.IIF	NB,<DEQ>,	MOVW	DEQ,FAB$W_DEQ($$B)
	.IIF	NB,<BLS>,	MOVW	BLS,FAB$W_BLS($$B)
	.IIF	NB,<NAM>,	MOVAL	NAM,FAB$L_NAM($$B)
	$$RMSCHO	FAB$C_,RFM,FAB$B_RFM,$$B
	.IIF	NB,<FSZ>,	MOVB	FSZ,FAB$B_FSZ($$B)
	.IIF	NB,<BKS>,	MOVB	BKS,FAB$B_BKS($$B)
	.IIF	NB,<GBC>,	MOVW	GBC,FAB$W_GBC($$B)
	.IIF	NB,<LNM_MODE>,	INSV	LNM_MODE,#FAB$V_LNM_MODE,#FAB$S_LNM_MODE,FAB$B_ACMODES($$B)
	.IIF	NB,<CHAN_MODE>,	INSV	CHAN_MODE,#FAB$V_CHAN_MODE,#FAB$S_CHAN_MODE,FAB$B_ACMODES($$B)
	.IIF	NB,<CTX>,	MOVL	CTX,FAB$L_CTX($$B)
	.ENDM	$$FAB_STO

	.MACRO	$RAB_STORE	RAB,RAC,ROP,FAB,KBF,PBF,RBF,RHB,UBF,-
			XAB,BKT,CTX,KRF,KSZ,MBC,MBF,PSZ,RFA,RSZ,TMO,-
			USZ
	$RABDEF
	$$RMSBASE	RAB
	.IF	NE,$$RMSR
	$$RAB_STO	RAB,<RAC>,<ROP>,<FAB>,<KBF>,<PBF>,<RBF>,<RHB>,-
			<UBF>,<XAB>,<BKT>,<CTX>,<KRF>,<KSZ>,<MBC>,-
			<MBF>,<PSZ>,<RFA>,<RSZ>,<TMO>,<USZ>
	.IFF
	$$RAB_STO	R0,<RAC>,<ROP>,<FAB>,<KBF>,<PBF>,<RBF>,<RHB>,-
			<UBF>,<XAB>,<BKT>,<CTX>,<KRF>,<KSZ>,<MBC>,-
			<MBF>,<PSZ>,<RFA>,<RSZ>,<TMO>,<USZ>
	.ENDC
	.ENDM	$RAB_STORE

	.MACRO	$$RAB_STO	$$B,RAC,ROP,FAB,KBF,PBF,RBF,RHB,UBF,-
			XAB,BKT,CTX,KRF,KSZ,MBC,MBF,PSZ,RFA,RSZ,TMO,-
			USZ
	$$RMSCHO	RAB$C_,RAC,RAB$B_RAC,$$B
	$$RMSOPT	L,RAB$V_,<ROP>,RAB$L_ROP,$$B,
	.IIF	NB,<UBF>,	MOVAL	UBF,RAB$L_UBF($$B)
	.IIF	NB,<USZ>,	MOVW	USZ,RAB$W_USZ($$B)
	.IIF	NB,<RBF>,	MOVAL	RBF,RAB$L_RBF($$B)
	.IIF	NB,<RSZ>,	MOVW	RSZ,RAB$W_RSZ($$B)
	.IIF	NB,<BKT>,	MOVL	BKT,RAB$L_BKT($$B)
	.IIF	NB,<KBF>,	MOVAL	KBF,RAB$L_KBF($$B)
	.IIF	NB,<PBF>,	MOVAL	PBF,RAB$L_PBF($$B)
	.IIF	NB,<KSZ>,	MOVB	KSZ,RAB$B_KSZ($$B)
	.IIF	NB,<PSZ>,	MOVB	PSZ,RAB$B_PSZ($$B)
	.IIF	NB,<RHB>,	MOVAL	RHB,RAB$L_RHB($$B)
	.IIF	NB,<FAB>,	MOVAL	FAB,RAB$L_FAB($$B)
	.IIF	NB,<XAB>,	MOVAL	XAB,RAB$L_XAB($$B)
	.IIF	NB,<MBF>,	MOVB	MBF,RAB$B_MBF($$B)
	.IIF	NB,<MBC>,	MOVB	MBC,RAB$B_MBC($$B)
	.IIF	NB,<TMO>,	MOVB	TMO,RAB$B_TMO($$B)
	.IIF	NB,<CTX>,	MOVL	CTX,RAB$L_CTX($$B)
	.IIF	NB,<KRF>,	MOVB	KRF,RAB$B_KRF($$B)
	$$RMSPAIR	RFA,RAB$W_RFA,_RFA,$$B
	.ENDM	$$RAB_STO

	.MACRO	$NAM_STORE	NAM,NOP,ESA,RLF,RSA,DID,DVI,ESS,FID,-
			RSS
	$NAMDEF
	$$RMSBASE	NAM
	.IF	NE,$$RMSR
	$$NAM_STO	NAM,<NOP>,<ESA>,<RLF>,<RSA>,<DID>,<DVI>,<ESS>,-
			<FID>,<RSS>
	.IFF
	$$NAM_STO	R0,<NOP>,<ESA>,<RLF>,<RSA>,<DID>,<DVI>,<ESS>,-
			<FID>,<RSS>
	.ENDC
	.ENDM	$NAM_STORE

	.MACRO	$$NAM_STO	$$B,NOP,ESA,RLF,RSA,DID,DVI,ESS,FID,-
			RSS
	.IIF	NB,<RSA>,	MOVAL	RSA,NAM$L_RSA($$B)
	.IIF	NB,<RSS>,	MOVB	RSS,NAM$B_RSS($$B)
	$$RMSOPT	B,NAM$V_,<NOP>,NAM$B_NOP,$$B,
	.IIF	NB,<ESA>,	MOVAL	ESA,NAM$L_ESA($$B)
	.IIF	NB,<ESS>,	MOVB	ESS,NAM$B_ESS($$B)
	.IIF	NB,<RLF>,	MOVAL	RLF,NAM$L_RLF($$B)
	$$RMSPAIR	FID,NAM$W_FID,_FID,$$B
	$$RMSPAIR	DID,NAM$W_DID,_DID,$$B
	.IIF	NB,<DVI>,	.ERROR ; ** DVI ** -- ILLEGAL ADDRESSING MODE FOR _DVI;
	.ENDM	$$NAM_STO

	.MACRO	$XABALL_STORE	XAB,ALN,AOP,NXT,AID,ALQ,BKZ,DEQ,LOC,-
			RFI,VOL
	$XABDEF
	$XABALLDEF
	$$RMSBASE	XAB
	.IF	NE,$$RMSR
	$$XABALL_STO	XAB,<ALN>,<AOP>,<NXT>,<AID>,<ALQ>,<BKZ>,<DEQ>,-
			<LOC>,<RFI>,<VOL>
	.IFF
	$$XABALL_STO	R0,<ALN>,<AOP>,<NXT>,<AID>,<ALQ>,<BKZ>,<DEQ>,-
			<LOC>,<RFI>,<VOL>
	.ENDC
	.ENDM	$XABALL_STORE

	.MACRO	$$XABALL_STO	$$B,ALN,AOP,NXT,AID,ALQ,BKZ,DEQ,LOC,-
			RFI,VOL
	.IIF	NB,<VOL>,	MOVW	VOL,XAB$W_VOL($$B)
	$$RMSCHO	XAB$C_,ALN,XAB$B_ALN,$$B
	$$RMSOPT	B,XAB$V_,<AOP>,XAB$B_AOP,$$B,
	.IIF	NB,<LOC>,	MOVL	LOC,XAB$L_LOC($$B)
	.IIF	NB,<ALQ>,	MOVL	ALQ,XAB$L_ALQ($$B)
	.IIF	NB,<NXT>,	MOVAL	NXT,XAB$L_NXT($$B)
	.IIF	NB,<DEQ>,	MOVW	DEQ,XAB$W_DEQ($$B)
	.IIF	NB,<AID>,	MOVB	AID,XAB$B_AID($$B)
	.IIF	NB,<BKZ>,	MOVB	BKZ,XAB$B_BKZ($$B)
	$$RMSPAIR	RFI,XAB$W_RFI,_RFI,$$B
	.ENDM	$$XABALL_STO

	.MACRO	$XABDAT_STORE	XAB,NXT,CDT,EDT,RDT,RVN
	$XABDEF
	$XABDATDEF
	$$RMSBASE	XAB
	.IF	NE,$$RMSR
	$$XABDAT_STO	XAB,<NXT>,<CDT>,<EDT>,<RDT>,<RVN>
	.IFF
	$$XABDAT_STO	R0,<NXT>,<CDT>,<EDT>,<RDT>,<RVN>
	.ENDC
	.ENDM	$XABDAT_STORE

	.MACRO	$$XABDAT_STO	$$B,NXT,CDT,EDT,RDT,RVN
	.IIF	NB,<EDT>,	MOVQ	EDT,XAB$Q_EDT($$B)
	.IIF	NB,<NXT>,	MOVAL	NXT,XAB$L_NXT($$B)
	.IIF	NB,<RVN>,	MOVW	RVN,XAB$W_RVN($$B)
	.IIF	NB,<RDT>,	MOVQ	RDT,XAB$Q_RDT($$B)
	.IIF	NB,<CDT>,	MOVQ	CDT,XAB$Q_CDT($$B)
	.ENDM	$$XABDAT_STO

	.MACRO	$XABFHC_STORE	XAB,NXT
	$XABDEF
	$XABFHCDEF
	$$RMSBASE	XAB
	.IF	NE,$$RMSR
	$$XABFHC_STO	XAB,<NXT>
	.IFF
	$$XABFHC_STO	R0,<NXT>
	.ENDC
	.ENDM	$XABFHC_STORE

	.MACRO	$$XABFHC_STO	$$B,NXT
	.IIF	NB,<NXT>,	MOVAL	NXT,XAB$L_NXT($$B)
	.ENDM	$$XABFHC_STO

	.MACRO	$XABKEY_STORE	XAB,DTP,FLG,COLTBL,KNM,NXT,DAN,DFL,-
			IAN,IFL,LAN,NUL,POS,POS0,POS1,POS2,POS3,POS4,-
			POS5,POS6,POS7,PROLOG,REF,SIZ,SIZ0,SIZ1,SIZ2,-
			SIZ3,SIZ4,SIZ5,SIZ6,SIZ7
	$XABDEF
	$XABKEYDEF
	$$RMSBASE	XAB
	.IF	NE,$$RMSR
	$$XABKEY_STO	XAB,<DTP>,<FLG>,<COLTBL>,<KNM>,<NXT>,<DAN>,-
			<DFL>,<IAN>,<IFL>,<LAN>,<NUL>,<POS>,<POS0>,-
			<POS1>,<POS2>,<POS3>,<POS4>,<POS5>,<POS6>,-
			<POS7>,<PROLOG>,<REF>,<SIZ>,<SIZ0>,<SIZ1>,-
			<SIZ2>,<SIZ3>,<SIZ4>,<SIZ5>,<SIZ6>,<SIZ7>
	.IFF
	$$XABKEY_STO	R0,<DTP>,<FLG>,<COLTBL>,<KNM>,<NXT>,<DAN>,-
			<DFL>,<IAN>,<IFL>,<LAN>,<NUL>,<POS>,<POS0>,-
			<POS1>,<POS2>,<POS3>,<POS4>,<POS5>,<POS6>,-
			<POS7>,<PROLOG>,<REF>,<SIZ>,<SIZ0>,<SIZ1>,-
			<SIZ2>,<SIZ3>,<SIZ4>,<SIZ5>,<SIZ6>,<SIZ7>
	.ENDC
	.ENDM	$XABKEY_STORE

	.MACRO	$$XABKEY_STO	$$B,DTP,FLG,COLTBL,KNM,NXT,DAN,DFL,-
			IAN,IFL,LAN,NUL,POS,POS0,POS1,POS2,POS3,POS4,-
			POS5,POS6,POS7,PROLOG,REF,SIZ,SIZ0,SIZ1,SIZ2,-
			SIZ3,SIZ4,SIZ5,SIZ6,SIZ7
	.IIF	NB,<PROLOG>,	MOVB	PROLOG,XAB$B_PROLOG($$B)
	.IIF	NB,<COLTBL>,	MOVAL	COLTBL,XAB$L_COLTBL($$B)
	.IIF	NB,<DAN>,	MOVB	DAN,XAB$B_DAN($$B)
	.IIF	NB,<DFL>,	MOVW	DFL,XAB$W_DFL($$B)
	$$RMSCHO	XAB$C_,DTP,XAB$B_DTP,$$B
	$$RMSOPT	B,XAB$V_,<FLG>,XAB$B_FLG,$$B,
	.IIF	NB,<IAN>,	MOVB	IAN,XAB$B_IAN($$B)
	.IIF	NB,<IFL>,	MOVW	IFL,XAB$W_IFL($$B)
	.IIF	NB,<KNM>,	MOVAL	KNM,XAB$L_KNM($$B)
	.IIF	NB,<LAN>,	MOVB	LAN,XAB$B_LAN($$B)
	.IIF	NB,<NUL>,	MOVB	NUL,XAB$B_NUL($$B)
	$$RMSLIST	W,<POS>,XAB$W_POS0,2,$$B
	.IIF	NB,<POS0>,	MOVW	POS0,XAB$W_POS0($$B)
	.IIF	NB,<POS1>,	MOVW	POS1,XAB$W_POS1($$B)
	.IIF	NB,<POS2>,	MOVW	POS2,XAB$W_POS2($$B)
	.IIF	NB,<POS3>,	MOVW	POS3,XAB$W_POS3($$B)
	.IIF	NB,<POS4>,	MOVW	POS4,XAB$W_POS4($$B)
	.IIF	NB,<POS5>,	MOVW	POS5,XAB$W_POS5($$B)
	.IIF	NB,<POS6>,	MOVW	POS6,XAB$W_POS6($$B)
	.IIF	NB,<POS7>,	MOVW	POS7,XAB$W_POS7($$B)
	.IIF	NB,<REF>,	MOVB	REF,XAB$B_REF($$B)
	$$RMSLIST	B,<SIZ>,XAB$B_SIZ0,1,$$B
	.IIF	NB,<SIZ0>,	MOVB	SIZ0,XAB$B_SIZ0($$B)
	.IIF	NB,<SIZ1>,	MOVB	SIZ1,XAB$B_SIZ1($$B)
	.IIF	NB,<SIZ2>,	MOVB	SIZ2,XAB$B_SIZ2($$B)
	.IIF	NB,<SIZ3>,	MOVB	SIZ3,XAB$B_SIZ3($$B)
	.IIF	NB,<SIZ4>,	MOVB	SIZ4,XAB$B_SIZ4($$B)
	.IIF	NB,<SIZ5>,	MOVB	SIZ5,XAB$B_SIZ5($$B)
	.IIF	NB,<SIZ6>,	MOVB	SIZ6,XAB$B_SIZ6($$B)
	.IIF	NB,<SIZ7>,	MOVB	SIZ7,XAB$B_SIZ7($$B)
	.IIF	NB,<NXT>,	MOVAL	NXT,XAB$L_NXT($$B)
	.ENDM	$$XABKEY_STO

	.MACRO	$XABPRO_STORE	XAB,PRO,PROT_OPT,ACLBUF,NXT,ACLCTX,-
			ACLSIZ,MTACC,UIC
	$XABDEF
	$XABPRODEF
	$$RMSBASE	XAB
	.IF	NE,$$RMSR
	$$XABPRO_STO	XAB,<PRO>,<PROT_OPT>,<ACLBUF>,<NXT>,<ACLCTX>,-
			<ACLSIZ>,<MTACC>,<UIC>
	.IFF
	$$XABPRO_STO	R0,<PRO>,<PROT_OPT>,<ACLBUF>,<NXT>,<ACLCTX>,-
			<ACLSIZ>,<MTACC>,<UIC>
	.ENDC
	.ENDM	$XABPRO_STORE

	.MACRO	$$XABPRO_STO	$$B,PRO,PROT_OPT,ACLBUF,NXT,ACLCTX,-
			ACLSIZ,MTACC,UIC
	.IIF	NB,<NXT>,	MOVAL	NXT,XAB$L_NXT($$B)
	.IIF	NB,<MTACC>,	MOVB	MTACC,XAB$B_MTACC($$B)
	$$RMSOPT	B,XAB$V_,<PROT_OPT>,XAB$B_PROT_OPT,$$B,
	.IIF	NB,<ACLBUF>,	MOVAL	ACLBUF,XAB$L_ACLBUF($$B)
	.IIF	NB,<ACLSIZ>,	MOVW	ACLSIZ,XAB$W_ACLSIZ($$B)
	.IIF	NB,<ACLCTX>,	MOVL	ACLCTX,XAB$L_ACLCTX($$B)
	$$RMSPROS	<PRO>,XAB$W_PRO,$$B
	$$RMSUICS	<UIC>,$$B
	.ENDM	$$XABPRO_STO

	.MACRO	$XABRDT_STORE	XAB,NXT,RDT,RVN
	$XABDEF
	$XABRDTDEF
	$$RMSBASE	XAB
	.IF	NE,$$RMSR
	$$XABRDT_STO	XAB,<NXT>,<RDT>,<RVN>
	.IFF
	$$XABRDT_STO	R0,<NXT>,<RDT>,<RVN>
	.ENDC
	.ENDM	$XABRDT_STORE

	.MACRO	$$XABRDT_STO	$$B,NXT,RDT,RVN
	.IIF	NB,<NXT>,	MOVAL	NXT,XAB$L_NXT($$B)
	.IIF	NB,<RVN>,	MOVW	RVN,XAB$W_RVN($$B)
	.IIF	NB,<RDT>,	MOVQ	RDT,XAB$Q_RDT($$B)
	.ENDM	$$XABRDT_STO

	.MACRO	$XABSUM_STORE	XAB,NXT
	$XABDEF
	$XABSUMDEF
	$$RMSBASE	XAB
	.IF	NE,$$RMSR
	$$XABSUM_STO	XAB,<NXT>
	.IFF
	$$XABSUM_STO	R0,<NXT>
	.ENDC
	.ENDM	$XABSUM_STORE

	.MACRO	$$XABSUM_STO	$$B,NXT
	.IIF	NB,<NXT>,	MOVAL	NXT,XAB$L_NXT($$B)
	.ENDM	$$XABSUM_STO

	.MACRO	$XABTRM_STORE	XAB,ITMLST,NXT,ITMLST_LEN
	$XABDEF
	$XABTRMDEF
	$$RMSBASE	XAB
	.IF	NE,$$RMSR
	$$XABTRM_STO	XAB,<ITMLST>,<NXT>,<ITMLST_LEN>
	.IFF
	$$XABTRM_STO	R0,<ITMLST>,<NXT>,<ITMLST_LEN>
	.ENDC
	.ENDM	$XABTRM_STORE

	.MACRO	$$XABTRM_STO	$$B,ITMLST,NXT,ITMLST_LEN
	.IIF	NB,<NXT>,	MOVAL	NXT,XAB$L_NXT($$B)
	.IIF	NB,<ITMLST>,	MOVAL	ITMLST,XAB$L_ITMLST($$B)
	.IIF	NB,<ITMLST_LEN>,	MOVW	ITMLST_LEN,XAB$W_ITMLST_LEN($$B)
	.ENDM	$$XABTRM_STO

; The RMS service macros (docs/PHASE-32.md, subtask 7), from the RMS
; Reference Manual's appendix B and part III and the code real VAX MACRO
; assembled for the oracle's probes. With no arguments, a service macro
; calls the service with the argument list AP addresses (CALLG). With
; them, it pushes the list and calls with CALLS: the control block, then
; ERR and SUC, each an address. A control block in a register is pushed
; as it is (PUSHL); anything else is an address (PUSHAL). An omitted ERR
; before a given SUC is pushed as 0. $RENAME takes OLDFAB, ERR, SUC, and
; NEWFAB, always as four arguments; $WAIT takes only RAB.
;
; Helper macros:
;
;   $$RMSPUSH ARG
;	Push ARG: PUSHL for a register, PUSHAL otherwise.
;
;   $$RMSSVC NAME,BLOCK,ERR,SUC
;	Call SYS$NAME with BLOCK and the completion routines ERR and SUC.
;
; Each service is declared .GLOBL, as the system service macros declare
; theirs: real MACRO's listings show the RMS services as global (GX) in
; the symbol table, where a symbol that's only referred to is external
; (X) (docs/PHASE-29.md, subtask 6).

	.MACRO	$$RMSPUSH ARG
	.NTYPE	$$RMSM,ARG
	.IF	EQ,<$$RMSM&^XF0>-^X50
	PUSHL	ARG
	.IFF
	PUSHAL	ARG
	.ENDC
	.ENDM	$$RMSPUSH

	.MACRO	$$RMSSVC NAME,BLOCK,ERR,SUC
	.GLOBL	SYS$'NAME
	.IF	B,<BLOCK>
	CALLG	(AP),G^SYS$'NAME
	.MEXIT
	.ENDC
	.IF	NB,<SUC>
	PUSHAL	SUC
	.IF	NB,<ERR>
	PUSHAL	ERR
	.IFF
	PUSHL	#0
	.ENDC
	$$RMSPUSH BLOCK
	CALLS	#3,G^SYS$'NAME
	.MEXIT
	.ENDC
	.IF	NB,<ERR>
	PUSHAL	ERR
	$$RMSPUSH BLOCK
	CALLS	#2,G^SYS$'NAME
	.MEXIT
	.ENDC
	$$RMSPUSH BLOCK
	CALLS	#1,G^SYS$'NAME
	.ENDM	$$RMSSVC

	.MACRO	$CLOSE	FAB,ERR,SUC
	$$RMSSVC CLOSE,<FAB>,<ERR>,<SUC>
	.ENDM	$CLOSE

	.MACRO	$CREATE	FAB,ERR,SUC
	$$RMSSVC CREATE,<FAB>,<ERR>,<SUC>
	.ENDM	$CREATE

	.MACRO	$DISPLAY	FAB,ERR,SUC
	$$RMSSVC DISPLAY,<FAB>,<ERR>,<SUC>
	.ENDM	$DISPLAY

	.MACRO	$ENTER	FAB,ERR,SUC
	$$RMSSVC ENTER,<FAB>,<ERR>,<SUC>
	.ENDM	$ENTER

	.MACRO	$ERASE	FAB,ERR,SUC
	$$RMSSVC ERASE,<FAB>,<ERR>,<SUC>
	.ENDM	$ERASE

	.MACRO	$EXTEND	FAB,ERR,SUC
	$$RMSSVC EXTEND,<FAB>,<ERR>,<SUC>
	.ENDM	$EXTEND

	.MACRO	$OPEN	FAB,ERR,SUC
	$$RMSSVC OPEN,<FAB>,<ERR>,<SUC>
	.ENDM	$OPEN

	.MACRO	$PARSE	FAB,ERR,SUC
	$$RMSSVC PARSE,<FAB>,<ERR>,<SUC>
	.ENDM	$PARSE

	.MACRO	$REMOVE	FAB,ERR,SUC
	$$RMSSVC REMOVE,<FAB>,<ERR>,<SUC>
	.ENDM	$REMOVE

	.MACRO	$SEARCH	FAB,ERR,SUC
	$$RMSSVC SEARCH,<FAB>,<ERR>,<SUC>
	.ENDM	$SEARCH

	.MACRO	$CONNECT	RAB,ERR,SUC
	$$RMSSVC CONNECT,<RAB>,<ERR>,<SUC>
	.ENDM	$CONNECT

	.MACRO	$DELETE	RAB,ERR,SUC
	$$RMSSVC DELETE,<RAB>,<ERR>,<SUC>
	.ENDM	$DELETE

	.MACRO	$DISCONNECT	RAB,ERR,SUC
