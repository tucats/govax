	.ENDM	$DISCONNECT

	.MACRO	$FIND	RAB,ERR,SUC
	$$RMSSVC FIND,<RAB>,<ERR>,<SUC>
	.ENDM	$FIND

	.MACRO	$FLUSH	RAB,ERR,SUC
	$$RMSSVC FLUSH,<RAB>,<ERR>,<SUC>
	.ENDM	$FLUSH

	.MACRO	$FREE	RAB,ERR,SUC
	$$RMSSVC FREE,<RAB>,<ERR>,<SUC>
	.ENDM	$FREE

	.MACRO	$GET	RAB,ERR,SUC
	$$RMSSVC GET,<RAB>,<ERR>,<SUC>
	.ENDM	$GET

	.MACRO	$NXTVOL	RAB,ERR,SUC
	$$RMSSVC NXTVOL,<RAB>,<ERR>,<SUC>
	.ENDM	$NXTVOL

	.MACRO	$PUT	RAB,ERR,SUC
	$$RMSSVC PUT,<RAB>,<ERR>,<SUC>
	.ENDM	$PUT

	.MACRO	$READ	RAB,ERR,SUC
	$$RMSSVC READ,<RAB>,<ERR>,<SUC>
	.ENDM	$READ

	.MACRO	$RELEASE	RAB,ERR,SUC
