; STARLET.MAR: govax's own system macros.
;
; This is the source of govax's STARLET.MLB, the macro library MACRO uses
; when neither SYS$LIBRARY:STARLET.MLB on a mounted volume nor STARLET.MLB
; in the host library directory exists. The macros are written from the
; argument lists in the OpenVMS System Services Reference Manual, not
; copied from VMS's STARLET, and a test (internal/asm) checks that each
; call expands to the same code as the real library's.
;
; After changing this file, run "go generate ./internal/bootdata" to
; rebuild starlet.mlb; a test fails if the two don't match. The library is
; built as LIBRARY/CREATE/MACRO builds one, which squeezes out comments
; (from each line's last semicolon), so keep semicolons out of strings.
;
; Helper macros:
;
;   $PUSHADR ADDR,CONTEXT=L
;	Push the address of an argument passed by reference, or zero for an
;	omitted one (0). CONTEXT is the operand's size (B, W, L, Q), which
;	matters only for an addressing mode whose address depends on it:
;	a literal (short or immediate), autoincrement, autodecrement, or an
;	indexed operand. Everything else is pushed with PUSHAB. A literal
;	is recognized by its "#" (absolute mode's "@#" isn't one), not by
;	.NTYPE, so it doesn't matter how .NTYPE numbers the PC modes.
;
;   $PUSHVALS A,B
;	Push two longwords passed by value, A first, or clear a quadword
;	when both are #0.
;
;   $PUSHVALADR VAL,ADDR,CONTEXT=L
;	Push VAL by value, then ADDR by reference, or clear a quadword when
;	VAL is #0 and ADDR is 0.
;
;   $PUSHADRVAL ADDR,VAL,CONTEXT=L
;	Push ADDR by reference, then VAL by value, or clear a quadword when
;	ADDR is 0 and VAL is #0.
;
; (The helpers pass CONTEXT on to $PUSHADR by position: written as
; CONTEXT=CONTEXT, the formal name is replaced on both sides of the "=".)
;
; An argument list is pushed last argument first, so each service macro
; pushes its arguments in the reverse of their order in the call.

	.MACRO	$PUSHADR ADDR,CONTEXT=L
	.IF	IDN,<0>,<ADDR>
	PUSHL	#0
	.MEXIT
	.ENDC
	$$SIZED = 0
	.IIF	LT,%LOCATE(<#>,ADDR)-%LENGTH(ADDR),	$$SIZED = 1	; literal
	.IIF	LT,%LOCATE(<@#>,ADDR)-%LENGTH(ADDR),	$$SIZED = 0	; absolute
	.NTYPE	$$MODE,ADDR
	.IIF	NE,<$$MODE&^XFF00>,	$$SIZED = 1	; indexed
	.IIF	EQ,<$$MODE&^XF0>-^X70,	$$SIZED = 1	; autodecrement
	.IIF	EQ,<$$MODE&^XF0>-^X80,	$$SIZED = 1	; autoincrement
	.IF	NE,$$SIZED
	PUSHA'CONTEXT	ADDR
	.IFF
	PUSHAB	ADDR
	.ENDC
	.ENDM	$PUSHADR

	.MACRO	$PUSHVALS A,B
	.IF	IDN,<#0>,<A>
	.IF	IDN,<#0>,<B>
	CLRQ	-(SP)
	.MEXIT
	.ENDC
	.ENDC
	PUSHL	A
	PUSHL	B
	.ENDM	$PUSHVALS

	.MACRO	$PUSHVALADR VAL,ADDR,CONTEXT=L
	.IF	IDN,<#0>,<VAL>
	.IF	IDN,<0>,<ADDR>
	CLRQ	-(SP)
	.MEXIT
	.ENDC
	.ENDC
	PUSHL	VAL
	$PUSHADR ADDR,CONTEXT
	.ENDM	$PUSHVALADR

	.MACRO	$PUSHADRVAL ADDR,VAL,CONTEXT=L
	.IF	IDN,<0>,<ADDR>
	.IF	IDN,<#0>,<VAL>
	CLRQ	-(SP)
	.MEXIT
	.ENDC
	.ENDC
	$PUSHADR ADDR,CONTEXT
	PUSHL	VAL
	.ENDM	$PUSHADRVAL

; $ASSIGN devnam, chan, [acmode], [mbxnam], [flags]
;	devnam and mbxnam are descriptors, by reference. chan is a word
;	written by the service, by reference. acmode and flags are by value.

	.MACRO	$ASSIGN_S DEVNAM,CHAN,ACMODE=#0,MBXNAM=0,FLAGS=#0
	.GLOBL	SYS$ASSIGN
	PUSHL	FLAGS
	$PUSHADRVAL MBXNAM,ACMODE,CONTEXT=Q
	$PUSHADR CHAN,CONTEXT=W
	$PUSHADR DEVNAM,CONTEXT=Q
	CALLS	#5,G^SYS$ASSIGN
	.ENDM	$ASSIGN_S

; $DASSGN chan
;	chan is a word, by value.

	.MACRO	$DASSGN_S CHAN
	.GLOBL	SYS$DASSGN
	MOVZWL	CHAN,-(SP)
	CALLS	#1,G^SYS$DASSGN
	.ENDM	$DASSGN_S

; $EXIT [code]
;	code is a longword, by value.

	.MACRO	$EXIT_S	CODE=#1
	.GLOBL	SYS$EXIT
	PUSHL	CODE
	CALLS	#1,G^SYS$EXIT
	.ENDM	$EXIT_S

; $QIO [efn], chan, func, [iosb], [astadr], [astprm], [p1]...[p6]
; $QIOW takes the same arguments.
;	efn and astprm are longwords, by value. chan and func are words, by
;	value. iosb is a quadword, by reference, and astadr a procedure, by
;	reference. p1 is by reference (a buffer's address), and p2 through
;	p6 by value.

	.MACRO	$QIO_S	EFN=#0,CHAN,FUNC,IOSB=0,ASTADR=0,ASTPRM=#0,-
			P1=0,P2=#0,P3=#0,P4=#0,P5=#0,P6=#0
	.GLOBL	SYS$QIO
	$PUSHVALS P6,P5
	$PUSHVALS P4,P3
	PUSHL	P2
	$PUSHADR P1
	$PUSHVALADR ASTPRM,ASTADR
	$PUSHADR IOSB,CONTEXT=Q
	MOVZWL	FUNC,-(SP)
	MOVZWL	CHAN,-(SP)
	PUSHL	EFN
	CALLS	#12,G^SYS$QIO
	.ENDM	$QIO_S

	.MACRO	$QIOW_S	EFN=#0,CHAN,FUNC,IOSB=0,ASTADR=0,ASTPRM=#0,-
			P1=0,P2=#0,P3=#0,P4=#0,P5=#0,P6=#0
	.GLOBL	SYS$QIOW
	$PUSHVALS P6,P5
	$PUSHVALS P4,P3
	PUSHL	P2
	$PUSHADR P1
	$PUSHVALADR ASTPRM,ASTADR
	$PUSHADR IOSB,CONTEXT=Q
	MOVZWL	FUNC,-(SP)
	MOVZWL	CHAN,-(SP)
	PUSHL	EFN
	CALLS	#12,G^SYS$QIOW
	.ENDM	$QIOW_S

; The process-management and related services (docs/PHASE-45.md, "the
; process-service macros"), written from the System Services Reference
; Manual's argument lists and checked against real MACRO's objects for the
; probes in testdata/mp/macros. NAME_S comes first; the argument-list form
; (NAME) and NAME_G follow further down. $CREPRC's two last arguments are the
; keywords ITMLST and NODE (round 3 found them; "have no keyword" below is
; what the first probes thought).
;
; What the probes showed, beyond the argument lists: a macro pushes an
; omitted argument as zero ($PUSHADR, PUSHL #0); a word argument is pushed
; with MOVZWL; each macro pairs particular adjacent arguments, which
; become one CLRQ when both are omitted or #0 ($GETJPI's ASTPRM and
; ASTADR, $GETDVI's NULLARG and ASTPRM, $CREMBX's LOGNAM and ACMODE and
; its PROMSK and BUFQUO, $SETIMR's REQIDT and FLAGS and its DAYTIM and
; EFN, $CREPRC's UIC and BASPRI, $CANTIM's two); and
; $CREPRC passes two arguments past STSFLG (ITMLST and NODE), as zeros,
; and $GETDVI and $CREMBX have a last one with a keyword (NULLARG, FLAGS).
; A missing required argument is an error here (the real macros' error
; leaves a broken instruction stream).

; $CREPRC [pidadr], [image], [input], [output], [error], [prvadr], [quota],
;	[prcnam], [baspri], [uic], [mbxunt], [stsflg], [itmlst], [node]
;	pidadr, quota, and the strings are by reference, the rest by value
;	(mbxunt a word). baspri defaults to 2. itmlst and node (a descriptor)
;	are by reference; their sizes are unconfirmed (the probes passed
;	neither with an addressing mode that shows it).

	.MACRO	$CREPRC_S PIDADR=0,IMAGE=0,INPUT=0,OUTPUT=0,ERROR=0,PRVADR=0,-
			QUOTA=0,PRCNAM=0,BASPRI=#2,UIC=#0,MBXUNT=#0,STSFLG=#0,-
			ITMLST=0,NODE=0
	.GLOBL	SYS$CREPRC
	$PUSHADR NODE,CONTEXT=Q
	$PUSHADR ITMLST
	PUSHL	STSFLG
	MOVZWL	MBXUNT,-(SP)
	$PUSHVALS UIC,BASPRI
	$PUSHADR PRCNAM,CONTEXT=Q
	$PUSHADR QUOTA
	$PUSHADR PRVADR,CONTEXT=Q
	$PUSHADR ERROR,CONTEXT=Q
	$PUSHADR OUTPUT,CONTEXT=Q
	$PUSHADR INPUT,CONTEXT=Q
	$PUSHADR IMAGE,CONTEXT=Q
	$PUSHADR PIDADR
	CALLS	#14,G^SYS$CREPRC
	.ENDM	$CREPRC_S

; $DELPRC, $WAKE, $CANWAK, $RESUME [pidadr], [prcnam]
;	both by reference: pidadr a longword, prcnam a descriptor.

	.MACRO	$DELPRC_S PIDADR=0,PRCNAM=0
	.GLOBL	SYS$DELPRC
	$PUSHADR PRCNAM,CONTEXT=Q
	$PUSHADR PIDADR
	CALLS	#2,G^SYS$DELPRC
	.ENDM	$DELPRC_S

	.MACRO	$WAKE_S PIDADR=0,PRCNAM=0
	.GLOBL	SYS$WAKE
	$PUSHADR PRCNAM,CONTEXT=Q
	$PUSHADR PIDADR
	CALLS	#2,G^SYS$WAKE
	.ENDM	$WAKE_S

	.MACRO	$CANWAK_S PIDADR=0,PRCNAM=0
	.GLOBL	SYS$CANWAK
	$PUSHADR PRCNAM,CONTEXT=Q
	$PUSHADR PIDADR
	CALLS	#2,G^SYS$CANWAK
	.ENDM	$CANWAK_S

	.MACRO	$RESUME_S PIDADR=0,PRCNAM=0
	.GLOBL	SYS$RESUME
	$PUSHADR PRCNAM,CONTEXT=Q
	$PUSHADR PIDADR
	CALLS	#2,G^SYS$RESUME
	.ENDM	$RESUME_S

; $HIBER
;	no arguments.

	.MACRO	$HIBER_S
	.GLOBL	SYS$HIBER
	CALLS	#0,G^SYS$HIBER
	.ENDM	$HIBER_S

; $SCHDWK [pidadr], [prcnam], daytim, [reptim]
;	all by reference: daytim and reptim quadwords.

	.MACRO	$SCHDWK_S PIDADR=0,PRCNAM=0,DAYTIM,REPTIM=0
	.GLOBL	SYS$SCHDWK
	.IF	B,<DAYTIM>
	.ERROR	; MISSING REQUIRED ARGUMENT DAYTIM;
	.MEXIT
	.ENDC
	$PUSHADR REPTIM,CONTEXT=Q
	$PUSHADR DAYTIM,CONTEXT=Q
	$PUSHADR PRCNAM,CONTEXT=Q
	$PUSHADR PIDADR
	CALLS	#4,G^SYS$SCHDWK
	.ENDM	$SCHDWK_S

; $FORCEX [pidadr], [prcnam], [code]
; $SUSPND [pidadr], [prcnam], [flags]
;	code and flags are longwords, by value.

	.MACRO	$FORCEX_S PIDADR=0,PRCNAM=0,CODE=#0
	.GLOBL	SYS$FORCEX
	PUSHL	CODE
	$PUSHADR PRCNAM,CONTEXT=Q
	$PUSHADR PIDADR
	CALLS	#3,G^SYS$FORCEX
	.ENDM	$FORCEX_S

	.MACRO	$SUSPND_S PIDADR=0,PRCNAM=0,FLAGS=#0
	.GLOBL	SYS$SUSPND
	PUSHL	FLAGS
	$PUSHADR PRCNAM,CONTEXT=Q
	$PUSHADR PIDADR
	CALLS	#3,G^SYS$SUSPND
	.ENDM	$SUSPND_S

; $SETPRI [pidadr], [prcnam], pri, [prvpri]
;	pri by value; prvpri a longword, by reference.

	.MACRO	$SETPRI_S PIDADR=0,PRCNAM=0,PRI,PRVPRI=0
	.GLOBL	SYS$SETPRI
	.IF	B,<PRI>
	.ERROR	; MISSING REQUIRED ARGUMENT PRI;
	.MEXIT
	.ENDC
	$PUSHADR PRVPRI
	PUSHL	PRI
	$PUSHADR PRCNAM,CONTEXT=Q
	$PUSHADR PIDADR
	CALLS	#4,G^SYS$SETPRI
	.ENDM	$SETPRI_S

; $SETPRN [prcnam]

	.MACRO	$SETPRN_S PRCNAM=0
	.GLOBL	SYS$SETPRN
	$PUSHADR PRCNAM,CONTEXT=Q
	CALLS	#1,G^SYS$SETPRN
	.ENDM	$SETPRN_S

; $GETJPI, $GETJPIW [efn], [pidadr], [prcnam], itmlst, [iosb], [astadr],
;	[astprm]
;	efn and astprm by value; the rest by reference. ASTPRM and ASTADR
;	are pushed as a pair.

	.MACRO	$GETJPI_S EFN=#0,PIDADR=0,PRCNAM=0,ITMLST,IOSB=0,ASTADR=0,ASTPRM=#0
	.GLOBL	SYS$GETJPI
	.IF	B,<ITMLST>
	.ERROR	; MISSING REQUIRED ARGUMENT ITMLST;
	.MEXIT
	.ENDC
	$PUSHVALADR ASTPRM,ASTADR
	$PUSHADR IOSB,CONTEXT=Q
	$PUSHADR ITMLST
	$PUSHADR PRCNAM,CONTEXT=Q
	$PUSHADR PIDADR
	PUSHL	EFN
	CALLS	#7,G^SYS$GETJPI
	.ENDM	$GETJPI_S

	.MACRO	$GETJPIW_S EFN=#0,PIDADR=0,PRCNAM=0,ITMLST,IOSB=0,ASTADR=0,ASTPRM=#0
	.GLOBL	SYS$GETJPIW
	.IF	B,<ITMLST>
	.ERROR	; MISSING REQUIRED ARGUMENT ITMLST;
	.MEXIT
	.ENDC
	$PUSHVALADR ASTPRM,ASTADR
	$PUSHADR IOSB,CONTEXT=Q
	$PUSHADR ITMLST
	$PUSHADR PRCNAM,CONTEXT=Q
	$PUSHADR PIDADR
	PUSHL	EFN
	CALLS	#7,G^SYS$GETJPIW
	.ENDM	$GETJPIW_S

; $GETDVI, $GETDVIW [efn], [chan], [devnam], itmlst, [iosb], [astadr],
;	[astprm], [nullarg]
;	efn and astprm by value, chan a word by value; nullarg is a
;	placeholder, by reference, pushed with astprm as a pair.

	.MACRO	$GETDVI_S EFN=#0,CHAN=#0,DEVNAM=0,ITMLST,IOSB=0,ASTADR=0,ASTPRM=#0,NULLARG=0
	.GLOBL	SYS$GETDVI
	.IF	B,<ITMLST>
	.ERROR	; MISSING REQUIRED ARGUMENT ITMLST;
	.MEXIT
	.ENDC
	$PUSHADRVAL NULLARG,ASTPRM,CONTEXT=Q
	$PUSHADR ASTADR
	$PUSHADR IOSB,CONTEXT=Q
	$PUSHADR ITMLST
	$PUSHADR DEVNAM,CONTEXT=Q
	MOVZWL	CHAN,-(SP)
	PUSHL	EFN
	CALLS	#8,G^SYS$GETDVI
	.ENDM	$GETDVI_S

	.MACRO	$GETDVIW_S EFN=#0,CHAN=#0,DEVNAM=0,ITMLST,IOSB=0,ASTADR=0,ASTPRM=#0,NULLARG=0
	.GLOBL	SYS$GETDVIW
	.IF	B,<ITMLST>
	.ERROR	; MISSING REQUIRED ARGUMENT ITMLST;
	.MEXIT
	.ENDC
	$PUSHADRVAL NULLARG,ASTPRM,CONTEXT=Q
	$PUSHADR ASTADR
	$PUSHADR IOSB,CONTEXT=Q
	$PUSHADR ITMLST
	$PUSHADR DEVNAM,CONTEXT=Q
	MOVZWL	CHAN,-(SP)
	PUSHL	EFN
	CALLS	#8,G^SYS$GETDVIW
	.ENDM	$GETDVIW_S

; $CREMBX [prmflg], chan, [maxmsg], [bufquo], [promsk], [acmode], [lognam],
;	[flags]
;	chan a word, by reference; lognam a descriptor, by reference; the
;	rest by value. LOGNAM and ACMODE are pushed as a pair, and PROMSK
;	and BUFQUO.

	.MACRO	$CREMBX_S PRMFLG=#0,CHAN,MAXMSG=#0,BUFQUO=#0,PROMSK=#0,ACMODE=#0,LOGNAM=0,FLAGS=#0
	.GLOBL	SYS$CREMBX
	.IF	B,<CHAN>
	.ERROR	; MISSING REQUIRED ARGUMENT CHAN;
	.MEXIT
	.ENDC
	PUSHL	FLAGS
	$PUSHADRVAL LOGNAM,ACMODE,CONTEXT=Q
	$PUSHVALS PROMSK,BUFQUO
	PUSHL	MAXMSG
	$PUSHADR CHAN,CONTEXT=W
	PUSHL	PRMFLG
	CALLS	#8,G^SYS$CREMBX
	.ENDM	$CREMBX_S

; $DELMBX chan
;	chan a word, by value.

	.MACRO	$DELMBX_S CHAN
	.GLOBL	SYS$DELMBX
	.IF	B,<CHAN>
	.ERROR	; MISSING REQUIRED ARGUMENT CHAN;
	.MEXIT
	.ENDC
	MOVZWL	CHAN,-(SP)
	CALLS	#1,G^SYS$DELMBX
	.ENDM	$DELMBX_S

; $SETIMR [efn], daytim, [astadr], [reqidt], [flags]
;	efn, reqidt, and flags by value; daytim a quadword and astadr a
;	procedure, by reference. FLAGS and REQIDT are pushed as a pair.

	.MACRO	$SETIMR_S EFN=#0,DAYTIM,ASTADR=0,REQIDT=#0,FLAGS=#0
	.GLOBL	SYS$SETIMR
	.IF	B,<DAYTIM>
	.ERROR	; MISSING REQUIRED ARGUMENT DAYTIM;
	.MEXIT
	.ENDC
	$PUSHVALS FLAGS,REQIDT
	$PUSHADR ASTADR
	$PUSHADRVAL DAYTIM,EFN,CONTEXT=Q
	CALLS	#5,G^SYS$SETIMR
	.ENDM	$SETIMR_S

; $CANTIM [reqidt], [acmode]
;	both by value, pushed as a pair.

	.MACRO	$CANTIM_S REQIDT=#0,ACMODE=#0
	.GLOBL	SYS$CANTIM
	$PUSHVALS ACMODE,REQIDT
	CALLS	#2,G^SYS$CANTIM
	.ENDM	$CANTIM_S

; $WAITFR, $SETEF, $CLREF efn
; $READEF efn, state
;	efn by value; state a longword, by reference.

	.MACRO	$WAITFR_S EFN
	.GLOBL	SYS$WAITFR
	.IF	B,<EFN>
	.ERROR	; MISSING REQUIRED ARGUMENT EFN;
	.MEXIT
	.ENDC
	PUSHL	EFN
	CALLS	#1,G^SYS$WAITFR
	.ENDM	$WAITFR_S

	.MACRO	$SETEF_S EFN
	.GLOBL	SYS$SETEF
	.IF	B,<EFN>
	.ERROR	; MISSING REQUIRED ARGUMENT EFN;
	.MEXIT
	.ENDC
	PUSHL	EFN
	CALLS	#1,G^SYS$SETEF
	.ENDM	$SETEF_S

	.MACRO	$CLREF_S EFN
	.GLOBL	SYS$CLREF
	.IF	B,<EFN>
	.ERROR	; MISSING REQUIRED ARGUMENT EFN;
	.MEXIT
	.ENDC
	PUSHL	EFN
	CALLS	#1,G^SYS$CLREF
	.ENDM	$CLREF_S

	.MACRO	$READEF_S EFN,STATE
	.GLOBL	SYS$READEF
	.IF	B,<EFN>
	.ERROR	; MISSING REQUIRED ARGUMENT EFN;
	.MEXIT
	.ENDC
	.IF	B,<STATE>
	.ERROR	; MISSING REQUIRED ARGUMENT STATE;
	.MEXIT
	.ENDC
	$PUSHADR STATE
	PUSHL	EFN
	CALLS	#2,G^SYS$READEF
	.ENDM	$READEF_S

; The argument-list forms (NAME) and the CALLG forms (NAME_G) of the same
; services, from the same probes (docs/PHASE-45.md). NAME lays down, in
; line, a longword count and then every argument as an .ADDRESS, even a
; number, an omitted one 0 (BASPRI 2), as real MACRO's objects show: it
; makes no check for a required argument, and a value is written without
; its "#". NAME_G is CALLG with the argument list's address, written as the
; macro's one positional argument: real MACRO takes ARGLST=X as that text,
; not as a keyword, so the formal here is named LST. $HIBER has no NAME
; form (real MACRO has none: it is not a macro there).

	.MACRO	$CREPRC PIDADR=0,IMAGE=0,INPUT=0,OUTPUT=0,ERROR=0,PRVADR=0,QUOTA=0,-
			PRCNAM=0,BASPRI=2,UIC=0,MBXUNT=0,STSFLG=0,ITMLST=0,NODE=0
	.LONG	14
	.ADDRESS	PIDADR
	.ADDRESS	IMAGE
	.ADDRESS	INPUT
	.ADDRESS	OUTPUT
	.ADDRESS	ERROR
	.ADDRESS	PRVADR
	.ADDRESS	QUOTA
	.ADDRESS	PRCNAM
	.ADDRESS	BASPRI
	.ADDRESS	UIC
	.ADDRESS	MBXUNT
	.ADDRESS	STSFLG
	.ADDRESS	ITMLST
	.ADDRESS	NODE
	.ENDM	$CREPRC

	.MACRO	$CREPRC_G LST
	.GLOBL	SYS$CREPRC
	CALLG	LST,G^SYS$CREPRC
	.ENDM	$CREPRC_G

	.MACRO	$DELPRC PIDADR=0,PRCNAM=0
	.LONG	2
	.ADDRESS	PIDADR
	.ADDRESS	PRCNAM
	.ENDM	$DELPRC

	.MACRO	$DELPRC_G LST
	.GLOBL	SYS$DELPRC
	CALLG	LST,G^SYS$DELPRC
	.ENDM	$DELPRC_G

	.MACRO	$WAKE PIDADR=0,PRCNAM=0
	.LONG	2
	.ADDRESS	PIDADR
	.ADDRESS	PRCNAM
	.ENDM	$WAKE

	.MACRO	$WAKE_G LST
	.GLOBL	SYS$WAKE
	CALLG	LST,G^SYS$WAKE
	.ENDM	$WAKE_G

	.MACRO	$CANWAK PIDADR=0,PRCNAM=0
	.LONG	2
	.ADDRESS	PIDADR
	.ADDRESS	PRCNAM
	.ENDM	$CANWAK

	.MACRO	$CANWAK_G LST
	.GLOBL	SYS$CANWAK
	CALLG	LST,G^SYS$CANWAK
	.ENDM	$CANWAK_G

	.MACRO	$RESUME PIDADR=0,PRCNAM=0
	.LONG	2
	.ADDRESS	PIDADR
	.ADDRESS	PRCNAM
	.ENDM	$RESUME

	.MACRO	$RESUME_G LST
	.GLOBL	SYS$RESUME
	CALLG	LST,G^SYS$RESUME
	.ENDM	$RESUME_G

	.MACRO	$HIBER_G LST
	.GLOBL	SYS$HIBER
	CALLG	LST,G^SYS$HIBER
	.ENDM	$HIBER_G

	.MACRO	$SCHDWK PIDADR=0,PRCNAM=0,DAYTIM=0,REPTIM=0
	.LONG	4
	.ADDRESS	PIDADR
	.ADDRESS	PRCNAM
	.ADDRESS	DAYTIM
	.ADDRESS	REPTIM
	.ENDM	$SCHDWK

	.MACRO	$SCHDWK_G LST
	.GLOBL	SYS$SCHDWK
	CALLG	LST,G^SYS$SCHDWK
	.ENDM	$SCHDWK_G

	.MACRO	$FORCEX PIDADR=0,PRCNAM=0,CODE=0
	.LONG	3
	.ADDRESS	PIDADR
	.ADDRESS	PRCNAM
	.ADDRESS	CODE
	.ENDM	$FORCEX

	.MACRO	$FORCEX_G LST
	.GLOBL	SYS$FORCEX
	CALLG	LST,G^SYS$FORCEX
	.ENDM	$FORCEX_G

	.MACRO	$SUSPND PIDADR=0,PRCNAM=0,FLAGS=0
	.LONG	3
	.ADDRESS	PIDADR
	.ADDRESS	PRCNAM
	.ADDRESS	FLAGS
	.ENDM	$SUSPND

	.MACRO	$SUSPND_G LST
	.GLOBL	SYS$SUSPND
	CALLG	LST,G^SYS$SUSPND
	.ENDM	$SUSPND_G

