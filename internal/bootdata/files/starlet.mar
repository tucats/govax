; $SETPRT inadr, [retadr], [acmode], prot, [prvprt]
	.MACRO	$SETPRT_S INADR,RETADR=0,ACMODE=#0,PROT,PRVPRT=0
	.GLOBL	SYS$SETPRT
	.IF	B,<INADR>
	.ERROR	; MISSING REQUIRED ARGUMENT INADR;
	.MEXIT
	.ENDC
	.IF	B,<PROT>
	.ERROR	; MISSING REQUIRED ARGUMENT PROT;
	.MEXIT
	.ENDC
	$PUSHADR PRVPRT,CONTEXT=B
	$PUSHVALS PROT,ACMODE
	$PUSHADR RETADR,CONTEXT=Q
	$PUSHADR INADR,CONTEXT=Q
	CALLS	#5,G^SYS$SETPRT
	.ENDM	$SETPRT_S

	.MACRO	$SETPRT INADR=0,RETADR=0,ACMODE=0,PROT=0,PRVPRT=0
	.LONG	5
	.ADDRESS	INADR
	.ADDRESS	RETADR
	.ADDRESS	ACMODE
	.ADDRESS	PROT
	.ADDRESS	PRVPRT
	.ENDM	$SETPRT

	.MACRO	$SETPRT_G LST
	.GLOBL	SYS$SETPRT
	CALLG	LST,G^SYS$SETPRT
	.ENDM	$SETPRT_G

