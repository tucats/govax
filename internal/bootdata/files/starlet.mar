	.ENDM	$UPDATE

	.MACRO	$WRITE	RAB,ERR,SUC
	$$RMSSVC WRITE,<RAB>,<ERR>,<SUC>
	.ENDM	$WRITE

	.MACRO	$RENAME	OLDFAB,ERR,SUC,NEWFAB
	.GLOBL	SYS$RENAME
	.IF	B,<OLDFAB>
	CALLG	(AP),G^SYS$RENAME
	.MEXIT
	.ENDC
	$$RMSPUSH NEWFAB
	.IF	NB,<SUC>
	PUSHAL	SUC
	.IFF
	PUSHL	#0
	.ENDC
	.IF	NB,<ERR>
	PUSHAL	ERR
	.IFF
	PUSHL	#0
	.ENDC
	$$RMSPUSH OLDFAB
	CALLS	#4,G^SYS$RENAME
	.ENDM	$RENAME

	.MACRO	$WAIT	RAB
	.GLOBL	SYS$WAIT
	.IF	B,<RAB>
	CALLG	(AP),G^SYS$WAIT
	.MEXIT
	.ENDC
	$$RMSPUSH RAB
	CALLS	#1,G^SYS$WAIT
	.ENDM	$WAIT
