; $BRKTHRU [efn], [msgbuf], [sendto], [sndtyp], [iosb], [carcon], [flags], [reqid], [timout], [astadr], [astprm]
	.MACRO	$BRKTHRU_S EFN=#0,MSGBUF=0,SENDTO=0,SNDTYP=#0,IOSB=0,CARCON=#32,-
			FLAGS=#0,REQID=#0,TIMOUT=#0,ASTADR=0,ASTPRM=#0
	.GLOBL	SYS$BRKTHRU
	$PUSHVALADR ASTPRM,ASTADR,CONTEXT=L
	$PUSHVALS TIMOUT,REQID
	$PUSHVALS FLAGS,CARCON
	$PUSHADRVAL IOSB,SNDTYP,CONTEXT=Q
	$PUSHADR SENDTO,CONTEXT=Q
	$PUSHADRVAL MSGBUF,EFN,CONTEXT=Q
	CALLS	#11,G^SYS$BRKTHRU
	.ENDM	$BRKTHRU_S

	.MACRO	$BRKTHRU EFN=0,MSGBUF=0,SENDTO=0,SNDTYP=0,IOSB=0,CARCON=32,-
			FLAGS=0,REQID=0,TIMOUT=0,ASTADR=0,ASTPRM=0
	.LONG	11
	.ADDRESS	EFN
	.ADDRESS	MSGBUF
	.ADDRESS	SENDTO
	.ADDRESS	SNDTYP
	.ADDRESS	IOSB
	.ADDRESS	CARCON
	.ADDRESS	FLAGS
	.ADDRESS	REQID
	.ADDRESS	TIMOUT
	.ADDRESS	ASTADR
	.ADDRESS	ASTPRM
	.ENDM	$BRKTHRU

	.MACRO	$BRKTHRU_G LST
	.GLOBL	SYS$BRKTHRU
	CALLG	LST,G^SYS$BRKTHRU
	.ENDM	$BRKTHRU_G

