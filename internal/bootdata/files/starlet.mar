; $FAO ctrstr, [outlen], outbuf, [p1, ..., p17]
	.MACRO	$FAO_S CTRSTR,OUTLEN=0,OUTBUF,P1,P2,P3,P4,P5,P6,P7,P8,-
			P9,P10,P11,P12,P13,P14,P15,P16,P17
	.GLOBL	SYS$FAO
	.IF	B,<CTRSTR>
	.ERROR	; MISSING REQUIRED ARGUMENT CTRSTR;
	.MEXIT
	.ENDC
	.IF	B,<OUTBUF>
	.ERROR	; MISSING REQUIRED ARGUMENT OUTBUF;
	.MEXIT
	.ENDC
	$$FAOCNT = 3
	.IF	NB,<P17>
	PUSHL	P17
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P16>
	PUSHL	P16
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P15>
	PUSHL	P15
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P14>
	PUSHL	P14
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P13>
	PUSHL	P13
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P12>
	PUSHL	P12
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P11>
	PUSHL	P11
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P10>
	PUSHL	P10
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P9>
	PUSHL	P9
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P8>
	PUSHL	P8
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P7>
	PUSHL	P7
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P6>
	PUSHL	P6
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P5>
	PUSHL	P5
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P4>
	PUSHL	P4
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P3>
	PUSHL	P3
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P2>
	PUSHL	P2
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P1>
	PUSHL	P1
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	$PUSHADR OUTBUF,CONTEXT=Q
	$PUSHADR OUTLEN,CONTEXT=W
	$PUSHADR CTRSTR,CONTEXT=Q
	CALLS	#$$FAOCNT,G^SYS$FAO
	.ENDM	$FAO_S

	.MACRO	$FAO CTRSTR=0,OUTLEN=0,OUTBUF=0,P1,P2,P3,P4,P5,P6,P7,P8,-
			P9,P10,P11,P12,P13,P14,P15,P16,P17
	$$FAOCNT = 3
	.IF	NB,<P1>
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P2>
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P3>
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P4>
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P5>
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P6>
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P7>
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P8>
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P9>
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P10>
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P11>
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P12>
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P13>
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P14>
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P15>
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P16>
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.IF	NB,<P17>
	$$FAOCNT = $$FAOCNT+1
	.ENDC
	.LONG	$$FAOCNT
	.ADDRESS	CTRSTR
	.ADDRESS	OUTLEN
	.ADDRESS	OUTBUF
	.IF	NB,<P1>
	.ADDRESS	P1
	.ENDC
	.IF	NB,<P2>
	.ADDRESS	P2
	.ENDC
	.IF	NB,<P3>
	.ADDRESS	P3
	.ENDC
	.IF	NB,<P4>
	.ADDRESS	P4
	.ENDC
	.IF	NB,<P5>
	.ADDRESS	P5
	.ENDC
	.IF	NB,<P6>
	.ADDRESS	P6
	.ENDC
	.IF	NB,<P7>
	.ADDRESS	P7
	.ENDC
	.IF	NB,<P8>
	.ADDRESS	P8
	.ENDC
	.IF	NB,<P9>
	.ADDRESS	P9
	.ENDC
	.IF	NB,<P10>
	.ADDRESS	P10
	.ENDC
	.IF	NB,<P11>
	.ADDRESS	P11
	.ENDC
	.IF	NB,<P12>
	.ADDRESS	P12
	.ENDC
	.IF	NB,<P13>
	.ADDRESS	P13
	.ENDC
	.IF	NB,<P14>
	.ADDRESS	P14
	.ENDC
	.IF	NB,<P15>
	.ADDRESS	P15
	.ENDC
	.IF	NB,<P16>
	.ADDRESS	P16
	.ENDC
	.IF	NB,<P17>
	.ADDRESS	P17
	.ENDC
	.ENDM	$FAO

