	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;    1  C     Statement functions (Phase 79, subtask 10, the manual's section 6.2.1),
;    2  C     expanded in line: a dummy argument's name only gives it its type, whatever
;    3  C     else the unit calls that name; the manual's VOLUME, SINH (an intrinsic's
;    4  C     name), AVG, and CSF; every type of value; functions using those before
;    5  C     them, one reference inside another's argument; actual arguments that are
;    6  C     constants, variables, elements, expressions, and CHARACTER values of other
;    7  C     lengths, cut or padded to the dummy's; the value converted to the
;    8  C     function's type and length; a value that goes through a dummy procedure
;    9  C     and into a routine that changes its argument. Z = SWAP(Z) reads Z's parts
;   10  C     after neither is written.
;   11        PROGRAM STMTFN
	.ENTRY	STMTFN,^M<R2,R3,R4,R5>
;   12        EXTERNAL BUMP
;   13        REAL GRADE, TEST1, TEST2, XLAB, R, H, M(3), X, SINH, Y, COMMONV
;   14        INTEGER I, IDX, TWICE, K
;   15        INTEGER*2 N2, NEXT2
;   16        LOGICAL BIG, L
;   17        DOUBLE PRECISION DBL, D
;   18        COMPLEX C, SWAP, W, CVAL
;   19        CHARACTER*10 CSF, A, B
;   20        CHARACTER*4 SHORT
;   21        CHARACTER*3 FIRST3
;   22        CHARACTER*6 PADDED, T6
;   23        COMMON /BLK/ COMMONV
;   24        VOLUME(RADIUS) = 4.189*RADIUS**3
;   25        SINH(X) = (EXP(X)-EXP(-X))*0.5
;   26        AVG(R, H, Y) = (R + H + Y) / 3.0
;   27        TWICE(I) = I*2
;   28        IDX(I) = M(I) * 10.0
;   29        NEXT2(N2) = N2 + 1
;   30        BIG(H) = H .GT. 2.0
;   31        DBL(D) = D*D
;   32        SWAP(W) = CMPLX(AIMAG(W), REAL(W))
;   33        CVAL(R) = R
;   34        CSF(A,B) = A(6:10)//B(1:5)
;   35        SHORT(A) = A
;   36        FIRST3(T6) = T6
;   37        PADDED(R) = 'X'
;   38        FIRSTV(R) = R
;   39        AREA(R) = 3.0*R*R
;   40        RING(R, H) = AREA(R) - AREA(H)
;   41        PUSH(R) = COMMONV + R
;   42        CALLS(R) = BUMP(R)
;   43  C     The manual's
;   44        PRINT *, VOLUME(1.0), VOLUME(2.0)
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	MULF3	STMTFN.$K1,STMTFN.$K1,R0
	MULF2	STMTFN.$K1,R0
	MULF3	STMTFN.$F1,R0,STMTFN.$T1
	PUSHAQ	STMTFN.$D1
	CALLS	#1,G^FTN$IO_ITEM
	MULF3	STMTFN.$K2,STMTFN.$K2,R0
	MULF2	STMTFN.$K2,R0
	MULF3	STMTFN.$F1,R0,STMTFN.$T2
	PUSHAQ	STMTFN.$D2
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   45        PRINT *, SINH(0.0)
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	PUSHAL	STMTFN.$K3
	CALLS	#1,G^MTH$EXP
	MOVF	R0,STMTFN.$T2
	MNEGF	STMTFN.$K3,STMTFN.$T3
	PUSHAL	STMTFN.$T3
	CALLS	#1,G^MTH$EXP
	MOVF	R0,STMTFN.$T1
	SUBF3	STMTFN.$T1,STMTFN.$T2,R0
	MULF3	R0,STMTFN.$F2,STMTFN.$T4
	PUSHAQ	STMTFN.$D3
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   46        TEST1 = 3.0
	MOVL	#^X00004140,STMTFN.TEST1 ; 3.0
;   47        TEST2 = 4.0
	MOVL	#^X00004180,STMTFN.TEST2 ; 4.0
;   48        XLAB = 5.0
	MOVL	#^X000041A0,STMTFN.XLAB	; 5.0
;   49        GRADE = AVG(TEST1, TEST2, XLAB)
	ADDF3	STMTFN.TEST1,STMTFN.TEST2,R0
	ADDF2	STMTFN.XLAB,R0
	DIVF3	STMTFN.$K4,R0,STMTFN.GRADE
;   50        PRINT *, GRADE
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	PUSHAQ	STMTFN.$D4
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   51        IF (AVG(1.0, 2.0, 3.0) .LT. AVG(4.0, 5.0, 6.0)) PRINT *, 'LESS'
	ADDF3	STMTFN.$K1,STMTFN.$K2,R0
	ADDF2	STMTFN.$K4,R0
	DIVF2	STMTFN.$K4,R0
	ADDF3	STMTFN.$K5,STMTFN.$K6,R1
	ADDF2	STMTFN.$K7,R1
	DIVF2	STMTFN.$K4,R1
	CMPF	R0,R1
	BLSS	STMTFN.$2
	BRW	STMTFN.$1
STMTFN.$2:
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	PUSHAQ	STMTFN.$D5
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
STMTFN.$1:
;   52        PRINT *, CSF('ABCDEFGHIJ', 'KLMNOPQRST')
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	MOVC3	#5,STMTFN.$K9+5,STMTFN.$T5
	MOVC3	#5,STMTFN.$K10,STMTFN.$T5+5
	PUSHAQ	STMTFN.$D6
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   53  C     The names of dummy arguments, whatever they are elsewhere: H is a REAL
;   54  C     variable, I an INTEGER one, and neither is touched
;   55        H = 99.0
	MOVL	#^X000043C6,STMTFN.H	; 99.0
;   56        I = 77
	MOVL	#77,STMTFN.I
;   57        PRINT *, BIG(1.0), BIG(3.0), TWICE(21), H, I
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	CLRL	R0
	CMPF	STMTFN.$K1,STMTFN.$K2
	BLEQ	STMTFN.$3
	MNEGL	#1,R0
STMTFN.$3:
	MOVL	R0,STMTFN.$T6
	PUSHAQ	STMTFN.$D7
	CALLS	#1,G^FTN$IO_ITEM
	CLRL	R0
	CMPF	STMTFN.$K4,STMTFN.$K2
	BLEQ	STMTFN.$4
	MNEGL	#1,R0
STMTFN.$4:
	MOVL	R0,STMTFN.$T7
	PUSHAQ	STMTFN.$D8
	CALLS	#1,G^FTN$IO_ITEM
	MULL3	STMTFN.$K11,#2,STMTFN.$T8
	PUSHAQ	STMTFN.$D9
	CALLS	#1,G^FTN$IO_ITEM
	PUSHAQ	STMTFN.$D10
	CALLS	#1,G^FTN$IO_ITEM
	PUSHAQ	STMTFN.$D11
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   58  C     An INTEGER function of a REAL element
;   59        M(1) = 1.5
	MOVL	#^X000040C0,STMTFN.M	; 1.5
;   60        M(2) = 2.5
	MOVL	#^X00004120,STMTFN.M+4	; 2.5
;   61        M(3) = 3.5
	MOVL	#^X00004160,STMTFN.M+8	; 3.5
;   62        K = 2
	MOVL	#2,STMTFN.K
;   63        PRINT *, IDX(K), IDX(K + 1)
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	MOVL	STMTFN.K,R0
	MULF3	STMTFN.M-4[R0],STMTFN.$F3,R0
	CVTFL	R0,STMTFN.$T8
	PUSHAQ	STMTFN.$D9
	CALLS	#1,G^FTN$IO_ITEM
	ADDL3	STMTFN.K,#1,STMTFN.$T7
	MOVL	STMTFN.$T7,R0
	MULF3	STMTFN.M-4[R0],STMTFN.$F3,R0
	CVTFL	R0,STMTFN.$T6
	PUSHAQ	STMTFN.$D12
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   64  C     Word arguments: a constant that fits, a variable
;   65        N2 = 4
	MOVW	#4,STMTFN.N2
;   66        PRINT *, NEXT2(N2), NEXT2(32)
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	ADDW3	STMTFN.N2,#1,STMTFN.$T9
	PUSHAQ	STMTFN.$D13
	CALLS	#1,G^FTN$IO_ITEM
	ADDW3	STMTFN.$K12,#1,STMTFN.$T10
	PUSHAQ	STMTFN.$D14
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   67  C     REAL*8, COMPLEX, and a REAL value made COMPLEX
;   68        PRINT *, DBL(1.5D0)
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	MULD3	STMTFN.$K13,STMTFN.$K13,STMTFN.$T11
	PUSHAQ	STMTFN.$D15
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   69        C = (1.0, 2.0)
	MOVQ	STMTFN.$F4,STMTFN.C	; (1.0, 2.0)
;   70        C = SWAP(C)
	MOVF	STMTFN.C+4,STMTFN.$T12
	MOVF	STMTFN.C,STMTFN.$T12+4
	MOVQ	STMTFN.$T12,STMTFN.C
;   71        PRINT *, C
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	PUSHAQ	STMTFN.$D16
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   72        PRINT *, SWAP((3.0, 4.0))
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	MOVF	STMTFN.$K14+4,STMTFN.$T12
	MOVF	STMTFN.$K14,STMTFN.$T12+4
	PUSHAQ	STMTFN.$D17
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   73        PRINT *, CVAL(7.0)
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	MOVF	STMTFN.$K15,STMTFN.$T12
	CLRF	STMTFN.$T12+4
	PUSHAQ	STMTFN.$D17
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   74  C     Using those before, one inside another's argument
;   75        PRINT *, RING(2.0, 1.0)
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	MULF3	STMTFN.$K4,STMTFN.$K2,R0
	MULF2	STMTFN.$K2,R0
	MULF3	STMTFN.$K4,STMTFN.$K1,R1
	MULF2	STMTFN.$K1,R1
	SUBF3	R1,R0,STMTFN.$T4
	PUSHAQ	STMTFN.$D3
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   76        PRINT *, AREA(AREA(1.0))
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	MULF3	STMTFN.$K4,STMTFN.$K1,R0
	MULF3	R0,STMTFN.$K1,STMTFN.$T4
	MULF3	STMTFN.$K4,STMTFN.$T4,R0
	MULF3	R0,STMTFN.$T4,STMTFN.$T3
	PUSHAQ	STMTFN.$D18
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   77        PRINT *, RING(M(1) + 0.5, AREA(1.0) - 2.0)
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	ADDF3	STMTFN.M,STMTFN.$F2,STMTFN.$T3
	MULF3	STMTFN.$K4,STMTFN.$K1,R0
	MULF2	STMTFN.$K1,R0
	SUBF3	STMTFN.$K2,R0,STMTFN.$T4
	MULF3	STMTFN.$K4,STMTFN.$T3,R0
	MULF2	STMTFN.$T3,R0
	MULF3	STMTFN.$K4,STMTFN.$T4,R1
	MULF2	STMTFN.$T4,R1
	SUBF3	R1,R0,STMTFN.$T1
	PUSHAQ	STMTFN.$D1
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   78  C     CHARACTER values: the function's length, and the dummy's
;   79        PRINT *, '[', SHORT('ABCDEFGHIJ'), ']'
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	PUSHAQ	STMTFN.$D19
	CALLS	#1,G^FTN$IO_ITEM
	MOVC3	#4,STMTFN.$K9,STMTFN.$T13
	PUSHAQ	STMTFN.$D20
	CALLS	#1,G^FTN$IO_ITEM
	PUSHAQ	STMTFN.$D21
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   80        PRINT *, '[', SHORT('AB'), ']'
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	PUSHAQ	STMTFN.$D19
	CALLS	#1,G^FTN$IO_ITEM
	MOVC5	#2,STMTFN.$K18,#^A/ /,#10,STMTFN.$T5
	MOVC3	#4,STMTFN.$T5,STMTFN.$T13
	PUSHAQ	STMTFN.$D20
	CALLS	#1,G^FTN$IO_ITEM
	PUSHAQ	STMTFN.$D21
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   81        PRINT *, '[', FIRST3('ABCDEF'), ']'
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	PUSHAQ	STMTFN.$D19
	CALLS	#1,G^FTN$IO_ITEM
	MOVC3	#3,STMTFN.$K19,STMTFN.$T14
	PUSHAQ	STMTFN.$D22
	CALLS	#1,G^FTN$IO_ITEM
	PUSHAQ	STMTFN.$D21
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   82        PRINT *, '[', FIRST3('AB'), ']'
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	PUSHAQ	STMTFN.$D19
	CALLS	#1,G^FTN$IO_ITEM
	MOVC5	#2,STMTFN.$K18,#^A/ /,#6,STMTFN.$T15
	MOVC3	#3,STMTFN.$T15,STMTFN.$T14
	PUSHAQ	STMTFN.$D22
	CALLS	#1,G^FTN$IO_ITEM
	PUSHAQ	STMTFN.$D21
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   83        PRINT *, '[', CSF('12345', 'VWXYZ'), ']'
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	PUSHAQ	STMTFN.$D19
	CALLS	#1,G^FTN$IO_ITEM
	MOVC5	#5,STMTFN.$K20,#^A/ /,#10,STMTFN.$T5
	MOVC5	#5,STMTFN.$K21,#^A/ /,#10,STMTFN.$T16
	MOVC3	#5,STMTFN.$T5+5,STMTFN.$T17
	MOVC3	#5,STMTFN.$T16,STMTFN.$T17+5
	PUSHAQ	STMTFN.$D23
	CALLS	#1,G^FTN$IO_ITEM
	PUSHAQ	STMTFN.$D21
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   84        PRINT *, '[', PADDED(1.0), ']'
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	PUSHAQ	STMTFN.$D19
	CALLS	#1,G^FTN$IO_ITEM
	MOVC5	#1,STMTFN.$K22,#^A/ /,#6,STMTFN.$T15
	PUSHAQ	STMTFN.$D24
	CALLS	#1,G^FTN$IO_ITEM
	PUSHAQ	STMTFN.$D21
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   85        PRINT *, LEN(SHORT('X')), LEN(CSF('X', 'Y'))
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	PUSHAQ	STMTFN.$D25
	CALLS	#1,G^FTN$IO_ITEM
	PUSHAQ	STMTFN.$D26
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   86        A = 'ABCDEFGHIJ'
	MOVC3	#10,STMTFN.$K9,STMTFN.A
;   87        A = SHORT(A)
	MOVC3	#4,STMTFN.A,STMTFN.$T13
	MOVC5	#4,STMTFN.$T13,#^A/ /,#10,STMTFN.A
;   88        PRINT *, '[', A, ']'
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	PUSHAQ	STMTFN.$D19
	CALLS	#1,G^FTN$IO_ITEM
	PUSHAQ	STMTFN.$D27
	CALLS	#1,G^FTN$IO_ITEM
	PUSHAQ	STMTFN.$D21
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   89        PRINT *, '[', SHORT(CSF('ABCDEFGHIJ', 'KLMNOPQRST')) // '!', ']'
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	PUSHAQ	STMTFN.$D19
	CALLS	#1,G^FTN$IO_ITEM
	MOVC3	#5,STMTFN.$K9+5,STMTFN.$T16
	MOVC3	#5,STMTFN.$K10,STMTFN.$T16+5
	MOVC3	#10,STMTFN.$T16,STMTFN.$T17
	MOVC3	#4,STMTFN.$T17,STMTFN.$T13
	MOVC3	#4,STMTFN.$T13,STMTFN.$T18
	MOVC3	#1,STMTFN.$K25,STMTFN.$T18+4
	PUSHAQ	STMTFN.$D28
	CALLS	#1,G^FTN$IO_ITEM
	PUSHAQ	STMTFN.$D21
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   90  C     Variables in the expression, read when it is used
;   91        COMMONV = 1.0
	MOVL	#^X00004080,STMTFN.COMMONV ; 1.0
;   92        PRINT *, PUSH(1.0)
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	ADDF3	STMTFN.COMMONV,STMTFN.$K1,STMTFN.$T1
	PUSHAQ	STMTFN.$D1
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   93        COMMONV = 2.0
	MOVL	#^X00004100,STMTFN.COMMONV ; 2.0
;   94        PRINT *, PUSH(1.0)
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	ADDF3	STMTFN.COMMONV,STMTFN.$K1,STMTFN.$T1
	PUSHAQ	STMTFN.$D1
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   95  C     A function called from the expression, changing its argument; a statement
;   96  C     function's value is a copy, wherever it goes
;   97        Y = 1.0
	MOVL	#^X00004080,STMTFN.Y	; 1.0
;   98        PRINT *, CALLS(Y), Y
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	PUSHAL	STMTFN.Y
	CALLS	#1,G^BUMP
	MOVF	R0,STMTFN.$T1
	PUSHAQ	STMTFN.$D1
	CALLS	#1,G^FTN$IO_ITEM
	PUSHAQ	STMTFN.$D29
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;   99        CALL SHOW(AVG(1.0, 2.0, 3.0), SHORT('ABCDEFGHIJ'))
	ADDF3	STMTFN.$K1,STMTFN.$K2,R0
	ADDF2	STMTFN.$K4,R0
	DIVF3	STMTFN.$K4,R0,STMTFN.$T1
	MOVC3	#4,STMTFN.$K9,STMTFN.$T13
	MOVC3	#4,STMTFN.$T13,STMTFN.$T19
	PUSHAQ	STMTFN.$D30
	PUSHAL	STMTFN.$T1
	CALLS	#2,G^SHOW
;  100        CALL CHANGE(FIRSTV(Y))
	MOVF	STMTFN.Y,STMTFN.$T1
	PUSHAL	STMTFN.$T1
	CALLS	#1,G^CHANGE
;  101        PRINT *, Y
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	PUSHAQ	STMTFN.$D29
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;  102  C     In the conditions of statements
;  103        K = 0
	CLRL	STMTFN.K
;  104  10    IF (TWICE(K) .LT. 6) THEN
STMTFN.L10:
	MULL3	STMTFN.K,#2,R0
	CMPL	R0,#6
	BLSS	STMTFN.$6
	BRW	STMTFN.$5
STMTFN.$6:
;  105          K = K + 1
	INCL	STMTFN.K
;  106          GO TO 10
	BRW	STMTFN.L10
STMTFN.$5:
;  107        END IF
;  108        PRINT *, K
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	PUSHAQ	STMTFN.$D31
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;  109        DO WHILE (AREA(REAL(K)) .LT. 100.0)
STMTFN.$7:				; DO (line 109)'s test
	CVTLF	STMTFN.K,STMTFN.$T1
	MULF3	STMTFN.$K4,STMTFN.$T1,R0
	MULF2	STMTFN.$T1,R0
	CMPF	R0,STMTFN.$F5
	BLSS	STMTFN.$9
	BRW	STMTFN.$8
STMTFN.$9:
;  110          K = K + 1
	INCL	STMTFN.K
;  111        END DO
	BRW	STMTFN.$7
STMTFN.$8:
;  112        PRINT *, K
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	PUSHAQ	STMTFN.$D31
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;  113        DO 20 K = TWICE(1), TWICE(2), TWICE(1)
	MULL3	STMTFN.$K26,#2,STMTFN.$S1 ; DO 20's step
	MULL3	STMTFN.$K27,#2,R0	; DO 20's count
	MULL3	STMTFN.$K26,#2,R1
	SUBL2	R1,R0
	ADDL2	STMTFN.$S1,R0
	DIVL3	STMTFN.$S1,R0,STMTFN.$C1
	MULL3	STMTFN.$K26,#2,STMTFN.K
	TSTL	STMTFN.$C1
	BGTR	STMTFN.$11
	BRW	STMTFN.$10
STMTFN.$11:
STMTFN.$12:				; DO 20's body
;  114          PRINT *, K
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	PUSHAQ	STMTFN.$D31
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;  115  20    CONTINUE
STMTFN.L20:
	ADDL2	STMTFN.$S1,STMTFN.K
	DECL	STMTFN.$C1		; one pass fewer
	BLEQ	STMTFN.$13
	BRW	STMTFN.$12
STMTFN.$13:
STMTFN.$10:
;  116        L = BIG(M(1)) .OR. BIG(M(3))
	MOVF	STMTFN.M,STMTFN.$T1
	MOVF	STMTFN.M+8,STMTFN.$T4
	CLRL	R0
	CMPF	STMTFN.$T1,STMTFN.$K2
	BLEQ	STMTFN.$14
	MNEGL	#1,R0
STMTFN.$14:
	CLRL	R1
	CMPF	STMTFN.$T4,STMTFN.$K2
	BLEQ	STMTFN.$15
	MNEGL	#1,R1
STMTFN.$15:
	BISL3	R0,R1,STMTFN.L
;  117        PRINT *, L
	PUSHAB	STMTFN.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	PUSHAQ	STMTFN.$D32
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;  118        END
	MOVL	#1,R0			; SS$_NORMAL
	RET

; Storage map for BUMP, a REAL function
;   V     REAL  argument 1  @BUMP.V(AP)
;   BUMP  REAL  $LOCAL+0    BUMP.BUMP
;
BUMP.V = 4				; V is argument 1

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
BUMP.BUMP:
	.BLKL	1			; BUMP, the function's value

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
BUMP.$F1:
	.LONG	^X00004080		; 1.0
BUMP.$F2:
	.LONG	^X00004220		; 10.0

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  119
;  120        FUNCTION BUMP(V)
	.ENTRY	BUMP,^M<>
;  121        V = V + 1.0
	ADDF2	BUMP.$F1,@BUMP.V(AP)
;  122        BUMP = V * 10.0
	MULF3	@BUMP.V(AP),BUMP.$F2,BUMP.BUMP
;  123        END
	MOVF	BUMP.BUMP,R0		; the function's value
	RET

; Storage map for SHOW, a subroutine
;   V     REAL           argument 1  @SHOW.V(AP)
;   S     CHARACTER*(*)  argument 2  @SHOW.S(AP)
;
SHOW.V = 4				; V is argument 1
SHOW.S = 8				; S is argument 2

	.PSECT	$LOCAL,PIC,CON,REL,LCL,NOSHR,NOEXE,RD,WRT,LONG
SHOW.$D1:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_F,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used
SHOW.$T1:
	.BLKL	1			; temporary
SHOW.$D3:
	.WORD	0			; length
	.BYTE	DSC$K_DTYPE_T,DSC$K_CLASS_S
	.LONG	0			; set when the descriptor is used

	.PSECT	$PDATA,PIC,CON,REL,LCL,SHR,NOEXE,RD,NOWRT,LONG
SHOW.$IO1:
	.WORD	8			; PRINT *'s control block: its size
	.WORD	0			; flags
	.LONG	-1			; unit *
SHOW.$D2:
	.WORD	4			; length
	.BYTE	DSC$K_DTYPE_L,DSC$K_CLASS_S
	.ADDRESS SHOW.$T1

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  124
;  125        SUBROUTINE SHOW(V, S)
	.ENTRY	SHOW,^M<>
;  126        CHARACTER*(*) S
;  127        PRINT *, V, LEN(S), S
	PUSHAB	SHOW.$IO1
	CALLS	#1,G^FTN$PRINT_LIST
	MOVAL	@SHOW.V(AP),SHOW.$D1+4
	PUSHAQ	SHOW.$D1
	CALLS	#1,G^FTN$IO_ITEM
	MOVZWL	@SHOW.S(AP),SHOW.$T1
	PUSHAQ	SHOW.$D2
	CALLS	#1,G^FTN$IO_ITEM
	MOVW	@SHOW.S(AP),SHOW.$D3
	MOVL	SHOW.S(AP),R0
	MOVAB	@4(R0),SHOW.$D3+4
	PUSHAQ	SHOW.$D3
	CALLS	#1,G^FTN$IO_ITEM
	CALLS	#0,G^FTN$IO_END
;  128        END
	RET

; Storage map for CHANGE, a subroutine
;   V     REAL  argument 1  @CHANGE.V(AP)
;
CHANGE.V = 4				; V is argument 1

	.PSECT	$CODE,PIC,CON,REL,LCL,SHR,EXE,RD,NOWRT,LONG
;  129
;  130        SUBROUTINE CHANGE(V)
	.ENTRY	CHANGE,^M<>
;  131        V = -1.0
	MOVL	#^X0000C080,@CHANGE.V(AP) ; -1.0
;  132        END
	RET

	.END	STMTFN
